>rand_prog 100~
if notbeing(kobold-soldier-king)
	mppurge self
endif
if pcnum($) > 0
	if is_qmark($r) & kobold_cave_hero 300004
		look $r
		fear
		say 你一定是刺客！來殺我的刺客！
		help!
		mpecho $I趁著他的叫喊擾亂到你的心神時，迅速從某處密穴逃走了....
		mppurge self
	endif
