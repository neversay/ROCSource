>rand_prog 100~
if pcnum($) > 0
	if is_inv_obj($i) != 66100
		mpoload 66100 1
	endif
endif
if inroom($i) != 66143
	mpcallout 30 mpcall goback $i
endif
~
>fight_prog 33~
if inroom($i) == 66143
	say 護駕～護駕～
	if rmobcount(66109) < 5
		mpmload 66109
		mpgroup $i kobold-soldier-shielder 1
	endif
	if rmobcount(66110) < 3
		mpmload 66110
		mpgroup $i kobold-soldier-priest 0
	endif
endif
if hitprcnt($i) < 50
	if notbeing(doll-kobold)
	or insameroom(doll-kobold)
	else
		yell 自地獄重生、挾毀滅之力的邪龍之偶啊....
		yell 在吾汝共主的名義下令汝前來，護衛吾吧！
		mpecho 一道煙霧過去，一隻巨大的龍忽然出現！
		mptransfer doll-kobold
		mpgroup $i doll-kobold 1
	endif
endif
~
>fight_prog 50~
if rand(40)
	circular
	circular
else
	say 這就是違逆我的下場！
	c soulsteal $r
	c 3 lifesteal $r
	c 3 energy $r
endif
~
>greet_prog 100~
if inroom($i) == 66170
	say 竟然被你發現了！受死吧！
	mpkill $n
	break
endif
if is_qmark($i) == istalk
or isnpc($n)
	break
endif
if is_qmark($n) !& kobold_cave_hero 300001
or is_qmark($n) & kobold_cave_hero 300512
or is_qmark($n) > kobold_cave_hero 200005
or is_qmark($n) != kobold_cave_hero
	look $n
else
	mpadd_qmark self istalk -1 0 0 0 1 0
	glare $n
	mpcallout 1 say 你就是最近幫助我們斬殺精靈、建功無數的外來者啊？
	mpcallout 2 say 果然一表人材，一看就知道不同凡響！很好！
	mpcallout 3 ponder
	mpcallout 4 say 不過，人不可貌相，你的能力還是得試過後才能知道。
	mpcallout 5 mpecho $I露出意味不明的詭異笑容....！？
	mpcallout 6 say 是這樣的，我這裡正好有一件事情需要你的幫忙。
	mpcallout 7 say 雖然我們地靈也算是人材濟濟，但這件事還是由外族人來比較適合。
	mpcallout 8 say 當然，我也不會虧待你的。如何？(yes/no)
	mpcallout 8 mpmod_qmark $n kobold_cave_hero v2 | 2
	mpcallout 8 mpmod_qmark $n kobold_cave_hero v2 r 1
	mpcallout 8 mpdel_qmark self istalk
endif
~
>talk_prog yes~
if is_qmark($i) == istalk
	tell $n 我正在忙，請稍等一下。
	break
endif
if is_qmark($n) & kobold_cave_hero 300002
	if is_qmark($n) != kobold_cave_hero 200100
	or is_qmark($n) <= kobold_cave_hero 200006
		mpadd_qmark self istalk -1 0 0 0 1 0
		mpmod_qmark $n kobold_cave_hero v2 r 2
		say 是這樣的，我發現我們地靈裡出了一位叛徒。
		mpcallout 1 say 如果公開處置掉他的話，恐怕會動搖士氣。
		mpcallout 2 say 因此我只是找個藉口將他趕出了軍隊。
		mpcallout 3 say 但是若放著他不管，又怕他再做出什麼對地靈不利的事。
		mpcallout 4 say 所以，希望你前去祕密處決掉他。
		mpcallout 5 say 他的名字叫做：贊錢拉龜斯田目但他。
		mpcallout 6 say 一切就拜託你了！
		mpcallout 6 mpmod_qmark $n kobold_cave_hero v2 | 4
		mpcallout 6 mpdel_qmark self istalk
	else
		mpadd_qmark self istalk -1 0 0 0 1 0
		mpechoat $n 正當你想要答應薩瑞塔爾時，外面忽然跑來了一名地靈遞給了薩瑞塔爾一張紙。
		mpmod_qmark $n kobold_cave_hero v2 | 512
		mpcallout 1 say 啊！不好意思，我發現這件事已經不用人幫忙了！
		mpcallout 2 say 真是抱歉，讓你白跑一趟了！
		mpcallout 3 wave $n
		mpcallout 3 mpdel_qmark self istalk
	endif
endif
~
>talk_prog no~
if is_qmark($i) == istalk
	tell $n 我正在忙，請稍等一下。
	break
endif
if is_qmark($n) & kobold_cave_hero 300002
	mpmod_qmark $n kobold_cave_hero v2 r 2
	say 好吧！既然如此，那我也不勉強你。
	mpcallout 1 shrug
endif
~
>talk_prog report~
if is_qmark($i) == istalk
	tell $n 我正在忙，請稍等一下。
	break
endif
if is_qmark($n) & kobold_cave_hero 300008
	mpmod_qmark $n kobold_cave_hero v2 r 8
	good $n
	say 沒想到你這麼快就有好消息了！
	mpadd_qmark self istalk -1 0 0 0 1 0
	mpcallout 1 say 看來委託你做這種事情還真是大材小用啊？
	mpcallout 2 ponder
	mpcallout 3 mpgold $n 1000000
	mpcallout 3 say 這是你的獎賞，請先收下吧！
	mpcallout 4 say 如果你沒事的話，我這裡倒還有一件事需要你的協助(help)....
	mpcallout 4 mpmod_qmark $n kobold_cave_hero v2 | 16
	mpcallout 4 mpdel_qmark self istalk
~
>talk_prog help~
if is_qmark($i) == istalk
	tell $n 我正在忙，請稍等一下。
	break
endif
if is_qmark($n) & kobold_cave_hero 300016
	mpmod_qmark $n kobold_cave_hero v2 r 16
	say 眾所皆知，我們地靈乃是上古巨龍流傳下來的後裔....
	mpechoat $n 你心想：有這回事嗎！？
	mpadd_qmark self istalk -1 0 0 0 1 0
	mpcallout 1 say 然而，像牠們這麼偉大的存在，平時極少有空理會我們的生活。
	mpcallout 2 say 如今，我們與精靈一族的決戰已經到了生死存亡的關頭。
	mpcallout 3 say 雖然我們擁有無比的信心，但如果能夠祈求我們遠祖的幫助，
	mpcallout 4 say 就能夠用更少的犧牲來獲得更偉大的勝利！
	mpcallout 5 say 祭祀祈禱的準備工作我早究已經吩咐手下去完成了，
	mpcallout 6 say 但是，現在還缺少最後的三樣物品，才能夠進行祭祀。
	mpcallout 7 say 這些材料分別是：純淨的龍晶、龍心的結晶以及龍之魂魄的凝聚體。
	mpcallout 8 say 不知英雄您是否能幫忙我前去尋找呢？
	mpcallout 8 mpmod_qmark $n kobold_cave_hero v2 | 32
	mpcallout 8 mpdel_qmark self istalk
endif
~
>defun_prog solvequest~
if is_qmark($n) !& kobold_cave_hero 300064
or is_qmark($n) !& kobold_cave_hero 300128
or is_qmark($n) !& kobold_cave_hero 300256
or is_qmark($n) != kobold_cave_hero
else
	mpadd_qmark self istalk -1 0 0 0 1 0
	mpcallout 1 applaud $n
	mpcallout 2 say 沒想到你一個人就把所有剩下的材料找齊了。
	mpcallout 3 say 實在太了不起了。
	mpcallout 4 glare $n
	mpcallout 5 say 雖然你是個外族人，但是卻為我們地靈做了這麼多事。
	mpcallout 6 ponder
	mpcallout 7 say 我決定冊封你為地靈族的英雄，並且廣為宣傳你的功蹟！
	mpcallout 8 say 另外，這雙手套就送給你，作為你這次的獎賞吧！
	mpcallout 9 mpechoat $n $I將一雙手套交給了你。
	mpcallout 9 mpechoaround $n $I將一雙手套交給了$N。
	mpcallout 9 mpoload 66114 $n 36 target
	mpcallout 9 mpmod_qmark $n kobold_cave_hero v2 | 512
	mpcallout 10 grin
	mpcallout 10 say 就這樣，我趕著去進行儀式，不送了。
	mpcallout 11 mpforce all south
	mpcallout 11 mpecho $I將在場的人通通趕出了王座室。
	if notbeing(doll-kobold)
		mpcallout 12 close down
		mpcallout 12 down
		mpcallout 12 open down
		mpcallout 12 unlock down
		mpcallout 12 mpoload 66100 1
		mpcallout 13 down
		mpcallout 14 say 終於湊齊了製作邪龍魂所需要的原料了。
		mpcallout 15 grin
		mpcallout 15 say 這下子，我手中的力量就能更多了。
		mpcallout 16 say 主宰庇佑，助我功成！
		mpcallout 17 mpecho $I開始將手裡的材料依序擺上祭壇....
		mpcallout 18 mpecho $I跪拜下來，向著某個不知名的邪神緩緩祈禱。
		mpcallout 19 mpecho 邪異的紅色光芒從祭壇上發散出來，鑽入了龍的屍骸中。
		mpcallout 20 mpecho 在紅色光芒彷彿有生命的操控下，龍晶、龍心與龍魂緩緩地融入了龍屍之中。
		mpcallout 21 mpgroup $i doll-kobold 1
		mpcallout 21 mppurge dragon-koboldobj
		mpcallout 21 mpecho 龍的屍骸彷彿活過來似地動了起來！
		mpcallout 21 mpmload 66134
		mpcallout 22 say 成功了！成功了！邪龍偶製作成功了！
		mpcallout 22 cackle
		mpcallout 23 sweat
		mpcallout 23 say 嗯....也該回去了，不然上面有是有人闖進來就糟了。
		mpcallout 24 mpjunk key
		mpcallout 24 avert
		mpcallout 24 lock down
		mpcallout 24 close down
		mpcallout 24 up
		mpcallout 24 open up
		mpcallout 24 up
		mpcallout 24 mpdel_qmark self istalk
	endif
endif
~
>give_prog 63099~
if is_qmark($n) !& kobold_cave_hero 300032
or is_qmark($n) & kobold_cave_hero 300064
or is_qmark($n) != kobold_cave_hero
	?
	drop $o
else
	good $n
	say 我收到純淨龍晶了！
	mpmod_qmark $n kobold_cave_hero v2 | 64
	mpcall solvequest $n
	mpjunk $o
