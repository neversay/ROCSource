#66108
狹窄的山道~
你正走在一條狹窄的山道上。這條崎嶇的山道在此處已經到了盡頭，但你在山壁
上發現了許多細小的踏腳洞，上面有著許多某種小形生物攀爬過的痕跡。
~
0 0 5
D0
~
~
0 0 66107
D4
~
~
0 0 66109
>room_mask up default~
echoat $n 你踩著狹小踏腳洞努力向上攀去....
echoaround $n $N踩著狹小踏腳洞努力向上攀去....
if roomvalue($n66108v0) == 1
	if dex($n) < 20
		if dex($n) < 17
			if rand(90)
				echoat $n 山頂忽然掉下一塊巨大的落石，將你砸了下來！
				echoaround $n 山頂忽然掉下一塊巨大的落石，將$N砸了下來！
				modhmv $n 01.500 1000 10100001
			else
				transfer $n 66109
				force 66109 force $n look
				force 66109 echoaround $n $N從山崖下攀上來了。
			endif
		else
			if rand(95)
				echoat $n 山頂忽然掉下一塊巨大的落石，將你砸了下來！
				echoaround $n 山頂忽然掉下一塊巨大的落石，將$N砸了下來！
				modhmv $n 01.500 1000 10100001
			else
				transfer $n 66109
				force 66109 force $n look
				force 66109 echoaround $n $N從山崖下攀上來了。
			endif
		endif
	else
		if dex($n) < 24
			if rand(70)
				echoat $n 山頂忽然掉下一塊巨大的落石，將你砸了下來！
				echoaround $n 山頂忽然掉下一塊巨大的落石，將$N砸了下來！
				modhmv $n 01.500 1000 10100001
			else
				transfer $n 66109
				force 66109 force $n look
				force 66109 echoaround $n $N從山崖下攀上來了。
			endif
		else
			if rand(50)
				echoat $n 山頂忽然掉下一塊巨大的落石，將你砸了下來！
				echoaround $n 山頂忽然掉下一塊巨大的落石，將$N砸了下來！
				modhmv $n 01.500 1000 10100001
			else
				echoat $n 山頂忽然掉下一塊巨大的落石砸向你，但被你以敏捷到不可思議的身法躲了過去！
				echoaround $n 山頂忽然掉下一塊巨大的落石砸向$N，但被$N以敏捷到不可思議的身法躲了過去！
				transfer $n 66109
				force 66109 force $n look
				force 66109 echoaround $n $N從山崖下攀上來了。
			endif
		endif
	endif
else
	transfer $n 66109
	force 66109 force $n look
	force 66109 echoaround $n $N從山崖下攀上來了。
endif
~
>room_rand 100~
if roomchar($) > 0
	if roomvalue($n66108v0) == 1
		if dex($r) < 18
		or rand(33)
			echoat $r 山頂忽然掉下一塊巨大的落石，砸得你頭破血流！
			echoaround $r 山頂忽然掉下一塊巨大的落石，砸得$R頭破血流！
			modhmv $r 01.250 500 10100001
		else
			echoat $r 山頂忽然掉下一塊巨大的落石砸向你，但被你以敏捷的身法躲了過去！
			echoaround $r 山頂忽然掉下一塊巨大的落石砸向你，但被$R以敏捷的身法躲了過去！
		endif
	endif
endif
~
