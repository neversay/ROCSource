	break
endif
if is_qmark($n) == kobold_cave_hero 200008
	say 什麼！？王座底下竟然有那種東西....
	mpadd_qmark self istalk -1 0 0 0 1 0
	mpcallout 1 say 看樣子薩瑞塔爾的背後的確有邪惡勢力的存在。
	mpcallout 2 say 再讓他把持著權力，他肯定會將地靈拖入戰爭的深淵的。
	mpcallout 3 say 但是，現在卻有一堆頭腦不清楚只想著建功立業的地靈支持著他。
	mpcallout 4 ponder
	mpcallout 5 say 能否請您幫忙告知城中的警備隊員真相，說服他們幫忙我推翻薩瑞塔爾呢？
	mpcallout 6 say 如果可以的話，盡可能不要動用武力比較好。
	mpcallout 6 mpmod_qmark $n kobold_cave_hero v1 = 9
	mpcallout 7 addoil $n
	mpcallout 7 mpdel_qmark self istalk
	mpmload 66132
	mpforce assassin-kobold mpdef_rembch $n
	mpforce assassin-kobold mpgoto 2
endif
