>talk_prog topic~
if is_qmark($n) <= kobold_cave_hero 100012
or is_qmark($n) == kobold_cave_hero 200001
or is_qmark($n) > kobold_cave_hero 300000
or is_qmark($n) != kobold_cave_hero
	if is_qmark($n) == kobold_cave_hero 200001
		say 我表弟名字叫贊錢拉龜斯田目但他，以前都是他叫我起床的。
		mpcallout 1 say 後來他不知道犯了什麼錯，被趕出軍隊了。
		mpcallout 2 say 只是不知道為什麼，從那時候起他就一副畏首畏尾的樣子。
		mpcallout 3 say 不知道在怕什麼(something)？
		mpcallout 4 say 他現在似乎是跑到礦坑去當個礦工了。
		mpcallout 5 sleep
		mpcallout 5 yawn
		mpcallout 5 say .....反正這也不關我的事，我還是繼續睡吧！
		if is_qmark($n) !& kobold_cave_hero 300512
			mpcallout 5 mpmod_qmark $n kobold_cave_hero v1 = 2
		endif
	else
		?
		yawn
		mpcallout 10 sleep
	endif
else
	?
	yawn
	mpcallout 1 say ..........
	mpcallout 2 say ！？
	mpcallout 3 say 糟了！我都忘記我表弟已經不在，沒人叫我起床了。
	mpcallout 4 say ..........
	mpcallout 5 sleep
	mpcallout 5 say 算了，還是繼續睡吧！
	mpcallout 5 mpmod_qmark $n kobold_cave_hero v1 = 1
endif
