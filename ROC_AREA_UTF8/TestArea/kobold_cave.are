>rand_prog 100~
if pcnum($) > 0
	if fightwith($r) / kobold
		if isfight($i)
		else
			yell 愚蠢的狂徒$R[0m[33;1m，竟敢在此攻擊吾輩地靈！
			mpkill $r
		endif
	endif
endif
~
>death_prog 100~
mpjunk sword-kobold
~
>talk_prog topic~
if is_qmark($n) < kobold_cave_hero 200009
or is_qmark($n) == kobold_cave_hero 200020
or is_qmark($n) != kobold_cave_hero
or is_qmark($n) & kobold_cave_hero 300512
else
	if notbeing(assassin-kobold)
		mpmload 66132
		mpforce assassin-kobold mpdef_rembch $n
		mpforce assassin-kobold mpgoto 2
	endif
	if is_qmark($i) != questtalked
		mpadd_qmark self questtalked -1 0 0 0 1 0
		mpechoat $n 你將薩瑞塔爾的所作所為告訴了$I....
		mpcallout 1 say 你說什麼？地靈王在暗地裡接觸邪神的力量？
		if rand(50)
			mpcallout 2 say 這樣不是很好嗎？
			mpcallout 3 say 有了邪神的力量，想必就能夠更快的消滅西邊那群精靈吧？
		else
			mpcallout 2 say 這有什麼關係呢？
			mpcallout 3 say 不是有句話嗎？善神邪神，能幫助我們的就是好神！
		endif
		mpcallout 4 mpforce $n -
		mpcallout 5 mpechoat $n 你將此事的利弊得失仔仔細細地對$I分析。
		mpcallout 5 mpechoaround $n $N將此事的利弊得失仔仔細細地對$I分析。
		if int($n) > 19
		or wis($n) > 19
			if rand(80)
				mpcallout 6 say 唔唔....原來如此！原來如此！
				mpcallout 7 say 雖然我還是搞不太清楚啦！
				mpcallout 8 say 總之只要幫助古拉拉小姐推翻薩瑞塔爾就好了是吧？
				mpcallout 8 mpmod_qmark $n kobold_cave_hero v1 + 1
				if is_qmark($n) == kobold_cave_hero 200009
					mpcallout 9 mpechoat $n 你終於說服一個人了！
				else
					if is_qmark($n) == kobold_cave_hero 200019
						mpcallout 9 mpechoat $n 你覺得你說服的人數差不多已經夠了，回去找古拉拉吧！
						mpcallout 9 mpmod_qmark $n kobold_cave_hero v1 = 20
					else
						mpcallout 9 mpechoat $n 你又說服一個人了！
					endif
				endif
			else
				mpcallout 6 say 你到底在說什麼啊？我根本聽不懂！
				mpcallout 7 say 總之你是在說地靈王的壞話是吧？
				mpcallout 8 mpkill $n
				mpcallout 8 yell 你這個間諜，死來！
			endif
		else
			if rand(40)
				mpcallout 6 say 唔唔....原來如此！原來如此！
				mpcallout 7 say 雖然我還是搞不太清楚啦！
				mpcallout 8 say 總之只要幫助古拉拉小姐推翻薩瑞塔爾就好了是吧？
				mpcallout 8 mpmod_qmark $n kobold_cave_hero v1 + 1
				if is_qmark($n) == kobold_cave_hero 200009
					mpcallout 9 mpechoat $n 你終於說服一個人了！
				else
					if is_qmark($n) == kobold_cave_hero 200019
						mpcallout 9 mpechoat $n 你覺得你說服的人數差不多已經夠了，回去找古拉拉吧！
						mpcallout 9 mpmod_qmark $n kobold_cave_hero v1 = 20
					else
						mpcallout 9 mpechoat $n 你又說服一個人了！
					endif
				endif
			else
				mpcallout 6 say 你到底在說什麼啊？我根本聽不懂！
				mpcallout 7 say 總之你是在說地靈王的壞話是吧？
				mpcallout 8 mpkill $n
				mpcallout 8 yell 你這個間諜，死來！
			endif
		endif
	else
		say 你已經對我說過這件事了！
	endif
endif
~
|
