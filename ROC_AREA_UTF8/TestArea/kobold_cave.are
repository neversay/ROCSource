>rand_prog 50~
if pcnum($) > 0
	if rand(80)
		?
		yawn
		mpcallout 10 sleep
	else
		if is_qmark($r) <= kobold_cave_hero 100012
		or is_qmark($r) > kobold_cave_hero 200000
		or is_qmark($r) > kobold_cave_hero 300000
		or is_qmark($r) != kobold_cave_hero
		else
			?
			yawn
