>greet_prog 100~
if ispc($n)
	if is_qmark($n) != kobold_cave_hero
	or is_qmark($n) <= kobold_cave_hero 100012
		if is_qmark($n) > war_reward 200000
		or race($n) == elf
			stare $n
			if is_qmark($n) & kobold_cave_hero 300512
				say 投靠精靈的叛徒....滾開！
			else
				say 精靈族的敵人啊....滾開！
			endif
			if race($n) != elf
				mpcallout 1 mpechoat $n 或許你可以向他解釋(Explain)你並不是精靈族的人？
			endif
		else
			if is_qmark($n) != kobold_cave_hero
			or is_qmark($n) == kobold_cave_hero 100000
				if isgood($n)
					stare $n
				endif
				say 外族人，你沒有進入(Enter)這裡的資格，走開！
			else
				say 你答應帶來的精靈人頭呢？數量還不夠喔....
			endif
		endif
	else
		salute $n
		if is_qmark($n) & kobold_cave_hero 300512
			say 地靈族的英雄，歡迎您！
		else
			say 地靈族的朋友，歡迎您！
		endif
		tell $n 如果你想要進入(Enter)地靈洞窟的話，告訴我就可以了。
	endif
endif
~
>talk_prog explain~
if is_qmark($n) != kobold_cave_hero
or is_qmark($n) == kobold_cave_hero 100000
	mpechoat $n 你努力地向門衛解釋你並非精靈族的人....
	mpechoaround $n $N努力地向門衛解釋他並非精靈族的人....
	if race($n) == elf
	or isgood($n)
		mpcallout 1 say 少來！我的眼睛可沒瞎。
		mpcallout 2 mpechoat $n $I看起來一點也不相信你。
		mpcallout 2 mpechoaround $n $I看起來一點也不相信$N。
	else
		if is_qmark($n) > war_reward 200000
			ponder $n
			mpcallout 1 say 這樣啊？也許是我認錯人了吧....
			mpcallout 2 say 但是職責所在，我也不能隨便放身份不明的人進去。
			mpcallout 3 say 這樣吧，你從西邊的精靈鎮帶一百顆精靈族的人頭過來。
			mpcallout 4 say 我就可以將你視為我們的朋友。
			mpcallout 4 mpmod_qmark $n kobold_cave_hero v0 = 1
			mpcallout 4 mpmod_qmark $n kobold_cave_hero v1 = 45
			mpcallout 4 mpadd_qmark $n kobold_cave_hero -1 1 45 0 0 1
		endif
	endif
endif
~
>talk_prog enter~
if is_qmark($n) != kobold_cave_hero
or is_qmark($n) == kobold_cave_hero 100000
	if is_qmark($n) > war_reward 200000
	or race($n) == elf
		stare $n
		if is_qmark($n) & kobold_cave_hero 300512
			say 投靠精靈的叛徒....滾開！
		else
			say 精靈族的敵人啊....滾開！
		endif
		if race($n) != elf
			mpcallout 1 mpechoat $n 或許你可以向他解釋(Explain)你並不是精靈族的人？
		endif
	else
		say 只有地靈族的朋友，才能進入這裡。
		mpcallout 1 ponder $n
		if level($n) > 35
			mpcallout 2 say 你看起來也算有點能力，夠格與我們為友。
			if isevil($n)
				mpcallout 3 say 這樣吧，你從西邊的精靈鎮帶十顆精靈族的人頭過來。
				mpcallout 4 say 我就可以將你視為我們的朋友。
				mpcallout 4 mpmod_qmark $n kobold_cave_hero v0 = 1
				mpcallout 4 mpmod_qmark $n kobold_cave_hero v1 = 0
				mpcallout 4 mpadd_qmark $n kobold_cave_hero -1 1 0 0 0 1
			else
				mpcallout 3 say 這樣吧，你從西邊的精靈鎮帶二十顆精靈族的人頭過來。
				mpcallout 4 say 我就可以將你視為我們的朋友。
				mpcallout 4 mpmod_qmark $n kobold_cave_hero v0 = 1
				mpcallout 4 mpmod_qmark $n kobold_cave_hero v1 = 5
				mpcallout 4 mpadd_qmark $n kobold_cave_hero -1 1 5 0 0 1
			endif
		else
			mpcallout 2 say 你的能力太弱了，不夠格與我們為友。
			mpcallout 3 wave $n
		endif
	endif
else
	if is_qmark($n) < kobold_cave_hero 100013
	or is_qmark($n) != kobold_cave_hero
	else
		nod $n
		mpechoat $n $I迅速地打開門讓你進去。
		mpechoaround $n $I迅速地打開門讓$N進去。
		mptransfer $n 66134
	endif
endif
~
>give_prog 13668~
if is_qmark($n) != kobold_cave_hero
or is_qmark($n) == kobold_cave_hero 100000
or is_qmark($n) > kobold_cave_hero 100012
	? $n
	drop $o
else
	mpjunk $o
	good $n
	if is_qmark($n) <= kobold_cave_hero 100013
		mpmod_qmark $n kobold_cave_hero v0 + 1
	endif
	if is_qmark($n) <= kobold_cave_hero 200000
	or is_qmark($n) != kobold_cave_hero 100003
	else
		mpmod_qmark $n kobold_cave_hero v0 = 1
		mpmod_qmark $n kobold_cave_hero v1 - 1
	endif
	if is_qmark($n) == kobold_cave_hero 100011
		mpmod_qmark $n war_reward v1 = 0
		mpmod_qmark $n kobold_cave_hero v0 = 13
		mpcallout 1 gasp $n
		mpcallout 2 say 太棒了！你真是一位強大的冒險者！
		mpcallout 3 say 地靈族交了你這個朋友了！
		mpcallout 4 say 如果你想進入(Enter)我們洞窟的話，只要跟我說一聲就好了。
	endif
endif
