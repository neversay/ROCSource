>death_prog 100~
yell 不！我不想死～我不想死啊～～～
if is_qmark($n) & kobold_cave_hero 300004
	mpmod_qmark $n kobold_cave_hero v2 r 4
	mpmod_qmark $n kobold_cave_hero v2 | 8
	mpechoat $n 看來你已經完成任務，可以去回報了(Report)。
endif
~
>talk_prog something~
if is_qmark($n) == kobold_cave_hero 200002
	fear
	mpcallout 1 say 我..我什麼都沒看到！什麼都沒聽到！
	mpcallout 2 leave
	mpmod_qmark $n kobold_cave_hero v1 = 3
	mpmload 66131
	break
endif
if is_qmark($n) == kobold_cave_hero 200003
	if is_qmark($i) != beassed
		forget
		leave
		break
	else
		mpecho $I一副驚魂未定的樣子，好像還未從剛才的刺殺中回復過來。
		mpcallout 1 say 沒想到即使我緊守祕密，他(He)還是不肯放過我....
		mpcallout 1 mpmod_qmark $n kobold_cave_hero v1 = 4
		mpcallout 2 glare
		mpcallout 3 say 難不成要我離鄉背井才肯罷休嗎？
		mpcallout 4 sigh
	endif
endif
~
>talk_prog he~
if is_qmark($n) == kobold_cave_hero 200004
	say 他....就是地靈之王－薩瑞塔爾！
	mpcallout 1 say 之前，我在回家時不小心迷了路....
	mpcallout 2 say 結果在一處隱密的地方窺見了薩瑞塔爾與某位「使者」的會面。
	mpcallout 3 say 那位使者似乎是由某個被稱為「主宰」的傢伙派來的，
	mpcallout 4 say 目的是賜給薩瑞塔爾某種力量，讓牠率領地靈發動戰爭，
	mpcallout 5 say 藉此消耗這個大陸上所有種族的力量。
	mpcallout 6 say 我知道這件事之後，一直很小心，從來沒有跟人透露過。
	mpcallout 7 say 怎麼還是被發現了呢？
	mpcallout 8 sigh
	mpcallout 9 say 這下子，叫我該如何是好呢？
	mpcallout 10 mpechoat $n 你心想：這裡有誰是可以庇佑(Protect)他不被薩瑞塔爾加害的呢？
	mpcallout 10 mpmod_qmark $n kobold_cave_hero v1 = 5
endif
~
