	if area($b) != holytown
		def_rembch null-tar
		def_rembch $n
	endif
	if pcnum($) == 1
		rcall holytown_musicseal_randset1 $n
		break
	endif
	if pcnum($) > 1
		if inroom($b) == 24132
			rcall holytown_musicseal_randset2 $n
		else
			def_rembch null-tar
			def_rembch $n
			rcall holytown_musicseal_randset3 $n
		endif
	endif
endif
~
>room_rand 20~
