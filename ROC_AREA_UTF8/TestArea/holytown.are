>room_command choose 1~
if rmobcount(24005) > 0
	if is_qmark($n) == holytown_enemy
		force susanna-holytown fear
		force susanna-holytown say 你是神聖小鎮的仇人，請你趕快離開這裡吧～
		force susanna-holytown say 再不然我可要叫人了喔～
		break
	endif
	if isevil($n)
		force susanna-holytown say 很抱歉我並不想把服飾賣給你這種邪惡之徒。
		force susanna-holytown say 也請你趕快離開這裡吧，不要再為難我了。
		break
	endif
	if hour($) > 21
	or hour($) < 10
		force susanna-holytown say 唉呀～現在是休息時間唷，麻煩您早上十點後再來吧～
		force susanna-holytown sorry $n
		break
	endif
	if is_qmark(susanna-holytown) >= holytown_susanna_cloth 100015
		force susanna-holytown say 唉呀～雲彩披風好像正巧賣完了耶～
		force susanna-holytown say 真不好意思ㄋㄟ～讓你白跑了這一趟。
		break
	endif
	if goldamt($n) < 200000
		force susanna-holytown inn $n
		force susanna-holytown say 這位冒險者，你身上的錢帶的好像不夠耶～
	else
		force susanna-holytown smile $n
		force susanna-holytown say 這位冒險者您請稍等唷。
		echoat $n 你看到 $I 從衣架中拿下了一件雲彩披風交給了你。
		echoaround $n 你看到 $I 從衣架中拿下了一件雲彩披風交給了$n。
		force susanna-holytown say 這件披風穿在您身上，一定會很好看的～
		force susanna-holytown mpgold $n -200000
		mod_qmark susanna-holytown holytown_susanna_cloth v0 + 1
		oload 24022 25 $n target
	endif
else
	ehcoat $n 服飾店老闆娘蘇桑娜 (Susanna) 現在並不在這間店裡喔！
endif
~
|
