>room_mask combat default~
if rmobcount(24011) > 0
	echoat $n [1;32m在你正試著想大聲吼叫時，卻看到老闆娘蘇桑娜(Susanna)正站在一旁望著你。[0m
	echoat $n [1;32m接著便聽到蘇桑娜(Susanna)一臉無辜的對你說到「對不起，可以麻煩你別大聲喧嘩嗎？」[0m
else
	echoat $n [1;32m趁著老闆娘不在，你便在店裡大吵大鬧，希望別讓守衛聽到才好。[0m
endif
~
>room_mask list default~
if rmobcount(24005) > 0
	if is_qmark($n) == holytown_enemy
		force susanna-holytown say 很抱歉喔，我不想把我的商品賣給小鎮的仇人。
		force susanna-holytown say 還是請你趕快離開這裡吧，不然我要叫守衛了喔。
		break
	endif
	if isevil($n)
		force susanna-holytown say 對不起，我並不想和邪惡之徒有生意上的往來。
		break
	endif
	if hour($) > 21
	or hour($) < 10
		force susanna-holytown say 真不好意思，我已經要休息了耶！明天請早好嗎？
		force susanna-holytown sorry
		break
	endif
	echoat $n [編號   Lv  價 錢 ] 物 品 名 稱
	if is_qmark(susanna-holytown) >= holytown_susanna_cloth 100015
		echoat $n [   1   25    售完] 雲彩披風(rosy clouds cloak).
	else
		echoat $n [   1   25  200000] 雲彩披風(rosy clouds cloak).
	endif
	if is_qmark(susanna-holytown) >= holytown_susanna_cloth 200010
		echoat $n [   2   25    售完] 舞風霓裳(flourish dress).
	else
		echoat $n [   2   25  300000] 舞風霓裳(flourish dress).
	endif
	if is_qmark(susanna-holytown) >= holytown_susanna_cloth 300020
		echoat $n [   3   25    售完] 青絲腰帶(green silk belt).
	else
		echoat $n [   3   25  150000] 青絲腰帶(green silk belt).
	endif
else
	echoat $n [1;32m老闆娘蘇桑娜 (Susanna) 現在並不在店裡唷！[0m
endif
~
