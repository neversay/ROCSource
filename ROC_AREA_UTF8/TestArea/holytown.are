>room_command push default~
echoat $n 你要推什麼？
~
>room_command push tree~
if is_qmark($n) == holytown_room_pushing 100002
	echoat $n 你現在還是氣喘如牛呢！休息一下子等體力回復後再繼續推吧！
	break
endif
if is_qmark($n) == holytown_room_pushing 100001
	echoat $n 你昏頭了嗎？你不是已經在推晃這棵椰子樹了嗎？
else
	if roomvalue($1) & 2
		echoat $n 你沒看到 $B 目前正使盡了吃奶的力氣在推這棵椰子樹了嗎？
		echoat $n 等看看他的結果如何吧！也許椰子馬上就掉下來了呢！
		break
	else
		if roomvalue($1) & 1
			if mvnum($n) < 400
				echoat $n 你已經沒有那個體力去推動這棵椰子樹了。
				break
			else
				modrvt v1 | 2
				def_rembch $n
				add_qmark $n holytown_room_pushing 2 1 0 0 1 0
				echoat $n 你使盡了吃奶的力氣，努力的推晃著眼前的椰子樹。
				echoaround $n 你看到 $N 在貼近椰子樹後，便開始使勁的推晃著椰子樹。
				modhmv $n 21.350 400 0
				callout 3 rcall holytown_room_push_checkmiss $b
			endif
		else
			if robjcount(24079) >= 1
				if robjcount(24088) >=1
					purge tree
					purge tree
					oload 24088 1 floor
					modrvt v1 | 1
					modrvt t0 = 50
					break
				else
					if mvnum($n) < 400
						echoat $n 你的體力已經不足以推動這棵椰子樹了喔。
						break
					else
						modrvt v1 | 2
						def_rembch $n
						add_qmark $n holytown_room_pushing 2 1 0 0 1 0
						echoat $n 你使盡了吃奶的力氣，努力的推晃著眼前的椰子樹。
						echoaround $n 你看到 $N 在貼近椰子樹後，便開始使勁的推晃著椰子樹。
						modhmv $n 21.350 400 0
						callout 3 rcall holytown_room_push_check
					endif
				endif
			else
				if robjcount(24088) < 1
					echoat $n 在這裡並沒有任何樹可以讓你推喔！
					oload 24088 1 floor
					modrvt v1 | 1
					modrvt t0 = 50
				endif
			endif
		endif
	endif
endif
~
>room_defun holytown_room_push_checkmiss~
if roomvalue($1) & 2
	if inroom($b) == 24080
		if is_qmark($b) != holytown_room_pushing 100002
			echoat $n 滿身是汗的你仰頭望了一下，才發現樹上早已沒半顆椰子了。
			echoaround $n 在 $N 使勁的推晃了一陣子之後，你卻發現樹上早就沒半顆椰子了。
			mod_qmark $n holytown_room_pushing v0 = 2
			def_rembch null-tar
			modrvt v1 r 2
		endif
	endif
endif
~
>room_defun holytown_room_push_check~
if roomvalue($1) & 2
	if inroom($b) == 24080
		if is_qmark($b) == holytown_room_pushing 100001
			if str($b) >= 23
				if rand(25)
					rcall holytown_room_push_over
				else
					rcall holytown_room_push_lose
				endif
			else
				if str($b) >= 20
					if rand(20)
						rcall holytown_room_push_over
					else
						rcall holytown_room_push_lose
					endif
				else
					if str($b) >= 17
						if rand(15)
							rcall holytown_room_push_over
						else
							rcall holytown_room_push_lose
						endif
					else
						if str($b) >= 14
							if rand(10)
								rcall holytown_room_push_over
							else
								rcall holytown_room_push_lose
							endif
						else
							if rand(5)
								rcall holytown_room_push_over
							else
								rcall holytown_room_push_lose
							endif
						endif
					endif
				endif
			endif
		endif
	endif
endif
~
