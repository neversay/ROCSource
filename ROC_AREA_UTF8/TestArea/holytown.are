	or hour($) < 10
		force trumen-holytown say 抱歉，我已經打烊了，明天請您早點來。
		force trumen-holytown yawn
		break
	endif
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 300010
		force trumen-holytown say 啊！真對不起，今天生意太好了，光之長劍已經賣完了勒！
		force trumen-holytown pat $n
		force trumen-holytown say 明天早一點來的話，我一定幫你留一把～
		break
	endif
	if goldamt($n) < 200000
		force trumen-holytown ponder
		force trumen-holytown say 這位冒險者，你確定你身上有足夠的錢買光之長劍嗎？
		force trumen-holytown say 我可是不習慣讓人賒帳的唷！真不好意思。
	else
		force trumen-holytown smile $n
		force trumen-holytown say 這位冒險者你運氣可真好，本店的光之長劍可是很熱門的呢！
		echoat $n 杜魯門(Trumen) 一邊說著，一邊從武器櫃裡拿出一把光之長劍遞交給你。
		echoaround $n 杜魯門(Trumen) 一邊說著，一邊從武器櫃裡拿出了一把光之長劍遞交給$n。
		force trumen-holytown say 再晚一點來的話，你可就買不到了呢！
		force trumen-holytown mpgold $n -200000
		mod_qmark trumen-holytown holytown_trumen_weapon v2 + 1
		oload 24023 25 $n target
	endif
else
	ehcoat $n 武器店老闆杜魯門 (Trumen) 現在並不在店裡喔！
endif
~
|
S
#24072
蘇桑娜的服飾店~
走進了這裡，因為平時客人十分的多，所以老闆--蘇桑娜忙的抽不出時
間來招呼客人，所以大家也就習慣了自己在店裡四處逛逛，看看有沒有適合
自己穿的服飾。看著店裡有著那麼多各式各樣的服飾，讓你不禁佩服老闆的
才華，因為這裡所能看到的服飾，都是由老闆親自手工製作而成的呢！而在
牆上則貼有著一張告示牌(note)。
