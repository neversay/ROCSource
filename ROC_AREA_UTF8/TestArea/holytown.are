>all_greet_prog 100~
if isaffected($i) & 1
	mpdis_magic self blindness
endif
if ispc($n)
	if is_qmark($i) == holytown_talking
		mpechoat $n $I現在正在忙著呢，並沒有注意到你的樣子。
		break
	endif
	if is_qmark($n) == holytown_enemy
		say 神聖小鎮的敵人！受死來吧！！
		mpkill $n
		hunt $n
		mpnowait
		break
	endif
	if isevil($n)
		say 該死的邪惡之徒！納命來呀！
		mpkill $n
		hunt $n
		mpnowait
		break
	endif
	if rand(30)
		if hour($) > 22
		of hour($) < 6
			mpadd_qmark $i holytown_talking 2 0 0 0 1 1
			mpechat $n $I[1;32m親切的對你說道「這位冒險者，那麼晚了還在外面閒晃呀？有什麼事就大聲叫我喔。」[0m
			mpechoaround $n $I[1;32m親切的對 [0m$n [1;32m說道「這位冒險者，那麼晚了還在外面閒晃呀？有什麼事就大聲叫我喔。」[0m
			mpcallout 2 mpdel_qmark $i holytown_talking
		else
			mpadd_qmark $i holytown_talking 2 0 0 0 1 1
			mpechoat $n $I[1;32m親切的對你說道「這位冒險者你好，有壞人欺負你的話，請大聲呼叫我。」[0m
			mpechoaround $n $I[1;32m親切的對[0m $n [1;32m說道「這位冒險者你好，有壞人欺負你的話，請大聲呼叫我。」[0m
			mpcallout 2 mpdel_qmark $i holytown_talking
		endif
	else
		mpechoat $n $I[1;36m正忙著他的巡視工作，所以沒空跟你打招呼。[0m
	endif
endif
~
>tick_prog 30~
if isfight($i)
	break
else
	mpecho $I[1;36m巡視了一下四週，似乎是已經沒有什麼危險了。[0m
	mpecho $I[1;32m放心的說道：「若再發現什麼可疑的人物，請大聲的呼喚求援。」[0m
	mpecho [1;36m說道，$I 便離開了這裡。[0m
	modrvt 24000 v0 - 1
	mppurge self
endif
~
