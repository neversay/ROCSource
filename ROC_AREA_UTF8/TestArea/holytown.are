#24049
魔法藥水店~
走進了這裡，你四處打量了一下店裡的擺設，兩旁的牆壁上各掛有著數
幅山水畫。而櫃台就在那離大門最遠的左前方。平常時候，你能看到一位漂
亮的女子站在櫃台後方用笑臉來迎接每個客人，她就是整個小鎮之中魔法造
詣最好的伊莉雅。櫃台後方擺著一罐罐由伊莉雅親自用魔力所灌製而成的魔
法藥水，依照每個人不同的需求而有所不同。你可以下達 (list) 指令來看
看有沒有你所需要的藥水。在櫃台的後方，你看到一張告示 (note) 。也許
你可以稍微看一下內容寫了些什麼。
~
0 8 0
D2
封印之路
~
~
7 -1 24045
D5
地下室
~
密門~
3 -1 24142
E
note~
你在這裡可以使用這些指令：

  List   - 列出店裡所有陳列的藥水種類。
  Choose - 選購一罐藥水。

因為所有的藥水數量有限，欲購從速，而且每人每次限選購一瓶。
ＰＳ：本店並不做收購服務喔～～貨物既出，概不退回～

在告示的最後面，你還看到伊莉雅(Eria) 漂亮的簽名，真是美呀～
~
>room_mask combat default~
if rmobcount(24007) > 0
	echoat $n [1;32m在你想大聲吼叫之前，卻被伊莉雅(Eria) 給阻止了下來。[0m
	echoat $n [1;32m只見伊莉雅(Eria) 對你說道「這位冒險者，麻煩不要在人家店裡吵鬧好嗎？」[0m
else
	echoat $n [1;32m趁著主人不在，你試著想在店裡開始大吼大叫，當心把守衛也給叫來了。[0m
endif
~
>room_mask list default~
if rmobcount(24007) > 0
	if is_qmark($n) == holytown_enemy
		force eria-holytown say 我不與神聖小鎮的仇人做生意！
		force eria-holytown say 麻煩你趕快離開這裡！不然我要叫守衛了喔！
		break
	endif
	if isevil($n)
		force eria-holytown say 這裡並不歡迎邪惡之徒，麻煩你趕快離開這裡，不然我要叫守衛了喔！
		break
	endif
	if hour($) > 21
	or hour($) < 8
		rcall holytown_eria_close $n
		break
	endif
	echoat $n [編號   Lv  價 錢 ] 物 品 名 稱
	if is_qmark(eria-holytown) >= holytown_eria_potion1 100020
		echoat $n [   1   20    售完] 白色藥水(white potion).
	else
		echoat $n [   1   20   50000] 白色藥水(white potion).
	endif
	if is_qmark(eria-holytown) >= holytown_eria_potion1 200010
		echoat $n [   2   30    售完] 綠色藥水(green potion).
	else
		echoat $n [   2   30  100000] 綠色藥水(green potion).
	endif
	if is_qmark(eria-holytown) >= holytown_eria_potion1 300020
		echoat $n [   3   20    售完] 黃色藥水(yellow potion).
	else
		echoat $n [   3   20   30000] 黃色藥水(yellow potion).
	endif
	if is_qmark(eria-holytown) >= holytown_eria_potion2 100015
		echoat $n [   4   20    售完] 淡紫色藥水(lavender potion).
	else
		echoat $n [   4   20   50000] 淡紫色藥水(lavender potion).
	endif
	if is_qmark(eria-holytown) >= holytown_eria_potion2 200015
		echoat $n [   5   20    售完] 水藍色藥水(azure potion).
	else
		echoat $n [   5   20   70000] 水藍色藥水(azure potion).
	endif
else
	echoat $n [1;32m美麗的老闆娘伊莉雅(Eria) 並不在店裡喔！[0m
endif
~
>room_mask buy default~
if rmobcount(24007) > 0
	if hour($) > 21
	or hour($) < 8
	force eria-holytown say 不好意思，本店已經打烊了，而且您用錯指令囉。
	else
		echoat $n 請善用選購指令 (Choose)，謝謝。
	endif
else
	echoat $n 伊莉雅(Eria) 並不在這裡哦！而且您也用錯指令囉。
endif
~
