		echoat $r [1;33m在夢中傳來了一陣詭異的音樂後，不禁讓你全身無力。[0m
		modhmv 01.20 30 00010501
	else
		rcall holytown_musicseal_randsetb1 $r
	endif
	break
endif
if pcnum($) > 1
	if inroom($b) == 24132
		if isaffected($b) & 131072
			echoat $b [1;33m在夢中傳來了一陣詭異的音樂後，不禁讓你全身無力。[0m
			echoaround $b $b [1;33m似乎在睡夢中也不得安寧，看他抽搐了幾下後，還是沒醒來。[0m
			modhmv 01.20 30 00010501
			break
		else
			rcall holytown_musicseal_randcheck $b
		endif
	else
		def_rembch null-tar
		def_rembch $r
		rcall holytown_musicseal_bigpk $r
	endif
endif
~
>room_rand 20~
