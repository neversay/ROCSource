7 -1 24068
>room_mask combat default~
if rmobcount(24006) > 0
	echoat $n [1;32m在你想大聲吼叫之前，卻被杜魯門(Trumen) 給喝止了下來。[0m
	echoat $n [1;32m只見杜魯門(Trumen) 對你說道「這位冒險者，要吵可以麻煩你出去外面吵嗎？」[0m
else
	echoat $n [1;32m趁著主人不在，你試著想在店裡開始大吼大叫，當心把守衛也給叫來了。[0m
endif
~
>room_mask list default~
if rmobcount(24006) > 0
	if is_qmark($n) == holytown_enemy
		force trumen-holytown say 我店裡的武器是不會賣給神聖小鎮的仇人的！
		force trumen-holytown say 你還是快點走吧！不然我可要不客氣了！
		break
	endif
	if isevil($n)
		force trumen-holytown say 我並不想和邪惡之徒有任何生意上的往來！
		break
	endif
	if hour($) > 23
	or hour($) < 10
		force trumen-holytown yawn
		force trumen-holytown say 真抱歉，本店已經打烊了，您也早點休息吧。
		break
	endif
	echoat $n [編號   Lv  價 錢 ] 物 品 名 稱
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 100010
		echoat $n [   1   25    售完] 光之匕首(light dagger).
	else
		echoat $n [   1   25  200000] 光之匕首(light dagger).
	endif
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 200010
		echoat $n [   2   25    售完] 光之長刀(light blade).
	else
		echoat $n [   2   25  200000] 光之長刀(light blade).
	endif
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 300010
		echoat $n [   3   25    售完] 光之長劍(light sword).
	else
		echoat $n [   3   25  200000] 光之長劍(light sword).
	endif
else
	echoat $n [1;32m老闆杜魯門 (Trumen) 現在並不在店裡喔！[0m
endif
~
>room_mask buy default~
if rmobcount(24006) > 0
	echoat $n 請善用選購指令 (Choose)，謝謝。
else
	echoat $n 杜魯門 (Trumen) 並不在這裡哦！而且您也用錯指令囉。
endif
~
>room_mask sell default~
if rmobcount(24006) > 0
	force trumen-holytown ponder
	force trumen-holytown say 很抱歉，我這裡並不提供收購服務。
	force trumen-holytown say 光明之鎮武器店老闆可能會很熱意收購您的裝備。
else
	echoat $n 你想做什麼呢？武器店老闆杜魯門 (Trumen) 現在並不在這裡哦！
endif
~
>room_command choose default~
echoat $n 請選購 "編號"。
~
>room_command choose 1~
if rmobcount(24006) > 0
	if is_qmark($n) == holytown_enemy
		force trumen-holytown say 我是不可能將武器賣給神聖小鎮的仇人的！
		force trumen-holytown say 你快離開我的視線吧！不然我要叫守衛了！
		break
	endif
	if isevil($n)
		force trumen-holytown say 我不想和邪惡之徒有任何生意上的往來！
		break
	endif
	if hour($) > 23
	or hour($) < 10
		force trumen-holytown say 抱歉，我已經打烊了，明天請您早點來。
		force trumen-holytown yawn
		break
	endif
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 100010
		force trumen-holytown say 真不好意思，光之匕首已經賣完了喔！
		force trumen-holytown sorry $n
		break
	endif
	if goldamt($n) < 200000
		force trumen-holytown say 這位冒險者，你身上的錢好像不夠買光之匕首耶！
		force trumen-holytown roll $n
	else
		force trumen-holytown hug $n
		force trumen-holytown say 這位冒險者你可真有眼光，本店的匕首可是相當有名的呢！
		echoat $n 杜魯門(Trumen) 說完，便從武器櫃裡拿出了一把光之匕首交給了你。
		echoaround $n 杜魯門(Trumen) 說完，便從武器櫃裡拿出了一把光之匕首交給了$n。
		force trumen-holytown mpgold $n -200000
		mod_qmark trumen-holytown holytown_trumen_weapon v0 + 1
		oload 24025 25 $n target
	endif
else
	ehcoat $n 武器店老闆杜魯門 (Trumen) 現在並不在店裡喔！
endif
~
>room_command choose 2~
if rmobcount(24006) > 0
	if is_qmark($n) == holytown_enemy
		force trumen-holytown say 我是不可能將武器賣給神聖小鎮的仇人的！
		force trumen-holytown say 你快離開我的視線吧！不然我要叫守衛了！
		break
	endif
	if isevil($n)
		force trumen-holytown say 我不想和邪惡之徒有任何生意上的往來！
		break
	endif
	if hour($) > 23
	or hour($) < 10
		force trumen-holytown say 抱歉，我已經打烊了，明天請您早點來。
		force trumen-holytown yawn
		break
	endif
	if is_qmark(trumen-holytown) >= holytown_trumen_weapon 200010
		force trumen-holytown say 很抱歉，目前光之長刀已經沒有存貨了喔！
		force trumen-holytown sorry $n
		force trumen-holytown say 不知您要不要再看看其它的武器呢？
		break
	endif
	if goldamt($n) < 200000
		force trumen-holytown say 這位冒險者，你身上的錢並不足於支付光之長刀的價錢耶！
		force trumen-holytown inn $n
	else
		force trumen-holytown good $n
		force trumen-holytown say 這位冒險者真是好眼力啊，本店的光之長刀可是很出名的呢！
		echoat $n 杜魯門(Trumen) 說完，便彎身從武器櫃之中拿出一把光之長刀交給你。
		echoaround $n 杜魯門(Trumen) 說完，便彎身從武器櫃之中拿出一把光之長刀交給了$n。
		force trumen-holytown mpgold $n -200000
		mod_qmark trumen-holytown holytown_trumen_weapon v1 + 1
		oload 24024 25 $n target
	endif
else
	ehcoat $n 武器店老闆杜魯門 (Trumen) 現在並不在店裡喔！
endif
~
