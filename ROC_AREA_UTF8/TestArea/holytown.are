>room_command choose 1~
if rmobcount(24007) > 0
	if is_qmark($n) == holytown_enemy
		force eria-holytown say 我是不會將藥水賣給神聖小鎮的仇人的！
		force eria-holytown say 再不離開我可要叫守衛了喔！
		break
	endif
	if isevil($n)
		force eria-holytown say 很抱歉，我是不會將藥水賣給邪惡之徒的。
		break
	endif
	if hour($) > 21
	or hour($) < 8
		rcall holytown_eria_close $n
		break
	endif
	if is_qmark(eria-holytown) >= holytown_eria_potion1 100020
		force eria-holytown say 對不起，白色藥水剛好賣完了耶！明早再來看看好嗎？
		force eria-holytown sorry $n
		break
	endif
	if goldamt($n) < 50000
		force eria-holytown say 這位冒險者，你身上的錢並不夠買白色藥水耶。
		force eria-holytown inn $n
	else
		force eria-holytown smile $n
		force eria-holytown say 好的，這是您要的白色藥水，謝謝您的惠顧～
		echoat $n 伊莉雅(Eria) 轉過身去，從櫃子的右上方拿出了一罐白色的藥水，交給了你。
		echoaround $n 伊莉雅(Eria) 轉過身去，從櫃子的右上方拿出了一罐白色的藥水，交給了$n。
		force eria-holytown mpgold $n -50000
		mod_qmark eria-holytown holytown_eria_potion1 v0 + 1
		oload 24030 20 $n target
	endif
else
	ehcoat $n 美麗的老闆娘伊莉雅(Eria) 並不在店裡喔！
endif
~
