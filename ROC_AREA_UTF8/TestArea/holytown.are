>room_mask unlock default~
if is_inv_obj($n) == 24002
	echoat $n 先將你手上的封印鑰匙 (Seal Key) 插進去鑰匙孔裡吧！
else
	echoat $n 你身上並沒有適合的鑰匙喔！
endif
~
>room_command insert key~
if robjcount(24003) >= 1
	if roomvalue($0) == 0
		if is_inv_obj($n) == 24002
			echoat $n 你小心翼翼的將手上的封印鑰匙(Seal Key) 插進去鑰匙孔中。
			echoaround $n 你看到 $n 小心翼翼的將手上的封印鑰匙(Seal Key) 插進去鑰匙孔中。
			purge $n sealkey-holytown
			echo 瞬間四周產生一股不安的氣息流竄過你的全身，讓你混身覺得不自在。
			echo 彷彿好像轉動鑰匙 (turn key) 之後，就會發生什麼事情似的。
			echo 心中不禁產生一股想要把鑰匙取出來(drawout key) 的想法。
			modrvt v0 = 1
		else
			echoat $n 你身上並沒有適合的鑰匙來做這個動作。
		endif
	else
		if roomvalue($0) == 1
			if is_inv_obj($n) == 24002
				echoat $n 你小心翼翼的想將手上的封印鑰匙(Seal Key) 插進去鑰匙孔中。
				echoaround $n 你看到 $n 小心翼翼的想將手上的封印鑰匙(Seal Key) 插進去鑰匙孔中。
				echoat $n 但卻發現鑰匙孔中早已經插入了一把同樣的鑰匙了，所以便將鑰匙又收了起來。
				echoaround $n 但卻發現鑰題孔中早已經插入了一把同樣的鑰匙，你便看到 $n 將鑰匙給收了起來。
				echo 你心中不免開始疑惑，怎麼會有兩把同樣的鑰匙呢？真奇怪。
			else
				echoat $n 你身上並沒有適合的鑰匙來做這個動作。
			endif
		endif
	endif
else
	if is_inv_obj($n) == 24002
		echoat $n 在這裡並沒有看到任何的鎖頭來讓你插入手上的這把封印鑰匙(Seal Key) 呀！
	else
		echoat $n 這裡並沒有任何可以讓你做插入鑰匙這個動作的東西。
	endif
endif
~
>room_command drawout key~
if robjcount(24003) >= 1
	if roomvalue($0) == 0
		echoat $n 在鑰匙孔上你並沒有看到任何的鑰匙喔！
		break
	endif
	if roomvalue($0) == 1
		echoat $n 受不了滿身的疑慮與恐懼，你還是將封印鑰匙(Seal Key) 給取了出來。
		echoaround $n 你看到 $n 將封印鑰匙(Seal Key) 給從黃金鎖頭上取了下來。
		echoat $n 不知為什麼，你鬆了好大一口氣，因為心中的一塊大石頭好像突然不見了。
		echoaround $n 你看到 $n 深深的吸了一口氣，四周凝結的不安氣息也在一瞬間消失無蹤。
		oload 24002 1 $n target
		modrvt v0 = 0
	endif
else
	echoat $n 在這裡並沒有看到任何的鎖頭，當然更別提說有什麼鑰匙可以取出了。
endif
~
>room_command turn key~
if robjcount(24003) >= 1
	if roomvalue($0) == 1
		echoat $n 你鼓起了勇氣，捉緊插在鑰匙孔上的封印鑰匙(Seal Key) 後，便開始轉動著鑰匙。
		echoaround $n 你看到 $n 捉緊插在鑰匙孔上的封印鑰匙(Seal Key) 後，便開始轉動著鑰匙。
		echo 沒多久之後，你看到鎖頭終於打開了，而就在那鎖頭打開的瞬間....
		echoat $n 在你還來不及反應時，那兩道符咒化為一股強大的魔法朝你身上襲擊過來....
		echoaround $n 在你還來不及反應時，你看到那兩道符咒化為一股強大的魔法朝著 $n 身上襲去....
		if isaffected($n) / mystic mirror
			echoat $n 幸好身上的魔法之鏡又將那道強大的魔法給反彈了回去。
			echoaround $n 幸好 $n 身上的魔法之鏡又將那道強大的魔法給反彈了回去。
			echo 而封印之箱(Seal Box) 也在瞬間被魔法給擊碎....
			echo 在那箱子的碎片之中，你卻意外的看到一個散發著邪惡氣息的圖騰(totem)。
			modrvt v0 = 0
			purge sealbox-holytown
			oload 24004 1 floor
		else
			echo 強大的魔法威力，瞬間侵襲整個洞穴，所有人都難逃這個突如其來的災難。
			echoat $n 心中不禁開始後悔，為何要去打開那道恐怖的黃金鎖頭呢！
			echoaround $n 在死前你不禁開始後悔，怎麼沒在 $n 要轉動鑰匙前先阻止他呢！
			modhmv all 03.100 100 0
			modhmv all 01.10 20 0
			at 24097 echo 你看到一道威力強大的魔法瞬間從北邊的洞穴那裡攻擊了過來。
			at 24097 echo 還來不及反應，你便已經躺在血泊之中了，根本不知發生了什麼事。
			at 24097 modhmv pc 03.100 100 0
			at 24097 modhmv pc 01.10 20 0
			at 24098 echo 你看到一道威力強大的魔法瞬間從北邊的洞穴那裡攻擊了過來。
			at 24098 echo 還來不及反應，你便已經躺在血泊之中了，根本不知發生了什麼事。
			at 24098 modhmv pc 03.100 100 0
			at 24098 modhmv pc 01.10 20 0
			at 24096 echo 四周突然產生巨大振盪，不知道上頭是發生了什麼事情。
			at 24027 echo 從北邊的瀑布裡頭突然傳來一聲巨響，一道強大的水柱朝你襲擊而來。
			at 24027 echo 在你還搞不清楚狀況時，你已經被那水柱給擊中而倒在地上了。
			at 24027 modhmv pc 03.80 90 00012401
			at 24027 modhmv pc 01.50 100 00012401
			purge sealbox-holytown
			modrvt v0 = 0
		endif
	else
		echoat $n 那鎖頭上面並沒有插著任何鑰匙可以讓你來轉動喔！
	endif
else
	echoat $n 這裡並沒有看到任何像鎖頭的東西，當然更不會有任何鑰匙來讓你轉動了。
endif
~
