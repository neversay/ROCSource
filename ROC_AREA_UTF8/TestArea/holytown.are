else
	modhmv $r 01.381 450 0
	echoat $r 米娜絲(Minace) 的[1;36m極凍冰界[0m打得你[1;32m**** 血流如注 ****[0m.(381-450)
	echoaround $r 米娜絲(Minace) 的[1;36m極凍冰界[0m打得$R[1;32m**** 血流如注 ****[0m.
