>room_defun holytown_eria_close~
if is_qmark($n) != holytown_eria_close
	force eria-holytown say 真不好意思，本店已經打烊了，明天請早吧～
	force eria-holytown inn $n
	add_qmark $n holytown_eria_close 5 0 0 0 0 1
else
	if is_qmark($n) == holytown_eria_close 100003
		echoat $n 別再自討沒趣了，伊莉雅(Eria) 已經不想理你了。
	endif
	if is_qmark($n) == holytown_eria_close 100002
		force eria-holytown angry
		echoat $n 伊莉雅(Eria) 轉過頭去，已經不想理會你了。
		echoaround $n 你看到伊莉雅(Eria) 將頭轉到一邊，一副不想再理會$N 的樣子。
		mod_qmark $n holytown_eria_close v0 = 3
	endif
	if is_qmark($n) == holytown_eria_close 100001
		force eria-holytown say 這位客人，本店已經打烊了，明兒一早再來好嗎？
		force eria-holytown sorry $n
		mod_qmark $n holytown_eria_close v0 = 2
	endif
	if is_qmark($n) == holytown_eria_close 100000
		force eria-holytown say 不好意思，本店已經打烊了，明早九點將準時為您服務。
		force eria-holytown bow
		mod_qmark $n holytown_eria_close v0 = 1
	endif
endif
~
