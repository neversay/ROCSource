>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 0 1
mpadd_qmark self baneparadise_mob -1 0 0 0 0 1
mpat 12000 mpoload 12080
mpat 12000 wear all
~
>tick_prog 100~
if inroom($i) != 12260
or inroom($i) != 12261
	if nplayer($) == 0
		mpat 12257 mpforcer here modrvt t0 = 10
		mppurge self
	endif
endif
~
>fight_prog 100~
if is_qmark($n) == baneparadise_mob
	mpgoto self
endif
~
>fight_prog 15~
mpmodify act r 32
mpgoto self
bs $r
mpmodify act | 32
~
>fight_prog 100~
if rand(20)
	skilldrv multihit $n
	skilldrv multihit $n
	skilldrv onehit $r
	break
endif
if rand(20)
	bashhead
	bashhead
	bashhead
	break
endif
if rand(15)
	c paralyze $r
	c 'seal magic' $r
endif
if rand(25)
	mpat 12000 mpoload 12082
	throw dart-bp $r
	mpjunk dart-bp
endif
if rand(20)
	c 2 'chill touch' $r
endif
if rand(25)
	c 'fang of slime'
	c 'lore of frost'
endif
~
>death_prog 100~
mpat 12000 mpforcer here rcall call_add_timer
if inroom($i) == 12260
or inroom($i) == 12261
	if rmobcount(12035) == 1
		mpforcer here modrvt t0 = 200
	endif
endif
if rand(95)
	mppurge whinger
endif
if rand(20)
	mpoload 12082 41
endif
mpgreward skexp $n 30 1000
if pcnum($) > 15
	mpgreward exp $n 30 10000
else
	if pcnum($) > 10
		mpgreward exp $n 30 15000
	else
		if pcnum($) > 5
			mpgreward exp $n 30 25000
		else
			mpgreward exp $n 30 35000
		endif
	endif
endif
~
|
