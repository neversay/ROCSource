>talk_prog p reset~
mpmload 12101
mpecho $I重生ＯＫ！
mppurge self
~
>talk_prog p act~
say 攻擊設定包括致命攻擊(critical)、御劍術(hard_dis)、
say 戰術(tactics)、再生(regeneracy)、反向(reflexion)、
say 獵殺(hunt)、獵殺技巧(track)及停止普攻(stop)。
~
>talk_prog p affect~
say 法術設定包括聖光(sanctuary)、天使加護(Protect)、
say 飛行(flying)、焰甲(flaming armor)、魔力屏障(mana shield)
say 、魔法之鏡(mystic mirror)及魔力護壁(mystic armor)。
~
>talk_prog p class~
say 職業設定包括戰士(warrior)、法師(mage)、盜賊(thief)、
say 劍士(swordsman)、弓箭手(archer)及嗜血(blood)。
say 另外, 可以調升降強度(power)一次。
~
>talk_prog p +power~
if is_qmark($i) & baneparadise_act 100001
	mpecho $I的強度已經是進階強度了。
	break
endif
mpmod_qmark self baneparadise_act v0 | 1
mpmodify special | 4194304
mpecho $I的強度提升了。
~
>talk_prog p -power~
if is_qmark($i) !& baneparadise_act 100001
	mpecho $I的強度已經是普通強度了。
	break
endif
mpmod_qmark self baneparadise_act v0 r 1
mpmodify special r 4194304
mpecho $I的強度降低了。
~
>talk_prog p +critical~
if is_qmark($i) & baneparadise_act 100002
	mpecho $I目前已經是會玫命一擊的攻擊設定。
	break
endif
mpmod_qmark self baneparadise_act v0 | 2
mpmodify act | 2048
mpecho $I目前開始會致命一擊。
~
>talk_prog p -critical~
if is_qmark($i) !& baneparadise_act 100002
	mpecho $I目前已經是不會玫命一擊的攻擊設定。
	break
endif
mpmod_qmark self baneparadise_act v0 r 2
mpmodify act r 2048
mpecho $I目前開始不會致命一擊。
~
>talk_prog p +hard_dis~
if is_qmark($i) & baneparadise_act 100004
	mpecho $I目前已經是會御劍術的攻擊設定。
	break
endif
mpmod_qmark self baneparadise_act v0 | 4
mpmodify act | 4096
mpecho $I目前開始會御劍術。
~
>talk_prog p -hard_dis~
if is_qmark($i) !& baneparadise_act 100004
	mpecho $I目前已經是不會御劍術的攻擊設定。
