		echoaround $n [1;30m人影一晃，[m$N[1;30m的身影竟從你眼前消失了。[m
		at 12166 echo [1;33m你看到[m$N[1;33m的身影突然出現在你的眼前。[m
	endif
	transfer $n 12166
	at 12166 force $n look
endif
~
>room_mask west default~
