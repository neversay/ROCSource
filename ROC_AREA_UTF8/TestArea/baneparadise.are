#12081
nightmares sphere~
夢魘魂珠(Sphere Of Nightmares)~
你看到一顆泛著暗淡紫光的珠子(Sphere)飄浮在這裡。~
~
15 1|2|4|16|64|256|512|2048|4194304|33554432 1|16384
0~ 14~ 100~ 0~
1 10000000 0
C 10000000
X lightning aura~
E nightmares sphere~
這是由您的坐騎夢魘(Nightmares)所轉換成的另一種型態。當你有需要的
時候，可以藉由觸摸(Touch) 魂珠的方式來喚醒牠。
~
Z 4
A
3 1
A
18 2
A
40 2
A
44 30
>obj_repop 100~
if is_qmark($n) == nightmares_convert
	opmodvt self used = 2
	opmodvt self v0 = 1
endif
~
>obj_rand 100~
if is_qmark($n) == nightmare_death
or isgood($n)
or isneutral($n)
or max_wis($n) < 18
	break
endif
if weather($) == 2
or weather($) == 3
	if hour($) == 0
	or hour($) == 2
	or hour($) == 4
	or hour($) == 6
	or hour($) == 8
	or hour($) == 10
	or hour($) == 12
	or hour($) == 14
	or hour($) == 16
	or hour($) == 18
	or hour($) == 20
	or hour($) == 22
		echoat $n [1;34m$O將吸收的雷雨之能轉換成魔法能量散發而出，你的魔力回復了一些。[m
		modhmv $n 12.500 500 0
	endif
endif
~
>obj_act wear~
if is_qmark($n) == nightmare_death
	echoat $n [1;32m夢魘(Nightmares)受重傷療養中，產生一股排斥力讓你無法裝備。[m
	oforcer here oload 12081 41 $n target
	ogoto self
	purge self
	break
endif
if ispc($n)
	if isneutral($n)
	or isgood($n)
	or max_wis($n) < 18
		echoat $n [1;32m你的能力還不足已穿上$O。[m
		echoaround $n $N[1;32m嚐試著要穿上$O，但卻被$O給排斥了。[m
		echoat $n [1;36m你看到夢魘(Nightmares)化回原型對著你生悶氣。[m
		echoaround $n [1;36m你看到一隻夢魘(Nightmares)化回原型對著[m$N[1;36m生悶氣。[m
		oforcer here mload 12029
		oforcer here del_qmark $n nightmares_convert
		oforce nightmares-bp-h mpdef_rembch $n
		oforce nightmares-bp-h mpgroup $n nightmares-bp-h 1
		ogoto self
		purge self
		break
	endif
	if is_equ_obj($n) == 12069
		echoat $n [1;33m你身上已經騎有一隻夢魘(Nightmares)了喔。[m
		ogoto self
		purge self
	endif
	if is_wear_loc($n) == 24
		echoat $n [1;35m因為你又另外找來了一頭坐騎，所以讓夢魘(Nightmares)感到不愉快。[m
		echoat $n [1;36m你看到夢魘(Nightmares)化回原型對著你生悶氣。[m
		echoaround $n [1;36m你看到一隻夢魘(Nightmares)化回原型對著[m$N[1;36m生悶氣。[m
		oforcer here mload 12029
		oforcer here del_qmark $n nightmares_convert
		oforce nightmares-bp-h mpdef_rembch $n
		oforce nightmares-bp-h mpgroup $n nightmares-bp-h 1
		ogoto self
		purge self
	endif
endif
~
>obj_command touch default~
if objextra(self,v0) != 0
or is_qmark($n) != nightmares_convert
	echoat $n [1;34m這個魂珠看來失效了。[m
	ogoto self
	purge self
	break
endif
if is_equ_obj($n) == 12069
	echoat $n [1;33m你不可以同時擁有兩隻夢魘(Nightmares)喔！[m
	echoat $n [1;33m你看到$O在你手中消失不見。[m
	ogoto self
	purge self
	break
endif
if is_equ_obj($n) == 12081
	echoat $n [1;37m你還握著它呢！[m
	break
endif
if is_qmark($n) == nightmare_death
	echoat $n [1;33m夢魘受到致命的傷害，正在療養中。[m
	break
endif
if is_inv_obj($n) == 12081
	if isevil($n)
		echoat $n [1;30m你的愛寵夢魘(Nightmares)聽從您的召喚，回復的原身出現在你面前。[m
		echoaround $n [1;30m你看到一隻漂亮的夢魘(Nightmares)突然出現在[m$N[1;30m身旁。[m
		oforcer here mload 12029
		oforce nightmares-bp-h mpdef_rembch $n
		oforce nightmares-bp-h mpgroup $n nightmares-bp-h 1
		oforcer here del_qmark $n nightmares_convert
		ogoto self
		purge self
	else
		echoat $n [1;33m你的愛寵似乎並不想接受您的召喚。[m
	endif
endif
~
|
