>talk_prog p convert~
if rembch($n)
else
	break
endif
if being($b)
	if insameroom($b)
		if is_inv_obj($b) == 12081
		or is_equ_obj($b) == 12081
		or is_equ_obj($b) == 12069
		or is_qmark($b) == nightmares_convert
			mpechoat $b [1;32m你不可以同時擁有兩隻$I喔。[m
			break
		else
			mpadd_qmark self converting
			mpechoat $b [1;35m$I轉換成魂珠狀態，依附在你身上。[m
			mpechoaround $b [1;35m你看到$I化為一顆泛著暗淡紫光的珠子，飄落在[m$B[1;35m身上。[m
			mpadd_qmark $b nightmares_convert -1 0 0 0 0 1
			mpoload 12081 $b 41 target
			mppurge self
		endif
	endif
endif
~
>tick_prog 100~
if being($b)
	if insameroom($b)
		if is_qmark($i) == converting
			break
		endif
		if rand(100)
			if is_inv_obj($b) == 12081
			or is_equ_obj($b) == 12081
			or is_equ_obj($b) == 12069
				mpecho [1;31m$I似乎被主人給遺棄了，只好傷心的回到牠原來的居所。[m
				mppurge self
			endif
		endif
		if rand(10)
			nuzzle $b
		endif
	else
		if is_inv_obj($b) == 12081
		or is_equ_obj($b) == 12081
		or is_equ_obj($b) == 12069
			mpecho [1;31m$I似乎被主人給遺棄了，只好傷心的回到牠原來的居所。[m
			mppurge self
		endif
		mpecho [1;32m$I踏著輕快的腳步，直奔主人的身旁去。[m
		mpgoto $b
		mpechoat $b [1;32m$I迅速奔跑回到你的身旁，似乎想緊緊的黏著你。[m
		mpechoaround $b [1;32m$I迅速奔跑回到[m$B[1;32m的身旁，真有靈性啊。[m
	endif
else
	mpecho [1;31m$I似乎被主人給遺棄了，只好傷心的回到牠原來的居所。[m
	mppurge self
endif
