			mpgreward exp $n 30 9000
		else
			mpgreward exp $n 30 10000
		endif
	endif
endif
if is_qmark($n) & baneparadise_qmark 100001
	if is_equ_obj($n) == 12069
	or is_equ_obj($n) == 12081
	or is_inv_obj($n) == 12081
		mpecho $I幻化成一顆漂亮的寶珠掉落在地面上。
		mpforcer here oload 12083 41 floor
		mppurge self
	else
		mpechoat $n $I被你擊敗後，站了起來跟在你身後。
		mpechoaround $n $I被$N擊敗後，臣服於$N的淫威之下。
		mpmload 12029
		mpforce nightmares-bp-h mpdef_rembch $n
		mpgroup $n nightmares-bp-h 1
		mppurge self
	endif
endif
~
