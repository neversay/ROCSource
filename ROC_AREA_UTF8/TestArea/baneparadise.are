>obj_repop 100~
oset self v1 = 66
oset self v2 = 70
~
>obj_act wear~
if objval1($o) < 66
or objval2($o) > 70
	echoat $n 裝備更新完成。
	oforcer here oload 12078 40 $n target
	ogoto self
	purge self
	break
endif
if ispc($n)
	if con($n) < 21
		echoat $n [1;32m你的能力還不足已穿上$O。[m
		echoaround $n $N[1;32m嚐試著要穿上$O，但卻被$O給排斥了。[m
		echoat $n [1;35m你的體質似乎還差了點。[m
		echoat $n [1;31m$O從你身上彈開，掉落在地。[m
		echoaround $n [1;31m你看到$O從[m$N[1;31m身上彈開，掉落在地。[m
		ogoto self
	endif
endif
~
