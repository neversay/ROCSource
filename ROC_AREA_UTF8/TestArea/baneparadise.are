~
>room_defun search_east~
if roomvalue($0) & 2
	echoat $n 東邊的石堆已經被撞開了。
else
	if roomvalue($0) & 1
		echoat $n 經過清理之後，東邊的石堆似乎有點鬆動的感覺。
	else
		echoat $n 經過仔細的搜索與清理之後，你發現東邊的石堆似乎有點鬆動的感覺。
		makedoor 1 土堆 土堆 103 -1 12266
		at 12266 makedoor 3 土堆 土堆 103 -1 12084
		modrvt v0 | 1
	endif
endif
~
>room_command search default~
echoat $n 你想要搜索什麼方向？
~
>room_trap 33554432 100~
modrvt v0 | 2
at 12266 modrvt v0 | 2
at 12266 modrvt t0 = 4
~
