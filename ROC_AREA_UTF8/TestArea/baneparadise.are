		setdoor 1 flags 1
	endif
else
	setdoor 1 flags 127
endif
~
>room_trap 2 100~
echoat $n [1;35m因為沒有魔龍卡希迪的魔力支持，結界之石在瞬後變化成了一堆粉末。[0m
echoaround $n [1;35m你看到[m$N[1;35m手上的結界之石在瞬間化成了一堆粉末。[0m
purge $n stone-bp1
modrvt t0 = 100
modrvt v0 = 1
~
|
