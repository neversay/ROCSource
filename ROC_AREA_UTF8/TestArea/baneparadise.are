	if is_inv_obj($n) != 12061
		echoat $n [1;32m要將$O拿到手上才可以進行認主程序喔。[m
		break
	endif
	if resp($n) < 70
	or hpnum($n) < 2000
	or isneutral($n)
	or isgood($n)
	or is_qmark($n) !& baneparadise_qmark 100064
	or is_qmark($n) != baneparadise_qmark
		echoat $n [1;31m你似乎還不夠資格讓$O認你為主喔！你的血白流了！[m
		echoaround $n [1;31m你看到[m$N[1;31m將自己的大量鮮血揮灑在$O上頭，真是瘋狂啊。[m
		modhmv $n 01.1999 1999 0
		break
	endif
	echoat $n [1;31m你將你的鮮血揮灑在$O上頭，完成了認主的程序。[m
	echoaround $n [1;31m你看到[m$N[1;31m將自己的大量鮮血揮灑在$O上頭，真是瘋狂啊。[m
	opmodvt self used = 2
	opmodvt self v0 = 1
	oset self extra | 4194304
	oset self extra | 4096
	modhmv $n 01.1999 1999 0
	opremove_obj_affect self all
	if class($n) == 18
		opmodify_obj_affect self 18 + 4 -1
		opmodify_obj_affect self 19 + 4 -1
	else
		if class($n) == 13
			opmodify_obj_affect self 18 + 4 -1
			opmodify_obj_affect self 43 + 15 -1
			break
		endif
		if class($n) == 17
			opmodify_obj_affect self 18 + 4 -1
			opmodify_obj_affect self 43 + 15 -1
			opmodify_obj_affect self 44 + 20 -1
		else
			opmodify_obj_affect self 18 + 5 -1
			opmodify_obj_affect self 19 + 2 -1
			opmodify_obj_affect self 44 + 20 -1
		endif
	endif
endif
~
