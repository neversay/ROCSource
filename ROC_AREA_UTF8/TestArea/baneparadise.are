>talk_prog p +level~
if level($i) <= 120
	mpmodify level + 1
	mpecho $I的等級提升１。
else
	say 等級已經不能再升上去了。
endif
~
>talk_prog p -level~
if level($i) > 1
	mpmodify level - 1
	mpecho $I的等級降低１。
else
	say 等級已經不能再降下去了。
endif
~
>talk_prog p level +10~
if level($i) <= 110
	mpmodify level + 10
	mpecho $I的等級提升１０。
else
	say 等級已經不能再升１０上去了。
endif
~
>talk_prog p level -10~
if level($i) > 10
	mpmodify level - 10
	mpecho $I的等級降低１０。
else
	say 等級已經不能再降低１０了。
endif
~
>talk_prog p how~
say 若要加的話，請在選項前面加+ 號。如：+pp
say 若要減的話，請在選項前面加- 號。如：-ac
say 也可以選擇重生(reset) 讓一切回復原始狀。
say 另外再加強定值調整(how2)。
~
>talk_prog p how2~
say ac dc 提供+-500, +-1000, +-1500, +-2000定值調整。
say pd md pp 提供+-50, +-100, +-150, +-200 定值調整。
say hr dr 提供+-100, +-150, +-200, +-300 定值調整。
say mdr pdr 提供+-100, +-300, +-500, +-1000 定值調整。
say 如：talk golem hr +200, talk golem mdr -100。
