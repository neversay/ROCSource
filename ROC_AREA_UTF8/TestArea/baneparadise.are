or isnpc($n)
	makedoor 3 出口 出口 0 0 12153
	force $n west
	deldoor 3
else
	if rand(30)
		echoaround $n [1;30m人影一晃，[m$N[1;30m的身影竟從你眼前消失了。[m
		at 12153 echo [1;33m你看到[m$N[1;33m的身影突然出現在你的眼前。[m
	endif
	transfer $n 12153
	at 12153 force $n look
endif
~
