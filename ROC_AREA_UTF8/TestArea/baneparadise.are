~
>talk_prog p number~
say 數值設定包括pp、ac、dc、hr、dr、md、pd、mdr、pdr、
say align(陣營)、level(等級) 、svs、svfire、svcold、
say svlight、svearth、svwind、svsaint、svdark、svbreath。
say 其中 level 能以 １０ 為單位調整，talk level -10 或 level + 10
~
>talk_prog p +dc~
if is_qmark($i) == baneparadise_dodge 102000
	mpecho $I的閃避率已經爛到爆了。
	break
endif
mpmod_qmark self baneparadise_dodge v0 + 1
mpmodify dc + 50
mpecho $I的閃避率增加了５０點。
~
>talk_prog p -dc~
if is_qmark($i) == baneparadise_dodge 100000
	mpecho $I的閃避率已經好到爆了。
	break
endif
mpmod_qmark self baneparadise_dodge v0 - 1
mpmodify dc - 50
mpecho $I的閃避率減少了５０點。
~
>talk_prog p +svs~
if is_qmark($i) == baneparadise_svs 100200
	mpecho $I的法術抗性已經爛到爆了。
	break
endif
mpmod_qmark self baneparadise_svs v0 + 1
mpforcer here add_affect $i 'detect evil' 1000 -1 24 +5 0
mpecho $I的法術抗性＋５。
~
