mpadd_qmark self delayed_stun -1 0 0 0 0 1
mpat 12000 mpoload 12062 41
mpat 12000 wear all
~
>fight_prog 50~
if rand(20)
	c 'phlogistic verse'
	break
endif
if rand(20)
	c 'finger of death'
	break
endif
if rand(20)
	c 'virtual swords'
	break
endif
if rand(20)
	c 'demon tremor'
endif
~
>talk_prog help~
if is_qmark($n) != bp_questmark
        mpadd_qmark $n bp_questmark -1 0 0 0 0 1
endif
if is_qmark($i) != bp_talking
	if is_qmark($n) != bp_save_quest
		if is_qmark($n) !& bp_questmark 100001
			mpadd_qmark self bp_talking 10 0 0 0 0 1
			mpechoat $n $I謹慎地打量了你一下。
			mpcallout 1 tell $n 你......你願意助我一臂之力？
	                mpcallout 2 mpechoat $n $I像是溺水的人突然抓到浮木一般，眼神變得和剛才不太一樣了。
        	        mpcallout 3 tell $n 不，我想你還是先聽聽我的煩惱(trouble)，再做決定吧。
			mpcallout 4 tell $n 畢竟，我碰上的並非很簡單的問題......
			mpcallout 4 mpadd_qmark $n bp_save_quest -1 1 0 0 0 1
			mpcallout 5 mpdel_qmark self bp_talking
		endif
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
>talk_prog trouble~
if is_qmark($i) != bp_talking
	if is_qmark($n) == bp_save_quest 100001
		mpadd_qmark self bp_talking 10 0 0 0 0 1
		tell $n 是這樣的......我兩個朋友迷失在這片叢林裡了。
		mpcallout 1 tell $n 我想去救他們，但是我的實力不夠，這樣進去只會白白犧牲。
		mpcallout 2 tell $n 可是我又不能放著他們不管，畢竟他們是為了我才會身陷險境。
		mpcallout 3 mpechoat $n $I說著，突然望向遠方......
		mpcallout 4 tell $n 以前這裡可是個充滿著榮耀與光輝的國家啊，可恨的密茲雷克(Myzelak)！
		mpcallout 4 mpmod_qmark $n bp_save_quest v0 = 2
		mpcallout 4 mpdel_qmark self bp_talking
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
>talk_prog myzelak~
if is_qmark($i) != bp_talking
	if is_qmark($n) == bp_save_quest 100002
		mpadd_qmark self bp_talking 10 0 0 0 0 1
		tell $n 以前這裡曾經是我父皇所統治的羅曼諾斯城。
		mpcallout 1 tell $n 我不敢說它是世界上最繁華的城市，但比它繁華的城市可以說沒有幾座！
		mpcallout 2 tell $n 然而這一切，全在巫妖之王密茲雷克(Myzelak)來襲後，化為現在的模樣。
		mpcallout 3 tell $n 更可恨的是我父皇竟然被他變成了不死生物，繼續統治這裡！
		mpcallout 4 sigh
		mpcallout 5 tell $n 我兩個朋友大概是為了幫助軟弱的我，所以才會冒險闖入此地。
		mpcallout 6 tell $n 如果、如果我有更強大的力量，我的朋友也不會......
		mpcallout 7 mpechoat $n $I突然一咬牙，硬是將激動的情緒平復下來。
		mpcallout 8 tell $n 即使是這麼危險的情況下，你仍然願意去拯救他們嗎？
		mpcallout 8 mpmod_qmark $n bp_save_quest v0 = 3
		mpcallout 8 mpdel_qmark self bp_talking
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
>talk_prog no~
if is_qmark($i) != bp_talking
	if is_qmark($n) == bp_save_quest 100003
		tell $n 不行嗎......能否請你再多考慮考慮？
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
>talk_prog yes~
if is_qmark($i) != bp_talking
	if is_qmark($n) == bp_save_quest 100003
		mpadd_qmark self bp_talking 10 0 0 0 0 1
		thank $n
		mpcallout 1 tell $n 拜託你了，請代替軟弱的我去拯救他們吧！
		mpcallout 2 tell $n 我那兩個朋友分別叫做蕾姍娜(Lexanna)與菲尼勒斯(Phineas)。
		mpcallout 3 tell $n 他們兩位都是精靈，是我最好的朋友。
		mpcallout 4 tell $n 不管如何，一切的希望......全都寄託在你身上了！
		mpcallout 4 mpadd_qmark $n bp_save_count1 150 0 0 0 0 1
		mpcallout 4 mpmod_qmark $n bp_save_quest v0 = 4
		mpcallout 4 mpdel_qmark self bp_talking
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
>talk_prog report~
if is_qmark($i) != bp_talking
	if is_qmark($n) == bp_save_quest 100009
		mpadd_qmark self bp_talking 10 0 0 0 0 1
		mpechoat $n 你向$I回報了蕾姍娜與菲尼勒斯已經逃脫的事情。
		if is_qmark($n) == bp_save_quest 300001
			mpcallout 1 tell $n 我果然沒看錯人，你的確是可靠的英雄！
			mpcallout 2 hand $n 
			mpcallout 3 tell $n 現在他們已經安全了，但是密茲雷克(Myzelak)的勢力仍然很強大。
			mpcallout 4 tell $n 我必須進行下一個計劃，阻止他繼續肆虐下去！
			mpcallout 4 mpmod_qmark $n bp_save_quest v1 = 1
			mpcallout 4 mpmod_qmark $n bp_save_quest v0 = 10
		endif
		if is_qmark($n) == bp_save_quest 300002
			mpcallout 1 mpechoat $n 但是話才講一半，你發現$I的臉色越變越糟。
			mpcallout 2 mpechoat $n 一切的一切都發生得太突然了，$I就這麼倒了下去。
			mpcallout 3 mpechoat $n 你大驚失色，連忙蹲下去查看他的情況。
			mpcallout 4 mpechoat $n 只聽到他用最後的力氣對你說道......
			mpcallout 5 tell $n 我...感謝...你...的...協助......
			mpcallout 6 mpechoat $n 說完他就斷氣了，這時你突然聽到背後傳來聲音。
			mpcallout 7 mpechoat $n 回頭一看，只見一臉蒼白的蕾姍娜(Lexanna)與菲尼勒斯(Phineas)就站在你身後。
			mpcallout 8 mpechoat $n 接著你看見菲尼勒斯(Phineas)露出憤恨的神情，接著再次衝進了敵陣！
			mpcallout 9 mpechoat $n 蕾姍娜想拉他也拉不住，只能跟著追上去......
			mpcallout 9 mpmod_qmark $n bp_save_quest v1 = 2
			mpcallout 9 mpmod_qmark $n bp_save_quest v0 = 10
		endif
		if is_qmark($n) == bp_save_quest 300003
			mpcallout 1 mpechoat $n 然而不提還好，你話都還沒講完，$I卻已露出了悲痛的神情。
			mpcallout 2 tell $n 菲尼死了，他在你去找符文石的時候遇襲。
			mpcallout 3 tell $n 他為了保護蕾娜，即使已經受了嚴重的內傷仍然死撐著......
			mpcallout 4 tell $n 直到脫離險境後才不支倒地。
			mpcallout 5 tell $n 蕾娜現在精神很不穩定，因此我先請人將她送回安全的地方。
			mpcallout 6 tell $n 同時我發誓，用盡任何手段，也要為他復仇！
			mpcallout 6 mpmod_qmark $n bp_save_quest v1 = 3
			mpcallout 6 mpmod_qmark $n bp_save_quest v0 = 10
		endif
		if is_qmark($n) == bp_save_quest 300002
			mpcallout 1 mpechoat $n 但是話才講一半，你發現$I的臉色越變越糟。
			mpcallout 2 mpechoat $n 一切的一切都發生得太突然了，$I就這麼倒了下去。
			mpcallout 3 mpechoat $n 你大驚失色，連忙蹲下去查看他的情況。
			mpcallout 4 mpechoat $n 只聽到他用最後的力氣對你說道......
			mpcallout 5 tell $n 我...感謝...你...的...協助......
			mpcallout 6 mpechoat $n 說完他就斷氣了......
			mpcallout 6 mpmod_qmark $n bp_save_quest v1 = 4
			mpcallout 6 mpmod_qmark $n bp_save_quest v0 = 10
		endif
		if is_qmark($n) == bp_save_quest 300005
			mpcallout 1 mpechoat $n 然而不提還好，你話都還沒講完，$I卻已露出了悲痛的神情。
			mpcallout 2 tell $n 蕾娜死了，她在空間傳送的過程中受到敵人阻擾。
			mpcallout 3 tell $n 為了讓菲尼活下去，她使用全力將他傳送到安全的地方。
			mpcallout 4 tell $n 自己卻因此死在敵人的手裡......
			mpcallout 5 tell $n 菲尼已經離開這裡了，去尋求能消滅密茲雷克(Myzelak)的力量。
			mpcallout 6 tell $n 而我決定了，不能讓蕾娜白白死去，我要替她復仇！
			mpcallout 6 mpmod_qmark $n bp_save_quest v1 = 5
			mpcallout 6 mpmod_qmark $n bp_save_quest v0 = 10
		endif
	endif
else
	mpechoat $n 別人講話時不要插嘴。
endif
~
