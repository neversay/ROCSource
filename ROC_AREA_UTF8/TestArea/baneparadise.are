>talk_prog maxskexp~
if level($n) >= 41
	if is_qmark($n) != enable_level_41
		if is_qmark($n) == max_skill_exp
			if is_qmark($n) <= max_skill_exp 100050
				mpmod_qmark $n max_skill_exp v0 + 5
				mpechoat $n 你感到自身潛在的力量覺醒了！
			else
				say 你的上限已經到頂囉，沒法再幫你提升了。
			endif
		else
			mpadd_qmark $n max_skill_exp -1 5 0 0 0 1
			mpechoat $n 你感到自身潛在的力量覺醒了！
		endif
	endif
endif
~
>talk_prog p give me caster eq~
if level($n) >= 41
	if is_qmark($n) != enable_level_41
		mpechoat $n $I給了你一套施法系裝備。
		mpechoaround $n $I給了$N一套施法系裝備。
		mpcall caster_eq1 $n
		mpcall caster_eq2 $n
		mpcall caster_eq3 $n
		mpcall caster_eq4 $n
		mpcall caster_eq5 $n
		mpcall caster_eq6 $n
	endif
endif
~
