0 0 12052
>room_leave 511 100~
if mobcount(12021) == 0
or isnpc($n)
or is_qmark($n) == bp_spaced
	setdoor 0 vnum 12050
	setdoor 2 vnum 12052
	break
endif
if rand(33)
	setdoor 0 vnum 12050
else
