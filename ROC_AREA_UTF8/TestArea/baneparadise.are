or isnpc($n)
or is_qmark($n) == bp_spaced
or rand(33)
	makedoor 1 出口 出口 0 0 12184
	modrvt v0 = 0
else
	if rand(50)
		makedoor 1 出口 出口 0 0 12158
		modrvt v0 = 1
	else
		makedoor 1 出口 出口 0 0 12272
		modrvt v0 = 2
	endif
endif
force $n east
deldoor 1
~
>room_defun random_exit_west~
if mobcount(12021) == 0
or isnpc($n)
or is_qmark($n) == bp_spaced
or rand(33)
	makedoor 3 出口 出口 0 0 12158
	modrvt v1 = 0
else
	if rand(50)
		makedoor 3 出口 出口 0 0 12184
		modrvt v1 = 1
	else
		makedoor 3 出口 出口 0 0 12272
		modrvt v1 = 2
	endif
endif
force $n west
deldoor 3
