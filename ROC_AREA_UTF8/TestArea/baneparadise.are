~
>room_defun search_east~
if roomvalue($1) & 2
	echoat $n 東邊的石堆已經被撞開了。
else
	if roomvalue($1) & 1
		echoat $n 經過清理之後，東邊的石堆似乎有點鬆動的感覺。
	else
		echoat $n 經過仔細的搜索與清理之後，你發現東邊的石堆似乎有點鬆動的感覺。
		makedoor 1 土堆 土堆 103 -1 12104
		modrvt v1 | 1
	endif
endif
~
