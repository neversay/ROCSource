>room_command dig default~
if is_qmark($n) == bp_save_quest 100007
	if rand(80)
		echoat $n 你覺得這附近的地面好像有點問題，於是你動手開始挖掘。
		echoat $n 但是挖了半天，你什麼也沒挖到。
	else
		echoat $n 你覺得這附近的地面好像有點問題，於是你動手開始挖掘。
		echoat $n 過沒多久，你挖出了一顆閃亮的符文石！
		echoat $n 然而，當你將石頭收進行囊裡的瞬間，耳邊突然響起了恐怖的聲音。
		echoat $n 「卑賤的蟲子......在巫妖之王的面前你所有的努力都是徒勞無功......」
		echoat $n 此地不宜久留，快閃吧。
		mod_qmark $n bp_save_quest v0 = 8
	endif
else
	echoat $n 什麼？
endif
~
