~
>talk_prog p +stop~
if is_qmark($i) == disable_round_hit
	mpecho $I已經停止使用普通攻擊。
	break
endif
mpadd_qmark self disable_round_hit -1 0 0 0 0 1
mpecho $I將不會使用普通攻擊。
~
>talk_prog p -stop~
if is_qmark($i) != disable_round_hit
	mpecho $I已經會使用普通攻擊。
	break
endif
mpdel_qmark self disable_round_hit -1 0 0 0 0 1
mpecho $I將使用普通攻擊。
~
