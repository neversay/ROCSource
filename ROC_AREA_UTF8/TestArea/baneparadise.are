or isnpc($n)
or is_qmark($n) == bp_spaced
or roomvalue($1) == 0
	makedoor 3 出口 出口 0 0 12158
	force $n scout west
	deldoor 3
else
	if roomvalue($1) == 1
		makedoor 3 出口 出口 0 0 12184
		force $n scout west
		deldoor 3
	else
		if roomvalue($1) == 2
			makedoor 3 出口 出口 0 0 12272
			force $n scout west
			deldoor 3
		endif
	endif
endif
~
