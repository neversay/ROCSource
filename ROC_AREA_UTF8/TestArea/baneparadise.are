or isnpc($n)
or is_qmark($n) == bp_spaced
or roomvalue($0) == 0
	makedoor 1 出口 出口 0 0 12184
	force $n scout east
	deldoor 1
else
	if roomvalue($0) == 1
		makedoor 1 出口 出口 0 0 12158
		force $n scout east
		deldoor 1
	else
		if roomvalue($0) == 2
			makedoor 1 出口 出口 0 0 12272
			force $n scout east
			deldoor 1
		endif
	endif
endif
~
>room_defun scout_west~
