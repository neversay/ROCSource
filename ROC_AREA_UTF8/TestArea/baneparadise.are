		setdoor 0 vnum 12052
	else
		setdoor 0 vnum 12267
	endif
endif
if rand(33)
	setdoor 2 vnum 12050
else
	if rand(50)
		setdoor 2 vnum 12052
	else
		setdoor 2 vnum 12267
	endif
endif
~
>room_mask north default~
if isnpc($n)
or is_qmark($n) == bp_spaced
or mobcount(12021) == 0
	setdoor 0 vnum 12050
endif
force $n north
~
>room_mask south default~
if isnpc($n)
or is_qmark($n) == bp_spaced
or mobcount(12021) == 0
	setdoor 2 vnum 12052
endif
force $n south
~
|
