		break
	endif
	if pcweight($) > 800
		if roomvalue($0) & 2
			echoat $n 但似乎已經沒有什麼反應了。
		else
			modrvt v0 | 2
			modrvt t1 = 2
			echo 你看到地板上的凹痕似乎因為重量的關係而下沈了幾公分。
			if roomvalue($n12251v0) & 2
			if roomvalue($n12263v0) & 2
