E anathema scepter~
它原本代表著康斯坦丁大帝皇權的皇室象徵之一，本身乃是帶有著靈氣的
一件寶器。於羅曼諾斯的滅亡之後，雖然仍究伴隨著大帝的身旁，但早已
被混濁的亡靈氣息給侵蝕的它，原有的靈氣似乎早已不再，取代而之的卻
是濃郁的魔氣。
~
A
4 2
A
18 2
A
40 4
L 41
>obj_act wear~
if ispc($n)
	if skillexp($n) < 289 5
	or resp($n) < 75
		echoat $n [1;32m你的能力還不足已穿上$O。[m
		echoaround $n $N[1;32m嚐試著要穿上$O，但卻被$O給排斥了。[m
		if skillexp($n) < 289 5
			echoat $n [1;35m你的天賦似乎還不夠。[m
		endif
		if resp($n) < 75
			echoat $n [1;35m你的威望似乎還不夠。[m
		endif
		echoat $n [1;31m$O從你身上彈開，掉落在地。[m
		echoaround $n [1;31m你看到$O從[m$N[1;31m身上彈開，掉落在地。[m
		ogoto self
	endif
endif
~
|
