>fight_prog 100~
		skilldrv multihit $r
		skilldrv speedhit $r
		skilldrv heavyhit $r
		skilldrv multihit $r
		if rand(50)
				if rand(50)
						if rand(50)
								if rand(50)
										cast acid $r
								else
										cast blindness $r
								endif
						else
								if rand(50)
										cast paralyze $r
								else
										cast chill $r
								endif
						endif
				else
						if rand(50)
								if rand(50)
										cast earthquake
								else
										cast energy $r
								endif
						else
								if rand(50)
										cast gas
								else
										cast whirlwind
								endif
						endif
				endif
		else
				if rand(50)
						if rand(50)
								if rand(50)
										cast crushing $r
								else
										cast seal $r
								endif
						else
								if rand(50)
										cast lifesteal $r
								else
										cast chain
								endif
						endif
				else
						if rand(50)
								if rand(50)
										cast powerball $r
								else
										cast fear $r
								endif
						else
								if rand(50)
										cast mute $r
								else
										cast star $r
								endif
						endif
				endif
		endif
~
