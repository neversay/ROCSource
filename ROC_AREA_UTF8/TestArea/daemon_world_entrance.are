#595
night mist soul~
[0m[30;1m夜之魂[0m(Night Soul)~
一團晦暗不明的霧氣(Mist)聚集在這裡。~
~
8 2|4|256|16777216 2077
0~ 6~ 0~ 0~
1 100000 0
Z 4
E
night mist soul~
這團霧氣似乎是黑夜凝聚而具現化的物質，從中能窺視(check)到無盡的黑夜。
也許能想個方法來利用。
~
R 8|128|256|2048|1048576
X black matter~
>obj_repop 100~
if rand(20)
	opset_obj_affect self -1 1 2
else
	if rand(25)
		opset_obj_affect self -1 2 2
	else
		if rand(33)
			opset_obj_affect self -1 3 2
		else
			if rand(50)
				opset_obj_affect self -1 4 2
			else
				opset_obj_affect self -1 5 2
			endif
		endif
	endif
endif
~
>obj_command check default~
if objval1($o) != 6
	echoat $n 你凝視著$O的內部，只看到一團晦暗不明的黑色。
else
	echoat $n 你凝視著$O的內部，似乎看見了黑夜的景色。
endif
~
>obj_rand 100~
if is_equ_obj($n) == 595
	if hour($) >= 18
	or hour($) <= 6
		if objval0($o) == 0
			break
		endif
		if objval1($o) == 5
			echoat $n 吸收足夠的夜之力後，$O的霧氣凝聚在一起。
			oset self value1 + 1
		endif
		if objval1($o) == 4
			echoat $n 夜晚的力量被$O緩緩吸收著...
			oset self value1 + 1
		endif
		if objval1($o) == 3
			echoat $n 夜晚的力量被$O緩緩吸收著...
			oset self value1 + 1
		endif
		if objval1($o) == 2
			echoat $n 夜晚的力量被$O緩緩吸收著...
			oset self value1 + 1
		endif
		if objval1($o) == 1
			echoat $n 夜晚的力量被$O緩緩吸收著...
			oset self value1 + 1
		endif
		if objval1($o) == 0
			echoat $n 夜晚的力量被$O緩緩吸收著...
			oset self value1 + 1
		endif
	endif
endif
~
>obj_act wear~
oset self value0 = 1
if objval1($o) >= 6
	if hour($) >= 18
	or hour($) <= 6
		echoat $n 聚集在$O中的夜之力湧進了你的身體！
		del_affect $n 'body building'
		add_affect $n 'body building' 1000 3 18 5 0
		add_affect $n 'body building' 1000 3 19 5 0
		add_affect $n 'body building' 1000 3 40 4 0
		add_affect $n 'body building' 1000 3 44 15 0
		oset self value1 = 0
	endif
endif
~
>obj_act remove~
oset self value0 = 0
del_affect $n 'body building'
~
|

