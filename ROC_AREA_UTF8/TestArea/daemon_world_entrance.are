				mpnowait
				cast 'demon tremor' $r
				mpnowait
				cast 'seal magic' $r
				mpnowait
		else
				meteoric $n
				meteoric $r
				if rand(33)
						mpforcer here echo $I的身體忽然越來越模糊...越來越模糊...
						mpgoto 5
						mpteleport vnum 562 576
				endif
		endif
		if isaffected($i) == seal magic
				if rand(33)
						mpforcer here del_affect $i 'seal magic'
				endif
		endif
		if isaffected($i) == mute
				if rand(50)
						mpforcer here del_affect $i 'mute'
				endif
		endif
~
|
