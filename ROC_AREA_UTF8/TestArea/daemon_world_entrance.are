				echo 空間不停劇烈地震盪著...
				mload 578
		endif
~
>room_enter 64 100~
echoaround $n $N突然出現在這裡！
force $n look
if is_qmark($n) != wererat_plane
	add_qmark $n wererat_plane -1 0 0 0 1 0
endif
mod_qmark $n wererat_plane v0 = 33
if is_qmark($n) == ismoving
	del_qmark $n ismoving
endif
~
|
