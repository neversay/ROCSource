#0


#ROOMDATA
#500
界域封印~
你飄浮在一片黑暗的無重力空間中，失序的方向感讓你完全無法按照正常的方式
移動(move)。各種顏色的光線從四面八方朝著此處匯聚而來，組成了一團閃爍不定的
巨大光雲。你感到光雲裡散發出純正的神聖力量，看來這裡就是防止邪惡入侵的封印
所在了？
~
0 1114128 0
>room_defun repairseal~
		if is_inv_obj($n) == 550
				purge $n fragment-obj
				echoat $n 你身上的封印碎片飛進了巨大的光雲之中！
				echoaround $n $N身上的封印碎片飛進了巨大的光雲之中！
				if roomvalue($n500v0) < 30
						if is_qmark($n) <= wererat_save 300015
								mload 559
								mod_qmark $n wererat_save v2 + 1
								if class($n) < 5
										force rpqew-fqwere mpexp $n 3000
								endif
								force rpqew-fqwere mpexp $n 3000
								force rpqew-fqwere mpskillexp $n 60
								purge rpqew-fqwere
						endif
						modrvt 500 v0 + 1
						if roomvalue($n500v0) > 29
								callout 1 echotoarea [0m[33;1m在奪目的光芒之後，整個空間開始依循著某種規律律動起來！[0m
								callout 1 purge seal-obj
								callout 1 oload 552 1 floor
						endif
				endif
				rcall repairseal $n
		endif
~
>room_enter 64 100~
		if is_qmark($n) != wererat_save 100002
		or level($n) < 36
				transfer $n 3840
		else
				if is_qmark($n) == wererat_save 300005
						mod_qmark $n wererat_save v2 = 6
						add_qmark $n wererat_plane -1 0 0 0 1 0
						echoat $n 當光芒逐漸暗淡後，你發現你已經被傳送到了一個奇特的空間裡。
				else
						echoaround $n $N往這裡游了過來...
						if is_qmark($n) != wererat_plane
							add_qmark $n wererat_plane -1 0 0 0 1 0
						endif
						mod_qmark $n wererat_plane v0 = 0
						if is_qmark($n) == ismoving
							del_qmark $n ismoving
						endif
				endif
		endif
		force $n look
		rcall repairseal $n
~
>room_command check plane seal light~
		if objcount(551) > 0
				if roomvalue($n500v0) < 10
						echoat $n 封印看起來極端的不穩定，快想辦法修好它吧！
				else
						if roomvalue($n500v0) < 20
								echoat $n 封印看起來有些不穩定，快想辦法修好它吧！
						else
								if roomvalue($n500v0) > 29
										echoat $n 封印看來十分穩定，或許你可以試著穿越(enter)看看了？
								else
										echoat $n 封印閃爍著些微不穩定的光芒，再加點勁吧！
								endif
						endif
				endif
		else
				echoat $n 什麼？
		endif
~
>room_command enter plane seal light~
		if robjcount(551) > 0
		or robjcount(552) > 0
				if roomvalue($n500v0) > 29
						echoat $n 你試圖前往封印的另一端。
						echoaround $n $N試圖穿越封印，整個人消沒在光團之中...
						echoat $n [0m[33;1m你感到封印中充沛的神聖力量湧入了你的身體。[0m
						cast san $n 30
						if is_qmark($n) <= wererat_save 300016
								mod_qmark $n wererat_save v2 = 17
								force 3899 mload 554
								force 3899 mload 554
						endif
						transfer $n 533
				else
						echoat $n 你試圖前往封印的另一端，卻被看不見的障礙擋了回來。
						echoaround $n $N試圖穿越封印，但不久後就又退了回來。
						callout 1 echoat $n 看來必須想辦法把封印修復完整一點才行...
				endif
		else
				echoat $n 什麼？
		endif
~
>room_defun profra~
		if objcount(550) < 40
				if roomvalue($n500v0) < 30
						force rpqew-fqwere mpoload 550
						rcall profra rpqew-fqwere
				endif
		endif
~
>room_defun sealdecrease~
		if roomvalue($n500v0) > 0
				modrvt 500 v0 - 1
		endif
~
>room_time 100~
		mload 559
		if roomvalue($n500v0) < 30
				echo [0m[33;1m一道光芒從光團中分裂而出，流星似地往遠方逝去...[0m
				callout 1 echo [0m[35m巨大的光雲似乎變得更加黯淡了許多...[0m
				if rand(80)
						rcall sealdecrease rpqew-fqwere
				endif
				if rand(40)
						rcall sealdecrease rpqew-fqwere
				endif
				if rand(20)
						rcall sealdecrease rpqew-fqwere
				endif
				if rnplayer($) > 7
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
				if rnplayer($) > 9
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
				if rnplayer($) > 11
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
				if rnplayer($) > 13
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
				if rnplayer($) > 19
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
						if rand(15)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
				if rnplayer($) > 25
						if rand(25)
								rcall sealdecrease rpqew-fqwere
						endif
						if rand(15)
								rcall sealdecrease rpqew-fqwere
						endif
				endif
		endif
		rcall profra rpqew-fqwere
		purge rpqew-fqwere
~
>room_command move default~
echoat $n 你要移動到哪裡(exits)去？
~
>room_mask east default~
echoat $n 你判斷不出哪邊是東方！
~
>room_mask west default~
echoat $n 你判斷不出哪邊是西方！
~
>room_mask north default~
echoat $n 你判斷不出哪邊是北方！
~
>room_mask south default~
echoat $n 你判斷不出哪邊是南方！
~
>room_mask up default~
echoat $n 在這個沒有重力的地方，你判斷不出哪邊是上方！
~
>room_mask down default~
echoat $n 在這個沒有重力的地方，你判斷不出哪邊是下方！
~
>room_mask exits default~
echoat $n 　
echoat $n 青與紫的電光在你的左手邊(left)交互纏繞
echoat $n 一望無際的深藍往你的右手邊(right)延伸而去
echoat $n 你的前方(front)閃爍著血似腥紅的暗芒
echoat $n 銀輝色的光河橫亙在你的身後(back)
echoat $n 你的頭頂(up)是深邃無邊的黑暗
echoat $n 你的腳底(down)是深邃無邊的黑暗
~
>room_command move down~
if is_qmark($n) == ismoving
	break
endif
if is_qmark($n) != wererat_plane
	add_qmark $n wererat_plane -1 13 0 0 1 0
endif
if is_qmark($n) != ismoving
	add_qmark $n ismoving 2 0 0 0 1 0
	echoat $n 你滑動著雙手，往深邃無邊的黑暗游去...
	echoaround $n $N滑動著雙手，往深邃無邊的黑暗游去...
	if rand(33)
		transfer $n 530
		force 530 echoaround $n $N往這裡游了過來...
	else
		if rand(50)
			transfer $n 531
			force 531 echoaround $n $N往這裡游了過來...
		else
			transfer $n 532
			force 532 echoaround $n $N往這裡游了過來...
		endif
	endif
endif
~
>room_command move up~
if is_qmark($n) == ismoving
	break
