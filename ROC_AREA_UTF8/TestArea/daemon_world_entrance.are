#555
dark fragment~
黑暗碎片(Dark Fragment)~
一小團晦暗不明的黑色物體(dark)在這裡蠕動著。
~
　　這團黑色霧狀物體在這裡吸收靠近它的光線，似乎有越來越膨脹的趨勢。
~
98 100 -1000 S
1 0 0 0d0+0 0d0+0
-1 0
0 8 0
R Demon~
>tick_prog 100~
		if is_qmark($i) != wererat_mob
				mpforcer here echo $I溶入了周遭的黑暗之中！
				mpmload 554
				mppurge self
		else
				mpforcer here echo $I的體型越來越大了....
		endif
~
>repop_prog 100~
		mpadd_qmark $i wererat_mob 3 0 0 0 1 0
		mpadd_qmark self delayed_stun -1 0 0 0 0 1
		mpadd_qmark self enable_fight_tick -1 0 0 0 1 0
		mpteleport vnum 533 548
		mpforcer here echo 四處散落的黑暗聚集了起來！
~
>death_prog 100~
		if is_qmark($n) < wererat_save 300020
				mpechoat $n [0m[33;1m你身上來自界域封印的神聖力量將黑暗碎片溶解了！[0m
				mpechoaround $n $N[0m[33;1m身上來自界域封印的神聖力量將黑暗碎片溶解了！[0m
				mpmod_qmark $n wererat_save v2 + 1
				if is_qmark($n) == wererat_save 300020
						mpechoat $n [0m[35m附著在你身上的神聖力量已經完全耗盡了...[0m
				endif
				mpgreward exp $n 36 500
				mpgreward exp $n basic 500
				mpgreward skexp $n 36 10
				if mobcount(555) != 1
				or mobcount(554) != 0
						mpoload 560 $n viclv floor
						if rand(50)
							mpoload 560 $n viclv floor
						endif
						if rand(25)
							mpoload 560 $n viclv floor
						endif
				else
						mpforcer here echotoarea 當瀰漫空間的黑暗全都消散的時候，整個空間忽然劇烈地震動起來！
						mpoload 560 $n viclv floor
						if rand(50)
							mpoload 560 $n viclv floor
						endif
						if rand(25)
							mpoload 560 $n viclv floor
						endif
						mpmload 556
						mpforcer here modrvt 533 v0 = 1
						mpforcer here modrvt 534 v0 = 1
						mpforcer here modrvt 535 v0 = 1
						mpforcer here modrvt 536 v0 = 1
						mpforcer here modrvt 537 v0 = 1
						mpforcer here modrvt 538 v0 = 1
						mpforcer here modrvt 539 v0 = 1
						mpforcer here modrvt 540 v0 = 1
						mpforcer here modrvt 541 v0 = 1
						mpforcer here modrvt 542 v0 = 1
						mpforcer here modrvt 543 v0 = 1
						mpforcer here modrvt 544 v0 = 1
						mpforcer here modrvt 545 v0 = 1
						mpforcer here modrvt 546 v0 = 1
						mpforcer here modrvt 547 v0 = 1
						mpforcer here modrvt 548 v0 = 1
				endif
				mppurge self
		else
				mpforcer here echo $I爆炸成許多黑光往四周逸散而去！
				mpmload 555
				mppurge self
		endif
~
