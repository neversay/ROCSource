>talk_prog topic~
if is_qmark($n) == circus_bobby_finding 100003
	say 快去將我的東西拿來吧！
	say 我才能將它改造，把它送給你。
	break
endif
if is_qmark($n) == circus_bobby_finding 100002
	say 沒想到您幫了我內人那麼大的一個忙。
	say 我實在不知道怎麼感謝您....，我有個東西送您。
	say 這邊是我的行李車的鑰匙，裡頭有我的一件物品。
	say 把東西拿給我，我可以將其改造然後把它送給您。
	mpoload 4403 10
	give key $n
	mpmod_qmark $n circus_bobby_finding v0 + 1
else
	say 想看我的表演啊！現在時間還沒到。
	say 等一下你再過來看看，或許可以看到我的表演。
endif
~
>give_prog 4407~
if is_qmark($n) == circus_bobby_finding 100003
	say 謝謝你了，我立即將他改造。
	mpechoat $n 你看到 $I 將護肘調整了一下....
	mpjunk bracers
	mpoload 4451 5
	give bracers $n
	mpexp $n 200
	say 這就是我給您的謝禮。
	bow $n
	wave $n
	mpdel_qmark $n circus_bobby_finding
	if is_qmark($n) != circus_quest
		mpadd_qmark $n circus_quest -1 2 0 0 0 1
	else
		if is_qmark($n) !& circus_quest 100002
			mpmod_qmark $n circus_quest v0 | 2
		endif
	endif
endif
~
