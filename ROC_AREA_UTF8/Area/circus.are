  mpadd_qmark $n slum_strong_notalk 10 1 0 0 1 1
  if is_qmark($n) & slum_libei_quest 300064
    	if is_qmark($n) & slum_wis_quest 216384
      		mpmod_qmark $n slum_wis_quest v1 | 32768
      		mpechoat $n 你擺出一副兇惡的樣子，試圖嚇唬$I
      		if wis($n) >= 12
        		mpcall positive_1 $n
        		say 哼，你有一點底子又如何？給我叫他過來談！
      		else
        		mpmod_qmark $n slum_wis_quest v1 + 10
        		say 你以為你這副架勢嚇得了誰？給我叫他乖乖過來談！
      		endif
      		break
  	endif
  	if is_qmark($n) & slum_wis_quest 204096
      		mpmod_qmark $n slum_wis_quest v1 | 8192
      		mpechoat $n 你照著談判專家的話重複了上一次的內容。
      		if wis($n) >= 9
        		mpcall positive_1 $n
