>greet_prog 20~
if ispc($n)
	if is_qmark($n) & circus_quest 100002
		break
	endif
	if is_qmark($n) != circus_bobby_finding
		if rand(50)
			tell $n 你有看到我的小孩小鮑比(bobby)嗎？
		else
			mpecho $I 正焦急的到處尋找他的小孩小鮑比(bobby)。
			say 小鮑比，你在哪裡啊？
		endif
	endif
