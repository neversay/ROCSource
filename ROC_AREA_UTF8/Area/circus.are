~
>talk_prog bobby~
if is_qmark($n) != circus_bobby_finding
	say 小鮑比是我的孩子，他剛剛走失了。
	cry $n
endif
~
>talk_prog topic~
if is_qmark($n) & circus_quest 100002
	say 謝謝您的協助，我會永遠感激你的。
	bow $n
	break
endif
if is_qmark($n) != circus_bobby_finding
	mpecho $I 看起來似乎很著急的樣子。
	say 我的小孩小鮑比走失了，$n 可以幫我找到他嗎(yes/no)？
	break
endif
if is_qmark($n) == circus_bobby_finding 100000
	say 請趕緊找到小鮑比吧！
	break
endif
if is_qmark($n) == circus_bobby_finding 100001
	say 你真的找到小鮑比了，真是太感謝您了。
	say 你可以去找我的先生艾文(Ivan)，他會有謝禮的。
	mpechoat $n $I 話說完就往你指示的地方走去....
	mpechoaround $n $I 話說完就往 $n 指示的方向走去....
	mpexp $n 200
	mpmod_qmark $n circus_bobby_finding v0 + 1
	mpgoto bobby-boy
	mppurge bobby-boy
	mppurge self
endif
~
>talk_prog ivan~
if is_qmark($n) == circus_bobby_finding 100002
	say 我的先生艾文是馬戲團的大力士。
	say 他現在應該就在這附近。
	say 你在這裡逛一逛應該就可以找到他了。
endif
~
>talk_prog yes~
if is_qmark($n) & circus_quest 100002
	break
endif
if is_qmark($n) == circus_bobby_finding 100000
	say 請趕緊找到小鮑比吧！
	break
endif
if is_qmark($n) != circus_bobby_finding
	mpecho $I 對 $n 露出十分感激的表情....
	say 謝謝您的幫忙，當你找到小鮑比時請趕緊通知我。
	mpadd_qmark $n circus_bobby_finding -1 0 0 0 0 1
endif
~
>talk_prog restart~
if is_qmark($n) < circus_bobby_finding 100002
	mpechoat $n 由遠方傳來一陣聲響：這項任務已經重新開始了！
	mpdel_qmark $n circus_bobby_finding
endif
~
