	sigh $n
	say 那算了，我另請高明好了。
endif
~
>talk_prog restart~
if is_qmark($n) & circus_quest 100001
	break
endif
if is_qmark($n) == circus_employee_help 100000
	mpechoat $n 從遠方傳來一些聲響「你這個任務已經重新開始了。」
	mpdel_qmark $n circus_employee_help
endif
~
>give_prog 4453~
if is_qmark($n) & circus_quest 100001
	drop contract
	break
endif
if is_qmark($n) == circus_employee_help 100000
	mpexp $n 200
	say 實在太感謝你了，我們終於自由了，這是給您的禮物....。
	mpoload 4452 10
	give pole $n
	yell $n 解放了馬戲團可憐的員工們！
	mpjunk contract
	mpdel_qmark $n circus_employee_help
	if is_qmark($n) != circus_quest
		mpadd_qmark $n circus_quest -1 1 0 0 0 1
	else
		if is_qmark($n) !& circus_quest 100001
			mpmod_qmark $n circus_quest v0 | 1
		endif
	endif
endif
~
