	say 我們老闆永遠先考慮他自己，再來才是馬戲團。
	say 我們賺的大筆的錢，幾乎卻都被他鎖在保險箱裡。
	say 只有一些被他拿出來分給工作人員(employee)。
endif
~
>talk_prog employee~
if is_qmark($n) & circus_quest 100001
	break
endif
if is_qmark($n) != circus_employee_help
	say 我們不得不這樣為他賣命工作，
	say 因為老闆他擁有我們每個人的賣身契(contract)。
	say 我們是因為以前生活窮困，所以只好到馬戲團工作，
	say 簽下了賣身契。
endif
~
>talk_prog contract~
if is_qmark($n) & circus_quest 100001
	break
endif
if is_qmark($n) != circus_employee_help
	say 我們工作了那麼多年，早超過了契約上規定的內容。
	say 但老闆不願意放我們走，還請了不少保鏢保護他的保險箱。
	say 你願意替我們這些可憐的工作人員取回賣身契嗎(yes/no)？
endif
~
>talk_prog yes~
if is_qmark($n) & circus_quest 100001
	break
endif
if is_qmark($n) != circus_employee_help
	mpadd_qmark $n circus_employee_help -1 0 0 0 0 1
	say 謝謝，我們所有的工作人員都會感謝您的。
	say 取得賣身契後，請把它交給我們任何一個工作人員。
	say 加油！我們的英雄！
endif
~
>talk_prog no~
