      		break
  	endif
  	if is_qmark($n) & slum_wis_quest 201024
      		mpmod_qmark $n slum_wis_quest v1 | 2048
      		mpechoat $n 你小心地使用詞藻，將$I唬的一愣一愣。
      		mpcall negative_1 $n
      		mpcallout 1 say 嗯？你這是啥意思？你直接叫他來跟我講！別在後面耍小把戲！
      		break
  	endif
  	if is_qmark($n) & slum_wis_quest 200001
      		mpmod_qmark $n slum_wis_quest v1 | 512
      		mpcall negative_1 $n
      		say 哼，你們巢穴想退讓是不錯，但你沒有作主的權力，[1;37m傳話回去，[0m
      		say 告訴他想收山就乖乖摸鼻子回家，別放了這麼多話才低頭！
  	endif
  endif
~
>all_greet_prog 100~
  if is_qmark($n) != slum_libei_quest 300064     
	break
  endif
  if is_qmark($n) & slum_libei_quest 300064
    	if is_qmark($n) == slum_representative_nojob
      		say 黑幫的敵人，休想要我再跟你說任何一句話！
      		break
    	endif
    	if is_qmark($n) & slum_libei_quest 200064
		say .......
        	break
    	endif
    	if is_qmark($n) & slum_wis_quest 216384 
      		mpechoat $n 你帶著自信來到$I面前，將談判專家教你的招術用上。
      		mpcallout 1 say 哼，這樣就想唬我！叫你把那傢伙叫來你是沒聽到嗎？
      		mpcallout 2 mpcall judge $n
      		break
      	endif
    	if is_qmark($n) & slum_wis_quest 204096
      		say 哼，你又帶來啥新把戲了？
      		mpcallout 1 mpcall judge $n
      		break
      	endif
    	if is_qmark($n) & slum_wis_quest 201024
      		mpechoat $n 你將談判專家的吩咐牢記在心，小心地與$I談判
      		mpcallout 1 say 哼，憑你這種三腳貓還能作什麼？
      		mpcallout 1 mpcall judge $n
      		break
      	endif
    	if is_qmark($n) & slum_wis_quest 200001
      		mpechoat $n 你看到一名大漢在這裡，大概就是你要找的人吧！
      		mpechoat $n 你向他說明來意......
      		laugh
      		if sex($n) <= 1
        		mpcallout 1 say 哈，那膽小傢伙竟派了一個乳臭未乾的小子過來。
      		else
        		mpcallout 1 say 哈，他以為派個小姑娘來就有用啦？
      		endif
      		mpcallout 1 mpcall judge $n
    	endif
  endif
~
>defun_prog judge~
  mpcall eq $n
  mpechoat $n 你想起此次的任務，你只好克制殺人衝動，好好跟他談。
  mpechoat $n 你要使用強硬的態度來談(talk man positive)？
  mpechoat $n 還是使用退讓的態度談(talk man negative)？
~
>defun_prog eq~
  if wis($n) > 20
    	mpechoat $n 你聽了一肚子火，但你很理智地克制了衝動。
    	break
  endif
  if wis($n) > 15
    	mpechoat $n 你聽了一肚子火，但你勉強克制住衝動。
    	break
  endif
  if wis($n) > 12
    mpechoat $n 你聽了一肚子火，幾乎想開扁。
  else
    mpechoat $n 你滿腔怒火，差一點爆發。
  endif
~
