        		mpcallout 1 say 哼，你以為這樣就可以嚇住我？去叫你上面的那個出來談！
      		else
        		mpmod_qmark $n slum_libei_quest v1 + 10
        		mpcallout 1 say 哼，你以為這樣就可以嚇住我？去叫你上面的那個出來談！
      		endif
      		break
  	endif
  	if is_qmark($n) & slum_wis_quest 201024
      		mpmod_qmark $n slum_wis_quest v1 | 2048
      		mpechoat $n 你用強硬的態度來談判，$I顯然嚇了一跳。
      		mpcall positive_1 $n
