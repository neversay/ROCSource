~
0 0 4402
>room_enter 5 100~
if ispc($n)
	if is_qmark($n) != circus_quest
		add_qmark $n circus_quest -1 0 0 0 0 1
	endif
	if is_qmark($n) == circus_employee_help 100001
		del_qmark $n circus_employee_help
		mod_qmark $n circus_quest v0 | 1
		echoat $n 遠方傳來一陣聲響「本區域『解救工作人員』任務標記已經轉換成功」
	endif
	if is_qmark($n) == circus_bobby_finding 100004
		echoat $n 遠方傳來一陣聲響「本區域『小鮑比的媽媽』任務標記已經轉換成功」
		del_qmark $n circus_bobby_finding
		mod_qmark $n circus_quest v0 | 2
	endif
endif
~
