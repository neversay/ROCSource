~
>room_defun skarabrae_beaker_explode~
modrvt 3160 v0 = 1
modrvt 3160 t0 = 50
if pcnum($) > 0
        if rand(50)
                echoaround $r 轉眼間，那個燒杯便發生爆炸，裡面的液體噴到$R身上！
                echoat $r 燒杯忽然猛地爆炸，你被裡面的酸液正面噴中！
                if level($r) < 31
                        cast 'acid blast' $r 10
                else
                        if rand(50)
                                cast 2 'acid blast' $r 31
                        else
                                cast 'acid blast' $r 45
                        endif
                endif
        else
                echoaround $r 轉眼間，那個燒杯便發生爆炸，衝擊力波及到$R！
                echoat $r 燒杯忽然猛地爆炸，你措手不及被波及到！
                if level($r) < 31
                        cast 'shocking grasp' $r 10
                else
                        if rand(50)
                                cast 2 'shocking grasp' $r 31
                        else
                                cast 'shocking grasp' $r 45
                        endif
                endif
        endif
endif
~
