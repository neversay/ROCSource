                say 真是不好意思，讓你白忙了，另外那本書的問題我們已經解決了。
                say 你會原諒我的吧？哈哈哈哈哈哈......
                mpechoat $n 你在心裡想著：「把這個臭老頭痛打一頓應該不會被記仇......」
                mpmod_qmark $n skarabrae_study_quest01 v0 = 13
        endif
endif
~
>death_prog 100~
mpdis_magic self all
mpat 5 cast 'detect hidden'
mpat 5 cast 'detect invis'
mpat 5 cast infravision
if is_qmark($n) == skarabrae_study_quest01 100013
        if class($n) == 5
        or class($n) == 6
                yell 饒了我吧～$N～我以後不會再犯同樣的錯了～～
                mpexp $n 15000
                mpskillexp $n 5000
                mpresp $n 1
                mpdel_qmark $n skarabrae_study_quest01
                mpmod_qmark $n skarabrae_study_questmark v0 | 1
        endif
endif
