>talk_prog raft~
say 你想要坐船(board)嗎？我得看一下港內是否有提供漁船載客。
mpgoto ferryman-d
if is_qmark(ferryman-d) == mist_ferryage
        if is_qmark(ferryman-d) != mist_ferryage_waiting
                mpgoto 3049
                say 抱歉，現在港內並沒有漁船，請等待。
        else
                mpgoto 3049
                say 現在港內有一艘漁船停靠，你想要搭乘嗎？
                say 請給我12萬元金幣，我得將一半付給船夫，
                say 另外一半就當作手續費吧！
        endif
else
        mpgoto 3049
        say 現在港內有一艘漁船停靠，你想要搭乘嗎？
        say 請給我12萬元金幣，我得將一半付給船夫，
        say 另外一半就當作手續費吧！
endif
~
>rand_prog 20~
if rand(30)
        say 乘坐渡船到迷霧之島會比較安全，通常不會受到天氣的影響。
        break
endif
if rand(30)
        say 乘坐漁船到迷霧之島的速度會比較快，但是由於船體本身比
        say 較小，因此如果海上有風浪的話就會有翻覆的可能。
else
        say 想要坐漁船(raft)嗎？漁船的速度比渡輪還快喔！
endif
~
>fight_prog 100~
mpat 5 c 'full heal'
c 3 powerball
mpgoto self
~
>talk_prog topic~
if is_qmark($i) == misty_captain_ferryage 100002
or is_qmark($i) == misty_captain_ferryage 100004
        if rand(50)
                mpecho $I 說著「你想要登船(board)船嗎？現在沒有船隻停泊在港口內，請等待。」
        else
                mpecho $I 說著「海上最易迷失，請小心。」
        endif
        break
endif
if is_qmark($i) == misty_captain_ferryage 100001
        mpecho $I 說著「現在有一艘豪華渡船在港內，您要登船(board)嗎？」
        break
endif
if is_qmark($i) == misty_captain_ferryage 100003
        mpecho $I 說著「現在有一艘普通渡船在港內，你要登船(board)嗎？」
endif
~
>talk_prog board~
if is_qmark($i) == misty_captain_ferryage 100001
                mpecho $I 說著「豪華渡船到 迷霧之島 的費用是 300000 元。」
                break
        endif
        if is_qmark($i) == misty_captain_ferryage 100003
                mpecho $I 說著「普通渡船到 迷霧之島 的費用是 100000 元。」
        else
                mpecho $I 說著「現在沒有船隻停泊在港口內，請等待。」
        endif
~
>bribe_prog 300000~
if is_qmark($i) == misty_captain_ferryage 100001
        if is_qmark($i) < misty_captain_ferryage 200050
                nod
                mpecho $I 說著「好， $n 你可以上船了。」
                mpechoat $n 你登上了豪華渡船的甲板上....。」
                mpjunk coins
                mptransfer $n 4501
                mpmod_qmark self misty_captain_ferryage v1 + 1
                break
        endif
        if is_qmark($i) == misty_captain_ferryage 200050
                shake
                mpecho $I 說著「豪華渡船的載重有限，頂多只能 50 個人上去。」
                mpecho $I 說著「現在船上已經滿 50 個人了，請下次再來。」
                give 300000 coins $n
        endif
else
        mpjunk coins
endif
~
>bribe_prog 120000~
mpjunk all.coins
mpgoto ferryman-d
if is_qmark(ferryman-d) == mist_ferryage
        if is_qmark(ferryman-d) != mist_ferryage_waiting
                mpgoto 3049
                say 我已經跟你說過現在港內沒有漁船了，
                say 你還給我錢做什麼呢？
                mpjunk all.coins
                mpgold $n 120000
        else
                if is_qmark(ferryman-d) >= mist_ferryage 100005
                        mpgoto 3049
                        say 抱歉，漁船的承載量已經到達上限。
                        say 只好請你等待下一次漁船進港了。
                        break
                endif
                mpmod_qmark ferryman-d mist_ferryage v0 + 1
                mpgoto 3049
                mpechoat $n $I 說著「好的， $n 你可以上船了....。」
                mpechoat $n 經由維芬海港的碼頭，你登上了一艘小漁船....。
                mpechoaround $n $n 經由維芬海港的碼頭登上了一艘漁船....。
                mptransfer $n 4672
        endif
else
        mpadd_qmark ferryman-d mist_ferryage_waiting 3 0 0 0 0 1
        mpadd_qmark ferryman-d mist_ferryage 51 1 0 0 0 1
        mpforce ferryman-d mpat 3001 yell 前往光明之鎮的漁船快要開了....。
        mpforce ferryman-d mpat 3001 yell 請趕快到維芬海港向船長登記上船....。
        mpgoto 3049
        mpechoat $n $I 說著「好的， $n 你可以上船了....。」
        mpechoat $n 經由維芬海港的碼頭，你登上了一艘小漁船....。
        mpechoaround $n $n 經由維芬海港的碼頭登上了一艘漁船....。
        mptransfer $n 4672
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
~
>bribe_prog 100000~
if is_qmark($i) == misty_captain_ferryage 100003
        if is_qmark($i) < misty_captain_ferryage 200010
                nod
                mpecho $I 說著「好， $n 你可以上船了。」
                mpechoat $n 你登上了普通渡船的甲板上....。
                mpjunk coins
                mptransfer $n 4516
                mpmod_qmark self misty_captain_ferryage v1 + 1
                break
        endif
        if is_qmark($i) == misty_captain_ferryage 200010
                shake
                mpecho $I 說著「普通渡船的載重有限，頂多只能 10 個人上去。」
                mpecho $I 說著「現在船上已經滿 10 個人了，請下次再來。」
                give 100000 coins $n
        endif
else
