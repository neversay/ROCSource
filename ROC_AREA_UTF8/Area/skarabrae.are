	if objval1($o) == 45
		if level($n) >= 10
			opmodify_obj_affect self 19 - 12 -1
		endif
		if level($n) >= 20
			opmodify_obj_affect self 18 - 12 -1
		endif
		if level($n) >= 30
			opmodify_obj_affect self 43 - 50 -1
			oset self value1 = 10
			oset self value2 = 15
		endif
	endif
endif
