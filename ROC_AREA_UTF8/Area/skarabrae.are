endif
~
>tick_prog 100~
if month($) == 3
        or month($) == 6
        or month($) == 9
        or month($) == 12
        or month($) == 15
                if day($) == 0
                        if hour($) == 8
                                yell [1;32m往迷霧之島(Misty Island)的豪華渡船開放旅客登記....！[0m
                                mpgoto ferryman-a
                                if is_qmark(ferryman-a) != misty_ferryman-a_ferryage
                                        mpadd_qmark ferryman-a misty_ferryman-a_ferryage -1 1 0 0 0 1
                                else
                                        mpmod_qmark ferryman-a misty_ferryman-a_ferryage v0 = 1
                                endif
                                mptransfer ferryman-a 4502
                                mpgoto 3049
                                if is_qmark($i) != misty_captain_ferryage
                                        mpadd_qmark self misty_captain_ferryage -1 1 0 0 0 1
                                else
                                        mpmod_qmark self misty_captain_ferryage v0 = 1
                                endif
                                break
                        endif
                        if hour($) == 13
                                yell [1;32m往迷霧之島(Misty Island)的豪華渡船要開了，請趕快上船。[0m
                                break
                        endif
                        if hour($) == 14
                                yell [1;32m往迷霧之島(Misty Island)的豪華渡船已經出發了....！[0m
                                mpgoto ferryman-a
                                if is_qmark(ferryman-a) != misty_ferryman-a_ferryage
                                        mpadd_qmark ferryman-a misty_ferryman-a_ferryage -1 2 0 0 0 1
                                else
                                        mpmod_qmark ferryman-a misty_ferryman-a_ferryage v0 = 2
                                endif
                                mpgoto 3049
                                if is_qmark($i) != misty_captain_ferryage
                                        mpadd_qmark self misty_captain_ferryage -1 2 0 0 0 1
                                else
                                        mpmod_qmark self misty_captain_ferryage v0 = 2
                                        mpmod_qmark self misty_captain_ferryage v1 = 0
                                endif
                        endif
                endif
                break
        endif
        if day($) == 0
        or day($) == 7
        or day($) == 14
        or day($) == 21
        or day($) == 28
                if hour($) == 8
                        yell [1;32m往迷霧之島(Misty Island)的普通渡船開放旅客登記....！[0m
                        mpgoto ferryman-b
                        if is_qmark(ferryman-b) != misty_ferryman-b_ferryage
                                mpadd_qmark ferryman-b misty_ferryman-b_ferryage -1 1 0 0 0 1
                        else
                                mpmod_qmark ferryman-b misty_ferryman-b_ferryage v0 = 1
                        endif
                        mpgoto 3049
                        mptransfer ferryman-b 4517
                        if is_qmark($i) != misty_captain_ferryage
                                mpadd_qmark self misty_captain_ferryage -1 3 0 0 0 1
                        else
                                mpmod_qmark self misty_captain_ferryage v0 = 3
                        endif
                        break
                endif
                if hour($) == 13
                        yell [1;32m往迷霧之島(Misty Island)的普通渡船要開了，請趕快上船。[0m
                        break
                endif
                if hour($) == 14
                        yell [1;32m往迷霧之島(Misty Island)的普通渡船已經出發了....！[0m
                        mpgoto ferryman-b
                        if is_qmark(ferryman-b) != misty_ferryman-b_ferryage
                                mpadd_qmark ferryman-b misty_ferryman-b_ferryage -1 2 0 0 0 1
                        else
                                mpmod_qmark ferryman-b misty_ferryman-b_ferryage v0 = 2
                        endif
                        mpgoto 3049
                        if is_qmark($i) != misty_captain_ferryage
                                mpadd_qmark self misty_captain_ferryage -1 4 0 0 0 1
                        else
                                mpmod_qmark self misty_captain_ferryage v0 = 4
                                mpmod_qmark self misty_captain_ferryage v1 = 0
                        endif
                endif
        endif
endif
~
