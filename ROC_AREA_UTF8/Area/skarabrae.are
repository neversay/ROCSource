	if objval2($o) == 0
		oset self v2 = -1
		oset self v3 + 10
		oforce $n r100digit $o
	else
		oset self v2 - 1
		oset self v3 + 10
		oforcer here del_qmark $n gembanking
		odef_rembch null-tar
		oforce $n save
	endif
