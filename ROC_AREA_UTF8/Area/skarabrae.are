>all_greet_prog 100~
if isaffected($i) & 1
        mpdis_magic self blindness
endif
if isnpc($n)
        if name($n) == mayor-s
        or name($n) == terminator-s
        or name($n) / lancelot-skarabrae
        or name($n) / dynia-skarabrae
        or name($n) / pure
        or name($n) / Shida
        else
                say 這裡是史卡拉貝城神聖的聖殿....，
                say 不能有外來的生物侵入此處。
                mpecho $I 將 $N 傳送到了 長長的石階 去了....。
                mptransfer $n 3005
        endif
        break
endif
if rand(40)
        if hitprcnt($i) < 40
                cast 'double heal'
                mpnowait
        endif
        if is_qmark($n) == skarabrae_healer_help 100001
                angry $n
                break
        endif
        if hitprcnt($n) < 20
                say 讓我來幫你療傷吧!
                mpcallout 1 cast heal $n
                mpcallout 1 mpnowait
        else
                tell $n 需要我的幫忙嗎？
        endif
endif
~
>talk_prog topic~
mpechoat $n $I 說 '如果需要我幫你療傷只要告訴我 helpheal 就可以了'.
~
>talk_prog p helpheal~
if is_qmark($n) == skarabrae_healer_help 100001
        tell $n 你這個可惡的傢伙，我才不幫你治療呢！
        break
endif
if hitprcnt($n) >= 100
        tell $n 你並沒有受傷
        break
endif
if is_qmark($n) >= skarabrae_healer_help 1005
        shake $n
        tell $n 對不起，我的法力不夠了哦。
        if rand(10)
                mpmod_qmark $n skarabrae_healer_help timer - 2
        endif
        if rand(25)
                mpmod_qmark $n skarabrae_healer_help timer + 1
        endif
else
        tell $n 沒問題，讓我來治療你！
        cast 'cure critical' $n
        mpnowait
        if is_qmark($n) == skarabrae_healer_help
                mpmod_qmark $n skarabrae_healer_help timer + 3
        else
                mpadd_qmark $n skarabrae_healer_help 3 0 0 0 1 1
        endif
endif
~
>fight_prog 50~
cast blindness
mpnowait
cast 'double heal'
mpnowait
