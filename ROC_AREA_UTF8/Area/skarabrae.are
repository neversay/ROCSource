>talk_prog feenaisasuperbachi~
if is_qmark($n) == skarabrae_study_quest03 100010
        if is_qmark($n) == skarabrae_enemy
                mpgoto self
                mpechoat $n $I先是愣了一下，接著馬上將你拉到角落......
                tell $n 被通緝的狀態下不好行動，我替你打點一下吧。
                mpdel_qmark $n skarabrae_enemy
                tell $n 嗯，同志，辛苦你了，我等你好久了。
                tell $n 為了彼此的安全與未來的計劃，因此我們客套話就免了吧。
                tell $n 你趁著那幾個研究部要員不在時去搜搜他們的房間。
                tell $n 先搜對面的情報室，然後是隔壁的部長室。
                tell $n 再來依序是樓上的開發室、實驗室與研究室。
                tell $n 必要時動武也沒關係！
                mpmod_qmark $n skarabrae_study_quest03 v0 = 11
        else
                mpechoat $n $I先是愣了一下，接著馬上將你拉到角落......
                tell $n 嗯，同志，辛苦你了，我等你好久了。
                tell $n 為了彼此的安全與未來的計劃，因此我們客套話就免了吧。
                tell $n 你趁著那幾個研究部要員不在時去搜搜他們的房間。
                tell $n 先搜對面的情報室，然後是隔壁的部長室。
                tell $n 再來依序是樓上的開發室、實驗室與研究室。
                tell $n 必要時動武也沒關係！
                mpmod_qmark $n skarabrae_study_quest03 v0 = 11
        endif
endif
~
>talk_prog report~
if is_qmark($n) == skarabrae_study_quest03 100016
        mpechoat $n 你將搜集到的情報全都告訴了$I。
        tell $n 史卡拉貝軍方高層真的是瘋了，比我們之前所預測的還誇張！
        tell $n 干涉歷史、合成生物、禁忌武器、窮兵黷武的大侵攻計畫......
        tell $n 簡直是無藥可救，我得快點將這些情報告訴我的上級。
        tell $n 這些亂七八糟的計畫一定得破壞掉！
        mpechoat $n 你突然想起先前在部長室找到的奇怪東西，或許可以拿給$I看看......
        mpmod_qmark $n skarabrae_study_quest03 v0 = 17
endif
~
>talk_prog demon~
if is_qmark($n) == skarabrae_study_quest03 100021
        tell $n 好啦，現在又多了召喚惡魔這一項計畫案。
        tell $n 史卡拉貝軍方高層幹的事可真是三隻小豬......更正，罄竹難書。
        tell $n 不管怎樣，現在你還有一件事要做。
        tell $n 就是將這些情報告訴我的同志，讓他帶回本部去研擬對策。
        mpmod_qmark $n skarabrae_study_quest03 v0 = 22
endif
~
>give_prog 3319~
if is_qmark($n) == skarabrae_study_quest03 100017
        tell $n 嗯......這個東西似乎是個造型比較怪異的盒子，而且還上了封印。
        tell $n 不過這難不倒我的，用中和的咒文就可以......好，開了。
        tell $n 喔喔，這好像是戒指型態的魔法鑰匙，不曉得是用來開哪裡的鎖。
        mpecho $I將盒子砸了，把盒內的東西交給了你。
        tell $n 如果找到了什麼，記得來告訴我啊。
        mpoload 3320 $n 36 target
        mpmod_qmark $n skarabrae_study_quest03 v0 = 18
endif
~
>fight_prog 100~
