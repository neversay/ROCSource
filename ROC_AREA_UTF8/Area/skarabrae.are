>talk_prog survey~
if is_qmark($i) & thief_quest_solved 100001
        break
endif
if is_qmark($n) >= thief_quest_list 200001
        say 先把已經接下來的任務完成再說吧。
        break
endif
if is_qmark($n) & thief_quest_list 100001
        say 委託人希望我們幫他調查飛翔的妖精(flying fairy)
        say 尼爾森(Nelson)身上帶著什麼樣的寶物，你就幫他跑這一趟吧。
        gig
        say 對了，只需要告訴我名字就好，不必偷過來...
        mpmod_qmark $n thief_quest_list v1 = 1
        if is_qmark($i) == thief_quest_solved
                mpmod_qmark self thief_quest_solved v0 | 1
                mpmod_qmark self thief_quest_solved timer + 12
        else
                mpadd_qmark self thief_quest_solved 12 1 0 0 1 0
        endif
        if mobcount(3052) == 0
                mpat 3024 mpmload 3052
        else
                mpat 5 cast 'detect invis'
                mpat 5 cast 'detect hidden'
                mpat 5 cast infravision
                mpat nelson mpforce nelson mpjunk all
        endif
        if rand(50)
                if rand(50)
                        mpat nelson mpoload 3041 nelson 15 target
                        mpmod_qmark self thief_quest_solved v1 = 1
                else
                        mpat nelson mpoload 3051 nelson 1 target
                        mpmod_qmark self thief_quest_solved v1 = 2
                endif
        else
                if rand(50)
                        mpat nelson mpoload 3036 nelson 15 target
                        mpmod_qmark self thief_quest_solved v1 = 3
                else
                        mpat nelson mpoload 13030 nelson 5 target
                        mpmod_qmark self thief_quest_solved v1 = 4
                endif
        endif
endif
