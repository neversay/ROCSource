1|2|128 8|32 400 S
23 0 0 0d0+0 0d0+0
0 0
0 8 1
P 8|128
>tick_prog 100~
if is_qmark($i) == myroad_talking
	if being($b)
		break
	else
		mpdel_qmark self myroad_talking
	endif
endif
~
>talk_prog topic~
if is_qmark($i) == myroad_talking
	tell $n 我在跟人說話，你給我閉嘴！
	break
endif
if is_qmark($n) == adv_mission_mark 200004
	mpechoat $n 你向他表示自己是冒險者公會介紹的人。
	mpdel_qmark $n adv_mission_mark
	mpmod_qmark $n adv_mission_complete v1 | 4
	mpcallout 1 tell $n 我等好久了呢，可終於來了！
	mpcallout 1 hop $n
	mpcallout 2 tell $n 的巫師而努力。
	mpcallout 2 tell $n 我先自介一下；我的身份是法師公會中的實習巫師，正為了成為能獨當一面
	mpcallout 3 tell $n 研究論文；所以，我也正面臨著論文的折磨....
	mpcallout 3 tell $n 然而想從公會中走出去成為一位有牌的巫師，就必須先提出受人認可的魔法
	mpcallout 4 sigh
	mpcallout 5 tell $n 能夠實現，我相信這將會成為世界上最偉大的魔法之一！
	mpcallout 5 tell $n 不過呢，前陣子我在馬桶上想到了一個非常有建設性的理論！如果這個理論
	mpcallout 6 mpechoat $n $I開始陷入自己的腦內小劇場中....(continue)
	mpcallout 6 mpadd_qmark $n adv_myroad -1 0 0 0 0 1
	mpcallout 6 good self
endif
~
>talk_prog continue~
if is_qmark($i) == myroad_talking
	tell $n 我在跟人說話，你給我閉嘴！
	break
endif
if is_qmark($n) == adv_myroad 300000
	mpmod_qmark $n adv_myroad v2 = 1
	mpechoat $n 你稍微輕咳一下，示意要他繼續說下去。
	tell $n 啊...抱歉，突然神游了一下。
	giggle
	mpcallout 1 tell $n 那麼切入我這次委託的內容吧！
	mpcallout 2 tell $n 的人。只要每跑一次腿把東西帶回，我就會當場給十萬元，絕不糊弄！
	mpcallout 2 tell $n 者公會作為人力仲介的窗口多請幾個人來幫忙，所以我的酬勞也是只給找到
	mpcallout 2 tell $n 的委託就是要請人幫忙找尋文獻，不過因為東西不太好找，所以才想以冒險
	mpcallout 2 tell $n 我的理論中目前還存在部分的缺陷，大概需要用幾種文獻來驗證；而我這次
	mpcallout 4 tell $n 顯示，最後一次出現在魔法高塔的書庫中，要麻煩你幫忙找找(search)了。
	mpcallout 4 tell $n 那麼先請你去幫我找出高級火燄咒文書(book)，這本書從法師公會的記錄上
	mpcallout 5 bow $n
endif
~
>talk_prog result~
if is_qmark($i) == myroad_talking
	tell $n 我在說話，給我閉嘴乖乖聽！
	break
endif
if is_qmark($n) == myroad_timer
	mpechoat $n 他專心的作著研究，沒注意到你。
	break
endif
if is_qmark($n) == adv_myroad 300002
	mpdef_rembch $n
	mpadd_qmark self myroad_talking -1 0 0 0 0 1
	tell $n 你來啦，在上次那本書中我發現.....%@#!@#%^#$%
	mpechoat $n 他開始對你長篇大論....
	mpcallout 1 talk self ll_talking
endif
if is_qmark($n) == adv_myroad 300004
	mpdef_rembch $n
	mpadd_qmark self myroad_talking -1 0 0 0 0 1
	tell $n 你來啦，在上次那本書中我發現.....%@#!@#%^#$%
	mpechoat $n 他開始對你長篇大論....
	mpcallout 1 talk self ll_talking
endif
~
>talk_prog ll_talking~
if name($n) / young-skara-my
	if being($b)
		if insameroom($b)
			if is_qmark($b) == adv_myroad 300002
				if is_qmark($i) >= myroad_talking 100005
					talk self llt_f1
				else
					mpechoat $b 他開心地對你說著自己的研究內容...
					mpcallout 3 talk self ll_talking
					mpcallout 3 mpmod_qmark self myroad_talking v0 + 1
				endif
			endif
			if is_qmark($b) == adv_myroad 300004
				if is_qmark($i) >= myroad_talking 100005
					talk self llt_f2
				else
					mpechoat $b 他開心地對你說著自己的研究內容...
					mpcallout 3 talk self ll_talking
					mpcallout 3 mpmod_qmark self myroad_talking v0 + 1
				endif
			endif
		else
			tell $b 你怎麼沒聽我說完就跑了呢？
			tell $b 給我回來重聽一次！
			mpdef_rembch null-tar
		endif
	else
		mpdel_qmark self myroad_talking
		mpdef_rembch null-tar
	endif
endif
~
>talk_prog llt_f1~
if name($n) / young-skara-my
	if being($b)
		if insameroom($b)
			mpcallout 2 mpechoat $b 他終於說完了...顯然他沒發現你根本不想聽。
			mpcallout 3 tell $b 本書，書名是高級寒冰咒文書。
			mpcallout 3 tell $b 總之呢，我發現到光是只有這本書是不夠的，所以希望你能再幫我去找另一
			mpcallout 4 tell $b 在哪邊就不得而知了。
			mpcallout 4 tell $b 根據記錄指出，這本古書最早被發現的地方是在永恆之塔的書櫃中，不過放
			mpcallout 5 tell $b 至於報酬的部分就跟上次一樣，那萬事拜託囉。
			mpcallout 5 mpmod_qmark $b adv_myroad v2 = 3
			mpcallout 5 mpdel_qmark self myroad_talking
			mpcallout 6 mpat $b mpechoat $b 你突然覺得只為區區十萬好像有點不太划算....
			mpcallout 7 mpdef_rembch null-tar
		else
			tell $b 你怎麼沒聽我說完就跑了呢？
			tell $b 給我回來重聽一次！
			mpdef_rembch null-tar
		endif
	else
		mpdel_qmark self myroad_talking
		mpdef_rembch null-tar
	endif
endif
~
>talk_prog llt_f2~
if name($n) / young-skara-my
	if being($b)
		if insameroom($b)
			mpcallout 2 mpechoat $b 他終於說完了...顯然他沒發現你根本不想聽。
			mpcallout 3 tell $b 總之，我又發現光是有這本書也還是不夠，所以希望你能再幫我去找個人。
			mpcallout 4 tell $b 造之中，有一項是能盛裝魔法的容器，我想要知道這個的作法。
			mpcallout 4 tell $b 製造都難不倒他，尤其是魔藥跟魔法人偶的創造更是他的專常。而在他的創
			mpcallout 4 tell $b 我在書上看過，在奈圖有位專攻物質創造的國家鍊金術師，對於各種物質的
			mpcallout 5 tell $b 然而....我也沒見過本人，不過書上既然這樣寫，那肯定不會有錯啦！
			mpcallout 6 mpechoat $b 你心想：連存不存在都不知道的人，還要去找...
			mpcallout 7 tell $b 譽。或許可以跟當地居民打聽看看練金術師 荷菲夫(Hovav)的情報。
			mpcallout 7 tell $b 不過，書上還有記載，據說在奈圖王國中，他與祭司沙德倫有著同樣高的聲
			mpcallout 8 tell $b 那麼，為了我的理論，請你多加努力吧！另外報酬的部分與之前相同。
			mpcallout 8 mpmod_qmark $b adv_myroad v2 = 5
			mpcallout 8 mpdel_qmark self myroad_talking
			mpcallout 9 mpat $b mpechoat $b 你發現十萬連光明鎮來回都不夠....確定要繼續陪這個怪咖鬧下去嗎？
			mpcallout 10 mpdef_rembch null-tar
		else
			tell $b 你怎麼沒聽我說完就跑了呢？
			tell $b 給我回來重聽一次！
			mpdef_rembch null-tar
		endif
	else
		mpdel_qmark self myroad_talking
		mpdef_rembch null-tar
	endif
endif
