>all_greet_prog 100~
if isaffected($i) & 1
        c 'cure blindness'
endif
if isaffected($i) !& 128
        c sanc
endif
if is_qmark($n) == skarabrae_enemy
        mpecho $I 說：史卡拉貝城的敵人，看招....！
        mpkill $n
        break
endif
