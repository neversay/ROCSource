>rand_prog 100~
if ispc($r)
        if is_qmark($r) == skarabrae_enemy
                yell 終結史卡拉貝城的敵人$R！
                mpkill $r
                hunt $r
                mpnowait
                frenzy
                mpnowait
        endif
endif
~
>entry_prog 100~
if insameroom(mayor)
	say 您好！市長，您辛苦了。
	mpforce mayor say 不客氣，您也辛苦了。
	break
endif
if insameroom(cur-skarabrae)
	say 可惡的惡狗，看招！
	mpkill cur-skarabrae
	break
endif
if insameroom(rogue-skarabrae)
	say 可惡的惡棍，看招！
	mpkill rogue-skarabrae
	break
endif
