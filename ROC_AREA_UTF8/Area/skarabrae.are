>tick_prog 80~
if inroom($i) != 3225
	if is_qmark($n) != tall_lord_timer
	or notbeing($b)
		say 我很擔心我的佃農們，必須回去看看...
		wave
		if being(braver)
		mpat braver mppurge braver
		endif
		mppurge self
		break
	endif
endif
if area($i) == skarabrae
or area($i) == haon
or area($i) == hitower
or area($i) == draconia
	break
endif
say 我很擔心我的佃農們，必須回去看看...
wave
if being(braver)
	mpat braver mppurge braver
endif
mppurge self
