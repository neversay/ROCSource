>defun_prog negotiate~
mpechoat $n 你開始運用你的三吋不爛之舌與老闆殺價......
if wis($n) >15
or int($n) >19
or resp($n) >5
        mpechoat $n 經過一陣討價還價之後，你終於砍掉一些價錢。
        if level($n) <= 21
                mpcallout 1 say 好啦，算你三千就好。
                break
        endif
        if level($n) <= 28
                mpcallout 1 say 好啦，算你五千就好。
                break
        endif
        if level($n) <= 35
                mpcallout 1 say 好啦，算你八千就好。
                break
        endif
        if level($n) <= 42
                mpcallout 1 say 好啦，算你一萬五就好。
                mpcallout 2 mpechoat $n 你有一種進了黑店的感覺。
                break
        endif
endif
mpcallout 1 mpechoat $n 很可惜老闆不吃你這一套，你失敗了。
~
