>all_greet_prog 100~
if isaffected($i) & 1
        mpdis_magic self blindness
endif
if is_qmark($n) == skarabrae_enemy
        if mobcount(3011) > 0
                yell 執法者，請擊退史卡拉貝的敵人$N吧！
                if insameroom(enforcer-skarabrae)
                        mptransfer enforcer-skarabrae
                endif
                mpforce enforcer-skarabrae hunt $n
                mpforce enforcer-skarabrae frenzy
                hunt $n
                mpnowait
        else
                say 史卡拉貝的敵人，覺悟吧！
                hunt $n
                frenzy
        endif
else
        if isnpc($n)
                if name($n) == mayor-s
                or name($n) == terminator-s
                else
                        say 這裡是史卡拉貝城的銀行....，
                        say 外來的生物不能隨便闖入！
                        mpecho $I將$N給「請」出銀行門外。
                        mptransfer $n 3224
                endif
        endif
endif
~
