>kill_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) == skarabrae_enemy
        mpdel_qmark $n skarabrae_enemy
endif
if is_qmark($i) != skarabrae_exe_kill
        mpadd_qmark self skarabrae_exe_kill 5 0 0 0 1 0
else
        if is_qmark($i) <= skarabrae_exe_kill 100005
                mpmod_qmark self skarabrae_exe_kill v0 + 1
        else
                mpecho $I 利用連續許多冒險者短時間連續死亡的能量，讓自己再度精神飽滿....
                mpdis_magic self 'seal magic'
                mpnowait
                mpdel_qmark self skarabrae_exe_kill
                mpat 5 c 'full heal'
                mpnowait
        endif
endif
if ispc($n)
        if is_qmark($n) != skarabrae_exe_kill
                mpadd_qmark $n skarabrae_exe_kill 10 0 0 0 0 1
        else
                if is_qmark($n) <= skarabrae_exe_kill 100005
                        mpmod_qmark $n skarabrae_exe_kill v0 + 1
                else
                        mpecho $I 利用$N短時間連續死亡的能量再度讓自己精神飽滿....
                        mpdis_magic self 'seal magic'
                        mpnowait
                        mpdel_qmark self skarabrae_exe_kill
                        mpat 5 c 'full heal'
                        mpnowait
                endif
        endif
endif
~
