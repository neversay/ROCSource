>talk_prog signet~
if is_qmark($i) == old_student_talking
	mpechoat $n $I正在說話。
	break
endif
if is_qmark($n) == mist_clean_quest 100005
or is_qmark($n) == mist_clean_quest 100006
	mpadd_qmark self old_student_talking
	mpechoat $n 你把金屬印記(metal signet)的事情告訴$I。
	mpmod_qmark $n mist_clean_quest v0 = 7
	mpcallout 1 hmm
	mpcallout 2 tell $n 我知道了，那麼把東西拿來給我看看吧。
	mpcallout 2 mpdel_qmark self old_student_talking
else
	mpechoat $n 他專心的讀著書，沒發現到你的存在。
endif
~
>talk_prog difficult~
if is_qmark($i) == old_student_talking
	mpechoat $n $I正在說話。
	break
endif
if is_qmark($n) == mist_clean_quest 100008
	mpadd_qmark self old_student_talking
	mpmod_qmark $n mist_clean_quest v0 = 9
	tell $n 對於史卡拉貝學界的派系權利鬥爭，你應該也略有耳聞吧....
	tell $n 而學者習慣將文字暗號化的原因就是為了避免重要的訊息被對手得知。
	tell $n 畢竟，許多研究內容跟見不得光的訊息都可能影響學界的勢力分佈。
	mpcallout 2 shrug
	mpcallout 2 tell $n 這樣你覺得完整解密的可能性如何？除非找得到解碼本....
	mpcallout 2 tell $n 換言之，光是整天研究暗號就能搞出幾百篇的論文了呢！
	mpcallout 2 tell $n 據可信的統計指出，史卡拉貝學術界只計算史學家的部分，就發展出至少有上百種的暗號。
	mpcallout 4 tell $n 最簡單的方法就是把作者找出來讓他分析就行啦！的文獻全翻過一次，應該能作到部分解碼的程度。
	mpcallout 4 tell $n 不過，既然都知道是誰編寫的暗號，要解析內容也不是件辦不到的事情。
	mpcallout 5 tell $n 這樣只能採取另一種極端的方法了。(method)
	mpcallout 5 tell $n 但從你之前的敘述上看來，歐米拉在這次出外考察中恐怕也凶多吉少，要找到活人可能會有難度....
	mpcallout 5 mpdel_qmark self old_student_talking
endif
~
>talk_prog method~
if is_qmark($i) == old_student_talking
	mpechoat $n $I正在說話。
	break
endif
if is_qmark($n) == mist_clean_quest 100009
	mpadd_qmark self old_student_talking
	mpmod_qmark $n mist_clean_quest v0 = 10
	tell $n 雖然人可能找不到了，但是他以前寫的文獻還儲藏在史卡拉貝管理的圖書館中。
	tell $n 只要把他留下的創作全讀過一次，雖不能保證完整分析，但總能看出些端倪吧？
	tell $n 部分了解也強過什麼都不懂。
	mpcallout 2 tell $n 我會幫你分析內容，看看能否找出些暗號的規則。
	mpcallout 2 tell $n 如果想知道內容，要麻煩你收集歐米拉的著作(gather literature)後交給我。
	mpcallout 3 addoil $n
	mpcallout 3 tell $n 所以要請你盡可能的多找文獻拿來。
	mpcallout 3 tell $n 最後提醒你，給的資料越多完整解碼的機會也就越大，如果東西太少可能連點屁都看不出來。
	mpcallout 3 mpdel_qmark self old_student_talking
	mpcallout 4 mpechoat $n 總之，先到週邊的圖書館晃晃，或許在某些地方還能找得到歐米拉的著作也不一定。
endif
~
>defun_prog analysis_literature~
mpcallout 1 mpechoat $n $I著手讀起拿到的資料。
mpcallout 2 mpechoat $n $I仔細研讀著手內的資料。
mpcallout 4 mpechoat $n $I仔細研讀著手內的資料。
mpcallout 6 mpechoat $n $I仔細研讀著手內的資料。
mpcallout 8 mpechoat $n $I開始分析起金屬印記(metal signet)上的暗號....
mpcallout 9 mpechoat $n $I仔細分析金屬印記(metal signet)上的暗號....
mpcallout 11 mpechoat $n $I仔細分析金屬印記(metal signet)上的暗號....
if is_qmark($n) == mist_clean_quest 300001
	mpcallout 13 tell $n 但有找出幾個重要的關鍵字，讓我說給你聽聽吧。
	mpcallout 13 tell $n 呼...手中的資料不足，果然還是沒辦法完整分析出整段文字呢。
	mpcallout 14 tell $n ...元素峽谷...鍊金術....藥(medicine)。　　歐米拉
	mpcallout 15 tell $n 雖然沒逐字翻出，但字詞應該都是正確的。
	mpcallout 16 wave $n
	mpcallout 16 tell $n 那麼祝你辦事順利。
	mpcallout 16 mpdel_qmark self old_student_talking
	mpcallout 16 mpmod_qmark $n mist_clean_quest v0 = 11
	mpcallout 17 mpechoat $n 看來要去元素峽谷找一個用鍊金術作藥的人。
endif
if is_qmark($n) == mist_clean_quest 300002
	mpcallout 13 tell $n 但暗號中的名詞倒是意外地都有找出來，先讓我說給你聽聽吧。
	mpcallout 13 tell $n 呼...手中的資料有些不足，要完整分析出整段文意還是有些困難呢。
	mpcallout 14 tell $n 想請你...元素峽谷...鍊金術...製造....治療藥(medicine)。　　歐米拉
	mpcallout 15 tell $n 雖然沒逐字翻出，但字詞應該都是正確的。
	mpcallout 16 wave $n
	mpcallout 16 tell $n 請你之後有空再來找我吧，祝你辦事順利。
	mpcallout 16 tell $n 另外暗號中有段獨立的文字讓我有些在意，可能要再花些時間分析。
	mpcallout 16 mpdel_qmark self old_student_talking
	mpcallout 16 mpmod_qmark $n mist_clean_quest v0 = 11
	mpcallout 17 mpechoat $n 看來要去元素峽谷找一個用鍊金術作藥的人。
endif
if is_qmark($n) == mist_clean_quest 300003
	mpcallout 13 tell $n 很意外的內容解碼出來了，我說給你聽聽吧。
	mpcallout 13 tell $n 呼...終於分析完了....
	mpcallout 14 tell $n 我想請你在元素峽谷用鍊金術製造出只有你會作的治療藥(medicine)。　　歐米拉
	mpcallout 15 tell $n 雖然沒逐字翻出，但內容大致上是這個意思。
	mpcallout 16 wave $n
	mpcallout 16 tell $n 請你之後有空再來找我吧，祝你辦事順利。
	mpcallout 16 tell $n 不過，暗號的排列似乎還隱藏著其他的意義讓我有些在意，可能要再花些時間分析。
	mpcallout 16 mpdel_qmark self old_student_talking
	mpcallout 16 mpmod_qmark $n mist_clean_quest v0 = 11
	mpcallout 17 mpechoat $n 看來要去元素峽谷找一個用鍊金術作藥的人。
endif
if is_qmark($n) == mist_clean_quest 300004
	mpcallout 13 tell $n 很意外的大部分內容都順利解碼完成了，我說給你聽聽吧。
	mpcallout 13 tell $n 呼...終於分析完了....
	mpcallout 14 tell $n 　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　歐米拉
	mpcallout 14 tell $n 畢竟製造靈藥這件事只有你作得到。
	mpcallout 14 tell $n 特拉恰斯(therachepist)，我想請你在元素峽谷運用鍊金術製造出治療百病的靈藥。
	mpcallout 15 tell $n 雖然還有部分沒完成，但大致上的內容就是這樣。
	mpcallout 16 wave $n
	mpcallout 16 tell $n 請你之後有空再來找我吧，祝你辦事順利。
	mpcallout 16 tell $n 不過，暗號的排列似乎還隱藏著其他的句意讓我有些在意，可能要再花些時間分析。
	mpcallout 16 mpdel_qmark self old_student_talking
	mpcallout 16 mpmod_qmark $n mist_clean_quest v0 = 11
	mpcallout 17 mpechoat $n 看來要去元素峽谷找一個叫特拉恰斯(therachepist)用鍊金術作靈藥的人。
endif
if is_qmark($n) == mist_clean_quest 300005
	mpcallout 13 tell $n 內容完整分析出來了，我說給你聽聽吧。
	mpcallout 13 tell $n 呼...終於分析完了....
	mpcallout 14 tell $n 　　　　　　　　　　　　　　　　　　　　　　　　　　　歐米拉
	mpcallout 14 tell $n 但仍希望你念在舊交情上，能幫助製造靈藥，畢竟這件事只有你作得到。
	mpcallout 14 tell $n 雖然在你遭人詆毀受到放逐時，我並沒有足夠的勇氣挺身幫助你。
	mpcallout 14 tell $n 吾友特拉恰斯(therachepist)，我想請你在元素峽谷運用鍊金術製造出治療百病的靈藥。
	mpcallout 15 mpechoat $n $I隨意地再次確認分析內容有無錯誤。
	mpcallout 15 tell $n 大概就是這樣....
	mpcallout 16 wow
	mpcallout 17 tell $n 疑？這個難道是...？！
	mpcallout 18 mpechoat $n $I突然想起你還在場，立即從驚訝中回復過來。
	mpcallout 19 wave $n
	mpcallout 19 tell $n 請你之後有空再來找我吧，祝你辦事順利。
	mpcallout 19 tell $n 啊...沒事我只是對暗號巧妙的規則有點驚訝，或許還能找出些什麼....
	mpcallout 19 mpdel_qmark self old_student_talking
	mpcallout 19 mpmod_qmark $n mist_clean_quest v0 = 11
	mpcallout 20 mpechoat $n 看來要去元素峽谷找一個叫特拉恰斯(therachepist)用鍊金術作靈藥的人。
	mpcallout 22 ponder
endif
~
>talk_prog decode~
if is_qmark($i) == old_student_talking
	mpechoat $n $I正在說話。
	break
endif
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) != mist_clean_quest 300000
		mpadd_qmark self old_student_talking
		tell $n 好，那我現在開始試著解暗號，你在這邊等我一下。
		mpcall analysis_literature $n
	else
		tell $n 你還沒給任何的資料，這樣我無從解碼呀！
	endif
endif
~
>give_prog 4235~
if is_qmark($n) != mist_clean_quest
	? $n
	give $o $n
	drop $o
	break
endif
if is_qmark($i) == old_student_talking
	tell $n 我現在沒空。
	give $o $n
	drop $o
	break
endif
if is_qmark($n) == mist_clean_quest 100005
or is_qmark($n) == mist_clean_quest 100006
	mpjunk $o
	mpadd_qmark self old_student_talking
	mpmod_qmark $n mist_clean_quest v0 = 8
	? $n
	mpcallout 1 tell $n 這個是....你從哪裡拿到的？
	mpcallout 2 mpechoat $n 你把事情的原委告訴了$I。
	mpcallout 4 tell $n 原來如此，從幾個符號的形狀能看出確實是史學家所用的加密方式之一。
	mpcallout 5 tell $n 不過要將這個完整解碼可能會有些困難....(difficult)
	mpcallout 5 mpdel_qmark self old_student_talking
else
	if is_qmark($n) == mist_clean_quest 100007
		mpjunk $o
		mpadd_qmark self old_student_talking
		mpmod_qmark $n mist_clean_quest v0 = 8
		mpechoat $n $I將金屬印記(metal signet)放在手中細心調查....
		mpcallout 2 tell $n 不過要將這個完整解碼可能會有些困難....(difficult)
		mpcallout 2 tell $n 原來如此，從幾個符號的形狀能看出確實是史學家所用的加密方式之一。
		mpcallout 2 mpdel_qmark self old_student_talking
	else
		? $n
		give $o $n
		drop $o
	endif
endif
