>talk_prog quest~
if primeattr($n) == 2
or class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
        if is_qmark($n) >= thief_quest_list 200001
                mpechoat $n $I說 '你目前已經有接下任務了'
                mpechoat $n $I說 '如果你想接別的任務，就必須放棄此一任務'
                mpechoat $n $I說 '或是直到目前的任務解完為止'
                mpechoat $n $I說 '如果你想重來的話，請告訴我 restart'
                break
        endif
        nod
        if is_qmark($n) != thief_quest_list
                mpadd_qmark $n thief_quest_list -1 255 0 0 0 1
        endif
        if is_qmark($i) != thief_quest_solved
                mpadd_qmark self thief_quest_solved 120 0 0 0 1 0
        endif
        mpechoat $n $I說 '現在公會有的懸賞任務包括：
        if is_qmark($n) & thief_quest_list 100001
                if is_qmark($i) !& thief_quest_solved 100001
                        mpechoat $n 　         [1;37m秘密調查(survey)[m－懸賞是獎金，難度評等為：極易
                endif
        endif
        if is_qmark($n) & thief_quest_list 100002
                if is_qmark($i) !& thief_quest_solved 100002
                        mpechoat $n 　     [1;37m妙手精精兒(steal Jr)[m－懸賞是物品，難度評等為：易
                endif
        endif
        if is_qmark($n) & thief_quest_list 100008
                if is_qmark($i) !& thief_quest_solved 100008
                        mpechoat $n 　     [1;37m妙手空空兒(steal Sr)[m－懸賞是獎金，難度評等為：普通
                endif
        endif
        if is_qmark($n) & thief_quest_list 100016
                if is_qmark($i) !& thief_quest_solved 100016
                        mpechoat $n 　        [1;37m暗殺(assassin Jr)[m－懸賞是物品，難度評等為：中等
                endif
        endif
        if is_qmark($n) & thief_quest_list 100004
                if is_qmark($i) !& thief_quest_solved 100004
                        mpechoat $n 　    [1;37m暗通情款(love letter)[m－懸賞是經驗，難度評等為：中等
                endif
        endif
        if is_qmark($n) & thief_quest_list 100032
                if is_qmark($i) !& thief_quest_solved 100032
                        mpechoat $n 　             [1;37m劫獄(rescue)[m－懸賞是獎金或經驗，難度評等為：難
                endif
        endif
        if is_qmark($n) & thief_quest_list 100064
                if mobcount(3163) == 0
                        mpechoat $n 　    [1;37m血腥暗殺(assassin Sr)[m－懸賞是物品，難度評等為：難
                endif
        endif
        if is_qmark($n) & thief_quest_list 100128
                if mobcount(3165) == 0
                        mpechoat $n [1;37m空手入白刃(unarmed killing)[m－懸賞是物品，難度評等為：難
                endif
        endif
        if is_qmark($n) == thief_quest_list 100000
                mpechoat $n $I說：呃...所有的任務你全都試過了...
                clap $n
        endif
else
        say 對不起，公會任務只允許公會會員接，你去找自己的公會吧。
endif
