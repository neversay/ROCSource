>talk_prog p ultimate spell~
if is_qmark($n) == myroad_timer
	mpechoat $n 他專心的作著研究，沒注意到你。
	break
endif
if is_qmark($n) == adv_myroad 300010
	tell $n 你來啦！那麼我就開始囉！
	mpcallout 1 mpecho $I用魔力在右手上聚集出一團火燄，隨後左手也凝聚出一道寒冰。
	mpcallout 2 mpecho $I慢慢將手上的兩股異屬性魔法逐漸地加強。
	mpcallout 3 mpecho 你看見火燄與寒冰越發越大...越發越大....
	mpcallout 4 mpecho 越發越大...越發越大....
	mpcallout 5 mpecho 冰與火的瞬間衝突讓整個空間產生了巨大的波動！
	mpcallout 5 mpecho 突然間$I將雙手的異向魔法同時拋向空中！
	mpcallout 6 yell 全即是一！！！
	mpcallout 6 mpecho $I立刻擊掌，將雙手合十。
	mpcallout 7 mpecho 你看見半空中的火燄與寒冰漸漸地被透明的外殼包覆起，慢慢的收斂....
	mpcallout 8 mpecho 慢慢的收斂....慢慢的收斂....最終變成一顆安定的球體降至$I手中。
	mpcallout 9 tell $n 這個就是我所研究的究級魔法，究級光球！！
	mpcallout 9 tell $n 完成了！！
	mpcallout 10 mpechoat $n 不過這東西看起來真得很厲害，應該問他使用的方法(use)。
	mpcallout 10 mpechoat $n 你發現$I有點站得不穩，大概是一時消耗太多魔力了。
	mpcallout 10 mpmod_qmark $n adv_myroad v2 = 11
endif
