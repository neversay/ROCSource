>room_enter 127 100~
if ispc($n)
        del_affect $n all
endif
~
>room_time 100~
if roomtimer($0) == 0
        if mobcount(3322) == 0
                mload 3322
        endif
endif
~
>room_command search around~
if mobcount(3322) == 0
        if is_qmark($n) == skarabrae_study_quest02 100005
                if is_qmark($n) != study_necklace_search
                        add_qmark $n study_necklace_search 120 0 0 0 0 1
                        echoat $n 你找到了一條項鍊！
                        oload 3308 1 floor
                else
                        echoat $n 你什麼也沒找到。
                endif
        else
                echoat $n 你什麼也沒找到。
        endif
else
        echoat $n 開玩笑，惡魔還在啊！找死不成？
endif
~
