>greet_prog 100~
if is_qmark($n) == skarabrae_enemy
	if mobcount(3011) > 0
		yell 執法者，請擊退史卡拉貝的敵人$N吧！
		if insameroom(enforcer-skarabrae)
		else
			mptransfer enforcer-skarabrae
		endif
		mpforce enforcer-skarabrae hunt $n
		mpforce enforcer-skarabrae frenzy
		hunt $n
		mpnowait
	else
		say 史卡拉貝的敵人，覺悟吧！
		hunt $n
		frenzy
	endif
endif
~
>talk_prog topic~
if rand(50)
	say 泰洛斯(Thalos)的市長前陣子送消息給我，說是有個異世界的邪惡
	say 集團正進行一項大計劃，可惜後來就沒下文了，真令人擔心啊....
	sigh
else
	say 最近從秘書那邊聽到幾個城市守衛在追求同一位女士的事情。
	say 秘書似乎覺得這是個趣談，不過我覺得要是妨礙到工作就不好笑了。
endif
~
>rand_prog 20~
if rand(25)
	say 我討厭野狗。
	say 它看起來好噁心。
else
	if rand(50)
		grumble
		say 每次選舉一到，我就得出來賣笑。
		sigh
	else
		say 煩死了，每天都這樣一成不變。
		kowtow
	endif
endif
~
>entry_prog 100~
if rand(2)
	if inroom($i) != 3001
		if ispc($r)
			say 天啊，這份工作我幹得累死了。你來的正好！
			yell 我解脫嘍！
			remove key
			give key $r
			leave
			mpasound $I 高興的逃出這個城市。
			mppurge self
		endif
	endif
endif
if insameroom(secretary)
	say 你好！秘書。
	mpforce secretary bow mayor
	mpforce secretary say 您好，市長。今天的行程還是依照昨天那樣。
endif
if rand(30)
	if insameroom(cityguard)
		say 辛苦你們了，史卡拉貝城的守衛們！
		mpforce cityguard say 不用客氣市長，我們會盡我們所能保護史卡拉貝城安全。
	endif
endif
if insameroom(notsha)
	say 您好，娜塔莎(Notsha)，好久不見了。
	mpforce notsha say 您也辛苦了市長，我在這裡倒是還好。
endif
if insameroom(dynia)
	say 您好大主教，好久不見了。
	mpforce dynia say 是啊！市長您實在是太忙了。
endif
~
>fight_prog 50~
c fireball
mpnowait
if rand(20)
	say 警衛們！快來幫我！
	mpmload 3060
	mpforce guard rescue mayor
	mpmload 3060
	mpforce guard rescue mayor
endif
~
