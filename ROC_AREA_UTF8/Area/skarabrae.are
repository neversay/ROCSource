alchemist~
煉金術師(alchemist)~
看管倉庫的煉金術師(alchemist)正在這裡忙自己的事。
~
他是一個高大的獸人，但舉止相當有禮清潔，與人們刻板印象中的獸人完全不同。
~
1|2 0 350 S
39 0 0 0d0+0 0d0+0
0 0
0 8 1
R Orc~
>talk_prog topic~
if is_qmark($i) == talking
	break
endif
if rand(25)
	if primeattr($n) == 3
	or class($n) == 5
	or class($n) == 6
	or class($n) == 15
		say 請問有什麼事嗎？
	else
		say 你不是法師公會的成員吧？
	endif
endif
~
>talk_prog p supplies~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == ianua_supplies
or is_qmark($n) & ianua_quest 100001
	break
endif
if is_qmark($n) & adv_guild_level 300002
	mpadd_qmark self talking
	mpadd_qmark $n ianua_supplies -1 0 0 0 0 1
	tell $n 是看了商會留言板來的嗎？
	mpcallout 1 look $n
	mpcallout 2 tell $n 算了，這不重要。
	mpcallout 3 tell $n 目的地是伊安諾遺跡(Ianua Remains)，你願意幫這個忙嗎？(yes/no)
	mpcallout 3 tell $n 時間緊迫，我們有一批人急需物資。
	mpcallout 3 mpdel_qmark self talking
else
	mpadd_qmark self talking
	tell $n 是看了商會留言板來的嗎？
	mpcallout 1 look $n
	mpcallout 3 sorry $n
	mpcallout 3 tell $n 你看起來在這方面的經驗還不夠，我不能隨便把這任務交給你。
	mpcallout 3 tell $n 抱歉，事關重大。
	mpcallout 3 mpdel_qmark self talking
endif
~
>talk_prog p Ianua Remains~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == ianua_supplies 100000
	mpmod_qmark $n ianua_supplies v0 = 1
	tell $n 伊安諾是前陣子才被人發現的遺跡。
	tell $n 穿過銀蛇武士堡東側的森林就能到達了。
	tell $n 但在森林中不知道存在著什麼生物。
	tell $n 這樣你還願意幫忙嗎？(yes/no)
endif
~
>talk_prog p yes~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == ianua_supplies 100000
or is_qmark($n) == ianua_supplies 100001
	mpmod_qmark $n ianua_supplies v0 = 2
	tell $n 太好了！那麼請你把這個箱子交給遺跡裡法師公會的人。
	tell $n 萬事拜託了！
	mpechoat $n $I搬了一個超重的大木箱給你。
	mpoload 13200 $n 1 target
endif
~
>talk_prog p no~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == ianua_supplies 100000
or is_qmark($n) == ianua_supplies 100001
	mpmod_qmark $n ianua_supplies v0 = 999
	tell $n 那就沒辦法了，我再另請高明。
	bow $n
endif
~
