>fight_prog 50~
if rand(50)
        cast 'double heal'
        mpnowait
else
        cast 'full heal'
        mpnowait
endif
if rand(40)
        cast blindness
endif
if isaffected($i) !& 128
        cast sanctuary
endif
~
>fight_prog 40~
if rand(30)
        c 3 weaken
endif
if rand(30)
        c 3 poison
endif
if rand(30)
        c 3 blindness
endif
if isaffected($i) & 1
        cast 'cure blindness'
endif
if isaffected($n) !& 256
        cast 'faerie fire'
endif
if rand(60)
        cast 'faerie fog'
else
        cast earthquake
endif
~
>death_prog 100~
mplog $I killed by $n
mpdis_magic self blindness
mpat 5 c inf
if isnpc($n)
        break
endif
if is_qmark($n) != skarabrae_enemy
        mpadd_qmark $n skarabrae_enemy 200 0 0 0 1 1
else
        mpmod_qmark $n skarabrae_enemy timer + 50
endif
~
