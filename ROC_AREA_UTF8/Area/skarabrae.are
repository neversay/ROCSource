        mpmod_qmark $n skarabrae_healer_help v0 = 1
else
        mpadd_qmark $n skarabrae_healer_help 200 1 0 0 1 1
endif
tell $n 你怎麼可以攻擊我，其他在 ROC 中的玩家還需要我的幫助！
tell $n 消失吧！在史卡拉貝城已經不需要你的存在了！
cast blindness
mpnowait
cast curse
mpnowait
mptransfer $n 1
