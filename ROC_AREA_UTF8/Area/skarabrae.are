>fight_prog 100~
perform hasten
mpnowait
if pcnum($) < 5
        mpforce $n protect self
        change $r
endif
if rand(33)
        skilldrv heavyhit $n
        skilldrv heavyhit $n
        skilldrv heavyhit $n
        skilldrv heavyhit $n
        skilldrv heavyhit $n
        skilldrv heavyhit $n
else
        if rand(50)
                combat
                mpnowait
        else
                mpforcer here del_affect $i 'polymorph other'
                mpforcer here add_affect $i 'polymorph other' 1050 -1 38 -38 16384
                cast 'agglomerate descant'
                mpnowait
                mpcallout 3 mpforcer here del_affect $i 'polymorph other'
        endif
endif
