	mpadd_all_qmark $n skarabrae_enemy 200 0 0 0 1 1
else
	mpmod_all_qmark $n skarabrae_enemy timer + 50
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mpmod_all_qmark $n adv_book_1_main v0 | 2
if isnpc($n)
        break
endif
mplog killed by $n
if is_qmark($n) != skarabrae_enemy
        mpadd_qmark $n skarabrae_enemy 200 0 0 0 1 1
else
        mpmod_qmark $n skarabrae_enemy timer + 50
endif
~
