if is_qmark($n) == skarabrae_joe_quest 100003
        mpmod_qmark $n skarabrae_joe_quest v0 = 4
        say 我已經收到涵涵來的信了，他說道你除了幫她傳信外，還幫我們守墓家族籌齊了
        say 葬禮所需的物品，我們家族欠你一個人情，$n。
        mpoload 3391 $n viclv target
        mpechoat $n $I給了你一張紙。
        mpechoaround $n $I給了$n一張紙。
        if class($n) < 5
                mpexp $n 1800
        endif
        mpexp $n 3600
        mpresp $n 1
        mpcallout 1 say 請你好好保存這張契約，這樣我就能為您招喚屍體了。
        break
endif
if level($n) >= 38
        if is_qmark($n) != skarabrae_joe_quest
                hmm
                mpechoat $n 喬藍多(Joe Rando)好像有什麼心事似的，
                mpechoat $n 也許你可以詢問看看(quest)
        endif
