		oforce $n r10digit $o
	else
		if objval3($o) == 3
			oset self v3 = -2
			oforce $n r10digit $o
		else
			if objval3($o) == 2
				oset self v3 = -3
				oforce $n r10digit $o
			else
				if objval3($o) == 1
					oset self v3 = -4
					oforce $n r10digit $o
				else
					if objval3($o) == 0
						oset self v3 = -5
						oforce $n r10digit $o
					else
						oset self v3 - 5
						oforcer here del_qmark $n gembanking
						odef_rembch null-tar
						oforce $n save
					endif
				endif
			endif
		endif
	endif
else
	echoat $n 什麼？
endif
~
>obj_command recegem_10 default~
