>room_enter 63 100~
if primeattr($n) == 3
if isaffected($n) & 524288
        echoat $n 你感覺這裡好像可以順著城牆飛上去(fly up)。
endif
endif
~
>room_command fly up~
if isaffected($n) & 524288
        echoat $n 你飛了上去。
if ispc($n)
        echoaround $n $n飛了上去。
        force 3251 echo $n飛了上來！
else
        echoaround $n $N飛了上去。
        force 3251 echo $N飛了上來！
endif
        transfer $n 3251
        break
endif
if roomvalue($0) == 1
if ispc($n)
        echoaround $n $n爬了上去。
        force 3251 echo $n爬了上來！
else
        echoaround $n $N爬了上去。
        force 3251 echo $N爬了上來！
endif
        transfer $n 3251
endif
~
>room_command set escalade~
if is_inv_obj($n) == 3533
if isnpc($n)
        force $n mppurge escalade
        echoaround $n $N將攻城梯立了起來！
        modrvt v0 = 1
        modrvt 3251 v0 = 1
        force 3251 echo 攻城梯(escalade)勾上了城牆頭！
endif
endif
~
