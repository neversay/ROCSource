>talk_prog point~
if level($n) >= 30
        if is_qmark($n) != enable_level_40
                if class($n) < 5
                        mpcallout 1 tell $n 新生的冒險者呀，你是否幫助過城內的人們呢？
                        mpcallout 2 tell $n 城內的老者正等著考驗你，你是否幫助過藍色精靈村對抗邪惡？
                        mpcallout 3 tell $n 你是否到過馬戲團幫助走失的孩子尋找母親？
                        mpcallout 4 tell $n 還有，密登尼森林的吟遊詩人你是否見過了？
                        mpcallout 5 tell $n 完成這些任務，你的事蹟才能被認證。
                endif
                if class($n) == 14
                or class($n) == 18
                or class($n) == 19
                        mpcallout 1 tell $n 不知道你有沒有注意到史卡拉貝附近的城市的變化，蠻荒地帶似乎有著
                        mpcallout 2 tell $n 問題需要解決，泰洛斯似乎也常常出現了悲慘的哀鳴，而創世紀的八大
                        mpcallout 3 tell $n 美德更是一個勇者不可或缺的。當然，通過基本的試練也是必要的。最
                        mpcallout 4 tell $n 後我想就是你總該讓大家都認識你，你的威望要高一點。
                        mpcallout 5 mpcall bar_check $n
                endif
                if class($n) == 11
                or class($n) == 12
                or class($n) == 13
                        mpcallout 1 tell $n 不知道你有沒有注意到史卡拉貝附近城市的變化，蠻荒地帶似乎有著不
                        mpcallout 2 tell $n 小的問題需要有人去解決，泰洛斯那裡也常常出現了悲慘的哀鳴。創世
                        mpcallout 3 tell $n 紀的八大美德考驗是一個勇者必定要經歷的。而對於你來說，
                        mpcallout 4 tell $n 各式試練想必一定不成問題。最後，我想你應該讓大家更認識你一點。
                        mpcallout 5 mpcall war_check $n
                endif
                if class($n) == 5
                or class($n) == 6
                or class($n) == 15
                        mpcallout 1 tell $n 對於學魔法的你來說，秩序和混沌應該已經能夠區分的很明顯了。
                        mpcallout 2 tell $n 雖然是學魔法，但是創世紀的八大美德，還是你該具備的。最近我似乎
                        mpcallout 3 tell $n 聽到了在遙遠的迷霧之島有著邪惡生物的出現，似乎在水晶湖和奈圖附
                        mpcallout 4 tell $n 近，我想，你應該能夠順利的解決這些問題吧。最後，要當個勇者還必
                        mpcallout 5 tell $n 須要讓大家都知道你的名聲才行。
                        mpcallout 6 mpcall mag_check $n
                endif
                if class($n) == 7
                or class($n) == 8
                or class($n) == 16
                        mpcallout 1 tell $n 身為神職人員的你來說，怎麼去分辨秩序和混沌應該是很重要的。不知
                        mpcallout 2 tell $n 道你有沒有經歷過八大美德的考驗，我想對你來說應該幫助不少。當個
                        mpcallout 3 tell $n 勇者所需要具備的是能夠解決問題的能力，在遙遠的聖域之中存在著一
                        mpcallout 4 tell $n 些考驗著你們知識的謎題。我想你還是去調查一下比較好。最後，要當
                        mpcallout 5 tell $n 個勇者除了要有一定的實力之外也要讓大家都知道有你這個人才行！所
                        mpcallout 6 tell $n 以多努力充實自己的威望吧。
                        mpcallout 7 mpcall cle_check $n
                endif
                if class($n) == 9
                or class($n) == 10
                or class($n) == 17
                        mpcallout 1 tell $n 不知道對於從小偷出身的你，現在成長到現在的感覺是如何呢？在成長
                        mpcallout 2 tell $n 的旅程中，我相信八大美德應該可以給你很多的啟示。對了，不知道你
                        mpcallout 3 tell $n 是否已經解決了所有盜賊的試練呢，我想那些一定也可以讓你成長更多
                        mpcallout 4 tell $n 的。最後，有空多充實自己的威望吧，一個勇者是該讓大家所知道的。
                        mpcallout 5 mpcall thi_check $n
                endif
        endif
endif
~
>defun_prog undeclare~
tell $n 親愛的冒險家啊，我想你似乎還不夠資格接受我的檢驗，這世界
tell $n 上還有許多東西和許多事情是你該自己去經歷的。等你準備好了
tell $n 之後，歡迎你再來找我。
mpechoat $n 如果你想知道一些該注意的地方，請詢問黛妮亞吧(point)。
~
