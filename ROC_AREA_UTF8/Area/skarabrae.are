>fight_prog 60~
mpat 5 mpdis_magic self blindness
mpat 5 mpdis_magic self poison
mpat 5 mpdis_magic self mute
mpat 5 mpdis_magic self 'seal magic'
mpat 5 mpdis_magic self paralyze
if rand(33)
        say 冰之女神，依照契約賜予我力量！
        say 霜之光與雪之舞，讓敵人永遠沉眠在冰雪之中吧！
        mpecho 四周溫度突然急速降低，寒氣飛快地凝聚在$I的雙掌之間！
        say 北壁的雪花！
        cast 'agglomerate descant'
        mpnowait
else
        if rand(50)
                say 來吧！霜與雪的精靈們！化為利劍貫穿敵人吧！
                mpecho 空氣中的水份瞬間結凍，並聚合成一把冰劍！
                say 雪國風暴！
                mpat 5 mpoload 70914 36
                mpat 5 wear sword
                circular
                mpnowait
                icecore
                mpnowait
                mpat 5 remove sword
                mpat 5 mpjunk sword
                mpecho 冰劍隨著劍技的使出而崩解了。
        else
                say 雪妖召喚！帶來白色世界的使者們！
                mpechoat $r $I召喚出的雪妖朝你吹出刺骨的寒風！
                mpechoaround $r $I召喚出的雪妖朝$R吹出刺骨的寒風！
                mpforcer here add_affect $r 'chill touch' 1130 5 19 -2 1073741824
                mpforcer here add_affect $r 'chill touch' 1130 5 28 10 1073741824
        endif
endif
~
>rand_prog 100~
if hitprcnt($i) < 100
        if isfight($i)
        or isaffected($i) !& 128
        else
                mpat 5 mpdis_magic self 'seal magic'
                mpat 5 mpdis_magic self mute
                mpat 5 mpdis_magic self 'polymorph other'
                cast 'full heal'
                mpnowait
        endif
endif
~
