if insameroom(dracking)
	hunt dracking
	yell 殺！殺！殺！大家衝啊！！！
endif
if inroom($i) == 2207
	say 等下往上就會遇到大批守衛(bodyguard).
	say 切記要藏匿行蹤以免遭到攻擊!
	mpdis_magic self blindness
	hide
	if insameroom(braver)
		mpforce braver hide
	endif
