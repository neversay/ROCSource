>room_command fly up~
if isnpc($n)
if isaffected($n) & 524288
        echoat $n 你飛了上去。
        echoaround $n $N飛了上去。
        force 3255 echo $N飛了上來！
        transfer $n 3255
        break
endif
if roomvalue($1) & 4
        echoaround $n $N順著繩梯爬了上去。
        force 3255 echo $N順著繩梯爬了上來！
        transfer $n 3255
endif
endif
~
>room_command knock door~
if roomvalue($1) & 1
if isnpc($n)
        if name($n) / battering-goblin-g
                echo [1;37m攻城槌(battering ram)猛烈地撞向城門！[0m
                force 3039 echo [1;37m攻城槌(battering ram)猛烈地撞向城門！[0m
                modrvt v0 + 10
                force 3039 modrvt v0 + 10
                if rmobcount(3556) >= 4
                        modrvt v0 + 8
                        force 3039 modrvt v0 + 8
                endif
                if rmobcount(3556) == 3
                        modrvt v0 + 6
                        force 3039 modrvt v0 + 6
                endif
                if rmobcount(3556) == 2
                        modrvt v0 + 4
                        force 3039 modrvt v0 + 4
                endif
                if rmobcount(3556) == 1
                        modrvt v0 + 2
                        force 3039 modrvt v0 + 2
                endif
        endif
        if race($n) == Goblin
                echo [1;37m小惡鬼軍團猛烈地攻向城門！[0m
                force 3039 echo [1;37m小惡鬼軍團猛烈地攻向城門！[0m
                modrvt v0 + 5
                force 3039 modrvt v0 + 5
        endif
endif
        rcall judge_door $n
endif
~
>room_defun judge_door~
if roomvalue($0) >= 500
        echotoall [1;35m【幻世戰報】史卡拉貝的南門被小惡鬼軍團所攻破！！[0m
        echo [1;35m【幻世戰報】史卡拉貝的南門被小惡鬼軍團所攻破！！[0m
        modrvt v1 r 1
        modrvt v1 | 2
        setdoor 0 flags 0
        force 3039 setdoor 2 flags 0
endif
if roomvalue($0) >= 500
        echo [1;31m這扇門已經毀滅了。[0m
        break
endif
if roomvalue($0) >= 450
        echo [1;31m這扇門岌岌可危，即將毀壞！[0m
        break
endif
if roomvalue($0) >= 400
        echo [1;31m這扇門受了非常嚴重的破壞！[0m
        break
endif
if roomvalue($0) >= 350
        echo [1;31m這扇門出現非常巨大的裂縫！[0m
        break
endif
if roomvalue($0) >= 300
        echo [1;33m這扇門出現了好幾條小裂縫。[0m
        break
endif
if roomvalue($0) >= 250
        echo [1;33m這扇門已經開始不穩。[0m
        break
endif
if roomvalue($0) >= 200
        echo [1;33m這扇門遭受了不小的撞擊。[0m
        break
endif
if roomvalue($0) >= 150
        echo [1;32m這扇門遭受過輕微的撞擊。[0m
        break
endif
if roomvalue($0) >= 100
        echo [1;32m這扇門非常堅固，沒有傷痕。[0m
        break
endif
if roomvalue($0) > 0
        echo [1;35m這扇門非常堅固，沒有傷痕。[0m
else
        echo [1;37m這扇門絲毫無損，固若金湯。[0m
endif
~
