>fight_prog 100~
if is_qmark($n) != skarabrae_enemy
        mpadd_all_qmark $n skarabrae_enemy 200 0 0 0 1 1
else
        mpmod_all_qmark $n skarabrae_enemy timer + 50
endif
if rand(33)
        c fireball
        mpnowait
else
        if rand(50)
                c flamestrike
                mpnowait
                c 'burning hand'
                mpnowait
        else
                c 'star fire'
                mpnowait
        endif
endif
if rand(50)
        wear goddess
        disarm
        mpnowait
endif
if isaffected($i) & 1
        c 'cure blindness'
        mpnowait
endif
if isaffected($i) !& 128
        c sanc
        mpnowait
endif
if isaffected($i) & 1024
        c 'remove curse'
        mpnowait
endif
if isaffected($i) & 4096
        c 'cure poison'
        mpnowait
endif
if rand(20)
        yell $n 正在攻擊我們！請天神保佑我吧！
        c 'gfull heal'
        mpnowait
endif
if rand(30)
        c 'high explosive'
        mpnowait
endif
if rand(30)
        c powerball
        mpnowait
endif
if rand(30)
        if ispc($r)
                c mute $r
        endif
endif
if hitprcnt($i) < 70
        c 'gdouble heal'
        mpnowait
endif
if hitprcnt($i) < 50
        c 'gdouble heal'
        mpnowait
endif
~
