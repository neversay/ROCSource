>room_command read default~
echoat $n 你想閱讀什麼？
~
>room_command read tomes~
echoat $n 你想讀哪一本？
echoat $n 這裡有：
echoat $n 魔法的起源(Origin of Magic)
echoat $n 關於火(About Fire)
echoat $n 論古代捲軸(About Ancient scrolls)
~
>room_command read p origin of magic~
echoat $n 你拉出一把椅子坐了下來，開始仔細閱讀著書本。
echoaround $n $N仔細閱讀著書本。
if int($n) <= 14
        mpcallout 1 rcall magic_dunno
else
        mpcallout 1 echoat $n 你雖然看懂了，但這本書對你並沒有什麼實質幫助。
endif
~
>room_command read p about fire~
echoat $n 你拉出一把椅子坐了下來，開始仔細閱讀著書本。
echoaround $n $N仔細閱讀著書本。
if int($n) <= 13
        mpcallout 1 rcall magic_dunno
else
        mpcallout 1 echoat $n 你雖然看懂了，但這本書對你並沒有什麼實質幫助。
endif
~
>room_command read p about ancient scrolls~
echoat $n 你拉出一把椅子坐了下來，開始仔細閱讀著書本。
echoaround $n $N仔細閱讀著書本。
if int($n) <= 15
        mpcallout 1 rcall magic_dunno $n
else
        mpcallout 1 echoat $n 你雖然看懂了，但這本書對你並沒有什麼實質幫助。
endif
~
>room_defun magic_dunno~
if rand(60)
        echoat $n 你完全無法理解這本書的內容。
else
        echoat $n 你看到睡著了...Zzzzzz
        echoaround $n $N翻著書，逐漸打起瞌睡來。
        force $n sleep
endif
~
|
