                break
        endif
        if roomvalue($0) >= 400
                echoat $n [1;31m這扇門受了非常嚴重的破壞！[0m
                break
        endif
        if roomvalue($0) >= 350
                echoat $n [1;31m這扇門出現非常巨大的裂縫！[0m
                break
        endif
        if roomvalue($0) >= 300
                echoat $n [1;33m這扇門出現了好幾條小裂縫。[0m
                break
        endif
        if roomvalue($0) >= 250
                echoat $n [1;33m這扇門已經開始不穩。[0m
                break
        endif
        if roomvalue($0) >= 200
                echoat $n [1;33m這扇門遭受了不小的撞擊。[0m
                break
        endif
        if roomvalue($0) >= 150
                echoat $n [1;32m這扇門遭受過輕微的撞擊。[0m
                break
        endif
        if roomvalue($0) >= 100
                echoat $n [1;32m這扇門非常堅固，沒有傷痕。[0m
                break
        endif
        if roomvalue($0) > 0
                echoat $n [1;35m這扇門非常堅固，沒有傷痕。[0m
        else
                echoat $n [1;37m這扇門絲毫無損，固若金湯。[0m
