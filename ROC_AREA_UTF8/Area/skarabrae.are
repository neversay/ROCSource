>talk_prog sign~
if ispc($n)
        if is_qmark($n) != skarabrae_study_questmark
                mpadd_qmark $n skarabrae_study_questmark -1 0 0 0 0 1
        endif
        if is_qmark($n) !& skarabrae_study_questmark 100002
                if is_qmark($n) != skarabrae_study_quest02
                        say 嗯，你應該就是$N了，我在商會聽過你的名字。
                        say 本來這件事我自己解決也不是不行，只是因為闖禍的人跟我有關......
                        say 所以現在我的立場也有點尷尬，因此得委託外面的人了。
                        say 希望你不會跟外頭那五人組一樣沒用才好(continue)。
                        mpadd_qmark $n skarabrae_study_quest02 -1 6 0 0 0 1
                endif
        endif
