>defun_prog skarabrae_dynia_schedule_1~
if inroom($i) != 3211
        break
endif
say 時間到了，該出去走走了！
if mobcount(3087) > 0
        mpgoto 3210
        if insameroom(priest-skarabrae)
        else
                mptransfer priest-skarabrae
        endif
        mpforce priest-skarabrae unlock n
        mpforce priest-skarabrae open n
        mpforce priest-skarabrae say 大主教出神殿休息的時間到了。
        mpgoto 3211
        mpcallout 1 s
        mpcallout 2 say 您好，聖堂祭司，我出來走走！
        mpcallout 2 mpforce priest-skarabrae say 您好，大主教！
        mpcallout 3 open s
        mpcallout 4 s
else
        mpcallout 1 say 但是聖堂祭司似乎不在，不知道跑到那邊去了。
        mpcallout 2 mpoload 3378
        mpcallout 3 unlock s
        mpcallout 4 open s
        mpcallout 5 s
        mpcallout 5 mpjunk all.key
        mpcallout 6 s
endif
~
>defun_prog skarabrae_dynia_schedule_2~
if inroom($i) != 3054
        break
endif
say 您好，醫者，我出來走走。
mpforce healer-s say 您好，大主教！
mpcallout 1 rest
mpcallout 1 mpforce lancelot-skarabrae rest
mpcallout 2 mpforce healer-s say 最近聽說經過一陣劇烈的人事異動，城中冒險者有增加的趨勢。
mpcallout 2 say 不知道最近史卡拉貝城近況如何？
mpcallout 3 mpecho $I 抬頭仰望史卡拉貝城的天空....
mpcallout 4 mpforce healer-s say 是的，也只有如此才能夠抵擋破壞神的入侵。
mpcallout 4 say 希望新的史卡拉貝城與遠方的光明之鎮能夠好好合作。
mpcallout 5 mpforce healer-s say 怎麼了，大主教？
mpcallout 5 sigh
mpcallout 6 mpforce healer-s say 沒錯，光明之鎮的冒險者也表現得相當積極。
mpcallout 6 say 由於冒險者的積極，使得迷霧之島許多秘密都已經漸漸被發掘出來。
~
>defun_prog skarabrae_dynia_schedule_3~
if inroom($i) != 3054
        break
endif
say 但是近來整個世界讓我感到心神不寧。
mpforce healer-s say 大主教您的意思是？
mpcallout 1 mpforce healer-s gasp
mpcallout 1 say 我覺得這個世界在短期之內可能會有大變動。
mpcallout 2 shake
mpcallout 2 mpforce healer-s say 大主教的直覺向來很準，難道真的會有毀滅性的災難？
mpcallout 3 mpforce healer-s nod
mpcallout 3 say 我的感覺是憂喜參半，毀滅性的災難倒是不至於。
~
>defun_prog skarabrae_dynia_schedule_4~
if inroom($i) != 3054
        break
endif
say 我想是該回到神殿的時間了。
mpforce healer-s nod dynia
mpcallout 1 mpforce healer-s bow dynia
mpcallout 1 say 再見了，醫者。
mpcallout 2 mpforce healer-s say 明天見，大主教。
mpcallout 3 wak
mpcallout 4 mpforce lancelot-skarabrae wak
mpcallout 5 open n
mpcallout 6 n
~
>defun_prog skarabrae_dynia_schedule_5~
if inroom($i) != 3210
        break
endif
if insameroom(priest-skarabrae)
        mpforce priest-skarabrae say 大主教，您要回到神殿去了嗎？
        nod priest-skarabrae
        mpcallout 1 say 是的，煩請聖堂祭司開個門。
        mpcallout 2 mpforce priest-skarabrae say 是的。
        mpcallout 3 mpforce priest-skarabrae unlock n
        mpcallout 4 mpforce priest-skarabrae open n
        mpcallout 5 n
        mpcallout 6 close s
        mpcallout 7 mpoload 3378
        mpcallout 8 lock s
        mpcallout 9 mpjunk all.key
else
        ponder
        mpcallout 1 say 看樣子聖堂祭司還沒回來。
        mpcallout 2 mpoload 3378
        mpcallout 3 unlock n
        mpcallout 4 open n
        mpcallout 5 n
        mpcallout 6 close s
        mpcallout 7 lock s
        mpcallout 8 mpjunk all.key
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
if insameroom(lancelot-skarabrae)
        mpgroup self lancelot-skarabrae 1 0
        mpforce lancelot-skarabrae protect dynia-skarabrae
endif
~
>talk_prog seed~
if is_qmark($n) == ocean_annie_seed 100003
        mpmod_qmark $n ocean_annie_seed v0 = 4
        nod $n
        mpcallout 1 say 是的，我是曾經有過這個種子。
        mpcallout 2 say 不過我已經又把它轉送給費那提克了
        mpcallout 3 say 你還是去問問他吧。
endif
~
>kill_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($i) != skarabrae_dynia_kill
        mpadd_qmark self skarabrae_dynia_kill 5 0 0 0 1 0
else
        if is_qmark($i) <= skarabrae_dynia_kill 100005
                mpmod_qmark self skarabrae_dynia_kill v0 + 1
        else
                mpecho $I 利用連續許多冒險者短時間連續死亡的能量，讓自己再度精神飽滿....
                mpdis_magic self 'seal magic'
                mpdel_qmark self skarabrae_dynia_kill
                mpat 5 c 'full heal'
                mpnowait
        endif
endif
if ispc($n)
        if is_qmark($n) != skarabrae_dynia_kill
                mpadd_qmark $n skarabrae_dynia_kill 10 0 0 0 0 1
        else
                if is_qmark($n) <= skarabrae_dynia_kill 100005
                        mpmod_qmark $n skarabrae_dynia_kill v0 + 1
                else
                        mpecho $I 利用$N短時間連續死亡的能量再度讓自己精神飽滿....
                        mpdis_magic self 'seal magic'
                        mpdel_qmark self skarabrae_dynia_kill
                        mpat 5 c 'full heal'
                        mpnowait
                endif
        endif
endif
~
>give_prog 4612~
if is_qmark($n) & mist_council_send-a 100001
        say 謝謝您千里迢迢將$O拿給我。
        kiss $n
        mpjunk all.heart
        mpechoat $n 遠方傳來一陣聲響「完成這項任務！請回光明之鎮市議會領取獎賞。」
        mpechoat $n 遠方傳來一陣聲響「有關坐船的費用，市議會將給予補償30萬金幣。」
        mpdel_qmark self mist_council_send-a
        mpmod_qmark $n mist_council_send-a v2 | 1024
else
        say 我不知道你給我這個東西要做什麼？
        drop heart
endif
