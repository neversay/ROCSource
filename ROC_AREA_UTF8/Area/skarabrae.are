>talk_prog note~
if is_qmark($n) != skarabrae_enemy
        if ispc($n)
                if is_qmark($n) != skarabrae_study_questmark
                        mpadd_qmark $n skarabrae_study_questmark -1 0 0 0 0 1
                endif
                if is_qmark($n) !& skarabrae_study_questmark 100004
                        if is_qmark($n) != skarabrae_study_quest03
                                say 嗯，其實也不是什麼特別的事，只是最近有點小狀況。
                                say 聽說最近偶爾有反叛軍的間諜(spy)在夜間潛入史卡拉貝，天亮後就不見人影了。
                                say 我相信他們一定是為了執行某些陰謀才會潛進來。
                                mpadd_qmark $n skarabrae_study_quest03 -1 1 0 0 0 1
                        endif
                endif
        endif
else
        yell 史卡拉貝之敵$N！死吧！
        mpkill $n
        hunt $n
endif
~
>talk_prog spy~
if is_qmark($n) != skarabrae_enemy
        if is_qmark($n) == skarabrae_study_quest03 100001
                say 根據情報，這些間諜相當狡猾，而且受過嚴格的軍事訓練。
                say 我希望有人能抓到他們，或是從他們身上搶到任何有關的物品與情報。
                say 這個工作不太輕鬆，你如果要做的話就去吧，有什麼收穫務必讓我知道。
                mpmod_qmark $n skarabrae_study_quest03 v0 = 2
        endif
else
        yell 史卡拉貝之敵$N！死吧！
        mpkill $n
        hunt $n
endif
~
>talk_prog report~
if is_qmark($n) != skarabrae_enemy
        if is_qmark($n) == skarabrae_study_quest03 100008
                mpecho 你將搜尋的結果全數告知了$I，接著$I向你問了一些細節方面的問題。
                mpecho 在你據實回答了十多個問題之後，$I露出得意的笑容。
                say 哼，居然是那傢伙......看起來是得採取一點行動的時候了。
                say 辛苦了，你做得很好，收下你應得的吧。
                mpexp $n 7500
                mpskillexp $n 9000
                mpresp $n 1
                mpoload 3318 $n 36 target
                mpcall magic_power $n
                mpdel_qmark $n skarabrae_study_quest03
                mpmod_qmark $n skarabrae_study_questmark v0 | 4
                mpmod_qmark $n skarabrae_study_questmark v2 | 2
                say 另外......這個東西也可以打開機械室的門，我准許你使用那部機器。
                say 只要按下按鈕(push button)就可以了，至於會發生什麼事嘛......嘿嘿嘿......
        endif
else
        yell 史卡拉貝之敵$N！死吧！
        mpkill $n
        hunt $n
endif
~
>defun_prog magic_power~
if is_qmark($n) == max_skill_exp
        mpmod_qmark $n max_skill_exp v0 + 2
else
        mpadd_qmark $n max_skill_exp -1 2 0 0 0 1
endif
mpechoat $n 你感到自身潛在的力量覺醒了！
~
