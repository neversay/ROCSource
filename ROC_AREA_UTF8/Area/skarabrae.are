>talk_prog sign~
if ispc($n)
        if is_qmark($n) != skarabrae_study_questmark
                mpadd_qmark $n skarabrae_study_questmark -1 0 0 0 0 1
        endif
        if is_qmark($n) !& skarabrae_study_questmark 100002
                if is_qmark($n) != skarabrae_study_quest02
                        say 喔，你說你叫$N，是看了公佈欄的徵才公告而來的......
                        say 那好吧，我這就對你說明委託內容，你準備好要聽了(ready)再告訴我。
                        mpadd_qmark $n skarabrae_study_quest02 -1 1 0 0 0 1
                endif
        endif
endif
~
>talk_prog ready~
if is_qmark($n) == skarabrae_study_quest02 100001
        say 事情是這樣的......
        say 在幾個月前，原本文學、哲學與史學的三名教授因為闖了大禍，所以被解聘了。
        say 他們召喚出惡魔，惡魔並占據了對面那棟校舍。
        say 雖然校方找了外面的人來處理這件事，但是......
        say 唉，你去跟那棟校舍前面那五個人打一架就知道他們有多不可靠了。
        say 總而言之，我希望你能去將惡魔消滅掉！你辦得到嗎？(sure)
        mpmod_qmark $n skarabrae_study_quest02 v0 = 2
endif
~
>talk_prog sure~
if is_qmark($n) == skarabrae_study_quest02 100002
        say 那麼就交給你了！
        say 另外，我之前提到的那不可靠的五人組......
        say 雖然他們戰鬥能力低弱，不過或許也能從他們口中得到有用的情報吧。
        say 惡魔消滅後請回來向我報告(report)。
        mpmod_qmark $n skarabrae_study_questmark v2 r 1
        mpmod_qmark $n skarabrae_study_quest02 v0 = 3
endif
~
>talk_prog report~
if is_qmark($n) == skarabrae_study_quest02 100003
        if is_qmark($n) & skarabrae_study_questmark 300001
                say 很好！果然比那五人組可靠得多了！
                say 這是給你的，謝謝你的協助！
                mpexp $n 18000
                mpskillexp $n 12000
                mpresp $n 1
                mpcall magic_power $n
                mpdel_qmark $n skarabrae_study_quest02
                mpmod_qmark $n skarabrae_study_questmark v0 | 2
                mpmod_qmark $n skarabrae_study_questmark v1 | 1
        endif
endif
~
>talk_prog demon~
if is_qmark($n) == skarabrae_study_quest03 100020
        if is_qmark($n) & skarabrae_study_questmark 200001
                mpechoat $n 你向$I質問關於「魔氣反饋利用」的事。
                mpechoat $n $I一開始竟然還跟你裝傻，直到你騙他說自己已經掌握證據時，$I臉色忽然變了。
                yell 像你這種傢伙，怎麼可能會懂得長久以來被學界的人瞧不起的心情！
                yell 既然你已經知道一切，那麼我也豁出去了，出來吧！炎翼惡魔！
                mpecho 地面上瞬間出現炎之魔法陣，有著烈焰般雙翼的惡魔出現在你面前！
                mpmload 3331
                mpmod_qmark $n skarabrae_study_quest03 v0 = 21
                mpgoto 5
        endif
endif
~
>talk_prog signet~
if is_qmark($n) == mist_clean_quest 100005
	mpechoat $n 你把金屬印記(metal signet)拿到$I的眼前。
	mpmod_qmark $n mist_clean_quest v0 = 6
	mpcallout 1 tell $n 你去問其他人吧。
	mpcallout 1 tell $n 我只是個外聘講師，不解這種學界高層特有的閒情雅致。
	mpcallout 2 mpechoat $n 看來只能再找找其他的方法了。
endif
~
>defun_prog magic_power~
if is_qmark($n) == max_skill_exp
        mpmod_qmark $n max_skill_exp v0 + 1
else
        mpadd_qmark $n max_skill_exp -1 1 0 0 0 1
endif
mpechoat $n 你感到自身潛在的力量覺醒了！
~
>give_prog 4235~
if is_qmark($n) == mist_clean_quest 100005
	mpechoat $n 你請$I幫忙分析金屬印記(metal signet)的暗號。
	mpmod_qmark $n mist_clean_quest v0 = 6
	mpcallout 1 give $o $n
	mpcallout 1 tell $n 你拿去問其他人吧。
	mpcallout 1 tell $n 我只是個外聘講師，不解這種學界高層特有的閒情雅致。
	mpcallout 2 mpechoat $n 看來只能再找找其他的方法了。
else
	? $n
	give $o $n
endif
~
