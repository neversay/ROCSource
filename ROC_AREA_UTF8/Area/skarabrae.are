                mload 3305
                force retini-skarabrae mpexp $r 3000
                force retini-skarabrae mpskillexp $r 5000
                force retini-skarabrae mpresp $r 1
                purge retini-skarabrae
                del_qmark $r skarabrae_study_quest01
                mod_qmark $r skarabrae_study_questmark v0 | 1
        endif
        if class($r) == 14
                echoat $r 你忽然覺得手上的書有了神秘的反應......
                echoat $r 靈光一閃，你隨即召喚低位魔神附身在你身上。
                echoat $r 就在附身後的瞬間，你赫然看見有個美少女模樣的靈體浮現在書本上！
                echoat $r 你還來不及驚訝，便聽到她發出細微的聲音......
                echoat $r 「請你......將這本書......帶到艾斯貝爾......交給法師......」
                mod_qmark $r skarabrae_study_quest01 v0 = 10
        endif
        if class($r) == 15
                echoat $r 你忽然覺得手上的書有了神秘的反應......
                echoat $r 然而這對你來說已經是司空見慣的情況，比吃飯還容易。
                echoat $r 你的眼睛隨即閃過一道異光，書本上頓時浮現出美少女模樣的靈體！
                echoat $r 就在你剛要開口問她話時，她卻先發出細微的聲音......
                echoat $r 「請你......將這本書......帶到艾斯貝爾......交給法師......」
                mod_qmark $r skarabrae_study_quest01 v0 = 10
        endif
        if class($r) == 16
                echoat $r 來到這裡，你突然覺得心靈有種異樣的感覺。
                echoat $r 就像事先已經計劃好了一般，你拿出了那本問題書本。
                echoat $r 你以天生的領袖氣質與才華為後盾，命令書中的靈體現身。
                echoat $r 具有半透明身軀的美少女緩緩浮現在你面前。
                echoat $r 你緩緩地對她說：「悲哀的亡靈啊，不要眷戀於此，帶著希望走向來生吧！」
                echoat $r 她沒說什麼，只是向你行了個禮，然後緩緩消失......
                echoat $r 在她即將完全消失的瞬間，你聽到了她的聲音，很細微......
                echoat $r 「以後當你......覺得苦惱時......來這裡......祈禱吧......」
                mload 3305
                force retini-skarabrae mpexp $r 3000
                force retini-skarabrae mpskillexp $r 5000
                force retini-skarabrae mpresp $r 1
                purge retini-skarabrae
                del_qmark $r skarabrae_study_quest01
                mod_qmark $r skarabrae_study_questmark v0 | 1
        endif
endif
~
>room_command pray default~
if is_qmark($n) & skarabrae_study_questmark 100001
        if class($n) == 13
        or class($n) == 16
                echoat $n 你彷彿被柔和的風輕撫......
                del_affect $n 'detect evil'
                add_affect $n 'detect evil' 1130 120 39 -10 4
        endif
endif
~
>room_command gather literature~
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) !& mist_clean_quest 200001
		echoat $n 你在書架上發現了一本署名歐米拉(Oimyra)的厚書本。
		oload 4266 1 $n target
		mod_qmark $n mist_clean_quest v1 | 1
	else
		echoat $n 你已經找過這裡了。
	endif
else
	echoat $n 什麼？
endif
~
