>talk_prog quest~
if is_qmark($n) != skarabrae_joe_quest
        say 你想要接任務？我想想，最近事情不多，但是倒有一件事很麻煩。
        say 先說好，這事情說大不大說小不小，但是處理的不好，你自己就最
        say 好給我注意點，我一旦不高興，以後說不定就不幫你招屍了。這樣
        say 你想要做嗎？(Yes/No)
else
        say 任務還沒辦好嗎？
endif
~
>talk_prog yes~
if is_qmark($n) == skarabrae_joe_quest 100004
        if is_equ_obj($n) == 3391
        or is_inv_obj($n) == 3391
                ? $n
        else
                say 依照契約的內容，吸收你的精氣以為血誓！
                mpexp $n -3000
                mpoload 3391 $n viclv target
                mpechoat $n $I給了你一張新的契約。
                mpechoaround $n $I給了$n一張新的契約。
                mpcallout 1 say 記得好好保管，別再弄丟了！
        endif
        break
endif
if is_qmark($n) != skarabrae_joe_quest
        mpadd_qmark $n skarabrae_joe_quest -1 1 0 0 0 1
        mpoload 3006 1
        say 好吧！既然你這麼想做，那我就先告訴你事情的大概。
        mpcallout 1 mpcall yes_1 $n
        mpcallout 2 mpcall yes_2 $n
        mpcallout 3 give letter-joe $n
        mpcallout 4 say 到那裡找一個綁著馬尾的女孩就是了。
        mpcallout 5 say 快去吧！萬事拜託了。
        mpcallout 5 drop letter-joe
endif
~
>defun_prog yes_1~
say 事情是這樣的。我老婆的大姊最近過世了，她唯一的親人──她女
say 兒正在永恆之塔當學徒。你幫我送個信去給她，就這樣而已。
~
>defun_prog yes_2~
say 身為一個招屍人，親人死了也不能不顧，但是卻又不能丟著史卡拉
say 貝這邊的事情不管。你就去幫我料理我她的後事吧！而且要辦的風
say 風光光的，要做就給我做好，不要惹我生氣，那吃虧的絕對是你！
~
>talk_prog no~
say 這樣啊！好吧那我再找別人幫吧。
~
>talk_prog restart~
if is_qmark($n) < skarabrae_joe_quest 100004
        mpechoat $n 遠方傳來一道聲音：任務可以重解了。
        mpdel_qmark $n skarabrae_joe_quest
        mpdel_qmark $n shire_ornament_quest
        mpdel_qmark $n grove_tear_quest
        mpdel_qmark $n commerce_gem_quest
else
        if is_equ_obj($n) == 3391
        or is_inv_obj($n) == 3391
                mpechoat $n 遠方傳來一道聲音：你已經解完此任務了，無法重解！
        else
                say 唉呀，粗心的傢伙，竟然弄丟了我給你的契約書，算了，
                say 再幫你補發一張吧，但是要扣除你的經驗值作為代價，如何？
                say (yes/no)
        endif
endif
~
