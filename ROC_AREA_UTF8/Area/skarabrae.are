#2962
mercenary-skarabrae~
傭兵(mercenary)~
一個傭兵(mercenary)正在這裡等雇主上門。
~
一個來自西方的人類傭兵，看來十分精明。
~
1|2|8192|67108864 0 100 S
37 0 0 0d0+0 0d0+0
0 0
0 8 1
>talk_prog topic~
if notbeing($b)
        say 要雇用我(hire)嗎？
        say 我的能力會隨著戰鬥成長。
else
        if rembch($n)
                tell $b 你想要知道目前我戰鬥經驗累積的狀況(experience)嗎？
                tell $b 或是你想確認合約(contract)的狀況？
                tell $b 你也可以命令我做一些事情，例如丟下(drop)、拿起(get)、移除(remove)或穿上(wear)所有裝備。
        endif
endif
~
>talk_prog contract~
if rembch($n)
        if is_qmark($i) != skarabrae_merc_hire
                say 咦，合約已經過期了！
                say 那麼，後會有期！
                remove all
                drop all
                wave $b
                mppurge self
                break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1002
                say 合約只剩下不到兩個小時了。
                say 要續約只要給我聘金三十萬就可以了。
                break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1006
                say 合約大概還剩下三到五個小時。
                break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1010
                say 合約大概還剩下六到九個小時。
                break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1014
                        say 合約大概還剩下半天左右。
                        break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1022
                say 合約超過半天，不用擔心。
                break
        endif
        if is_qmark($i) < skarabrae_merc_hire 1025
                say 合約大約還有一天整。
        else
                if is_qmark($i) < skarabrae_merc_hire 1048
                        say 合約超過一天。
                else
                        say 合約超過兩天。
                endif
        endif
endif
~
>talk_prog drop~
if rembch($n)
        drop all
endif
~
>talk_prog get~
if rembch($n)
        get all
endif
~
>talk_prog remove~
if rembch($n)
        remove all
endif
~
>talk_prog wear~
if rembch($n)
        wear all
endif
~
>talk_prog hire~
if notbeing($b)
                look $n
        if level($n) < 36
                say 我只接受經驗足夠的冒險者雇用。
        else
                nod $n
                say 三十萬一天，不二價。
        endif
endif
~
>rand_prog 50~
if being($b)
        if is_qmark($i) != skarabrae_merc_hire
                tell $b 抱歉，合約已經過期了，
                tell $b 以後有機會的話歡迎雇用我！
                wave $b
                remove all
                drop all
                mppurge self
        else
                if insameroom($b)
                else
                        if is_qmark($i) >= skarabrae_merc_hire 1006
                                mpmod_qmark self skarabrae_merc_hire timer - 5
                        endif
                        break
                endif
        endif
else
        if is_qmark($i) == skarabrae_merc_hire
                mpcallout 1 say 雇主呢？
                mpcallout 2 mpecho $I 喃喃自語著：「竟然無視合約跑掉了....」
                mpcallout 3 mpecho $I 轉身離開。
                mpcallout 4 mpcall skarabrae_return_pub 2955
        endif
endif
~
>defun_prog skarabrae_return_pub~
mpgoto 2955
if insameroom(mercenary-skarabrae)
        mpgoto 2958
endif
~
>bribe_prog 300000~
mpjunk all.coins
if level($n) < 36
        say 我只接受經驗足夠的冒險者雇用。
        mpgold $n 300000
        break
endif
if being($b)
        if rembch($n)
                say 你要延長合約嗎？
                mpcallout 1 say 好，合約時間增加了 一天 。
                if is_qmark($i) == skarabrae_merc_hire
                        mpmod_qmark self skarabrae_merc_hire timer + 24
                else
                        mpadd_qmark self skarabrae_merc_hire 24 0 0 0 1 0
                endif
        else
                say 我已經被$B雇用了，改天再說。
                mpjunk all.coins
                mpgold $n 300000
        endif
else
        mpjunk all.coins
        nod $n
        mpdef_rembch $n
        mpgroup $b self 0 1
        if is_qmark($i) != skarabrae_merc_exp
                mpadd_qmark self skarabrae_merc_exp -1 0 0 0 0 1
        endif
        if is_qmark($i) == skarabrae_merc_hire
                mpmod_qmark self skarabrae_merc_hire timer = 24
        else
                mpadd_qmark self skarabrae_merc_hire 24 0 0 0 1 0
        endif
endif
~
>fight_prog 30~
if being($b)
	if insameroom($b)
		if fightwith($i) == $b
			say 你竟然攻擊我，那我也不必履行合約了！
			mpdef_rembch null-tar
			group leave
			if is_qmark($i) == skarabrae_merc_hire
				mpdel_qmark self skarabrae_merc_hire
			endif
			break
		endif
	endif
endif
if hitprcnt($i) < 50
	mpat 5 cast heal
endif
skilldrv multihit $n
if insameroom($b)
        if rand(25)
                if is_qmark($i) < skarabrae_merc_exp 100100
                        mpmod_qmark $i skarabrae_merc_exp v0 + 1
                        if rand(50)
                                mpmodify dr + 1
                        else
                                mpmodify hr + 1
                        endif
                endif
                break
        endif
        if rand(33)
                if is_qmark($i) < skarabrae_merc_exp 200100
                        mpmod_qmark $i skarabrae_merc_exp v1 + 1
                        if rand(50)
                                mpmodify ac - 7
                                mpmodify dc - 3
                        else
                                mpmodify ac - 3
                                mpmodify dc - 7
                        endif
                endif
        else
                if is_qmark($i) < skarabrae_merc_exp 300100
                        mpmod_qmark $i skarabrae_merc_exp v2 + 1
                        if rand(50)
                                mpmodify hp + 10
                        else
                                mpmodify hp + 30
                        endif
                endif
        endif
endif
~
>talk_prog experience~
if being($b)
        if insameroom($b)
                if is_qmark($i) == skarabrae_merc_exp
                        tell $b 目前我的戰鬥經驗累積狀況：
                        if is_qmark($i) < skarabrae_merc_exp 100025
                                mpechoat $b [1;35m 攻    擊[m：初級
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 100050
                                if is_qmark($i) >= skarabrae_merc_exp 100025
                                        mpechoat $b [1;35m 攻    擊[m：中級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 100075
                                if is_qmark($i) >= skarabrae_merc_exp 100050
                                        mpechoat $b [1;35m 攻    擊[m：高級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 100100
                                if is_qmark($i) >= skarabrae_merc_exp 100050
                                        mpechoat $b [1;35m 攻    擊[m：頂級
                                endif
                        endif
                        if is_qmark($i) == skarabrae_merc_exp 100100
                                mpechoat $b [1;35m 攻    擊[m：完美
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 200025
                                mpechoat $b [1;35m 防    禦[m：初級
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 200050
                                if is_qmark($i) >= skarabrae_merc_exp 200025
                                        mpechoat $b [1;35m 防    禦[m：中級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 200075
                                if is_qmark($i) >= skarabrae_merc_exp 200050
                                        mpechoat $b [1;35m 防    禦[m：高級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 200100
                                if is_qmark($i) >= skarabrae_merc_exp 200050
                                        mpechoat $b [1;35m 防    禦[m：頂級
                                endif
                        endif
                        if is_qmark($i) == skarabrae_merc_exp 200100
                                mpechoat $b [1;35m 防    禦[m：完美
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 300025
                                mpechoat $b [1;35m 耐    力[m：初級
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 300050
                                if is_qmark($i) >= skarabrae_merc_exp 300025
                                        mpechoat $b [1;35m 耐    力[m：中級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 300075
                                if is_qmark($i) >= skarabrae_merc_exp 300050
                                        mpechoat $b [1;35m 耐    力[m：高級
                                endif
                        endif
                        if is_qmark($i) < skarabrae_merc_exp 300100
                                if is_qmark($i) >= skarabrae_merc_exp 300050
                                        mpechoat $b [1;35m 耐    力[m：頂級
                                endif
                        endif
                        if is_qmark($i) == skarabrae_merc_exp 300100
                                mpechoat $b [1;35m 耐    力[m：完美
                        endif
                endif
        endif
endif
