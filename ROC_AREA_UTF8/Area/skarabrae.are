        if is_qmark($n) == thief_quest_list 100000
                mpecho $I 將鞋子拿起來看了看....，接著又檢視了你的相關任務記錄....
                if is_qmark($n) & thief_quest_reward 100001
                        say 我已經將改造過後沒有等級上限的暗器鞋給您了....。
                        give shoes $n
                else
                        if is_qmark($n) != thief_quest_reward
                                mpadd_qmark $n thief_quest_reward -1 1 0 0 0 1
                        else
                                mpmod_qmark $n thief_quest_reward v0 | 1
                        endif
                        mpjunk all.shoes
                        mpcallout 2 nod $n
                        mpcallout 3 say 的確，你已經完成了本公會所有的任務。
                        mpcallout 4 say 我立即將沒有等級限制的暗器鞋交給您....。
                        mpcallout 4 mpoload 3126 $n viclv
                        mpcallout 5 give shoes $n
                endif
        endif
endif
