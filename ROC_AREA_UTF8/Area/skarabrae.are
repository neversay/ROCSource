>repop_prog 100~
mpadd_qmark $i delayed_cast -1 999 0 0 0 1
~
>talk_prog p help peddler~
if is_qmark($n) == serpent_peddler_quest 100003
                if insameroom(peddler-m)
                        mpechoat $n 你決定保護小生意人對付煉金師.
                        mpmod_qmark $n serpent_peddler_quest v0 = 4
                        say 好吧！那你們就試試我的厲害！
                        cast fireball peddler-m
                        mpforce $n rescue peddler-m
                endif
        endif
~
>talk_prog p help silent~
if is_qmark($n) == serpent_peddler_quest 100003
                if insameroom(peddler-m)
                        mpechoat $n 你決定停止保護小生意人.
                        mpmod_qmark $n serpent_peddler_quest v0 = 100
                        mpforce peddler-m follow self
                        mpforce peddler-m group leave
                        cast powerball peddler-m
                endif
        endif
~
>bribe_prog 400000~
if is_qmark($n) == skarabrae_alchemist_mercenary
        if being($b)
                if rembch($n)
                        mpmod_qmark self skarabrae_alchemist_follow timer + 48
                        bow $n
                        say OK，再多幫你兩天...
                else
                        say 報歉! 我正在幫 $b 的忙，等下有空就幫你。
                        give coins $n
                endif
        else
                say 好的，朋友，你現在需要我是吧？
                mpgroup $n self 0 1
                mpdef_rembch $n
                mpmod_qmark $n skarabrae_alchemist_mercenary v0 + 1
                if is_qmark($i) == skarabrae_alchemist_follow
                        mpmod_qmark self skarabrae_alchemist_follow timer = 48
                else
                        mpadd_qmark self skarabrae_alchemist_follow 48 0 0 0 1 0
                endif
        endif
else
        say 無功不受錄，你給我這麼多錢做什麼？
        give coins $n
endif
mpjunk coins
~
>tick_prog 30~
if inroom($i) == 3006
or isfight($i)
        break
endif
if being($b)
        if is_qmark($i) == skarabrae_alchemist_follow
                break
        endif
endif
say 對不起，我們的契約到期了，希望下次還能合作。
wave $b
follow self
group leave
mpecho $I離開隊伍回去了。
mpgoto 3006
mpdel_qmark self skarabrae_alchemist_follow
mpdef_rembch null-tar
