#3305
Retini-skarabrae~
蕾蒂妮(Retini)~
種族學助理蕾蒂妮(Retini)正在整理資料。
~
她是種族學教授賴斯(Race)的助理，在賴斯因故逃亡後就成了種族學這門課唯一
的講師，由於年輕漂亮又有實力，因此她在學生間擁有相當不錯的風評與人氣。
~
67 0 1000 S
30 0 0 0d0+0 0d0+0
-1 0
0 8 2
P 8
>talk_prog topic~
if ispc($n)
        if is_qmark($n) != skarabrae_study_questmark
                mpadd_qmark $n skarabrae_study_questmark -1 0 0 0 0 1
        endif
        if rand(90)
                say 真傷腦筋......老師一走留下很多問題要解決......
        else
                if is_qmark($n) !& skarabrae_study_questmark 100001
                        if is_qmark($n) != skarabrae_study_quest01
                                say 你看起來不太像是新來的學生......有什麼事嗎？
                                say 啊，該不會你是商會派來協助解決這個問題的冒險者？
                                mpadd_qmark $n skarabrae_study_quest01 -1 1 0 0 0 1
                        else
                                if is_qmark($n) > skarabrae_study_quest01 100001
                                        say 問題解決了嗎？
                                else
                                        say 真傷腦筋......老師一走留下很多問題要解決......
                                endif
                        endif
                else
                        say 上次的事情感謝你的協助。
                endif
        endif
endif 
~
>talk_prog race~
if rand(50)
        say 他是我的老師，也是種族學的教授。
else
        say 老師最近好像惹上了一點麻煩，短時間內不會來學院了。
endif
~
>talk_prog yes~
if is_qmark($n) == skarabrae_study_quest01 100001
        say 好的，那麼我就將事情經過詳細地告訴你。
        say 大約幾天前，有學生在圖書間某處發現一本被靈體附著的古書。
        say 由於這本書是賴斯(Race)老師留下的，所以我也不敢亂動。
        say 但是最近這棟校舍因為那本書而發生了不少怪事，因此我才委託商會協助。
        say 大致上就是這樣，另外這就是那本書，你想知道更多資訊可以問問學院裡的學生們。
        mpechoat $n $I說完話的同時給了你一本可以拿來當磚頭的書！
        mpechoaround $n $I給了$N一本厚得嚇人的書！
        mpmod_qmark $n skarabrae_study_quest01 v0 = 2
endif
~
>all_greet_prog 100~
if is_qmark($n) == skarabrae_study_quest01 100010
        if class($n) == 7
        or class($n) == 8
                mpechoat $n 你把書本還給了$I，並將之前發生的事件告訴了她。
                nod $n
                say 這樣應該就沒問題了，學生們也可以安心唸書。
                say 不愧是商會派來的，真是可靠呢。
                say 總之，謝謝你的協助，也請代我向商會致意。
                mpexp $n 5000
                mpskillexp $n 5000
                mpresp $n 1
                mpdel_qmark $n skarabrae_study_quest01
                mpmod_qmark $n skarabrae_study_questmark v0 | 1
        endif
        if class($n) == 9
        or class($n) == 10
                mpechoat $n 你對$I隱瞞了自己已經把書賣掉的事實，編了個謊言。
                sigh $n
                say 那本書的問題竟然這麼大？真令人不敢相信。
                say 暗黑主宰到底想利用那本書進行什麼可怕的陰謀......？
                say 這真是太可怕了，還好史卡拉貝政府已經決定接手，應該沒問題了才對。
                say 真是太感謝你了......
                mpexp $n 10
                mpskillexp $n 5000
                mpresp $n 1
                mpdel_qmark $n skarabrae_study_quest01
                mpmod_qmark $n skarabrae_study_questmark v0 | 1
        endif
        if class($n) == 17
        or class($n) == 18
        or class($n) == 19
                mpechoat $n 你作好會被責罵的心理準備，把事情經過告訴了$I。
                gasp $n
                say 你說你把書給撕爛了？怎麼會這樣，老師回來後我要怎麼跟他解釋呀......
                say 不管了，老師如果問起，我就說是你弄的。
                mpechoat $n 雖然結果不太圓滿，不過這件靈體騷動案件也算是解決了。
                mpexp $n 5000
                mpskillexp $n 5000
                mpresp $n 1
                mpdel_qmark $n skarabrae_study_quest01
                mpmod_qmark $n skarabrae_study_questmark v0 | 1
        endif
endif
~
