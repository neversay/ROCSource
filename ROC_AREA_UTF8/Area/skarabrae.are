~
>obj_command r100digit default~
if is_qmark($n) == gembanking
	if objval1($o) == 0
		oset self v0 - 1
		oset self v1 = 9
		oset self v2 + 10
		oforcer here del_qmark $n gembanking
		odef_rembch null-tar
		oforce $n save
	else
		oset self v1 - 1
		oset self v2 + 10
		oforcer here del_qmark $n gembanking
		odef_rembch null-tar
		oforce $n save
	endif
else
	echoat $n 什麼？
endif
~
>obj_command no_storegmes default~
if is_qmark($n) == gembanking
	oforce $b mpechoat $n $B苦笑著對你說：「抱歉，您的戶頭中沒有足夠數量的魔力寶石」
	oforcer here del_qmark $n gembanking
	odef_rembch null-tar
else
	echoat $n 什麼？
endif
