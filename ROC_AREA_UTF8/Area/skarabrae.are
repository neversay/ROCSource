S 16 -1000
>greet_prog 100~
if is_qmark($n) == skarabrae_enemy
        if mobcount(3011) > 0
                yell 執法者，請擊退史卡拉貝的敵人$N吧！
                if insameroom(enforcer-skarabrae)
                else
                        mptransfer enforcer-skarabrae
                endif
                mpforce enforcer-skarabrae hunt $n
                mpforce enforcer-skarabrae frenzy
                hunt $n
                mpnowait
        else
                say 史卡拉貝的敵人，覺悟吧！
                hunt $n
                frenzy
        endif
        break
endif
if inroom($n) != 3232
        mpgoto 3232
        break
endif
if level($n) > 42
        bow $n
        break
endif
if is_qmark($n) == skara_baby_quest2 100002
        say 你還沒採到嗎？不妨問問別人吧。
        brea
endif
if is_qmark($n) == skara_baby_quest2 100003
        smile $n
        break
endif
if is_qmark($n) == skara_baby_quest2
        break
endif
if ispc($n)
        if level($n) > 9
                nod $n
                say 我已經聽說過你的事蹟了，年輕的冒險家$N。
                say 我想拜託你一件事，當然報酬是優渥的，
                say 你願意接受嗎？(talk ethen yes 或 no)
                mpadd_qmark $n skara_baby_quest2 -1 1 1 1 0 1
        else
                sigh $n
                say 你還太嫩了，不能擔大任。
        endif
endif
~
>talk_prog p yes~
if is_qmark($n) == skara_baby_quest2 100001
        nod $n
        say 我需要一株龍葵(nightshade)做藥引，請你幫我採一株好嗎。
        say 據我所知，在城西北的藍色小精靈村有，麻煩你找找看。
        say 採到後，直接交給我(give)就可以了。
        say 切記，龍葵有毒，千萬別誤食了。
        mpmod_qmark $n skara_baby_quest2 v0 + 1
endif
~
>talk_prog p no~
if is_qmark($n) == skara_baby_quest2 100001
        sigh
        say 真是傲慢的年輕人。
        mpmod_qmark $n skara_baby_quest2 v0 + 2
endif
~
>defun_prog baby_quest2~
if is_qmark($n) == skara_baby_quest2 100002
        smile $n
        say 謝謝你，年輕人，這是你的報償：
        mpjunk nightshade
        mpoload 3055 12
        give recovery $n
        if class($n) < 5
                mpexp $n 1500
        else
                mpexp $n 1000
        endif
        mpgold $n 1500
        mpmod_qmark $n skara_baby_quest2 v0 + 1
        say 這張魔盾能夠給你很大的保護，使你在面對魔怪的戰鬥中
        say 沒有後顧之憂，這樣你便能夠放心到城外探險了。
        say 你可以先到密登尼森林看看，那裡也有一個試煉。
        say 另外，前兩天酒吧老闆馬修送酒來給我時，提到他也願意助你一臂之力。
        say 你不妨去找他，就說是我介紹的(talk mathew ethen)。
        wave $n
        say 加油啊，$N，願天神(Zcecil)保護你.....
else
        say 啊？我已經有了。
        give nightshade $n
endif
