>fight_prog 20~
if hitprcnt($i) > 70
        if rand(90)
                mpecho $I瘋狂地對你進行一連串的攻擊！
                skilldrv multihit $n
                skilldrv multihit $n
        else
                frenzy
        endif
else
        if is_qmark($i) >= skarabrae_defensive 100005
                break
        endif
        mpecho $I小心翼翼地採取防守陣勢。
        mpmodify ac - 100
        mpmodify dc - 100
        if is_qmark($i) == skarabrae_defensive
                mpmod_qmark self skarabrae_defensive v0 + 1
        else
                mpadd_qmark self skarabrae_defensive -1 1 0 0 0 1
        endif
endif
