>tick_prog 100~
if inroom($i) != 10328
	mpgoto 10328
	break
endif
if month($) == 14
	if day($) == 6
		if hour($) > 21
		or hour($) < 3
			if rand(15)
				mpcall meteor_group
			else
				mpcall meteor_single
				mpcall meteor_rate
			endif
		endif
	else
		if hour($) > 21
		or hour($) < 3
			mpcall meteor_single
		endif
	endif
else
	if day($) == 6
		if hour($) > 21
		or hour($) < 3
			mpcall meteor_single
			mpcall meteor_rate
		endif
	else
		if hour($) > 21
		or hour($) < 3
			mpcall meteor_single
		endif
	endif
endif
~
>defun_prog meteor_group~
mpechotoall [1;36m一群流星劃破漆黑的夜空，照耀著整片大地！[m
mpforcer here modrvt v0 + 6
mpforcer here modrvt v1 + 3
mpoload 10330
telefragment fragment
mpoload 10330
telefragment fragment
mpoload 10330
telefragment fragment
mpoload 10330
telefragment fragment
mpoload 10330
telefragment fragment
mpoload 10330
telefragment fragment
if rand(20)
	mpoload 10330
	telefragment fragment
	mpforcer here modrvt v0 + 1
	mpforcer here modrvt v1 + 1
endif
if rand(15)
	mpoload 10330
	telefragment fragment
	mpforcer here modrvt v0 + 1
	mpforcer here modrvt v1 + 1
endif
if rand(10)
	mpoload 10330
	telefragment fragment
	mpforcer here modrvt v0 + 1
	mpforcer here modrvt v1 + 1
endif
~
>defun_prog meteor_single~
if rand(15)
	if rand(60)
		mpechotoall [1;36m一顆流星劃破漆黑的夜空！[m
	else
		mpechotoall [1;36m一顆流星劃破漆黑的夜空，掉落在地上！[m
		mpoload 10330
		mpforcer here modrvt v0 + 1
		mpforcer here modrvt v1 + 1
		telefragment fragment
	endif
endif
~
>defun_prog meteor_rate~
if rand(10)
	if rand(50)
		mpechotoall [1;36m一顆流星劃破漆黑的夜空！[m
	else
		mpechotoall [1;36m一顆流星劃破漆黑的夜空，掉落在地上！[m
		mpforcer here modrvt v0 + 1
		mpforcer here modrvt v1 + 1
		mpoload 10330
		telefragment fragment
	endif
endif
~
