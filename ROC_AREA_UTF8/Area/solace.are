50 2000 0 20d10+0 0d0+0
34 0
0 8 0
P 8
C 11
>entry_prog 100~
if insameroom(tiamat)
        if is_qmark($i) == solace_adventurer_hire 100000
                if being($b)
                        shout 緹雅瑪特(Tiamat)，我終於找到你了，受死吧！
                        mpmod_qmark self solace_adventurer_hire v0 = 1
                        mpat tiamat mpadd_qmark tiamat solace_adventurer_quest 200 0 0 0 1 0
                        mpat tiamat mpforce tiamat mpdef_rembch $b
                        mpat $b mpmod_qmark $b solace_adventurer_quest v0 = 3
                        if insameroom($b)
                                tell $b 一起奮戰吧！
                        else
                                tell $b 趕快來幫助我吧！我單獨一個人撐不久的....！
                        endif
                        hunt tiamat
                        mpnowait
                endif
        endif
endif
if inroom($i) == 16058
        say 我們已經到達了楓紅林的漁港，讓我們上船吧。
        mpechoat $b 你登上了 $I 的私人小船....
        mptransfer $b 16060
        mpcallout 1 mpgoto 16060
        mpcallout 2 mpforcer here modrvt v0 = 1
endif
if inroom($i) == 2222
        say 這邊如果沒有穿牆術(pass door)我是沒有辦法過去的....。
        mpcallout 1 say 你可以給我喝霧化藥水(misty potion)....，
        mpcallout 2 say 那麼我就可以跟隨你穿過這道牆壁。
endif
if inroom($i) == 2243
        if is_equ_obj($i) != 10331
                if is_inv_obj($i) == 10331
                        remove all
                        wear dragonslicer
                        wear hammer
                else
                        say 沒想到轉眼間就已經到了這裡，
                        say 如果能夠有斬龍劍的幫助，
                        say 斬殺緹雅瑪特更能易如反掌。
                endif
        endif
endif
~
>give_prog 2015~
if inroom($i) == 2222
        if is_qmark($i) == solace_adventurer_hire
                say 好的，我立即喝下霧化藥水....。
                mpcallout 1 qua potion
        endif
endif
~
>give_prog 2384~
if inroom($i) == 2222
        if is_qmark($i) == solace_adventurer_hire
                say 好的，我立即喝下霧化藥水....。
                mpcallout 1 qua potion
        endif
endif
~
>give_prog 10331~
if is_qmark($i) >= solace_adventurer_hire 100000
        if is_equ_obj($i) == 10331
                say 我手上已經裝備斬龍劍了呢。
                sm $n
                drop dragonslicer
        else
                bow $n
                remove all
                wear dragonslicer
                wear hammer
        endif
else
        ? $n
        drop dragonslicer
endif
~
>fight_prog 80~
if is_equ_obj($i) == 10331
        if rand(40)
                if insameroom(tiamat)
                        yell 看我的狂龍八斬法！
                        perform empslash
                        mpnowait
                        perform empslash
                        mpnowait
                endif
        endif
else
        if is_inv_obj($i) == 10331
                wear dragonslicer
        endif
endif
if is_qmark($i) == solace_adventurer_hire 100001
        if vnum($n) == 2220
                if insameroom($b)
                else
                        tell $b 趕快過來幫我啊！緹雅瑪特(Tiamat)好強。
                        mpmod_qmark self solace_adventurer_hire v1 + 1
                        if is_qmark($i) == solace_adventurer_hire 200005
                                tell $b 快來幫我啊！我快要不行了！
                        endif
                        if is_qmark($i) == solace_adventurer_hire 200010
                                tell $b 再不來幫我，我快要被緹雅瑪特(Tiamat)打死啦！
                        endif
                        if is_qmark($i) == solace_adventurer_hire 200012
                                rumor 由於 $b 遲遲不肯幫助隊友 $b ，讓他葬送在緹雅瑪特(Tiamat)的爪下。
                                if is_qmark(tiamat) == solace_adventurer_quest
                                        mpdel_qmark tiamt solace_adventurer_quest
                                        mpat $b mpmod_qmark $b solace_adventurer_quest v0 = 9
                                        mpat $b mpmod_qmark $b solace_advneturer_quest timer = 500
                                endif
                                shout 我會記住你的， $b。
                                if is_equ_obj($i) == 10331
                                        remove dragonslicer
                                        drop dragonslicer
                                endif
                                mppurge self
                        endif
                endif
        endif
endif
if insameroom($b)
else
        if is_qmark($i) >= solace_adventurer_hire 1010
                mpmod_qmark self solace_adventurer_hire timer - 5
        endif
endif
if isgood($n)
        say 啊！我不能夠欺負善良！
        flee
        flee
endif
if race($n) == Human
        say 啊！我不能夠攻擊同類！
        flee
        flee
endif
~
>talk_prog restart~
if is_qmark($n) & mist_quest 100008
        say 抱歉，你已經完成了這項任務。
        break
endif
if is_qmark($n) == solace_adventurer_quest 100009
        say 我永遠不會忘記你對我做過的事情。
        break
endif
if is_qmark($i) == solace_adventurer_hire
        if being($b)
                if insameroom($b)
                        say 抱歉，我目前已經被 $b 雇用了。
                else
                        say 奇怪，我的雇主 $b 又跑到那邊去了？
                endif
        else
                sigh
                mpcallout 1 say 我的雇主不知道又跑到那邊去了？
                mpcallout 2 say 回去索雷斯城找找看吧。
                mpcallout 3 mpechoat $n $I 不理你的話，頭也不回的離開了....。
                mpcallout 3 mpechoaround $n $I 不理 $n 的話，頭也不回的離開了....。
                mpcallout 4 mppurge self
        endif
        break
endif
if is_qmark($n) <= solace_adventurer_quest 100004
        mpechoat $n 遠方傳來一陣聲響「此項任務已經可以重新開始。」
        mpdel_qmark $n solace_adventurer_quest
endif
~
>rand_prog 50~
if being($b)
        if is_qmark($i) == solace_adventurer_hire
                if insameroom($b)
                else
                        tell $b 你跑到那邊去了？
                        tell $b 趕緊回來完成我們的任務啊。
                        if is_qmark($i) > solace_adventurer_hire 1005
                                mpmod_qmark self solace_adventurer_hire timer - 5
                        endif
                endif
        else
                tell $b 你的速度實在是太慢了，我只好另找高明了。
                mppurge self
        endif
else
        if is_qmark($i) == solace_adventurer_hire
                say 又是一個沒有完成任務就離開的傢伙。
                shrug
                mpecho $I 往索雷斯城的方向走去....
                mppurge self
        endif
endif
~
>kill_prog 100~
if is_qmark($i) == solace_adventurer_hire 100001
        if vnum($n) == 2220
                shout 太好了，我終於親自殺掉緹雅瑪特了！
                if insameroom($b)
                else
                        mpgoto $b
                endif
                if is_qmark($b) == mist_quest
                        mpmod_qmark $b mist_quest v0 | 8
                else
                        mpadd_qmark $b mist_quest -1 8 0 0 0 1
                endif
                mpdel_qmark $b solace_adventurer_quest
                mpcall solace_adventurer_gift1 $b
        endif
endif
~
>talk_prog topic~
if being($b)
        if rembch($n)
                sm $n
                say 我們出發吧！
        else
                say 我現在正被 $b 所雇用，一切事情稍後再說！
        endif
        break
endif
say 好無聊喔！好想去探險一下....。
mpcallout 1 say 我一直都想要去龍塔....，
mpcallout 2 say 看看傳說中的緹雅瑪特(Tiamat)到底是多麼強勁。
~
>talk_prog tiamat~
if being($b)
        say 我現在正被 $b 所雇用，一切事情稍後再說！
        break
endif
if is_qmark($n) & mist_quest 100008
        say 你好，希望我們往後還有機會可以一起合作。
        break
endif
if is_qmark($n) == solace_adventurer_quest 100009
        tell $n 你對我做過的事情，我永遠不會忘記的。
        break
endif
say 喔！你願意帶我去風之大陸嗎？
say 我願意為你的冒險旅程付出(support)一些微薄心力。
~
>talk_prog support~
if being($b)
        say 我現在正被 $b 所雇用，一切事情稍後再說！
        break
endif
if is_qmark($n) & mist_quest 100008
        say 你好，希望我們往後還有機會可以一起合作。
        break
endif
if is_qmark($n) == solace_adventurer_quest 100009
        tell $n 你對我做過的事情，我永遠不會忘記的。
        break
endif
if class($n) < 5
	tell $n 你還太弱小了，我怕你幫不上忙。
	break
endif
if is_qmark($n) == solace_adventurer_quest
        say 抱歉，你曾經接過這項任務，但卻沒有完成。
        mpcallout 1 say 若需要重新開始本項任務，請跟我說 <talk adventurer restart> 。
        break
endif
if area($i) == solace
        nod $n
        say 我在楓紅林的小漁港有一艘私人的小船，
        say 能夠快速地到達目的地，
        say 我們先到楓紅林的漁港去吧。
        mpdef_rembch $n
        mpgroup $n self 1 0
        mpadd_qmark self solace_adventurer_hire 200 0 0 0 1 0
        mpadd_qmark $n solace_adventurer_quest 200 0 0 0 0 1
else
        say 我想要先回去家鄉索雷斯城(solace)處理一些事務。
        mpcallout 1 tell $n 這樣好了，我先回去索雷斯城(solace)等你。
        mpcallout 2 tell $n 如果你有需要，就來索雷斯城找我吧！
        mpcalluot 3 tell $n 索雷斯城(solace)位於迷霧之島水晶湖的北方。
        mpcallout 4 wave $n
        mpcallout 5 mppurge self
endif
~
>defun_prog solace_adventurer_gift1~
say 真是太感謝您了， $b 。
say 因為你的幫助，我才得以親自除去強大的緹雅瑪特(Tiamat)。
if is_equ_obj($i) == 10331
        remove dragonslicer
endif
if is_inv_obj($i) == 10331
        give dragonslicer $b
        say 謝謝你的斬龍劍。
endif
if class($b) < 5
        mpexp $b 10000
else
        mpexp $b 30000
endif
mpresp $b 3
if class($b) < 5
	say 不管如何，我一定要送你一個小禮物。
	say 只是你現在還太弱小了，等你長大之後再來找我拿禮物吧。
	mpmadd_qmark $b solace_adventurer_gift -1 0 0 0 0 1
else
	say 不管如何，我一定要送你一些個人的小禮物。
	mpecho $I 由自己的行李袋中，拿出了一件物品....。
	mpechoat $b $I 將禮物交給了你....。
	mpechoaround $b $I 將禮物交給了 $b ....。
	if class($b) == 11
	or class($b) == 12
