		if is_equ_obj($n) == 10278
			echoat $n 你把整套潛水裝備好，並打開氧氣罐的開關。
			oforcer here callout 1 echoat $n 慢慢的氧氣從供氣器傳送出。
			oforcer here callout 2 echoat $n 現在你可以開始潛水了！
			oforcer here add_affect $n 'breathe water' 1100 -1 17179869184
		else
			echoat $n 你忘記穿氧氣桶前，要先綁上潛水腰帶，所以先把氧氣罐放下了。
			ogoto self
		endif
	else
		echoat $n 你忘記穿氧氣桶前，要先裝上供氣器，所以先把氧氣罐放下了。
		ogoto self
	endif
else
	echoat $n 你忘記穿氧氣桶前，要先穿好潛水蹼，所以先把氧氣罐放下了。
	ogoto self
endif
~
>obj_rand 100~
