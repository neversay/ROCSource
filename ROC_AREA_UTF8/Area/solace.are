>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpoload 10201 40
mpoload 10298 40
mpoload 10202 40
mpoload 10203 40
mpoload 10204 40
mpoload 10205 40
mpoload 10206 40
mpoload 10207 40
mpoload 10209 40
mpoload 10208 40
mpoload 10331 40
mpoload 10211 40
mpoload 10212 40
mpoload 10213 40
mpoload 10213 40
wear all
mpoload 10210
mpoload 10306
~
>defun_prog solace_enemy~
if is_qmark($n) == solace_enemy
        yell 大膽的狂徒，給我受死吧！
        hunt $n
        break
endif
~
>fight_prog 40~
if rand(30)
        yell 喝！冰凍法術對我沒用啦！
        mpdis_magic self chill
        break
endif
if isaffected($i) & 1
        yell 哈哈哈！盲目術對我是沒有用的....。
        c 'cure blindness'
        mpnowait
endif
if isaffected($i) & 4096
        yell 糟糕！我中毒了....。
        mpecho $I [1;33m趕緊喝下了解毒的藥水....。[m
        mpdis_magic self poison
endif
if isaffected($i) & 8388608
        mpdis_magic self mute
        yell 禁言術在索雷斯城中對我是沒有用的....！
endif
if isaffected($i) & 16777216
        yell 你是無法封鎖住我的魔法的....！
        mpdis_magic self 'seal magic'
endif
if isaffected($i) & 268435456
        mpecho $I [1;33m在全身無法動彈時，由口中吞下一顆藥丸....。[m
        mpecho $I [1;33m身上的麻痺術被解開了....。[m
        mpdis_magic self paralyze
endif
~
>greet_prog 100~
mpcall solace_enemy $n
if rand(30)
        if isgood($n)
                sm $n
                mpcallout 1 say 歡迎 $n 蒞臨 索雷斯城(Solace) 。
        else
                look $n
                mpcallout 1 say 索雷斯城(Solace)法律嚴明，千萬不要在裡頭鬧事。
        endif
endif
~
>talk_prog news~
mpcall solace_enemy $n
if is_qmark($n) & solace_quest_record 100001
        say 你也聽說了嗎！
        say 真不不知道艾思摩亞(Ismoa)要找的人(people)到底什麼時候才會出現。
        if is_qmark($n) != solace_quest_record
                mpadd_qmark $n solace_quest_record -1 0 1 0 0 1
        endif
endif
~
>talk_prog people~
if is_qmark($n) & solace_quest_record 100001
        say 你能通過試練之窟的考驗，真是太厲害了。
else
        say 我也不知道他要找一個怎樣的人，只知道他建造了一個試練之窟(trial)考驗那個人。
        mpcallout 1 say 他說，只有那個人才有能力通過考驗，但是至今也沒有人可以成功通過考驗(test)。
        mpcallout 1 solace_quest_record02 $n
endif
~
>defun_prog solace_quest_record02~
if is_qmark($n) !& solace_quest_record 200003
        mpmod_qmark $n solace_quest_record v1 | 2
endif
~
>talk_prog ismoa~
if is_qmark($n) !& solace_quest_record 100001
        if is_qmark($n) & solace_quest_record 20003
                say 你說艾思摩亞(Ismoa)嗎？我看他絕不是普通人物，他的兩個隨從，都身懷絕技。
                mpcallout 1 say 上次要不是有他們幫忙，我早就戰死了。
                mpcallout 1 solace_quest_record04 $n
        endif
endif
~
>defun_prog solace_quest_record04~
if is_qmark($n) !& solace_quest_record 200007
        mpcallout 1 mpmod_qmark $n solace_quest_trial v1 | 4
endif
~
>talk_prog trial~
if is_qmark($n) !& solace_quest_record 100001
        if is_qmark($n) & solace_quest_record 20003
                say 有關試練之窟的事的也不是很清楚，只知道是由艾思摩亞(Ismoa)所建造的。
                mpcallout 1 say 如果你想知道多一點關於試練之窟的事，你就要去問艾思摩亞(Ismoa)本人了。
                mpcallout 1 solace_quest_record08 $n
        endif
endif
~
>defun_prog solace_quest_record08~
if is_qmark($n) !& solace_quest_record 200011
        mpcallout 1 mpmod_qmark $n solace_quest_trial v1 | 8
endif
~
>talk_prog test~
if is_qmark($n) !& solace_quest_record 100001
        if is_qmark($n) & solace_quest_record 200015
                say 那個就是給予勇者的考驗，至於他為什麼要這樣做，我就不知道了。
                mpcallout 1 say 他說如果有人可以從裡面拿到試練之窟的魔法石，他就會送他一份禮物。
                mpcallout 2 say 說真的，他送出的禮物也絕非等閒之物，如果我有時間我也想去試一試(try)。
                mpcallout 2 solace_quest_record16 $n
        endif
endif
~
>defun_prog solace_quest_record16~
if is_qmark($n) !& solace_quest_record 200031
        mpcallout 1 mpmod_qmark $n solace_quest_trial v1 | 16
endif
~
>talk_prog try~
if is_qmark($n) !& solace_quest_record 100001
        if is_qmark($n) !& solace_quest_record 200063
                say 如果你真的想試，就去找他帶來的隨從老者(Elder)，和他說(try)就可以了。
                if is_qmark($n) & solace_quest_record 200031
                        mpmod_qmark $n solace_quest_trial v1 | 32
                endif
        endif
endif
~
>talk_prog elder~
if is_qmark($n) == solace_quest_record
        if is_qmark($n) & solace_quest_record 200063
                say 他就在噴泉廣場那邊的山洞裡。
        endif
endif
~
>talk_prog topic~
mpcall solace_enemy $n
say 歡迎光臨索雷斯城(Solace)。
mpcallout 1 say 有什麼問題請儘管問我。
~
>talk_prog solace~
mpcall solace_enemy $n
say 索雷斯城位於迷霧之島水晶湖的北邊....，
mpcallout 1 say 與迷霧大平原間隔著一座小山....，
mpcallout 2 say 也因為那座小山....，
mpcallout 3 say 使得迷霧大平原上的恐龍無法入侵索雷斯城。
~
>talk_prog obsidian~
mpcall solace_enemy $n
say 你是說黑曜石(obsidian)嗎？
mpcallout 1 say 黑曜石是迷霧之島的特產，具有強大的魔力。
mpcallout 2 say 雖然黑曜石相當的重....，
mpcallout 3 say 但是其隱藏的強大魔力仍使索雷斯城的匠師(craftsman)們趨之若鶩....，
mpcallout 4 say 他們都希望自己能夠利用這迷霧之島的特產....，
mpcallout 5 say 打造出最強大的裝備。
~
>talk_prog craftsman~
mpcall solace_enemy $n
say 索雷斯城的匠師，比起光明之鎮那些二楞子匠師好的多....，
mpcallout 1 say 索雷斯城可是迷霧之島戰鬥之城....，
mpcallout 2 say 那些史卡拉貝來這裡「遊覽」的人....，
mpcallout 3 say 完全搞不清楚兩者間武力的差距....，
mpcallout 4 mpechoat $n $I 用疑惑的眼神看著你....
mpcallout 4 mpechoaround $n $I 用疑惑的眼神看著 $n ....
mpcallout 5 say 你不會就是史卡拉貝城來的人吧？
~
>fight_prog 15~
if is_qmark($i) != solace_captain_unique-skill
        mpecho $I[1;33m忽然將手上那把劍高高的舉起........
        mpadd_qmark $i solace_captain_unique-skill 5 0 0 0 1 0
        mpcallout 1 wear doomgiver
        mpcallout 2 mpecho [1;33m天空降下一道閃電，打在[m $I[1;33m手上那把審判者之劍........[m
        mpcallout 4 yell 看我   *****   [1;36m雷       霆      萬      鈞[m   *****   的厲害！
        mpcallout 5 perform empslash
        mpcallout 5 perform empslash
        mpcallout 5 perform empslash
        mpcallout 5 mpdel_qmark $i solace_captain_unique-skill
endif
~
>fight_prog 100~
if is_qmark($i) == solace_captain_unique-skill
        break
endif
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv speedhit $n
skilldrv speedhit $n
~
>fight_prog 50~
if is_qmark($n) != solace_enemy
        mpadd_qmark $n solace_enemy 50 0 0 0 1 0
else
        mpmod_qmark $n solace_enemy timer + 5
endif
if is_qmark($i) == solace_captain_unique-skill
        break
endif
if is_equ_obj($i) != 10211
        wear doomgiver
        disarm
        mpnowait
endif
if hitprcnt($i) <= 70
        if is_qmark($i) != solace_captain_potion
                mpadd_qmark $i solace_captain_potion 200 0 0 0 1 0
        else
                if is_qmark($i) <= solace_captain_potion 100020
                        mpecho $I [1;33m見傷勢加重，趕緊掏出 [1;36m治療藥水[m 喝下....。[m
                        mpat 5 c 'double heal'
                        mpnowait
                        mpmod_qmark $i solace_captain_potion v0 + 1
                else
                        if is_qmark($i) == solace_captain_potion 100021
                                yell 糟糕，身上沒有 治療藥水 了....！
                                mpmod_qmark $i solace_captain_potion v0 + 1
                        endif
                endif
        endif
endif
if hitprcnt($i) <= 30
        if is_qmark($i) <= solace_captain_potion 200010
                mpecho $I [1;33m見傷勢加重，趕緊掏出 ** [1;36m強效靈藥[33m ** 喝下....。[m
                mpat 5 c 3 'double heal'
                mpnowait
                mpmod_qmark $i solace_captain_potion v1 + 1
        else
                if is_qmark($i) == solace_captain_potion 200011
                        yell 糟糕，身上沒有 ** 強效靈藥 ** 了....！
                        mpmod_qmark $i solace_captain_potion v1 + 1
                endif
        endif
endif
~
