                say 所以，我們就在此分手吧。
                wave $b
                mpecho $I 失神地慢慢離開.....
                mppurge self
                break
        endif
        if is_qmark($i) == hobbit_robber_quest 100002
                mpecho $I 把搶匪銬好後轉頭對 $b 說：「走，先帶他去見市長。」
                mpmod_qmark $i hobbit_robber_quest v0 = 3
                mpmod_qmark $b hobbit_robber_quest v0 = 4
                break
        endif
endif
