        nod $n
        say 你曾聽過元素峽谷這個地方嗎？據說那裡的元素流會
        say 讓人終生難忘耶！而且，我的哥哥曾經提到一位魔幻
        say 的水之主宰，我們去見識一下他的模樣好嗎？
        mpmod_qmark $i hobbit_adventure_inno v0 = 9
endif
~
>entry_prog 100~
if inroom($i) == 3006
        if is_qmark($i) != hobbit_adventure_inno 100000
                break
        endif
        say 原來咕嚕咕嚕野豬酒吧是這個樣子！
        mpecho $I睜大了眼睛四處張望，似乎忘了你的存在...
        mpmod_qmark $i hobbit_adventure_inno v0 = 1
        break
endif
if inroom($i) == 3054
        if is_qmark($i) != hobbit_adventure_inno 100003
                break
        endif
        mpecho $I環顧四周，以讚嘆的語氣說：「實在是太雄偉了！這裡....」
        mpecho $I 目不轉睛地打量四周，一時說不出話來.....
        mpmod_qmark $i hobbit_adventure_inno v0 = 4
        break
endif
if inroom($i) == 13067
        if is_qmark($i) != hobbit_adventure_inno 100006
                break
        endif
        say 哇....好清爽的空氣，萬里無雲的天空，青翠高聳的
        say 大樹，一覽無遺的美景，旅行真是好....
        mpecho $I 用力地深呼吸，彷彿要把這裡清新的味道永遠記起來....
        mpmod_qmark $i hobbit_adventure_inno v0 = 7
        break
endif
if inroom($i) == 9236
        if is_qmark($i) != hobbit_adventure_inno 100009
                break
        endif
        say 你不覺得元素峽谷真是一種奇觀嗎？
        mpecho $I 對元素形成的環境嘖嘖稱奇。
        if insameroom(water)
                say 而且，水之主宰真的如哥哥所說的如霧如幻耶！
                mpecho $I偷偷地打量著水之主宰(Water Ruler)。
        endif
        mpmod_qmark $i hobbit_adventure_inno v0 = 10
        break
endif
if inroom($i) == 1717
        if is_qmark($i) != hobbit_adventure_inno 100011
                break
        endif
        say 呵呵，世上生物無奇不有，真的要自己親眼看到...
        mpecho $I 隨興和身邊的人馬聊了起來....
        mpmod_qmark $i hobbit_adventure_inno v0 = 12
        break
endif
if inroom($i) == 14008
        if is_qmark($i) != hobbit_adventure_inno 100013
                break
        endif
        say 呀....我家就快到了。
        bow $b
        say 謝謝你陪我走過我的第一次遠遊，我覺得收穫很多。
        say 從此以後，沒人會再瞧不起我了。
        think
        say 天下沒有不散的宴席，我想我們在此分手吧？
        mpdel_qmark $i hobbit_adventure_inno
        if being($b)
                wave $b
                say 希望以後在旅途上還能有你作伴....
                mpecho $I 加快腳步回家了。
                follow self
                if class($n) < 5
                        mpexp $n 1400
                endif
                mpexp $b 2800
                mpmod_qmark $b hobbit_all_quests v0 | 1
                mpdef_rembch null-tar
        endif
        mpgoto 14094
endif
