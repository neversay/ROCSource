>talk_prog no~
shrug
say 那也沒辦法。
if is_qmark($n) == hobbit_robber_quest
        mpdel_qmark $n hobbit_robber_quest
endif
~
>talk_prog yes~
if is_qmark($n) != hobbit_robber_quest 100001
        break
else
        if isimmort($n)
                tell $n 你是神族吧！
        endif
        say 像您這麼見義勇為的人現在已經越來越少了....
        bow $n
        say 請您就在街上巡邏，只要聽到市民的呼救聲請以最快速度
        say 趕到。如果一次來不及也別氣餒，我想搶匪一定會再犯案
        say ，下次聽到呼救時跑快點就是....
        think
        say 我想，你先去找副隊長吧，她對賽伐斯拖普市區的道路比
        say 較熟，對你會有很大幫助。(talk lieutenant help)
        mpmod_qmark $n hobbit_robber_quest v0 = 2
endif
