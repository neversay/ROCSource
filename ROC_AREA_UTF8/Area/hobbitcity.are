        if insameroom(retired-m)
                mpecho $I 偷偷指著退休的大臣(retired fairy)說：「ㄟ，你不覺得這個」
                mpecho $I 說：「老人有點奇怪嗎？你過去跟他聊聊吧？」
                mpecho $I 輕輕推了 $b 一下。
        endif
        mpecho $I說：「如果你想要走了，就叫我一聲(let's go)。」
        mpmod_qmark $i hobbit_adventure_inno v0 = 8
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100010
        mpecho $I 滿足好奇心後，$I 說：「接下來....」
        mpecho $I 說：「我們到人馬村看看吧？」
        mpecho $I 說：「人馬是一種奇特生物，我一直想親眼目睹。」
        mpecho $I 說：「我們下一站就到他們的聚會所大廳參觀吧。」
        mpmod_qmark $i hobbit_adventure_inno v0 = 11
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100012
        mpecho $I 聊完天，大致理解人馬的生活情形後，轉頭對你說
        say ㄟ....這真是一趟豐富的旅程，你應該也很滿足吧？
        say 我想，旅行這麼久，我們也該回賽伐斯拖普了，走...
        mpmod_qmark $i hobbit_adventure_inno v0 = 13
        break
endif
