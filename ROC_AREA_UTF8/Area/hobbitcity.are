>greet_prog 100~
if isnpc($n)
        break
endif
if is_qmark(lieutenant) != hobbit_robber_quest 100004
if is_qmark($n) == hobbit_robber_quest 100004
        if insameroom(lieutenant)
                mpforce lieutenant say 報告市長，我們終於抓到搶匪了！
        endif
        mpmod_qmark lieutenant hobbit_robber_quest v0 = 4
        mpecho $I 很高興地走過來和你握手....
        say 太好了，太好了，您為賽伐斯拖普做了一件大事！
        clap $n
        mpmod_qmark $n hobbit_robber_quest v0 = 5
	if is_qmark($n) != hobbit_robber_newcheck
        	mpadd_qmark $n hobbit_robber_newcheck -1 0 0 0 0 1
        	say 這是您的賞金....
        	mpgold $n 100000
        endif
        say 至於那個混蛋強盜....
        star robber-h
        say 就麻煩您和副隊長送到法院去詢問吧。
        bow $n
        break
endif
endif
if rand(25)
        welcome $n
        say 請慢慢參觀這座偉大的城市。
else
        hello $n
        say 您好，您是從遠方來的朋友吧？
        say 我以賽伐斯拖普市長的身份歡迎你。
endif
~
>talk_prog topic~
bow $n
say 您好，我叫巴洛特，是賽伐斯拖普的新任市長。
say 說實話，市長這個職位真不是人幹的，整天忙個不停，
say 要操心很多事，一刻不得閒.....
sigh
say 您一定旅行過許多地方吧？現在參觀過賽伐斯拖普，
say 是否對市政有什麼建議(suggestion)呢？
~
>talk_prog suggestion~
nod $n
say 是啊，譬如，你覺得賽伐斯拖普的發展還跟得上潮流嗎？
say 之前賽伐斯拖普是一個以農業為主的市鎮，一直到上一
say 任市長都沒有改變這個傳統。不過，我旅行過許多地方，
say 看過許多興盛的國家(nations)後，深深覺得商業貿易
say (trade)才能使賽伐斯拖普快速發達起來.....
mpecho $I 忍不住露出得意的神情....
~
>talk_prog nations~
say 喔....我旅行過的國家可多啦，
mpecho $I 扳起手指開始算....
say 我從十三歲就到處跑，造訪過的大國家有史卡拉貝、綠樹
say 王國、奧夫卡、泰洛斯、尤根王國、深土城、羅胡城堡、
say 光明之鎮.....還有其他小國根本算不完。
smile $n
say 那麼您呢？去過這些地方嗎？
~
>talk_prog trade~
say 我們賀比特一向有旅行的習慣，大陸每個角落幾乎都有我
say 們的足跡。如果能將各地人文物產的知識好好利用，搬有
say 運無各地貨物，那麼可獲得的利益是以百倍計！只要大家
say 賺錢了，您說，賽伐斯拖普能夠不發達起來嗎？
sigh
say 可惜，有些沒有遠見，只知道死守祖先那塊耕地的農夫總
say 是有些意見(complains)。真是氣死人....
~
>talk_prog complains~
say 他們總是說以前的日子比較好比較安靜，緬懷一些都快變
say 古董的東西，想要讓賽伐斯拖普故步自封。其實，那是他
say 們跟不上時代潮流，看見別人發達就覺得自己遭受不公平
say 的待遇....
sigh
say 如果不趕快讓賽伐斯拖普迎頭趕上，將來世界的舞台就沒
say 有賀比特的位置，搞不好還淪為別人的附庸呢！
say 市長難當喔....
~
>talk_prog robber~
say 那些可惡狡猾的強盜，處心積慮要破壞賽伐斯拖普。
hate
say 不論任何人，只要能抓到他們，我願意給賞金十萬金幣！
look $n
say 您看起來身手不錯，願意幫助我們緝捕這些搶匪嗎(yes/no)？
~
>talk_prog no~
shrug
say 這是我們的事，原本就不該麻煩你。
~
>talk_prog yes~
if isnpc($n)
        break
endif
if is_qmark($n) & hobbit_all_quests 100008
        mpechoat $n 一陣聲音在你心中響起：「對不起，這個 quest 只能解一次。」
        break
endif
say 太好了，多一個人多一份力量....
say 有關搶匪的長相以及出沒地點，你可以去請教守備隊隊長，
say 就說是我(mayor)請你過去的。他會告訴你相關情報。
mpadd_qmark $n hobbit_robber_quest -1 0 0 0 0 1
wave $n
say 祝您好運...
~
>talk_prog restart~
if is_qmark($n) & hobbit_all_quests 100008
        mpechoat $n 一陣聲音在你心中響起：「對不起，這個 quest 只能解一次。」
        break
endif
if is_qmark($n) == hobbit_robber_quest
        mpdel_qmark $n hobbit_robber_quest
        mpat lieutenant-h mpdel_qmark lieutenant-h hobbit_robber_quest
        mpat robber-h mpforce robber-h mppurge self
        yell 應 $N 的要求，賽伐斯拖普搶劫 quest 現在重新開始！
endif
