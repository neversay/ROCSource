        mpmod_qmark $n hobbit_gandalf_quest v0 = 7
        break
endif
if vnum($n) == 14050
        if is_qmark($n) == hobbit_gandalf_quest 100003
                mpecho $I 詫異地盯著 $N 看：
                say 咦？你喝過那個東西了？真是愚蠢，那個東西會讓你魔化，
                say 他們所謂的永恆生命其實就是永遠的奴隸啊！
                say 還好你只喝了一點，還有辦法解救。現在快告訴我們主宰在
                say 這個世界打通的入口在哪裡....
                mpmod_qmark $n hobbit_gandalf_quest v0 = 4
                break
        endif
endif
if is_qmark($n) == mage_envoy_quest 100018
        gig $n
        say 你把死亡谷那個小朋友解決了？不容易啊....
        clap $n
        mpcallout 2 say 我知道一定是瑪麗叫你來找我的。瑪麗她自奉儉樸，應該沒有
        mpcallout 4 say 什麼可以報答你的東西，只好叫你來找我了，呵-呵-呵-....
        mpcallout 6 say 我該給你什麼獎勵比較好呢....
        mpcallout 6 glar $n
        mpcallout 8 say 有啦，你身上那枚紫色的戒指很有趣喔，拿給我看看吧。
        mpmod_qmark $n mage_envoy_quest v0 = 19
        break
endif
if rand(50)
        hello $n
else
        if rand(50)
                say 孩子，你好，生命在無限寬廣世界中連一瞬都談不上。
        else
                say 孩子，無論你想找什麼，先從你的心開始找吧。
        endif
endif
~
>give_prog 1476~
if is_qmark($n) == mage_envoy_quest 100019
        mpjunk all.ring
        nod $n
        mpecho $I 拿起戒子放在耳旁傾聽...
        mpcallout 2 say 不錯，不錯，有魔法女王的加持喲！這樣的話我也一起來吧。
        mpcallout 3 mpecho $I閉起眼睛，拿著戒子叩-叩-叩地敲自己的額頭！
        mpcallout 4 mpecho 你發現紫薇神戒的紫色光芒上似乎又沾染了銀白色的光澤！
        if isgood($n)
                mpcallout 6 mpoload 14102 $n viclv target
        else
                mpcallout 6 mpoload 14101 $n viclv target
        endif
        mpcallout 6 mpecho $I 將戒子放到你的手掌心中。
        mpcallout 7 say 小心地使用這枚戒子，它已是了不起的神器了！
        mpcallout 7 mpgreward exp $n -46 3500
        mpcallout 8 say 噢，還有一件事要告訴你，你們的門主就快有麻煩了。
        mpcallout 10 say 你馬上就到新囤墾區找他吧，我想腳步快點應該還趕得上。
        mpcallout 12 say 加油嘍，你也是一位出色的年輕人，我對你有很高的期望。
        mpcallout 12 wave $n
        mpcallout 22 tell $n 記得別像小匹克斯一樣，格局不要太小。別為了復興一
        mpcallout 23 tell $n 個小幫派就忘記對整個世界的責任，那太浪費你的天賦。
        mpmod_qmark $n mage_envoy_quest v0 = 20
        mpmod_qmark $n mage_envoy_quest v1 = 4
        mpdef_rembch null-tar
else
        ?
        drop all.ring
endif
~
>talk_prog topic~
if is_qmark($n) > dragonbay_mayor_secret 100008
or is_qmark($n) & dragonbay_quest_mark 100004
        say 原來是神選之人呀，請問找我有什麼事(thing)嗎？
else
        ? $n
endif
~
>talk_prog thing~
if is_qmark($i) == hobbitcity_talking
        mpechoat $n $I 正在談話中喔。
        breake
endif
if is_qmark($n) > dragonbay_mayor_secret 100008
or is_qmark($n) & dragonbay_quest_mark 100004
        mpadd_qmark $i hobbitcity_talking 3 0 0 0 0 1
        mpechoat $n [1;32m你說「我想要跟你請教有關銀龍海灣魔法傳送門(portal)的問題。」[0m
        mpechoaround $n $N[1;32m說著「我想要跟你請教有關銀龍海灣魔法傳送門(portal)的問題。」[0m
        mpcallout 1 say 魔法傳送門啊？我並不擅長空間系魔法耶！
        mpcallout 2 say 也許你可以試著去找魔法高塔中的魔法女王試試
        mpcallout 3 say 不過她的個性滿高傲的，也許你說是我請她幫忙的她會比較高興
        mpcallout 4 say 我這裡有一張銀龍海灣的座標圖，若她答應幫助你們的話
        mpcallout 5 say 可以把這張座標圖拿給她看，畢竟銀龍海灣的位置向來不多人知道
        mpcallout 6 say 而這張座標圖可得好好保管，若給有心人士取得的話
        mpcallout 7 say 那對銀龍海灣可不是一件好事。
        mpcallout 8 say 我看，我還是在座標圖上做些處理好了。
        mpcallout 9 mpecho 你看到 $I 拿出手上的座標圖，嘴裡唸唸有詞....
        mpcallout 10 say 好了，這張座標圖你就拿去吧。
        mpcallout 10 mpoload 14103 $n 1 target
        mpcallout 10 mpechoat $n $I 把手上的座標圖交給了你。
        mpcallout 10 mpechoaround $n $I 把手上的座標圖交給了$N。
        mpcallout 10 mpdel_qmark $i hobbitcity_talking
endif
~
>talk_prog samuel~
if isnpc($n)
        break
endif
if isimmort($n)
        say 你是大神吧！
endif
if is_qmark($n) & hobbit_all_quests 100004
        mpechoat $n 一陣低沈的聲音自你心中響起：這個 quest 只能解一次。
        break
endif
if is_qmark($n) == hobbit_gandalf_quest
        mpechoat $n 一陣低沈的聲音自你心中響起：如果想重解，請先找人 restart。
        break
endif
smile $n
say 預言中的人是你嗎？所以你是專程來找我的嘍？呵呵呵.....
mpecho $I 揮手示意 $n 坐下來
say 索倫已經被遺忘數百年，而今，另一個時代，另一段冒險，
say 另一群英雄又該開始他們的歷史了。
mpecho $I 摸著鬍子，和藹的看著 $n
say 孩子啊，我想知道，你真的有心為這個世界做些什麼嗎？(yes/no)
mpadd_qmark $n hobbit_gandalf_quest -1 0 0 0 0 1
~
>talk_prog yes~
if is_qmark($n) == hobbit_gandalf_quest 100000
        mpecho $I 嘉許地對 $n 點點頭....
        say 這個世界又有新的威脅了！我可以感受到他們強大的力量....
        mpecho $I 閉起眼睛似乎在回想什麼....
        say 剛開始只是一些哨兵而已，慢慢地，這些黑暗勢力便顯露出他們
        say 真正的野心，一種奴役這個世界的強烈願望(wish)....
        mpecho $I 似乎又陷入自己的想法裡，或許你該把話題接下去。
        mpmod_qmark $n hobbit_gandalf_quest v0 = 1
endif
~
>talk_prog wish~
if is_qmark($n) == hobbit_gandalf_quest 100001
        say 歐，歐，對，對.....
        say 我知道他們是來自於異世界的一個黑暗種族，武力與精神力都很
        say 強大，泰洛斯、綠樹王國、永恆之塔等地都有他們的蹤跡。
        say 不過，我是個已經超脫時空的人，不該插手再管這個世界的事，
        say 這裡的事，只有靠你們自己去解決(solve)。
        mpecho $I 睜大眼睛看著你，似乎在等你開口....
        mpmod_qmark $n hobbit_gandalf_quest v0 = 2
endif
~
>talk_prog solve~
if is_qmark($n) == hobbit_gandalf_quest 100002
        nod $n
        say 是的，沒錯，你們自己的事不能依賴別人，要自己去做....
        say 不過別擔心，我會回到這裡也是想要助你們一臂之力。
        say 你現在到賽伐斯拖普西邊的山丘，撥開樹藤後用力摩擦山壁
        say (frictionize wall)，一個暗門會打開，裡面會你需要的線索，
        say 找到後再拿來找我......
        wave $n
        say 去吧，一段新的傳說即將展開，就在你手上....
        mpmod_qmark $n hobbit_gandalf_quest v0 = 3
endif
~
>talk_prog p frictionize wall~
say 是的，去那裡用力摩擦山壁(frictionize wall)就對了。
~
>give_prog 14093~
mpjunk dark
if is_qmark($n) == hobbit_gandalf_quest 100003
        mpecho $I 打開牛皮紙看了一眼....
        say 呵呵....一條大魚正在城裡喲，你拿著這份牛皮紙去試試吧。
        say 牛皮紙上的戳記是一個重要線索，細心觀察一下就不會找錯
        say 人。有消息再回來找我吧。
        mpecho $I 把黑暗密令(dark command)又還給 $n
        mpoload 14093 $n target
        mpmod_qmark $n hobbit_gandalf_quest v0 = 4
        break
endif
pon
drop dark
~
>talk_prog wfsea~
if is_qmark($n) != mage_envoy_quest 100014
	think
	break
endif
say 喔？你就是匹克斯的手下？
glare $n
mpcallout 1 say Hmm...不錯，不錯，強將手下無弱兵，果然優秀！
mpcallout 2 say 相信匹克斯已經告訴你大概，我就不拐彎抹角了。
mpcallout 3 say 光明之鎮的大主教-瑪麗 是我滿欣賞的一位小女孩，
mpcallout 4 say 她最近碰到一點麻煩，需要有個武功足夠的人幫忙
mpcallout 5 say 一下。可惜我必須留在這裡等候某位預言中的英雄，
mpcallout 6 say 暫時分不了身...碰巧前兩天遇到你們門主，聊得還
mpcallout 7 say 算愉快。既然他自告奮勇搶著幫忙，我就順水推舟，
mpcallout 8 say 順便也看看你們風火海的能耐了...
mpcallout 9 mpecho $I摸著鬍子呵-呵-呵地笑著...
mpcallout 10 say 去吧，去找瑪麗，順便告訴她我(gandalf)很關心她。
mpcallout 10 wave $n
mpcallout 16 tell $b 既使有困難也要盡量克服，逃避(quit)是不能解決問題的！
mpmod_qmark $n mage_envoy_quest v0 = 15
mpadd_qmark $i hobbit_gandalf_wfsea 30 0 0 0 0 1
mpdef_rembch $n
~
>tick_prog 100~
if is_qmark($i) != hobbit_gandalf_wfsea
	break
endif
if being($b)
else
	mpdel_qmark $i hobbit_gandalf_wfsea
	break
endif
if is_qmark($i) == hobbit_gandalf_wfsea 1028
	mpat $b mpecho 危險！！根據長年冒險培養出的第六感，你隱約感到你被跟蹤了！
	mpat $b mpecho 遺憾的是，對方隱藏氣息的技巧相當高明，你完全找不到蛛絲馬跡...
	break
endif
if is_qmark($i) == hobbit_gandalf_wfsea 1023
	mpat $b mpecho 這種感覺真使你神經緊張，一點點風吹草動也會讓你抬頭四處張望！
	mpat $b mpecho 看來對方也有意用這種草木皆兵的壓迫感削弱你的戰鬥力...
	break
endif
if is_qmark($i) == hobbit_gandalf_wfsea 1017
	mpat $b mpmload 14089
	mpat $b mpforce assassin-h mpdef_rembch $b
	mpat $b mpforce assassin-h back $b
	mpat $b mpmload 14090
	mpat $b mpforce ninja-h mpdef_rembch $b
	mpat $b mpforce ninja-h mpgroup assassin-h self 1 0
	mpat $b mpforce ninja-h back $r
	mpat $b mpmload 14090
	mpat $b mpforce ninja-h mpdef_rembch $b
	mpat $b mpforce ninja-h mpgroup assassin-h self 1 0
	mpat $b mpforce ninja-h back $r
	break
endif
if is_qmark($i) == hobbit_gandalf_wfsea 1015
	mpat $b mpecho 剛剛那一場莫名的暗殺讓你覺得很不舒服，你一直在心中盤算著，
	mpat $b mpecho 想要釐清到底是誰、或者哪一個組織，會想以高價致你於死...
	break
endif
if is_qmark($i) == hobbit_gandalf_wfsea 1008
	mpat $b mpmload 14093
	mpat $b mpforce savant-h mpdef_rembch $b
	mpat $b mpforce savant-h mpoload 14100
	mpat $b mpmload 14091
	mpat $b mpforce sorcerer-h mpdef_rembch $b
	mpat $b mpforce sorcerer-h mpgroup savant-h self 1 0
	mpat $b mpmload 14092
	mpat $b mpforce alchemist-h mpdef_rembch $b
	mpat $b mpforce alchemist-h mpgroup savant-h self 1 0
	mpat $b mpforce alchemist-h mpkill $b
	mpat $b mpforce alchemist-h c sun
	mpdel_qmark $i hobbit_gandalf_wfsea
	break
endif
