>rand_prog 40~
if is_qmark($i) != hobbit_adventure_inno
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100001
        mpecho $I 吞了吞口水，學其他客人點菜....
        say 希妲，再來一份烤雞
        mpmod_qmark $i hobbit_adventure_inno v0 = 2
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100002
        mpecho 烤雞上來後，$I 一邊狼吞虎嚥地吃，一邊還偷偷盯著希妲...
        say 咕嚕咕嚕野豬酒吧真是名不虛傳，能夠到這吃到烤雞實
        say 在太幸福了...
        say 吃完後我們再到史卡拉貝山頂聖殿參觀好不好？
        mpmod_qmark $i hobbit_adventure_inno v0 = 3
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100004
        if insameroom(healer)
                bow healer
                say 您好，醫者，我常聽前輩們提到您無償地為冒險者們
                say 治療傷勢的精神呢！
                mpforce healer nod $i
                mpforce healer say 謝謝你，為大眾消除痛苦只是我們牧師的天職，不算什麼。
        endif
        mpmod_qmark $i hobbit_adventure_inno v0 = 5
        break
endif
if is_qmark($i) == hobbit_adventure_inno 100005
        mpecho $I對$b說：「史卡拉貝山頂聖殿不但莊嚴雄偉，更重要的
