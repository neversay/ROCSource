>talk_prog yes~
if is_qmark($i) == hobbit_adventure_inno
or being($b)
        mpechoat $n 一陣聲音在你心中響起：「對不起，有人正在解這個 quest。」
        break
endif
if isimmort($n)
        say 你是神族吧！
else
        if level($n) < 25
                say 對不起，你的等級太低了，我們無法組隊。
                break
        endif
endif
if is_qmark($n) & hobbit_all_quests 100001
        mpechoat $n 一陣聲音在你心中響起：「對不起，這個 quest 只能解一次。」
        break
endif
say 太好了，我想這一定會是一趟豐富的旅行！
hop
say 我們先到全大陸最出名的咕嚕咕嚕野豬酒吧，
say 據說那裡的烤雞和麥酒連龍人士兵都無法抵擋！走吧！
