>rand_prog 30~
if insameroom($b)
        if is_qmark($i) == hobbit_robber_quest 100005
                mpecho 看完卷宗，法官(judge)抬起頭瞪著搶匪(robber)說：
                mpforce judge say 你罪證確鑿，犯行嚴重，必須判處唯一死刑....
                mpecho 搶匪(robber)聽到這句話，嚇得臉都白了，急忙高喊：
                mpforce robber-h say 不！不！我只是奉命行事，要抓你們該去抓我老闆！
                mpforce judge say 喔？你的幕後老闆是誰？
                mpecho 搶匪(robber)支支吾吾，顫抖地說：
                mpforce robber-h say 是....是....是巴菲特大人....
                mpecho 聽到這句話，所有人一時都呆住了....
                mpmod_qmark $i hobbit_robber_quest v0 = 6
                break
        endif
        if is_qmark($i) == hobbit_robber_quest 100006
                mpforce lieutenant-h star robber-h
                say 你可別血口噴人，巴菲特先生不但是前市長，而且
                say 卸任後還很關心貧苦的農民們，捐了許多的錢出來！
                mpecho 搶匪(robber)似乎下定決心要全抖出來，語氣也不再顫抖：
                mpforce robber-h say 我也知道巴菲特大人捐了很多錢給窮人，其實我也搞不
                mpforce robber-h say 懂老闆在想什麼，他都只叫我們去搶一些富商，然後搶
                mpforce robber-h say 來的錢也不自己用，全捐給一些窮人了....
                mpecho 聽完這些話，大家都不曉得該怎麼做，有些人開始私下議論起來....
                mpmod_qmark $i hobbit_robber_quest v0 = 7
                break
        endif
        if is_qmark($i) == hobbit_robber_quest 100007
                mpecho 「啪！啪！啪！」法官(judge)用力敲著議事槌說：
                mpforce judge say 安靜！安靜！這裡是法院。
                mpecho 等大家慢慢靜下來，法官(judge)繼續詢問搶匪(robber)。
                mpforce judge say 你說的這些很難令人相信，你有沒有任何證據證明？
                mpforce robber-h say 證據？呃....這個.....
                mpecho 搶匪(robber)皺眉想了一會
                mpforce robber-h say 有了，你們可以到巴菲特先生在克里米亞路的別墅去，
                mpforce robber-h say 我們都先把搶到的錢放在那裡，你們只要把床鋪移開
                mpforce robber-h say (move bed)，就可以看到我們藏錢的地窖。
                mpforce judge say 好，副隊長可以麻煩你們過去看看嗎？如果他說的是真的，
                mpforce judge say 回程時你們請巴菲特先生一起過來了解一下好嗎？
                mpforce judge say 至於犯人嘛....法警，先把他關進牢裡！
                mppurge robber-h
                mpmod_qmark $i hobbit_robber_quest v0 = 8
                mpmod_qmark $b hobbit_robber_quest v0 = 5
                tell $b 我們到巴菲特先生的住處調查看看這件事是否屬實吧！
                tell $b 如果是真的....，我也不知道，快走吧！
                break
        endif
        if is_qmark($i) == hobbit_robber_quest 100010
                mpecho 聽到巴菲特的喃喃自語，$I 不敢相信地說：
                say 巴菲特先生，那個強盜說的都不是真的吧....
                mpecho 華倫巴非特(warren buffett)微笑地看著 $I 說：
                mpforce buffett say 柴娜基可娃，我是看著妳長大的，妳從小就是一個
                mpforce buffett say 純真又善良的女孩，不曉得去懷疑別人....
                say 不！巴菲特先生，我不相信，你是這麼的照顧貧窮人！
                mpforce buffett say 柴娜基可娃，歷史上有遠見的先知，通常都會被當
                mpforce buffett say 成邪術士釘上十字架的，我老早就有這個準備了。
                mpecho 老管家(manager)突然跳出來，擋在你和巴菲特之間：
                mpforce manager say 站住，我不會讓你們把老主人帶走的！
                mpecho 氣氛一時僵住，你看著老管家大義凜然的神情也不知如何是好....
                mpmod_qmark $i hobbit_robber_quest v0 = 11
                break
        endif
        if is_qmark($i) == hobbit_robber_quest 100011
                mpecho 華倫巴非特(warren buffett)有點生氣地說：
                mpforce buffett say 阿福！我不是已經告訴過你了嗎？怎麼還不瞭解？
                mpforce manager say 老主人，可是你一去，巴洛特那小子一定會想盡辦法...
                mpecho 華倫巴非特(warren buffett)揮手示意，要老管家(manager)不必再說。
                mpforce buffett say 當命運那天來臨時，我們必須謙卑而感激地接受。
                mpforce buffett say 我和你們一起去吧，阿福，把我的大衣拿來....
                mpforce buffett fol $i
                protect $b
                mpmod_qmark $i hobbit_robber_quest v0 = 12
                mpmod_qmark $b hobbit_robber_quest v0 = 6
                break
        endif
endif
