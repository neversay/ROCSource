#14089
mercenary assassin-h~
傭兵刺客(mercenary assassin)~
一位身著夜行服的傭兵刺客(mercenary assassin)正在執行暗殺任務。
~
一位身著夜行服的傭兵刺客(mercenary assassin)正在執行暗殺任務。
~
538823 8840 -900 S
39 2000 0 10d20+-100 0d-100+0
-1 0
0 8 1
R Ogre~
C 5
P 4|8|128|4194304|16777216
>tick_prog 100~
if being($b)
	if insameroom($b)
		break
	else
		if area($b) == skarabrae
		or area($b) == school
				break
		endif
		mpgoto $b
		yell 風火海的人統統都得死！
		backstab $b
	endif
else
	say 任務達成，多留無益。
	mppurge self
endif
~
>repop_prog 100~
mpoload 3351 34
wear all
mpadd_qmark self delayed_cast -1 99999 0 0 0 1
mpadd_qmark self delayed_stun -1 0 0 0 0 1
~
>fight_prog 40~
wear all
dis
skilldrv heavyhit $n
if rand(50)
	mpecho $I以高明的技巧悄悄繞到$N身後！
	mpgoto self
	backstab $n
endif
~
>fight_prog 100~
if fightwith($i) / assassin-h
or fightwith($i) / ninja-h
or fightwith($i) / savant-h
or fightwith($i) / alchemist-h
or fightwith($i) / sorcerer-h
or fightwith($i) / warlord-m
or fightwith($i) / martialman-m
	mpgoto self
	if pcnum($) > 0
		backstab $r
	endif
endif
~
>death_prog 50~
if being($b)
	if insameroom($b)
		if insameroom(pixiee-m)
			mpdis_magic $i all
			if is_qmark($b) == mage_envoy_quest 100021
				mpat $b mpmod_qmark $b mage_envoy_quest v2 + 1
			endif
		endif
	endif
endif
~
|
