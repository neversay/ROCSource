				oforcer here add_affect $n fly 1130 0 39 -25 0
			endif
			if day($) == 28
			or day($) == 29
			or day($) == 30
			or day($) == 31
			or day($) == 32
				oforcer here add_affect $n fly 1130 0 39 -30 0
			endif
