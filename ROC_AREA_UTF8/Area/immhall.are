#11021
merit angel roc~
功勳天使(Angel of Merit)~
幻世功勳小天使(Angel of Merit)在這裡登記英雄們的戰果。
~
功勳小天使在這裡頒發功勳(merit)給有戰功的英雄。
~
63555 8892 1000 S
50 0 0 0d0+0 0d0+0
0 0
0 8 2
P 4194304|16777216
R Angel~
>repop_prog 100~
mpadd_qmark self enable_detect_nightstalk -1 0 0 0 0 1
~
>greet_prog 100~
smile $n
~
>talk_prog topic~
tell $n 您好，我是功勳小天使。當您成為英雄之後，可以向我領取
tell $n 功勳(merit)。您也可以向我查詢目前完整的戰區列表(list)。
tell $n 您也可以直接告訴我戰區名稱，我可以幫您查詢您目前的進度。
mpadd_qmark $n merit_abyss -1 0 0 0 0 1
mpadd_qmark $n merit_flame_red -1 0 0 0 0 1
mpadd_qmark $n merit_deepland -1 0 0 0 0 1
mpadd_qmark $n merit_seal_evil -1 0 0 0 0 1
mpadd_qmark $n merit_snow_castle -1 0 0 0 0 1
mpadd_qmark $n merit_dungeon -1 0 0 0 0 1
mpadd_qmark $n merit_marsh_ogre -1 0 0 0 0 1
~
>talk_prog list~
tell $n 目前能建立戰功的戰區有：
tell $n     海域(mist ocean) ............. 10 點功勳。
tell $n     瑪拉勒城(malathar) ........... 20 點功勳。
tell $n     幽冥深淵(abyss) .............. 25 點功勳。
tell $n     風火海(wfsea) ................ 30 點功勳。
tell $n     精靈鎮(elf town) ........ 10 - 80 點功勳。
tell $n     魔界入口(daemon entrance)..... 80 點功勳。
tell $n     巨魔營地(ogre camp) ......... 100 點功勳。
tell $n     幻惑迷林(wander forest) ..... 100 點功勳。
tell $n     風之大陸(wind continent)..... 180 點功勳。
tell $n     鬼鎮(gtown) ............. 5 - 250 點功勳。
tell $n     炎紅之塔(flame red) ......... 200 點功勳。
tell $n     深土城(deep land) ........... 200 點功勳。
tell $n     迷斯卓諾(Myth Drannor) ...... 200 點功勳。
tell $n     封魔洞窟(seal evil) ......... 360 點功勳。
tell $n     雪華城堡(snow castle) ....... 455 點功勳。
tell $n     地層魔域(dungeon)............ 910 點功勳。
tell $n     亡者樂園(bane paradise)..... 1275 點功勳。
~
>talk_prog 'Myth Drannor'~
if is_qmark($n) != mythruins_boss
	mpadd_qmark $n mythruins_boss -1 0 0 0 0 1
endif
tell $n 擊敗以下任一目標就可回來領取戰功(merit)。
tell $n 須擊敗目標：
if is_qmark($n) !& mythruins_boss 300001
	tell $n 　　 古代綠龍(ancient green dragon)
else
	tell $n 　　 已擊敗  古代綠龍(ancient green dragon)
endif
if is_qmark($n) !& mythruins_boss 300002
	tell $n 　　 骨惡魔(bone demon)
else
	tell $n 　　 已擊敗  骨惡魔(bone demon)
endif
if is_qmark($n) !& mythruins_boss 300004
	tell $n 　　 三首海蛇(three-headed hydra)
else
	tell $n 　　 已擊敗  三首海蛇(three-headed hydra)
endif
~
>talk_prog 'bane paradise'~
if is_qmark($n) == merit_bane_paradise 100127
  tell $n 你已經完成亡者樂園(bane paradise)的征討，請向我領取戰功(merit)。
  break
endif
mpadd_qmark $n merit_bane_paradise -1 0 0 0 0 1
tell $n 完成亡者樂園(bane paradise)征討可建立 1275 點功勳，
tell $n 您還有下列目標須要擊敗：
if is_qmark($n) !& merit_bane_paradise 100001
  tell $n 　　 空間魔導 -- 卡薩諾瓦(Casanova)
endif
if is_qmark($n) !& merit_bane_paradise 100002
  tell $n 　　 死靈祭師 -- 席爾菲諾(Silvano)
endif
if is_qmark($n) !& merit_bane_paradise 100004
  tell $n 　　 上古魔龍 -- 卡希迪(Cassidy)
endif
if is_qmark($n) !& merit_bane_paradise 100008
  tell $n 　　 黑暗武士 -- 費德立克(Federico)
endif
if is_qmark($n) !& merit_bane_paradise 100016
  tell $n 　　 冥界死神 -- 米勒(Miller)
endif
if is_qmark($n) !& merit_bane_paradise 100032
  tell $n 　　 幽 靈 龍 -- 緋嵐吉甌(Venanzio)
endif
if is_qmark($n) !& merit_bane_paradise 100064
  tell $n 　　 守 門 者 -- 撒爾梵托(Salvator)
endif
