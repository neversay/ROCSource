#11024
test room~
roomprog 測試用的房間。
~
0 0 0
>room_command nonechoat default~
nonechoat $n A.
if rand(80)
	nonechoat $n B.
endif
if rand(50)
	nonechoat $n C.
endif
if rand(30)
	nonechoat $n D.
endif
echoat $n END
echoat $n END2
~
>room_command nonechoaround default~
nonechoaround $n A.
if rand(80)
	nonechoaround $n B.
endif
if rand(50)
	nonechoaround $n C.
endif
if rand(30)
	nonechoaround $n D.
endif
echoaround $n END
echoaround $n END2
~
>room_command second_attr default~
if sndattr($n) == 1
	echo $n second 為 str
endif
if sndattr($n) == 2
	echo $n second 為 dex
endif
if sndattr($n) == 3
	echo $n second 為 int
endif
if sndattr($n) == 4
	echo $n second 為 wis
endif
if sndattr($n) == 5
	echo $n second 為 con
endif
~
>room_command maxhpcheck default~
if hpmax($n) > 3000
	echo $n 最大 hp 大於 3000
else
	echo $n 最大 hp 小於等於 3000
endif
~
>room_command maxmpcheck default~
if mpmax($n) > 3000
	echo $n 最大 mp 大於 3000
else
	echo $n 最大 mp 小於等於 3000
endif
~
>room_command maxmvcheck default~
if mvmax($n) > 3000
	echo $n 最大 mv 大於 3000
else
	echo $n 最大 mv 小於等於 3000
endif
~
>room_command practicecheck default~
if practice($n) > 1000
	echo $n practice 大於 1000
else
	echo $n practice 小於等於 1000
endif
~
>room_command skexpcheck default~
if skexp($n) > 2000000
	echo $n 持有 skexp 大於 2000000
else
	echo $n 持有 skexp 小於等於 2000000
endif
~
>room_command skexp_difcheck default~
if skexp_dif($n) > 200000
	echo $n 持有超量的 skexp 大於 200000
else
	echo $n 持有超量的 skexp 小於等於 200000
endif
~
