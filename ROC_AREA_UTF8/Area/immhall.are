	if carrycount($n , 23 ) >= 1
		add_qmark $n poker_21_bet -1 0 1 0 1 0
		rcall poker_21_check_pay $n
		rcall poker_21_bet_hit $n
	else
		echoat $n 你身上沒有這麼多籌碼。
	endif
	del_qmark $n bj_pay_ok
endif
