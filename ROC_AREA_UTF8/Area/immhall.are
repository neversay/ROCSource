>room_defun baccarat_banker_winner~
if is_qmark($n) != casino_chips_count
	add_qmark $n casino_chips_count -1 0 0 0 0 1
endif
if is_qmark($n) >= baccarat_banker_win 100002
	mod_qmark $n baccarat_banker_win v0 - 1
	mod_qmark $n casino_chips_count v0 + 200
	rcall baccarat_banker_winner $n
	break
endif
if is_qmark($n) == baccarat_banker_win 100001
	mod_qmark $n baccarat_banker_win v0 - 1
	mod_qmark $n casino_chips_count v0 + 100
	mod_qmark $n casino_chips_count v0 + 50
	if is_qmark($n) == baccarat_banker_win 200001
		mod_qmark $n casino_chips_count v0 + 25
		mod_qmark $n casino_chips_count v0 + 10
		mod_qmark $n casino_chips_count v0 + 10
	endif
	if is_qmark($n) == baccarat_banker_win 200002
		mod_qmark $n casino_chips_count v0 + 10
		mod_qmark $n casino_chips_count v0 + 10
		mod_qmark $n casino_chips_count v0 + 10
		mod_qmark $n casino_chips_count v0 + 10
	endif
	if is_qmark($n) == baccarat_banker_win 200003
		mod_qmark $n casino_chips_count v0 + 25
		mod_qmark $n casino_chips_count v0 + 10
	endif
	if is_qmark($n) == baccarat_banker_win 200004
		mod_qmark $n casino_chips_count v0 + 25
		mod_qmark $n casino_chips_count v0 + 5
	endif
	if is_qmark($n) == baccarat_banker_win 200005
		mod_qmark $n casino_chips_count v0 + 25
	endif
endif
rcall chips_change_all $n
