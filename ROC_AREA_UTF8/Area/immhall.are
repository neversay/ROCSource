#11013
gift giver angel roc~
幻世小天使(ROC Angel)~
一個可愛的天使(Angel)正在這裡發送禮物。
~
她正在發送禮物(gift)給來往的行人。
~
63555 8892 1000 S
50 0 0 0d0+0 0d0+0
0 0
0 8 2
P 4194304|16777216
R Angel~
S 16 -1000
>greet_prog 100~
smile $n
    mpjunk all
~
>talk_prog topic~
if is_qmark($n) == roc_skexp_20020816
    '你已經領過這次的禮物了。
    mpjunk all
    break
    else
    '要領禮物(gift)嗎？
    mpjunk all
    break
    endif
~
>hurt_prog 235~
    yell 神 之 障 壁 ！
    mpnowait
    c crush $n
    mpnowait
    c 3 'magic missi' $n
    mpnowait
    mpat 5 c full
    mpnowait
    mpat 5 c sanc
    mpnowait
    mpat 5 c 'mystic mirror'
    mpnowait
~
>fight_prog 40~
    yell 可惡的凡人，嘗嘗上天的制裁吧！
    mpadd_qmark $i delayed_cast -1 999 0 0 0 1
    mpat 5 c sanc
    if rand(30)
        mpnowait
        mpdef_rembch $r
        c 'dispel magic' $b
        mpnowait
        c 2 angry $b
        c 3 'meteor shower'
        mpnowait
    else
        if rand(50)
        mpnowait
            c 'wind scr' $r
        mpnowait
            c 'wind scr' $r
        mpnowait
            c 'wind scr' $r
        mpnowait
            c 3 whirlwind
        mpnowait
        else
            mpdef_rembch $r
        mpnowait
            c 'dispel magic' $b
        mpnowait
            c 3 'lightn bolt' $b
        mpnowait
        endif
    endif
~
>repop_prog 100~
    mpadd_qmark $i delayed_cast -1 999 0 0 0 1
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mpjunk all
mpgreward exp $n -42 -10000
~
>talk_prog gift~
if isnpc($n)
    break
    else
    if is_qmark($n) == roc_skexp_20020816
    '你已經領過嘍。
    waggle $n
    break
    else
    if level($n) < 30
    or class($n) < 5
    '你的年紀還太小了，等長大點再來。
    pat $n
    mpjunk all
    break
    else
    mpadd_qmark $n roc_skexp_20020816 -1 0 0 0 0 1
    mpskillexp $n 500000
    '要好好利用這 50 萬點技能經驗值哦。
    addoil $n
    break
    endif
    break
    endif
    break
    endif
    ~
