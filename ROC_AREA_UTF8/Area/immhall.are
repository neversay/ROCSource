		mpdel_qmark $n roc_gift_20171225
	endif
	if is_qmark($n) == roc_gift_20161225
		mpdel_qmark $n roc_gift_20161225
	endif
	if is_qmark($n) == roc_gift_20151225
		mpdel_qmark $n roc_gift_20151225
	endif
	if race($n) == beholder
		mpechoat $n $I 把手伸進去禮物袋，給你一枚戒指。
