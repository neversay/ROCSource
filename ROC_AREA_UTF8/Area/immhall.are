		mpmod_qmark $n ROC_Halloween v1 = 2024
	else
		mpadd_qmark $n ROC_Halloween -1 0 2024 0 0 1
	endif
	if is_qmark($n) == ROC_Pumpkin_Lantern_timer
		mpdel_qmark $n ROC_Pumpkin_Lantern_timer
	endif
	if is_qmark($n) == ROC_Pumpkin_Lantern
		mpdel_qmark $n ROC_Pumpkin_Lantern
	endif
	mpadd_qmark $n ROC_Pumpkin_Lantern -1 0 0 0 0 1
