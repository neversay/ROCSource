>greet_prog 100~
if is_inv_obj($n) == 11090
or is_equ_obj($n) == 11090
	glare $n
	tell $n 喔，孩子，你身上的東西不是聖誕雪鈴(sleigh bell)嗎？
endif
~
>talk_prog p sleigh bell~
if is_inv_obj($n) == 11090
or is_equ_obj($n) == 11090
	tell $n 雪鈴掛在雪橇上能讓人在風雪中辨識出所在的位置，而受過加持的聖誕雪鈴又與一般的雪鈴不同。
	tell $n 不僅能當成一般雪鈴使用，把它掛(hang bell)在房間(room)當裝飾還會發出獨特的旋律。
	tell $n 如果掛在無主的馴鹿(reindeer)的脖子上，甚至能將其馴服呢～
	tell $n 孩子呀，你可獲得一件不可多得的珍寶囉～
	mpechoat $n $I得意地發出：「齁～齁～齁～」的低沉笑聲。
endif
~
>talk_prog topic~
if is_qmark($n) == ROC_Christmas 202024
	tell $n 喔，你看起來凍壞了。
	tell $n 在這裡養好精神再上路吧！
	break
endif
if is_qmark($n) == ROC_Christmas
	mpmod_qmark $n ROC_Christmas v1 = 2024
else
	mpadd_qmark $n ROC_Christmas -1 0 2024 0 0 1
endif
if is_qmark($n) == ROC_Claus_2019
	mpdel_qmark $n ROC_Claus_2019
endif
if is_qmark($n) == ROC_Claus_2018
	mpdel_qmark $n ROC_Claus_2018
endif
if is_qmark($n) == ROC_Claus
	mpdel_qmark $n ROC_Claus
endif
mpadd_qmark $n ROC_Claus -1 0 0 0 0 1
tell $n 孩子，你看起來凍壞了。
tell $n 這裡也很安全(safe)，你可以安心的休息。
~
>talk_prog p Rudolph~
tell $n 魯道夫看到我吃薑餅，也想來一塊。
tell $n 然後就像嗑了什麼興奮劑一樣，頭也不回的就衝出門了。
tell $n 牠之後發生什麼事我也不清楚...喔...我的肚子....
~
>talk_prog p safe~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100000
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 1
	tell $n 孩子，雖然不知道你是如何來到這個不屬於你存在的世界。
	tell $n 但請放心，這神聖的領域中不會有任何事物傷害你，放鬆休息吧。
	mpcallout 1 hmm
	mpcallout 2 tell $n 不過你會來到這裡，也是種緣份。
	mpcallout 3 tell $n 願意傾聽年邁的老人發點牢騷(bellyache)嗎？
endif
~
>talk_prog p bellyache~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100001
	mpadd_qmark self talking
	mpcallout 7 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 2
	tell $n 太感謝你了，終於讓我有個訴苦的對象。
	mpcallout 1 tell $n 事情是這樣的....
	mpcallout 3 tell $n 下場是連續鬧好幾天的肚子，到現在都還不太能站起來呢...
	mpcallout 3 tell $n 不過呀，前幾天呢，一時嘴饞吃了去年的薑餅。
	mpcallout 3 tell $n 我有份每年在這時候非作不可的工作。
	mpcallout 4 say 啊爽！
	mpcallout 4 fart
	mpcallout 5 tell $n 呃，抱歉一時無法控制.....
	mpcallout 6 avert
	mpcallout 7 tell $n 那麼孩子呀，我們剛剛說到哪兒了？(job)
endif
~
>talk_prog p job~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100002
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 3
	tell $n 啊對，就是工作！一份在這段時間才需要作的工作。
	mpcallout 1 tell $n 對老人家真是有點吃不消呢。
	mpcallout 1 tell $n 先不講的夜晚有多冷，光是持續幾天熬夜工作。
	mpcallout 1 tell $n 這是不論刮風下雪都要在冬天的深夜裡東奔西跑的苦差事。
	mpcallout 2 beg self
	mpcallout 3 tell $n 多少也作出些感情了....
	mpcallout 3 tell $n 不過仔細想想，每年持續作這份差事也有不少歲月了呢。
	mpcallout 4 tell $n 不過...照現在的身體狀況看來，大概也就到今年為止了...
	mpcallout 5 sigh
	mpcallout 6 mpechoat $n 從他的描述看來，他可能是個送貨員(porter)？
endif
~
>talk_prog p porter~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100003
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 4
	ponder $n
	mpcallout 1 tell $n 嗯，精準的說....
	mpcallout 1 tell $n 廣義上而言，我的工作的確跟送貨員差不了多少。
	mpcallout 2 tell $n 我是負責傳遞夢想的送貨員！
	mpcallout 3 mpechoat $n $I得意地發出：「齁～齁～齁～」的低沉笑聲。
	mpcallout 5 tell $n 直到現在都還沒到各地裝置聚集(gather)願望的媒介。
	mpcallout 5 tell $n 不過這也成為過去式了，因為今年我身體不舒服.....
endif
~
>talk_prog p gather~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100004
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 5
	tell $n 傳遞夢想，首先要知道他人的願望。
	tell $n 如果都不講，我也不知道別人想要什麼呀。
	tell $n 但我年紀大了，可沒體力當街一個人一個人的詢問。
	mpcallout 1 tell $n 把寫下的願望掛在媒介上，媒介則會把內容傳達給我。
	mpcallout 1 tell $n 所以我製作出一種類似郵桶的媒介。
	mpcallout 2 tell $n 如此一來人們想許願有個確實的去處，也可以省去詢問的麻煩呢。
	mpcallout 3 look $n
	mpcallout 5 tell $n 孩子呀，你有沒有意願幫老人家一個忙？(ok)
	mpcallout 5 tell $n 就像一開始跟你說的，你能夠進到這世界也算是種緣分。
endif
~
>talk_prog p ok~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100005
	mpmod_qmark $n ROC_Claus v0 = 6
	mpechoat $n $I把一個盆栽交給了你。
	mpoload 11001 $n 1 target
	tell $n 那麼請回到你所屬的世界，尋找聖誕樹的幼苗，把它移植到盆栽內。
	tell $n 把它種植在人類城市(city)最多人的聚集處，再回來跟我說(report)。
	tell $n 去吧，孩子！
endif
~
>talk_prog p no~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100005
	no! $n
endif
~
>talk_prog p city~
if is_qmark($n) == ROC_Claus 100006
	tell $n 分別是，史卡拉貝城廣場最熱鬧的地方、奧夫卡最多人通行的地方、
	tell $n 永恆之塔最多遊客的廣場中央、光明之鎮廣場的中央、
	tell $n 奈圖王國最多人慕名而去的市場及綠葉谷市集的中心。
	tell $n 完成後再來跟我說一聲(report)。
endif
~
>talk_prog p report~
if is_qmark($n) == ROC_Claus 100006
	waggle $n
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在跟人講話。
	break
endif
if is_qmark($n) == ROC_Claus 100007
	mpadd_qmark self talking
	mpcallout 6 mpdel_qmark self talking
	mpmod_qmark $n ROC_Claus v0 = 8
	cong $n
	mpcallout 1 gift
	mpcallout 1 tell $n 這下你也成為一個專業的夢想送貨員了。
	mpcallout 2 mpoload 11059 $n 1 target
	mpcallout 2 tell $n 來，這是給你的謝禮。
	mpcallout 3 tell $n 這套專業的送貨服也送給你吧。
	mpcallout 3 tell $n 另外，為了慶祝你成為我們的一員。
	mpcallout 4 mpoload 11023 $n 1 target
	mpcallout 4 mpoload 11024 $n 1 target
	mpcallout 4 mpoload 11025 $n 1 target
	mpcallout 4 mpechoat $n $I給了你一套衣服。
	mpcallout 5 tell $n 齁～齁～齁～聖誕快樂！
	mpcallout 5 tell $n 孩子啊，願你未來在傳遞夢想的旅途上，也能實現自己的夢想。
	mpcallout 6 mpat 4500 rumor $N 在經過嚴格的考驗後，成功轉職為聖誕老人了！
	mpcallout 6 mpat 5 rumor $N 在經過嚴格的考驗後，成功轉職為聖誕老人了！
	mpcallout 6 rumor $N 在經過嚴格的考驗後，成功轉職為聖誕老人了！
endif
~
|

