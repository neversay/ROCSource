	drop $o
	break
endif
if is_qmark($i) == fahai_give
	tell $n 我現在沒空，你等下再來。
	drop $o
	break
endif
if is_qmark($n) == ROC_white_snake 200004
	if material($o) == fiber
		if rand(15)
			tell $n 這樣就足夠了。
			tell $n 請在一旁稍等，我要來製作一下法具。
			mpadd_qmark self fahai_give -1 0 0 0 0 1
			mppurge $o
			mpcallout 2 mpechoat $n $I快速地將手上的綢布裁剪成袋狀，然後拿出一些木片磨成粉末狀。
			mpcallout 3 mpechoat $n $I將木片粉末倒入綢布袋中，然後放入些不明物，隨之將袋口縫合。
			mpcallout 5 mpechoat $n $I給了你一個香囊。
			mpcallout 5 tell $n 好，完成了。
			mpcallout 5 mpoload 11047 $n viclv target
			mpcallout 6 tell $n 戴著這個就可以消除身上的妖氣了。
			mpcallout 6 mpmod_qmark $n ROC_white_snake v1 = 5
			mpcallout 6 mpadd_qmark $n dbf_fahai_timer 48 0 0 0 0 1
			mpcallout 7 mpdel_qmark self fahai_give
			mpcallout 7 tell $n 有事想請你幫忙一下。(thing)
			mpcallout 7 tell $n 另外你看起來滿利害的，過兩天後再來找我，
			mpcallout 8 wave $n
		else
			tell $n 還需要更多，再找一些來。
			mppurge $o
		endif
	else
		shake $n
		tell $n 這東西不是綢布(fiber)。
		drop $o
	endif
else
	? $n
	drop $o
endif
