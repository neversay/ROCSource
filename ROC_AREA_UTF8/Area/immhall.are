	mpcallout 5 mppurge self
	if rand(10)
		mpcallout 5 mpecho $I 生氣地丟下手中的武器轉頭離開這裡。
		mpcallout 5 mpoload 11081 40 floor
	else
		mpcallout 5 mpecho $I 生氣地轉頭離開這裡。
	endif
	mpcallout 5 say 哼！
endif
