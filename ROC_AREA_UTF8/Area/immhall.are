	tell $n 報歉，我現在沒空。
	drop $o
	break
endif
if is_qmark($n) == ROC_Pumpkin_Lantern_timer
	tell $n 我已經在製作燈籠了，你再等一下吧。
	drop $o
	break
endif
if is_qmark($n) == ROC_Pumpkin_Lantern 100002
	mpdel_qmark $n ROC_Pumpkin_Lantern
	mpoload 10910 $n 1 target
	tell $n 呃...你忘了自己找我訂作過南瓜燈作了嗎？
	tell $n 這是你的訂作的，總之祝你在慶典玩得愉快。
	mpechoat $n $I給了你[1;33;41m南瓜燈籠[0m(Pumpkin Lantern).
	mpjunk $o
	break
endif
if is_qmark($n) == ROC_Pumpkin_Lantern 100001
	tell $n 好的，大概一天後再來找我。
	mpmod_qmark $n ROC_Pumpkin_Lantern v0 = 2
	mpadd_qmark $n ROC_Pumpkin_Lantern_timer 24 0 0 0 0 1
	mpjunk $o
	break
endif
drop $o
