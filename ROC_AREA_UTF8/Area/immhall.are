>tick_prog 100~
if isfight($i)
	break
endif
if is_qmark($i) == jacko_fighting_stun
	break
endif
if is_qmark($i) < jacko_teleport 100024
	mpmod_qmark self jacko_teleport v0 + 1
else
	if is_qmark($i) == jacko_moving_stun
		mpdel_qmark self jacko_moving_stun
	endif
endif
if is_qmark($i) == jacko_moving_stun
	break
endif
mpcall jacko_wandering $i
~
>entry_prog 100~
if isaffected($i) !& 2
	mpat 5 c invis
endif
if isaffected($i) !& 65536
	hide
endif
if roomflag($) & 1024
	mpteleport area
	break
endif
if aobjcount(10901) < 10
	if robjcount(10901) == 0
		if aobjcount(10901) < 5
			if rand(80)
				mpforcer here callout 5 oload 10901 1 floor
			endif
		else
			if rand(40)
				mpforcer here callout 5 oload 10901 1 floor
			endif
		endif
	endif
endif
if is_qmark($i) == jacko_fighting_stun
	break
endif
mpadd_qmark self jacko_moving_stun 2 0 0 0 0 1
mpcall jacko_greeting pc
mpcallout 10 mpcall jacko_wandering $i
mpcallout 10 mpdel_qmark self jacko_moving_stun
~
>defun_prog jacko_greeting~
if rand(20)
	mpechoat $n 你突然感到一陣涼意...
endif
~
>defun_prog jacko_wandering~
if is_qmark($i) == jacko_fighting_stun
	break
endif
if is_qmark($i) == jacko_moving_stun
	break
endif
if isfight($i)
	break
endif
mpmod_qmark self jacko_flee_count v0 = 0
if is_qmark($i) >= jacko_teleport 100024
	mpmod_qmark self jacko_teleport v0 = 0
	if rand(50)
		if rand(9)
			mpgoto 3057
			mpteleport area
		else
			if rand(10)
				mpgoto 680
				mpteleport area
			else
				if rand(11)
					mpgoto 5566
					mpteleport area
				else
					if rand(12)
						mpgoto 14108
						mpteleport area
					else
						if rand(14)
							mpgoto 1130
							mpteleport area
						else
							if rand(16)
								mpgoto 13008
								mpteleport area
							else
								if rand(20)
									mpgoto 13641
									mpteleport area
								else
									if rand(25)
										mpgoto 8031
										mpteleport area
									else
										if rand(33)
											mpgoto 13421
											mpteleport area
										else
											if rand(50)
												mpgoto 8269
												mpteleport area
											else
												mpgoto 11133
												mpteleport area
											endif
										endif
									endif
								endif
							endif
						endif
					endif
				endif
			endif
		endif
	else
		if rand(14)
			mpgoto 4581
			mpteleport area
		else
			if rand(16)
				mpgoto 10328
				mpteleport area
			else
				if rand(20)
					mpgoto 70900
					mpteleport area
				else
					if rand(25)
						mpgoto 21036
						mpteleport area
