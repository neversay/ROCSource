>talk_prog merit~
if isnpc($n)
	break
endif
if is_qmark($n) == myth_templar_enemy 10
	mpechoat $n 綠葉谷記仇更新。
	mpmod_qmark $n myth_templar_enemy death = 1
endif
if class($n) < 5
	tell $n 你還太小，無法領取戰功。
	break
endif
if is_qmark($n) != enable_level_41
	if level($n) < 41
		tell $n 只有英雄才能領取戰功喔。
		break
	endif
endif
tell $n 歡迎歸來，我們的英雄。
if is_qmark($n) == merit_murky 100015
	mpdel_qmark $n merit_murky
	tell $n 你因為征討幽冥深淵建立 30 點戰功。
	mpmerit $n 30
endif
if is_qmark($n) == merit_marsh_ogre 100007
	mpdel_qmark $n merit_marsh_ogre
	tell $n 你因為征討巨魔營地建立 100 點戰功。
	mpmerit $n 100
endif
if is_qmark($n) == merit_flame_red 104095
	mpdel_qmark $n merit_flame_red
	tell $n 你因為征討炎紅之塔建立 200 點戰功。
	mpmerit $n 200
endif
if is_qmark($n) == merit_wind_continent 100063
	mpdel_qmark $n merit_wind_continent
	tell $n 你因為征討風之大陸建立 180 點戰功。
	mpmerit $n 180
endif
if is_qmark($n) == merit_deepland 100063
	mpdel_qmark $n merit_deepland
	tell $n 你因為征討深土城建立 200 點戰功。
	mpmerit $n 200
endif
if is_qmark($n) == merit_dungeon 100063
	mpdel_qmark $n merit_dungeon
	tell $n 你因為征討地層魔域建立 910 點戰功。
	mpmerit $n 910
endif
if is_qmark($n) >= mythruins_boss 300001
	if is_qmark($n) & mythruins_boss 300001
		tell $n 你擊敗古代綠龍建立 100 點戰功。
		mpmerit $n 100
	endif
	if is_qmark($n) & mythruins_boss 300002
		tell $n 你擊敗骨惡魔建立 100 點戰功。
		mpmerit $n 100
	endif
	if is_qmark($n) & mythruins_boss 300004
		tell $n 你擊敗三首海蛇建立 150 點戰功。
		mpmerit $n 150
	endif
	mpmod_qmark $n mythruins_boss v2 = 0
endif
if is_qmark($n) == merit_seal_evil 100031
	mpdel_qmark $n merit_seal_evil
	tell $n 你因為征討封魔洞窟建立 360 點戰功。
	mpmerit $n 360
endif
if is_qmark($n) == merit_snow_castle 100031
	mpdel_qmark $n merit_snow_castle
	tell $n 你因為征討雪華城堡建立 455 點戰功。
	mpmerit $n 455
endif
if is_qmark($n) == merit_bane_paradise 100127
	mpdel_qmark $n merit_bane_paradise
	tell $n 你因為征討亡者樂園建立 1275 點戰功。
	mpmerit $n 1275
endif
mpadd_qmark $n merit_abyss -1 0 0 0 0 1
mpadd_qmark $n merit_marsh_ogre -1 0 0 0 0 1
mpadd_qmark $n merit_flame_red -1 0 0 0 0 1
mpadd_qmark $n merit_deepland -1 0 0 0 0 1
mpadd_qmark $n merit_seal_evil -1 0 0 0 0 1
mpadd_qmark $n merit_snow_castle -1 0 0 0 0 1
mpadd_qmark $n merit_dungeon -1 0 0 0 0 1
mpadd_qmark $n merit_bane_paradise -1 0 0 0 0 1
