>room_defun baccarat_timeline~
if roomvalue($1) == 0
	break
endif
if roomvalue($1) == 1
	force $n say 還有人要下注嗎？
endif
if roomvalue($1) < 5
	modrvt v1 + 1
	if roomvalue($1) == 4
		force $n say 遊戲準備開始，還有人要下注嗎？
	endif
endif
if roomvalue($1) == 5
	force $n say 停止下注！
	force $n mpcall baccarat_interval_1 $n
	modrvt v1 = 6
endif
~
>room_defun baccarat_ending_transfor~
modrvt v1 = 7
transfer all 11006
callout 1 force $b mpcall baccarat_reset_all $b
~
|
