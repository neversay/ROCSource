>talk_prog hummus~
if cancarry($n) < 1
	mpechoat $n $I對你搖了搖頭。
	mpechoat $n $I[1;32m說著「你拿不了這麼多東西。」[0m
	break
endif
if goldamt($n) >= 100000
	mpgold $n -100000
	mpechoat $n $I[1;32m說著「來，這是您要的綠豆沙月餅。」[0m
	mpechoat $n $I把[1;32m綠豆沙月餅[0m(Hummus moon cake)交給了你。
	mpoload 11049 $n 1 target
else
	mpechoat $n $I[1;32m說著「你身上的錢不太夠喔。」[0m
endif
