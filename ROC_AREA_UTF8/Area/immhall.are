	else
		mpechoat $n $I 把手伸進去禮物袋，給你一雙襪子。
		mpoload 11026 $n 1 target
		mpechoat $n $I[1;32m說著「這是給你的聖誕禮物，聖誕快樂！」[0m
	endif
	if level($n) < 36
		mpechoat $n $I[1;32m說著「另外，我這裡有販賣薑餅(gingerbread)，如果想吃可以來買喔！」[0m
		mpechoat $n $I對你愉快的笑著。
	else
		if level($n) < 39
			mpechoat $n $I 又把手伸進去禮物袋裡面搜索。
			mpechoat $n $I[1;32m說著「另外送你一隻薑餅人。」[0m
			mpechoat $n $I[1;32m說著「如果吃不夠還可以再買喔！(gingerbread)」[0m
			mpoload 11074 $n target
			mpechoat $n $I對你愉快的笑著。
		else
			mpechoat $n $I 又把手伸進去禮物袋裡面搜索。
			mpechoat $n $I[1;32m說著「另外送你一隻薑餅人跟一棟薑餅屋。」[0m
			mpoload 11074 $n target
			mpoload 11075 $n target
			mpechoat $n $I[1;32m說著「如果吃不夠還可以再買喔！(gingerbread)」[0m
			mpechoat $n $I對你愉快的笑著。
		endif
	endif
else
	mpechoat $n $I[1;32m說著「聖誕快樂！」[0m
	mpechoat $n $I對你愉快的笑著。
