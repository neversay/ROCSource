150 0 0 5000d5000+-50000 -1000d-50000+0
-1 0
0 8 0
R Angel~
P 512|2048|4194304|67108864|268435456
C 1|2|4|8|32
S 13 500000
S 18 5000
S 19 5000
S 23 -500
S 27 -500
S 28 -500
S 29 -500
S 30 -500
S 31 -500
S 40 1000
S 41 100000
S 42 100000
S 43 100000
S 44 100000
S 45 100000
S 46 100000
>repop_prog 100~
mpadd_qmark self music_count -1 0 0 0 0 1
mpadd_qmark self hare_born -1 0 0 0 0 1
mpat 11037 mpmload 11029
mpat 11003 mpforcer here deldoor 0 
mpat 11003 mpforcer here makedoor 0 北邊可以回到現世 0 0 0 4580
mpat 71096 mpforcer here makedoor 3 通往竹林深處的小徑 0 0 0 11026
mpat 71096 mpforcer here setroom desc N 你走在竹林之間，和走在森林之間的感覺很明顯地有所不同，那種感覺只有
mpat 71096 mpforcer here setroom desc A 親自走過的人才能體會。東邊有一棟小屋，而且是用竹子搭建而成的，和四周的
mpat 71096 mpforcer here setroom desc A 竹林看起來頗搭配。西邊竹林有條新開的小徑，裡面傳來異樣的氣息。
~
>tick_prog 100~
if is_qmark($i) >= music_count 100048
	music 在這美麗的中秋佳節中，祝福大家都能夠幸福與快樂～
	mpmod_qmark self music_count v0 = 0
else
	if rand(50)
		mpmod_qmark self music_count v0 + 1
	endif
endif
if is_qmark($i) == hare_born
	if is_qmark($i) >= hare_born 100024
		mpdel_qmark self hare_born
		mpat 5 mpmload 11022
		rumor 近期大量冒險者目擊到有隻不明人形生物出沒在各地城鎮，進行著無差別殺戮行為。
	else
		mpmod_qmark self hare_born v0 + 1
	endif
endif
~
>talk_prog topic~
if rand(50)
	mpechoat $n $I[1;32m一臉喜悅的對著你說「你領過禮盒(gift)嗎？」[0m
else
	mpechoat $n $I[1;32m一臉歡喜的對著你說「今年中秋你過得快樂嗎？」[0m
endif
~
>talk_prog gift~
if is_qmark($n) == ROC_Mid_Autumn 102024
	smile $n
	mpechoat $n $I[1;32m親切的跟你說道「你已經領過禮盒了喔。」[0m
	mpechoat $n $I[1;32m親切的跟你說道「若你還想再吃的話，大概就要花錢囉。」[0m
else
	if is_qmark($n) == ROC_Mid_Autumn
		mpmod_qmark $n ROC_Mid_Autumn v0 = 2024
	else
		mpadd_qmark $n ROC_Mid_Autumn -1 2024 0 0 0 1
	endif
	if is_qmark($n) == ROC_Mid_Autumn_2020
		mpdel_qmark $n ROC_Mid_Autumn_2020
	endif
	if is_qmark($n) == ROC_Mid_Autumn_2019
		mpdel_qmark $n ROC_Mid_Autumn_2019
	endif
	if is_qmark($n) == ROC_Mid_Autumn_2018
		mpdel_qmark $n ROC_Mid_Autumn_2018
	endif
	if is_qmark($n) == ROC_Mid_Autumn_2017
		mpdel_qmark $n ROC_Mid_Autumn_2017
	endif
	if is_qmark($n) == roc_gift_2017_1004
		mpdel_qmark $n roc_gift_2017_1004
	endif
	if is_qmark($n) == roc_gift_2016_0915
		mpdel_qmark $n roc_gift_2016_0915
	endif
	if level($n) < 25
		mpechoat $n $I[1;32m微笑地對你說道「你年紀還小，就給你一個柚子吧 ^_^」[0m
		mpechoaround $n $I[1;32m微笑地對[0m$N[1;32m說道「你年紀還小，就給你一個柚子吧 ^_^」[0m
		mpechoat $n $I將[1;32m柚子[0m(Pompelmous)給了你。
		mpechoaround $n $I將[1;32m柚子[0m(Pompelmous)給了$N。
		mpoload 11052 $n 1 target
	else
		if level($n) < 39
			mpechoat $n $I[1;32m微笑地對你說道「來～這是送給您的中秋禮盒～」[0m
			mpechoaround $n $I[1;32m微笑地對[0m$N[1;32m說道「來～這是送給您的中秋禮盒～」[0m
			mpjunk all
			mpat 5 mpoload 11049 1
			mpat 5 mpoload 11051 1
			mpat 5 mpoload 11053 1
			mpat 5 open box
			mpat 5 put all box
			mpat 5 close box
			give box $n
			drop box
			mpechoat $n $I[1;32m微笑地繼續對你說道「還有一顆柚子也送給你唷～」[0m
			mpechoaround $n $I[1;32m微笑地繼續對[0m$N[1;32m說道「還有一顆柚子也送給你唷～」[0m
			mpechoat $n $I將[1;32m柚子[0m(Pompelmous)給了你。
			mpechoaround $n $I將[1;32m柚子[0m(Pompelmous)給了$N。
			mpoload 11052 $n 1 target
			mpechoat $n $I [1;32m對著你神祕的一笑，你發覺得身上又多了一樣東西。[0m
			mpechoaround $n $I[1;32m對著[0m$N[1;32m神祕的一笑。[0m
			mpoload 10915 $n 36 target
		else
			mpechoat $n $I[1;32m微笑地對你說道「來～這是送給您的中秋禮盒～」[0m
			mpechoaround $n $I[1;32m微笑地對[0m$N[1;32m說道「來～這是送給您的中秋禮盒～」[0m
			mpjunk all
			mpat 5 mpoload 11049 1
			mpat 5 mpoload 11051 1
			mpat 5 mpoload 11053 1
			mpat 5 open box
			mpat 5 put all box
			mpat 5 close box
			give box $n
			drop box
			mpechoat $n $I[1;32m微笑地繼續對你說道「還有一顆柚子也送給你唷～」[0m
			mpechoaround $n $I[1;32m微笑地繼續對[0m$N[1;32m說道「還有一顆柚子也送給你唷～」[0m
			mpechoat $n $I將[1;32m柚子[0m(Pompelmous)給了你。
			mpechoaround $n $I將[1;32m柚子[0m(Pompelmous)給了$N。
			mpoload 11052 $n 1 target
			mpechoat $n $I [1;32m對著你神祕的一笑，你發覺得身上又多了一樣東西。[0m
			mpechoaround $n $I[1;32m對著[0m$N[1;32m神祕的一笑。[0m
			mpoload 10915 $n 36 target
		endif
	endif
endif
