>defun_prog nian_control~
mpat 5 c 'double heal'
mpechoat $n $I 身上散發出來的強大魔法力量忽然喚起了你體內最深的恐懼感！
if rand(50)
	if rand(40)
		mpadd_qmark self roc_nian_skill 2 0 0 0 0 1
		mpforce $n shout 年獸太可怕了！大家快逃啊！
		mpforcer here add_affect $n fear 1130 2 3 -5 2199023255552
	else
		mpforcer here add_affect $n fear 1130 2 3 -5 2199023255552
		mpforcer here add_affect $n disease 1130 5 5 -5 1099511627776
		mpforcer here add_affect $n poison 1130 5 1 -5 4096
		mpforcer here add_affect $n poison 1130 5 34 500 4096
	endif
endif
if rand(20)
	mpforce $n flee
	mpforce $n flee
	mpforce $n flee
	combat
	break
endif
~
>defun_prog nian_shock~
if is_qmark($i) >= roc_nian_shock 100010
	mpmod_qmark self roc_nian_shock v0 - 10
	mpecho $I 瘋狂地四竄，甩掉身上一切的火焰！
	mpecho [1;31m你受到四散的火焰波及而受傷！[0m
	mpforcer here modhmv pc 01.700 1100 0
else
	if is_qmark($i) >= roc_nian_shock 100004
		if rand(15)
			mpmod_qmark self roc_nian_shock v0 - 4
			combat
			mpnowait
			untan
			mpnowait
			flee
			mpnowait
		endif
	endif
endif
mpadd_qmark self nian_shocking_delay -1 0 0 0 0 1
mpmod_qmark self nian_shocking_delay v0 + 3
if rand(60)
	mpmod_qmark self nian_shocking_delay v0 + 2
endif
if rand(30)
	mpmod_qmark self nian_shocking_delay v0 + 1
endif
if rand(15)
	mpmod_qmark self nian_shocking_delay v0 + 1
endif
~
>defun_prog nian_firecracker~
