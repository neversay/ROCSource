mpmod_qmark self nian_shocking_delay v0 + 3
if rand(60)
	mpmod_qmark self nian_shocking_delay v0 + 2
endif
if rand(30)
	mpmod_qmark self nian_shocking_delay v0 + 1
endif
if rand(15)
	mpmod_qmark self nian_shocking_delay v0 + 1
endif
~
>death_prog 100~
mpecho $I 受到致命的傷害，形體中的生命力開始四散粉碎。
mpecho 你看到一陣紅光飛快地竄出$I 的形體。
mpechotoall [31;1m經過了激烈的奮戰，$n消滅了傳說中的年獸(Nian)！[m
mpechoaround $n [31;1m在激烈的奮戰之中，$n對傳說中的年獸(Nian)發出最後一擊！[m
mpechoat $n [31;1m在激烈的奮戰之中，你成功地對傳說中的年獸(Nian)發出最後一擊！[m
mpecho 你看到無數個寶箱(Talisman Box)及紅包從$I的身上朝著四面八方散去。
mpgreward exp $n 31 30000
mpgreward skexp $n 31 500
mpgreward merit $n 31 20
if is_qmark($n) != roc_nian_slayer
	mpadd_qmark $n roc_nian_slayer -1 1 0 0 0 1
else
	mpmod_qmark $n roc_nian_slayer v0 + 1
endif
mpmod_all_qmark $n adv_book_1_other v1 | 4
if rand(85)
	if rand(25)
		if rand(50)
			mpoload 10923 36 floor
		else
			mpoload 10925 36 floor
		endif
	else
		if rand(33)
			if rand(50)
