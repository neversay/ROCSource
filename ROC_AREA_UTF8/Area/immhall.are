#10904
Pumpkin Seeds~
南瓜籽(Pumpkin Seeds)~
一堆南瓜籽(Pumpkin Seeds)被放在這裡。~
~
19 0 1
2~ 13~ 50~ 0~
1 0 0
E pumpkin seeds~
在你眼前有一堆南瓜籽，你可以選擇一把抓起放入嘴中，或是拿來
播種(sowing)以收成更多南瓜籽。該怎麼作，全由你自己決定。
~
X food~
>obj_command sowing default~
echoat $n 你把南瓜籽(Pumpkin Seeds)灑在一旁，祈禱它能順利成長吧！
echoaround $n $N一個腳滑摔倒在地，手中的南瓜籽灑得到處都是！
if robjcount(10901) > 1
or aobjcount(10901) >= 10
	purge self
	break
endif
if weather($) >= 2
	if weather($) >= 4
		oforcer here callout 150 oload 10901 1 floor 
	else
		oforcer here callout 50 oload 10901 1 floor
	endif
else
	oforcer here callout 100 oload 10901 1 floor
endif
purge self
~
|

#10905
halloween candy~
萬聖驚喜糖(halloween candy)~
一顆萬聖驚喜糖(halloween candy)被放在這裡。~
~
19 0 1
5~ 0~ 0~ 0~
1 0 0
X food~
E halloween candy~
一顆被彩紙包裹妥當的糖果，唯有放入嘴中才能了解箇中滋味。
~
>obj_act eat~
if rand(1)
	echoat $n 呃.....這熟悉味道難道是.....？！
	echoat $n 　
	echoat $n 　
	echoat $n 　
	echoat $n 　
	echoat $n [1;31m是死亡的味道呀！！！[m
	echoaround $n $N熟練的撕開糖果紙，看也不看的就把東西往嘴裡塞，緊接著俐落的吐了一口鮮血癱軟在地！
	oforcer here stun $n 50
	oforcer here modhmv $n 03.98 98 0
	oforcer here modhmv $n 13.98 98 0
	oforcer here modhmv $n 23.98 98 0
else
	if rand(3)
		echoat $n 此糖滋味只應天上有，就如同天使的甘露，你感覺渾身又充滿了活力！
		echoaround $n $N撕開糖果紙，把糖放入嘴中後，露出一臉享受的表情，看起來有些變態。
		oforcer here modhmv $n 04.99 99 0
		oforcer here modhmv $n 14.99 99 0
		oforcer here modhmv $n 24.99 99 0
	else
		if rand(7)
			echoat $n 這是像冰糖的結晶體，嚼著嚼著你突然覺得周遭環境變得扭曲，整個人輕飄飄的～好舒湖～～
			echoaround $n $N撕開糖果紙，把糖放入口中後，不一會時間突然開始莫名傻笑，而且嘴角還流著口水呢，噁...
			oforcer here modhmv $n 13.20 20 0
		else
			if rand(6)
				echoat $n 嗯？嗯嗯嗯...嗯！？ 噗～～哈！！竟然是哇莎比辣椒糖呀！！
				echoaround $n $N撕開糖果紙，把糖放入口中嚼了一會，隨後一把鼻涕一把淚的發出劇烈的慘叫。
				oforcer here modhmv $n 03.20 20 0
			else
				if rand(20)
					echoat $n 這是顆草本糖，淡淡的植物香讓你身體稍微放鬆，恢復了少許體力。
					echoaround $n $N撕開糖果紙，把糖放入口中後，表情呈現放空的呆樣。
					oforcer here modhmv $n 24.15 15 0
				else
					if rand(25)
						echoat $n 這是顆太妃糖，甜滋滋的味道使你不由得會心一笑。
						echoaround $n $N撕開糖果紙，把糖放入口中後，露出有些猥瑣的笑容。
						oforcer here modhmv $n 04.15 15 0
					else
						if rand(33)
							echoat $n 這是顆超涼薄荷糖，涼感直達腦門讓你瞬間清醒了不少。
							echoaround $n $N撕開糖果紙，把糖放入口中後，像被雷打到一般，整個人精神一振。
							oforcer here modhmv $n 14.15 15 0
							if isdrunk($n)
								oforcer here cast 'sober up' $n 1
							endif
						else
							if rand(50)
								echoat $n 喔耶！是糖果耶！嗯....不過也就只是個糖果....
								echoaround $n $N撕開糖果紙，把糖放入口中後，臉上露出些許失望的表情。
							else
								echoat $n 這是顆南瓜口味的糖果，說到萬聖節果然還是南瓜吧！
								echoaround $n $N撕開糖果紙，把糖放入口中後，閉目感受著節慶的氛圍。
								oforcer here add_affect $n satiety 0 10 13 200 0
							endif
						endif
					endif
				endif
			endif
		endif
	endif
endif
~
|

