#11090
Christmas-xmas sleigh-xmas bell-xmas~
[1;31m聖誕[1;33m雪鈴[0m(Christmas Sleigh Bell)~
裝飾在房間中的雪鈴(bell)隨風擺動發出清脆的叮噹聲。~
~
8 1|256|65536|16777216 1|4|32|2048|4096|16384
0~ 0~ 0~ 0~
1 0 0
Z 4
A 28 -4
X gold~
E Christmas sleigh bell~
這顆雪鈴外表看起來跟一般的差不多，但不知道使用了什麼特別的
工法，單獨掛在房間時，被風吹動偶爾會發出奇妙的旋律。
~
>obj_repop 100~
if rand(20)
	opset_obj_affect self -1 1 2
else
	if rand(25)
		opset_obj_affect self -1 2 2
	else
		if rand(33)
			opset_obj_affect self -1 3 2
		else
			if rand(50)
				opset_obj_affect self -1 4 2
			else
				opset_obj_affect self -1 5 2
			endif
		endif
	endif
endif
~
>obj_tick 100~
if objval1($o) > 9
	oset self v1 = 1
endif
if robjcount(11090) == 1
	if objval1($o) == 1
		if rand(15)
			oforcer here echo [1;33m雪鈴[0m隨風擺動，發出奇妙的旋律。
			oforcer here echo 　
			oset self v1 + 1
		endif
	endif
endif
if robjcount(11090) >= 2
	if objval1($o) > 0
		oforcer here echo [1;33m雪鈴[0m隨風擺動，發出叮叮噹、叮叮噹的響亮鈴聲。
		oset self v1 = 0
	endif
	break
endif
if objval1($o) == 2
	oforcer here echo [1;33mDashing through the snow, In a one-horse open sleigh.[0m
endif
if objval1($o) == 3
	oforcer here echo [1;33mO'er the fields we go, Laughing all the way.[0m
endif
if objval1($o) == 4
	oforcer here echo [1;33mBells on bobtail ring, Making spirits bright.[0m
endif
if objval1($o) == 5
	oforcer here echo [1;33mWhat fun it is to ride and sing, A sleighing song tonight![0m
endif
if objval1($o) == 6
	oforcer here echo [1;33mJingle bells, Jingle bells, Jingle all the way.[0m
endif
if objval1($o) == 7
	oforcer here echo [1;33mOh what fun it is to ride, In a one-horse open sleigh.[0m
endif
if objval1($o) == 8
	oforcer here echo [1;33mJingle bells, Jingle bells, Jingle all the way.[0m
endif
if objval1($o) == 9
	oforcer here echo [1;33mOh what fun it is to ride, In a one-horse open sleigh![0m
	oset self wear | 1
endif
if objval1($o) >= 2
	oset self v1 + 1
endif
~
>obj_command hang default~
echoat $n 你要把$O掛在哪？
~
>obj_command hang reindeer~
if is_inv_obj($n) == 11090
or is_equ_obj($n) == 11090
	if rmobcount(11040) >= 1
		echoat $n 你把$O掛在[33m馴鹿[0m(Reindeer)脖子上。
		echoaround $n $N把$O掛在[33m馴鹿[0m(Reindeer)脖子上。
		oforce Reindeer-Xmas mpcall get_reindeer_horse $n
		purge self
	else
		echoat $n 這裡沒有[33m馴鹿[0m(Reindeer)。
	endif
else
	echoat $n 什麼？
endif
~
>obj_command hang room~
if is_inv_obj($n) == 11090
or is_equ_obj($n) == 11090
	echoat $n 你把$O掛在房間中。
	echoaround $n $N把$O掛在房間中。
	if robjcount(11090) >= 1
		if rand(30)
			oforcer here echo [1;33m雪鈴[0m隨風擺動，發出叮叮噹、叮叮噹的響亮鈴聲。
		endif
		break
	endif
	oset self v1 = 1
	ogoto self
else
	echoat $n $O已經裝飾在房間中了。
endif
~
>obj_act get~
if objval1($o) != 0
	oset self v1 = 0
endif
~
