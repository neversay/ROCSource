	echoat $n equ_loc is 18
else
	echoat $n else equ_loc not 18
endif
if is_equ_loc($o) != 18
	echoat $n equ_loc not 18
else
	echoat $n else equ_loc is 18
endif
if is_equ_loc($o) < 16
	echoat $n equ_loc < 16
else
	echoat $n else equ_loc >= 16
endif
if is_equ_loc($o) > 16
	echoat $n equ_loc > 16
else
	echoat $n else equ_loc <= 16
endif
~
