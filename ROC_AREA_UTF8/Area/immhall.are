			mpmod_qmark self nian_teletime v0 = 0
			break
		endif
		mpmod_qmark self nian_teletime v0 = 9
		break
	endif
	mpmod_qmark self nian_teletime v0 = 0
	mpteleport all
	mpforcer here echotoarea 傳說中的年獸突然出現在這附近，四處瞬間傳來無數的哀號聲。
	break
endif
