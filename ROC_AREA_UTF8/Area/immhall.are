>talk_prog report~
if is_qmark($i) == baiwar_over
	if is_qmark($n) == bai_fighting
		if is_qmark($n) == ROC_white_snake 300001
			mpmod_qmark $n ROC_white_snake v2 = 3
			mpdel_qmark $n bai_fighting
			tell $n 感謝你的協助，短時間內這妖孽應該不會再出現作亂了。
			tell $n 我手上沒有什麼好東西，只能將這把刀送給你作為謝禮。
			mpechoat $n $I給了你一把黑色的刀。
			mpoload 11079 $n 40 target
			mpcallout 1 wave $n
			mpcallout 1 tell $n 那麼祝你端午節快樂，我們後會有期。
		endif
	else
		tell $n 雖然我跟你不熟，但很慶幸你能從這災難中活著回來。
		mpdel_qmark $n bai_fighting
	endif
endif
