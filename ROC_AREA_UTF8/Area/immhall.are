E realgar wine~
在某些國家傳統習俗中，於特定節慶時會飲用這種參入雄黃粉末的酒類。
但雄黃具有一定的毒性，食用後可能造成中毒的現象。如果不想食物中毒
但又想融入節慶氛圍，將它塗抹(smear)在身上也不失為一種好方法。
~
>obj_command smear default~
echoat $n 你將[33m雄黃酒[0m(realgar wine)均衡地塗抹在身上。
oforcer here cast 'cure disease' $n 60
oforcer here cast 'acid blast' $n 60
if rand(40)
	oforcer here cast 'acid blast' $n 60
endif
if rand(20)
	oforcer here cast 'acid blast' $n 60
endif
if rand(10)
	oforcer here cast 'acid blast' $n 60
endif
oforcer here add_affect $n 'protection' 1140 5 28 -15 8192
purge self
~
>obj_command spill default~
if inroom($n) == 11121
	if mobcount(11023) == 1
		if is_qmark($n) == ROC_white_snake 200007
			if is_qmark($n) == ROC_white_snake 100004
				echoat $n 你將[33m雄黃酒[0m(realgar wine)朝白素貞(Bai Suzhen)身上潑灑，但被她靈巧地閃開。
				oforcer here force suzhen-dbf tell $n 你想要作什麼！！
				oforcer here angry $n
				oforcer here mod_qmark $n ROC_white_snake v0 = 5
				echoat $n 　
				echoat $n 你的意圖被視破了！看來也無法繼續執行委託，那只能跟她說明一下理由了。(reason)
			else
				if is_qmark($n) >= ROC_white_snake 300002
					echoat $n 你將[33m雄黃酒[0m(realgar wine)朝白素貞(Bai Suzhen)身上潑灑。
					oforcer here force suzhen-dbf talk self changetosnake
				else
					echoat $n 你將[33m雄黃酒[0m(realgar wine)朝白素貞(Bai Suzhen)身上潑灑。
					oforcer here mod_qmark $n ROC_white_snake v2 = 1
					oforcer here force suzhen-dbf talk self changetosnake
				endif
			endif
		else
			echoat $n 你將[33m雄黃酒[0m(realgar wine)潑灑出去。
		endif
	else
		echoat $n 你將[33m雄黃酒[0m(realgar wine)潑灑出去。
	endif
else
	echoat $n 你將[33m雄黃酒[0m(realgar wine)潑灑出去。
endif
purge self
~
