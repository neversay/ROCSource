>defun_prog jack-o-sword~
mpmod_qmark self jacko_sword_count v0 - 1
change $n
mpechoat $n $I從身上亮出一把闊劍朝你刺了過來。
mpechoaround $n $I從身上亮出一把闊劍朝$R刺了過去。
mpoload 10912 36
wear broadsword-jacko
sprinkle $n
mpnowait
mpjunk broadsword-jacko
mpnowait
if rand(20)
	mpoload 10912 $n 36 target
endif
~
>defun_prog jack-o-hammer~
mpmod_qmark self jacko_hammer_count v0 - 1
mpecho $I從身上掏出一把鐵鎚朝地面猛擊。
mpoload 10913 36
wear hammer-jacko
earth
mpnowait
mpjunk hammer-jacko
if rand(20)
	mpoload 10913 36 floor
endif
~
>defun_prog jack-o-knife~
if is_qmark($i) < jacko_knife_shot 100010
	if rand(70)
		mpoload 10914 36
		throw knife-jacko $n
		mpnowait
		if rand(10)
			mpoload 10914 $n 36 target
		endif
	else
		if rand(10)
			mpoload 10914 36 floor
		endif
	endif
	mpmod_qmark self jacko_knife_shot v0 + 1
endif
~
>defun_prog jack-o-dispel~
if rand(30)
	if isaffected($n) / mystic armor
		c crush $n
	else
		mpforcer here del_affect $n random
	endif
endif
~
>fight_prog 100~
if is_qmark($i) != jacko_fighting_stun
	mpadd_qmark self jacko_fighting_stun 3 0 0 0 0 1
else
	mpmod_qmark self jacko_fighting_stun timer = 3
endif
if is_qmark($i) == jacko_moving_stun
	mpdel_qmark self jacko_moving_stun
endif
if is_qmark($i) >= jacko_flee_count 100010
	mpmod_qmark self jacko_flee_count v0 = 0
	mpmod_qmark self jacko_fighting_stun timer = 2
	mpgoto self
	mpecho $I化成一團煙霧脫離戰鬥。
	mpteleport area
	if isaffected($i) !& 2
		mpat 5 c invis
	endif
	if isaffected($i) !& 65536
		hide
	endif
	break
endif
if is_qmark($i) == jacko_suse
	mpdel_qmark self jacko_suse
	break
endif
if rand(80)
	if is_qmark($i) <= jacko_sword_count 100000
		if is_qmark($i) <= jacko_hammer_count 100000
			if is_qmark($i) <= jacko_knife_count 100000
				mpmod_qmark self jacko_spell v0 + 1
			else
				mpmod_qmark self jacko_skill v0 + 1
			endif
		else
			mpmod_qmark self jacko_skill v0 + 1
		endif
	else
		mpmod_qmark self jacko_skill v0 + 1
	endif
endif
if rand(30)
	mpmod_qmark self jacko_spell v0 + 1
endif
if rand(60)
	mpmod_qmark self jacko_flee_count v0 + 1
endif
if is_qmark($i) >= jacko_skill 100005
or is_qmark($i) >= jacko_spell 100005
	if pcnum($) > 0
		mpcall jack-o-dispel pc
	endif
	mpadd_qmark self jacko_suse -1 0 0 0 0 1
else
	if rand(20)
		c ghost
	else
		if rand(20)
			c apocalypse
		else
			c fireball
		endif
	endif
endif
if is_qmark($i) >= jacko_skill 100005
	mpmod_qmark self jacko_skill v0 = 0
	if rand(33)
		if is_qmark($i) > jacko_sword_count 100000
			mpcall jack-o-sword $r
		else
			if rand(50)
				if is_qmark($i) > jacko_hammer_count 100000
					mpcall jack-o-hammer $i
				else
					if is_qmark($i) > jacko_knife_count 100000
						mpmod_qmark self jacko_knife_count v0 - 1
						mpmod_qmark self jacko_knife_shot v0 = 0
						mpecho $I朝四面八方丟出許多短刀。
						mpcall jack-o-knife all
					endif
				endif
			else
				if is_qmark($i) > jacko_knife_count 100000
					mpmod_qmark self jacko_knife_count v0 - 1
					mpmod_qmark self jacko_knife_shot v0 = 0
					mpecho $I朝四面八方丟出許多短刀。
					mpcall jack-o-knife all
				else
					if is_qmark($i) > jacko_hammer_count 100000
						mpcall jack-o-hammer $i
					endif
				endif
			endif
		endif
	else
		if rand(50)
			if is_qmark($i) > jacko_hammer_count 100000
				mpcall jack-o-hammer $i
			else
				if is_qmark($i) > jacko_sword_count 100000
					mpcall jack-o-sword $r
				else
					if is_qmark($i) > jacko_knife_count 100000
						mpmod_qmark self jacko_knife_count v0 - 1
						mpmod_qmark self jacko_knife_shot v0 = 0
						mpecho $I朝四面八方丟出許多短刀。
						mpcall jack-o-knife all
					endif
				endif
			endif
		else
			if is_qmark($i) > jacko_knife_count 100000
				mpmod_qmark self jacko_knife_count v0 - 1
				mpmod_qmark self jacko_knife_shot v0 = 0
				mpecho $I朝四面八方丟出許多短刀。
				mpcall jack-o-knife all
			else
				if is_qmark($i) > jacko_sword_count 100000
					mpcall jack-o-sword $r
				else
					if is_qmark($i) > jacko_hammer_count 100000
						mpcall jack-o-hammer $i
					endif
				endif
			endif
		endif
	endif
else
	if is_qmark($i) >= jacko_spell 100005
		mpmod_qmark self jacko_spell v0 = 0
		if rand(50)
			c 'hell southerncross'
		else
			c 'holy judgement'
		endif
	endif
endif
