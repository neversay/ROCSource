if is_qmark($n) == ROC_white_snake 100006
	mpmod_qmark $n ROC_white_snake v2 = 2
	mpat suzhen-dbf mpadd_qmark suzhen-dbf fahai_war -1 0 0 0 0 1
	say 什麼？你居然在幫妖孽說話！
	say 既然你已被妖孽迷惑，那老納就親自去解決她！
	mpecho $I說完後往山下直奔而去。
	mpgoto 5
	mpcallout 3 mpat 234 mpmload 11028
	mpcallout 4 mppurge self
