	mpechoat $n 這老頭似乎在打瞌睡....
	drop $o
	break
endif
if is_qmark($n) == ROC_Mid_Autumn 202024
	mpjunk $o
	break
endif
if is_qmark($n) == ROC_Mid_Autumn
	mpmod_qmark $n ROC_Mid_Autumn v1 = 2024
else
	mpadd_qmark $n ROC_Mid_Autumn -1 0 2024 0 0 1
endif
if is_qmark($n) == ROC_taketori_2020
	mpdel_qmark $n ROC_taketori_2020
endif
if is_qmark($n) == ROC_taketori_2020
	mpdel_qmark $n ROC_taketori_2019
endif
if is_qmark($n) == ROC_taketori
	mpdel_qmark $n ROC_taketori
endif
mpadd_qmark $n ROC_taketori -1 0 0 0 0 1
mpjunk $o
mpadd_qmark self talking
mpcallout 6 mpdel_qmark self talking
mpechoat $n $I把朧月長刀(knife)拿進了門後。
mpcallout 1 mpechoat $n 隨後一道女性的聲音傳入你腦中：
mpcallout 2 mpechoat $n 「它是屬於其他世界的相同之物吧。」
mpcallout 2 mpechoat $n 「在我所屬的世界，這把刀早在百年前就已毀滅」
mpcallout 3 mpechoat $n 腦中的聲音沉寂了一陣子。
mpcallout 3 mpechoat $n 「但你也很清楚，我跟你是不可能有結果的....」
mpcallout 3 mpechoat $n 「來自異界的旅人呀，雖然你完成了任務」
mpcallout 5 mpechoat $n 「能借助你的力量讓外頭的凡夫俗子們知難而退嗎？」
mpcallout 5 mpechoat $n 「話雖如此，但我們的相遇自然是種緣分」
mpcallout 6 mpechoat $n 「是否願意幫助我，一切取決於你」
~
|

