>death_prog 100~
mpecho $I[1;32m喊道：啊....[0m
if is_qmark($n) != skarabrae_enemy
	mpadd_qmark $n skarabrae_enemy 200 0 0 0 1 1
else
	mpmod_qmark $n skarabrae_enemy timer + 200
endif
~
