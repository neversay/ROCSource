P 8
>talk_prog mission~
if ispc($n)
        if is_qmark($n) != eastern_summon_quest
                mpadd_qmark $n eastern_summon_quest -1 1 0 0 0 1
                say 這件事與其說是任務，不如說是考古研究。
                say 幾個月前，有塊隕石掉到這片沙漠中，讓一處被埋在沙裡的遺跡得以重見天日。
                say 不過沒過幾天就又被埋了......然而這不是重點。
                say 重點是那處遺跡，是人類尚未登上這片大陸時就存在的建築物。
                say 裡面據說囚禁著四個魔王級的怪物(monster)......
        endif
endif
~
>talk_prog monster~
if is_qmark($n) == eastern_summon_quest 100001
        say 嗯，四個，據說都相當地強大。
        say 似乎是神為了懲罰當時這片大陸的住民，而派出來的。
        say 最後四個魔王先後被勇者打倒並封印起來......聽起來像是很常見的小說橋段。
        say 可惜的是，這是真的，而且相關的文獻上還記載著......
        say 「被封印起來的魔王們正在恢復力量，等著再次執行神的旨意」
        say 因此我有個想法......就是趁著魔王們力量還沒完全回復，把封印解開，消滅(destroy)他們！
        mpmod_qmark $n eastern_summon_quest v0 = 2
endif
~
>talk_prog destroy~
if is_qmark($n) == eastern_summon_quest 100002
        say 要消滅他們就得先找到遺跡，不過這個問題我已經解決了。
        say 找到遺跡後還得解開封印讓其中一名魔王出現，這就比較麻煩。
        say 不過幸運的是，由於魔王們的力量尚未完全恢復，因此......
        say 即使封印解開了，他們也只能在這個世界活動大約三天。
        say 至於解開封印的方法......有點血腥，聽好了。
        say 這沙漠裡任何生物都可以，去殺個兩百隻，聚集大量的死亡氣息。
        say 然後回來找我(over)，我可以用這些死亡氣息做出可以讓封印暫時弱化的物品。
        mpmod_qmark $n eastern_summon_quest v0 = 3
endif
~
>talk_prog over~
if is_qmark($n) == eastern_summon_quest 100203
        say 喔喔～～你回來啦，辛苦了辛苦了。
        say 只要喝下這個，就可以將死亡氣息集結並轉化，然後你就可以解開封印了。
        mpechoat $n 你接過$I給的藥物，考慮了幾秒後才喝下，這藥物味道有點像放了兩個月的草莓汁...
        say 喔，對了，如果你以後想再解開封印，再去殺個兩百隻沙漠裡的生物後再來找我吧。
        mpmod_qmark $n eastern_summon_quest v0 = 3
        mpmod_qmark $n eastern_summon_quest v1 + 1
else
        if is_qmark($n) < eastern_summon_quest 100203
                say 嗯......死亡氣息的濃度還不夠，再努力點吧。
        endif
endif
~
