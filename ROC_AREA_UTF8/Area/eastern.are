>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 1 0
mpadd_qmark self eastern_summon 72 0 0 0 1 0
mpechotoall [1;31m【警報】：「『惡魔公爵』費德斯坦復活了......！」[m
~
>tick_prog 100~
if is_qmark($i) != eastern_summon
        mpecho 忽然間，$I的身影逐漸變得模糊，最後完全消失了！
        shout 可恨！我一定會再回來的......！
        mppurge self
endif
~
>fight_prog 100~
if is_qmark($i) != eastern_summon
        mpecho 忽然間，$I的身影逐漸變得模糊，最後完全消失了！
        shout 可恨！我一定會再回來的......！
        mppurge self
else
        if rand(50)
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
        else
                mpecho $I雙拳發出異光，你的能量脫離了你的身體，化為光點朝他飛去！
                mpforcer here modhmv pc 11.100 100 0
                mpforcer here modhmv pc 21.100 100 0
        endif
endif
~
>death_prog 100~
mpdis_magic self all
mpat 5 cast 'detect hidden'
mpat 5 cast 'detect invis'
mpat 5 cast infravision
rumor 「惡魔公爵」費德斯坦(Feldstein)被 $N 消滅了！
mpoload 5034 38
if rand(10)
        if rand(50)
                mpoload 5038 38
        else
                mpoload 5039 38
        endif
endif
~
