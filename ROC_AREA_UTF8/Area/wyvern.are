  		mpecho $I 掏出一根小蠟燭。
  		say 可別小看這根蠟燭喔，這上面可是有魔法的。
  		say 這根尋寶者之燭可以幫助佩帶他的人尋找到他要的東西。
  		say 如何？一把不要算你太貴， 800 元就好啦，嘿嘿嘿。
  		mpmod_qmark $n wyvern_tower v0 = 4
	endif
~
>bribe_prog 800~
if is_qmark($n) >= wyvern_tower 100004
	mpjunk coins
	say 啊，不好意思，貪財貪財。
	mpoload 1714
	give candle $n
	say 忘了告訴你，它可是會熄的喔，使用時請小心。
	smile $n
	say 再會啦，有空再來坐啊！
	if is_qmark($n) == wyvern_tower 100004
		mpmod_qmark $n wyvern_tower v0 = 5
	endif
endif
~
|
