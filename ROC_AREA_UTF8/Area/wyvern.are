>rand_prog 40~
if hitprcnt($i) <= 10
	if is_qmark($i) != wyvern_chief_fullheal
		mpadd_qmark $i wyvern_chief_fullheal 100 0 0 0 1 0
	else
		if is_qmark($i) <= wyvern_chief_fullheal 100002
			c 'full heal'
			mpmod_qmark $i wyvern_chief_fullheal v0 + 1
		endif
	endif
	break
endif
if hitprcnt($i) <= 30
	mpat 5 c 'double heal'
endif
~
>fight_prog 100~
if class($n) == 10
	if rand(80)
		c 'star fire' $n
		mpnowait
		c para
		mpnowait
		mpat 5 c 3 double
		mpnowait
		break
	endif
endif
if class($n) == 14
	if rand(80)
        	c 3 fireball $n
        	mpnowait
        endif
endif
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
if hitprcnt($i) <= 10
	if is_qmark($i) != wyvern_chief_fullheal
		mpadd_qmark $i wyvern_chief_fullheal 100 0 0 0 1 0
	else
		if is_qmark($i) <= wyvern_chief_fullheal 100002
			c 'full heal'
			mpmod_qmark $i wyvern_chief_fullheal v0 + 1
		endif
	endif
	break
endif
~
>fight_prog 60~
if hitprcnt($i) < 20
	c 'double heal'
	mpnowait
	c heal
	mpnowait
	mpat 5 invoke
endif
if hitprcnt($i) < 50
	if rand(30)
		c 'double heal'
		mpnowait
		c flamestrike
	else
		c 'double heal'
		mpnowait
		c fireball
	endif
	mpnowait
endif
if hitprcnt($i) < 80
	if rand(30)
		c 'double heal'
	else
		c heal
	endif
	mpnowait
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mplog killed by $n
~
>hurt_prog 60~
if is_qmark($i) != chief_magic_missile
    mpadd_qmark $i chief_magic_missile -1 1 0 0 0 1
    mpat 5 c full
    mpnowait
else
        if is_qmark($i) < chief_magic_missile 100010
            mpmod_qmark $i chief_magic_missile v0 + 1
            mpat 5 c 2 double
            mpnowait
        else
            mpdel_qmark $i chief_magic_missile
                sigh $n
                say 已經很久沒有人敢對我這樣做了！
                mpat 5 c 2 'double heal'
                mpnowait
                if rand(80)
                	c 3 whirl 
                	mpnowait
                endif
                if rand(60)
                	c 'magic missile' $n
                	mpnowait
                endif
        endif
endif
~
>hurt_prog 58~
if is_qmark($i) != chief_lightning
    mpadd_qmark $i chief_lightning -1 1 0 0 0 1
    mpat 5 c full
    mpnowait
    else
        if is_qmark($i) < chief_lightning 100007
            mpmod_qmark $i chief_lightning v0 + 1
            mpat 5 c double
            mpnowait
        else
            mpdel_qmark $i chief_lightning
                worry $n
                say 你真的以為我怕這招嗎？！
                mpat 5 c full
                mpnowait
                if rand(80)
                	c 'fire breath' $n
                	mpnowait
                endif
                if rand(40)
                	c 'frost breath' $n
                	mpnowait
                endif
        endif
endif
~
>hurt_prog 137~
if is_qmark($i) != chief_frenzy
    mpadd_qmark $i chief_frenzy -1 1 0 0 0 1
    mpat 5 c full
    mpnowait
    else
        if is_qmark($i) < chief_frenzy 100005
            mpmod_qmark $i chief_frenzy v0 + 1
            mpat 5 c 3 double
            mpnowait
        else
            mpdel_qmark $i chief_frenzy
                sigh $n
                say 別以為這招會有用！
                mpat 5 c full
                mpnowait
                c 3 powerball $n
                mpnowait
                c 2 whirl
                mpnowait
        endif
endif
~
>hurt_prog 101~
if is_qmark($i) != chief_circle
     mpadd_qmark $i chief_circle -1 1 0 0 0 1
     mpnowait
     mpat 5 c heal
     mpnowait
     else
        if is_qmark($i) < chief_circle 100003
            mpmod_qmark $i chief_circle v0 + 1
            mpat 5 c 2 double
            mpnowait
        else
                mpdel_qmark $i chief_circle
                sigh $n
                say 你經驗還是太嫩了！
                mpat 5 c 2 'double heal'
                mpnowait
                c 3 whirl 
                mpnowait
                c 'magic missile' $n
                mpnowait
        endif     
endif
