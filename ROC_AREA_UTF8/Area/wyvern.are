wizard lopas~
魔法師羅帕斯(wizard lopas)~
魔法師羅帕斯(wizard lopas)正在專心的試驗新魔法。
~
他就是飛龍之塔的主人，傳說中的魔法師羅帕斯。傳聞他有跟龍
族建立良好的關係，因此能獲得龍族的魔法知識和技術。
~
67 524716 800 S
37 0 0 0d0+0 0d0+0
10000 0
0 8 1
C 2
P 136
>greet_prog 100~
if is_qmark($n) == wyvern_tower 100006
  	mpmod_qmark $n wyvern_tower v0 = 7
  	mpechoat $n $I 向你說： 幹嘛，你們怎麼會有我的鑰匙咧。
  	ponder
  	mpechoat $n $I 向你說： 該死，一定是那個貪得無饜的酒店肥子告訴你們的，
  	mpechoat $n $I 向你說： 是不是這樣沒錯？
  	mpechoat $n 你心想：我要照實回答他嗎？(yes/no)
  	break
	endif
if is_qmark($n) == wyvern_tower 100009
	mpechoat $n $I 向你說： 還不趕快去拿角來？
else
	mpecho $I 朝你瞪了一眼：走開走開，不要打擾我做實驗。
endif
if is_qmark($n) == wyvern_tower 200006
        say 搞什麼，不是已經幫你們處理掉那群不人不牛的傢伙
        say 了嗎？還跑來這邊幹什麼？沒事就快滾，別妨礙我做
        say 試驗！
        mpechoat $n $I說完話就撇過頭，不再搭理你。
        mpechoat $n 你心想：還是該問問他關於魔法傳送通道的事情才行....
        mpmod_qmark $n wyvern_tower v1 = 7
endif
~
>talk_prog yes~
if is_qmark($n) == wyvern_worse 100000
  		mpecho $I 大吼：你給我出去，你給我出去，我不要再看見你！
  		mpechoat $n $I 用魔法將你轟了出來！
  		mpforce $n s
  		break
	endif
	if is_qmark($n) == wyvern_tower 100007
  		mpmod_qmark $n wyvern_tower v0 = 8
  		mpecho $I 仰天大笑。
  		mpechoat $n $I 向你說：哈哈哈哈，我就知道是這樣，我真是聰明極了。
  		mpechoat $n $I 向你說：他一定是對那些該死的牛頭人感到不厭煩了，
  		mpechoat $n $I 向你說：所以叫你們來找我，對不對啊？(yes/no)
  		break
	endif
	if is_qmark($n) == wyvern_tower 100008
  		mpmod_qmark $n wyvern_tower v0 = 9
  		mpecho $I 捻了捻鬍子。
  		mpechoat $n $I 向你說：那些人不像人牛不像牛的傢伙也胡鬧夠久了，
  		mpechoat $n $I 向你說：也是時候把我的塔清一清了。
  		mpechoat $n $I 向你說：這樣吧，你去幫我拿一根牛頭人的角來。
	endif
~
>talk_prog no~
if is_qmark($n) == wyvern_tower 100007
	or is_qmark($n) == wyvern_tower 100008
  		mpecho $I 氣的吹鬍子瞪眼：什麼！你竟敢反抗我的意見！
  		mpadd_qmark $n wyvern_worse 40 0 0 0 0 1
  		mpecho $I 大吼：你給我出去，你給我出去，我不要再看見你！
  		mpechoat $n $I 用魔法將你轟了出來！
  		mpforce $n s
	endif
~
>talk_prog passage~
if is_qmark($n) == wyvern_tower 200007
        mpechoat $n 你將你描繪下來的魔法陣圖案拿給羅帕斯，並向他說明了事情的原委。
        say 嗯....嗯嗯，喔....
        mpcallout 1 mpcall lopas_talking1 $n
        mpcallout 2 mpcall lopas_talking2 $n
        mpcallout 3 mpcall lopas_talking3 $n
        mpcallout 4 mpcall lopas_talking4 $n
        mpcallout 5 mpcall lopas_talking5 $n
        mpcallout 6 mpcall lopas_talking6 $n
        mpcallout 6 mpmod_qmark $n wyvern_tower v1 = 8
endif
~
>talk_prog ok~
if is_qmark($n) == wyvern_tower 200015
        say 嗯嗯，小子幹的不錯，人馬村長那邊我找時間再跟他
        say 說明吧，送你點小禮物，讓你以後能多幫我做點事。
        mpechoat $n 說完，$I朝你身上灑了一把灰......
        mpexp $n 10000
        mpskillexp $n 5000
        mpcall lopas_talking9 $n
        mpechoat $n 你感覺身體裡面好像有股微弱的力量冒了出來......
        say 不過這盾牌的詛咒(curse)還真是有意思啊......
        mpmod_qmark $n wyvern_tower v1 = 16
endif
~
>talk_prog curse~
if is_qmark($n) == wyvern_tower 200016
        if is_qmark($n) == wyvern_tower 300000
                say 嗯？你聽到了啊，那也沒差，沒錯，就跟你聽到的一
                say 樣，我認為那盾牌會吞噬使用者的靈魂是一種詛咒。
                say 或者也可以說是一種陷阱之類的，我猜想可能是某個
                say 高等魔族利用這玩意收集靈魂(soul)，藉此壯大自己
                say 的力量！
                ponder
                say 不過也跟我沒關係就是了，不要礙著我做實驗就好。
                mpmod_qmark $n wyvern_tower v2 = 1
        endif
endif
~
>talk_prog soul~
if is_qmark($n) == wyvern_tower 300001
        say 小子，你有興趣？還真是個愛管閒事的傢伙啊......
        shrug
        say 這玩意在我的專業領域外，如果你能再弄到一面樣品
        say 的話，拿去楓紅村吧，聽說那裡有個很厲害的牧師，
        say 他也許有辦法搞定。
        say 聽懂了就快滾，別留在這裡礙眼。
        mpmod_qmark $n wyvern_tower v2 = 2
endif
~
>give_prog 1693~
if is_qmark($n) == wyvern_tower 100010
  		mpjunk horn
  		mpoload 1694
  		hmm
  		mpechoat $n $I 向你說：很好，這樣我就可以讓這些牛頭人回老家了。
  		mpecho $I 手中發出一陣閃光，讓你全身暈眩！
  		mpechoat $n $I 向你說： 好啦，這下子就搞定啦。
  		mpechoat $n $I 向你說： 把這拿給人馬村村長，他會知道怎麼用它的。
  		mpechoat $n $I 向你說：對了，還有....！
  		mpdef_rembch $n
  		mpadd_qmark self wyvern_quest -1 0 0 0 0 1
	else
  		mpechoat $n $I 向你說： 你給我這什勞子的牛頭人角幹嘛？拿回去拿回去。
  		give horn $n
	endif
~
>give_prog 15112~
if is_qmark($n) == wyvern_tower 200008
        mpmod_qmark $n wyvern_tower v1 = 9
        say 再來個四面吧。
        mpat 5 mpjunk $o
        break
endif
if is_qmark($n) == wyvern_tower 200009
        mpmod_qmark $n wyvern_tower v1 = 10
        say 再來個三面吧。
        mpat 5 mpjunk $o
        break
endif
if is_qmark($n) == wyvern_tower 200010
        mpmod_qmark $n wyvern_tower v1 = 11
        say 再來個兩面吧。
        mpat 5 mpjunk $o
        break
endif
if is_qmark($n) == wyvern_tower 200011
        mpmod_qmark $n wyvern_tower v1 = 12
        say 再來個一面吧。
        mpat 5 mpjunk $o
        break
endif
if is_qmark($n) == wyvern_tower 200012
        mpmod_qmark $n wyvern_tower v1 = 13
        say 好了好了，這樣數量就足夠了，你等一下啊......
        mpat 5 mpjunk $o
        mpcallout 1 mpcall lopas_talking7 $n
        mpcallout 21 mpechoat $n 過了一段時間，你發現盾牌的數量好像減少了一面....刺耳的尖叫聲也小了點。
        mpcallout 31 mpechoat $n 過了一段時間，你發現盾牌的數量好像減少了一面....刺耳的尖叫聲也小了點。
        mpcallout 41 mpechoat $n 過了一段時間，你發現盾牌的數量好像減少了一面....刺耳的尖叫聲也小了點。
        mpcallout 51 mpechoat $n 過了一段時間，你發現盾牌的數量好像減少了一面....刺耳的尖叫聲也小了點。
        mpcallout 52 mpcall lopas_talking8 $n
endif
~
>defun_prog lopas_talking1~
mpechoat $n $I看起來似乎一點都不意外，並將你遞給他的魔法陣圖案隨手丟在一旁。
say 這玩意我看都不用看啊，這可是我苦思三週才想出來
say 的單向傳送法陣，你就算要我閉著眼睛倒著畫也畫得
say 出來！
cackle
mpforce $n -
~
>defun_prog lopas_talking2~
say 怎麼？不高興啊？早就知道你們這些俗人無法理解，
say 所以我才把自己關在這種地方做研究......
mpechoat $n $I搔了搔頭，沈思了片刻。
say 不過說也奇怪....我設計的傳送通道應該是從這邊單
say 向通往地底沼澤才是，那群爬蟲類是怎麼過來的....
mpechoat $n $I邊說邊把那張描著魔法陣的紙片拿起來觀看。
~
>defun_prog lopas_talking3~
mpechoat $n 經過了片刻，$I突然拍了拍自己的額頭大叫。
say 唉呀！原來是這個地方錯了！這裡不該是α而應該是
say β，所以這裡的γ就應該是......
mpechoat $n $I自顧自的唸著一堆你聽都聽不懂的東西。
say 哈哈哈，原來這裡用這個符號可以產生讓通過通道的
say 生物在經過一定時間後被強制送回入口的效果，這就
say 是那兩隻爬蟲類會突然消失的原因了吧。
mpechoat $n $I拿起了紙筆，把這些情報記錄起來。
~
>defun_prog lopas_talking4~
mpechoat $n 做完了記錄，$I再度抬起頭狂笑不止。
say 哈哈哈！真不愧是我啊！就算在無意識的情況下也能
say 夠設計出如此強大的魔法！這就是真正的天才！沒錯
say 沒錯，只有天才如我才有如此的能力啊！
mpechoat $n 看$I現在這個狀態，你實在不知道該如何是好，
mpechoat $n 但還是只能硬著頭皮再向他說明一次人馬村現在遇到的困境....
~
>defun_prog lopas_talking5~
say 啊？人馬村那邊啊，嗯....有什麼差嗎？反正都知道
say 那些爬蟲類會定時被送回去地底沼澤了不是嗎。
mpechoat $n $I繼續沈溺在自己的偉大成就之中，不太想理睬你。
mpechoat $n 你忍住想要殺人的衝動，再一次"懇求"他高抬貴手幫幫可憐的人馬村解決這個"意外"。
~
>defun_prog lopas_talking6~
say 嘖，真是麻煩啊，不過要是那群爬蟲類定時跑到這邊
say 來散步的話也挺礙眼的，幫你們把通道塞起來倒也不
say 是什麼太困難的事情......
mpechoat $n $I翻了翻自己的實驗筆記。
say 有了有了，封住靈魂通道的方式......嗯嗯，你去幫
say 我弄幾面那些爬蟲類身上的盾牌過來，不用太多，大
say 概有個五面就可以封住通道了。
mpechoat $n 你心想：Ｘ的哩....我得去地底沼澤拼命還跟我說五面不算太多......
~
>defun_prog lopas_talking7~
mpechoat $n $I將五面吞噬之盾(devour shield)疊在一起，喃喃念起了咒語。
mpechoat $n 你看到五面吞噬之盾(devour shield)都發出了詭異的亮黑色光暈，並傳出了尖銳的叫聲。
~
>defun_prog lopas_talking8~
mpechoat $n 從開始施法到現在已經過了一段時間，盾牌終於只剩下最後一面了。
mpechoat $n 你心中不禁疑惑起：另外四面盾牌到底跑哪去了？
say 終於完工了，這面盾『吃了』另外四面盾之後，整個
say 威力應該是更不同凡響了，你就把這盾拿去，埋在魔
say 法陣的中央，應該就能塞住通道了。
say 除非牠們在通過靈魂通道的時候能夠不被這面盾把魂
say 魄給吞掉......
hehe
