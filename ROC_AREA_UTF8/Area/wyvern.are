>room_enter 127 100~
if is_qmark($n) == wyvern_tower 200004
        echoat $n 一走進壕溝之中，突然就有兩隻巨龍蜥(great basilisk)張大了嘴朝你衝來！
        echoat $n 就在你舉起武器打算應戰時，一陣藍色的光芒從壕溝底部亮起，巨龍蜥也隨即消逝的無影無蹤。
        mod_qmark $n wyvern_tower v1 = 5
endif
~
>room_command search around~
if is_qmark($n) == wyvern_tower 200005
        echoat $n 你試著搜尋四周....
        echoat $n 你在剛才亮起藍色光芒的地面看到了一個似乎是魔法陣的圖案，似乎是傳送用的通道。
        echoat $n 這是個很重要的發現，也許你可以去問問這帶對魔法最有研究的人。
        mod_qmark $n wyvern_tower v1 = 6
endif
~
>room_command bury shield~
if is_qmark($n) == wyvern_tower 200014
        echoat $n 你小心翼翼的將那面有本來五倍重量的吞噬之盾拿了出來，
        echoat $n 並將它埋在羅帕斯指示的魔法陣中心點......
        echoat $n 看起來好像沒什麼變化....不過羅帕斯說這樣就行了....
        echoat $n 那應該是沒問題(OK)了吧，可以回去跟羅帕斯說一聲了。
        purge $n super-devour-deepland
        mod_qmark $n wyvern_tower v1 = 15
endif
~
