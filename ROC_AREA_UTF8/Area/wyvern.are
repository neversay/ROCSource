  		sigh
  		say 看來一切的努力都白費了，得從頭來起了。
  		mpdel_qmark $n wyvern_tower
		mpat lopas mpdel_qmark lopas wyvern_quest
endif
~
>fight_prog 30~
if class($n) == 10
        if rand(80)
		c 'star fire' $n
		mpnowait
		c para
		mpnowait
		mpat 5 c 3 double
		mpnowait
	endif
endif
c 'energy drain' $n
mpnowait
c curse $n
mpnowait
c poison $n
mpnowait
mpat 5 c 2 double
mpnowait
