>talk_prog topic~
if is_qmark($n) == wyvern_tower 100011
		mpechoat $n $I 說「您好，人馬村的英雄！」
                if is_qmark($n) == wyvern_tower 200000
                        mpechoat $n $I向你打招呼時不自覺地表露出了焦急慌張的情緒。
                        mpechoat $n 也許你可以問問他又遇到了什麼麻煩？
                        mpmod_qmark $n wyvern_tower v1 = 1
                endif
		break
	endif
	if is_qmark($n) != wyvern_tower
  		mpadd_qmark $n wyvern_tower -1 0 0 0 0 1
  		look $n
  		say 你好啊.....
  		say 真是很抱歉，沒有什麼好東西可以招待你的。
  		sigh
  		mpechoat $n 你覺得 $I 似乎有滿腹的委屈想說出來....。
  		mpadd_qmark self wyvern_quest -1 0 0 0 0 1
	else
		if is_qmark($n) == wyvern_tower 100002
  			ponder
  			say 你們被魔法力場給震了出來？
  			say 那應該是羅帕斯所設下的結界，據我所知
  			say 只要找到雙子塔之鑰，就能破除力場了。
  			say 至於怎麼找到鑰匙(key)，我想酒吧的老闆應該比我清楚。
  			mpmod_qmark $n wyvern_tower v0 = 3
		else
  			mpecho $I 苦笑著：現在可是苦哈哈的日子啊....
		endif
	endif
~
>talk_prog lopas~
if is_qmark($n) == wyvern_tower 100000
  		mpecho $I 雙眼熱烈的注視著 $n
  		say 什麼？您願意幫我們打聽羅帕斯的下落嗎？
  		say 真是太好了，我族必定引頸期待您的好消息。
  		say 如果遇到了什麼問題，可以回來找我商量。
  		smile $n
	else
  		think
  		say 羅帕斯可是這一帶赫赫有名的大法師呢！
  		say 據說他跟龍族訂定了特殊契約，擁有操控龍的力量呢！
	endif
~
>talk_prog trouble~
if is_qmark($n) == wyvern_tower 200001
        mpechoat $n $I抬起頭，用盼望的眼神看著你。
        say 唉，本來是不好意思再麻煩英雄您的，不過您提起了，
        say 那我就告知您人馬村現在遇到的困境吧......
        sigh
        mpcallout 1 mpcall chief_talking1 $n
        mpcallout 2 mpcall chief_talking2 $n
        mpcallout 3 mpcall chief_talking3 $n
        mpcallout 3 mpmod_qmark $n wyvern_tower v1 = 2
endif
~
