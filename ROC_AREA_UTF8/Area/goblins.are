>defun_prog war_start~
rumor 小惡鬼戰役0.2測試版開始！
mpgoto 20078
mpadd_qmark self war_start -1 1 0 0 0 1
mpadd_qmark self war_process -1 1 0 0 0 1
mpforcer 20057 makedoor 0 洞穴 door 0 -1 20054
mpforcer 20054 makedoor 2 要塞門 door 0 -1 20057
mpforcer 20057 echo 大鐵門打開了！
mpforcer 20054 echo 大鐵門打開了！
mpforcer 20058 makedoor 0 洞穴 door 0 -1 20055
mpforcer 20055 makedoor 2 要塞門 door 0 -1 20058
mpforcer 20058 echo 大鐵門打開了！
mpforcer 20055 echo 大鐵門打開了！
mpforcer 20052 makedoor 0 斜坡 door 0 -1 20001
mpforcer 20001 makedoor 2 洞穴 door 0 -1 20052
mpforcer 20052 echo 洞口打開了！
mpforcer 20001 echo 洞口打開了！
mpforcer 20053 makedoor 0 斜坡 door 0 -1 20051
mpforcer 20051 makedoor 2 洞穴 door 0 -1 20053
mpforcer 20053 echo 洞口打開了！
mpforcer 20051 echo 洞口打開了！
	mpadd_qmark self plan_1 -1 1 0 0 0 1
	mpat 20063 mpmload 3521
	mpat captain-goblin-a mpadd_qmark captain-goblin-a plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-a mpadd_qmark vice-captain-goblin-a plan_1 -1 1 0 0 0 1
	mpat 20064 mpmload 3526
	mpat captain-goblin-b mpadd_qmark captain-goblin-b plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-b mpadd_qmark vice-captain-goblin-b plan_1 -1 1 0 0 0 1
	mpat 20060 mpmload 3531
	mpat captain-goblin-c mpadd_qmark captain-goblin-c plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-c mpadd_qmark vice-captain-goblin-c plan_1 -1 1 0 0 0 1
	mpat 20060 mpmload 3541
	mpat captain-goblin-e mpadd_qmark captain-goblin-e plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-e mpadd_qmark vice-captain-goblin-e plan_1 -1 1 0 0 0 1
	mpat 20061 mpmload 3536
	mpat captain-goblin-d mpadd_qmark captain-goblin-d plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-d mpadd_qmark vice-captain-goblin-d plan_1 -1 1 0 0 0 1
	mpat 20061 mpmload 3546
	mpat captain-goblin-f mpadd_qmark captain-goblin-f plan_1 -1 1 0 0 0 1
	mpat vice-captain-goblin-f mpadd_qmark vice-captain-goblin-f plan_1 -1 1 0 0 0 1
~
>tick_prog 100~
if is_qmark($i) == war_start
	mpdel_qmark self war_start
	mpforcer here echotoall [1;37m一道古老雄渾的號角聲響起......[0m
	mpcallout 1 mpcall second_attack $i
endif
if is_qmark($i) == war_process
	mpmod_qmark self war_process v0 + 1
endif
if is_qmark($i) == war_process 100003
	mpforcer 3001 echotoarea [1;35m【幻世戰報】史卡拉貝南城門緩緩地關了起來！[0m
	mpforcer 3296 modrvt v1 | 1
	mpforcer 3039 modrvt v0 | 1
	mpforcer 3296 setdoor 0 flags 119
	mpforcer 3039 setdoor 2 flags 119
	mpcall second_attack $i
	if is_qmark($i) == war_enable_second_attack
		mpcall second_attack $i
	endif
	break
endif
if is_qmark($i) == war_process 100004
	mpforcer here echotoall [1;37m一道古老雄渾的號角聲響起......[0m
	mpcallout 2 mpforcer here echotoall [1;37m小惡鬼大軍如同潮水般傾洩而出！[0m
	mpcallout 3 mpat 3255 mpmload 20040
	break
endif
if is_qmark($i) == war_process 100005
	yell 密登尼之子！我是飛翼同盟的首領，阿曼達(Amen-da)！
	mpcallout 1 yell 今日，我看到我的同胞，為了對抗暴君強權而組成的軍隊。
	mpcallout 2 yell 我們為了自由而戰，而我們終將自由！
	mpcallout 3 yell 若是我們為了自由而戰，你們願意為自由而死嗎！
	mpcallout 4 yell 回答我！你們會為了自由而死嗎！
	mpcallout 5 mpforcer here echotoarea 眾軍士熱血沸騰！
	break
endif
if is_qmark($i) == war_process 100006
	mpforcer here echotoarea 小惡鬼士兵吶喊著：「不，我們會逃跑，然後我們都能活下來。」
	mpcallout 1 yell 是呀，戰鬥，你可能會死；逃跑，你可以活下來......活一陣子！
	mpcallout 2 yell ......多年之後，當你病死在床前，回想這一天，
	mpcallout 3 yell 你們是否願意用餘下的時光，換取這一次機會，[1;31m就只有這麼一次機會！！[0m
	mpcallout 4 yell 回到這裡來，用刀劍告訴我們的敵人，他們或許可以奪走我們的生命，
	mpcallout 5 yell 但是他們絕對奪不走[1;31m我們的自由！[0m
	break
endif
if is_qmark($i) == war_process 100007
	shout 開戰！！！
	break
endif
if is_qmark($i) == war_process 100011
	mpforcer here echotoall [1;37m一道古老雄渾的號角聲響起......[0m
	break
endif
if is_qmark($i) == war_process 100012
	mpcall eagle_birth_a
	mpcall eagle_birth_b
	break
endif
if is_qmark($i) == war_process 100014
	mpforcer here echotoall [1;37m又一道古老雄渾的號角聲響起......[0m
	break
endif
if is_qmark($i) == war_process 100015
	mpcall conscripts_attack
	break
endif
~
>defun_prog second_attack~
mpat 20064 mpmload 3550
if is_qmark($i) == plan_1
	mpat captain-goblin-g mpadd_qmark captain-goblin-g plan_1 -1 1 0 0 0 1
	mpat battering-goblin-g mpadd_qmark battering-goblin-g plan_1 -1 1 0 0 0 1
	mpat ballista-a-goblin-g mpadd_qmark ballista-a-goblin-g plan_1 -1 1 0 0 0 1
	mpat ballista-b-goblin-g mpadd_qmark ballista-b-goblin-g plan_1 -1 1 0 0 0 1
endif
if is_qmark($i) == plan_2
	mpat captain-goblin-g mpadd_qmark captain-goblin-g plan_2 -1 1 0 0 0 1
	mpat battering-goblin-g mpadd_qmark battering-goblin-g plan_2 -1 1 0 0 0 1
	mpat ballista-a-goblin-g mpadd_qmark ballista-a-goblin-g plan_2 -1 1 0 0 0 1
	mpat ballista-b-goblin-g mpadd_qmark ballista-b-goblin-g plan_2 -1 1 0 0 0 1
endif
if is_qmark($i) == plan_3
	mpat captain-goblin-g mpadd_qmark captain-goblin-g plan_3 -1 1 0 0 0 1
	mpat battering-goblin-g mpadd_qmark battering-goblin-g plan_3 -1 1 0 0 0 1
	mpat ballista-a-goblin-g mpadd_qmark ballista-a-goblin-g plan_3 -1 1 0 0 0 1
