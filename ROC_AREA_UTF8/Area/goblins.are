>tick_prog 100~
if is_qmark($i) == fire_countdown
	break
endif
say 弓箭齊射！
break escalade
if mobcount(20018) == 0
    rumor 小惡鬼大軍已退，南門守軍也撤回駐地。
    mppurge self
endif
if insameroom(goblin)
    mpkill goblin
endif
~
>fight_prog 50~
circular
if is_qmark($i) == melee_count
	frenzy
else
	mpadd_qmark self melee_count -1 0 0 0 0 1
	say 拔刀！近戰準備！
	if rand(30)
		yell 敵人登城！準備接戰！
	endif
	break
endif
if hitprcnt($i) > 50
	if rand(50)
		yell 別放棄希望！援軍很快就來了！
	else
		yell 奮戰！史卡拉貝永存！
	endif
else
	if rand(50)
		yell 南方城牆快撐不下去了！請求支援！
	else
		yell 殺 殺 殺 殺 殺！
	endif
endif
~
>death_prog 100~
yell 啊～～～～～
mpasound 一聲慘叫從鄰近的城牆處傳來......
mpforcer 3001 echotoarea [1;35m【幻世戰報】南城牆戰區一支守衛部隊被殲滅！[0m
~
