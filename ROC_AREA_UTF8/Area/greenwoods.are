>greet_prog 100~
if is_qmark($n) == greenwoods_retired_kill 100001
	bow $n
	say 太好了，綠樹王國終於脫離危機了！
	say 親愛的勇者，您不但解救了綠樹王國，
	say 也為史卡拉貝大陸解除了一場可能的災禍！
	say 為了答謝你的英勇與抉擇，請您將這項
 	say 寶物收下吧。
 	if class($n) < 5
 		mpexp $n 1800
 	endif
 	mpexp $n 3600
	mpoload 13095 $n 1 target
	mpecho 將一面紅色絲巾交給$N。
	say 再見了，勇者，綠樹王國永遠歡迎你...
	mpdel_qmark $n greenwoods_retired_kill
	mpmod_qmark $n greenwoods_gharba_finished v0 = 4
	mplog $n finished greenwoods gharba quest 2
	if being(greenwoodsr)
		mpat greenwoodsr mppurge greenwoodsr
		mpecho $I高興地向 綠樹俠客(greenwoods ranger)點點頭，
		mpecho 綠樹俠客(greenwoods ranger) 笑容滿面地消失了。
	endif
	if being(greenwoodsr)
		mpat greenwoodsr mppurge greenwoodsr
	endif
	if being(greenwoodsr)
		mpat greenwoodsr mppurge greenwoodsr
	endif
	break
endif
if is_qmark($n) == green_imp_story
	mpdel_qmark $n green_imp_story
endif
if isnpc($n)
or is_qmark($n) == green_fairy_story
	break
endif
mpechoat $n $I 說著「年輕人，陪我聊聊天好嗎？(yes/no)」
mpadd_qmark $n green_fairy_story 24 0 0 0 0 1
~
>death_prog 100~
mpdis_magic self blindness
mpmod_all_qmark $n adv_book_1_main v0 | 4096
	mpat 5 cast inf
	say [1;32m蒼天曷有極，典型在夙昔；[m
 	say [1;32m風簷展書讀，古道照顏色。[m
	rumor [1;32m$I 被 $n 殺害了！[m
	if is_qmark($n) == greenwoods_gharba_assassin 100001
		mpmod_qmark $n greenwoods_gharba_assassin v0 = 2
	endif
if is_qmark($n) != snow_enemy
	if is_qmark($n) == snow_Porak02_quest 100004
		mpechoat $n 在一場激戰後，$I也被你刺殺了。
		mpechoat $n 忽然一陣勁風掠過，一支十字鏢插在你身旁的樹幹上。
		mpechoat $n 你看見十字鏢上附了張紙條。
		mpechoat $n 「替我將禮物送給銀蛇堡主吧，麻煩你了。」
		mpmod_qmark $n snow_Porak02_quest v0 = 5
	endif
endif
