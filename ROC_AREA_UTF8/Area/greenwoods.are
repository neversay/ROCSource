>bribe_prog 5000~
if is_qmark($i) <= green_elder_grave 100001
or is_qmark($i) <= green_elder_grave 200001
or is_qmark($i) <= green_elder_grave 300001
	ponder
	break
endif
if is_qmark($i) == green_elder_grave
	smile $n
	say 這是你的盜墓術捲軸。
	mpoload 13071 10
	give grave $n
	mpdel_qmark $i green_elder_grave
	mpjunk coins
else
	ponder
endif
~
