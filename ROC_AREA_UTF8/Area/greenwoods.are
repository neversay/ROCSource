R Fairy~
C 1
P 8
>tick_prog 100~
if inroom($i) == 5
	if is_qmark($i) != green_waiting
		mpechotoall 據聞綠樹王國的王子與奧夫卡帝國暗中交涉，欲除掉賈霸......
		if being(gharba)
			mpcallout 1 mpat gharba mpforce gharba yell 皇家衛隊聽令！將通敵叛國的妖精王子關進黑塔！
			mpcallout 2 mpat gharba mpforce gharba yell 以示效尤！
		endif
		mpcallout 3 rumor 綠樹王國發生動亂，妖精王子一黨被鷹派肅正！
		if insameroom(pixy-greenwoods)
			mppurge pixy-greenwoods
		endif
		if insameroom(pixy2-greenwoods)
			mppurge pixy2-greenwoods
		endif
		if mobcount(13080) > 0
			mpat pixy3-greenwoods mppurge pixy2-greenwoods
		endif
		mpcallout 4 mppurge self
	endif
	break
endif
	if area($i) != greenwoods
		if inroom($i) == 6
			break
		else
			no!
			say 賈霸的詛咒…！
			if insameroom(13053)
				mpecho $I 緊緊抓著小妖精公主(pixy lady)的手，和她一起消失在一陣光中。
				mptransfer pixy-greenwoods 13113
				mpat 13113 mpecho $I 與小妖精公主(pixy lady)在一陣光之後出現在這裡。
			else
				mpecho $I 消失在一陣光中。
				mpat 13113 mpecho $I 在一陣光之後出現在這裡。
