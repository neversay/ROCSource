#13141
地底牢房~
一個陰暗，污穢的牢房，潮濕的泥土上有許多小蟲子到處爬，一些人影頹喪
地蹲坐在靠牆的地上，北邊的鐵門牢牢的鎖著。
~
0 73745 0
D0
~
~
55 13103 13140
D1
~
~
0 -1 13142
D3
~
~
0 -1 13143
>room_enter 10 50~
if isnpc($n)
or roomvalue($0) == 1
	break
endif
if insameroom(scholara)
	if mobcount(13079) > 4
		modrvt v0 = 1
		modrvt t0 = 24
		break
	endif
	modrvt v0 = 1
	modrvt t0 = 24
	modrvt d0 r 6
	echo [1;37m外面突然傳來一陣悶響聲，接著鐵門突然被打開，
	echo 兩個綠樹俠客(greenwoods ranger)從外面躍了進來！[m
	mload 13079
	add_qmark ranger greenwoods_ranger_timer 96 0 0 0 1 0
	oload 13617 standard ranger target
	oload 13618 standard ranger target
	force ranger wear all
	force ranger follow scholar
	mload 13079
	add_qmark ranger greenwoods_ranger_timer 96 0 0 0 1 0
	oload 13617 standard ranger target
	oload 13618 standard ranger target
	force ranger wear all
	force ranger follow scholar
	echo 綠樹俠客(greenwoods ranger)對妖精學者(fairy scholar)說：
	echo 綠樹俠客(greenwoods ranger)說：老師您還好吧？我們來救你了！
	echo 妖精學者(fairy scholar)點了點頭
	echo 妖精學者(fairy scholar)說：啊...這麼危險，真是麻煩你們了！
	echo 妖精學者(fairy scholar)說：對了！
	echo 妖精學者(fairy scholar)突然轉頭問你：
	echo 妖精學者(fairy scholar)說：勇者，你願意和我們一起走嗎？雖然危險是免
	echo 妖精學者(fairy scholar)說：不了的，但這是離開這裡的唯一機會！(yes/no)
else
	modrvt v0 = 1
	modrvt t0 = 24
endif
~
>room_time 100~
if pcnum($) == 0
	break
endif
if roomvalue($0) == 1
	if roomtimer($0) == 7
		echo [1;37m外面突然傳來一陣喊叫：吃飯了！[m
		echo 監牢鐵門上的小洞被打開，幾塊臭麵包和一鍋餿水被丟進來。
		echo 小洞再度關上後你望了一下這些連狗也不吃的廚餘，
		echo 看來這些噁心的東西就是你下半輩子的美食了...
		oload 13101 1
		oload 13101 1
		oload 13102 1
		force 13142 echo [1;37m外面突然傳來一陣喊叫：吃飯了！[m
		force 13142 echo 監牢鐵門上的小洞被打開，一塊臭麵包被丟進來。
		force 13142 echo 小洞再度關上後你望了一下這些連狗也不吃的廚餘，
		force 13142 echo 看來這些噁心的東西就是你下半輩子的美食了...
		force 13142 oload 13101 1
		force 13143 echo [1;37m外面突然傳來一陣喊叫：吃飯了！[m
		force 13143 echo 監牢鐵門上的小洞被打開，一塊臭麵包被丟進來。
		force 13143 echo 小洞再度關上後你望了一下這些連狗也不吃的廚餘，
		force 13143 echo 看來這些噁心的東西就是你下半輩子的美食了...
		force 13143 oload 13101 1
	endif
endif
~
