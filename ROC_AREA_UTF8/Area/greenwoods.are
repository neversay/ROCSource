		yell 應 $n 的要求，第一階段任務重新開始！
		mpechoat $n 一陣聲音傳至你心中：請你重新拿一次試煉證明交給副隊長。
	endif
endif
if is_qmark($n) == greenwoods_gharba_finished 100001
	if rembch($n)
	or is_qmark($i) != greenwoods_gharba_solving
		yell 應 $n 的要求，第二階段任務重新開始！
		mpdel_qmark $n greenwoods_gharba_pixie
		mpdel_qmark self greenwoods_gharba_solving
