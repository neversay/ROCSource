>rand_prog 40~
if is_qmark($i) == greenwoods_vice_meeting 100001
	mpecho $I手裡拿著一疊卷宗，匆匆自外面走進會議室
	mpecho 皇家衛隊小隊長(royal lieutenant) 向 $I 瀟灑地敬個軍禮！
	mpecho 皇家衛隊小隊長(royal lieutenant) 向 $I 瀟灑地敬個軍禮！
	mpecho 傭兵(mercenary) 向 $I 瀟灑地敬個軍禮！
	mpecho 傭兵(mercenary) 向 $I 瀟灑地敬個軍禮！
	mpecho 皇家衛隊副隊長(vice-captain) 向 $I 瀟灑地敬個軍禮！
	mpmod_qmark self greenwoods_vice_meeting v0 + 1
	break
endif
if is_qmark($i) == greenwoods_vice_meeting 100002
	say 不必客氣，請坐，請坐...
	mpecho 眾人紛紛坐下來。
	mpecho $I將卷宗放在桌上，乾咳一聲後說： 今天召開這個會議
	say 主要是為了執行某項重要任務....
	mpecho $I環視了一下眾人...
	say 由於奧夫卡帝國對我國表現出極為藐視與不友善的態度，
	say 剛剛在最高軍事會議中已經決議，必須給奧夫卡帝國一點
	say 武力展示，否則綠樹王國的國民往後將會繼續受到羞辱。
	mpmod_qmark self greenwoods_vice_meeting v0 + 1
	break
endif
if is_qmark($i) == greenwoods_vice_meeting 100003
	say 我們認為只要將奧夫卡的帝國元帥黛安娜與守衛隊隊長
	say 賈桂琳擊敗，並將金龍珠奪回，便足以向各國宣示綠樹王國
 	say 的強盛的國力與維護國格的決心，往後他國便不會將綠樹的
 	say 國民視為二等公民了...
	say 各位都是綠樹的英雄，我希望有人能自告奮勇執行這項任務。
	mpecho 你願意自告奮勇(talk gharba let me do it)
	mpecho 還是選擇其他的任務？(talk gharba I am tired today)
 	mpdel_qmark self greenwoods_vice_meeting
	break
endif
if is_qmark($i) == greenwoods_vice_meeting 200001
	mpdel_qmark self greenwoods_vice_meeting
	if insameroom($b)
		mpecho $I看著$b很高興地說：啊，我們新來的
		mpecho 英雄$b搶著要這項任務哩！我看大家就別和他爭了。
		mpecho 眾人一陣懊惱嘆息聲...
		say 這雖然是一項困難的任務，但我相信您一定能圓滿達成。
		say 您拿到夜之使者(nightbringer)和黎明使者(dawnbringer)
		say 後請交給我，我們必有優渥的酬勞
		say 綠樹王國對於英雄們一向很慷慨！
		mpecho $I 向大家點個頭：那麼，今天的會議就到此結束，謝謝。
		mpecho $I 離開後，眾人也開始離去...
		mpecho 皇家衛隊副隊長(vice-captain) 拍拍你的肩膀：
		mpecho 皇家衛隊副隊長(vice-captain) 說 '加油，別讓大家失望！'
		mpecho 皇家衛隊副隊長(vice-captain) 大步向外走去。
		mpmod_qmark $b greenwoods_vice_meeting v1 = 1
		mpdef_rembch null-tar
		if insameroom(vice-captain)
			mpdel_qmark vice-captain greenwoods_vice_solving
			mptransfer vice-captain 13068
		endif
		mppurge allmob
		mpgoto 13087
	endif
	break
endif
if is_qmark($i) == greenwoods_gharba_pixie
	mpdel_qmark self greenwoods_gharba_pixie
	if being($b)
		tel $b 謝謝你，英雄，我想這樣就夠了，不必趕盡殺絕...
		tel $b 您現在可以回來了，我們有點小小的獎賞給您。
		mpat $b mpmod_qmark $b greenwoods_gharba_pixie v0 = 2
	endif
	break
endif
if is_qmark($i) == greenwoods_gharba_speech2
	mpdel_qmark self greenwoods_gharba_speech2
	if insameroom($b)
		mpecho $I 抿一抿嘴唇，似乎下定決心了
		say 是這樣的，其實綠樹王國國內一直有人想要推翻我，
	 	say 好奪取政權！那些鴿派份子因循苟且，從不會為下一
	 	say 代好好打算。如果他們安安份份也就罷了，但卻一直
	 	say 不斷對國民散播偏安的思想，結果杭州汴梁，一些
	 	say 國民真的慢慢就被污染。為了綠樹的未來，你能去把
