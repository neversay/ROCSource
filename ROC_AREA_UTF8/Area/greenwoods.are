		mpoload 13097
		mpdel_qmark $n greenwoods_seasoned_quest
		s
		e
		u
		w
		n
	else
		say 好，只要再給我捕風捉影密令，
		say 寶貝就是你的了！
	endif
endif
~
>give_prog 3035~
if is_qmark($n) >= greenwoods_seasoned_quest 100001
	mpjunk command
	mpmod_qmark $n greenwoods_seasoned_quest v0 | 4
	if is_qmark($n) == greenwoods_seasoned_quest 100007
		say 終於弄到手了，這下一定能升官...
		laugh
		mpecho $I好像忘了對你的承諾，一溜煙便跑掉了！
		mpoload 13097
		mpdel_qmark $n greenwoods_seasoned_quest
		s
		e
		u
		w
		n
	else
		say 好，只要再給我風火海的入會證明，
		say 寶貝就是你的了！
	endif
endif
~
