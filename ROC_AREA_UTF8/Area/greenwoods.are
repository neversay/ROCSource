>greet_prog 100~
if is_qmark($n) == greenwoods_gharba_pixie 100000
	smile $n
	say 太好了，您來了，有一項艱鉅任務必須麻煩你...
	pon
	say 我想你也知道在茵夢湖對岸有一群身材矮小，
	say 尚未進化完全的種族叫小妖精(pixie)。這些小妖怪
 	say 為了改良自己的品種，竟然千方百計引誘高尚的綠樹
 	say 國民，讓我們防不勝防。因此，最高軍事會議已經決
 	say 定給他們一點警告，希望他們能夠自重。這次就麻煩
 	say 您到湖的對岸收集六雙小妖精的翅膀吧。
	mpmod_qmark $n greenwoods_gharba_pixie v0 = 1
	addoil $n
endif
if is_qmark($n) == greenwoods_gharba_pixie 100002
	bow $n
	say 我謹代表綠樹的人民感謝您...
	say 您為綠樹王國貢獻良多，真不知如何回報。
	say 這張魔毯是我家傳的一項寶物，我就送給您吧！
	mpechoat $n $I 將一張隱形魔毯交給你.
	mpechoaround $n $I 將一張隱形魔毯交給 $n
	mpoload 13093 $n viclv target
	if class($n) < 5
		mpexp $n 1800
	endif
	mpexp $n 2600
	mpgreward exp $n -37 1000
	say 我想我應該可以完全信任您了，其實有一項秘密任務，
	say 我一直找不到合適的人去做...
	mpechoat $n $I 望著你思考著如何啟齒
	mpechoaround $n $I 望著 $n 思考著如何啟齒
	mpdel_qmark $n greenwoods_gharba_pixie
	mpadd_qmark self greenwoods_gharba_speech2 10 0 0 0 1 0
	mpmod_qmark $n greenwoods_gharba_finished v0 = 2
endif
if is_qmark($n) == greenwoods_gharba_assassin 100002
	clap $n
	say 太好了，這樣我就沒有後顧之憂了。
	hop
	say 為了答謝您，插在牆邊那柄巨劍就給你吧，
	say 只要您拿得動的話...
	mpoload 13094 $n viclv floor
	say 您真是綠樹的英雄，希望以後能繼續為綠樹奔走。
	bow $n
	say 再見了，勇者...
	mpdel_qmark self greenwoods_gharba_solving
	mpdel_qmark $n greenwoods_gharba_assassin
	mpmod_qmark $n greenwoods_gharba_finished v0 = 3
	mplog $n finished greenwoods gharba quest 1
	if class($n) < 5
		mpexp $n 1800
	endif
	mpexp $n 2400
	mpgreward exp $n -46 1200
endif
