		mpexp $n 1800
	endif
	mpexp $n 3300
	say 我想您也累了，請先下去休息吧，不過請別跑太遠，
	say 我們還有許多地方需要借重您...
	mpdel_qmark $n greenwoods_vice_meeting
	mpdef_rembch $n
	mpadd_qmark self greenwoods_gharba_solving 250 0 0 0 1 0
	mpadd_qmark self greenwoods_gharba_timer 10 0 0 0 1 0
	mpadd_qmark $n greenwoods_gharba_finished -1 1 0 0 0 1
	mpgreward exp $n -37 300
