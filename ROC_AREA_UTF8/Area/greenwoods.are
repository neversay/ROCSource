if is_qmark($n) != greenwoods_vice_quest
	mpjunk trial
	say 歡迎，歡迎！綠樹王國現在很需要能力出眾的人才。
 	say 能打敗那尊銅像就表示你的能力已經在水準之上！
	good $n
	say 既然你有這份誠心，我就先交給你一份簡單的任務吧。
	mpecho $I 低頭沉思
 	say 前幾天我有派人送一份密函給奧夫卡的元帥
 	say "冰山黛安娜"，過了那麼久我想她也應該討論出結論了
	say 你就走一趟問問她的回答吧。只要告訴她你是綠樹王國
	say 的密使(Envoy from Greenwoods)就行了。
	wave $n
	mpadd_qmark $n greenwoods_vice_quest -1 0 0 0 0 1
endif
