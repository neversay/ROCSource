	mpmod_qmark self greenwoods_gharba_assassin v0 = 1
	mpdis_magic self blindness
	mpgoto self
	hunt
	mpat 5 cast inf
	mpat 5 cast full
	mpecho [1;37m就在危急之時，從旁邊的樹蔭裡突然飛出三個人，把你的武器架開！[m
	mpmload 13071
	mpoload 13617 ranger 36 target
	mpoload 13618 ranger 36 target
	mpforce ranger wear all
	mpgroup self ranger 1 1
	mpmload 13071
	mpoload 13617 ranger 36 target
	mpoload 13618 ranger 36 target
	mpforce ranger wear all
	mpgroup self ranger 1 1
	mpforce ranger protect $i
	mpmload 13071
	mpoload 13617 ranger 36 target
	mpoload 13618 ranger 36 target
	mpforce ranger wear all
	mpgroup self ranger 1 1
	mpecho [1;32m$I 對綠樹俠客(greenwoods ranger)說「住手，住手，讓我跟他說幾句話...」
	mpecho $I 用惋惜的目光看著你：[m
	say 年輕人，我知道你是賈霸派來的殺手，但是你有
 	say 沒有想過，一個軍國主義的綠樹王國真的是世界
 	say 之福，真的是綠樹國民之福嗎？我勸你現在及時
 	say 回頭，幫我們除掉賈霸這個禍害吧！
	mpecho 你的內心一陣陣掙扎，一邊是對你信賴頗深，為了摯愛的國家而宵旰勤勞
 	mpecho 的賈霸與副隊長，另一邊又是傷懷國事，以大義之名諄諄開導你的慈祥老者；
	mpecho 聰明的你，到底會做什麼樣的選擇？
	mpecho [1;37m你可以繼續攻擊，或者選擇幫助$I
 	mpecho (talk retired I am regretful)[m
endif
