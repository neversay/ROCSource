if isaffected($i) & 1
	mpecho $I 施法治癒自己的失明
	mpdis_magic $i blindness
endif
if isaffected($i) & 16777216
	mpecho $I 喝下一罐藥水
	mpdis_magic $i 'seal magic'
endif
~
>death_prog 100~
mpdis_magic self blindness
mpmod_all_qmark $n adv_book_1_main v0 | 128
mplog killed by $n
if pcnum($) > 15
	mpgreward exp $n -37 100
	mpgreward exp $n -35 400
else
	if pcnum($) > 10
		mpgreward exp $n -37 300
		mpgreward exp $n -35 500
	else
		if pcnum($) > 5
			mpgreward exp $n -37 400
			mpgreward exp $n -35 500
		else
			mpgreward exp $n -37 500
			mpgreward exp $n -35 500
		endif
	endif
endif
mpgreward exp $n basic 500
~
