		mpdef_rembch $n
		mpechoat $n 一陣聲音傳至你心中：請您稍待， $I 會主動找你。
	endif
endif
if is_qmark($n) == greenwoods_gharba_finished 100002
	if is_qmark($i) == greenwoods_retired_kill
	or is_qmark($i) == greenwoods_gharba_solving
		break
	endif
	yell 應 $n 的要求，第三階段任務重新開始！
	mpdef_rembch $n
	mpdel_qmark $n greenwoods_gharba_assassin
	mpadd_qmark self greenwoods_gharba_speech2 10 0 0 0 1 0
	say 我想我應該可以完全信任您了，其實有一項秘密任務，
	say 我一直找不到合適的人去做...
	mpecho $I 望著 $n 思考著如何啟齒
endif
if is_qmark($n) >= greenwoods_gharba_finished 100003
	mpechoat $n 一陣聲音傳至你心中：這個任務只能解一次！
endif
~
>fight_prog 30~
if level($n) > 36
	c 'sun flash'
	c wind
endif
if is_qmark($i) != greenwoods_retired_kill
	if is_qmark($n) != greenwoods_retired_kill 100000
		if is_qmark($n) <= greenwoods_gharba_guard 100030
			if is_qmark($i) <= greenwoods_gharba_guard 100030
				mpdis_magic self blindness
				if mobcount(13072) < 8
					yell 來人啊！有刺客！
					mpmload 13072
					mpoload 13001 guard 36 target
					mpforce guard wear all
					mpgroup self guard 1 1
					mpforce guard resc gharba
					if is_qmark($n) == greenwoods_gharba_guard
						mpmod_qmark $n greenwoods_gharba_guard v0 + 1
					else
						mpadd_qmark $n greenwoods_gharba_guard 300 1 0 0 0 1
					endif
					if is_qmark($i) == greenwoods_gharba_guard
						mpmod_qmark self greenwoods_gharba_guard v0 + 1
					else
						mpadd_qmark self greenwoods_gharba_guard 300 1 0 0 0 1
					endif
				endif
			endif
		else
			mpdis_magic self all
			cast 'sun flash'
			skilldrv multihit $n
			skilldrv speedhit $n
			skilldrv heavyhit $n
			cast 'mass heal'
		endif
	endif
endif
if rand(30)
	mpdis_magic self all
	cast 'sun flash'
	skilldrv multihit $n
	skilldrv speedhit $n
	skilldrv heavyhit $n
else
	cast wind
endif
~
