>talk_prog p I am regretful~
if is_qmark($i) == greenwoods_gharba_assassin 100001
	if is_qmark($n) == greenwoods_gharba_assassin 100001
		nod $n
		mpecho $I 露出欣慰的眼神說：迷途知返，殊為難得...
		say 既然這樣，就請他們助你一臂之力吧。
		mpecho 綠樹俠客(greenwoods ranger) 們加入你的隊伍
		mppurge greenwoodsr
		mpforce greenwoodsr follow $n
		mpforce 2.greenwoodsr follow $n
		mpgroup $n greenwoodsr 1 1
		mpgroup $n 2.greenwoodsr 1 1
		say 各位勇士請小心，綠樹的存亡就在此一戰了！
		bow $n
		mpdel_qmark self greenwoods_gharba_assassin
		mpdel_qmark $n greenwoods_gharba_assassin
		mpadd_qmark $n greenwoods_retired_kill -1 0 0 0 0 1
		if mobcount(13058) == 0
			mpat 13087 mpmload 13058
		else
			mpat 5 cast 'detect inv'
			mpat 5 cast 'detect hid'
		endif
		mpat 5 cast inf
		mpat gharba mpadd_qmark gharba greenwoods_retired_kill -1 0 0 0 1 0
	endif
endif
