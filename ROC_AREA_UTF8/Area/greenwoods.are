if insameroom($b)
	if is_qmark($i) == greenwoods_vice_speech 100001
		say 這樣吧，你跑這一趟大概也累了，就先在
		say 綠樹王國晃一晃，補足精神。
		mpecho $I 拿出一袋金幣
		mpgold $b 20000
		say 這些金幣你就拿去花吧，別客氣，綠樹王國
		say 一向很尊敬英雄的！
		say 對了，如果有事我會派人去找你，請暫時先
		say 不要跑太遠，以免聯絡不到你....
		wave $b
		mpdel_qmark self greenwoods_vice_speech
		mpadd_qmark self greenwoods_vice_solving 24 0 0 0 1 0
		mpadd_qmark self greenwoods_vice_timer 6 0 0 0 1 0
		mpgreward exp $n -37 100
	endif
	if is_qmark($i) == greenwoods_vice_speech 100000
		mpecho 過了一會，$I總算慢慢平靜下來，臉色也緩和多了。
		say 國家弱小，到處都會被人欺負....
		sigh
		say 所以綠樹的國民都應當發奮圖強，為下一代
		say 建立更好的生活環境，讓他們即使到外地也
 		say 能昂首闊步，頂天立地！
		think
		say 至於這件事我會再向賈霸大人報告，由大人
 		say 他決定我們對奧夫卡帝國的應對態度，你呢...
		mpecho $I 望了$b一眼，似乎在考慮下一步....
		mpmod_qmark self greenwoods_vice_speech v0 + 1
	endif
endif
