	if is_qmark($n) != greenwoods_santa_timer
		if mobcount(13078) < 3
			smile $n
			say 你好，親愛的朋友，聖塔麻尼卡兄弟會做你的後盾！
			mpmload 13078
			mpgroup $n monica 1 1
			mpadd_qmark $n greenwoods_santa_timer 100 0 0 0 0 1
			mpadd_qmark monica greenwoods_santa_timer 100 0 0 0 1 0
