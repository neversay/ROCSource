#13053
pixy-greenwoods pixy lady~
小妖精公主(pixy lady)~
一位亮麗的小妖精公主(pixy lady)默默望著你。
~
當你看著她時，她的臉蛋都羞紅起來。
~
67108867 8364 800 S
39 0 0 0d0+0 0d0+0
-1 0
0 8 2
R Pixie~
C 2
P 8
>greet_prog 100~
if isnpc($n)
or is_qmark($i) == green_lady_light
	break
endif
if inroom($i) == 13105
	mpechoat $n $I 紅著臉對你說：您好，很高興認識您，不過，
	mpechoat $n 您是怎麼上來的呢？
	mpadd_qmark self green_lady_light 150 0 0 0 1 0
endif
~
>talk_prog ghen~
if is_qmark($i) == green_lady_light 100000
	say 啊，原來是小娟....真是感激你們....
	blu
	say 我知道王子現在被賈霸關在黑塔頂上，雖然非常兇險，
	say 但麻煩你們帶我一起去救他好嗎？(yes/no)
	mpmod_qmark self green_lady_light v0 = 1
endif
~
>talk_prog yes~
if is_qmark($i) == green_lady_light 100001
	say 真不知如何謝謝你們...
	say 我把我的綠樹之光送給你們好了，聊表謝意....
	mpgroup $n lady 0 1
	mpdef_rembch $n
	if level($n) < 11
		mpoload 13089 10
	else
		mpoload 13089 $n viclv
	endif
	give light $n
	say 小娟應該有麻煩你們帶芒果吧？請交給我施法，謝謝。
	mpmod_qmark self green_lady_light v0 = 2
endif
~
>give_prog 13021~
if is_qmark($i) == green_lady_light 100002
	mpecho 公主喃喃施法，在一陣強光後，牆上突然出現一扇藍色的門。
	mpoload 13104 10
	unlock s
	open s
	mpjunk key
	mpjunk mango
	nod
	say 好了，我們走吧。
	mpmod_qmark self green_lady_light v0 = 3
	mpgreward exp $n -37 400
	mpgreward exp $n -35 200
endif
~
>tick_prog 30~
if rand(33)
	if nplayer($) == 0
		mpgoto 13105
	endif
endif
if inroom($i) == 13105
or isfight($i)
	break
endif
if is_qmark($i) != green_lady_light
or notbeing($b)
	mppurge self
endif
