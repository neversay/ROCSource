#13073
frowned fairy~
妖精青年(frowned fairy)~
一位眉頭深鎖的妖精青年(frowned fairy)心事重重，動不動就撞倒東西。
~
他看起來心情很糟(low mood)，好像有天大的事情不能解決。
~
195 8704 500 S
32 0 0 0d0+0 0d0+0
0 0
0 8 1
R Fairy~
P 12
>talk_prog topic~
if is_qmark($n) == greenwoods_frowned_quest
		say 別煩我！
	else
 		mpecho $I無力地看了你一眼：
		say 對不起，我現在心情不好(low mood)，
 	 	say 改天再和你聊好嗎？
	endif
~
>talk_prog p low mood~
if is_qmark($n) == greenwoods_frowned_quest
		mpechoat $n 這個 quest 只能解一次！
	else
		sigh
		say 關關鴭鳩，在河之洲，
 	 	say 窈窕淑女，君子好逑。
		blush
		say 我很喜歡美女紫羅蘭(lady fairy violet)，
		say 想送她禮物，卻不知道該送什麼。
 		say 真不知道誰能幫我打聽喲...
	endif
~
>talk_prog chrysanthemum~
if is_qmark($i) == greenwoods_frowned_quest
		mpechoat $n 一陣聲音傳至你的心中：
		mpechoat $n 有人在解這個quest，請稍後再來。
		break
	endif 
	if is_qmark($n) == greenwoods_frowned_quest
		mpechoat $n 這個 quest 只能解一次！
		break
	endif
	say 真的！她喜歡菊花？太好了！
	hop
	say 不過，我要上哪找菊花呢？
	pon
	mpecho $I抬起頭看你：
	say 不好意思，可是，你有辦法幫我找到菊花嗎？
	mpadd_qmark $n greenwoods_frowned_quest -1 0 0 0 0 1
~
>give_prog 13608~
if is_qmark($n) == greenwoods_frowned_quest 100000
		mpjunk chrysanthemum
		bow $n
		say 太感謝你了，請你帶我去找紫羅蘭吧。
		mpgroup $n self 1 1
		mpmod_qmark $n greenwoods_frowned_quest v0 = 1
		mpadd_qmark self greenwoods_frowned_quest 50 0 0 0 1 0
		mpdef_rembch $n
	else
		mpecho $I以奇怪的眼神打量$n
		drop chrysanthemnm
 	endif
~
>talk_prog restart~
if is_qmark($n) < greenwoods_frowned_quest 100005
		say 好的，quest重新開始。
		mpdel_qmark $n greenwoods_frowned_quest
	endif
~
>entry_prog 100~
if is_qmark($i) == greenwoods_frowned_quest 100000
if insameroom($b)
	if insameroom(violet)
		mpecho [1;32m$I紅著臉把菊花(chrysanthemum)送給[m
 		mpecho [1;32m妖精美女紫羅蘭(fairy lady violet) [m
		say [1;32m這束花送妳...我，我...那個...我想... [m
		mpecho [1;32m$I全身都羞紅了起來！[m
		mpecho 妖精美女紫羅蘭(fairy lady violet)無辜地看著$I
		mpecho [1;32m$I竟然慌張地飛掉了！[m
		mpforce violet pon
		mpforce violet say 好奇怪的人啊？不過這真的是菊花耶！
		mpforce violet say 我該說聲謝謝的...
		mpecho 妖精美女紫羅蘭(fairy lady violet)望著$I逃走的
   		mpecho 方向沈思
		mpmod_qmark $b greenwoods_frowned_quest v0 = 2
		mpgoto 13081
	endif
endif
endif
~
>rand_prog 40~
if is_qmark($i) == greenwoods_frowned_speech
	if insameroom($b)
		mpecho $I 突然眼睛發亮，好像想到什麼！
		say 呃，還是，我想到一個主意...
		say 可不可以麻煩你扮演翦徑的強盜，
		say 然後由我去解救她....
		mpforce $b faint
		blush
		say 我知道這個要求很過分，但是這個方法
 		say 一定能使紫羅蘭對我有很深的印象...
 		mpecho $I 用哀求的眼光看著你
		say 拜託了，我一生的幸福就在你手上！
		mpmod_qmark $b greenwoods_frowned_quest v0 = 3
		mpdel_qmark self greenwoods_frowned_speech
		mpdef_rembch null-tar
		fol self
	endif
endif
~
>greet_prog 100~
if is_qmark($n) == greenwoods_frowned_quest 100002
	sorry $n
	say 真的對不起，可是，
 	say 我一看到她就緊張得說不出話來...
	pon
	mpadd_qmark self greenwoods_frowned_speech 5 0 0 0 1 0
endif
if is_qmark($n) == greenwoods_frowned_quest 100004
	mpechoat $n 你看到贏得美人心的$I得意洋洋地展示魔法，
	mpechoat $n $I對你眨眨眼後偷偷塞一個東西到你手裡。
	mpoload 13099 $n viclv target
	if class($n) < 5
		mpexp $n 400
	endif
	mpexp $n 800
	mpecho $I和妖精美女紫羅蘭(fairy lady violet)一起飛走了！
	mpmod_qmark $n greenwoods_frowned_quest v0 = 5
	mppurge violet
	mppurge self
endif
~
