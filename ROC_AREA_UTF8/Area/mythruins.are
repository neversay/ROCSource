E
elvish bone scepter~
一根由精靈骨頭製成的纖細節杖，充滿不輸龍骨的魔力。仔細觀察(observed)發現
杖中沉睡著不具惡意的靈體，她應該是骨頭原本的主人吧。與杖中的居民建立良好
關係才能發揮完整性能，也許...用吃收買(instill)會是個不錯的方法。存在感情
基礎的前題下，在戰鬥中把她喚醒(arouse)就能發揮意想不到的戰力了。
~
M 0 從杖上散發出毒氣包覆你的全身。~
M 1 毒氣退散回杖中。~
X bone~
>obj_command observed default~
if objval3($o) == 0
	echoat $n $O似乎有靈魂存在其中。
else
	if objval3($o) == 1
		echoat $n $O[1;30m存在著極弱的靈魂[0m。
	else
		if objval3($o) == 2
			echoat $n $O[37m存在著弱小的靈魂[0m。
		else
			if objval3($o) == 3
				echoat $n $O[1;37m中存在著靈魂[0m。
			else
				if objval3($o) == 4
					echoat $n $O[1;36m存在著強烈的靈魂[0m。
				else
					if objval3($o) == 5
						echoat $n $O[1;36m中的靈魂劇烈地躁動著[0m。
					endif
				endif
			endif
		endif
	endif
endif
~
>obj_command instill default~
if learned($n) < 70 1
	echoat $n 你不具備灌輸能量到物品中的知識。
	break
endif
if skillexp($n) < 70 3
	echoat $n 你的物品充能技術還不足以灌輸靈魂到這把節杖中。
	break
endif
if objval3($o) < 5
	echoat $n 你將部分的靈魂輸入到結杖中，供養杖中的靈魂。
	oforcer here rpexp $n -2000
	oset self v3 + 1
	oforcer here stun $n 10
	oforcer here callout 1 echoat $n 精靈骨節杖(Scepter of Elvish Bone)發出點點的光茫。
else
	echoat $n $O中的靈魂已經太強大了，再養下去會衝破節杖。
endif
~
>obj_command arouse default~
if is_equ_obj($n) == 21354
	if isfight($n)
		if objval3($o) == 0
			echoat $n 杖中的靈魂強度不足以作為你的盾牌。
		else
			if mpnum($n) >= 500
				echoat $n 你將魔力灌輸到節杖中，喚醒沉睡中的少女靈魂作為護盾！
				oforcer here add_affect $n 'mystic armor' 1130 1 58 3000 137438953472
				oset self v3 - 1
			else
				echoat $n 你魔力不足以喚醒沉睡在杖中的靈魂。
			endif
		endif
	else
		echoat $n 平常叫她起來想幹啥？
		break
	endif
else
	echoat $n 你要握著它才能喚醒節杖的力量。
endif
~
|

