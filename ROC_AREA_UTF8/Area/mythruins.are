#21495
在湍急的黑色河流中~
你一個不慎踩空了腳步，跌進了河水之中，這條河流相當湍急，你完全束手無
策，只能順著河水漂流，靜靜等待時機....當你靜下心來之後，你赫然發現原來河
水的黑色並非因為光線昏暗，而是混雜著大量血液的緣故，空氣中也因此發散著令
人不適的氣味。
~
0 1|4|1024|8192|65536|524288|1048576 2
>room_enter 127 100~
if is_qmark($n) < myth_falldown 100007
	if rand(40)
		mod_qmark $n myth_falldown v0 + 1
		callout 4 transfer $n 21498
		callout 4 echoat $n 湍急的河水讓你束手無策，只能隨波逐流....
	else
		if rand(40)
			mod_qmark $n myth_falldown v0 + 1
			callout 4 transfer $n 21495
			callout 4 echoat $n 湍急的河水讓你束手無策，只能隨波逐流....
		else
			if rand(40)
				mod_qmark $n myth_falldown v0 + 1
				callout 4 transfer $n 21496
				callout 4 echoat $n 湍急的河水讓你束手無策，只能隨波逐流....
			else
				if rand(50)
					del_qmark $n myth_falldown
					callout 2 at $n force $n look
					callout 2 transfer $n 21455
					callout 2 echoaround $n $N被河水帶回岸上。
					callout 3 at $n echoat $n 你被河水帶到一個未知的地方...
				else
					del_qmark $n myth_falldown
					callout 2 at $n force $n look
					callout 2 transfer $n 21462
					callout 2 echoaround $n $N被河水帶回岸上。
					callout 3 at $n echoat $n 你被河水帶到一個未知的地方...
				endif
			endif
		endif
	endif
else
	if rand(50)
		del_qmark $n myth_falldown
		callout 2 at $n force $n look
		callout 2 transfer $n 21455
		callout 2 echoaround $n $N被河水帶回岸上。
		callout 3 at $n echoat $n 你被河水帶到一個未知的地方...
	else
		del_qmark $n myth_falldown
		callout 2 at $n force $n look
		callout 2 transfer $n 21462
		callout 2 echoaround $n $N被河水帶回岸上。
		callout 3 at $n echoat $n 你被河水帶到一個未知的地方...
	endif
endif
~
>room_time 100~
if ispc($r)
	if rand(20)
		modhmv $r 03.2 4 0
		modhmv $r 13.2 4 0
		modhmv $r 23.2 4 0
		echoat $r 這濕黏的河水似乎掠奪著你的能量....
	endif
endif
~
|
S
