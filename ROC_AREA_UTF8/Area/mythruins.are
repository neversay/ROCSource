>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 1 0
~
>talk_prog topic~
if is_qmark($n) != mythruin_imp_things 100001
		mpcallout 1 tell $n 嘻嘻嘻，你看得見我(imp)
		mpcallout 2 giggle $n
		mpcallout 3 giggle self
	else
		break
	endif
endif
~
>talk_prog imp~
if is_qmark($n) != mythruin_imp_things 100001
		tell $n 噢，小鬼知道很多事情(things)
		mpadd_qmark $n mythruin_imp_things -1 0 0 0 1 0
	else
		break
	endif
endif
~
>talk_prog things~
if is_qmark($n) == mythruin_imp_things 100001
	tell $n 小鬼不告訴你!
endif
if is_qmark($n) == mythruin_imp_things 100000
	if rand(50)
		if rand(50)
			if rand(50)
				if rand(50)
					tell $n 例如，如果著火的時候就要澆水。
				else
					tell $n 例如，太暗的時候就要把燈打亮。
				endif
			else
				if rand(50)
					tell $n 例如，植物其實都喜歡風吹過沙沙的聲音。
				else
					tell $n 例如，黏黏的東西就不可以隨便亂揮亂砍，但一次戳很多洞的話...
				endif
			endif
		else
			if rand(50)
				if rand(50)
					tell $n 例如，小鬼喜歡搭船去探險！
				else
					tell $n 例如，這裡能夠重見天日，要跟很多人說謝謝。
				endif
			else
				if rand(50)
					tell $n 例如，在這裡走路要小心!!遇到危險記得大叫!!!!
				else
					tell $n 例如，這裡還有一些道路還沒有被「它」開啟....
				endif
			endif
		endif
	else
		if rand(50)
			if rand(50)
				if rand(50)
					tell $n 例如，這裡有些生物是單純的好戰份子，有些不是。
				else
					tell $n 例如，小鬼會飛，就不怕在經過水邊時弄濕身體，也不怕掉下去!!
				endif
			else
				if rand(50)
					tell $n 例如，這裡有些生物其實需要你的協助，才能獲得真正的平靜...
				else
					tell $n 例如，小鬼在這裡的兩個秘密基地都可以把門關起來慢慢想事情。
				endif
			endif
		else
			if rand(50)
				if rand(50)
					tell $n 例如，還有很多事情小鬼還沒想出來...
				else
					tell $n 例如，小鬼喜歡跟大家當好朋友～
				endif
			else
				if rand(50)
					tell $n 例如，小鬼跑得很快!!
				else
					tell $n 例如，想睡覺的時候，小鬼喜歡聽催眠曲。
				endif
			endif
		endif
	endif
endif
if is_qmark($n) != mythruin_imp_things
	tell $n 咦，你看得到小鬼(imp)嗎?
endif
~
>fight_prog 100~
