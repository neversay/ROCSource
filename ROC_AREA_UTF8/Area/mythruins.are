>tick_prog 100~
if is_qmark($i) == camp_cap_fight 300001
	if notbeing($b)
		mpecho $I戰後突然吐血身亡。
		mppurge self
		mpforcer here modrvt v0 = 0
	endif
	if is_qmark($i) == camp_cap_fight
		mpmod_qmark self camp_cap_fight v0 + 1
	endif
	if is_qmark($i) == camp_cap_fight 100010
		mpecho $I戰後突然吐血身亡。
		mppurge self
		mpforcer here modrvt v0 = 0
	endif
endif
~
>rand_prog 100~
if being($b)
	if inroom($i) == 21272
		if rmobcount(21269) != 0
		or rmobcount(21270) != 0
		else
			if is_qmark($i) == camp_cap_fight 300000
				if rmobcount(21266) == 1
				or rmobcount(21267) == 1
					mpecho $I指揮參與戰鬥的騎士返回工作崗位。
					if rmobcount(21266) == 1
						mppurge order-ship-1
					endif
					if rmobcount(21267) == 1
						mppurge order-ship-2
					endif
				endif
				mpcallout 1 tell $b 看來是解決了，冒險者你如何？有受傷(hurt)嗎？
				mpmod_qmark self camp_cap_fight v1 = 1
				mpmod_qmark self camp_cap_fight v2 = 1
				mpforcer here add_affect $i heal 1130 30 17 80 4096
				mpforcer here modrvt v0 = 0
			endif
		endif
	endif
	if inroom($i) == 21274
		if rmobcount(21269) != 0
		or rmobcount(21270) != 0
		else
			if is_qmark($i) == camp_cap_fight 300000
				if rmobcount(21266) == 1
					mpecho $I指揮參與戰鬥的騎士返回工作崗位。
					mppurge order-ship-1
				endif
				mpcallout 1 tell $b 冒險者，你的傷勢(hurt)還好吧？
				mpmod_qmark self camp_cap_fight v1 = 1
				mpmod_qmark self camp_cap_fight v2 = 1
				mpforcer here add_affect $i heal 1130 30 17 80 4096
				mpforcer here modrvt v0 = 0
			endif
		endif
	endif
endif
~
>talk_prog topic~
if being($b)
	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($n) == myth_templar_SP_II_A 100000
	if inroom($i) == 21270
		if is_qmark($n) == myth_templar_SP_II_A 300001
			mpmod_qmark $n myth_templar_SP_II_A v0 = 1
			tell $n 我們的契約在上次就結束了，你跑來這裡幹嘛？(for fun)
		endif
	endif
	if inroom($i) == 21272
		if is_qmark($n) == myth_templar_SP_II_A 300002
			mpmod_qmark $n myth_templar_SP_II_A v0 = 1
			tell $n 我們的契約在上次就結束了，你跑來這裡幹嘛？(for fun)
		endif
		if is_qmark($n) == myth_templar_SP_II_A 300003
			mpmod_qmark $n myth_templar_SP_II_A v0 = 1
			mpmod_qmark $n myth_templar_SP_II_A v1 = 1
			tell $n 我們的契約在上次就結束了，你跑來這裡幹嘛？(for fun)
		endif
	endif
	if inroom($i) == 21274
		if is_qmark($n) == myth_templar_SP_II_A 300004
			mpmod_qmark $n myth_templar_SP_II_A v0 = 1
			tell $n 這裡很危險，你來這裡作什麼？(for fun)
		endif
		if is_qmark($n) == myth_templar_SP_II_A 300005
			mpmod_qmark $n myth_templar_SP_II_A v0 = 1
			mpmod_qmark $n myth_templar_SP_II_A v1 = 1
			tell $n 這裡很危險，你來這裡作什麼？(for fun)
		endif
	endif
	break
endif
if inroom($i) == 21270
	if rand(30)
		say 看來船能比預期更早造好
		say 剩下的問題是，這張地圖該怎麼用
	endif
endif
if inroom($i) == 21272
	if rand(30)
		say 進度還算順利，惡魔的攻勢沒想像中的強
		say 照這樣子下去，任務或許沒問題
	endif
endif
if inroom($i) == 21274
	if rand(30)
		say 可惡，人手嚴重不足，進度不如預期
		say 營地面對那麼強的攻勢也撐不了多久
		say 現在也只能祈禱了...
	endif
endif
~
>talk_prog p for fun~
if being($b)
	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($n) == myth_templar_SP_II_A 100001
	if inroom($i) == 21270
		if is_qmark($n) == myth_templar_SP_II_A 300001
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 7 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_A v0 = 3
			tell $n 來找樂子？噗哈哈！！！
			tell $n 不愧是閒閒沒事幹的冒險者！！
			mpcallout 1 tell $n 擅闖營地會受什麼懲罰，你作好準備了吧？
			mpcallout 1 tell $n 但是你沒看到我們在忙嗎？
			mpcallout 2 stare $n
			mpcallout 4 tell $n 我感謝你都來不及了，怎麼會懲處你。
			mpcallout 4 tell $n 這次任務能進行那麼順利，你也有一半的功勞。
			mpcallout 4 tell $n 哈，開玩笑的！
			mpcallout 4 laugh $n
			mpcallout 5 tell $n 我也要繼續趕工了。
			mpcallout 5 tell $n 在遺跡內會發生什麼事一切難講，還是要稍微認真些。
			mpcallout 5 tell $n 好啦，玩笑話就到這裡結束吧。
			mpcallout 6 mpoload 21267 $n 38 target
			mpcallout 6 mpechoat $n $I臨別前把一柄鳶盾塞給你。
			mpcallout 6 tell $n 另外我有個東西要送你，當作是報答你的恩情吧。
			mpcallout 7 mpdef_rembch null-tar
			mpcallout 7 mpat $n mpmod_qmark $n myth_templar_SP_II_A v2 = 6
			mpcallout 7 wave $n
			mpcallout 7 tell $n 最後建議你面對未知要戒慎恐懼，否則怎麼死的都不知道。
		endif
	endif
	if inroom($i) == 21272
		if is_qmark($n) == myth_templar_SP_II_A 300002
		or is_qmark($n) == myth_templar_SP_II_A 300003
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 8 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_A v0 = 2
			tell $n 蛤？找樂子？冒險者，你是不是來錯地方啦？
			tell $n 沒看到我們在忙嗎？不要影響我們作業！
			mpcallout 2 mpforce order-ship-1 say 報告，騎士長！有惡魔從東邊海面靠近！
			mpcallout 2 mpmload 21266
			mpcallout 2 mpmload 21267
			mpcallout 3 say 我知道了，大家作好迎戰準備！
			mpcallout 4 mpgroup $n self 0
			mpcallout 4 mpforce order-ship-2 mpgroup $n self 0
			mpcallout 4 mpforce order-ship-1 mpgroup $n self 0
			mpcallout 4 tell $n 冒險者你也來幫個忙吧！
			mpcallout 5 say 該死的惡魔，放馬過來吧！
			mpcallout 6 mpecho 幾隻惡魔從海面上過來。
			mpcallout 6 mpadd_qmark self camp_cap_fight -1 0 0 0 0 1
			if is_qmark($n) myth_templar_SP_II_A 200001
				mpcallout 6 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 2
				mpcallout 6 strong_mob
			else
				mpcallout 6 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 2
				mpcallout 6 normal_mob
			endif
		endif
	endif
	if inroom($i) == 21274
		if is_qmark($n) == myth_templar_SP_II_A 300004
		or is_qmark($n) == myth_templar_SP_II_A 300005
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 6 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_A v0 = 2
			tell $n 你腦袋沒問題吧？
			tell $n 想找樂子你來錯地方了。
			mpcallout 1 mpforce order-ship-1 say 報...報告..！有大量惡魔從東邊海面靠近！
			mpcallout 1 mpmload 21266
			mpcallout 1 tell $n 閒雜人等快點離開，再不走就...
			mpcallout 2 mpecho $I轉頭看了一下海面。
			mpcallout 2 say 嘖...！這個數量...
			mpcallout 3 mpgroup $n self 0
			mpcallout 3 mpforce order-ship-1 mpgroup $n self 0
			mpcallout 3 tell $n 一起擊退惡魔吧。
			mpcallout 3 tell $n 這下你也不能安然脫身了。
			mpcallout 4 say 死守船隻！
			mpcallout 5 mpecho 大量惡魔從海面上過來。
			mpcallout 5 mpadd_qmark self camp_cap_fight -1 0 0 0 0 1
			if is_qmark($n) myth_templar_SP_II_A 200001
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 2
				mpcallout 5 strong_mob
			else
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 2
				mpcallout 5 normal_mob
			endif
		endif
	endif
endif
~
>talk_prog p hurt~
if rembch($n)
	if inroom($i) == 21272
		if is_qmark($i) == camp_cap_fight 200001
			if is_qmark($n) == myth_templar_SP_II_A 100002
				mpdel_qmark self camp_cap_fight
				tell $n 哼，還能說話看來沒什麼事。
				mpcallout 1 tell $n 這次突如其來的攻擊幸虧有你幫忙，傷亡才能降到最小。
				mpcallout 2 tell $n 這個東西就當成謝禮送你吧。
				mpcallout 3 mpechoat $n $I塞給你一件裝備。
				if is_qmark($n) == myth_templar_SP_II_A 300002
					mpcallout 3 mpoload 21268 $n 38 target
				endif
				if is_qmark($n) == myth_templar_SP_II_A 300003
					mpcallout 3 mpoload 21269 $n 38 target
				endif
				mpcallout 4 tell $n 這東西受過教會祝福，擁有抵抗邪惡的力量。
				mpcallout 5 mppurge self
				mpcallout 5 mpmload 21265
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_A v2 = 6
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 3
				mpcallout 5 mpforcer here modrvt v0 = 0
				mpcallout 5 tell $n 好了，沒事就快點離開，不要影響我們作業！
			endif
		endif
	endif
	if inroom($i) == 21274
		if is_qmark($i) == camp_cap_fight 200001
			if is_qmark($n) == myth_templar_SP_II_A 100002
				mpdel_qmark self camp_cap_fight
				tell $n 哼，看來冒險者就只有身體強壯。
				mpcallout 1 tell $n 下一次可沒人能保證你的安全。
				mpcallout 1 tell $n 勸你在下波襲擊前快點離開。
				mpcallout 1 tell $n 現在你也看到這裡的情況了。
				mpcallout 2 mpechoat $n $I塞給你一個旗幟。
				mpcallout 2 mpoload 21270 $n 38 target
				mpcallout 3 tell $n 離開遺跡的路上多少能庇護你不受邪惡的力量影響。
				mpcallout 3 tell $n 這面旗幟受過教會加持。
				mpcallout 4 mppurge self
				mpcallout 4 mpmload 21265
				mpcallout 4 mpat $n mpmod_qmark $n myth_templar_SP_II_A v2 = 6
				mpcallout 4 mpat $n mpmod_qmark $n myth_templar_SP_II_A v1 = 3
				mpcallout 4 mpforcer here modrvt v0 = 0
				mpcallout 4 tell $n 趁著下次襲擊前離開吧，冒險者。
			endif
		endif
	endif
endif
~
>fight_prog 30~
if rand(60)
	c heal
	mpnowait
else
	c 'double heal'
	mpnowait
endif
~
>fight_prog 20~
if rand(40)
	c 4 'dispel evil'
else
	if rand(50)
		flaming
		mpnowait
	else
		sun
		mpnowait
	endif
endif
~
>death_prog 100~
if being($b)
	mpat $b mpmod_qmark $b myth_templar_SP_II_A v2 = 6
	if insameroom($b)
		if is_qmark($i) == camp_cap_fight 200000
			say 看來情況不妙，冒險者你們先走！
			mpecho $I用最後的力量把大部分人傳送到安全的地方。
			mpforcer here transfergroup $b 21450
		endif
	endif
endif
mpforcer here modrvt v0 = 0
if rand(50)
	say 到此為止了嗎....
else
	say 教團榮光永存...！
endif
~
|

