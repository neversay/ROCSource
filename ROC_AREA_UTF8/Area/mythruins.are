>talk_prog topic~
if being($b)
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_kni_escaping
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_escaping_mid
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($n) == myth_templar_rescue 100004
	mpadd_qmark self myth_escaping_mid
	tell $n 謝謝協助，我終於有點力氣了...
	tell $n 此地相當危險，尤其是東邊那個洞穴，千萬不要誤入....
	mpcallout 1 tell $n 以我現在體力在沼澤中大概撐不了多久時間，更別說獨自離開了。
	mpcallout 1 tell $n 雖然很想馬上離開這個鬼地方，不過才剛被治療完，
	mpcallout 2 tell $n 你願意幫這個忙嗎？(yes/no)
	mpcallout 2 tell $n 所以還想請你協助我儘快脫離這個地方。
	mpcallout 2 mpmod_qmark $n myth_templar_rescue v0 = 5
	mpcallout 2 mpdel_qmark self myth_escaping_mid
else
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
~
>talk_prog no~
if being($b)
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_kni_escaping
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_escaping_mid
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($n) == myth_templar_rescue 100005
	tell $n 這樣呀....不願意嗎...
	tell $n 但我現在也只能靠你了，如果突然改變心意，請跟我說一下。
endif
~
>talk_prog yes~
if being($b)
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_kni_escaping
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_escaping_mid
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($n) == myth_templar_rescue 100005
	mpadd_qmark self myth_escaping_mid
	mpadd_qmark self myth_kni_staytime -1 0 0 0 0 1
	mpmod_qmark $n myth_templar_rescue v0 = 6
	mpmod_qmark $n myth_templar_rescue v2 = 3
	mpdef_rembch $n
	tell $n 真是感激不盡....！
	tell $n 但避免最壞的情況下我無法順利逃脫，需要有人傳達情報。
	tell $n 所以請容我簡短的自我介紹一下。
	mpcallout 1 tell $n 在隊伍進入沼澤後，我們遭到魔物的襲擊，團隊被擊破得支離破散。
	mpcallout 1 tell $n 而我被分配到的任務是搜索這片巨石上的生態跟地型。
	mpcallout 1 tell $n 我是教團派來調查遺跡的一員，這次的探勘地點是東區沼澤。
	mpcallout 2 tell $n 能慢慢靜待救援，但是後面卻碰到更糟糕的情況....
	mpcallout 2 tell $n 說幸不幸，在慌亂之中我恰巧逃到任務地點，想說這裡沒有魔物，
	mpcallout 3 tell $n 這片巨石上沒有其它生物的主因，他太過兇猛，其他生物都不敢接近。
	mpcallout 3 tell $n 我發現在東邊的洞穴中，住著一條巨龍。而這條巨龍也是造成
	mpcallout 4 tell $n 之後的慘狀就如同你發現我時一樣。
	mpcallout 4 tell $n 而我隨意闖入洞穴的結果，就是差點賠上一條性命。
	mpcallout 5 tell $n 那麼自介到此為止，請你盡快準備好後跟我說一聲(ok)。
	mpcallout 5 mpdel_qmark self myth_escaping_mid
endif
~
>talk_prog ok~
if is_qmark($i) == myth_kni_escaping
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if is_qmark($i) == myth_escaping_mid
	mpechoat $n 他看起來很虛弱，沒體力跟你閒聊。
	break
endif
if rembch($n)
	if is_qmark($b) == myth_templar_rescue 100006
		mpadd_qmark self myth_escaping_mid
		mpdel_qmark self myth_kni_staytime
		mpadd_qmark self myth_kni_escaping 10 0 0 0 0 1
		mpmod_qmark $b myth_templar_rescue v0 = 7
		tell $b 只要能到遺跡跟森林的交界處，我就有辦法獨自回到鎮上。
		tell $b 不過我的頭還有點昏昏的...如果恍神不小心走錯路的話，
		tell $b 請跟我說一聲，我會盡快跟上(refollow)。
		mpcallout 1 mpgroup $b self 0 0
		mpcallout 1 tell $b 那麼趁我還有體力移動時，快點出發吧。
		mpcallout 1 mpdel_qmark self myth_escaping_mid
	endif
endif
~
>talk_prog refollow~
if rembch($n)
	if is_qmark($b) == myth_templar_rescue 100007
		tell $b 抱歉，我這就跟上....
		follow $b
	endif
endif
~
