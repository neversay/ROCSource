#ROOMDATA
#21261
荒蕪的島嶼~
你站在一座血海上小島的海灘峽口。灘地被峭壁包圍，沿岸除了幾艘年代久遠
的腐朽破船(ship)外，還發現一些毀損的人造物。各種跡象顯示出，至少有數十年
的時光無人踏足過這座孤島了。就算島上保存著精靈族的遺產也不讓你感到意外。
北邊有道向上的斜坡，如果你對寶藏有興趣，可以從這裡進入小島。
~
0 1|4|256|8192|65536|524288|1048576 4
D0
~
~
0 0 21262
E
ship~
這些船大多是用木頭建造，也難怪長時間的泡在血海中會腐壞成這樣。
仔細找找(search)，或許可以找到尚能使用的東西帶你離開這鬼地方。
~
>room_time 100~
if roomtimer($0) != 0
	break
endif
if rnplayer($) == 0
	if roomvalue($0) == 0
		if rand(50)
			modrvt v0 = 1
		else
			if rand(20)
				modrvt v0 = 2
			else
				if rand(25)
					modrvt v0 = 3
				else
					if rand(33)
						modrvt v0 = 4
					else
						if rand(50)
							modrvt v0 = 5
						else
							modrvt v0 = 6
						endif
					endif
				endif
			endif
		endif
	endif
endif
~
>room_command search p ship~
if roomvalue($1) == 1
	echoat $n 你發現岸邊有一艘精靈船，也許能登入(aboard)。
else
	echoat $n 你發現任何堪用的船，不過船體的木材(wood)或許能拔下來(pluck)利用。
endif
~
>room_command pluck default~
echoat $n 你要拔什麼？
~
>room_command pluck p wood~
if is_inv_obj($n) == 21261
	echoat $n 你要那麼多塊木板幹啥？
else
	echoat $n 你隨手從船隻殘骸拔起一塊木板。
	echoaround $n $N隨手從地上撿起一塊破木板。
	oload 21261 1 $n target
endif
~
>room_command float p sea~
if is_inv_obj($n) == 21261
	echoat $n 你往海潮衝去！試圖靠著手中的木板征服這片血海！
	echoaround $n $N手持木板跳入海中航向....呃，飄向搖遠的彼方！
	transfer $n 21268
else
	echoat $n 什麼？
endif
~
>room_command aboard p ship~
if roomvalue($1) == 1
	echoat $n 你離開小島返回精靈船上。
	echoaround $n $N離開小島返回精靈船。
	transfer $n 21442
	at $n echoaround $n $N 上船了。
	at $n force $n look
else
	echoat $n 這裡沒有可以用的船。
endif
~
|
S
#21262
荒蕪的島嶼~
一路上只看得到光禿岩石跟幾棵枯木，配上烏雲密佈的陰暗天空就像走在世界
盡頭一般，帶來強烈的不安感。你開始懷疑，這座毫無生氣的小島真得藏有精靈族
的寶藏嗎？現在也只能期待在島上高處能看見不同的景色了。
~
