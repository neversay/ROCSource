	if rand(50)
		mpforcer here add_affect $n 'snare' 0 3 0 0 64
		mpgoto self
		waggle $n
		giggle
	else
		mpforcer here add_affect $n 'paralyze' 0 3 0 0 268435456
		mpgoto self
		waggle $n
		giggle
