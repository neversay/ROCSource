	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($n) == myth_templar_SP_II_B 100000
	if inroom($i) == 21269
		if is_qmark($n) == myth_templar_SP_II_B 300001
			mpmod_qmark $n myth_templar_SP_II_B v0 = 1
			tell $n 咦，你已經完成我的委託啦，又跑回遺跡幹啥？(for fun)
		endif
	endif
	if inroom($i) == 21271
		if is_qmark($n) == myth_templar_SP_II_B 300002
			mpmod_qmark $n myth_templar_SP_II_B v0 = 1
			tell $n 咦，你已經完成我的委託啦，又跑回遺跡幹啥？(for fun)
		endif
		if is_qmark($n) == myth_templar_SP_II_B 300003
			mpmod_qmark $n myth_templar_SP_II_B v0 = 1
			mpmod_qmark $n myth_templar_SP_II_B v1 = 1
			tell $n 咦，你已經完成我的委託啦，又跑回遺跡幹啥？(for fun)
		endif
	endif
	if inroom($i) == 21273
		if is_qmark($n) == myth_templar_SP_II_B 300004
			mpmod_qmark $n myth_templar_SP_II_B v0 = 1
			tell $n 啊...你還回到這危險的地方幹嘛？(for fun)
		endif
		if is_qmark($n) == myth_templar_SP_II_B 300005
			mpmod_qmark $n myth_templar_SP_II_B v0 = 1
			mpmod_qmark $n myth_templar_SP_II_B v1 = 1
			tell $n 啊...你還回到這危險的地方幹嘛？(for fun)
		endif
	endif
	break
endif
if inroom($i) == 21269
	if rand(30)
		say 感覺隨時會有東西跳出來
		say 遺跡真是個糟糕透頂的地方...
	endif
endif
if inroom($i) == 21271
	if rand(30)
		say 如果不出任何意料之外的事情
		say 以攻勢的強度而言，這次任務也許真能成功
	endif
endif
if inroom($i) == 21273
	if rand(30)
		say 攻擊沒完沒了，一波接一波的來...
		say 不論如何一定要死守這裡....
	endif
endif
~
>talk_prog p for fun~
if being($b)
	mpechoat $n 他現在沒空。
	break
endif
if is_qmark($n) == myth_templar_SP_II_B 100001
	if inroom($i) == 21269
		if is_qmark($n) == myth_templar_SP_II_B 300001
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 9 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_B v0 = 3
			tell $n 哈，你是把遺跡當成自家後院在逛嗎。
			tell $n 也難怪有本事輕鬆解決掉長期困擾我們的問題了。
			mpcallout 2 tell $n 在這裡你可以稍微休息喘口氣。
			mpcallout 2 tell $n 現在臨時營地內集結了能防禦強大攻擊的部隊。
			mpcallout 3 tell $n 而我還能活到現在大概也是這個原因吧。
			mpcallout 3 tell $n 這都要歸功你清掉大量的惡魔，部隊才能順利進駐。
			mpcallout 4 giggle
			mpcallout 5 tell $n 差不多該繼續對周圍保持警戒了。
			mpcallout 5 tell $n 畢竟還在遺跡內，說是安全也不可能安全到哪去吧。
			mpcallout 5 tell $n 好啦，閒話就到這了。
			mpcallout 6 tell $n 這算是點小心意吧。
			mpcallout 6 mpoload 21264 $n 38 target
			mpcallout 6 mpechoat $n $I臨別前把一柄大劍塞給你。
			mpcallout 7 hmm
			mpcallout 8 tell $n 還是小心點為妙....
			mpcallout 8 tell $n 雖然知道你的實力高強，但遺跡尚有許多未知。
			mpcallout 9 mpdef_rembch null-tar
			mpcallout 9 mpat $n mpmod_qmark $n myth_templar_SP_II_B v2 = 6
			mpcallout 9 wave $n
		endif
	endif
	if inroom($i) == 21271
		if is_qmark($n) == myth_templar_SP_II_B 300002
		or is_qmark($n) == myth_templar_SP_II_B 300003
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 8 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_B v0 = 2
			tell $n 呃...正常人都不會想再次踏入這個受詛咒的地方吧。
			tell $n 還說自己是來找樂子的...
			mpcallout 1 hmm
			mpcallout 2 tell $n 不對...看見沿路上的惡魔屍體數量也很難說你是個正常人...
			mpcallout 3 tell $n 你自己也要注....什麼！？
			mpcallout 3 tell $n 幾小時前才有魔物襲擊過營地，並出現一些傷亡。
			mpcallout 3 tell $n 總之，現在的人數雖然足夠應付零星的奇襲，但防禦設施還不夠完善。
			mpcallout 4 mpecho 不遠處有幾隻惡魔朝這裡飛來。
			mpcallout 5 yell 敵襲！
			mpcallout 6 mpgroup $n self 0
			mpcallout 6 tell $n 只能麻煩你陪我一起迎敵了。
			mpcallout 6 tell $n 看來船廠那邊的人一時間趕不過來。
			mpcallout 7 tell $n 來了，數量不算多！希望這次也能挺過...
			mpcallout 8 mpadd_qmark self camp_kni_fight -1 0 0 0 0 1
			if is_qmark($n) myth_templar_SP_II_B 200001
				mpcallout 8 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 2
				mpcallout 8 strong_mob
			else
				mpcallout 8 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 2
				mpcallout 8 normal_mob
			endif
			mpcallout 8	mpecho 幾隻惡魔從天而降！
		endif
	endif
	if inroom($i) == 21273
		if is_qmark($n) == myth_templar_SP_II_B 300004
		or is_qmark($n) == myth_templar_SP_II_B 300005
			mpdef_rembch $n
			mpadd_qmark self talking
			mpcallout 6 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP_II_B v0 = 2
			tell $n 跑來危險的地方逛街找樂子...是想找死吧...
			mpcallout 2 tell $n 要是晚一步的話....啊！？
			mpcallout 2 tell $n 為了安全，我建議你快點離開這裡。
			mpcallout 2 tell $n 這幾天下來這裡已經受到好幾波的攻擊了。
			mpcallout 3 mpecho 不遠處有大量惡魔朝這裡飛來。
			mpcallout 4 yell 惡魔來襲！
			mpcallout 5 mpgroup $n self 0
			mpcallout 5 tell $n 這種數量...你來幫我一把！
			mpcallout 6 mpadd_qmark self camp_kni_fight -1 0 0 0 0 1
			if is_qmark($n) myth_templar_SP_II_B 200001
				mpcallout 6 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 2
				mpcallout 6 strong_mob
			else
				mpcallout 6 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 2
				mpcallout 6 normal_mob
			endif
			mpcallout 6	mpecho 大量惡魔從天而降！
		endif
	endif
endif
~
>talk_prog p hurt~
if rembch($n)
	if inroom($i) == 21271
		if is_qmark($i) == camp_kni_fight 200001
			if is_qmark($n) == myth_templar_SP_II_B 100002
				mpmod_qmark $n myth_templar_SP_II_B v1 = 3
				mpdel_qmark self camp_kni_fight
				tell $n 不用在意，一點小傷而已幾發治療術就沒事了。
				mpcallout 1 tell $n 不好好的答謝可不行。
				mpcallout 1 tell $n 話說，真沒想到會再次被你拯救呢。
				mpcallout 2 ponder
				mpcallout 3 tell $n 多少帶點抵抗邪惡的力量。
				mpcallout 3 tell $n 雖然稱不上什麼好東西，但受過教會加持。
				mpcallout 3 tell $n 這樣好了，這把武器送給你。
				mpcallout 4 mpechoat $n $I塞給你一把武器。
				if is_qmark($n) == myth_templar_SP_II_B 300002
					mpcallout 4 mpoload 21265 $n 38 target
				endif
				if is_qmark($n) == myth_templar_SP_II_B 300003
					mpcallout 4 mpoload 21266 $n 38 target
				endif
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_B v2 = 6
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 3
				mpcallout 5 tell $n 你自己也小心點。
				mpcallout 5 tell $n 看來魔物可能會再次來襲，我要繼續保持警戒了。
				mpcallout 6 mppurge self
				mpcallout 6 mpmload 21268
				mpcallout 6 mpforcer here modrvt v0 = 0
				mpcallout 6 wave $n
			endif
		endif
	endif
	if inroom($i) == 21273
		if is_qmark($i) == camp_kni_fight 200001
			if is_qmark($n) == myth_templar_SP_II_B 100002
				mpdel_qmark self camp_kni_fight
				tell $n 先別管這個了，下一波攻擊不知道什麼時候會來。
				mpcallout 1 tell $n 隨時都會有大量的魔物出現，將你撕成碎片。
				mpcallout 1 tell $n 你也看到了，這裡的情況實在不適合閒逛參觀。
				mpcallout 2 tell $n 這邊的情況或多或少能滿足你吧？
				mpcallout 2 tell $n 當然如果你所謂的「找樂子」是指打打殺殺的話。
				mpcallout 3 tell $n 總之，勸你為了安全著想，儘早遠離這裡吧。
				mpcallout 4 hmm
				mpcallout 5 mpechoat $n $I塞給你一個旗幟。
				mpcallout 5 mpoload 21270 $n 38 target
				mpcallout 5 tell $n 你離開前把東西一起帶上吧。
				mpcallout 6 tell $n 對逃離這裡的過程多少會能起些幫助。
				mpcallout 6 tell $n 這個是受過教會加持的旗幟，能抵抗邪惡的力量。
				mpcallout 7 mpat $n mpmod_qmark $n myth_templar_SP_II_B v2 = 6
				mpcallout 5 mpat $n mpmod_qmark $n myth_templar_SP_II_B v1 = 3
				mpcallout 7 tell $n 你也盡早離開吧。
				mpcallout 7 tell $n 好了，我也要為下一波攻擊作準備。
				mpcallout 8 mppurge self
				mpcallout 8 mpmload 21268
				mpcallout 8 mpforcer here modrvt v0 = 0
				mpcallout 8 tell $n 祝你好運。
			endif
		endif
	endif
endif
~
>fight_prog 30~
if rand(60)
	c heal
	mpnowait
else
	c 'double heal'
	mpnowait
endif
~
>fight_prog 20~
if rand(50)
	c 3 'dispel evil'
else
	sun
	mpnowait
endif
~
>death_prog 100~
if being($b)
	mpat $b mpmod_qmark $b myth_templar_SP_II_B v2 = 6
	if insameroom($b)
		if is_qmark($i) == camp_kni_fight 200000
			say 看來不行了...快逃...
			mpecho $I用最後的力量把大部分人傳送到安全的地方。
			mpforcer here transfergroup $b 21450
		endif
	endif
endif
mpforcer here modrvt v0 = 0
if rand(50)
	say 嗚....看來這次真得要死了....
else
	say 果然踏入遺址就會有這種下場....
endif
~
