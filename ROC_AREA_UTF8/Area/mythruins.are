>talk_prog topic~
if is_qmark($i) == talking
	mpechoat $n 她正在忙。
	break
endif
if is_inv_obj($n) == 21026
	if is_qmark($n) == myth_elven_wish 100014
		tell $n 請將所需的物品帶來給我。
		break
	endif
	if is_qmark($n) == myth_elven_wish 100007
		tell $n 請引領六位我族的靈魂，讓他們回歸(returned)應去之處...
		break
	endif
	if is_qmark($n) == myth_elven_wish 100005
		mpadd_qmark self talking
		mpcallout 1 mpdel_qmark self talking
		mpechoat $n $I抬起頭來望向你。
		mpcallout 1 tell $n 你是來尋找我們(we)的嗎？
		mpcallout 1 tell $n 已經好久沒見到有人來到這了。
	else
		tell $n 我們還在等待著你...
	endif
else
	mpechoat $n $I悲傷地望向你。
endif
~
>talk_prog we~
if is_qmark($i) == talking
	mpechoat $n 她正在忙。
	break
endif
if is_qmark($n) !& myth_family_recipe 300001
	tell $n 海邊，傳來了精靈先祖們的悲痛之音...
	tell $n 我們還在等待著你...
	break
endif
if is_qmark($n) == myth_elven_wish 100005
	mpadd_qmark self talking
	mpcallout 6 mpdel_qmark self talking
	mpmod_qmark $n myth_elven_wish v0 = 6
	tell $n 「我們」，存在於輝煌時期的迷斯卓諾。
	mpcallout 1 tell $n 讓我族的歷史得以傳承...
	mpcallout 1 tell $n 透過吟唱者的血統，化作文字，踏入僅存於回音中的思念，
	mpcallout 1 tell $n 你身上的書頁，即是最後的「我們」，共同留下的回音。
	mpcallout 2 hmm
	mpcallout 4 tell $n 這份思念束縛著他們，使靈魂遊蕩在墮落的城址之中。
	mpcallout 4 tell $n 許多族人的靈魂仍思念著舊有的榮光。
	mpcallout 5 tell $n 我們深切地企盼他們的靈魂能得以安息。
	mpcallout 6 tell $n 你願意，協助我們嗎？(yes/no)
endif
~
