#21412
沾滿血跡的告示牌前~
在這片沼澤遺跡之中，有一面很大的木頭告示，上面都是乾涸已久的血漬，並
綴飾著已然發黑與破碎的頭骨。比起往西的方向相較，北面充斥著不祥的氣息。你
不禁注意到幾乎周遭所有跡象都指出你應當遠離北面，而非繼續前進。
~
0 1|4|65536|524288|1048576 4
D0
~
~
0 0 21413
D3
~
~
0 0 21378
>room_enter 127 100~
if is_qmark($n) == myth_templar_search 100005
	if is_qmark($n) !& myth_templar_search 200001
		echoat $n 你注意到旁邊有個告示牌(sign)，也許能從上面找到些痕跡(search)。
	endif
endif
~
>room_command search p sign~
if is_qmark($n) == myth_templar_search 100005
	if is_qmark($n) !& myth_templar_search 200001
		mod_qmark $n myth_templar_search v1 | 1
		echoat $n 告示牌留下的血跡已經相當陳舊，應該不是騎士們的「殘骸」。
		echoat $n 但一路的廝殺，難保你不會也成為告示牌的裝飾。
		echoat $n 你發現部分的血跡像被拖曳般的往北邊延伸而去。
	else
		echoat $n 沾滿血跡的告示牌，希望你不會也成為上面的裝飾。
	endif
else
	echoat $n 沾滿血跡的告示牌，希望你不會也成為上面的裝飾。
endif
~
|
S
#21413
遺跡沼澤地交口~
這片潮濕、已然沼澤化的區域幾乎已經將原本的精靈城市遺跡掩埋了，幾乎沒
有什麼線索能讓你看出這裡過去曾經存在過一座城市。往前的路幾乎被泥濘、深不
見底且淹滿泥水的地穴所覆蓋。有一條寬廣且清楚的小徑領你往東前進，往西的路
則暗些。南方的沼澤似乎有退去的跡象。
~
0 1|65536|524288|1048576 4
D1
~
~
0 -1 21414
D2
~
~
0 -1 21412
D3
~
~
0 -1 21419
>room_enter 127 100~
if is_qmark($n) == myth_templar_search 100005
	if is_qmark($n) & myth_templar_search 200001
		if is_qmark($n) !& myth_templar_search 200002
			mod_qmark $n myth_templar_search v1 | 2
			echoat $n 血跡向西邊延伸至較深的水窪處就消失了。
			echoat $n 也許朝西走能找到些什麼也不一定。
			break
		endif
	endif
endif
if is_qmark($n) == myth_templar_rescue 100004
or is_qmark($n) == myth_templar_rescue 100005
	if is_qmark($n) !& myth_templar_rescue 200002
		if is_inv_obj($n) == 21068
			echoat $n 你身上的教團印記(templar mark)發出劇烈的振動。
			echoat $n 這附近找找看(search)，也許能發現什麼線索。
			break
		endif
	else
		break
	endif
endif
~
>room_command search default~
echoat $n 你要探查這附近嗎？(around)
~
>room_command search p around~
if is_qmark($n) == myth_templar_rescue 100004
or is_qmark($n) == myth_templar_rescue 100005
	if is_qmark($n) !& myth_templar_rescue 200002
		if is_inv_obj($n) == 21068
			mod_qmark $n myth_templar_rescue v1 | 2
			echoat $n 你在草叢邊發現身上帶有教團印記的騎士屍體。
			echoat $n 並且發現到有些步伐匆忙的腳印朝東邊延伸而去。
		endif
	else
		echoat $n 你沒找到什麼特別的東西。
	endif
else
	echoat $n 你沒找到什麼特別的東西。
endif
~
|
