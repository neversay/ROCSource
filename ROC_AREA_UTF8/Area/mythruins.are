>room_enter 127 100~
if is_qmark($n) == myth_templar_search 100005
	if is_qmark($n) !& myth_templar_search 200004
		echoat $n 你注意到旁邊的空地上有一堆熄滅的篝火(bonfire)，也許可以探查周邊(search)看看。
	endif
endif
~
>room_command search p bonfire~
if is_qmark($n) == myth_templar_search 100005
	if is_qmark($n) !& myth_templar_search 200004
		mod_qmark $n myth_templar_search v1 | 4
		echoat $n 從堆積的痕跡看來，這堆篝火看起來是最近才被人作出來的。
		echoat $n 周圍分散的零亂腳印不難想像篝火的主人遇到某些危急的事情。
		echoat $n 也許附近能發現什麼線索。
	else
		echoat $n 只是一堆熄滅的篝火，沒什麼特別。
	endif
else
	echoat $n 只是一堆熄滅的篝火，沒什麼特別。
endif
~
|
