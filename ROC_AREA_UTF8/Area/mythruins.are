>room_enter 127 70~
if ispc($n)
	if isfly($n)
		break
	else
		stun $n 30
		echoat $n 你一腳踩空，摔了下去！
		echoaround $n 你看見$N一腳踩空，摔了下去！
		transfer $n 21497
		callout 1 at $n echoat $n 噗咚！你掉到溪中被沖走了...
		callout 2 at $n force $n look
	endif
endif
~
