#21442
破舊的精靈船~
你正在一艘破舊的精靈船上，除了破舊的甲板外只剩下一間駕駛台(bridge)，
上面掛著一些牌照(licenses)，旁邊則有放著引擎的鐵盒(engineroom)，你可以稍微確
認這些東西。整體而言，這船外觀老舊底部還有些進水，但比起其它停靠港灣已經的船
支，相對上堪用許多。甲板上只能看到一望無際的血紅海水，海面吹來的鹹腥海風讓你
想起史卡拉貝渡船的美好，不....這情況下就連走私漁船都更勝許多。如果受不了空氣
中的鹹腥味，在船靠岸的時候你可以下船(disembark)離開。
~
0 8192|65536|524288|1048576 7
E
licenses~
一些船的牌照，上面大部分的字體早已模糊，但隱約還能辨認其中一張寫著船隻型號：MD-CRMR702
~
E
bridge~
一個駕駛台，上面只剩下一個小棚子能擋擋雨水，你可以確認看看上面有啥(check)。
~
E
engineroom~
一個被稱為引擎室的鐵盒子，你可以看看裡面還留有什麼(check)。
~
>room_time 100~
if roomvalue($0) & 512
or roomvalue($0) & 1024
or roomvalue($n21261v1) == 1
	break
endif
if roomvalue($0) >= 31
	if pcnum($) == 0
		at 21447 echo 一艘船被海水打進了港口中....
		modrvt v0 = 15
		modrvt v1 = 0
		modrvt t0 = 0
		modrvt t1 = 0
		at 21474 modrvt t0 = 0
	endif
endif
~
>room_rand 100~
if roomvalue($0) == 1023
	modrvt v0 | 1024
	at 21474 modrvt t0 = 0
	callout 3 echo 船失去動力後被血紅的潮水推動著....
	callout 5 echo 船正快速的被血紅的潮水推動著....在不遠處看見一座小島...
	callout 7 echo 船正非常快速的被血紅的潮水推動著....並且離小島越來越近....
	callout 9 echo 轉眼間，船已經被推到快撞上小島了！
	callout 11 at 21447 modrvt t1 = 10
	callout 11 modrvt v0 = 1039
	callout 11 transfer all 21474
	callout 11 echo 碰！！ 船撞上了小島，你被甩到岸上。
endif
if roomtimer(1) == 0
	break
endif
if rmobcount(21327) == 0
	echo 擊退來犯的魚人後，又再次取回船的掌控權了。
	modrvt t1 = 0
	rcall check_island
endif
~
>room_enter 64 100~
if roomvalue($0) == 1039
	echoat $n 船沉在海中，你被血紅的海水帶往其他地方。
	transfer $n 21464
endif
~
>room_command disembark default~
echoat $n 你想要下什麼？
~
>room_command disembark ship~
if roomvalue($0) !& 16
	echoat $n 你離開了精靈船。
	echoaround $n $N下船離開。
	transfer $n 21447
	at $n echoaround $N 從船上走下來。
	at $n force $n look
else
	if roomvalue($n21261v1) == 1
		echoat $n 你離開了精靈船，登入小島。
		echoaround $n $N下船登入小島。
		transfer $n 21261
		at $n echoaround $n $N下船登入了小島。
		at $n force $n look
		break
	endif
	echoat $n 船還在海上飄，想跳海自殺嗎？
	echoaround $n $N手扶船緣看起來有些想不開，有空開導他一下吧....
endif
~
>room_command check default~
echoat $n 你要查看什麼？
~
>room_command check p bridge~
echoat $n 這是船隻的駕駛台，上面有著許許多多的東西，其中引起你興趣的是：
if roomvalue($0) & 3
	echoat $n 船舵穩穩地安裝在駕駛台上，上面還裝著一個羅盤。
	break
endif
if roomvalue($0) & 1
	echoat $n 船舵穩穩地安裝在駕駛台上，但上面有個孔不知道是幹啥的。
else
	echoat $n 駕駛台上居然沒有船舵(rudderhelm)！
endif
~
>room_command check p engineroom~
echoat $n 這是放置引擎的地方，但說白點外觀就只是像個大一點的金屬盒，你看進去裡面發現：
if roomvalue($0) & 16
	echoat $n 放著一顆發著微光的引擎，正在運轉中。
	break
endif
if roomvalue($0) & 12
	echoat $n 放著一顆發著微光的引擎，裡面加入了柴油，但沒有在運轉。
	break
endif
if roomvalue($0) & 4
	echoat $n 放著一顆發著微光的引擎，裡面還沒有放入燃料。
else
	echoat $n 放著一顆滿是破洞的引擎，連加個油都會漏，看來是不能用了。
endif
~
>room_command bolt default~
echoat $n 你要鎖什麼？
~
>room_command bolt rudderhelm~
if is_inv_obj($n) == 21349
	if roomvalue($0) & 1
		stun $n 10
		purge $n rudderhelm-myth
		echoat $n 船舵(rudderhelm)功能正常，但你還是想要換掉。
		echoaround $n $N似乎嫌船舵(rudderhelm)不順手，堅持替換掉，但過程非常快因此沒人有意見。
	else
		stun $n 10
		echoat $n 你將船舵(rudderhelm)栓到駕駛台上。
		echoaround $n $N將船舵(rudderhelm)栓到駕駛台上。
		modrvt v0 | 1
		purge $n rudderhelm-myth
	endif
else
	echoat $n 你身上沒有船舵。
endif
~
>room_command install default~
echoat $n 你要裝什麼？
~
>room_command install compass~
if roomvalue($0) !& 1
	echoat $n 在駕駛台上你找不到適合的地方安裝它。
	break
endif
if is_inv_obj($n) == 21350
	if roomvalue($0) & 2
		stun $n 10
		purge $n compass-myth
		echoat $n 魔導羅盤(magica compass)功能正常，但你還是想要換新的上去。
		echoaround $n $N堅持替換魔導羅盤(magica compass)，但過程非常快因此沒人有意見。
	else
		stun $n 10
		echoat $n 你將魔導羅盤(magica compass)妥善地裝置在船舵上。
		echoaround $n $N將魔導羅盤(magica compass)妥善地裝置在船舵上。
		modrvt v0 | 2
		purge $n compass-myth
	endif
else
	echoat $n 你身上沒有魔導羅盤。
endif
~
>room_command replace default~
echoat $n 你要換什麼？
~
>room_command replace engine~
if is_inv_obj($n) == 21351
	if roomvalue($0) & 4
		stun $n 10
		purge $n engine-myth
		echoat $n 魔導引擎(arcane engine)功能正常，但你還是想要換一顆新的上去。
		echoaround $n $N堅持換上一顆新的魔導引擎(arcane engine)，但處理非常快因此沒人有意見。
	else
		stun $n 10
		echoat $n 你將舊的引擎拆除，換上新的魔導引擎(arcane engine)。
		echoaround $n $N將舊的引擎拆除，換上新的魔導引擎(arcane engine)。
		modrvt v0 | 4
		purge $n engine-myth
	endif
