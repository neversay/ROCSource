>room_enter 127 100~
if is_qmark($n) == myth_templar_rescue 100004
or is_qmark($n) == myth_templar_rescue 100005
	if is_qmark($n) !& myth_templar_rescue 200001
		if is_inv_obj($n) == 21068
			echoat $n 你身上的教團印記(templar mark)發出劇烈的振動。
			echoat $n 這附近找找看(search)，也許能發現什麼線索。
		endif
	else
		break
	endif
endif
~
>room_command search default~
echoat $n 你要探查這附近嗎？(around)
~
>room_command search p around~
if is_qmark($n) == myth_templar_rescue 100004
or is_qmark($n) == myth_templar_rescue 100005
	if is_qmark($n) !& myth_templar_rescue 200001
		if is_inv_obj($n) == 21068
			mod_qmark $n myth_templar_rescue v1 | 1
			echoat $n 你在東邊及南邊的方向的地面上，各發現一枚教團印記。
			echoat $n 看來這是調查團用來指出前進方向的路標。
		endif
	else
		echoat $n 你沒找到什麼特別的東西。
	endif
else
	echoat $n 你沒找到什麼特別的東西。
endif
~
