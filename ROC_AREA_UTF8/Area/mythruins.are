>tick_prog 100~
if is_qmark($i) == myth_gbreath 100001
	if pcnum($21486) != 0
	or pcnum($21487) != 0
	or pcnum($21488) != 0
	or pcnum($21489) != 0
	or pcnum($21490) != 0
	or pcnum($21491) != 0
	or pcnum($21492) != 0
	or pcnum($21493) != 0
	or pcnum($21494) != 0
		break
	else
		mpmod_qmark self myth_gbreath v0 = 0
		mpmod_qmark self myth_gbreath v1 = 0
		mpmod_qmark self myth_gmove v0 = 0
		mpat 5 c 3 'full heal'
		mpgoto 21488
		mpnowait
	endif
endif
