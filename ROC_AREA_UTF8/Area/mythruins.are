>repop_prog 100~
mpmodify level = 46
mpadd_qmark self enable_fight_tick -1 0 0 0 0 1
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 1 0
mpadd_qmark self ogre_non_autok -1 0 0 0 0 1
~
>tick_prog 100~
if is_qmark($i) >= ogre_non_autok 300002
	mpmod_qmark self ogre_non_autok v2 - 1
else
	if is_qmark($i) == ogre_non_autok 300001
		mpmod_qmark self ogre_non_autok v2 - 1
		mpmodify level = 46
		wake
	endif
endif
if isaffected($i) & 131072
	if is_qmark($i) < ogre_non_autok 100010
		mpmod_qmark self ogre_non_autok v0 = 10
		mpmod_qmark self ogre_non_autok v1 = 1
		mpmod_qmark self ogre_non_autok v2 = 6
		mpecho $I 手中抓著的"食物"掉了下來。
		mpat 5 mpforcer here del_affect $i sleep
		mpmodify level = 55
	else
		mpmod_qmark self ogre_non_autok v2 = 6
		mpecho 看來$I還要睡上好一陣子。
		mpecho 逃跑雖然可恥，但是有用，快趁現在逃走吧！
		mpat 5 mpforcer here del_affect $i sleep
		mpmodify level = 55
	endif
endif
~
>tick_prog 100~
if isfight($i)
	break
endif
if is_qmark($i) > ogre_non_autok 300000
	break
endif
if being($b)
	if is_qmark($i) == ogre_non_autok 100010
		mpdef_rembch null-tar
	else
		if insameroom($b)
			say 餓...吃....吃....吃！！！
			mpechoat $b $I突然向你衝了過來！
			mpechoaround $b $I突然向$B衝了過去！
			mpkill $b
			mptrip $b
			mpdef_rembch null-tar
			break
		else
			mpecho $I坐在地上認真地啃食著手上的"食物"
			mpdef_rembch null-tar
			break
		endif
	endif
endif
if is_qmark($i) == ogre_non_autok 100010
	mpmod_qmark self ogre_non_autok v0 + 1
	mpmod_qmark self ogre_non_autok v1 = 1
	say 啊...食物.....吃完了.....
	say 餓.....想睡覺.....
	mpcallout 1 mpecho $I開始向四周尋找食物。
	mpcallout 3 mpmodify act | 32
	mpcallout 3 mpmodify aff r 64
	mpcallout 3 mpmod_qmark self ogre_non_autok v0 + 1
endif
~
>rand_prog 5~
if isfight($i)
	break
endif
if is_qmark($i) > ogre_non_autok 300000
	break
endif
if is_qmark($i) > ogre_non_autok 100006
	if pcnum($) >= 1
		if ispc($r)
			mpmod_qmark self ogre_non_autok v0 + 1
			mpechoat $r 你看見$I咧嘴對著你笑，還是快點走吧！
			mpechoaround $r 你看見$I咧嘴對著$R笑。
			mpdef_rembch $r
			break
		endif
	endif
endif
if is_qmark($i) < ogre_non_autok 100010
	mpecho $I坐在地上認真地啃食著手上的"食物"
	mpmod_qmark self ogre_non_autok v0 + 1
endif
~
>greet_prog 100~
if isfight($i)
	break
endif
if is_qmark($i) > ogre_non_autok 300000
	break
endif
if ispc($n)
	if is_qmark($i) < ogre_non_autok 100012
		if rand(50)
			mpechoat $n $I正在這裡啃食著骨頭，還是不要打擾牠吧...
		endif
	else
		say 餓...吃....吃....吃！！！
		mpecho $I衝了過來！
	endif
endif
~
>fight_prog 30~
bashhead
mpnowait
bashhead
mpnowait
~
>fight_prog 20~
frenzy
mpnowait
~
>fight_prog 20~
if rand(50)
	skilldrv monehit $n
	mpnowait
else
	skilldrv heavyhit $n
	mpnowait
endif
~
>kill_prog 100~
mpmodify act r 32
mpmodify aff | 64
mpmod_qmark self ogre_non_autok v0 = 0
mpmod_qmark self ogre_non_autok v1 = 0
mpmod_qmark self ogre_non_autok v2 = 0
mpmodify level = 46
say 有吃的了.....
if rand(33)
	mpecho $I 將$N的大腿撕下來啃食。
else
	if rand(50)
		mpecho $I 將$N的手臂扯下來啃食。
	else
		mpecho $I 用大嘴貪婪地啃食著$N的屍首。
	endif
endif
~
>death_prog 100~
mpecho $I的身體緩慢地向後傾倒在地上。
mpgreward skexp $n 38 50
mpgreward exp $n 36 10000
~
