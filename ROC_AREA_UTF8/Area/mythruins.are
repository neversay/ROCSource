>room_rand 100~
if pcnum($21467) != 0
or pcnum($21468) != 0
or pcnum($21469) != 0
or pcnum($21470) != 0
or pcnum($21471) != 0
or pcnum($21472) != 0
or pcnum($21473) != 0
or pcnum($21474) != 0
or pcnum($21442) != 0
else
	break
endif
if mobcount(21325) >= 30
	break
endif
if mobcount(21331) == 1
	if pcnum($) >= 1
		if rand(40)
			mload 21325
		endif
	else
		if rand(25)
			mload 21325
		endif
	endif
endif
~
>room_command jump default~
if mobcount(21331) == 1
	echoat $n 你試著從斷崖邊跳下....
	stun $n 10
	callout 1 echoat $n 但一股無形的力量將你彈了回來。
	callout 1 echoaround $n $N像是撞到牆一樣，從斷崖邊向後彈回。
	break
endif
if dex($n) >= 21
	echoat $n 你試著從遺骨島的斷崖往下跳....
	echoaround $n $N展開雙臂向下一躍，瞬間你產生聽見老鷹叫聲的錯覺？！
	stun $n 40
	transfer $n 21466
	at $n echoaround $n $N從遺骨河堤上跳入河床中。
	callout 1 at $n echoat $n 你借由骨頭作為支點一路往下滑。
	callout 3 at $n echoat $n 你雙腳著地，順利的踏入河床上。
else
	echoat $n 你試著從遺骨島的斷崖往下跳....
	echoaround $n $N發瘋似地突然從骨堆邊緣跌了下去！
	stun $n 40
	transfer $n 21466
	at $n echoaround $n $N從天而降，跌了個狗吃屎！
	callout 1 at $n modhmv $n 01.300 300 0
	callout 1 at $n echoat $n 碰...好痛！
	callout 3 at $n echoat $n 你的屁股著地，重重地摔在河床上。
endif
~
|
S
#21468
遺骨之島~
你正站在許久以前就已經死亡的精靈遺骨所構成的小島上。這裡過去由成千上
萬副屍體堆疊而成，任憑他們風化腐爛在血水之中；一切彷彿發生在昨日，而不是
幾世紀以前。有一瞬間，你感覺這些骨骸似乎移動了一下，彷彿這些遺骨仍然活著
。當你望著這些骨骸時，你不禁打了一個冷顫。有許多廢棄的船骸散佈在北方，你
可以想像這些精靈當時如何努力著在屠殺與滅絕中竄逃出這裡。
