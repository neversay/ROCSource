#21486
充滿劇毒的洞穴~
這個洞窟相當的巨大，上下左右大約都有二十公尺的寬度，這裡的空氣比起戶
外顯得更差，刺激性氣體濃度更加提高了不少。這洞穴就像是充滿毒氣的密室，讓
人感到窒息；也許再深入下去就能找到毒氣的源頭了，前提是你沒被毒死。
~
0 1|4|8|16|8192|65536|524288|1048576 0
D0
~
~
0 0 21489
D1
~
~
0 0 21487
D2
~
~
0 0 21492
D3
~
~
0 0 21418
>room_time 100~
if pcnum($21486) > 0
	echo 周圍的毒氣讓你呼吸困難。
	modhmv pc 03.15 15 0
endif
if roomvalue($0) == 2
	if pcnum($21486) != 0
	or pcnum($21487) != 0
	or pcnum($21488) != 0
	or pcnum($21489) != 0
	or pcnum($21490) != 0
	or pcnum($21491) != 0
	or pcnum($21492) != 0
	or pcnum($21493) != 0
	or pcnum($21494) != 0
		break
	else
		makedoor 3 洞穴出口 洞穴出口 0 0 21418
		echo 啪喀！出口的巨岩突然碎裂，從隙縫中再次透進一絲光線。
		at 21418 makedoor 1 洞穴入口 洞穴入口 0 0 21486
		at 21418 echo 巨大的岩石因風化而碎裂，讓洞穴的入口再次顯現出來。
		modrvt v0 = 0
		modrvt t0 = 0
	endif
endif
~
>room_rand 100~
if roomvalue($0) == 2
	if mobcount(21307) == 0
		makedoor 3 洞穴出口 洞穴出口 0 0 21418
		echo 啪喀！出口的巨岩突然碎裂，從隙縫中再次透進一絲光線。
		at 21418 makedoor 1 洞穴入口 洞穴入口 0 0 21486
		at 21418 echo 巨大的岩石因風化而碎裂，讓洞穴的入口再次顯現出來。
		modrvt v0 = 0
		modrvt t0 = 0
		break
	endif
	if roomtimer($0) == 1
		makedoor 3 洞穴出口 洞穴出口 0 0 21418
		echo 啪喀！出口的巨岩突然碎裂，從隙縫中再次透進一絲光線。
		at 21418 makedoor 1 洞穴入口 洞穴入口 0 0 21486
		at 21418 echo 巨大的岩石因風化而碎裂，讓洞穴的入口再次顯現出來。
		modrvt v0 = 0
	endif
endif
if roomvalue($0) == 1
	deldoor 3
	echo 碰！！ 一顆巨石堵住了洞穴的出口！
	at 21418 deldoor 1
	at 21418 echo 洞穴上方的岩盤鬆動，從上面掉落下一顆巨石剛好堵住洞穴的出口！
	modrvt v0 = 2
	modrvt t0 = 100
endif
~
>room_enter 127 100~
if roomvalue($0) == 0
	if mobcount(21307) == 0
		break
	else
		modrvt v0 = 1
	endif
endif
~
|
S
