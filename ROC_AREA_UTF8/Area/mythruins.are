endif
~
>room_command refuel default~
echoat $n 你要填充什麼？
~
>room_command refuel diesel~
if roomvalue($0) !& 4
	echoat $n 這艄船的引擎毀壞嚴重。
	break
endif
if is_inv_obj($n) == 21352
	if roomvalue($0) & 8
		stun $n 10
		purge $n diesel-myth
		echoat $n 引擎中已經有柴油(diesel)了，但你還是倒入更多。
		echoaround $n $N堅持將柴油(diesel)加滿！
	else
		stun $n 10
		modrvt v0 | 8
		purge $n diesel-myth
		echoat $n 你將柴油(diesel)倒入魔導引擎中。
		echoaround $n $N將柴油(diesel)倒入魔導引擎中。
	endif
else
	echoat $n 你身上沒有柴油。
endif
~
>room_command trigger default~
echoat $n 你要引發什麼？
~
>room_command trigger cluster~
if is_inv_obj($n) == 21353
	echoat $n 你試著用魔法晶簇(magic cluster)啟動魔導引擎....
	echoaround $n $N試著用魔法晶簇(magic cluster)啟動魔導引擎....
	stun $n 10
	if roomvalue($0) !& 4
		callout 1 echoat $n 你發現這艘船的引擎毀壞嚴重，無法啟動。
		callout 1 echoaround $n 但引擎已經毀壞，對$N的行為沒有反應。
		break
	endif
	if roomvalue($0) !& 8
		callout 1 echoat $n 你發現魔導引擎中缺少燃料，沒辦法啟動。
		callout 1 echoaround $n 但魔導引擎對$N的行為沒有反應。
		break
	endif
	if roomvalue($0) !& 1
		callout 1 echoat $n 但你突然想到還沒找到方法操作船體，所以作罷。
		callout 1 echoaround $n $N好像突然想到了什麼，決定停止進行這個動作。
		break
	endif
	if roomvalue($0) !& 2
		callout 1 echoat $n 咚咚咚....咚咚....噗砰....
		callout 1 echoaround $n 咚咚咚....咚咚....噗砰....
		callout 2 echoat $n 你順利啟動引擎，但引擎突然又自動熄火。
		callout 2 echoat $n $N順利啟動魔導引擎，但引擎又自動熄火。
		break
	endif
	if roomvalue($0) & 16
		purge $n cluster-myth
		callout 1 echoat $n 魔法晶簇(magic cluster)發出炫麗的光茫消失掉了，引擎依然啟動。
	else
		stun $n 30
		modrvt v0 | 16
		modrvt t0 = 99
		at 21447 echo 你看見一艘船離開港口航向外海。
		purge $n cluster-myth
		callout 1 echoat $n 魔法晶簇(magic cluster)發出炫麗的光茫消失掉了。
		callout 2 echoat $n 咚咚咚....咚咚咚....咚咚咚咚！！！ 看來引擎順利啟動了。
		callout 2 echoaround $n 咚咚咚....咚咚咚....咚咚咚咚！！！
		callout 3 echo 船體開始移動，離開港口航向外海。
		callout 5 echo 不一會時間，船已經停在外海上了，現在或許能試著操作船舵(sail 方向)。
		callout 5 at 21474 modrvt t0 = 16
		callout 5 modrvt t0 = 0
	endif
else
	echoat $n 你身上沒有魔法晶簇。
endif
~
>room_command sail default~
if roomvalue($0) !& 16
	break
endif
echoat $n 你要把船開往哪邊？(sail 方向)
~
>room_command sail p north~
if roomvalue($0) !& 16
	break
endif
if roomtimer($0) != 0
	echoat $n 目前已經被掌舵了。
	break
endif
if roomtimer(1) != 0
	echoat $n 看來要擊退來犯的敵人才能奪回船的掌控權。
	break
endif
if roomvalue($0) & 512
	echoat $n 船失去了動力。
	break
endif
rcall ship_attack $n
rcall ship_north $n
