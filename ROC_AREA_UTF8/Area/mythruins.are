>entry_prog 100~
if is_qmark($i) == myth_escaping_mid
	break
endif
if area($i) == mythforest
	if being($b)
		mpadd_qmark self myth_escaping_mid
		follow self
		mpforcer here at $b mod_qmark $b myth_templar_rescue v2 = 1
		tell $b 到這裡就行了，接下來我能自己回去了。
		tell $b 感謝你的協助！
		mpcallout 1 mpgoto 21499
		mpcallout 1 mpecho $I 朝著綠葉谷的方向走去。
		mpcallout 2 mppurge self
		mpcallout 2 mpforcer here at $b echoat $b 看來任務順利完成了，有空回去找委託人回報(report)一下。
		break
	endif
endif
if is_qmark($i) == myth_kni_escaping 100010
	break
else
	if inroom($i) == 21336
		mpmod_qmark self myth_kni_escaping v0 = 10
		mpecho .
		mpecho 庭院中央憑空出現一隻巨大的惡魔...！！
		mpecho .
		mpmload 21338
		mpforce horned-myth-q mpkill injured-myth-2
		mpforce horned-myth-q c apocalypse
	endif
endif
if is_qmark($i) >= myth_kni_escaping 100006
or inroom($i) == 21336
	break
endif
if area($i) == mythruins
	if rand(25)
		if rand(33)
			mpmod_qmark self myth_kni_escaping v0 + 1
			mpecho 一群蜥蝪人朝你們衝來...！
			mpmload 21335
			mpforce lizardman-myth-q mpkill injured-myth-2
			mpmload 21335
			mpforce lizardman-myth-q mpkill injured-myth-2
			mpmload 21335
			mpforce lizardman-myth-q mpkill injured-myth-2
		else
			if rand(50)
				mpmod_qmark self myth_kni_escaping v0 + 1
				mpecho 一團爛泥突然從地面彈起，朝你們飛來...！
				mpmload 21336
				mpforce dweller-myth-q mpkill injured-myth-2
				mpmload 21336
				mpforce dweller-myth-q mpkill injured-myth-2
				mpmload 21336
				mpforce dweller-myth-q mpkill injured-myth-2
			else
				mpmod_qmark self myth_kni_escaping v0 + 1
				mpecho 幾隻巨蛙朝你們跳過來...！
				mpmload 21337
				mpforce frog-myth-q mpkill injured-myth-2
				mpmload 21337
				mpforce frog-myth-q mpkill injured-myth-2
			endif
		endif
	endif
endif
