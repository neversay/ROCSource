~
>room_defun hydra_map~
if roomvalue($n21261v0) > 0
	if roomvalue($n21261v0) > 0
		echoat $n 上面顯示著發著藍光的文字：
		nonechoat $n 　欲前往封印之地：
		if roomvalue($n21261v0) == 1
			echoat $n 向北轉南再朝東。
		endif
		if roomvalue($n21261v0) == 2
			echoat $n 向北轉東再朝南。
		endif
		if roomvalue($n21261v0) == 3
			echoat $n 向北兩次再轉西兩次。
		endif
		if roomvalue($n21261v0) == 4
			echoat $n 向南轉北再朝西。
		endif
		if roomvalue($n21261v0) == 5
			echoat $n 向南轉西再朝北。
		endif
		if roomvalue($n21261v0) == 6
			echoat $n 向南兩次再轉西兩次。
		endif
	else
		echoat $n 這是一張空白的地圖紙，上面什麼也沒有。
	endif
else
	echoat $n 這是一張空白的地圖紙，上面什麼也沒有。
endif
~
>room_defun ship_attack~
if roomvalue($0) & 256
	modrvt t0 = 99
	rcall check_leaving
	callout 2 echoat $n 船到達你預期的座標上了。
	callout 2 echoaround $n 船到達$N預期的座標上了。
	callout 3 modrvt t0 = 0
	callout 3 echo 突然一陣大浪打來，讓船失去了動力！
else
	rcall check_leaving
	if rand(20)
		modrvt t0 = 99
		callout 2 echo 船到達預期的座標後，突然無法控制。
		callout 3 echo 海面上跳出幾道身影。
		callout 4 modrvt t1 = 9999
		callout 4 modrvt t0 = 0
		callout 4 mload 21327
		callout 4 mload 21327
		callout 4 mload 21327
		callout 4 mload 21327
	else
		modrvt t0 = 99
		callout 2 echoat $n 船到達你預期的座標上了。
		callout 2 echoaround $n 船到達$N預期的座標上了。
		callout 3 modrvt t0 = 0
		callout 3 echo 船底自動拋下海錨，停在海面上。
		callout 3 rcall check_island
	endif
endif
~
>room_defun check_leaving~
if roomvalue($n21261v1) == 1
	at 21261 echo 一艘精靈船遠離了岸邊。
	at 21261 modrvt v1 = 0
	break
endif
~
>room_defun check_island~
if roomvalue($n21261v0) == 1
	if roomvalue($1) == 577
		echo 在船的前方，你看見了一座小島，要下船(disembark)登入嗎？
		at 21261 echo 你看見一艘精靈船靠近了岸邊....
		at 21261 modrvt v1 = 1
	endif
endif
if roomvalue($n21261v0) == 2
	if roomvalue($1) == 1057
		echo 在船的前方，你看見了一座小島，要下船(disembark)登入嗎？
		at 21261 echo 你看見一艘精靈船靠近了岸邊....
		at 21261 modrvt v1 = 1
	endif
endif
if roomvalue($n21261v0) == 3
	if roomvalue($1) == 34833
		echo 在船的前方，你看見了一座小島，要下船(disembark)登入嗎？
		at 21261 echo 你看見一艘精靈船靠近了岸邊....
		at 21261 modrvt v1 = 1
	endif
endif
if roomvalue($n21261v0) == 4
	if roomvalue($1) == 2068
		echo 在船的前方，你看見了一座小島，要下船(disembark)登入嗎？
		at 21261 echo 你看見一艘精靈船靠近了岸邊....
		at 21261 modrvt v1 = 1
	endif
endif
if roomvalue($n21261v0) == 5
	if roomvalue($1) == 388
		echo 在船的前方，你看見了一座小島，要下船(disembark)登入嗎？
		at 21261 echo 你看見一艘精靈船靠近了岸邊....
		at 21261 modrvt v1 = 1
	endif
endif
