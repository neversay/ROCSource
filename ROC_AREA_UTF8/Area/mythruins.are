echoat $n 　
echoat $n 形號：M#-600..............p###1
echoat $n 　
echoat $n 形號：#D-7##..............#ag##
echoat $n 　
echoat $n 形號：#D-C##R700..........page3
echoat $n 　
echoat $n 形號：M####MR##2..........p##e4
echoat $n 　
echoat $n 形號：M#-#R#R##2..........p##e#
echoat $n 　
echoat $n 形號：#D-CRMR##3..........pag##
echoat $n 　
echoat $n 形號：M#-##M#714..........#age7
echoat $n 　
echoat $n 附錄......................####8
echoat $n 　
echoat $n 你可以分別確認每頁的內容(check)。
~
>room_command check page1~
echoat $n 形號：#D-6#0
echoat $n 　
echoat $n 這款小型船為引進人類技術所製成，原本燃料使用柴油。但船##較小且輕##
echoat $n 經本##技師改良##，可####用純粹##魔力作為動力。也因##這款型號到今日
echoat $n 依##存在。
~
>room_command check page2~
echoat $n 形號：MD-705
echoat $n 　
echoat $n 這##運輸船為####人類技術##製成，燃料使用柴油。因##船體較大，造價##
echoat $n 宜且節省燃料消耗。運輸貨物##相當實用，######款型號##現在依然存在。
~
>room_command check page3~
echoat $n 形號：##-#RMR700
echoat $n 　
echoat $n 改良於M#-60#的小##船隻，彌補#D-#00型號速度上的不足，作為一般平民娛
echoat $n 樂運輸使用，但##價相對MD-600較高，因此普##率較低。
~
>room_command check page4~
echoat $n 形號：#D-C###70#
echoat $n 　
echoat $n 改良於MD#7#5的運輸船，####船首次搭載本國技####研發##魔導引擎，####
echoat $n 以魔法晶簇作為##燃料改##人類##擎柴油燃料的##效率問題。並且同時搭載
echoat $n 魔導羅盤##定位系統，可##船隻判斷移動，##航行##更##便利。##造價##高
echoat $n 而####無法完全替代#D-#05。
~
>room_command check page5~
echoat $n 形號：M#-C##R#12
echoat $n 　
echoat $n 改良於M#-C#M#7#2的運輸船，搭載魔導引擎II，完##不需以柴油作##燃料，
echoat $n 只需##使用魔法晶簇####產##動力。作##新技術##船隻，##全取代先前船型
echoat $n 也####時間的問題。
~
>room_command check page6~
echoat $n 形號：M#-CRMR#1#
echoat $n 　
echoat $n 本國研發##小型船隻，搭載魔##引擎II，作##平民娛樂運輸用，速度相對##
echoat $n 其##小型船隻快上許多，##可取代舊時小型船##地##。
~
>room_command check page7~
echoat $n 形號：#D#CR#R714
echoat $n 　
echoat $n 本##今年研發最新##小型快艇，搭載魔導引擎VI的##新技術，將不再##要用
echoat $n 魔法晶簇##為燃料，只需駕##提供少量魔力##可產生動力。##且##速度上較
echoat $n 去年研發##MD-C##R7#3快上兩倍。雖##造價##非常高，但##技術發展有朝一
echoat $n 日成為本國之光##只是時間問題。
~
>room_command check page8~
echoat $n 船隻引擎：
echoat $n 　
echoat $n 船型的數字都為研發出的年份，MD系列為舊時代產物，而MD-CRMR為搭載魔導引擎
echoat $n 的新系列。各位同人請注意，換置引擎(replace)時為避免將MD系列與CRMR的引擎
echoat $n 搞錯，MD系列的備品跟其他船隻部位一起放在船屋儲藏室，而價格比較貴的CRMR的
echoat $n 引擎則放在這個管理者房間，翻找其他東西(search)時小心不要碰壞引擎。
echoat $n 　
echoat $n 羅盤及雜物：
echoat $n 　
echoat $n 魔導羅盤在每個船屋的抽屜中都放有備品，安裝(install)前請記得先鎖上(bolt)
echoat $n 合適的船舵，其他的雜物在兩間船屋基本都能找得到。
echoat $n 　
echoat $n 燃料及晶簇：
echoat $n 　
echoat $n 柴油放在碼頭下方，加油(refuel)時請順便留意一下有沒有其他油桶被海水沖走。
echoat $n 這點雖然跟上面反應過很多次了，但他們認為放在碼頭上不雅觀而遲遲沒有處理。
echoat $n 魔法晶簇(magic cluster)則以二十為單位用木箱裝著放在船屋中，準備使用之前
echoat $n 請再三確認引擎種類是不是CRMR系列，如果對著MD系列引發(trigger)晶簇，將會
echoat $n 再次重演十年前的爆炸悲劇，請各位千萬要小心。
~
