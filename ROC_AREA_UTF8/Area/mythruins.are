>room_mask east default~
if exitinfo($1) & 2
	force $n east
	break
endif
if is_qmark($n) & myth_elven_end 100001
or is_qmark($n) & myth_elven_end 200001
	force $n east
	break
endif
if is_qmark($n) >= myth_elven_wish 100005
	setdoor 1 vnum 21299
	force $n east
	break
endif
force $n east
~
>room_leave 2 100~
setdoor 1 vnum 21480
~
>room_command knock p door~
if exitinfo($1) & 2
	stun $n 15
	echoat $n 你伸手敲了敲木門。
	if is_qmark($n) & myth_elven_end 100001
	or is_qmark($n) & myth_elven_end 200001
		echoaround $n $N伸手敲了敲橡木門(oak door)，什麼事都沒發生....。
		callout 1 echoat $n 毫無回應。
		break
	endif
	if is_qmark($n) >= myth_elven_wish 100005
		modrvt d1 r 2
		at 21299 modrvt d3 r 2
		echoaround $n $N伸手敲了敲橡木門(oak door)，門打開了。
		callout 1 echoat $n 門打開了。
		break
	endif
	if is_qmark($n) == myth_elven_wish 100004
		modrvt d1 r 2
		at 21299 modrvt d3 r 2
		mod_qmark $n myth_elven_wish v0 = 5
		echoaround $n $N伸手敲了敲橡木門(oak door)，門打開了。
		callout 1 echoaround $n $N露出疑惑的表情。
		callout 1 echoat $n 門打開了，你聽見模糊不真實耳語「請進」....
	else
		echoaround $n $N伸手敲了敲橡木門(oak door)，什麼事都沒發生....。
		callout 1 echoat $n 毫無回應。
	endif
else
	echoat $n [0m[33m它已經是開著的了。[0m
endif
~
|
S
