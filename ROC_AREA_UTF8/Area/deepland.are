X dragon crystal~
>obj_rand 100~
if hitprcnt($n) < 10
	if is_equ_obj($n) == 15104
		if objval3($o) == 0
			echoat $n 雙心護身符發出一陣白光，治癒了你的傷勢
			oset self value3 = 1
			modhmv $n 02.9999 9999 0
		else
			echoat $n 雙心護身符發出一陣白光，治癒了你的傷勢
			modhmv $n 02.9999 9999 0
			echoat $n  雙心護身符隨著白光的消逝化成了飛灰...
			purge self
		endif
	endif
endif
~
