yell 因為那是所有生物的命運，哈哈哈哈！
mpforcer 9059 modrvt t0 = 30
if is_qmark($i) != dead_shore_relife
	if pcnum($) > 15
        	mpgreward exp $n 30 1200
	else
        	if pcnum($) > 10
                	mpgreward exp $n 30 1500
        	else
                	if pcnum($) > 5
                        	mpgreward exp $n 30 1800
                	else
                        	mpgreward exp $n 30 2000
			endif
                endif
        endif
endif
~
