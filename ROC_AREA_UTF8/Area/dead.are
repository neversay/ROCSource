if hitprcnt($i) < 30
	mpecho $I 的身體忽然開始扭曲，似乎開始變形了。
	mpecho $I 你感到他對你的攻勢越來越猛烈。
	skilldrv multihit $n
	skilldrv multihit $n
	skilldrv heavyhit $n
	if rand(30)
		say 死亡谷的死氣，幫助我恢復戰鬥力吧！
		mpat 5 c 2 'double heal'
		mpnowait
	endif
	if hitprcnt($i) < 50
		c 'double heal'
		mpnowait
		c powerball
		mpnowait
		c fireball
		mpnowait
	endif
endif
~
