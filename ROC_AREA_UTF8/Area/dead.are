mpnowait
c heal
mpnowait
if rand(50)
	if insameroom(necri)
		mpgroup necri self 0 1
		mpforce necry protect shore
	else
		if is_qmark($i) == dead_Summon_Necri
			if is_qmark($i) < dead_Summon_Necri 100005
  				say 耐克瑞(Necri)，前來幫助我吧！
  				mptransfer necri
  				mpgroup necry self 0 1
  				mpforce necri protect shore
   				mpforce necri mpkill $n
   				mpmod_qmark self dead_Summon_Necri v0 + 1
   			else
   				say 耐克瑞(Necri)，前來幫助我吧！
   				mpecho 雖然$I這麼喊叫著，卻不見耐克瑞(Necri)前來幫忙...
   			endif
   		else
   			mpadd_qmark self dead_Summon_Necri -1 0 0 0 1 1
   		  	say 耐克瑞(Necri)，前來幫助我吧！
  			mptransfer necri
  			mpgroup necry self 0 1
  			mpforce necri protect shore
   			mpforce necri mpkill $n
   		endif
   	endif
endif
~
>death_prog 100~
