#9060
逃出生天~
有可能嗎？你竟然可以看到陽光？這裡有一口井，偶爾會發出奇怪的光線。
~
0 860169 0
D3
~
~
0 -1 9059
>room_rand 30~
if hasdoor(5)
	if roomvalue($0) == 0
		echo 通往陰間的通道消失了....
		deldoor 5
		force 9001 echo 通往人世的通道消失了....
		force 9001 deldoor 4
	endif
endif
if pcnum($) > 0
	if rand(50)
		echo 這口井忽然發出一陣強烈的光線....。
		echo 瞬間你不知道你已經到了何處？
		transfer all 9070
	else
		echo 忽然一陣劇烈的震動....
		echo 下方忽然出現了一個通道....
		makedoor 5 通往陰間的通道 passage 0 0 9001
		force 9001 makedoor 4 通往人世的通道 passage 0 0 9006
		modrvt v0 = 1
		modrvt timer = 24
	endif
endif
~
