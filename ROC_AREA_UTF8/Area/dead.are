~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) <= dead_guardian 100005
	mpecho 你看到 $I 手上的那把劍飛到空中，然後忽然消失了....。
	mpjunk all.slasher
	if is_qmark($n) == dead_guardian
		mpmod_qmark $n dead_guardian v0 + 1
	else
		mpadd_qmark $n dead_guardian -1 1 0 0 0 1
	endif
else
	mpecho 你看到 $I 手上的那把劍飛到空中，卻又掉了下來....。
	mpdel_qmark $n dead_guardian v0 - 5
endif
if pcnum($) > 15
	mpgreward exp $n 30 1000
else
	if pcnum($) > 10
		mpgreward exp $n 30 1500
	else
		if pcnum($) > 5
			mpgreward exp $n 30 2000
		else
			mpgreward exp $n 30 3000
		endif
	endif
endif
