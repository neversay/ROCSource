#66013
maid-aw~
侍女(Maid)~
一個侍女(Maid)在這邊打掃房間。
~
她穿著連身的長裙，頭髮稍微往上盤了起來，長相也相當的
清純，甚至可以說是標緻的女孩，她現在正努力的清掃這間
房間，希望房間的主人會覺得更舒適一點。
~
1 0 1000 S
36 0 0 0d0+0 0d0+0
10000 0
0 8 2
R human~
>talk_prog topic~
	if ispc($n)
		if name($n) == coconet
			say 啊，主人您回來啦。
			giggle
			mpechoat $n －－介紹一下自己吧(self)
			mpechoat $n －－妳打掃的相當不錯呢(well done)
		else
			say 如果要找主人的話
				if insameroom(coconet)
					say 他就在旁邊呢。
					point coconet
				else
					say 他可能正忙著寫Code吧
					say 希望他不要太勞累了...
					worry
				endif
		endif
	endif
~
>talk_prog self~
	if ispc($n)
		if name($n) == coconet
			say 我是Kention派來的侍女，負責幫您打掃房間。
			say Kention說因為您平常相當的勞累，希望我能好好的工作。
			smile coconet
		else
			say 我是Kention派來的侍女，負責幫Coconet主人打掃房間。
			smile $n
		endif
	endif
~
>talk_prog p well done~
	if name($n) == coconet
		say 啊..謝，謝謝您的誇獎。
		blush
		mpechoat $n 她好像非常的高興。
		mpechoaround $n $I好像非常的高興。
	else
		say 謝謝。
		smile $n
	endif
~
|

