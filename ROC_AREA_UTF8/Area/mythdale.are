>talk_prog p arcana~
if is_qmark($i) == talking
	mpechoat $n 他正在跟人說話呢。
	break
endif
if primeattr($n) == 3
	if is_qmark($n) == dale_magi_quest
	or is_qmark($n) & myth_greenleaf_end 100002
		if sex($n) == 0
			tell $n 這位同志，您就別再開玩笑了吧！
			break
		endif
		if sex($n) == 1
			tell $n 這位大哥，您就別再開玩笑了吧！
			break
		endif
		if sex($n) == 2
			tell $n 這位大姐，您就別再開玩笑了吧！
			break
		endif
	else
		if mpnum($n) >= 4000
			mpadd_qmark self talking
			mpcallout 2 mpdel_qmark self talking
			mpadd_qmark $n dale_magi_quest -1 0 0 0 0 1
			mpechoat $n $I緊張地把你拉到一旁
			tell $n 這位客人，別這樣，大家都是同道中人，出來混口飯吃...
			mpcallout 1 mpechoat $n $I好像突然想到些什麼，又把轉頭過來。
			mpcallout 2 tell $n 來到這邊也是為了去迷斯卓諾遺跡探險嗎？(yes/no)
			mpcallout 2 tell $n 啊，對了！看你渾身散發出強大的魔力，好像很厲害。
		else
			mpechoat $n $I緊張地把你拉到一旁
			tell $n 這位客人，別這樣，大家都是同道中人，出來混口飯吃...
		endif
	endif
else
	if is_qmark($n) == dale_magi_quest
	or is_qmark($n) & myth_greenleaf_end 100002
		if sex($n) == 0
			tell $n 這位同志，您就別再開玩笑了吧！
			break
		endif
		if sex($n) == 1
			tell $n 這位大哥，您就別再開玩笑了吧！
			break
		endif
		if sex($n) == 2
			tell $n 這位大姐，您就別再開玩笑了吧！
			break
		endif
	else
		tell $n 什麼！你竟然不知道鼎鼎有名的阿爾克那嗎！
		tell $n 我的天，沒想到像您這樣一位冒險者竟然還沒有見識過這種好東西！
		tell $n 今天請您務必要好好在本店內帶點東西回去！
		mpcallout 1 mpechoat $n 雖然你看$I說得口沫橫飛，但還是問清楚(benefit)再來買吧？
	endif
endif
