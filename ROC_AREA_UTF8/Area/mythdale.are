	mpdel_qmark $n myth_dis_officer
	if is_qmark($n) == myth_greenleaf_end
		mpmod_qmark $n myth_greenleaf_end v1 | 4
	else
		mpadd_qmark $n myth_greenleaf_end -1 0 4 0 0 1
	endif
endif
if is_qmark($n) == myth_dis_officer 100005
	mpdel_qmark $n myth_dis_officer
	if is_qmark($n) == myth_greenleaf_end
		mpmod_qmark $n myth_greenleaf_end v1 | 4
	else
		mpadd_qmark $n myth_greenleaf_end -1 0 4 0 0 1
	endif
endif
if is_qmark($n) == myth_dis_officer 100006
	mpdel_qmark $n myth_dis_officer
	if is_qmark($n) == myth_greenleaf_end
		mpmod_qmark $n myth_greenleaf_end v1 | 4
	else
		mpadd_qmark $n myth_greenleaf_end -1 0 4 0 0 1
	endif
