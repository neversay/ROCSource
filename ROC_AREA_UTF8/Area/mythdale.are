		endif
		tell $n 這大小值二十萬，請點收。
		mpgold $n 200000
		mpcallout 1 tell $n 另外，這個上次從遺跡裡帶回來的東西就送給你吧。
		mpcallout 1 tell $n 感謝你長期的協助，讓我的貨源相當充足。
		mpcallout 2 mpoload 21071 $n 40 target
		mpcallout 2 mpechoat $n $I給了你一把長劍。
		mpcallout 3 wave $n
		mpcallout 3 tell $n 如果還有取得更多請繼續賣給我，希望往後的合作一樣愉快
		break
	endif
	if is_qmark($n) < dale_magi_quest 200010
		if rand(33)
			tell $n 這大小值十萬，請點收。
			mpgold $n 100000
			mpmod_qmark $n dale_magi_quest v1 + 1
			break
		else
			if rand(50)
				tell $n 這大小值十五萬，請點收。
				mpgold $n 150000
				mpmod_qmark $n dale_magi_quest v1 + 1
				break
