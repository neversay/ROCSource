~
>talk_prog recipe~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) & myth_family_recipe 300002
	break
endif
if is_qmark($n) == myth_family_recipe 200002
	mpadd_qmark self talking
	mpcallout 8 mpdel_qmark self talking
	mpadd_qmark $n myth_family_timer 12 0 0 0 0 1
	mpmod_qmark $n myth_family_recipe v1 = 3
	nod $n
	mpcallout 1 tell $n 請你稍等我一下。
	mpcallout 1 tell $n 沒錯，這個就是祖先的祖傳食譜。
	mpcallout 3 mpechoat $n $I將手鍊端放在掌心上，你看見一道光暈聚集在手鍊旁。
	mpcallout 4 mpechoat $n 光芒消失之後，琥珀中的頭髮似乎也減少了。
	mpcallout 5 mpechoat $n $I輕輕地點了點頭，但你仍無法瞭解發生了什麼事。
	mpcallout 6 tell $n 冒險者啊，謝謝你將這個物件帶回來。
	mpcallout 7 tell $n 對任何人來說，這就只是一般的飾品罷了。
	mpcallout 7 tell $n 這是我族的魔法傳承之物，如果沒有擁有相同血脈，
	mpcallout 8 tell $n 請給我半天時間，讓我把這些訊息(info)整理出來，再轉交予你吧。
	mpcallout 8 tell $n 但或許對於想要探索迷斯卓諾的你，這些資訊會有更高的價值。
	mpcallout 8 tell $n 這些訊息對於不是冒險者的我來說，沒有太大用處。
	mpcallout 8 tell $n 有一些資訊透過剛剛的能量傳遞給我。
endif
~
>talk_prog info~
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_family_timer
	tell $n 我還需要一些時間...
	break
endif
if is_qmark($n) & myth_family_recipe 300002
	break
endif
if is_qmark($n) == myth_family_recipe 200003
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n myth_family_recipe v1 = 4
	mpmod_qmark $n myth_family_recipe v2 | 2
	tell $n 請收下這個，這是整理過後的資訊。
	mpcallout 1 mpechoat $n $I拿出一張紙交給了你。
	mpcallout 1 mpoload 21026 $n 1 target
	mpcallout 2 tell $n 但在部分訊息中，輾轉提到了關於我們家族與另一支古老精靈家族的緣分；
	mpcallout 2 tell $n 這些文字是用古老的精靈語寫成的，我也沒有辦法完全瞭解。
	mpcallout 3 tell $n 在遊歷的路程上，透過歌唱的方式傳唱著古老的歷史。
	mpcallout 3 tell $n 他們是專門雲遊四海的冒險者。
	mpcallout 4 tell $n 也許能夠請他們幫忙解讀(translate)....
	mpcallout 6 mpskillexp $n 2000
	mpcallout 6 mpexp $n 50000
	mpcallout 6 bow
	mpcallout 6 tell $n 那麼，祝福你在繼續探索迷斯卓諾的旅程上，能夠一切平安...
endif
