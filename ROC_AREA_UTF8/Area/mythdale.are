		break
	endif
else
	if is_qmark($n) == seamstress_making_1
		if is_qmark($n) < myth_seamstress 100018
			mpjunk $o
			tell $n 謝謝你，我收到了。
			mpmod_qmark $n myth_seamstress v0 + 1
