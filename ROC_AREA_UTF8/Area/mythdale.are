>talk_prog yes~
if is_qmark($i) == talking
	mpechoat $n 他正在說話呢。
	break
endif
if is_qmark($n) == dale_magi_quest 100005
or is_qmark($n) == dale_magi_quest 100100
or is_qmark($n) == dale_magi_quest 100200
or is_qmark($n) == dale_magi_quest 100300
	mpmod_qmark $n dale_magi_quest v0 = 6
	tell $n 對嘛，我就知道你是懂的呀！
	tell $n 那麼看在你我心心相印，一見如故的份上....
	tell $n 如果在遺跡中找到帶魔力的寶石、晶體之類的，我都會用高價跟你收購啦。
	tell $n 免得你賣不掉還被人砍價！
	tell $n 不如找到後拿給我，直接高價跟你收，你我都高興！
	tell $n 那麼如果有發現就直接交給我，我會直接拿現金給你。
endif
if is_qmark($n) == dale_magi_quest 100004
	mpadd_qmark self talking
	mpcallout 1 mpdel_qmark self talking
	mpmod_qmark $n dale_magi_quest v0 = 5
	tell $n 能懂就好。
	tell $n 那麼我接下來要講重點了，其實我來這其中一個目的就是為了收集精靈的魔法寶石。
	tell $n 不過那群貪得無厭的冒險者找到的寶石一個賣得比一個貴啦。
	tell $n 當然，他們壓根就不懂魔法根本不知道這些東西的價值嘛，就只會敢亂喊價。
	tell $n 如果是我啦，一定不會賣這樣啦！你說對不對？
	mpcallout 1 mpechoat $n 不過聽他講得自己很有本事，要不要他為什麼不自己去撿一些？
	mpcallout 1 mpechoat $n 聽他抱怨一堆，原來只是個想拿不到貨的商人想找你討拍(yes/no)。
endif
if is_qmark($n) == dale_magi_quest 100003
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n dale_magi_quest v0 = 4
	tell $n 能明白就好。
	tell $n 被搜索出的魔法物品中又以寶石類的魔法物品賣價最高啦。
	tell $n 理由很簡單咩，就算買方不是像我們這種懂魔法的傻逼，
	tell $n 看見很亮很漂亮的寶石一樣會掏錢買單啦，因為通貨上有價值嘛。
	mpcallout 1 tell $n Do You Understand？
	mpcallout 2 mpechoat $n 但為了獲得消息還是適當回應一下好了。(yes/no)
	mpcallout 2 mpechoat $n 他講一堆幹話還絡英文讓你很想揍他。
endif
if is_qmark($n) == dale_magi_quest 100002
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n dale_magi_quest v0 = 3
	tell $n 很好，非常好。
	tell $n 那麼你應該也發現到重點了吧？重點就是這些魔法物品啦！
	tell $n 暗黑勢力血洗迷斯卓諾是短時間的事情，匆忙逃難總不可能帶著所有家當跑路呀！
	tell $n 更不會有閒功夫銷毀魔法物品，所以這些來不及帶走的魔法物品當然都留在城中囉。
	tell $n 所以冒險者都把這些東西當作目標。
	mpcallout 1 mpechoat $n 你發現他講的內容真得很多沒重點的廢話。
	mpcallout 2 tell $n 懂了嗎？(yes/no)
endif
if is_qmark($n) == dale_magi_quest 100001
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n dale_magi_quest v0 = 2
	tell $n 所以你知道遺跡中最有價值的是什麼嗎？我看是不知道吧！
	tell $n 不過，看在你我同樣以魔法討生活的份上，就破例告訴你啦。
	tell $n 你也知道精靈族精通魔法，而迷斯卓諾的精靈族更是其中的佼佼者。
	tell $n 在所有魔法中他們最擅長把魔法封在物品之中，也就是魔法物品啦！
	mpcallout 1 mpechoat $n 你發現他講了一堆話都沒講到重點。
	mpcallout 2 tell $n 了解嗎？嗯？(yes/no)
endif
if is_qmark($n) == dale_magi_quest 100000
	mpmod_qmark $n dale_magi_quest v0 = 1
	tell $n 喔喔，果然是這樣呀！
	tell $n 現在還會來到這裡的不是為了賣東西的商人就是冒險者。
	tell $n 而大部分的冒險者把作為進入遺跡探險尋寶的中繼站。
	tell $n 畢竟裡面可是有精靈遺留下的龐大財產呀！一夜致富不是夢！
	tell $n 我看你也是打算來這裡大撈一筆的吧？(yes/no)
	giggle
endif
