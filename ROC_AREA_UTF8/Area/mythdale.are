0 0 21032
>room_rand 100~
if roomvalue($0) == 1
	break
endif
if rand(7)
	if rmobcount(21044) > 0
		if rmobcount(21040) > 0
		or rmobcount(21041) > 0
			modrvt v0 = 1
			echo 周圍傳來騎士們的竊竊私語...
			callout 1 echo 「喂，聽說了嗎？你們這次任務好像是森林探勘之類的....」
			callout 2 echo 「真的嗎？這次還真幸運呢！」
			callout 3 echo 「幸運嗎...前陣子不是有人在森林中毒後被抬回來，雖然沒死但也半殘」
			callout 4 echo 「但至少人還活著...比起死亡率高達七成的遺跡探勘來得好」
			callout 5 echo 「唉，說的也是呢....」
			callout 6 echo 「不聊了，等下被隊長罵就慘囉。回來再找你去喝一杯」
			callout 7 echo 「啊啊，祝你好運」
			callout 50 modrvt v0 = 0
		endif
	endif
endif
~
