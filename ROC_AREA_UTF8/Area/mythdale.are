>all_greet_prog 100~
if is_qmark($n) > myth_templar_enemy 100010
	mpmod_qmark $n myth_templar_enemy v0 = 10
endif
~
>talk_prog topic~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 邪惡之人！受死吧！
	mpkill $n
	break
endif
if is_qmark($n) & myth_templar_end 100004
or is_qmark($n) & myth_templar_end 200004
	break
endif
if is_qmark($n) > myth_templar_SP 200002
	break
endif
if is_qmark($i) == myth_templar_SP_rumor
	if is_qmark($n) == myth_templar_SP 100002
		if is_qmark($n) == myth_templar_SP 200001
			mpadd_qmark self talking
			mpcallout 1 mpdel_qmark self talking
			mpmod_qmark $n myth_templar_SP v1 = 2
			mpechoat $n $I喃喃自語「原來是去森林呀，呼...這次能活著回來了。」
			mpcallout 1 mpechoat $n 你是否要告訴他隊長為何焦慮不安？
		else
			if rand(50)
				mpechoat $n $I喃喃自語「原來是去森林呀，呼...這次能活著回來了。」
			else
				tell $n 拜託不要找我搭話，隊長在前面看著，會害我被罵的！
			endif
		endif
	else
		if rand(50)
			mpechoat $n $I喃喃自語「原來是去森林呀，呼...這次能活著回來了。」
		else
			tell $n 拜託不要找我搭話，隊長在前面看著，會害我被罵的！
		endif
	endif
else
	if rand(50)
		mpechoat $n 他認真的整裝，沒空鳥你。
	else
		tell $n 拜託不要找我搭話，隊長在前面看著，會害我被罵的！
	endif
endif
~
>talk_prog anxiety~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 你胡亂說什麼，可恨的教團之敵！
	mpkill $n
	break
endif
if is_qmark($n) & myth_templar_end 100004
or is_qmark($n) & myth_templar_end 200004
