	mpjunk $o
	mpmod_qmark $n myth_armawp_quest v1 = 4
	tell $n 好了，收下你的錢就快走吧，冒險者。
	mpgold $n 1000000
	tell $n 剩下是我的事，這裡沒你的事了。
	if is_qmark($n) == myth_armawp_quest 100004
		mpcallout 1 mpechoat $n 難道矮人的個性都那麼糟嗎？
		mpcallout 1 mpechoat $n 你覺得這矮人討厭的性格跟先前接觸的矮人防具匠如出一轍。
	endif
	if rand(10)
		mpcallout 15 mpecho $I在架子放上一把新的武器。
		mpcallout 15 mpoload 21077 40
	else
		if rand(25)
			mpcallout 25 mpecho $I在架子放上一把新的武器。
			mpcallout 25 mpoload 21077 40
		else
			if rand(50)
				mpcallout 40 mpecho $I在架子放上一把新的武器。
				mpcallout 40 mpoload 21077 40
			else
				mpcallout 50 mpecho $I在架子放上一把新的武器。
				mpcallout 50 mpoload 21077 40
			endif
		endif
	endif
else
	tell $n 你要把這東西送給我？多謝！
endif
