	if is_qmark($i) > apple_count 100000
		mpmod_qmark self apple_count v0 - 1
		mpoload 21028 $n 1 target
		mpechoat $n $I給了你一顆熟透的蘋果。
	else
		tell $n 現在沒有貨喔。
		mpgold $n 10000
	endif
else
	tell $n 我雖然不能賣東西，但是接受捐款是合法的！
	bow $n
	break
endif
