					mpgold $n 300000
					mpmod_qmark $n dale_magi_quest v1 + 1
					break
				endif
			endif
		endif
	endif
endif
if is_qmark($n) == dale_magi_quest 100600
	if is_qmark($n) == dale_magi_quest 300010
		mpdel_qmark $n dale_magi_quest
		if is_qmark($n) == myth_greenleaf_end
			mpmod_qmark $n myth_greenleaf_end v0 | 2
		else
			mpadd_qmark $n myth_greenleaf_end -1 2 0 0 0 1
		endif
		tell $n 這樣就夠了，感謝你的贊助！
		mpcallout 1 tell $n 上次我從遺跡的墓碑中借來的東西就送給你吧。
		mpcallout 2 mpoload 21072 $n 40 target
		mpcallout 2 mpechoat $n $I給了你一把短刀。
		mpcallout 3 tell $n 現在讓我來好好研究怎樣用這寶石提升魔力量。
		mpcallout 3 tell $n 等我成功後，我一定會再好好的報答你的！
		mpcallout 4 tell $n 另外，你如果有取得多的寶石也可以拿來賣我，我會依大小估價的。
		mpcallout 5 wave $n
		break
	endif
	if is_qmark($n) < dale_magi_quest 300010
		tell $n 我還需要更多，麻煩你再拿更多來。
		mpmod_qmark $n dale_magi_quest v2 + 1
		break
	else
		? $n
		drop $o
		break
	endif
endif
