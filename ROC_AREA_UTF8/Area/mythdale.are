>talk_prog p inherit~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300005
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	tell $n 這就是有趣的地方了。
	mpcallout 1 tell $n 讓弟弟也失去繼承權。
	mpcallout 1 tell $n 繼承無望又嫉妒弟弟的權力，憤而把鎚子弄丟。
	mpcallout 1 tell $n 有些人說，因為哥哥的技術比不上弟弟。
	mpcallout 2 tell $n 弟弟不滿這結果，偷偷把鎚子藏起來。
	mpcallout 2 tell $n 以往不成文的規定會讓年紀較大者優先繼承。
	mpcallout 2 tell $n 也有人說，能力不分軒輊的情況下。
	mpcallout 3 tell $n 好讓他們能在搞垮後將其納入囊下。
	mpcallout 3 tell $n 收買了落敗者把鎚子藏起來，讓家族失去繼承者而衰敗。
	mpcallout 3 tell $n 還有人說，是堂兄弟覬覦他們家族的領地。
	mpcallout 4 tell $n 但把這些當成茶餘飯後的八卦聊，也算種樂趣呢。
	mpcallout 4 tell $n 總之，繼承事件的真相(inherit)也只有當事人才知道吧。
	mpcallout 5 giggle
endif
