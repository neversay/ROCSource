endif
if is_qmark($n) == myth_templar_end
	if is_qmark($n) == myth_templar_SP 200002
		mpadd_qmark self talking
		mpcallout 5 mpdel_qmark self talking
		mpmod_qmark $n myth_templar_SP v0 = 0
		mpmod_qmark $n myth_templar_SP v1 = 3
		tell $n 你說什麼？！這次的任務是遺跡港口！
		tell $n 這跟聽到的不一樣呀....
		mpcallout 1 glare
		mpcallout 3 look $n
		mpcallout 4 tell $n hmm...你看起來是個有能力的冒險者。
		mpcallout 5 tell $n 有件事(thing)想委託你幫忙，願意嗎？
	else
		if is_qmark($n) == myth_templar_SP
			mpadd_qmark self talking
			mpcallout 2 mpdel_qmark self talking
			tell $n 嗯，我也不清楚。
			tell $n 確實給人的感覺跟平常不太一樣。
			tell $n 也許是....
			mpcallout 2 tell $n 任務上有什麼變因？！
		else
			mpadd_qmark self talking
			mpcallout 2 mpdel_qmark self talking
			tell $n 嗯，我也不清楚。
			tell $n 確實給人的感覺跟平常不太一樣。
			tell $n 也許是....
			mpcallout 2 tell $n 昨晚沒睡好？
		endif
	endif
else
	tell $n 拜託不要找我搭話，隊長在前面看著，會害我被罵的！
endif
