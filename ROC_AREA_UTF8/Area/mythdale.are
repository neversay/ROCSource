>talk_prog thing~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 對，有件必須作的事。
	say 那就是消滅教團之敵！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP 200000
	tell $n 抱歉，之前的事當我沒說過...因為....
	tell $n 隊長正在看著這邊呀...！！
	break
endif
if is_qmark($n) == myth_templar_SP 200003
	mpadd_qmark self talking
	mpcallout 4 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v1 = 4
	tell $n 如果事情就像你說的一樣，這次任務肯定是九死一生。
	tell $n 畢竟沒人有自信能從惡魔的爪下存活下來。
	tell $n 更何況在遺蹟中要面對的還是一大群的惡魔呀！
	tell $n 而且還要在沒準備的情況下前往遺蹟，這種事我想都不敢想。
	mpcallout 2 tell $n 而要降低遇到惡魔的機率最快的方法就是降低惡魔的數量。
	mpcallout 2 tell $n 如果進去遺蹟後不遇到大量的惡魔，肯定能提高存活率吧？
	mpcallout 2 tell $n 所以我在想....
	mpcallout 4 tell $n 像你這樣的冒險者，要消滅個五隻、十隻惡魔肯定也不是什麼難事對吧？(yes)
endif
~
>talk_prog yes~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 對什麼對。
	say 你活著就不對呀！
