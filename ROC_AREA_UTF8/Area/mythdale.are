>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 0 1
~
>talk_prog topic~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
mpadd_qmark self talking
mpcallout 2 mpdel_qmark self talking
if rand(50)
	wink $n
	mpcallout 1 tell $n 據說能夠撫慰遠遊之人騷動的靈魂呢。
	mpcallout 1 tell $n 想點首歌嗎？我的家族遊歷各地，透過詩歌傳唱著歷史唷～
	mpcallout 2 smile $n
else
	mpechoat $n $I輕輕地唱起歌來。
	mpcallout 1 mpechoat $n 藍影裹憂傷，古頁載哀愁。
	mpcallout 1 mpechoat $n 北方失落處，城牆俱頹傾，
	mpcallout 2 smile $n
endif
~
>talk_prog translate~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) & myth_elven_end 100001
or is_qmark($n) & myth_elven_end 200001
	break
endif
if is_qmark($n) == myth_elven_wish
	break
endif
if is_inv_obj($n) == 21026
	if is_qmark($n) & myth_family_recipe 300002
		mpadd_qmark self talking
		mpcallout 5 mpdel_qmark self talking
		mpadd_qmark $n myth_elven_wish -1 0 0 0 0 1
		hmm $n
		mpcallout 1 look $n
		mpcallout 2 tell $n 既然瞭解這是我們一族不願回溯的過往，那何苦又來追逐這些回音呢？
		mpcallout 2 tell $n 你已經大致知道一些關於我族與迷斯卓諾的歷史了吧。
		mpcallout 3 mpecho $I別過頭去，眼神中若有所思。
		mpcallout 5 ponder
		mpcallout 5 tell $n 就交托給回音本身(itself).....
		mpcallout 5 tell $n 也罷，這或許不是我們之中的任何一位能夠決定的。
	else
		pat $n
		tell $n 你還有一段路要走吶，孩子。
		tell $n 往北邊的遺跡探索吧，那古老的，毀壞的，墮落之城。
	endif
else
	? $n
	tell $n 你想請我翻譯什麼？
endif
~
>talk_prog itself~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == myth_elven_wish 100000
	mpadd_qmark self talking
	mpcallout 1 mpdel_qmark self talking
	mpmod_qmark $n myth_elven_wish v0 = 1
	tell $n 你能獲得這件物品，也許不是偶然。
	mpcallout 1 tell $n 引領我輩從歷史中記取關於自我沉溺的教訓(lesson)。
	mpcallout 1 tell $n 你身上的書頁，正是先祖所遺留給後世的訊息。
endif
~
>talk_prog lesson~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == myth_elven_wish 100001
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n myth_elven_wish v0 = 2
	tell $n 根據書頁的記載，當時的迷斯卓諾盛世如日當中，就和風之大陸的史卡拉貝齊名。
	mpcallout 1 tell $n 因著該地對於各種經驗與文化的開放與好奇，整個城市有著極快的進步與發展。
	mpcallout 2 tell $n 並逐漸在其中生根發芽，最終招來了北方黑暗的邪惡(evil)。
	mpcallout 2 tell $n 隨著區域的壯大，貪婪、傲慢與嫉妒也在迷斯卓諾城內布下種子，
endif
~
>talk_prog evil~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == myth_elven_wish 100002
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n myth_elven_wish v0 = 3
	tell $n 那份邪惡無法用言語訴說...。
	mpcallout 1 tell $n 就應該明瞭那份邪惡已在土壤中紮根，並完全籠罩著整個區域。
	mpcallout 1 tell $n 你曾進入墮落後的迷斯卓諾城，
	mpcallout 2 tell $n 留下了唯一的純淨之念(thought)。
	mpcallout 2 tell $n 我的先祖們無法從中逃脫，只能在最後一刻善盡身為歷史傳承者的責任，
endif
~
>talk_prog thought~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == myth_elven_wish 100003
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpmod_qmark $n myth_elven_wish v0 = 4
	tell $n 命運引領我前來這裡等待，
	mpcallout 1 tell $n 你獲得了先祖的文字，而這些文字引導著我們回到一切的開端。
	mpcallout 2 tell $n 帶著它回到迷斯卓諾吧，冒險者！
	mpcallout 3 tell $n 並時刻保持著專注與謙卑，牆中之境的真實面貌將為你展露。
endif
~
