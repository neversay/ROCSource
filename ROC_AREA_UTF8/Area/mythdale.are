	tell $n 抱歉，目前還沒研究出什麼成果呢...
	break
endif
if is_qmark($n) == stresearch_timer
	tell $n 我就快完成了....再等一段時間。
	break
endif
if is_qmark($n) == myth_seamstress 100005
	mpmod_qmark $n myth_seamstress v0 = 6
	tell $n 啊，是你呀！我的研究終於有點進展(progress)了...
endif
~
>talk_prog progress~
if is_qmark($n) == myth_seamstress 100006
	mpmod_qmark $n myth_seamstress v0 = 7
	tell $n 這個特殊材質確實可以在一些裝備上發揮作用，增強裝備的能力。
	tell $n 不過，不知是否和這個地區的魔性有關，這樣的功能似乎只侷限某些裝備上呢。
	mpcallout 1 tell $n 只可惜你辛苦蒐集的素材也被我用光了，沒能夠拿出成品給你看看。
	mpcallout 1 tell $n 一直嘗試到某條腰帶(belt)，才看見些許的成功跡象。
	mpcallout 1 tell $n 我用了手邊有的素材逐一嘗試，幾乎都失敗了。
endif
~
>talk_prog belt~
if is_qmark($n) == myth_seamstress 100007
	mpmod_qmark $n myth_seamstress v0 = 8
	mpmod_qmark $n myth_seamstress v1 = 0
	tell $n 真是不好意思，我也忘了這是從哪兒來的，但我想這是我到了迷霧之島後，才蒐集到的材料。
	tell $n 只可惜，我不懂裝備的事情，這樣的材料侷限性也是少見的，
	tell $n 你或許需要問問谷裡的其他人，多打聽關於特殊素材(area special)的事呢。
	tell $n 那麼，祝你好運啦，我也會繼續努力研究的。
endif
~
>talk_prog status~
if is_qmark($n) == seamstress_making_timer
	tell $n 抱歉，東西還沒完成，再給我一點時間。
	break
endif
if is_qmark($n) == myth_seamstress 100019
	if is_qmark($n) == seamstress_making_1
		mpdel_qmark $n seamstress_making_1
		mpmod_qmark $n myth_seamstress v0 = 20
		tell $n 好了，這是成品！
		tell $n 謝謝你的辛勞，這件成品就送給你吧。
		mpoload 21057 $n 36 target
		mpcallout 1 tell $n 雖然還不完全明白素材的性質，但繼續研究下去總有一天會完全了解。
		mpcallout 1 tell $n 感謝你的協助，讓我能夠研究這素材。
		mpcallout 2 mpskillexp $n 20000
		mpcallout 2 mpexp $n 50000
		mpcallout 2 smile $n
		mpcallout 2 tell $n 祝你在探險的旅途上一路平安順遂。
		break
	endif
endif
if is_qmark($n) == myth_seamstress 100020
	if is_qmark($n) == seamstress_making_2 100001
		mpdel_qmark $n seamstress_making_2
		mpmod_qmark $n myth_seamstress v0 = 21
		tell $n 好了，這是成品！
		tell $n 謝謝你的辛勞，這件成品就送給你吧。
		mpoload 21050 $n 38 target
		mpcallout 1 smile $n
		mpcallout 1 tell $n 感謝你讓我能更深入了解這素材。
	endif
	if is_qmark($n) == seamstress_making_2 100002
		mpdel_qmark $n seamstress_making_2
		mpmod_qmark $n myth_seamstress v0 = 21
		tell $n 好了，這是成品！
		tell $n 謝謝你的辛勞，這件成品就送給你吧。
		mpoload 21051 $n 38 target
		mpcallout 1 smile $n
		mpcallout 1 tell $n 感謝你讓我能更深入了解這素材。
	endif
endif
if is_qmark($n) == myth_seamstress 100021
	if is_qmark($n) == seamstress_making_3 100001
		if is_qmark($n) == myth_greenleaf_end
			mpmod_qmark $n myth_greenleaf_end v0 | 1
		else
			mpadd_qmark $n myth_greenleaf_end -1 1 0 0 0 1
		endif
		mpdel_qmark $n seamstress_making_3
		mpdel_qmark $n myth_seamstress
		tell $n 雖然把成品完成了...
		tell $n 不過，這件成品好像有著令人不安的感覺呢...
		mpechoat $n $I把裝備交給你。
		mpoload 21052 $n 38 target
		mpcallout 2 wave $n
		mpcallout 2 tell $n 希望你在探險的旅途上一路平安順遂。
		mpcallout 2 tell $n 你在使用的時候務必小心哪.... 
		mpcallout 2 tell $n 這裝備似乎跟這地區的黑暗力量相呼應著，
	endif
	if is_qmark($n) == seamstress_making_3 100002
		if is_qmark($n) == myth_greenleaf_end
			mpmod_qmark $n myth_greenleaf_end v0 | 1
		else
			mpadd_qmark $n myth_greenleaf_end -1 1 0 0 0 1
		endif
		mpdel_qmark $n seamstress_making_3
		mpdel_qmark $n myth_seamstress
		tell $n 雖然把成品完成了...
