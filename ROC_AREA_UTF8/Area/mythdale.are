>give_prog 21325~
if is_qmark($n) & myth_family_recipe 300002
	break
endif
if is_qmark($n) == myth_family_recipe 200001
	mpjunk $o
	mpadd_qmark self talking
	mpcallout 1 mpdel_qmark self talking
	mpmod_qmark $n myth_family_recipe v1 = 2
	mpechoat $n $I仔細地端詳著你交給他的物品。
	mpechoaround $n $I仔細地端詳著$N交給他的物品。
	mpcallout 1 tell $n 這個....難道就是......先祖們的.....(recipe)
