~
>all_greet_prog 100~
if is_qmark($n) > myth_templar_enemy 100010
	mpmod_qmark $n myth_templar_enemy v0 = 10
endif
~
>talk_prog topic~
if isfight($i)
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 教團之敵，看招！
	mpkill $n
else
	tell $n 往東走就是迷斯卓諾森林，請小心自身安全。
endif
~
>talk_prog worrisome~
if isfight($i)
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 教團之敵，看招！
	mpkill $n
	break
endif
if is_qmark($n) & myth_templar_end 100002
	tell $n 謝謝你的幫忙！我的好友已經順利返家休養了。
	tell $n 但迷斯卓諾的邪氣一天沒消失，我就無法鬆懈。
	break
endif
if is_qmark($n) & myth_templar_end 200002
	tell $n 給你個忠告，不要小看迷斯卓諾的邪氣。
	tell $n 不然會像我那再也沒回來的好友一樣。
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) & myth_templar_end 100001
or is_qmark($n) & myth_templar_end 200001
	if is_qmark($n) != myth_templar_rescue
		mpadd_qmark self talking
		tell $n 你身上的氣息.....
		mpcallout 1 think
		mpcallout 2 tell $n 能夠順利離開，想必你也有些能耐。
		mpcallout 2 tell $n 看來你已進入過遺跡之中吧。
		mpcallout 3 tell $n 只是我的朋友...他卻沒能順利回來(came back).....。
		mpcallout 3 mpadd_qmark $n myth_templar_rescue -1 0 0 0 0 1
		mpcallout 3 mpdel_qmark self talking
	else
		tell $n 我很擔心朋友的安危...卻又不能擅離職守....
	endif
else
	tell $n 迷斯卓諾總是散發出一股令人不安的氣息。
endif
~
>talk_prog p came back~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100000
	mpadd_qmark self talking
	tell $n 你應該有聽說過，教團前陣子徵召一批好手，組成調查隊多次前往遺跡探索。
	mpcallout 1 tell $n 在嘗到甜頭後，教團上層決定朝遺跡深處進行探索...
	mpcallout 1 tell $n 並且帶回的成果也相當豐碩。
	mpcallout 1 tell $n 剛開始在遺跡的外圍區域，調查進行得還算順利，前後大概進出五、六次，都沒什麼人傷亡，
	mpcallout 2 tell $n 當然生死下落也就此不明了。
	mpcallout 2 tell $n 事情發生的過程實在太快，指揮官還沒來得及掌握情況，全隊就已經完全失聯，
	mpcallout 2 tell $n 然而隨著探索逐漸地深入，他們卻突然一個接著一個的斷了音訊....
	mpcallout 3 tell $n 而在那隊精英裡，其中一位是我的好友(friend)....
	mpcallout 3 mpmod_qmark $n myth_templar_rescue v0 = 1
	mpcallout 3 mpdel_qmark self talking
endif
~
>talk_prog friend~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100001
	mpadd_qmark self talking
	tell $n 他最後一次出發時，我也是站在這裡目送他離開。
	tell $n 那時，他心神不寧地透露一些關於遺跡的訊息給我。
	mpcallout 2 tell $n 這次探勘地點就在東側區域沼澤內，而他所負責的是附近的巨石高地(rock)。
	mpcallout 2 tell $n 特別是在東側區域，沼澤化的相當明顯，且不時傳來不明生物的低吼聲。
	mpcallout 2 tell $n 他告訴我，進入城牆內之後，舉目所見都是深淺不一的沼澤。
	mpcallout 3 tell $n 也許當時他是在向我求助吧。而我居然沒能發現到....
	mpcallout 3 tell $n 說到這裡，我明顯發覺到他身體因不安而微微顫抖。
	mpcallout 4 sigh
	mpcallout 4 mpmod_qmark $n myth_templar_rescue v0 = 2
	mpcallout 4 mpdel_qmark self talking
endif
~
>talk_prog rock~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100002
	mpadd_qmark self talking
	tell $n 沒錯，就是在這次之後，他也如同其他同伴一樣，再也沒有回到這裡。
	tell $n 若不是我無法脫離我的崗位，否則，我肯定立刻出發前去尋找他吧！
	tell $n 我直到現在還是不敢相信，他就這麼消失在遺跡之中了...
	mpcallout 2 look $n
	mpcallout 3 tell $n 口中的巨石高地看看嗎？(yes/no)
	mpcallout 3 tell $n 我無法離開我應堅守的崗位，但你可願意替代我，前往我朋友
	mpcallout 3 tell $n 冒險者啊，你既然曾經進入那個區域，想必也有著一定實力吧。
	mpcallout 3 mpmod_qmark $n myth_templar_rescue v0 = 3
	mpcallout 3 mpdel_qmark self talking
endif
~
>talk_prog yes~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100003
	mpadd_qmark self talking
	tell $n 你願意幫忙真是太好了！
	tell $n 在你離開前，我這裡還有個東西要交給你。
	mpcallout 1 mpoload 21068 $n 1 target
	mpcallout 1 mpechoat $n $I給了你一枚徽章。
	mpcallout 2 tell $n 帶上它，也許對於找人會有所幫助。
	mpcallout 2 tell $n 這是我們教團的徽章，只要距離夠近，相同的徽章彼此會發出共鳴。
	mpcallout 3 tell $n 願主神保佑你一路平安，也了卻我一樁心願。
	mpcallout 3 tell $n 無論你最後有什麼發現，都請把消息帶回來給我。(report)
	mpcallout 3 mpmod_qmark $n myth_templar_rescue v0 = 4
	mpcallout 4 addoil $n
	mpcallout 4 mpdel_qmark self talking
endif
~
>talk_prog no~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100003
	mpdel_qmark $n myth_templar_rescue
	mpmod_qmark $n myth_templar_end v1 | 2
	tell $n 的確，迷斯卓諾地區令人聞之生畏。
	tell $n 不願踏入這未知境地也是明智之舉。
	tell $n 無論如何，謝謝你傾聽我的苦惱。
	bow $n
endif
~
>talk_prog report~
if is_qmark($n) == myth_templar_enemy
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_rescue 100004
or is_qmark($n) == myth_templar_rescue 100005
	mpadd_qmark self talking
	mpmod_qmark $n myth_templar_end v1 | 2
	mpdel_qmark $n myth_templar_rescue
	mpechoat $n 你向$I報告發現到的結果。
	mpcallout 1 tell $n 果然找不到人嗎....
	mpcallout 2 sigh
	mpcallout 3 tell $n 我有空會再花時間去找看看.....
	mpcallout 3 tell $n 雖然這結果不盡人意，但還是感謝你願意幫忙。
	mpcallout 4 tell $n 至於謝禮，我只有些微不足道的東西。
	mpcallout 5 mpskillexp $n 2500
	mpcallout 5 mpexp $n 30000
	mpcallout 5 mpgold $n 100000
	mpcallout 5 bow $n
	mpcallout 5 mpdel_qmark self talking
endif
if is_qmark($n) == myth_templar_rescue 100006
or is_qmark($n) == myth_templar_rescue 100007
	if is_qmark($n) == myth_templar_rescue 300001
		mpadd_qmark self talking
		mpmod_qmark $n myth_templar_end v0 | 2
		mpdel_qmark $n myth_templar_rescue
		mpechoat $n 你向$I報告發現到的結果。
		mpcallout 1 hmm
		mpcallout 2 tell $n 我剛才也看到他從森林裡走出來，不過他帶有重傷在身，先回去療養。
		mpcallout 3 tell $n 不然現在早就成為地上的一具乾屍了！
		mpcallout 3 tell $n 他回家前有跟我提到全靠你不離不棄的幫助，他才能順利離開遺跡。
		mpcallout 4 giggle
		mpcallout 5 tell $n 我想這件教會賜予榮譽之人的物品，你比我更有資格擁有。
		mpcallout 5 tell $n 多虧你一路上的堅持，才能讓我的好友再次回到心愛的家人身邊。
		mpcallout 6 mpskillexp $n 5000
		mpcallout 6 mpexp $n 50000
		mpcallout 6 mpgold $n 300000
		mpcallout 6 mpoload 21070 $n viclv target
		mpcallout 6 mpechoat $n $I把手上的臂環交給了你。
		mpcallout 7 wave $n
		mpcallout 7 tell $n 再會了，勇敢的冒險者。
		mpcallout 7 mpdel_qmark self talking
	endif
	if is_qmark($n) == myth_templar_rescue 300002
		mpadd_qmark self talking
		mpmod_qmark $n myth_templar_end v1 | 2
		mpdel_qmark $n myth_templar_rescue
		mpechoat $n 你向$I報告發現到的結果。
		mpcallout 1 tell $n 果然還是難逃大難呀....
		mpcallout 2 glare
		mpcallout 3 tell $n 這樣也能盡快處理好他的後事，也免得懸著一顆心不上不下的。
		mpcallout 3 tell $n 總之，這件事也算告一段落了，至少還能發現遺體。
		mpcallout 4 sigh
		mpcallout 5 tell $n 感謝你肯花時間幫忙找人，我只有些微不足道的東西能當謝禮。
		mpcallout 6 mpskillexp $n 5000
		mpcallout 6 mpexp $n 50000
		mpcallout 6 mpgold $n 200000
		mpcallout 6 mpoload 21069 $n viclv target
		mpcallout 6 mpechoat $n $I給了你一副臂甲。
		mpcallout 7 bow $n
		mpcallout 7 mpdel_qmark self talking
	endif
	if is_qmark($n) == myth_templar_rescue 300003
		mpadd_qmark self talking
		mpmod_qmark $n myth_templar_end v1 | 2
		mpdel_qmark $n myth_templar_rescue
		mpechoat $n 你向$I報告發現到的結果。
		mpcallout 1 tell $n 這一切都是天命，他注定沒辦法逃離迷斯卓諾的詛咒。
		mpcallout 1 tell $n 人找到了可是卻沒有足夠的體力逃離遺跡呀....
		mpcallout 2 glare
		mpcallout 3 tell $n 總之，我會盡快處理好他的後事。
		mpcallout 4 tell $n 不過我只有些微不足道的東西能給你。
		mpcallout 4 tell $n 雖然發生這種悲劇，但你幫忙找人的謝禮還是不能少。
		mpcallout 5 mpskillexp $n 5000
		mpcallout 5 mpexp $n 50000
		mpcallout 5 mpgold $n 200000
		mpcallout 5 mpoload 21069 $n viclv target
		mpcallout 5 mpechoat $n $I給了你一副臂甲。
		mpcallout 6 bow $n
