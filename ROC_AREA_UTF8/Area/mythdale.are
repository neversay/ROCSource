>room_enter 127 100~
if is_qmark($n) != myth_dis_officer 100002
	break
endif
if is_qmark($n) & myth_dis_officer 300001
	if is_qmark($n) !& myth_dis_officer 200004
		echoat $n 你腳邊傳來鬆動木頭地板的吱吱嘎嘎聲。
	endif
endif
if is_qmark($n) !& myth_dis_officer 200001
	mod_qmark $n myth_dis_officer v1 | 1
	echoat $n 看來長官不在家，或許能在房子中找出(search)長官去向的線索。
endif
~
>room_command search default~
if is_qmark($n) != myth_dis_officer 100002
	echoat $n 什麼？
	break
endif
if is_qmark($n) > myth_dis_officer 100002
	echoat $n 現在沒有必要這樣作。
	break
endif
if is_qmark($n) == myth_dis_officer 100002
	stun $n 30
	echoat $n 你開始尋找這個房子中讓你感興趣的地方....
	echoaround $n $N在別人家中找東找西的，似乎想趁火打劫。
	callout 1 echoat $n 一個被放置在餐桌正中央的方盒(box)。
	callout 1 echoat $n 角落邊堆放的好幾個手提箱。
	callout 1 echoat $n 牆面上掛著的幾支釣竿。
	callout 1 echoat $n 書桌上放著的一堆書本跟信件。
	callout 1 echoat $n 你發現有些東西值得仔細搜索(search)：
endif
~
>room_command search p box~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) != myth_dis_officer 100002
	echoat $n 什麼？
	break
endif
if is_qmark($n) !& myth_dis_officer 200002
	echoaround $n $N身體在餐桌上磨蹭著。
	mod_qmark $n myth_dis_officer v1 | 2
	oload 21079 1 $n target
	oload 21080 1 $n target
	echoat $n 你在盒中發現留給長官助理的字條及印章。
	echoat $n 你看了字條的內容，也許能回報(report)給秘書知道長官的下落了。
else
	echoat $n 這裡沒有什麼特別的東西了。
endif
~
>room_command search p floor~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200004
	echoat $n 地面沒有什麼特別的東西了。
	break
endif
if is_qmark($n) & myth_dis_officer 300001
	echoaround $n $N突然蹲在地上，難不成是...肚子痛嗎？
	mod_qmark $n myth_dis_officer v1 | 4
	oload 21081 1 $n target
	echoat $n 你撬開地面的木板，找到一封信。
else
	echoat $n 地面似乎沒有什麼特別的東西。
endif
~
>room_command search p corner~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
echoat $n 牆邊的角落放著好幾個手提箱不知道能幹嘛。
echoaround $n $N面向角落不知道在幹啥，活像個邊緣人....
~
>room_command search p wall~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
echoat $n 牆上掛著好幾把釣竿，看來房子的主人熱愛釣魚。
echoaround $n $N整個人貼在牆上呈現大字型。
~
>room_command search p desk~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
echoat $n 書桌有些雜亂，隨意堆放的書本跟文件快能疊成一座小山了。
echoaround $n $N翻著人家的書桌，該不會是想偷東西吧？
~
>room_command search p book~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
echoat $n 書桌上疊著各式各樣的書本，看來住這裡的人喜歡閱讀。
echoaround $n $N翻找著書桌，似乎在找值錢的東西...
~
>room_command search p table~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
echoat $n 餐桌上沒什麼特別的，除了上頭放著一個小盒子。
echoaround $n $N身體在餐桌上磨蹭著。
~
>room_command search p black-case~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200008
	echoat $n 這東西沒有什麼特別的地方了。
	break
endif
if is_qmark($n) & myth_dis_officer 300002
	echoaround $n $N面向角落不知道在幹啥，活像個邊緣人....
	mod_qmark $n myth_dis_officer v1 | 8
	oload 21082 1 $n target
	echoat $n 你在角落發現黑色的手提箱，並在裡面找到一把刀。
else
	echoat $n 手提箱似乎沒有什麼特別的地方。
endif
~
>room_command search p brown-case~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200016
	echoat $n 這東西沒有什麼特別的地方了。
	break
endif
if is_qmark($n) & myth_dis_officer 316384
	echoaround $n $N面向角落不知道在幹啥，活像個邊緣人....
	mod_qmark $n myth_dis_officer v1 | 16
	oload 21083 1 $n target
	echoat $n 你在角落發現咖啡色的手提箱，並在裡面找到一短刀。
else
	echoat $n 手提箱似乎沒有什麼特別的地方。
endif
~
>room_command search p pole~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200032
	echoat $n 牆上的釣竿沒有什麼特別的地方了。
	break
endif
if is_qmark($n) & myth_dis_officer 300032
	echoaround $n $N整個人貼在牆上呈現大字型。
	mod_qmark $n myth_dis_officer v1 | 32
	oload 21084 1 $n target
	echoat $n 牆上釣竿中你發現一把材質奇特的黑色釣竿。
else
	echoat $n 釣竿似乎沒有什麼特別的地方。
endif
~
>room_command search p notebook~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200064
	echoat $n 桌上的書本中沒有什麼特別的地方了。
	break
endif
if is_qmark($n) & myth_dis_officer 300008
	echoaround $n $N翻著人家的書桌，該不會是想偷東西吧？
	mod_qmark $n myth_dis_officer v1 | 64
	oload 21085 1 $n target
	echoat $n 你在桌上找到一本偽裝過的筆記本。
else
	echoat $n 你在桌上的書本中沒找到筆記本之類的東西。
endif
~
>room_command search p letter~
if is_qmark($n) != myth_dis_officer
	echoat $n 什麼？
	break
endif
if is_qmark($n) & myth_dis_officer 200128
	echoat $n 桌上的信件中沒有什麼特別吸引你的內容了。
	break
endif
if is_qmark($n) & myth_dis_officer 365536
	if is_qmark($n) & myth_dis_officer 300064
		echoaround $n $N翻著人家的書桌，該不會是想偷東西吧？
		mod_qmark $n myth_dis_officer v1 | 128
		oload 21086 1 $n target
		echoat $n 你在桌上找到寄件人署名與長官相同的信件。
	else
		echoat $n 桌上信件中似乎沒有什麼特別的內容。
	endif
else
	echoat $n 桌上信件中似乎沒有什麼特別的內容。
endif
~
