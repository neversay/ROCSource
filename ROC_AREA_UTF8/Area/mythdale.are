>greet_prog 100~
if is_qmark($n) == myth_templar_enemy
	mpechoat $n $I小心翼翼地打量著你。
else
	if is_qmark($i) == greeting
		break
	endif
	mpadd_qmark self greeting -1 0 0 0 0 1
	mpcallout 1 mpdel_qmark self greeting
	say 歡迎，您要不要來杯本店自釀的矮人麥酒？
endif
~
>talk_prog topic~
if is_qmark($n) == myth_templar_enemy
	tell $n 這位客人，希望你不要在這裡亂來。
	break
endif
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
tell $n 這位客人，請問您今天來是要吃飯喝酒或是住宿(rent)呢？
if is_qmark($n) == myth_armawp_quest 300000
	if is_qmark($n) == myth_armawp_quest 100004
		if is_qmark($n) == myth_armawp_quest 200004
			mpadd_qmark self talking
			mpcallout 2 mpdel_qmark self talking
			mpmod_qmark $n myth_armawp_quest v2 = 1
			mpcallout 1 mpechoat $n 你發覺得身為矮人的$I表現彬彬有禮，與你認知中的矮人差很大。
			mpcallout 2 mpechoat $n 或許能問他為什麼矮人(dwarf)的性格都讓人那麼反感。
		endif
	endif
endif
~
>talk_prog p dwarf~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300001
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpmod_qmark $n myth_armawp_quest v2 = 2
	smile
	mpcallout 1 tell $n 想必你是指東北角那兩間賣裝備的矮人店吧？
	mpcallout 1 tell $n 你不是第一個提這個問題的人，已經有好幾個客人問過了。
	mpcallout 2 tell $n 他們雖然對客人不友善，但技術確實了得。
	mpcallout 2 tell $n 作裝甲的是哥哥赫克拉迪，作武器的是弟弟弗林。
	mpcallout 2 tell $n 那兩個矮人是兄弟。
	mpcallout 3 tell $n 在矮人的世界中也算得上有名氣的流浪工匠(wandering craftsman)。
endif
~
>talk_prog p wandering craftsman~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300002
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n myth_armawp_quest v2 = 3
	tell $n 一群浪跡天涯、拋家棄子在世界各地尋求理想製作材料的匠人。
	tell $n 這些人不會在同個地方紮根，達到目的就前往下個目標。
	tell $n 而這兄弟倆又算是當中比較特別的一群。
	mpcallout 1 tell $n 所以充滿魔性的迷斯卓諾將是搜集素材的最佳地點。
	mpcallout 1 tell $n 認為如此的製成品也能擁有素材主人的相同異能。
	mpcallout 1 tell $n 他們追求以兇猛野獸、魔物的身體作為素材。
	mpcallout 2 tell $n 也同時被吸引過來了。
	mpcallout 2 tell $n 讓理當不會在同地點一起出現的兄弟(brotherhood)。
endif
~
>talk_prog p brotherhood~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300003
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpmod_qmark $n myth_armawp_quest v2 = 4
	tell $n 他們有名的原因不僅僅是有著優良的技術。
	tell $n 還有圍繞在兩兄弟間明爭暗鬥的八卦話題。
	tell $n 事件的起因是上代留下的家傳鍛鎚。
	mpcallout 1 tell $n 所有家族成員要對其效忠，不得有異議。
	mpcallout 1 tell $n 接收寶物的子孫，將會直接成為下代的當家。
	mpcallout 1 tell $n 矮人有著把象徵家族地位的寶物傳給最優秀子孫的習俗。
	mpcallout 2 tell $n 他們家族在這個世代中出現了兩位不分上下的天才。
	mpcallout 2 tell $n 輕則數人流放收場，重則造成家族分裂甚至於毀滅。
	mpcallout 2 tell $n 在人材輩出的世代，評鑑優劣不是容易的事，往往會轉變為族內派系鬥爭。
	mpcallout 3 tell $n 最終成為流浪工匠，但從此也不相往來。
	mpcallout 3 tell $n 家傳的鍛鎚突然失竊(stolen)，兩人同時失去繼承權。
	mpcallout 3 tell $n 在眾人無法決定誰成為下任繼承者時....
endif
~
>talk_prog p stolen~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300004
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n myth_armawp_quest v2 = 5
	tell $n 這就是有趣的地方了。
	mpcallout 1 tell $n 讓弟弟也失去繼承權。
	mpcallout 1 tell $n 繼承無望又嫉妒弟弟的權力，憤而把鎚子弄丟。
	mpcallout 1 tell $n 有些人說，因為哥哥的技術比不上弟弟。
	mpcallout 2 tell $n 弟弟不滿這結果，偷偷把鎚子藏起來。
	mpcallout 2 tell $n 以往不成文的規定會讓年紀較大者優先繼承。
	mpcallout 2 tell $n 也有人說，能力不分軒輊的情況下。
	mpcallout 3 tell $n 好讓他們能在搞垮後將其納入囊下。
	mpcallout 3 tell $n 收買了落敗者把鎚子藏起來，讓家族失去繼承者而衰敗。
	mpcallout 3 tell $n 還有人說，是堂兄弟覬覦他們家族的領地。
	mpcallout 4 tell $n 但把這些當成茶餘飯後的八卦聊，也算種樂趣呢。
	mpcallout 4 tell $n 總之，繼承事件的真相(inherit)也只有當事人才知道吧。
	mpcallout 5 giggle
endif
~
>talk_prog p inherit~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_armawp_quest 300005
	tell $n 我頂多能告訴你一些八卦。
	tell $n 繼承事件的真相(inherit)只有當事人才知道。
endif
~
>talk_prog p restore~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_inv_obj($n) == 21262
	tell $n 這位旅人是要來吃飯喝酒還是住宿(rent)呢？
	mpechoat $n 他像個 NPC 只會跳針同一句話。
endif
~
>talk_prog p knights~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_templar_enemy
	tell $n 抱歉，我不隨便提供客人的資料！
	break
endif
tell $n 對呀，就是門口的那群騎士，似乎有任務要執行，才剛退房。
tell $n 希望他們回程也能來這住，我就能再賺一筆了！
~
>talk_prog p rent~
if is_qmark($i) == talking
	mpechoat $n $I正在忙。
	break
endif
if is_qmark($n) == myth_templar_enemy
	tell $n 不好意思，我不希望驚擾到其他客人。
	tell $n 如果你只是來喝酒吃飯還不成問題，但如果是要住宿，
	tell $n 請去問問旁邊的酒館.....
	tell $n 畢竟你作過的事已經傳遍整個大街小巷了。
	tell $n 或許只有她肯收留你過夜吧。
else
	say 本店備有獨立床板的大通舖，能讓你好好休息舒解旅途帶來的疲憊。
	say 連教會的騎士大人們(knights)都讚不絕口。
	say 現在特價，一張床一份餐點，20000金幣。
endif
~
>bribe_prog 20000~
if is_qmark($n) == myth_templar_enemy
	mpgold 20000 $n
	say 我不作你的生意。
	sorry $n
	break
endif
say 好的，請跟我來，附餐隨後會送上。
mpechoat $n $I把你帶進二樓的大通舖後，就下樓了。
mptransfer $n 21149
mpcallout 1 mpat $n say 這是你的餐點，好好地放鬆休息吧。
mpcallout 1 mpat $n mpoload 21046 $n viclv target
mpcallout 1 mpat $n mpoload 21023 $n viclv target
mpcallout 1 mpat $n mpechoaround $n $I進門後將一份熱食跟啤酒送到$n的手上。
mpcallout 1 mpat $n mpechoat $n $I進門後將一份熱食跟啤酒送到你的手上。
~
|

