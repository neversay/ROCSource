if is_qmark($n) == myth_templar_SP 200004
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v0 = 0
	mpmod_qmark $n myth_templar_SP v1 = 5
	mpadd_qmark $n myth_templar_SP_count -1 0 0 0 0 1
	mpadd_qmark $n myth_templar_SPT2 8 0 0 0 0 0
	tell $n 根據隊長以往的作法，集合後會在幾個小時內先派出一隊前行的調查小隊去探路。
	tell $n 調查小隊的成員都是看他心情挑選的，沒有人能確定自己會不會被選上。
	tell $n 當然我也有機會成為其中一員。
	mpcallout 1 tell $n 這樣我才有辦法知道哪些路段惡魔數量比較少。
	mpcallout 1 tell $n 所以我希望你能盡快到遺蹟內清除惡魔，再來回報我(report)。
	mpcallout 2 tell $n 去吧，冒險者！
endif
~
>talk_prog report~
if is_qmark($n) == myth_templar_enemy
	say 用你的屍體來回報吧！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP 200005
	mpadd_qmark self talking
	mpcallout 4 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v1 = 6
	mpadd_qmark $n myth_templar_SP_timer2 12 0 0 0 0 1
	if is_qmark($n) == myth_templar_SPT2
		mpdel_qmark $n myth_templar_SPT2
		mpmod_qmark $n myth_templar_SP_count v2 = 1
		mpcallout 1 tell $n 你回來的正好，調查小隊才正準備要出發呢。
		mpcallout 2 tell $n 雖然我這次僥倖沒被挑上，但可以把這消息告訴隊員，多少能減少傷亡。
		mpcallout 3 mpgold $n 1000000
		mpcallout 3 tell $n 這些是給你的報酬，你先收下吧。
		mpcallout 4 tell $n 你再來問我吧。
		mpcallout 4 tell $n 要是你想知道後續的結果(result)，大概半天後會傳回消息。
	else
		mpcallout 1 tell $n 啊，你回來啦，不過調查小隊已經出發了。
		mpcallout 2 tell $n 我這次僥倖沒被選作隊員，只能祈禱你消滅的惡魔多到他們不會碰到了。
		mpcallout 3 mpgold $n 500000
		mpcallout 3 tell $n 這些是給你的報酬，你先收下吧。
		mpcallout 4 tell $n 到時候就會有個結果(result)了。
		mpcallout 4 tell $n 要是沒意外，通常會在半天後傳回消息。
	endif
endif
~
>talk_prog result~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 我這就把你結果掉！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP_timer2
	tell $n 還沒有他們的回報喔，要再等一下。
	break
endif
if is_qmark($n) == myth_templar_SP 200006
	mpdel_qmark $n myth_templar_SP
	mpadd_qmark $n myth_templar_SP_II_B -1 0 0 0 0 1
	if is_qmark($n) == myth_templar_SP_count 300001
		if is_qmark($n) >= myth_templar_SP_count 100008
			if is_qmark($n) == myth_templar_end
				mpmod_qmark $n myth_templar_end v0 | 4
			else
				mpadd_qmark $n myth_templar_end -1 4 0 0 0 1
			endif
		else
			if is_qmark($n) == myth_templar_end
				mpmod_qmark $n myth_templar_end v1 | 4
			else
				mpadd_qmark $n myth_templar_end -1 0 4 0 0 1
			endif
		endif
	else
		if is_qmark($n) == myth_templar_end
			mpmod_qmark $n myth_templar_end v1 | 4
		else
			mpadd_qmark $n myth_templar_end -1 0 4 0 0 1
		endif
	endif
	if is_qmark($n) >= myth_templar_SP_count 100010
		mpmod_qmark $n myth_templar_SP_II_B v2 = 1
		tell $n 據回報指出，這次的前行探查意外的順利。
		tell $n 一路上都沒有碰到任何攻擊性的生物。
		tell $n 沒有任何傷亡出現。
		mpcallout 1 tell $n 我替同伴們對你獻上最深的敬意。
		mpcallout 1 tell $n 如果沒有你的暗中協助，事情肯定無法進行得如此順利。
		mpcallout 2 mpresp $n 1
		mpcallout 2 mpskillexp $n 35000
		mpcallout 2 mpexp $n 150000
		mpcallout 2 salute $n
	endif
	if is_qmark($n) == myth_templar_SP_count 100009
	or is_qmark($n) == myth_templar_SP_count 100008
		mpmod_qmark $n myth_templar_SP_II_B v2 = 2
		tell $n 據回報指出，這次的前行探查還算順利。
		tell $n 路上碰到的強大惡魔只有一、二隻。
		tell $n 只有少數幾個人受點傷，沒有人死亡。
		mpcallout 1 tell $n 我在此代替同伴們對你獻上最深的敬意。
		mpcallout 1 tell $n 如果沒有你的暗中協助，事情不會進行得那麼順利。
		mpcallout 2 mpresp $n 1
		mpcallout 2 mpskillexp $n 25000
		mpcallout 2 mpexp $n 120000
		mpcallout 2 salute $n
	endif
	if is_qmark($n) == myth_templar_SP_count 100007
	or is_qmark($n) == myth_templar_SP_count 100006
		mpmod_qmark $n myth_templar_SP_II_B v2 = 3
		tell $n 據回報指出，這次的前行探查還算不錯。
		tell $n 沿途上的惡魔並不如之前遺蹟團回報的那麼大量。
		tell $n 傷亡的人數也比預期來得少上許多。
		mpcallout 1 tell $n 我在此代替同伴們對你獻上最深的敬意。
		mpcallout 1 tell $n 多虧有你的協助，才能將傷亡降到最低。
		mpcallout 2 mpresp $n 1
		mpcallout 2 mpskillexp $n 15000
		mpcallout 2 mpexp $n 100000
		mpcallout 2 salute $n
	endif
	if is_qmark($n) == myth_templar_SP_count 100005
	or is_qmark($n) == myth_templar_SP_count 100004
		mpmod_qmark $n myth_templar_SP_II_B v2 = 4
		tell $n 據回報指出，這次的前行探查跟預期的結果差不多。
		tell $n 雖然遺蹟內的惡魔數量不像之前報告說的那麼多。
		tell $n 但兇猛的程度卻超出想像，後果相當慘烈。
		mpcallout 2 tell $n 但不論結果如何，你確實有幫助過我們。
		mpcallout 2 tell $n 沒作足準備的情況下，面對他們會有這種結果也不太讓人意外。
		mpcallout 2 tell $n 遺蹟的惡魔也許受到迷斯卓諾邪氣的影響，而遠比我們之前遇見的還頑強。
		mpcallout 3 mpresp $n 1
		mpcallout 3 mpskillexp $n 8000
		mpcallout 3 mpexp $n 80000
		mpcallout 3 thank $n
	endif
	if is_qmark($n) == myth_templar_SP_count 100003
	or is_qmark($n) == myth_templar_SP_count 100002
	or is_qmark($n) == myth_templar_SP_count 100001
		mpmod_qmark $n myth_templar_SP_II_B v2 = 5
		tell $n 據回報指出，這次的前行探查比預期的結果還糟。
		tell $n 惡魔數量就像之前報告指出的一樣多。
		tell $n 在沒準備完善的情況下，死傷相當慘烈。
		mpcallout 1 tell $n 這樣就算作好準備，下次遇到的惡魔也會比之前更多。
		mpcallout 1 tell $n 遺蹟的惡魔也許受到迷斯卓諾邪氣的加持，成長的速度超出我們想像。
		mpcallout 2 tell $n 而殺不盡的惡魔也是天神給予我們的警告吧....
		mpcallout 2 tell $n 或許迷斯卓諾遺蹟本來就不該是凡人能踏足的領域。
		mpcallout 3 mpresp $n 1
		mpcallout 3 mpskillexp $n 3000
		mpcallout 3 mpexp $n 20000
		mpcallout 3 tell $n 再見了，冒險者。
		mpcallout 3 tell $n 不管結果如何，我依然會服從命令執行任務。
	endif
	if is_qmark($n) == myth_templar_SP_count 100000
		mpmod_qmark $n myth_templar_SP_II_B v2 = 6
		tell $n 嗯，已經過去半天多了。
		tell $n 先行的調查小隊還沒有任何的回報....
		tell $n 這種情況看來全員都被判定成 MIA 了吧。
		tell $n 看來再過不久，隊長就會下達全員出動的命令了。
		mpcallout 2 tell $n 哪怕這道命令是要我去死....
		mpcallout 2 tell $n 但身為騎士的榮譽心，不允許放棄任何一道長官的命令。
		mpcallout 2 tell $n 你或許會覺得服從這種必死無疑的命令是相當愚蠢的行為。
		mpcallout 3 mpskillexp $n 200
		mpcallout 3 mpexp $n 1000
		mpcallout 3 tell $n 再見了，好事的冒險者！
		mpcallout 3 tell $n 總之，如果還有緣相見，再一起喝杯酒吧。
	endif
	mpdel_qmark $n myth_templar_SP_count
endif
~
>fight_prog 30~
if rand(50)
	flaming
else
	circular
endif
~
>death_prog 100~
mpmod_all_qmark $n myth_templar_enemy v0 + 1
mpadd_all_qmark $n myth_templar_enemy -1 0 0 0 1 1
say 可恨的教團之敵，同伴會幫我報仇的！
if is_qmark($n) > myth_templar_enemy 100010
	mpmod_qmark $n myth_templar_enemy v0 = 10
endif
if is_qmark($n) >= myth_templar_enemy 100002
	if is_qmark($n) != absolution_rent_hint
		mpforcer here callout 2 at $n echoat $n 長時間被追補讓你感到身心俱疲...該找好好地方休息了。
		mpadd_qmark $n absolution_rent_hint 5 0 0 0 1 0
	endif
endif
~
