mpat 5 wear all
mpmload 21044
mpgroup self order-myth-3 1
mpmload 21044
mpgroup self order-myth-3 1
mpmload 21044
mpgroup self order-myth-3 1
mpgoto self
~
>all_greet_prog 100~
if is_qmark($n) > myth_templar_enemy 100010
	mpmod_qmark $n myth_templar_enemy v0 = 10
endif
~
>talk_prog topic~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 邪惡之人！受死吧！
	mpkill $n
	break
endif
if is_qmark($n) & myth_templar_end 100004
or is_qmark($n) & myth_templar_end 200004
	break
endif
if is_qmark($n) == myth_templar_SP 100001
	mpadd_qmark self talking
	mpcallout 1 mpdel_qmark self talking
	mpechoat $n $I喃喃自語「他媽的...！死狗官，突然叫人去開拓什麼鬼航道！」
	mpcallout 1 mpechoat $n 難道....這才是他焦慮的主因嗎？
	mpcallout 1 mpmod_qmark $n myth_templar_SP v0 = 2
else
	if is_qmark($n) == myth_templar_end
		if rand(50)
			mpechoat $n $I喃喃自語「本次任務為海港探察...嗯，這下該怎麼解釋呢...」
		else
			tell $n 我很忙沒空陪你聊天。
		endif
	else
		if rand(50)
			mpechoat $n $I喃喃自語「突然更換任務...真是別鬧了」
		else
			tell $n 我很忙沒空陪你聊天。
		endif
	endif
endif
~
>talk_prog anxiety~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 啊？你問我焦慮的原因？
	say 廢話！當然是因為有你這種教團之敵存在呀！
	mpkill $n
	break
endif
if is_qmark($n) & myth_templar_end 100004
or is_qmark($n) & myth_templar_end 200004
	break
endif
if is_qmark($n) == myth_templar_end
	if is_qmark($n) != myth_templar_SP
		mpadd_qmark self talking
		mpcallout 1 mpdel_qmark self talking
		mpadd_qmark $n myth_templar_SP -1 1 1 0 0 1
		tell $n 我表情焦慮？喔，這沒什麼。
		tell $n 想到今天要出任務，太興奮沒睡好而已。
		mpcallout 1 mpechoat $n 直覺告訴你事情不單純。
	else
		if is_qmark($n) == myth_templar_SP 100001
			mpadd_qmark self talking
			mpcallout 1 mpdel_qmark self talking
			tell $n 我說過了，只是晚上沒睡好！
			tell $n 死老百姓管那麼多幹啥！
			mpcallout 1 mpechoat $n 冒險者的直覺告訴你事情不單純。
		else
			if is_qmark($n) == myth_templar_SP 100002
				mpadd_qmark self talking
				mpcallout 4 mpdel_qmark self talking
				mpmod_qmark $n myth_templar_SP v0 = 3
				tell $n 唔....你怎麼會知道這件事。
				mpcallout 2 tell $n 算了，事情怎麼洩漏出去的不重要。
				mpcallout 3 tell $n 最該死的是我們對此完全沒有準備。
				mpcallout 3 tell $n 更該死的是，派給我們的任務是去繪製那片海域的航道。
				mpcallout 3 tell $n 從森林探索變為開拓該死的港口新發現區域。
				mpcallout 3 tell $n 反正就像你所知道的，今天一早長官派人傳令說要改變任務。
				mpcallout 4 tell $n 所以我正在煩惱著該如何跟部下解釋(explain)。
				mpcallout 4 tell $n 這任務無疑是要我們去送死。
			endif
		endif
	endif
else
	mpadd_qmark self talking
	mpcallout 1 mpdel_qmark self talking
	tell $n 你管那麼多幹啥！老百姓滾一旁買菜，去去去...
	mpcallout 1 mpechoat $n 他看起來心情不是很好，大概是昨晚沒睡好吧。
endif
~
>talk_prog explain~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 你的作為還有什麼好解釋！去死！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP 100000
	tell $n 這些東西幹啥跟你這個外人講。
	break
endif
if is_qmark($n) == myth_templar_SP 100003
	mpadd_qmark self talking
	mpcallout 6 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v0 = 4
	tell $n 任務內容是探勘海域，所以先要有能在海上航行的船隻。
	tell $n 船的來源則是自己製造，但想打造船隻就需要先建立小型營地。
	mpcallout 1 tell $n 這樣是沒辦法建立營地的。
	mpcallout 1 tell $n 周邊的環境還沒有完整的探勘報告。
	mpcallout 1 tell $n 不過如先前所說，港口是最近才被發現的區域。
	mpcallout 2 tell $n 這樣在執行主要任務前，手下的人就精疲力盡了。
	mpcallout 2 tell $n 但過往的經驗看來，進出遺跡肯定會造成大量傷亡。
	mpcallout 2 tell $n 因此，想建立營地勢必要先派出幾隊人馬進出港口探勘。
	mpcallout 4 look $n
	mpcallout 5 tell $n 而剛好有個方法能解決問題，但需要你這種人材幫忙。
	mpcallout 5 tell $n 其實我知道你這號人物，最近酒館上下都在傳著你的事蹟。
	mpcallout 6 tell $n 怎樣，有意願協助(assist)嗎？
endif
~
>talk_prog assist~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 想協助我？那你就去死吧！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP 100000
	tell $n 仔細評估後，我想還是找其他辦法解決好了。
	tell $n 之前的事就當我沒說過。
	break
endif
if is_qmark($n) == myth_templar_SP 100004
	mpadd_qmark self talking
	mpcallout 5 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v0 = 5
	mpmod_qmark $n myth_templar_SP v1 = 0
	tell $n 我的想法是這樣的，與其浪費大量人力執行非主要任務。
	tell $n 不如派少數機動性高的精英去收集必要的資訊。
	tell $n 如此不僅能把損傷降低，還能保留大部分隊員的體力。
	mpcallout 1 tell $n 不過呢....
	mpcallout 3 tell $n 大多情況都是以團隊合作為主要行動方針。
	mpcallout 3 tell $n 比起你們冒險者，我們團隊中沒有擅於獨立行動的人。
	mpcallout 4 tell $n 先不提能力，至少在生存率上比我們高出好幾倍吧。
	mpcallout 4 tell $n 所以這檔事比較適合像你這種多次進出遺跡的冒險者來執行。
	mpcallout 5 tell $n 如果你作好準備的話，跟我說一聲(ok)就能開始執行計劃了。
endif
~
>talk_prog ok~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 你還活著一點都不ok喔....
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP 100005
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpadd_qmark $n myth_templar_SPT 9 0 0 0 0 0
	mpmod_qmark $n myth_templar_SP v0 = 6
	tell $n 港口的位置，根據先前的回報指出。
	tell $n 從東邊城牆的破口一路往東穿出沼地後就能看到了。
	mpcallout 1 mpechoat $n $I交給你一張紙。
	mpcallout 1 mpoload 21078 $n viclv target
	mpcallout 2 tell $n 再盡快把紙交還給我。
	mpcallout 2 tell $n 時間緊迫，盡可能把港口範圍中的位置標上(mapping)。
	mpcallout 3 tell $n 去吧！
endif
~
>talk_prog result~
if isfight($i)
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($n) == myth_templar_enemy
	say 我這就把你結果掉！
	mpkill $n
	break
endif
if is_qmark($n) == myth_templar_SP_timer
	tell $n 我派的人還沒有消息，再等一下吧。
	break
endif
if is_qmark($n) == myth_templar_SP 100007
	mpadd_qmark self talking
	mpcallout 2 mpdel_qmark self talking
	mpdel_qmark $n myth_templar_SP
	mpadd_qmark $n myth_templar_SP_II_A -1 0 0 0 0 1
	if is_qmark($n) == myth_templar_SPE 300001
		if is_qmark($n) >= myth_templar_SPE 100004
			if is_qmark($n) == myth_templar_end
				mpmod_qmark $n myth_templar_end v0 | 4
			else
				mpadd_qmark $n myth_templar_end -1 4 0 0 0 1
			endif
		else
			if is_qmark($n) == myth_templar_end
				mpmod_qmark $n myth_templar_end v1 | 4
			else
				mpadd_qmark $n myth_templar_end -1 0 4 0 0 1
			endif
		endif
	else
		if is_qmark($n) == myth_templar_end
			mpmod_qmark $n myth_templar_end v1 | 4
		else
			mpadd_qmark $n myth_templar_end -1 0 4 0 0 1
		endif
	endif
	if is_qmark($n) == myth_templar_SPE 100005
		mpmod_qmark $n myth_templar_SP_II_A v2 = 1
		tell $n 這次多虧你的協助。
		tell $n 派出的先鋒依你的探查報告，安全的進入海港區，沒有任何人員傷亡。
		tell $n 沒意外，這幾天就能把全部隊帶進去完成剩下的營地建設跟造船了。
		mpcallout 1 mpresp $n 1
		mpcallout 1 mpskillexp $n 20000
		mpcallout 1 mpexp $n 100000
		mpcallout 1 mpgold $n 5000000
		mpcallout 1 tell $n 這是給你的報酬。
		mpcallout 2 tell $n 那麼，我要去為後續行動作準備了。
	endif
	if is_qmark($n) == myth_templar_SPE 100004
		mpmod_qmark $n myth_templar_SP_II_A v2 = 2
		tell $n 幸虧有你的協助。
		tell $n 派出的先鋒依你的探查報告，在幾乎無損的情況下進入海港區。
		tell $n 沒意外，這幾天就能把全部隊帶進去完成剩下的營地建設跟造船了。
		mpcallout 1 mpresp $n 1
		mpcallout 1 mpskillexp $n 15000
		mpcallout 1 mpexp $n 80000
		mpcallout 1 mpgold $n 3500000
		mpcallout 1 tell $n 這是給你的報酬。
		mpcallout 2 tell $n 那麼，我要去為後續行動作準備了。
	endif
	if is_qmark($n) == myth_templar_SPE 100003
		mpmod_qmark $n myth_templar_SP_II_A v2 = 3
		tell $n 所幸有你的協助。
		tell $n 派出的先鋒依你的探查報告，在極小傷亡的情況下進入海港區。
		tell $n 沒意外，這幾天就能把全部隊帶進去完成剩下的營地建設跟造船了。
		mpcallout 1 mpresp $n 1
		mpcallout 1 mpskillexp $n 8000
		mpcallout 1 mpexp $n 50000
		mpcallout 1 mpgold $n 1500000
		mpcallout 1 tell $n 這是給你的報酬。
		mpcallout 2 tell $n 那麼，我要去為後續行動作準備了。
	endif
	if is_qmark($n) == myth_templar_SPE 100002
		mpmod_qmark $n myth_templar_SP_II_A v2 = 4
		tell $n 好在有你的協助。
		tell $n 派出的先鋒依你的探查報告，避免受到全滅的下場，總算能進入海港區。
		tell $n 沒意外，這幾天就能把全部隊帶進去完成剩下的營地建設跟造船了。
		mpcallout 1 mpresp $n 1
		mpcallout 1 mpskillexp $n 5000
		mpcallout 1 mpexp $n 20000
		mpcallout 1 mpgold $n 800000
		mpcallout 1 tell $n 這是給你的報酬。
		mpcallout 2 tell $n 那麼，我要去為後續行動作準備了。
	endif
	if is_qmark($n) == myth_templar_SPE 100001
		mpmod_qmark $n myth_templar_SP_II_A v2 = 5
		tell $n 雖然受到你的協助。
		tell $n 不過派出的先鋒隊還是在海港區，受到嚴重的打擊，幾乎全滅。
		tell $n 這幾天要再想其他方法完成任務了。
		mpcallout 1 mpresp $n 1
		mpcallout 1 mpskillexp $n 2000
		mpcallout 1 mpexp $n 5000
		mpcallout 1 mpgold $n 150000
		mpcallout 1 tell $n 這是給你的報酬。
		mpcallout 2 tell $n 那麼，我要去為後續行動作準備了。
	endif
	if is_qmark($n) == myth_templar_SPE 100000
		mpmod_qmark $n myth_templar_SP_II_A v2 = 6
		tell $n 派出的先鋒隊目前還沒有回音，看來是全滅了吧。
		tell $n 這結果從一開始就是可預見的，也許上天注定要我們毀滅。
		tell $n 但作為一名騎士，面對困難不可為的任務也要正面回應。
		tell $n 才能不損身為自身的名譽。
		mpcallout 1 mpskillexp $n 100
		mpcallout 1 mpexp $n 1000
		mpcallout 1 mpgold $n 100000
		mpcallout 1 tell $n 我並不怨恨你，甚至還要感謝你肯在困難時伸出援手。
		mpcallout 2 tell $n 那麼，我還要去為後續作準備，不送了。
	endif
	mpdel_qmark $n myth_templar_SPE
endif
~
>give_prog 21078~
if is_qmark($n) == myth_templar_SP 100006
	mpjunk $o
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpmod_qmark $n myth_templar_SP v0 = 7
	mpadd_qmark $n myth_templar_SP_timer 12 0 0 0 0 1
	if is_qmark($n) == myth_templar_SPT
		mpdel_qmark $n myth_templar_SPT
		mpmod_qmark $n myth_templar_SPE v2 = 1
		tell $n 你回來的剛好，前行的調查隊員剛選出來，才正準備要出發呢。
		tell $n 我相信這份地圖對他們一定也有所幫助。
	else
		tell $n 你回來的有些遲，前行的調查隊員已經出發了。
		tell $n 不過沒關係，我會再派人追去送這份地圖。
	endif
	if objval1($o) >= 24
		mpadd_qmark $n myth_templar_SPE -1 5 0 0 0 1
		mpcallout 1 tell $n 雖然這港口大小有點超出我意外的大。
		mpcallout 1 tell $n 這張地圖畫得可真精細，各種細節都詳細記錄。
		mpcallout 2 tell $n 不過只要照著地圖上一步一步走，打先鋒的調查隊員應該不會有太大問題。
		mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
		mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
	else
		if objval1($o) >= 20
			mpadd_qmark $n myth_templar_SPE -1 4 0 0 0 1
			mpcallout 1 tell $n 這張地圖畫得可真詳細，不過....
			mpcallout 2 tell $n 但有這張詳細的地圖，我相信他們有辦法自己應付才是。
			mpcallout 2 tell $n 前行的調查隊員可能不太能處理這大小的港口，應該會產生不少傷亡。
			mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
			mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
		else
			if objval1($o) >= 15
				mpadd_qmark $n myth_templar_SPE -1 3 0 0 0 1
				mpcallout 1 tell $n 這規模看起來大概跟知名的海港差不多大。
				mpcallout 2 tell $n 前行的調查隊員可能會有不少傷亡，但不至於全滅才是。
				mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
				mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
			else
				if objval1($o) >= 10
					mpadd_qmark $n myth_templar_SPE -1 2 0 0 0 1
					mpcallout 1 tell $n 這規模看起來大概是個中型海港的大小。
					mpcallout 2 tell $n 前行的調查隊員應該還能夠應付這種情況。
					mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
					mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
				else
					if objval1($o) >= 5
						mpadd_qmark $n myth_templar_SPE -1 1 0 0 0 1
						mpcallout 1 tell $n 這規模看來，大概只能停兩、三艘小船吧。
						mpcallout 1 tell $n 海港區域看起來並不大。
						mpcallout 2 tell $n 這樣也不用擔心前行的調查隊員會有什麼傷亡了。
						mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
						mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
					else
						mpadd_qmark $n myth_templar_SPE -1 0 0 0 0 1
						mpcallout 1 tell $n 海港什麼的或是只是假象，弄不好只是個小湖而已。
						mpcallout 1 tell $n 這規模看來，大概只夠停一艘魚船吧。
						mpcallout 1 tell $n 真想不到，這海港區域比我想像中的還要小。
						mpcallout 2 tell $n 這樣也不用擔心前行的調查隊員會有什麼傷亡了。
						mpcallout 3 tell $n 你的報酬還在跟上級請款，等結果出來再一併給你。
						mpcallout 3 tell $n 總之，現在就等半天後的他們回報的結果(result)了。
					endif
				endif
			endif
		endif
	endif
endif
~
>give_prog all~
give $o $n
drop $o
~
>fight_prog 30~
if rand(50)
	flaming
else
	perform empslash
endif
~
>death_prog 100~
mpmod_all_qmark $n myth_templar_enemy v0 + 1
mpadd_all_qmark $n myth_templar_enemy -1 0 0 0 1 1
say 可恨的教團之敵，同伴會幫我報仇的！
if is_qmark($n) > myth_templar_enemy 100010
	mpmod_qmark $n myth_templar_enemy v0 = 10
endif
if is_qmark($n) >= myth_templar_enemy 100002
	if is_qmark($n) != absolution_rent_hint
		mpforcer here callout 2 at $n echoat $n 長時間被追補讓你感到身心俱疲...該找好好地方休息了。
		mpadd_qmark $n absolution_rent_hint 5 0 0 0 1 0
	endif
endif
~
