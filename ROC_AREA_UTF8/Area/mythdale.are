			mpcallout 19 mpechoat $n 　
			mpcallout 20 mpechoat $n 　
			mpcallout 21 mpexp $n -10
			mpcallout 22 lick
			mpcallout 23 tell $n 呼...終於完成了。
			mpcallout 24 tell $n 等到你能動了以後，記得快點去找聖堂的牧師完成後續的動作。(absolution)
			mpcallout 24 tell $n 我把東西放到你身上囉！但畢竟只是偽造品，只能保存個半天左右吧。
			mpcallout 24 mpoload 21073 $n viclv target
			mpcallout 25 tell $n 如果往後還有需求記得再來找我呦！
			mpcallout 26 addoil $n
			mpcallout 26 mpdel_qmark self talking
			break
		else
			pat $n
			tell $n 你的靈魂量不足，再吸下去你就要消失了。
			mpgold $n 1000000
			break
		endif
	endif
	if is_qmark($n) >= myth_templar_enemy 100005
		if exp($n) > 100000
			mpadd_qmark self talking
			mpechoat $n $I在你眼前彈了下手指，你的身體突然不能動了。
			mpat $n mpforcer here stun $n 400
			mpcallout 1 tell $n 那麼要開始囉。
			mpcallout 2 mpechoat $n $I從抽屜中拿出一張白紙放在桌面，並將右手壓在紙張上頭。
			mpcallout 3 mpechoat $n $I的左手輕撫在你的臉頰上，你沒有感到任何不適。
			mpcallout 5 mpechoat $n $I的左手像是抽風機一樣的，試著把你體內的某些東西吸出來！
			mpcallout 6 mpexp $n -1000
			mpcallout 6 mpechoat $n 你感到體內的一部分被抽離出來....
			mpcallout 7 mpexp $n -2000
			mpcallout 7 mpechoat $n 你感到體內的一部分被抽離出來....
			mpcallout 8 mpexp $n -3000
			mpcallout 8 mpechoat $n 你感到體內的一部分被抽離出來....
			mpcallout 9 mpechoat $n 隨著靈魂抽離的過程，你發現$I右手的白紙顯示出某種圖案。
			mpcallout 10 mpexp $n -4000
			mpcallout 10 mpechoat $n 你感到體內的一部分被抽離出來....
			mpcallout 10 mpechoat $n $I[1;32m紅著臉氣喘噓噓的說著「欸，好像有點難吸耶...我稍微加點力道呦～」[0m
			mpcallout 11 mpechoat $n 你感覺$I左手的吸引力突然變強。
			mpcallout 12 mpexp $n -11000
			mpcallout 12 mpechoat $n 你體內的一大部分被抽離出來！
			mpcallout 13 mpexp $n -12000
			mpcallout 13 mpechoat $n 你體內有大量的物質被抽離出來！讓你感到相當不適。
			mpcallout 14 mpexp $n -13000
			mpcallout 14 mpechoat $n 你吸引的力道越來越強，越來越快！你快虛脫了。
			mpcallout 15 mpexp $n -14000
			mpcallout 15 mpechoat $n 你身體裡有大量的東西快速地被吸了出來。 啊啊...會不會死掉....
			mpcallout 16 mpechoat $n $I[1;32m滿臉汗珠的喘著氣說著「接下來要一鼓作氣吸出來囉！」[0m
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n You sure are BLEEDING!
			mpcallout 17 mpexp $n -16000
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n That really did HURT!
			mpcallout 17 mpexp $n -12000
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpexp $n -4500
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpexp $n -3430
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpexp $n -2530
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpechoat $n 　
			mpcallout 17 mpexp $n -1530
			mpcallout 18 mpechoat $n ..............
			mpcallout 19 mpechoat $n 　
			mpcallout 20 mpechoat $n 　
			mpcallout 21 mpexp $n -10
			mpcallout 22 lick
			mpcallout 23 tell $n 呼...終於完成了。
			mpcallout 24 tell $n 等到你能動了以後，記得快點去找聖堂的牧師完成後續的動作。(absolution)
			mpcallout 24 tell $n 我把東西放到你身上囉！但畢竟只是偽造品，只能保存個半天左右吧。
			mpcallout 24 mpoload 21073 $n viclv target
			mpcallout 25 tell $n 如果往後還有需求記得再來找我呦！
			mpcallout 26 addoil $n
			mpcallout 26 mpdel_qmark self talking
			break
		else
			pat $n
			tell $n 你的靈魂量不足，再吸下去你就要消失了。
			mpgold $n 1000000
			break
		endif
	endif
	mpgold $n 1000000
	tell $n 你根本沒得罪教會吧...難不成是被吸魂上癮了嗎？
	blush
else
	tell $n 感謝你對小店的金援。
	bow $n
endif
~
