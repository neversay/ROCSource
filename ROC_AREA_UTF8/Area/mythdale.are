endif
if is_qmark($n) == myth_family_recipe 100008
	if is_qmark($n) >= myth_family_recipe 200002
		mpadd_qmark self talking
		mpcallout 4 mpdel_qmark self talking
		mpmod_qmark $n myth_family_recipe v0 = 9
		mpmod_qmark $n myth_family_recipe v2 | 1
		thank $n
		mpcallout 1 tell $n 我相信無法逃離的族人們在天之靈一定都很感謝你。
		mpcallout 2 ponder
		mpcallout 3 tell $n 雖然想要重金答謝你，但我只是個開烘焙店的，沒什麼錢...
		mpcallout 4 mpresp $n 1
		mpcallout 4 mpskillexp $n 8000
		mpcallout 4 mpexp $n 100000
		mpcallout 4 mpoload 21043 $n 1 target
		mpcallout 4 mpechoat $n $I給了你烤甜甜圈(donut).
		mpcallout 4 mpechoaround $n $I給了$N烤甜甜圈(donut).
	else
		mpadd_qmark self talking
		mpcallout 5 mpdel_qmark self talking
		mpmod_qmark $n myth_family_recipe v0 = 9
		mpmod_qmark $n myth_family_recipe v2 | 1
		thank $n
		mpcallout 1 tell $n 我相信無法逃離的族人們在天之靈一定都很感謝你。
		mpcallout 2 ponder
		mpcallout 3 tell $n 雖然想要重金答謝你，但我只是個開烘焙店的，沒什麼錢...
		mpcallout 4 mpresp $n 1
		mpcallout 4 mpskillexp $n 8000
		mpcallout 4 mpexp $n 100000
		mpcallout 4 mpoload 21043 $n 1 target
		mpcallout 4 mpechoat $n $I給了你烤甜甜圈(donut).
		mpcallout 4 mpechoaround $n $I給了$N烤甜甜圈(donut).
		mpcallout 5 sorry $n
		mpcallout 5 tell $n 如果有祖傳的食譜，就能作出更好的糕點招待你了....
	endif
