		callout 2 oload 325 36 $n target
		callout 2 oload 323 1 floor
		callout 2 modrvt timer = 24
	else
		echoat $n 你開始翻找這堆廢物....
		echoaround $n 你看到$N在翻著一旁的廢棄物。
