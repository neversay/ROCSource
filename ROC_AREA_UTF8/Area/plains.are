>greet_prog 100~
if is_qmark($n) == ofcol_cen_talking
	break
endif
if rand(30)
	if isgood($n)
		salute $n
		mpechoat $n $I [1;12m說著「您好，歡迎來到奧夫卡。」[0m
	else
		mpechoat $n $I仔細打量著你。
		mpechoat $n $I [1;12m說著「希望你在奧夫卡不要惹事生非。」[0m
