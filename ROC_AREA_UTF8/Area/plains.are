	if is_qmark($i) == sentry_fighting
		mpdel_qmark self sentry_fighting
	endif
endif
~
>rand_prog 10~
if rand(50)
	mpecho $I查看著南邊的峽谷，以防峽谷中的人馬闖入。
else
	mpecho $I查看著周邊的山道，防止不肖之徒進入。
endif
~
>talk_prog topic~
if is_qmark($n) == ofcol_cen_talking
	mpechoat $n 他正在忙。
	break
endif
say 最近南方的峽谷中出現了一群人馬(centaur)，他們會掠奪附近的農舍，造成我國不小的損害...
say 不知道有沒有方法趕走他們。
~
>talk_prog centaur~
if is_qmark($n) == ofcol_cen_talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == cen_clear_timer
	tell $n 人馬在峽谷中建立起小型的營地作為據點，不時會出來騷擾周邊的農家。
	tell $n 但前些日子，國內招集一群人去打擊過他們的勢力，讓他們安份許多。
	break
endif
if is_qmark($n) != ofcol_cen_clear
	if level($n) >= 36
		mpadd_qmark $n ofcol_cen_talking 2 0 0 0 0 1
		tell $n 人馬在峽谷中建立起小型的營地作為據點，不時會出來騷擾周邊的農家。
		tell $n 國內的高官們也為此事感到頭痛，因此正在募集有能之士去趕走人馬。
		mpcallout 1 look $n
		mpcallout 3 tell $n 請你去找守衛隊長德瑞克(Derrick)報到吧。
		mpcallout 3 tell $n 他們就是要找像你一樣有能力的冒險者，
		mpcallout 3 mpadd_qmark $n ofcol_cen_clear -1 0 0 0 0 0
		mpcallout 3 mpdel_qmark $n ofcol_cen_talking
	else
		tell $n 人馬在峽谷中建立起小型的營地作為據點，不時會出來騷擾周邊的農家。
	endif
else
	tell $n 人馬在峽谷中建立起小型的營地作為據點，不時會出來騷擾周邊的農家。
endif
~
>fight_prog 100~
if is_qmark($i) != sentry_fighting
	if mobcount(319) == 0
		mpadd_qmark self sentry_fighting
		mpecho 從哨站內衝出幾名哨兵加入戰鬥。
		mpmload 319
		mpgroup sentry-plains sentry-post 1
		mpmload 319
		mpgroup sentry-plains sentry-post 1
		mpmload 319
		mpgroup sentry-plains sentry-post 1
	endif
endif
~
>fight_prog 100~
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
~
