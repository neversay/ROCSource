9 1|2|32|256|16777216|134217728 1|4
0~ 0~ 200~ 0~
1 10000 0
L 30
E
emblematic healer drop~
一條項鍊掛著水藍色的寶石所形成的吊飾，平時戴在身上能將一小部分魔力
蘊藏(reserve)至寶石中；在急需使用時就可以從中取出(restore)。
~
A 12 200
A 40 2
P 128|256|65536|1048576
X sapphire~
>obj_command reserve default~
if is_inv_obj($n) == 320
	if is_equ_obj($n) == 320
		if objval3($o) == 200
			echoat $n 你將部分魔力儲入，$O散發出淡淡的[1;13m魔力[m之光。
			oset self extra | 64
			oset self value3 = 201
			modhmv $n 11.500 500 0
		else
			echoat $n $O內已經存有魔力了。
		endif
	else
		echoat $n 你要將$O戴在身上才能保存魔力。
	endif
else
	break
endif
~
>obj_command restore default~
if is_inv_obj($n) == 320
	if is_equ_obj($n) == 320
		if objval3($o) == 201
			echoat $n 儲存在$O中的魔力，瞬間轉移到你身上。
			oset self extra r 64
			oset self value3 = 200
			modhmv $n 12.300 300 0
		else
			echoat $n $O內已經沒有魔力了。
		endif
	else
		echoat $n 你要將$O戴在身上才能提取魔力。
	endif
else
	break
endif
~
|

