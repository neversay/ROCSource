#AREADATA
Name        北方平原~
Identity    plains~
Builders    Copper~
Translator  Marbas~
Modifier    Amenda~
VNUMs	      300 350
Security    1
Recall      3001
F_toggle    0
End



#MOBILES
#300
druid~
德魯伊教團員(druid)~
德魯伊教團員(druid)正在這平原附近行走，搜索著藥草。
~
這個德魯伊人身材高大，他的臉上的皮膚畫著德魯伊信仰裏所特有的圖案。
信奉大自然的他的神態十分和平。
~
193 8 -500 S
6 0 0 0d0+0 0d0+0
-1 0
0 8 1
>talk_prog topic~
say 不要破壞自然，植物是生命之源。
~
|
#301
sorbus~
隱士蘇巴斯(Sorbus)~
隱士蘇巴斯(Sorbus)正在這裡坐著烤免子。
~
他穿著簡單的衣服，並在這孤獨且難以生活的環境中過著樸素的生活。
~
3 0 0 S
4 0 0 0d0+0 0d0+0
-1 0
0 8 1
>greet_prog 30~
mpecho $I 轉了一下掛著兔子的樹枝，好讓兔肉烤勻。
~
>talk_prog topic~
say 要來點美味的烤兔肉嗎？
~
|
#305
Shudde-M'ell~
蠕動的大蟲(Shudde-M'ell)~
龐大的蟲(Shudde-M'ell)正在保衛他的寶物(G'harne)。
~
Shudde-M'ell 是大約 15  呎長且身上被邪惡的惡臭包圍者，他是 G'harne 寶物
的保護者，牠的特徵是牠的身長和惡臭。
~
35 8 -1000 S
18 0 0 0d0+0 0d0+0
-1 0
0 8 1
R Worm~
#309
rabbit~
可愛的兔子(rabbit)~
可愛的兔子(rabbit)在這裡。
~
它是小的，有著毛絨絨的毛皮和長耳朵以及大大的腳。
~
65 0 0 S
9 0 0 0d0+0 0d0+0
0 0
0 8 0
R Animal~
>death_prog 80~
if primeattr($n) == 2
or class($n) == 17
	mpechoat $n 你拿起小刀割下$I的皮......
	mpoload 35002 1
	break
endif
if rand(40)
	mpechoat $n 你拿起小刀割下$I的皮......
	mpoload 35002 1
endif
if class($n) < 5
	mpgreward exp $n -20 20
endif
~
|
#310
slaver~
奴隸商人(slaver)~
一個奴隸商人(slaver)正無精打采地在這裡休息。
~
他看起來已經很久找不到生意上門了，也許是因為受史卡拉貝反奴隸政策的影響。
~
3 168 -500 S
50 1000 500 10d10+-20 0d-30+50
-1 0
0 8 1
R Human~
C 1
P 1|8|128
>fight_prog 40~
if rand(30)
	c 3 'dispel magic' $n
else
	c 3 fireball $n
endif
~
>rand_prog 5~
if pcnum($) > 0
	if rand(50)
		sigh
		say 近來一個妖精(fairy)都沒抓到，真難生活。
	else
		say 最近這一帶的長官(chief)抓的正緊，妖精(fairy)的買賣越來越難做了…
	endif
endif
~
>talk_prog topic~
	? $n
	say 要買妖精(fairy)別找我唷，最近沒抓到半個。
~
>talk_prog p greenwood kingdom~
say 綠樹王國在史卡拉貝城西不遠處。
say 你可以藉著 <help map> 來得知前往綠樹王國的路線。
~
>talk_prog fairy~
if is_qmark($i) == plains_slaver_waiting
	mpechoat $n $I 忙著自己的事，根本沒空理你。
	break
endif
if is_qmark($n) == plains_slaver_quest 200004
	break
endif
if is_qmark($n) >= plains_slaver_quest 200001
	say 要找妖精(fairy)的話，可能得到
	say 綠樹王國(Greenwoods)，那邊有不少。
	break
endif
if is_qmark($n) >= plains_slaver_quest 200002
	mpechoat $n $I 說「加油！」
else
	mpechoat $n $I 說「你不知道嗎？」
	mpechoat $n $I 說「妖精奴隸可是在這一帶最搶手的商品呢！」
	mpechoat $n $I 說「只是近來因為綠樹王國民族意識高漲，史卡拉貝又下」
	mpechoat $n $I 說「禁令，妖精奴隸就越來越難抓了。」
	if level($n) >= 15
		mpechoat $n $I 說「你似乎是個經驗挺豐富的冒險者。」
		mpechoat $n $I 說「我這裡有件不錯的東西，但是你必須幫忙我(yes/no)。」
		mpadd_qmark $n plains_slaver_quest -1 1 0 0 0 1
		break
	endif
endif
~
>talk_prog no~
if is_qmark($i) == plains_slaver_waiting
	mpechoat $n $I 忙著自己的事，根本沒空理你。
	break
endif
if is_qmark($n) == plains_slaver_quest 200004
	break
endif
if is_qmark($n) == plains_slaver_quest 100001
	mpechoat $n $I 長長的嘆了一口氣，「唉～～」
	mpechoat $n $I 說「那就算了。」
	mpdel_qmark $n plains_slaver_quest
endif
~
>talk_prog chief~
say 長官(chief)就住在這附近，經常會在附近走來走去。
~
>talk_prog yes~
if is_qmark($i) == plains_slaver_waiting
	mpechoat $n $I 忙著自己的事，根本沒空理你。
	break
endif
if is_qmark($n) == plains_slaver_quest 100004
	break
endif
if is_qmark($n) == plains_slaver_quest 100001
	mpechoat $n $I 說「其實很簡單，你去幫我說服長官(chief)不再插手這事。」
	mpechoat $n $I 說「至於怎麼說服，就看你囉！」
	mpmod_qmark $n plains_slaver_quest v0 = 2
endif
~
>talk_prog inform~
if is_qmark($i) == plains_slaver_waiting
	mpechoat $n $I 忙著自己的事，根本沒空理你。
	break
endif
if is_qmark($n) == plains_slaver_quest 100004
	break
else
	if is_qmark($n) == plains_slaver_quest 100005
		mpechoat $n 你把之前發生的事通知商人。
		mpechoat $n $I 說「錢？我哪有錢付他…」
		mpechoat $n $I 說「不過至少你成功的完成任務了。」
		mpechoat $n $I 說「別跑遠了，晚點我還會找你的。」
		mpechoat $n 因為你完成任務，經驗值增加了！
		mpexp $n 500
		mpadd_qmark self plains_slaver_waiting 20 1 0 0 1 1
		mpmod_qmark $n plains_slaver_quest v0 = 0
		mpmod_qmark $n plains_slaver_quest v1 = 1
		break
	endif
	if is_qmark($n) == plains_slaver_quest 100006
		mpechoat $n 你把之前發生的事通知商人。
		mpechoat $n $I 說「幹的好，這樣我什麼都不用做了…」
		mpechoat $n $I 說「你成功的完成任務了。」
		mpechoat $n $I 說「別跑遠了，晚點我還會找你的。」
		mpechoat $n 因為你成功的完成任務，經驗值增加了！
		mpexp $n 1000
		mpadd_qmark self plains_slaver_waiting 20 1 0 0 1 1
		mpmod_qmark $n plains_slaver_quest v0 = 0
		mpmod_qmark $n plains_slaver_quest v1 = 2
		break
	endif
	if is_qmark($n) == plains_slaver_quest 100007
		mpechoat $n 你把之前發生的事通知商人。
		mpechoat $n $I 說「你殺了他！？你不知道這樣做對我們很不利嗎！？」
		mpechoat $n $I 說「不過至少你成功的完成任務了。」
		mpechoat $n 因為你的急燥，導致經驗減少了！
		mpexp $n -500
		mpechoat $n $I 說「別跑遠了，晚點我還會找你的。」
		mpadd_qmark self plains_slaver_waiting 20 1 0 0 1 1
		mpmod_qmark $n plains_slaver_quest v0 = 0
		mpmod_qmark $n plains_slaver_quest v1 = 3
		break
	endif
endif
~
>talk_prog restart~
if is_qmark($n) == plains_slaver_quest 200000
	if is_qmark($n) <= plains_slaver_quest 100003
		mpechoat $n 你聽到一道聲音說：「任務成功的重設！」
		mpdel_qmark $n plains_slaver_quest
	endif
	break
endif
if is_qmark($n) >= plains_slaver_quest 200001
	if is_qmark($n) <= plains_slaver_quest 200003
		if is_qmark($n) < plains_slaver_quest 300008
			mpechoat $n 你聽到一道聲音說：「本任務第二階段已經成功的重設！」
			mpmod_qmark $n plains_slaver_quest v2 = 0
			break
		endif
		break
	endif
	if is_qmark($n) == plains_slaver_quest 200004
		mpechoat $n 你聽到一道聲音說：「任務已經解完，不需重解。」
	endif
endif
~
>greet_prog 100~
if is_qmark($i) <= plains_slaver_quest 200003
	if isnpc($n)
		if race($n) == Fairy
			if isaffected($n) & 262144
				if insameroom($b)
					mpechoat $b $I 說「幹的好！」
					mpecho $I 連忙把 $N 抓起來帶走。
					mppurge $n
					if is_qmark($b) < plains_slaver_quest 300005
						mpmod_qmark $b plains_slaver_quest v2 + 1
					else
						if is_qmark($b) >= plains_slaver_quest 300005
							mpechoat $b $I 說「幹的好！」
							mpechoat $b $I 說「等等，我找件好東西送你。」
							mpadd_qmark self plains_slaver_speech 20 1 0 0 0 1
						endif
					endif
				endif
			endif
		endif
	endif
	break
endif
if is_qmark($i) == plains_slaver_waiting
	if is_qmark($n) >= plains_slaver_quest 200001
		mpechoat $n $I 說「晚一點再來找我吧。」
		break
	endif
endif
if is_qmark($n) >= plains_slaver_quest 200001
	if is_qmark($n) <= plains_slaver_quest 200003
		if notbeing($b)
			mpechoat $n $I 說「啊！你來了！」
			mpechoat $n $I 說「我有個任務找你....」
			mpechoat $n $I 說「你去幫我抓五隻妖精來吧！」
			mpechoat $n $I 說「記得，是妖精(fairy)，不是小妖精(pixie)。」
			mpmod_qmark $n plains_slaver_quest v2 = 1
			mpadd_qmark self plains_slaver_quest 70 0 0 1 0 1
			mpdef_rembch $n
		else
			if is_qmark($n) == plains_slaver_quest 300001
				break
			else
				mpechoat $n $I 說「啊！你來了！」
				mpechoat $n $I 說「不過已經有人在幫我的忙了。」
				mpechoat $n $I 說「你晚一點再來吧！」
			endif
		endif
	endif
endif
~
>tick_prog 100~
if is_qmark($i) == plains_slaver_speech
	if insameroom($b)
		if is_qmark($b) == plains_slaver_quest 200001
			mpechoat $b $I 說「這個送你吧！」
			mpoload 313 20
			give ofcol $b
			bye $b
			mpmod_qmark $b plains_slaver_quest v0 = 0
			mpmod_qmark $b plains_slaver_quest v1 = 4
			mpmod_qmark $b plains_slaver_quest v2 = 0
			mpdel_qmark self plains_slaver_speech
			mpdel_qmark self plains_slaver_quest
			mpdef_rembch null-tar
			break
		endif
		if is_qmark($b) == plains_slaver_quest 200002
			mpechoat $b $I 說「這個送你吧！」
			mpoload 314 20
			give ofcol $b
			bye $b
			mpmod_qmark $b plains_slaver_quest v0 = 0
			mpmod_qmark $b plains_slaver_quest v1 = 4
			mpmod_qmark $b plains_slaver_quest v2 = 0
			mpdel_qmark self plains_slaver_speech
			mpdel_qmark self plains_slaver_quest
			mpdef_rembch null-tar
			break
		endif
		if is_qmark($b) == plains_slaver_quest 200003
			mpechoat $b $I 說「這個送你吧！」
			mpoload 315 20
			give ofcol $b
			bye $b
			mpmod_qmark $b plains_slaver_quest v0 = 0
			mpmod_qmark $b plains_slaver_quest v1 = 4
			mpmod_qmark $b plains_slaver_quest v2 = 0
			mpdel_qmark self plains_slaver_speech
			mpdel_qmark self plains_slaver_quest
			mpdef_rembch null-tar
			break
		endif
	endif
	break
endif
if is_qmark($i) != plains_slaver_quest
	if being($b)
		tell $b 你動作真慢！
		tell $b 我去找別人好了！
		mpat $b mpechoat $b 你因為動作太慢，導致任務失敗了！
		mpat $b mpechoat $b 任務失敗，被扣除經驗點數！
		mpexp $b -2000
		mpdel_qmark $b plains_slaver_quest
		mpdef_rembch null-tar
	endif
endif
~
