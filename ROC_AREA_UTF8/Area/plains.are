#311
chief northern plains~
長官(chief)~
北方平原的長官(Chief of the Northern Plains)在這裡巡邏。
~
他是奧夫卡的一個小貴族，受史卡拉貝市議會秘令阻止奴隸買賣。
~
8195 168 1000 S
39 500 0 -10d-10+10 20d0+0
-1 0
0 8 1
P 137
>greet_prog 100~
if is_qmark($n) == plains_slaver_quest 100002
	mpechoat $n --- 你找到北方平原的長官了！ ---
endif
~
>talk_prog topic~
if is_qmark($n) == plains_slaver_quest 100002
	mpechoat $n -- 你要怎麼做？
	mpechoat $n -- 你是殺了他(kill)，還是試著說服(persuade)他？
	mpmod_qmark $n plains_slaver_quest v0 = 3
else
	mpechoat $n $I 說「奴隸制度(slavery)是邪惡的行為。」
	mpechoat $n $I 說「一定要阻止這些傢伙的惡行。」
endif
~
>talk_prog slavery~
mpechoat $n $I 說「只可惜我抓不到那個奴隸商犯罪的證據。」
mpechoat $n $I 說「他總是利用幫兇幫忙製造不在場證據(alibi)。」
~
>talk_prog alibi~
mpechoat $n $I 說「我遲早抓出他的犯罪證據！」
~
>talk_prog persuade~
if is_qmark($n) == plains_slaver_quest 100003
	mpechoat $n 你試著說服長官。
	mpechoat $n $I 說「什麼！？叫我跟奴隸商同流合汙！？」
	mpechoat $n $I 說「我想不出什麼理由可以讓我這麼做！」
	mpechoat $n 這時，你要怎麼回答他呢？
	mpechoat $n 是錢財(treasure)，還是更高的地位(class)？
	mpmod_qmark $n plains_slaver_quest v0 = 4
endif
~
>talk_prog treasure~
if is_qmark($n) == plains_slaver_quest 100004
	mpechoat $n 你對長官(chief)解釋了一番。
	mpechoat $n $I 說「的確，奴隸買賣利益相當的高。」
	mpechoat $n $I 說「好，你回去通知(inform)他我答應了。」
	mpmod_qmark $n plains_slaver_quest v0 = 5
endif
~
>talk_prog class~
if is_qmark($n) == plains_slaver_quest 100004
	mpechoat $n 你對長官(chief)解釋了一番。
	mpechoat $n 說「的確，奧夫卡高等貴族普遍支持奴隸制度。」
	mpechoat $n 說「這麼做，也許可以得到他們的支持。」
	mpechoat $n $I 說「好，你回去通知(inform)他我答應了。」
	mpmod_qmark $n plains_slaver_quest v0 = 6
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) == plains_slaver_quest 100003
	mpechoat $n 說「史卡拉貝不會放過你的，卑鄙的奴隸商人！」
	mpechoat $n 你成功的殺了長官(chief)，趕快回去通知(inform)商人吧！
	mpmod_qmark $n plains_slaver_quest v0 = 7
endif
~
