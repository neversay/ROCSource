#MOBILES
#1900
astral guardian~
星界守護者(Astral Guardian)~
穿著灰色護甲的星界守護者(Astral Guardian)在這邊守護星界的入口。
~
你看到這個守衛有著模糊的人類外型，全身缺乏任何明顯的特徵。他站在這裡
雙手交叉在胸前，似乎對你的到來一點也不關心。
~
1|2|64 8|32|128|512|8192 800 S
36 2000 0 30d0+0 0d0+0
-1 0
0 8 0
R Githyanki~
C 1
P 8|256
>talk_prog topic~
if is_qmark($i) == astral_talking
        break
endif
if is_qmark($n) & astral_quest 100001
        bow $n
        say 感謝你平定了整個星界的動亂。
        break
endif
if is_qmark($n) == astral_gith 100002
        mpdel_qmark $n astral_gith
        if is_qmark($n) != astral_quest
                mpadd_qmark $n astral_quest -1 1 0 0 0 1
        else
                mpmod_qmark $n astral_quest v0 | 1
        endif
        yell $n [1;33m平定了在星界作亂的夜靈族！！[m
        say 這是我僅能夠給你的獎品，請收下，我的英雄
        mpoload 1927 35
        give sceptre $n
        if class($n) < 5
                mpexp $n 3500
        else
                mpexp $n 3000
        endif
        wave $n
        break
endif
if is_qmark($n) == astral_gith 100001
        say 小心一點，冒險者！
        say 星界裡面可是步步危機。
        break
endif
mpadd_qmark self astral_talking 5 0 0 0 1 0
say 你是由史卡拉貝城過來的冒險者嗎....？
mpcallout 1 say 怎麼會來到這個危險的地方....？
mpcallout 2 say 我奉史卡拉貝城市長之命來此鎮守星界之門....，
mpcallout 3 say 為的就是不讓裡頭的夜靈族出來搗亂....，
mpcallout 4 say 聽說夜靈族在星界之中作威作福....，
mpcallout 5 say 還囚禁其他種族(race)的生物。
mpcallout 5 mpdel_qmark self astral_talking
~
>talk_prog race~
if is_qmark($i) == astral_talking
        break
endif
mpadd_qmark self astral_talking 5 0 0 0 1 0
say 有沒有聽過夜靈(githyanki)這一種種族....，
mpcallout 1 say 那是一種善於使用魔法的生物....，
mpcallout 2 say 外型長的跟一般人類差不多....，
mpcallout 3 say 體型與身高大小也差不多....，
mpcallout 4 say 但是膚色就像夜空那般的黑....，
mpcallout 5 say 跟暗黑精靈(drow)不同的是....，
mpcallout 6 say 他們沒有那麼長的耳朵，也沒那麼高。
mpcallout 6 mpdel_qmark self astral_talking
~
>talk_prog githyanki~
say 史卡拉貝城創始之初，曾經受到這種生物的侵襲，
say 但自從它們與奪心魔(mind flayer)發生戰爭(war)後，
say 就沒有再來侵擾這邊了。
~
>talk_prog p mind flayer~
say 我不太清楚奪心魔的底細，他們目前仍是謎樣的種族。
say 我只知道奪心魔又叫做靈吸怪(Illithid)。
~
>talk_prog war~
if is_qmark($i) == astral_talking
or is_qmark($i) == astral_gith
or is_qmark($i) & astral_quest 100001
        break
endif
say 有關戰爭的詳細內容我已經不太記得了....，
mpecho $I 抬頭望著天空靜靜的回憶著....
mpcallout 1 say 我在這邊已經很久了....，
mpcallout 2 say 最近聽說在星界的夜靈族有向史卡拉貝侵襲的意圖....，
mpcallout 3 say 雖然大主教黛妮亞為此在星界之門加持了魔法....，
mpcallout 4 say 阻擋了夜靈族的侵擾....，
mpcallout 5 say 但我懷疑夜靈族還是可以利用星界某處的缺口....，
mpcallout 6 say 穿越到下界的史卡拉貝城....，
mpcallout 7 mpechoat $I 看了你一眼，似乎在打量著你的能耐....
mpcallout 7 mpechoaround $I 看了 $n 一眼，似乎在打量著 $n 的能耐....
mpcallout 8 say 我因為有看守星界之門的任務在身....，
mpcallout 9 say 所以不便擅離崗位來深入星界調查....，
mpcallout 10 say 我想你應該是相當有經驗的冒險者吧....，
mpcallout 11 say 你能夠幫我進入星界調查夜靈族的現況嗎(yes/no)？
mpcallout 11 mpdel_qmark self astral_talking
~
>talk_prog yes~
if is_qmark($n) == astral_gith
or is_qmark($i) == astral_talking
or is_qmark($n) & astral_quest 100001
        break
endif
mpadd_qmark $n astral_gith -1 1 0 0 0 1
bow $n
say 謝謝您的幫忙了，不過請小心[1;31m吉斯王[m，
say 聽說他有可怕的不死能力
say 那麼讓我為您打開星界大門....
open n
~
>talk_prog no~
if is_qmark($i) == astral_talking
or is_qmark($n) == astral_gith
or is_qmark($n) & astral_quest 100001
        break
endif
sigh $n
say 是嗎？那真可惜，那只好另請高明了！
wave $n
~
>greet_prog 100~
if isnpc($n)
        break
endif
if rand(50)
        if is_qmark($n) & astral_quest 100001
                bow $n
                say 感謝你平定了整個星界的動亂。
        else
                say 你是史卡拉貝城來的冒險者嗎？
                say 我是守護星界之門的守衛。
                say 我奉勸你不要想進去，
                say 因為星界裡面有非常可怕的生物。
        endif
else
        if is_qmark($n) & astral_quest 100002
                if is_inv_obj($n) == 1928
                        mpechoat $n $I 發現了你身上有一片龍麟，似乎有些話想對你說。
                        say $n ，你身上的是龍的鱗片嗎？它可是能夠被改造成精良的裝備！
                        say 只要找到高級的鐵匠(blacksmith)就可以將其改造。
                endif
        endif
endif
~
>talk_prog blacksmith~
if is_qmark($n) & astral_quest 200001
        say 多年前我還在史卡拉貝城當警備隊長的時候，
        say 曾經聽說史卡拉貝城西北方的新囤墾區，
        say 有個技術高超的鐵匠，
        say 或許他可以給你一些幫助吧！
endif
~
>talk_prog restart~
if is_qmark($n) == astral_gith
        if is_qmark($n) !& astral_quest 100001
                mpechoat $n 天上傳來一陣聲響「本項任務已經重新開始！」
                mpdel_qmark $n astral_gith
        endif
endif
~
|
