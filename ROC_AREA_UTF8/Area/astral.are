~
~
0 -1 1945
>room_enter 32 100~
if ispc($n)
        if is_qmark($n) <= astral_gith 100001
                echoat $n [1;31m吉斯王[m對你喊著：[1;35m竟讓你通過了星界迷宮。[m
                echoat $n [1;31m吉斯王[m對你喊著：[1;35m來吧！找得到我的話，賞賜給你無盡的恐怖喔！[m
        break
        endif
        if is_qmark($n) & astral_quest 100001
                echoat $n 你竟然又聽到[1;31m吉斯王[m的笑聲：[1;35m黑暗與邪惡賜予我永恆的身軀！！[m
        else
                echoat $n 遠方傳來一陣聲音：[1;35m沒想到竟然可以穿透星界到達我的城堡啊！[m
                echoat $n 遠方傳來一陣聲音：[1;35m你以為這樣就可以脫離無盡的恐怖了嗎？[m
                echoat $n 遠方傳來一陣聲音：[1;35m還有更可怕的禮物等著你來拿，哈哈......！[m
        endif
endif
~
|
