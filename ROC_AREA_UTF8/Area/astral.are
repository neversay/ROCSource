mpat 5 c inf
mpmod_all_qmark $n adv_book_1_main v0 | 16384
mpgreward exp $n -42 700
yell 我竟然會被 $n 給打敗，實在不甘心！
yell 暗黑主宰，請您引導我的魂魄吧！
if insameroom($b)
        if is_qmark($b) == astral_gith 100001
                mpmod_qmark $b astral_gith v0 = 2
        endif
        mpecho 遠方傳來[1;31m $I [m的笑聲：[1;35m你以為打敗我就可以脫離這無盡的黑暗了嗎？[m
        mpecho 遠方傳來[1;31m $I [m的笑聲：[1;35m你就永遠留在這無盡暗夜之中吧！哈！哈哈！[m
endif
~
