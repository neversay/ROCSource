R Dragon~
C 1
>talk_prog topic~
if is_qmark($n) != astral_red_dragon
        if is_qmark($n) !& astral_quest 100002
        or is_qmark($n) != astral_quest
                say 我已經被它們奴役囚禁(prison)很久了，
                say 我還有可以自由飛翔的一天嗎？
        endif
else
        if is_qmark($n) == astral_red_dragon 100001
                if is_inv_obj($n) == 1924
                        say 趕緊將[1;36m星形鐵環[m交給我吧！
                else
                        say 你還沒拿到妖后的[1;36m星形鐵環[m嗎？
                        say 趕緊去找星界的妖后，拿取她身上的[1;36m星型鐵環。[m
                        say 這樣才能夠解開我身上的魔法枷鎖，還我自由....。
                endif
        endif
endif
~
>talk_prog prison~
if is_qmark($n) & astral_quest 100002
or is_qmark($n) == astral_red_dragon
        break
endif
mpadd_qmark $n astral_red_dragon -1 0 0 0 0 1
sigh
say 我被夜靈妖后用她的魔法將我監禁在這裡幫它們冶煉武器。
say 每天夜以繼日地不斷奴役我，我已經快要不行了。
say 你能夠協助我脫離妖后的魔掌嗎(yes/no)？
~
>talk_prog yes~
if is_qmark($n) == astral_red_dragon 100000
        mpmod_qmark $n astral_red_dragon v0 = 1
        thank $n
        say 如果你想要救我，就得先拿到妖后身上的[1;36m星型鐵環(pentagram)[m，
        say 這個東西是她所有魔力的泉源，甚至....，
        say 聽說這個東西也是能夠開啟通往夜靈之主住處的重要物品。
endif
~
>talk_prog no~
if is_qmark($n) == astral_red_dragon 100000
        mpdel_qmark $n astral_red_dragon
        sigh
        say 好吧，總有一天我會想辦法自己逃離這裡的！
endif
~
>talk_prog pentagram~
if is_qmark($n) == astral_red_dragon 100001
        say 這個東西就放在星界妖后的身上，不過她有很強的魔力，
        say 而且她身邊也有許多強力的夜靈守衛在保護她的安全，
        think
        say 不過聽說妖后的法力是邪惡的屬性，
        say 或許對於邪惡屬性的人傷害力較小。
endif
~
>give_prog 1924~
if is_qmark($n) == astral_red_dragon 100001
        mpdel_qmark $n astral_red_dragon
        if is_qmark($n) != astral_quest
                mpadd_qmark $n astral_quest -1 2 0 0 0 1
        else
                mpmod_qmark $n astral_quest v0 | 2
        endif
        thank $n
        say 謝謝你讓我取得了自由，我個人無以回報
        say 就把我腳上的一片擁有我魔法能力的鱗片送給你吧！
        mpoload 1928 5
        give scale $n
        if class($n) < 5
                mpexp $n 4500
        else
                mpexp $n 3000
        endif
        say [1;36m你可將他拿給工匠鍛造，或許可以改鍛造出好用的裝備[m
        if is_qmark($n) <= astral_gith 100001
                say 這東西其實對你還有用...
                give pentagram $n
                say [1;36m你可以用它開啟通往吉斯王住處的暗黑之門。[m
                say 我想你來星界應該是要平定整個夜靈族。
                wave $n
        else
                mpjunk pentagram
        endif
        mpecho $I 張開雙翅，澎礡地飛向自由的天空....
        mppurge self
endif
~
>rand_prog 30~
say 每天每天的在這邊搾乾我的能力來幫它們冶煉武器
faint
say 我已經快要受不了了！
~
>talk_prog restart~
if is_qmark($n) == astral_red_dragon
        mpechoat $n 天上傳來一陣聲音「本項任務已經重新開始了！」
        mpdel_qmark $n astral_red_dragon
endif
~
