dancing void shoes~
這是一雙看起來相當不真實的短筒鞋，且拿起來的重量也非常地
輕巧。如果穿在腳上能讓你移動(move)起來更佳靈活。
~
X unreal matter~
>obj_command move default~
if isaffected($n) & 268435456
	echoat $n 你麻痺了。
	break
endif
if is_equ_obj($n) == 8607
	if learned($n) >= 101 85
		if isfight($n)
			if skillexp($n) > 101 5
				if mvnum($n) >= 7000
					echoat $n 你踏出虛無的步伐，靈巧地移動到敵人的身後，給予致命的攻擊！
					echoaround $n $N以奇妙的腳步繞到敵人的身後...緊接著一陣亂砍！
					oforcer here add_affect $n critical 1050 1 19 70 0
					oforcer here force $n circle
					oforcer here modhmv $n 23.10 10 0
					oforcer here del_affect $n critical
					break
				else
					if mvnum($n) >= 6500
						echoat $n 你踏出虛無的步伐，靈巧地移動到敵人的身後，給予致命的攻擊！
						echoaround $n $N以奇妙的腳步繞到敵人的身後...緊接著一陣亂砍！
						oforcer here add_affect $n critical 1050 1 19 50 0
						oforcer here force $n circle
						oforcer here modhmv $n 23.10 10 0
						oforcer here del_affect $n critical
						break
					else
						if mvnum($n) >= 5000
							echoat $n 你踏出虛無的步伐，靈巧地移動到敵人的身後，給予致命的攻擊！
							echoaround $n $N以奇妙的腳步繞到敵人的身後...緊接著一陣亂砍！
							oforcer here add_affect $n critical 1050 1 19 40 0
							oforcer here force $n circle
							oforcer here modhmv $n 23.10 10 0
							oforcer here del_affect $n critical
							break
						else
							if mvnum($n) >= 4500
								echoat $n 你踏出虛無的步伐，靈巧地移動到敵人的身後，給予致命的攻擊！
								echoaround $n $N以奇妙的腳步繞到敵人的身後...緊接著一陣亂砍！
								oforcer here add_affect $n critical 1050 1 19 30 0
								oforcer here force $n circle
								oforcer here modhmv $n 23.10 10 0
								oforcer here del_affect $n critical
								break
							else
								echoat $n 你沒有足夠的體力！
								break
							endif
						endif
					endif
				endif
			else
				if mvnum($n) >= 4500
					echoat $n 你踏出虛無的步伐，靈巧地移動到敵人的身後，給予致命的攻擊！
					echoaround $n $N以奇妙的腳步繞到敵人的身後...緊接著一陣亂砍！
					oforcer here add_affect $n critical 1050 1 19 20 0
					oforcer here force $n circle
					oforcer here modhmv $n 23.10 10 0
					oforcer here del_affect $n critical
					break
				else
					echoat $n 你沒有足夠的體力！
					break
				endif
			endif
		else
			echoat $n 你不是在戰鬥中。
			break
		endif
	else
		echoat $n 你的腳步亂掉了。
		break
	endif
else
	echoat $n 什麼？
	break
endif
~
|

