#MOBILES
#8600
investigator~
調查員(investigator)~
調查員(investigator)正在搜索著整個空間。
~
她身上穿著老舊的史卡拉貝公製調查員衣裝。
~
1|2|64 0 1000 S
70 9000 10000 0d0+0 0d0+0
-1 0
0 8 2
S 45 100000
S 46 100000
W twin swords~ 1 1
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 0 1
~
>fight_prog 100~
mpgoto self
c teleport
mpnowait
mpecho $I 的身影逐漸消失.
mpteleport vnum 8600 8628
~
>talk_prog topic~
if is_qmark($n) != morris_equ_finding
	if is_equ_obj($n) == 8600
	or is_equ_obj($n) == 8601
	or is_equ_obj($n) == 8602
	or is_equ_obj($n) == 8603
	or is_equ_obj($n) == 8604
	or is_inv_obj($n) == 8600
	or is_inv_obj($n) == 8601
	or is_inv_obj($n) == 8602
	or is_inv_obj($n) == 8603
	or is_inv_obj($n) == 8604
		gasp $n
		tell $n 你身上的東西是不是摩爾斯物品？！
		tell $n 能給我看看嗎？
		mpadd_qmark $n morris_equ_finding -1 0 0 0 0 1
		mpcallout 1 mpechoat $n 你心想在這個地方會有人就很怪了，還要把東西給她，至少要先自介一下吧？(introduction)
	else
		mpechoat $n 她認真的查看周圍，沒注意到你。
	endif
endif
~
>talk_prog introduction~
if is_qmark($i) == talking
	mpechoat $I她正在說話。
	break
endif
if is_qmark($n) == morris_equ_finding 100000
	mpadd_qmark self talking
	tell $n 啊？抱歉，因為看到東西太興奮了，所以忘了自我介紹。畢竟如
	tell $n 你所見，這個空間是由不明的魔法所建構出來的，在這裡會碰到
	tell $n 人也真的是有些奇怪。
	giggle
	mpcallout 1 ponder
	mpcallout 2 tell $n 那麼讓我重新介紹一下....
	mpcallout 3 tell $n 公民們的人身安全危害。
	mpcallout 3 tell $n 原因跟理由，並且謹慎評估該區域是否有有可能造成對史卡拉貝
	mpcallout 3 tell $n 我是史卡拉貝城派來的調查員，正在這邊調查這個區域的形成的
	mpcallout 3 salute $n
	mpcallout 5 tell $n 話雖如此...但我的調查進度(work progress)其實嚴重落後呢....
	mpcallout 6 sigh
	mpcallout 6 mpmod_qmark $n morris_equ_finding v0 = 1
	mpcallout 6 mpdel_qmark self talking
endif
~
>talk_prog p work progress~
if is_qmark($i) == talking
	mpechoat $I她正在說話。
	break
endif
if is_qmark($n) == morris_equ_finding 100001
	mpadd_qmark self talking
	tell $n 是的，我的工作早在十天前就應該要完成了。
	tell $n 但花一個月依然找不到太多證據，大部分的時間裡，眼前都只有一片虛無。
	mpcallout 2 tell $n 一座被稱為摩爾斯的城市，不過....
	mpcallout 2 tell $n 目前從存在於空間裡的一些破碎遺跡，大概能推論出這裡可能是
	mpcallout 3 tell $n 大概跟建構出這個詭異空間的魔法脫不了關係吧。
	mpcallout 3 tell $n 這城市應該座落在迷霧之島上，實在想不通為什麼會以這種形式重現於此....
	mpcallout 3 tell $n 史書上記載著，摩爾斯早在上千年前就已經被毀滅，並且從地理位置而言，
	mpcallout 4 mpechoat $n $I看了看你。
	mpcallout 5 tell $n 或許能發現什麼線索也不一定....
	mpcallout 5 tell $n 所以我想盡可能的收集與摩爾斯有關的物品集中分析，
	mpcallout 6 bow $n
	mpcallout 6 tell $n 如果可以，想請你將找到的摩爾斯物品借給我研究，謝謝。
	mpcallout 6 mpmod_qmark $n morris_equ_finding v0 = 2
	mpcallout 6 mpdel_qmark self talking
endif
~
>defun_prog morris_check~
if is_qmark($n) == morris_equ_finding 200031
	mpmod_qmark $n morris_equ_finding v0 = 3
	mpcallout 2 hmm
	mpcallout 3 tell $n 這樣也間接證明出，這空間跟消失的摩爾斯果然存在著某種特殊性關係.....
	mpcallout 3 tell $n 對照歷史書所記載的內容，這些物品果然是古摩爾斯居民平日穿戴的飾品呢。
	mpcallout 4 tell $n 也許摩爾斯城的消失跟構成這空間術式也脫離不了關係.....
	mpcallout 5 think
	mpcallout 7 tell $n 總之多謝你的幫忙，我要先回去一趟對分析的結果作進一步的調查囉。
	mpcallout 8 mpechoat $n $I離開前似乎想到了些什麼。
	mpcallout 9 tell $n 我已經對它進行分析過了，我留著也沒用，就送給你當謝禮吧！
	mpcallout 9 tell $n 對了，這顆石頭是我在探索時發現的。
	mpcallout 10 mpechoat $n $I交給你一顆石頭。
	mpcallout 10 mpoload 8605 $n 1 target
	mpcallout 11 tell $n 那我先走囉，掰掰！
	mpcallout 12 mppurge self
	mpcallout 12 mpecho $I[1;32m腳下忽然出現了巨大的四角魔法陣，緊接著你眼前的景色開始扭曲變形！[0m
	mpcallout 12 c evacuate
else
	mpcallout 1 bow $n
	mpcallout 1 tell $n 你如果有發現更多，請再帶來給我分析。
endif
~
>give_prog 8600~
if is_qmark($n) == morris_equ_finding 100002
	if is_qmark($n) !& morris_equ_finding 200001
		mpmod_qmark $n morris_equ_finding v1 | 1
		tell $n 謝謝你，我分析一下就還你。
		mpechoat $n $I用魔法分析這件物品。
		mpcallout 1 mpjunk all
		mpcallout 1 give $o $n
		mpcall morris_check $n
	else
		tell $n 啊？你借過我這件東西囉。
		give $o $n
	endif
else
	? $n
	drop $o
endif
~
