>room_command wrap boy~
rcall murky_boy_quest_defun $n
~
>room_command bind boy~
rcall murky_boy_quest_defun $n
~
>room_command strap boy~
rcall murky_boy_quest_defun $n
~
>room_defun murky_boy_quest_defun~
if is_qmark(little-murky) == murky_boy_quest
	break
endif
if insameroom(little-murky)
	if is_qmark($n) != murky_quest
	or is_qmark($n) !& murky_quest 100002
		add_qmark little-murky murky_boy_quest 30 0 0 0 1 0
		if is_qmark($n) != murky_quest
			add_qmark $n murky_quest -1 2 0 0 0 1
		endif
		if is_qmark($n) !& murky_quest
			mod_qmark $n murky_quest v0 | 2
		endif
		echoat $n 你趕緊幫 小男孩 止血....。
		echoaround $n $n 趕緊幫 小男孩 止血....。
		callout 1 echoat $n 你隨即撕下自己衣物並幫 小男孩 包紮....。
		callout 1 echoaround $n $n 隨即撕下自己的衣物並幫 小男孩 包紮....。
		callout 2 echoat $n 你趕緊將 小男孩 手上那把危險的剃刀拿走....。
		callout 2 echoaround $n $n 趕緊將 小男孩 手上那把危險的剃刀拿走....。
		callout 2 oload 10714 10 $n target
		callout 3 echo 小男孩 的血順利的止住了....。
		callout 4 force little-murky thank
		callout 4 force little-murky say 謝謝你們....。
		callout 5 rcall murky_boy_quest_reward $n
		callout 7 echo 小男孩(little boy) 一溜煙的就跑掉了....。
		callout 8 purge little-murky
		break
	endif
	if is_qmark($n) & murky_quest 100002
		add_qmark little-murky murky_boy_quest 30 0 0 0 1 0
		echoat $n 你趕緊幫 小男孩 止血....。
		echoaround $n $n 趕緊幫 小男孩 止血....。
		callout 1 echoat $n 你隨即撕下自己衣物並幫 小男孩 包紮....。
		callout 1 echoaround $n $n 隨即撕下自己的衣物並幫 小男孩 包紮....。
		callout 2 echoat $n 你趕緊將 小男孩 手上那把危險的剃刀拿走....。
		callout 2 echoaround $n $n 趕緊將 小男孩 手上那把危險的剃刀拿走....。
		callout 2 oload 10714 10 $n target
		callout 3 echo 小男孩 的血順利的止住了....。
		callout 4 force little-murky thank
		callout 4 force little-murky say 謝謝你們....。
		callout 6 force little-murky kiss $n
		callout 7 echo 小男孩(little boy) 一溜煙的就跑掉了....。
		callout 8 purge little-murky
	endif
endif
~
>room_defun murky_boy_quest_reward~
if isaffected($n) & 65536
or isaffected($n) & 2
	add_affect little-murky 'detect hidden' 1130 -1 0 0 32
	add_affect little-murky 'detect invis' 1130 -1 0 0 8
	echoat $n 因為你不欲人知的善行，你獲得了天神的獎賞....。
	callout 1 force little-murky mpexp $n 6000
else
	echoat $n 因為你的善行，你獲得了天神的獎賞....。
	callout 1 force little-murky mpexp $n 1000
	callout 1 force little-murky mpresp $n 1
endif
~
|
