	echoat $n [1;32m當你打開魔性之門的同時，一股強大的幽冥之力向你衝來........[m
	echoaround $n [1;32m當 $n 打開魔性之門的同時，一股強大的幽冥之力向你衝來........[m
	echotoall [1;32m整個空間開始劇烈的震動，人間通往幽冥之界的通道被打開了........[m
	modrvt v0 = 2
	modrvt t0 = 24
	if class($n) == 8
		echo [1;37m由於主教的聖力守護，使得你受的傷害並不大....[m
		modhmv pc 03.10 15 0
		if rand(50)
			modhmv pc 13.10 15 0
		endif
	else
		echo [1;31m你招受到前所未有的嚴重傷害........！[m
		modhmv pc 03.80 85 0
		if rand(50)
			modhmv pc 13.80 85 0
		endif
	endif
endif
~
