>bribe_prog 5000~
if is_qmark($i) == murky_homo_work
	say 人家在忙，別吵！
	mpgold $n 5000
	break
endif
mpadd_qmark self murky_homo_work 30 0 0 0 1 0
mpjunk all.coins
if ispc($n)
	if race($n) == orc
		say 我討厭半獸人毛茸茸的感覺....，
		mpcallout 1 say 做起來一點都不舒服。
		mpcallout 2 mpgold $n 5000
		break
	endif
	if race($n) == lizardman
		say 留著口水的蜥蜴人....，
		mpcallout 1 say 一點美感都沒有....，
		mpcallout 2 say 叫我怎麼跟你做？
		mpcallout 3 mpgold $n 5000
		break
	endif
	if race($n) == vampire
		say 一口尖牙....，
		mpcallout 1 say 親我的時候輕一點....，
		mpcallout 2 say 不然要跟你多收一倍的價錢。
	endif
	if race($n) == beholder
		say 哇！有那麼多根觸手....，
		mpcallout 1 say 做起來一點會很好....，
		mpcallout 2 say 給你半價優待吧！
		mpcallout 3 mpgold $n 2500
	else
		say 那麼我們就開始吧....！
		mpcallout 1 blush $n
		mpcallout 2 mpechoat $n $I 開始褪去你與他身上所有的衣物....。
		mpcallout 2 mpforce $n remove all
		mpcallout 3 say 我們開始吧....！
		mpcallout 3 kiss $n
		mpcallout 3 close n
	endif
	mpcallout 5 mpechoat $n 你開始與 $I 翻雲覆雨了起來....。
	mpcallout 5 mpechoaround $n $n 開始與 $I 翻雲覆雨了起來....。
	mpcallout 5 mpforcer 10734 modhmv $n 03.35 37 0
	mpcallout 5 mpforcer 10734 modhmv $n 13.35 37 0
	mpcallout 5 mpforcer 10734 modhmv $n 23.35 37 0
	mpcallout 7 mpechoat $n $I 高超的技巧讓你欲仙欲死....。
	mpcallout 7 mpechoaround $n $I 高超的技巧讓 $n 欲仙欲死....。
	mpcallout 7 mpforcer 10734 modhmv $n 03.65 67 0
	mpcallout 7 mpforcer 10734 modhmv $n 13.65 67 0
	mpcallout 7 mpforcer 10734 modhmv $n 23.65 67 0
	mpcallout 9 mpechoat $n 你開始化被動為主動，主動攻擊 $I ....。
	mpcallout 9 mpechoaround $n $n 開始化被動為主動，主動攻擊 $I ....。
	mpcallout 9 mpforcer 10734 modhmv $n 03.85 87 0
	mpcallout 9 mpforcer 10734 modhmv $n 13.85 87 0
	mpcallout 9 mpforcer 10734 modhmv $n 23.85 87 0
	mpcallout 12 mpecho 經過一連串的激烈運動，終於結束了....。
	mpcallout 12 mpforcer 10734 modhmv $n 03.95 97 0
	mpcallout 12 mpforcer 10734 modhmv $n 13.95 97 0
	mpcallout 12 mpforcer 10734 modhmv $n 23.95 97 0
	mpcallout 14 mpechoat $n $I 幫自己著好了全部的衣裳....。
	mpcallout 15 mpcall murky_homo_reward $n
endif
~
>defun_prog murky_homo_reward~
