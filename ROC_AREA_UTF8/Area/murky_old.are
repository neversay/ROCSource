#10774
魔光之池~
在你眼前是一池發出奇異深紅色光芒的池子。你可以感受到異常強大的力場，由
池子中不斷的傳送過來。同時還可以隱約聽到池子中傳來一陣一陣哭喊的聲音。彷彿
在敘述著幽冥空間的痛苦與罪惡。
~
0 1|4|8|262144 7
D3
~
~
0 -1 10773
>room_command enter pool~
if ispc($n)
	if is_qmark($n) != murky_quest
		add_qmark $n murky_quest -1 4 0 0 0 1
		rpexp $n 1000
	endif
	if is_qmark($n) !& murky_quest 100004
		mod_qmark $n murky_quest v0 | 4
		rpexp $n 1000
	endif
	echoat $n 你跳進了池子之中........
	echoaround $n $n 跳進了池子之中........
	transfer $n 10775
endif
~
>room_rand 20~
if rand(30)
	echo [0;31m池子中傳來「我....好苦....啊....」[m
	break
endif
if rand(30)
	echo [0;31m池子中傳來「....救....救救....我啊....」[m
else
	echo [0;31m池子中傳來「我....我好....好恨....殺....殺殺....」[m
endif
~
|
S
#10775
幽冥空間~
跳進了魔光之池，你進入了通往幽冥深淵的空間裂縫之中。這裡是漫無邊際的無
盡幽冥，上下四方沒有一個地方可以供你著力，你只能夠漫無目的的隨處飄游。四周
的星光不斷的流逝，時間彷彿不斷地在流轉，腦中那些可怕的呼喊聲越來越大....！
~
0 1|4|8|262144 9
>room_time 100~
if roomvalue($0) <= 3
	echo 眼前星光移轉迅速，周圍的時間似乎在快速的流逝....
endif
if roomvalue($0) <= 6
	if roomvalue($0) > 3
		echo 眼前星光移轉迅速，周圍快速流逝的時間似乎漸漸緩和下來....
	endif
endif
modrvt v0 + 1
if roomvalue($0) == 7
	echo 忽然你眼前白光一閃，四周的星光忽然停止........
	modrvt v0 = 0
	transfer pc 10737
endif
~
>room_rand 10~
if pcnum($) > 0
	if rand(50)
		echo 周圍黑暗的空間，忽然飄出了 闇影(shade) 向你攻擊過來....！
		mload 10724
		force shadow mpkill $r
	else
		echo 周圍黑暗的空間，忽然飄出了 闇影(shade) 向你攻擊過來....！
		mload 10732
		force shadow mpkill $r
	endif
endif
~
>room_rand 30~
if rand(15)
	echo [0;31m腦中傳來呼喊聲「我....好苦....啊....」[m
	break
endif
if rand(18)
	echo [0;31m腦中傳來呼喊聲「我還....我還不....想死....啊........」[m
	break
endif
if rand(23)
	echo [0;31m腦中傳來呼喊聲「就是....就是你.... $r，你害死我的....」[m
	break
endif
if rand(28)
	echo [0;31m腦中傳來呼喊聲「 $r ，救....救救....我....啊....」[m
	break
endif
if rand(35)
	echo [0;31m腦中傳來呼喊聲「我用....一生....一....生的生命....詛咒 $r 啊！」[m
else
	echo [0;31m腦中傳來呼喊聲「去....去死....死....」[m
endif
~
|
