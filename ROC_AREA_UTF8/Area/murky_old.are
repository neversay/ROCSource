			if is_qmark($b) < murky_mercenary_exp 200100
				if is_qmark($b) >= murky_mercenary_exp 200050
					mpecho [1;35m 劍    術[m：頂級
				endif
			endif
			if is_qmark($b) == murky_mercenary_exp 200100
				mpecho [1;35m 劍    術[m：完美
			endif
			if is_qmark($b) < murky_mercenary_exp 300025
				mpecho [1;35m 治療法術[m：初級
			endif
			if is_qmark($b) < murky_mercenary_exp 300050
				if is_qmark($b) >= murky_mercenary_exp 300025
					mpecho [1;35m 治療法術[m：中級
				endif
			endif
			if is_qmark($b) < murky_mercenary_exp 300075
				if is_qmark($b) >= murky_mercenary_exp 300050
					mpecho [1;35m 治療法術[m：高級
				endif
			endif
			if is_qmark($b) < murky_mercenary_exp 300100
				if is_qmark($b) >= murky_mercenary_exp 300050
					mpecho [1;35m 治療法術[m：頂級
				endif
			endif
			if is_qmark($b) == murky_mercenary_exp 300100
				mpecho [1;35m 治療法術[m：完美
			endif
		endif
	endif
endif
~
>fight_prog 100~
if insameroom($b)
	if is_qmark($b) < murky_mercenary_exp 100025
		skilldrv onehit $n
	endif
	if is_qmark($b) < murky_mercenary_exp 100050
		if is_qmark($b) >= murky_mercenary_exp 100025
			skilldrv speedhit $n
			skilldrv heavyhit $n
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 100075
		if is_qmark($b) >= murky_mercenary_exp 100050
			skilldrv speedhit $n
			skilldrv onehit $n
			skilldrv heavyhit $n
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 100100
		if is_qmark($b) >= murky_mercenary_exp 100075
			skilldrv speedhit $n
			skilldrv speedhit $n
			skilldrv heavyhit $n
			skilldrv heavihit $n
		endif
	endif
	if is_qmark($b) == murky_mercenary_exp 100100
		skilldrv speedhit $n
		skilldrv speedhit $n
		skilldrv speedhit $n
		skilldrv heavyhit $n
		skilldrv heavyhit $n
	endif
endif
~
>fight_prog 30~
if insameroom($b)
	if is_qmark($b) < murky_mercenary_exp 200025
		earth
		mpnowait
	endif
	if is_qmark($b) < murky_mercenary_exp 200050
		if is_qmark($b) >= murky_mercenary_exp 200025
			circular
			mpnowait
			earth
			mpnowait
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 200075
		if is_qmark($b) >= murky_mercenary_exp 200050
			earth
			mpnowait
			flaming
			mpnowait
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 200100
		if is_qmark($b) >= murky_mercenary_exp 200075
			circular
			mpnowait
			perform empslash
			mpnowait
		endif
	endif
	if is_qmark($b) == murky_mercenary_exp 200100
		perform empslash
		mpnowait
		flaming
		mpnowait
	endif
endif
~
>fight_prog 20~
if insameroom($b)
	if is_qmark($b) < murky_mercenary_exp 300025
		c heal
		mpnowait
	endif
	if is_qmark($b) < murky_mercenary_exp 300050
		if is_qmark($b) >= murky_mercenary_exp 300025
			c 'double heal'
			mpnowait
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 300075
		if is_qmark($b) >= murky_mercenary_exp 300050
			c 'double heal'
			mpnowait
			c heal $b
			mpnowait
		endif
	endif
	if is_qmark($b) < murky_mercenary_exp 300100
		if is_qmark($b) >= murky_mercenary_exp 300075
			c 2 'double heal'
			mpnowait
			c 'double heal' $b
			mpnowait
		endif
	endif
	if is_qmark($b) == murky_mercenary_exp 300100
		if rand(90)
			c 2 'double heal'
			mpnowait
			c 2 'double heal' $b
			mpnowait
		else
			c 'gfull heal'
			mpnowait
		endif
	endif
endif
~
