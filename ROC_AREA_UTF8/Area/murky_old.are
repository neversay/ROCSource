			if mobcount(10745) == 0
			        if mobcount(8240) == 0
			             at 8296 mload 8240
			        endif
				if is_qmark($n) != murky_quest
					add_qmark $n murky_quest -1 8 0 0 0 1
					rpexp $n 3000
					rpresp $n 2
				endif
				if is_qmark($n) !& murky_quest 100008
					mod_qmark $n murky_quest v0 | 8
					rpexp $n 3000
					rpresp $n 2
				endif
				echoat $n 你進入了 [0;34m魔性之門[m ........
				echoaround $n $n 進入了 [0;34m魔性之門[m ........
				transfer $n 8254
				break
			endif
		endif
	endif
	echoat $n 你想要進入 [0;34m魔性之門[m，卻被一股力量檔了回來....
	echoaround $n $n 想要進入 [0;34m魔性之門[m，卻被一股力量檔了回來....
	echo [0;34m魔性之門[m 忽然消失了....
	purge gate
	break
endif
~
