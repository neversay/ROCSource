>tick_prog 100~
if hour($) == 20
	say 我好想睡覺喔....！
	mpadd_qmark self murky_baby_quest -1 0 0 0 1 0
	if insameroom(iccy-murky)
		mpadd_qmark iccy-murky murky_baby_quest -1 0 0 0 1 0
		say 依西(Iccy) 我們一起睡吧！
		mpforce iccy-murky say 好啊！
		sleep
		mpforce iccy-murky sleep
	endif
	break
endif
if hour($) == 10
	wak
	mpdel_qmark self murky_baby_quest
	if insameroom(iccy-murky)
		mpdel_qmark iccy-murky murky_baby_quest
		mpforce iccy-murky wak
		say 又白天了呢....！
		mpforce iccy-murky say 對啊！
	endif
endif
~
