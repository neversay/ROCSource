	mpechoat $n [1;32m$I 看到你就立即向你噴出毒液！！[0m
	mpechoaround $n [1;32m$I 看到你就立即向 $n 噴出毒液！！[0m
	if dex($n) > 18
		mpechoat $n [1;36m你機警地閃過了 $I 的毒液攻擊！[0m
	else
		mpforcer here add_affect $n poison 0 50 1 -1 4096
		mpechoat $n [1;32m你中毒了！[0m
	endif
endif
mpkill $n
