>talk_prog assist~
if is_qmark($n) == murky_bouncer_quest 100003
	say 這一件毛衣所需要的原料有：
	if is_qmark($n) !& murky_bouncer_quest 200001
		say 巨人巢穴的巨人硬皮(troll skin)
	endif
	if is_qmark($n) !& murky_bouncer_quest 200002
		say 蠻荒森林猩猩的皮(orang skin)
	endif
	if is_qmark($n) !& murky_bouncer_quest 200004
		say 蠻荒森林的豹皮(leopard skin)
	endif
endif
