>talk_prog topic~
say 父親怕我和賽門(simon)在一起，所以把我關在這裡。
	sigh
~
>talk_prog simon~
say 他是我的男朋友，住在史卡拉貝，但父親嫌他出身低微...
~
>give_prog 8922~
if is_qmark($n) == thief_quest_list 200202
		mpecho $I驚呼：賽門的信！
		mpecho $I急忙把信打開來看。
		mpadd_qmark self ofcol_cathy_story 50 0 0 0 1 0
		mpdef_rembch $n
		mpjunk letter
	else
		pon
		drop letter
	endif
~
>rand_prog 50~
if insameroom($b)
	if is_qmark($i) == ofcol_cathy_story
		mpecho $I看完信後感激的望著你：
		if sex($b) == 1
			say 這位先生真是謝謝你，這封信又給了我無窮的希望...
		else
			say 這位小姐真是謝謝你，這封信又給了我無窮的希望...
		endif
		bow $b
		ponder
		say 我知道賽門沒什麼錢，人又太節儉，一定沒給你什麼報酬。
		say 不過妳這樣幫助我們實在令我過意不去....這樣吧，
		mpecho $I從身後的珠寶箱裡翻出一顆藥丸
		say 這個藥丸是我去世的母親給我的，據說對冒險家們
		say 十分珍貴，就送給你吧。
		mpecho $I把一顆紅色的藥丸交給了你.
		mpoload 670 $b 30 target
		say 對了，能夠麻煩你回去告訴賽門，我會永遠愛他(love forever)嗎？
		thank $b
		wave $b
		mpdel_qmark self ofcol_cathy_story
		mpmod_qmark $b thief_quest_list v1 = 203
		mpmod_qmark $b thief_quest_list v0 r 4
		mpdef_rembch null-tar
	endif
endif
~
