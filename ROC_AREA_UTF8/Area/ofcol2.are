~
>talk_prog topic~
if is_qmark($n) == murky_bouncer_quest 100000
	gasp $n
	mpcallout 1 say 你....你說你到....羅胡城堡見過我愛兒....，
	mpcallout 2 say 他....他有沒有交付你什麼話....？
	mpcallout 3 say 他一切都安好嗎？
	break
endif
if is_qmark($n) == murky_bouncer_quest 100004
	if is_qmark($n) == murky_bouncer_quest 200007
		mpmod_qmark $n murky_bouncer_quest v0 = 5
		sm $n
		mpcallout 1 say 由於您的幫忙....，
		mpcallout 2 say 我終於得以順利完成這件毛衣....。
		mpcallout 3 say 請您將這件毛衣交給我的兒子好嗎？
		mpcallout 4 mpecho $I 將 毛衣(sweater) 交給了你....
		mpcallout 4 mpoload 673 $n viclv target
		break
	endif
endif
sm $n
mpcallout 1 say 您好，有什麼需要幫忙的嗎？
~
