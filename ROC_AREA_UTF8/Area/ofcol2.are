>talk_prog no~
if is_qmark($n) == murky_bouncer_quest 100001
	sigh
	mpmod_qmark $n murky_bouncer_quest v0 = 2
	mpcallout 1 say 那麼請你稍個口訊給我兒子....，
	mpcallout 2 say 跟他說我一切平安....，
	mpcallout 3 say 在 奧夫卡 日夜盼望著他的歸來。
	mpcallout 4 thank $n
	mpcallout 5 wave $n
