	mpmod_qmark $n murky_bouncer_quest v1 | 1
	say 謝謝，我收到 巨人硬皮(troll skin) 了....。
	if is_qmark($n) == murky_bouncer_quest 200007
		mpcall murky_bouncer_quest $n
	endif
endif
