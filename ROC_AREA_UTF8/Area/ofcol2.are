>talk_prog centaur~
if is_qmark($n) != cen_clear_timer
	tell $n 目前南邊峽谷的人馬勢力，還不構成我國的威脅。
	tell $n 除非他們有進一步發展，我們才會採取行動。
	break
endif
if is_qmark($n) == ofcol_cen_clear 100000
	if is_qmark($n) == ofcol_cen_clear 100001
		look $n
		tell $n 你是來接受招募的冒險者嗎？
		mpcallout 1 tell $n 對於任務的內容也都有一定程度的了解，那我就不多作說明了。
		mpcallout 1 tell $n 能夠取得我們私下招人的情報，相信你也算是個有能力的冒險者。
		mpcallout 2 tell $n 我們的要求相當簡單，只要讓南邊的峽谷所有的人馬消失就行了。
		mpcallout 3 tell $n 因此我們不會發放報酬(reward)給臨陣脫逃的人。
		mpcallout 3 tell $n 但是，請記得奧夫卡不能容忍弱者的存在！
		mpcallout 4 tell $n 去吧！不管你使什麼手段，只要求達成任務就行！
		mpcallout 4 mpmod_qmark $n ofcol_cen_clear v0 = 1
	else
		tell $n 把人馬趕走後，自己回來跟我領取獎賞(reward)。
		tell $n 我可沒那個閒功夫幫你把錢送到面前。
	endif
endif
~
>talk_prog reward~
if is_qmark($n) == ofcol_cen_clear 100001
	if mobcount(317) == 0
		mpdel_qmark $n ofcol_cen_clear
		good $n
		tell $n 這是你的獎勵。
		mpgold $n 200000
		if level($n) < 40
			mpexp $n 20000
		else
			mpexp $n 8000
		endif
		mpskillexp $n 500
		mpadd_qmark $n cen_clear_timer 72 0 0 0 0 1
		mpcallout 1 bye $n
		mpcallout 1 tell $n 合作愉快，有機會再找你幫忙。
	else
		ponder $n
		tell $n 派出的探子回報說，谷內還看得到人馬的蹤跡。
		tell $n 認真一點好嗎？
	endif
endif
~
