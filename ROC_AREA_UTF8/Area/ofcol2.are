>give_prog 10795~
mpjunk all.letter
if is_qmark($n) == murky_bouncer_quest 100000
	mpmod_qmark $n murky_bouncer_quest v0 = 1
	mpjunk all.letter
	mpecho $I 含著眼淚，趕緊打開這封信閱讀....
	mpcallout 2 say 原來他竟然身處那麼危險的地方....，
	mpcallout 3 sob
	mpcallout 4 say 這位英雄，有個私人的請求....，
	mpcallout 5 say 不知道您是否能夠幫忙(yes/no)？
endif
~
>talk_prog yes~
if is_qmark($n) == murky_bouncer_quest 100001
	mpmod_qmark $n murky_bouncer_quest v0 = 3
	mpecho $I 對你感激的再度流下淚來....
	mpcallout 1 say 其實是這樣的....，
	mpcallout 2 say 我希望能夠製作一件保暖的衣服給我兒子....，
	mpcallout 3 say 以免他在寒冷的 幽冥深淵 邊緣給凍著了....，
	mpcallout 4 say 但是這件毛衣的原料並不容易取得....，
	mpcallout 5 say 因此需要英雄您的幫忙(assist)。
endif
~
>defun_prog murky_bouncer_quest~
say 等我一下，我需要一點時間製作這件毛衣....，
mpcallout 1 say 大約需要將近半天的時間....，
mpcallout 2 say 若好了我會請人捎信通知你的。
mpcallout 3 mpecho $I 轉身離開了....
mpcallout 3 mpadd_qmark self murky_bouncer_quest 18 0 0 0 1 0
mpcallout 3 mpdef_rembch $n
mpcallout 4 mpgoto 5
~
>tick_prog 100~
if being($b)
	if is_qmark($i) != murky_bouncer_quest
		if is_qmark($b) == murky_bouncer_quest 100003
			mpat $b mpecho [1;37m忽然有個人急急忙忙的跑了過來....，[m
			mpat $b mpecho 那個人說著「抱歉， $b ，莎拉(Sara)叫我過來跟你說毛衣已經完成了！」
			mpat $b mpecho [1;37m那個人話說完後又急急忙忙的離開了這邊。[m
			mpat $b mpmod_qmark $b murky_bouncer_quest v0 = 4
			mpdef_rembch null-tar
			mpgoto 620
		endif
	endif
else
	if is_qmark($i) == murky_bouncer_quest
		mpdel_qmark self murky_bouncer_quest
		mpgoto 620
	else
		if inroom($i) == 620
		else
			mpgoto 620
		endif
	endif
endif
~
