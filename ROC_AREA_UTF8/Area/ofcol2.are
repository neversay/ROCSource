>talk_prog p envoy from greenwoods~
if is_qmark($n) == greenwoods_vice_quest 100000
	mpecho $I 鄙夷地看你一眼....
	mpcallout 1 mpecho $I對你冷笑起來！
	mpcallout 1 say 哼，就憑你們綠樹王國？真是癩蝦蟆想吃天鵝肉...
	mpcallout 1 say 回去告訴你的主子，叫他....
	mpcallout 2 think
	mpcallout 3 mpecho $I 不屑地把一張紙丟到你的腳邊。
 	mpcallout 3 say 拿回去交給你的主子吧，沒用的人渣....
	mpcallout 3 say 算了，告訴你這種跑腿的一點用也沒有，喏，把這封信
	mpcallout 3 mpoload 672 floor
	mpcallout 3 mpmod_qmark $n greenwoods_vice_quest v0 = 1
endif
~
>death_prog 100~
if is_qmark($n) >= greenwoods_vice_meeting 100003
	mpdis_magic self blindness
	mpat 5 c inf
	mpmod_qmark $n greenwoods_vice_meeting v0 | 4
	yell 哇啊！我竟然會被擊敗！
	mpecho $I 負傷逃離戰場，武器掉落在地。
	mpat 5 remove all
	mpoload 647 36 floor
	mppurge self
else
	mpecho $I用盡最後的力量把手中的劍毀掉。
	mpjunk avenger
endif
~
|
