>room_rand 100~
      	if robjcount(4071) > 0
             if robjcount(4072) > 0
                  deldoor 0
                  purge statuea
             endif
        endif
~
>room_command turn statue~
        if robjcount(4071) > 0
           callout 1 echo 「隨著石像的轉動，北面一道密門也漸漸打開。」
           callout 2 makedoor 0 一座石門緩緩上升 stone 0 0 4156
           callout 3 purge statueb
           callout 4 oload 4072 1 floor
        else
           if robjcount(4072) > 0
              callout 1 deldoor 0
              callout 2 echo 「隨著石像的轉動，北面的石門漸漸關閉。」
              callout 3 purge statuea
              callout 4 oload 4071 1 floor
           endif
        endif
~
