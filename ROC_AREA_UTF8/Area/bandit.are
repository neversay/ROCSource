>fight_prog 100~
if is_qmark($n) != bandit_enemy
	mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
endif
if mobcount(4065) > 0
	if insameroom(bishop)
	else
		yell 主教快來！
		mptransfer bishop-bandit
	endif
