>talk_prog topic~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if resp($n) > 10
		say 這不就是在史卡拉貝大名鼎鼎的 $n 嗎？
	else
		if resp($n) > 5
			say 這不就是遠近馳名的 $n 嗎？
		else
			say 喔！原來是盜賊同志 $n 啊？
		endif
	enidif
	say 怎麼？有什麼事情嗎？
else
	say 嗨！你好，有什麼事情需要我的幫忙嗎？
endif
~
>talk_prog key~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	say 我手上的鑰匙啊？那是....有些特殊用途(for some purpose)的。
	gigi
else
	say 鑰匙？不過是件裝飾品而已？
	say 我說怎麼，你是在質問我還是拷問我嗎？
	angry
endif
~
>talk_prog p for some purpose~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	say 原來雖然是同志，卻不知道這件事情啊？
	mpechoat $n $I 偷偷地在你耳朵旁說了些話....
	mpechoaround $n $I 偷偷地在 $n 耳朵旁說了些話....
	tell $n 其實這邊就是盜賊要塞(bandit keep)的入口啊！
else
	say $n 你在說些什麼呀？我完全聽不懂。
endif
~
>talk_prog p bandit keep~
if is_qmark($i) == bandit_talking
	break
endif
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	mpadd_qmark self bandit_talking
	gasp $n
	mpechoat $n $I 將你偷偷拉到房間一旁....
	mpechoaround $n $I 將 $n 偷偷拉到房間一旁....
	mpcallout 1 tell $n 你怎麼知道盜賊要塞這件事的....？
	mpcallout 2 tell $n 算了，我不逼問你了....，
	mpcallout 3 tell $n 但是盜賊要塞的入口位於此處....，
	mpcallout 4 tell $n 是我們盜賊共同的秘密....，
	mpcallout 5 tell $n 如果你答應信守承諾(promise)....，
	mpcallout 6 tell $n 不將這項秘密說出去....，
	mpcallout 7 tell $n 我可以答應為你開門。
	mpcallout 7 mpdel_qmark self bandit_talking
else
	say $n 你在說些什麼呀？我完全聽不懂。
endif
~
>talk_prog promise~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	good $n
	mpechoat $n $I 偷偷地將一把鑰匙交給了你....
	mpechoaround $n $I 不知道塞了什麼東西給 $n ....
	mpoload 4000 $n viclv target
	tell $n 這把鑰匙可以打開此處往下通往盜賊要塞的門，
	tell $n 前往該處接受更多盜賊的訓練吧！
endif
~
