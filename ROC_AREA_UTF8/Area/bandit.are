>room_time 100~
    echo 你覺得身體恢復的速度稍微加快了！
    modhmv pc 04.3 6 00000000
    modhmv pc 14.2 4 00000000
    modhmv pc 24.4 8 00000000
~
>room_enter 31 100~
if is_qmark($n) == bandit_thief_exam 100007
	echoat $n 一陣閃光之後，你被傳送到了火影之間。
	transfer $n 4165
	at 4165 force $n look
	at 4165 echoat $n 玩家請注意，打火影時屍體可能會被清掉，
	at 4165 echoat $n 這是正常情形哦，所以打前請多三思才好。
	break
endif
if is_qmark($n) == bandit_thief_exam 100006
if is_inv_obj($n) == 4070
if is_inv_obj($n) == 4087
if is_inv_obj($n) == 4090
if is_inv_obj($n) == 4091
if is_inv_obj($n) == 4092
if is_inv_obj($n) == 4093
if is_inv_obj($n) == 4094
			purge $n slate-a
			purge $n slate-b
			purge $n slate-c
			purge $n slate-d
			purge $n slate-e
			purge $n slate-f
			purge $n slate-g
			echoat $n 當你一踏進這裡，你身上的七個石版忽然發出一陣耀眼的光茫。
			echoat $n 等到你再清醒過來的時候，你已經被傳送到這個房間了。
			mod_qmark $n bandit_thief_exam v0 = 7
			transfer $n 4165
endif
endif
endif
endif
endif
endif
endif
endif
~
