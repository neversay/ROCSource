>fight_prog 75~
 if is_qmark($n) == bandit_thief_exam 100003
        if hitprcnt($i) <= 65
                 if is_qmark($n) != bandit_thief_jeweldrop
                        mpadd_qmark self bandit_thief_jeweldrop -1 0 0 0 0 1
                        mpcallout 1 goto $i
                        mpcallout 2 say 別..別..別再打了。
                        mpcallout 3 say 我投降了！你們好心點停手吧，再打會出人命的！
                        mpcallout 4 say 東西我還你們就是了！
                        mpcallout 5 say 不過一部分我已經賣了。
                        mpcallout 6 say 賣到了黑市，那個商人住在垃圾場附近。
                        mpcallout 7 mpcall fleeaway
                        mpcallout 8 mpat 5 mppurge self
                endif
        endif
endif
