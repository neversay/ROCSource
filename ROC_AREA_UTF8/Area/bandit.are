~
>defun_prog resp_check~
say 你可以向我學習盜賊新技能：「解除陷阱」了
mpadd_qmark $n untangle -1 1 0 0 0 1
if resp($n) >= 8
	mpoload 4065 $n viclv target
	break
endif
if resp($n) >= 5
	mpoload 4064 $n viclv target
	break
endif
if resp($n) >= 3
	mpoload 4063 $n viclv target
	break
endif
if resp($n) >= 0
	mpoload 4062 $n viclv target
endif
~
>talk_prog member~
if is_qmark($n) == bandit_thief_exam 100004
	mpcallout 1 mpechoat $n $I仔細地打量你。
	mpcallout 2 say 依照你的能力，我給你我們的證明。
	mpcallout 3 mpcall resp_check $n
	mpcallout 4 mpechoat $n $I 把盜賊的守則給了你。
	mpmod_qmark $n bandit_thief_exam v0 = 5
else
	say 你還不夠格啊！
endif
~
>talk_prog restart~
if is_qmark($n) == bandit_thief_exam
	if is_qmark($n) == bandit_thief_exam 100005
		mpechoat $n 「遠處傳來一陣聲音：你已經完成本任務了！」
		break
	else
		mpmod_qmark $n bandit_thief_exam v0 = 1
		mpechoat $n 「遠處傳來一陣聲音：你的任務重新開始了！」
	endif
endif
~
>fight_prog 100~
if is_qmark($n) != bandit_enemy
	mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
endif
if hitprcnt($i) < 30
	if is_qmark($i) > bandit_chief_heal 300001
		mpecho [1;33m$I 吃下了一顆[0m[1;36m青色藥丸[0m[1;33m....[0m
		mpat 5 c 3 'doubl heal'
		mpmod_qmark self bandit_chief_heal v2 - 1
		mpnowait
	else
		if is_qmark($i) == bandit_chief_heal 300001
			yell 糟糕！我身上已經沒有[1;36m青色藥丸[0m了！
			mpmod_qmark self bandit_chief_heal v2 = 0
		endif
	endif
endif
if hitprcnt($i) < 50
	if is_qmark($i) > bandit_chief_heal 200001
		mpecho [1;33m$I 吃下了一顆[0m[1;31m紅色藥丸[0m[1;33m....[0m
		mpat 5 c 2 'double heal'
		mpmod_qmark self bandit_chief_heal v1 - 1
		mpnowait
	else
		if is_qmark($i) == bandit_chief_heal 200001
			yell 糟糕！我身上已經沒有[1;31m紅色藥丸[0m了！
			mpmod_qmark self bandit_chief_heal v1 = 0
		endif
	endif
endif
if hitprcnt($i) < 70
	if is_qmark($i) > bandit_chief_heal 100001
		mpecho [1;33m$I 吃下了一顆[0m白色藥丸[1;34m....[0m
		mpat 5 c 'double heal'
		mpmod_qmark self bandit_chief_heal v0 - 1
		mpnowait
	else
		if is_qmark($i) == bandit_chief_heal 100001
			yell 糟糕！我身上已經沒有[1;37m白色藥丸[0m了！
			mpmod_qmark self bandit_chief_heal v0 = 0
		endif
	endif
endif
if is_equ_obj($i) != 4004
	wear bronze-dagger
endif
if is_equ_obj($i) != 4056
	wear assassination-dagger
endif
if rand(80)
	disarm
	mpnowait
	yell $n 死吧！看我的背刺....！
	mpdef_rembch $n
	mpgoto $b
	bs $b
	mpnowait
	mpdef_rembch null-tar
endif
if rand(50)
	disarm
	mpnowait
	yell $n 死吧！看我的連續背刺....！
	mpdef_rembch $n
	mpgoto $b
	bs $b
	mpnowait
	if insameroom($b)
		mpgoto $b
		bs $b
		mpnowait
	endif
	mpdef_rembch null-tar
endif
~
>kill_prog 100~
if ispc($n)
	mpget $n 3 0
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) != bandit_enemy
		mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
	endif
	shout 我竟然會被身為盜賊的人所擊敗，我不甘心....！
else
	if is_qmark($n) != bandit_enemy
		mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
	endif
	shout $n 我會記住你的，今後你將會被我的屬下所追殺....！
endif
~
