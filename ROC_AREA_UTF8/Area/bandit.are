>fight_prog 30~
if isaffected($i) & 1
	c 'cure blindness'
endif
if isaffected($i) & 4096
	c 'cure poison'
endif
if isaffected($i) & 8388608
	grin
	mpdis_magic self mute
	say 禁言術對我來說是沒有用的。
	mpecho $I 身上的禁言術消失了....。
endif
if isaffected($i) & 16777216
	shake
	say 你無法封鎖我身上的魔法。
	mpdis_magic self 'seal magic'
	mpecho $I 身上的封鎖魔法失效了....。
endif
if isaffected($i) & 268435456
	say 麻痺術怎麼可能對我有效呢？
	mpdis_magic self paralyze
	mpecho $I 的身體再度又能夠活動自如....。
endif
