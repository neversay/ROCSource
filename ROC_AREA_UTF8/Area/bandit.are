#4170
隱藏的密室~
灰塵佈滿了整個空間，牆上掛著蜘蛛網，看來已經有段時日沒有人進來過了。唯一
吸引你注意的是一口破舊的箱子。
~
0 8 0
D2
~
~
0 0 4160
>room_enter 127 100~
  if rand(30)
     echo 「突然傳出一陣喀喀聲」
     callout 1 deldoor 2
     callout 2 at 4160 deldoor 0
     callout 2 at 4160 purge statue
     callout 3 at 4160 oload 4095 1 floor
     callout 4 echo 「喔喔！看來你是觸動了機關了！」
     callout 5 echo 你發現你可能要自力救濟自行解除南邊的陷阱了。
  endif
~
>room_mask untangle south~
if learned($n) >= 133 10
	if rand(60)
		echo 你小心翼翼地找尋室內的機關，發現了一個裝置，並且將它拆除！
		callout 1 echo 一陣聲響後，南邊的門打開了......
		callout 1 makedoor 2 一座石門緩緩上升 stone 0 0 4160
	else
		echo 你小心翼翼地找尋室內的機關，但是什麼也沒有找到，而且還觸發了陷阱！
		modhmv $n 03.10 15 00000001
	endif
else
	if rand(10)
		echo 你小心翼翼地找尋室內的機關，發現了一個裝置，並且將它拆除！
		callout 1 echo 一陣聲響後，南邊的門打開了......
		callout 1 makedoor 2 一座石門緩緩上升 stone 0 0 4160
	else
		echo 你小心翼翼地找尋室內的機關，但是什麼也沒有找到，而且還觸發了陷阱！
		modhmv $n 03.10 15 00000001
	endif
endif
~
|
S
