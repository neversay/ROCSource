P 8|256|8192|16384|4194304|8388608|16777216
S 41 150
S 42 150
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
if being(princess-bandit)
else
	mpmload 4002
endif
if insameroom(princess-bandit)
else
	mptransfer princess-bandit
	mpforce princess-bandit mpat 5 c 'full heal'
endif
mpgroup princess-bandit self 1 0
~
>fight_prog 100~
if is_qmark($n) != bandit_enemy
	mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
endif
mpcall bandit_prince_heal $n
if is_equ_obj($i) != 4060
	wear poisonous-dagger
endif
if rand(50)
	disarm
	mpnowait
	yell $n 死吧！看我的背刺....！
	mpdef_rembch $n
	mpgoto $b
	bs $b
	mpnowait
	mpdef_rembch null-tar
endif
if rand(30)
	disarm
	mpnowait
	yell $n 看我的連續背刺....！
	mpdef_rembch $n
	mpgoto $b
	bs $b
	mpnowait
	if insameroom($b)
		mpgoto $b
		bs $b
		mpnowait
	endif
	mpdef_rembch null-tar
endif
~
>rand_prog 50~
mpcall bandit_prince_heal
~
>defun_prog bandit_prince_heal~
if insameroom(princess-bandit)
	if isaffected($i) & 1
		mpforce princess-bandit c 'cure blindness' prince-bandit
	endif
	if isaffected($i) !& 128
		mpforce princess-bandit c sanc prince-bandit
	endif
	if isaffected($i) & 1024
		mpforce princess-bandit c 'remove curse' prince-bandit
	endif
	if isaffected($i) & 4096
		mpforce princess-bandit c 'cure poison' prince-bandit
	endif
	if isaffected($i) & 268435456
		mpforce princess-bandit c vivi prince-bandit
	endif
	if hitprcnt($i) < 30
		mpforce princess-bandit c 3 'double heal' prince-bandit
		break
	endif
	if hitprcnt($i) < 50
		mpforce princess-bandit c 2 'double heal' prince-bandit
		break
	endif
	if hitprcnt($i) < 70
		mpforce princess-bandit c 'double heal' prince-bandit
	endif
endif
~
>kill_prog 100~
if ispc($n)
	mpget $n 3 0
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) != bandit_enemy
		mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
	endif
	yell 我竟然會被身為盜賊的人所擊敗，我不甘心....！
else
	if is_qmark($n) != bandit_enemy
		mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
	endif
	yell $n 我會記住你的，我的父王將為我報仇....！
endif
~
