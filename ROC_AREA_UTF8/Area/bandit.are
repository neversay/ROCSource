	if hitprcnt($i) < 30
		mpforce bishop-bandit c 3 'double heal' wizard-bandit
		break
	endif
	if hitprcnt($i) < 50
		mpforce bishop-bandit c 2 'doubl heal' wizard-bandit
		break
	endif
	if hitprcnt($i) < 70
		mpforce bishop-bandit c 'double heal' wizard-bandit
	endif
endif
