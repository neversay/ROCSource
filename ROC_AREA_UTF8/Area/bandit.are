princess-bandit bandit princess~
盜賊公主(Bandit Princess)~
美麗的盜賊公主(bandit princess)靜靜的看著你。
~
她身上並沒有什麼特別的。
~
1|2|4|64|1024|2048|4096|8192|262144|524288|8388608|16777216 8|32|128|512|8192|32768|65536 -1000 S
50 3000 0 20d-30+500 0d-400+30
-1 0
0 8 0
C 1|4|8
P 8|256|8192|16384|1048576|2097152|4194304|8388608|16777216|67108864
S 41 150
S 42 150
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpoload 4114
mpoload 4115
mpoload 4116
mpat 5 wear all
~
>fight_prog 100~
if is_qmark($n) != bandit_enemy
	mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
endif
if ispc($r)
	if rand(25)
		c blindness $r
	else
		if rand(33)
			c 3 poison $r
		else
			if rand(50)
				c 3 curse $r
			else
				c crush $r
			endif
		endif
	endif
endif
mpcall bandit_princess_heal $n
~
>rand_prog 50~
mpcall bandit_princess_heal
~
>defun_prog bandit_princess_heal~
if mobcount(4001) > 0
	if insameroom(prince-bandit)
	else
		yell 請王子回到我身邊幫助我擊退外敵！
		mpecho [1;33m盜賊王子(Bandit Prince) 忽然出現了！[0m
		mptransfer prince-bandit
	endif
endif
if isaffected($i) & 1
	c 'cure blindness'
endif
if isaffected($i) !& 128
	c sanc
endif
if isaffected($i) & 1024
	c 'remove curse'
endif
if isaffected($i) & 4096
	c 'cure poison'
endif
if hitprcnt($i) < 30
	c 3 'gdouble heal'
	mpnowait
	break
endif
if hitprcnt($i) < 50
	c 2 'gdouble heal'
	mpnowait
	break
endif
if hitprcnt($i) < 30
	c 'gdouble heal'
	mpnowait
endif
~
>kill_prog 100~
if ispc($n)
	mpget $n 3 0
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) != bandit_enemy
		mpadd_all_qmark $n bandit_enemy -1 0 0 0 1 1
