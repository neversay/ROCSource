#MOBILES
#4000
chief-bandit bandit chief~
盜賊頭頭(Bandit Chief)~
盜賊頭頭(bandit chief)正高貴的坐在這裡。
~
他看起來沒什麼特別的。
~
1|2|64|1024|2048|4096|8192|262144|524288|8388608|16777216 8|32|128|512|8192|32768|65536|4294967296 -1000 S
60 3000 0 30d-80+1000 0d-500+50
-1 0
0 8 0
K circle darkraid track nightstalk assassination reflexion *untangle 'deadly strike' escape morphing backstab sneak
 'enhanced damage' 'tricky pacing' scan dodge hide critical 'dart mastery'~
J assassin ninja ranger~
C 1|4|8
P 1|4|8|256|8192|16384|4194304|8388608|16777216
S 41 250
S 42 250
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self bandit_chief_heal -1 20 20 20 1 0
~
>all_greet_prog 100~
if is_equ_obj($i) != 4004
	wear bronze-dagger
endif
if is_equ_obj($i) != 4056
	wear assassination-dagger
endif
if is_qmark($n) == bandit_enemy
	if hitprcnt($i) > 50
		if rand(20)
			bs $n
			mpnowait
		else
			assa $n
			mpnowait
			flee
			flee
			flee
		endif
	else
		if rand(50)
			assa $n
			mpnowait
			flee
			flee
			flee
		else
			bs $n
			mpnowait
		endif
	endif
	break
endif
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) != bandit_thief_exam
		say 小子，沒有經過我的認定你只能夠稱為普通的盜賊。
		mpcallout 1 say 如果想要成為真正的盜賊，最好向我好好請教一下。
		mpcallout 1 mpadd_qmark $n bandit_thief_exam -1 1 0 0 0 1
		break
	endif
else
	say 職業不是盜賊的你，能夠走到我面前來已經算是不錯了。
	mpcallout 1 say 說吧！有什麼問題或要求，如果我能夠辦到一定儘量幫助你。
endif
if is_qmark($n) == bandit_thief_exam 100005
	if class($n) == 10
		say 你來了啊！我的得力助手....
		mpcallout 1 mpechoat $n $I 仔細打量著你....
		mpcallout 1 mpechoaround $n $I 仔細打量著 $n ....
		mpcallout 2 say 看來自從你上次離開至今，又長進了不少。
		mpcallout 3 gig
		mpcallout 4 say 我想你應該有能力挑戰進一步的試練。
		mpcallout 5 say 通過的話，還可以學到新的技能！如果你夠小心的話。
		mpcallout 6 chuckle
		mpcallout 7 say 怎樣！想不想試試啊(sure/not sure)？
		break
	endif
endif
if is_qmark($n) >= bandit_thief_exam 100006
	if class($n) == 10
		say 如果你想再次回去修練(discipline)，就告訴我一聲。
	endif
endif
~
>talk_prog topic~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) == bandit_thief_exam 100001
		say 我給你幾個任務，看看你是否有資格能夠接受我們的盜賊試煉。
		say 你有足夠的勇氣與技巧接受嗎(yes/no)？
		break
	endif
endif
if class($n) == 10
	if is_qmark($n) == bandit_thief_exam 100005
		say 看來你已經逐漸的成長茁壯了，那麼該是接受最後試練的時候了，
		say 最後的試練，你必須利用你所有曾經學會或是即將學會的技能，
		say 去達到最後的這項修練。如果你準備好，就請告訴我(sure)。
	endif
endif
if is_qmark($n) == bandit_thief_exam 100006
	say 看來你是失敗了，別灰心。如果準備好了，想要再試一次，
	say 那就再跟我說一下吧(discipline)。
endif
if is_qmark($n) == bandit_thief_exam 100007
	say 你又來了呀，想要進去試煉再提升你的實力嗎(discipline)？
endif
~
>talk_prog yes~
if class($n) == 2
or class($n) == 9
or class($n) == 10
or class($n) == 17
	if is_qmark($n) == bandit_thief_exam 100001
		if is_qmark($n) == thief_quest_list 100000
			mpmod_qmark $n bandit_thief_exam v0 = 2
			say 很好，這邊的任務可不是像在史卡拉貝那種小兒科的任務。
			mpcallout 1 say 想要加入我們，沒有一定的實力是不行的。
			mpcallout 2 say 當然，如果有幸成為我們的一員！
			mpcallout 3 say 能夠享受的利益是遠比一般盜賊公會好的多。
			mpcallout 4 hmm $n
			mpcallout 5 say 既然你有心想要加入，我就先給你一個任務，
			mpcallout 6 say 看看你的實力能不能符合我的要求吧。
			mpcallout 7 hmm $n
			mpcallout 8 say 最近我珍藏的一批珠寶竟然莫名的消失了，
			mpcallout 9 say 看來應該是要塞裡面的內賊所為，這件事情我尚未處理。
			mpcallout 10 say 不過你既然有心想加入，我看就當做你的考驗吧！
			mpcallout 11 say 你去把我遭竊的珠寶找回來。
			 mpcallout 12 mpat 4120 mpmload 4049
			mpcallout 13 say 拿回來後直接把東西給我吧。
			mpcallout 14 say 至於那個可惡的叛徒，他如果願意主動拿出來就算了。
			mpcallout 15 say 不願意的話，你就替我教訓教訓他吧！
			mpcallout 16 wave
		else
			mpcallout 1 mpechoat $n $I 不屑的看了你一眼....
			mpcallout 1 mpechoaround $n $I 不屑的看了 $n 一眼....
			mpcallout 2 say 連史卡拉貝那種小兒科任務都還沒完全解決的人，
			mpcallout 3 say 我是不會要的。你去多磨練自己吧！
		endif
	endif
endif
~
>talk_prog no~
if is_qmark($n) ==bandit_thief_exam 100000
	say 看來你是膽怯了。
	mpcallout 1 say 等你有了足夠的勇氣與技巧的時候，再來找我吧！
endif
~
>talk_prog p not sure~
if is_qmark($n) == bandit_thief_exam 100005
	ponder $n
	mpcallout 1 say 既然你尚心存顧忌！就先去鍛鍊鍛鍊自己吧！
	mpcallout 2 say 我就不逼你了！
	mpcallout 3 wave $n
endif
~
>talk_prog p sure~
if class($n) == 10
	if is_qmark($n) == bandit_thief_exam 100005
      		gig
      		mpmod_qmark $n bandit_thief_exam v0 = 6
                mpcallout 1 say 很好很好！我果然沒看錯人，
                mpcallout 2 say 我這就送你過去！
                mpcallout 3 mpcall set_guardian
                mpcallout 4 mpecho 你聽到一陣奇怪的喀喀聲，似乎是機關運作的聲響。
                mpcallout 5 mptransfer $n 4152
                mpcallout 6 mpat 4152 mpechoat $n 機關運作的喀喀聲停止後，你被送到了一間密室。
	endif
endif
~
>defun_prog set_guardian~
mpat 4155 mppurge guardian-bandit
mpat 4155 mpmload 4054
mpat 4159 mppurge guardian-bandit
mpat 4159 mpmload 4055
mpat 4160 mppurge guardian-bandit
mpat 4160 mpmload 4056
mapt 4161 mppurge guardian-bandit
mpat 4161 mpmload 4057
mpat 4162 mppurge guardian-bandit
mpat 4162 mpmload 4058
mpat 4163 mppurge guardian-bandit
mpat 4163 mpmload 4059
mpat 4164 mppurge guardian-bandit
mpat 4164 mpmload 4060
~
>talk_prog discipline~
if class($n) == 10
      if is_qmark($n) == bandit_thief_exam 100007
                say 沒問題，我這就送你過去！
                mptransfer $n 4152
               	mpcall dis_guardian
                mpcall set_guardian
      endif
      if is_qmark($n) == bandit_thief_exam 100006
      		sm $n
                mpcallout 1 say 很好！你的確很努力，
                mpcallout 2 say 我這就送你過去！
                mpcallout 3 mpcall dis_guardian
                mpcallout 4 mpcall set_guardian
                mpcallout 4 mpechoat $n 你聽到一陣奇怪的喀喀聲，似乎是機關運作的聲響。
                mpcallout 5 mptransfer $n 4152
                mpcallout 6 mpat 4152 mpechoat $n 機關運作的喀喀聲停止後，你被送到了一間密室。
      endif
endif
~
>defun_prog dis_guardian~
mpat 4155 mppurge guardian-bandit
mpat 4159 mppurge guardian-bandit
mpat 4160 mppurge guardian-bandit
mpat 4161 mppurge guardian-bandit
mpat 4162 mppurge guardian-bandit
mpat 4163 mppurge guardian-bandit
mpat 4164 mppurge guardian-bandit
~
>give_prog 4067~
if is_qmark($n) == bandit_thief_exam 100003
        if is_qmark($n) != bandit_thief_jewel
                mpadd_qmark $n bandit_thief_jewel -1 1 0 0 0 1
                mpjunk all.jewel
                say 我收到珠寶了。
        else
                if is_qmark($n) == bandit_thief_jewel 100002
                        mpjunk all.jewel
                        say 沒錯都齊了。
                        say 你合格了，恭喜你成為我們的一員(member)。
	        mpechoat $n 你心想 ：「該問問成員該有的優待吧？」
                        mpmod_qmark $n bandit_thief_exam v0 = 4
                        mpdel_qmark $n bandit_thief_jewel
                else
                        say 我不需要這個，你已經給過了。
                        drop jewel
                endif
        endif
else
        say 你給我這做什麼？
        drop jewel
endif
~
>give_prog 4068~
if is_qmark($n) == bandit_thief_exam 100003
        if is_qmark($n) != bandit_thief_jewel
                mpadd_qmark $n bandit_thief_jewel -1 2 0 0 0 1
                mpjunk all.jewel
                say 我收到珠寶了。
        else
                if is_qmark($n) == bandit_thief_jewel 100001
                        mpjunk all.jewel
                        say 沒錯都齊了。
                        say 你合格了，恭喜你成為我們的一員(member)。
	        mpechoat $n 你心想 ：「該問問成員該有的優待吧？」
                        mpmod_qmark $n bandit_thief_exam v0 = 4
                        mpdel_qmark $n bandit_thief_jewel
                else
