if is_qmark($i) == saintarea_sasong 100003
        mpecho $I唱道：「送君一曲終歸無, 蒼天茫茫夕色暮」
        mpdel_qmark self saintarea_sasong
endif
if is_qmark($i) == saintarea_sasong 100002
        mpecho $I唱道：「凡地非為神祇住, 虔心祈求能致務」
        mpmod_qmark self saintarea_sasong v0 + 1
endif
if is_qmark($i) == saintarea_sasong 100001
        mpecho $I唱道：「切記旅途危機伏, 步步為營性命顧」
        mpmod_qmark self saintarea_sasong v0 + 1
endif
if is_qmark($i) == saintarea_sasong 100000
        mpecho $I唱道：「君此當往女神處, 應尋十二宮之路」
        mpmod_qmark self saintarea_sasong v0 + 1
endif
