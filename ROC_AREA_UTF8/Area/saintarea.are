>greet_prog 50~
if rand(70)
        say 各位是來聖域冒險的嗎?
else
        say 唉, 雙子座的聖衣還沒修好....
endif
~
>rand_prog 15~
if is_qmark($i) == work_delay
  mpecho $I正拿著鐵鎚揮汗工作.
else
  break
endif
~
>talk_prog topic~
if is_qmark($n) == saintarea_quest_geminimask
or level($n) < 20
or rand(60)
        break
endif
say 當年卡諾和薩卡共同守護雙子聖衣之時
say 我將聖衣分成兩部分...
say 現在是把聖衣回歸原狀的時候了, 你能幫我嗎(yes/no)?
mpadd_qmark $n saintarea_quest_geminimask -1 0 0 0 0 1
~
>talk_prog yes~
if is_qmark($n) == saintarea_quest_geminimask 100000
        mpmod_qmark $n saintarea_quest_geminimask v0 = 1
        nod $n
        say 你把雙子座的聖衣拿來給我吧
endif
~
>talk_prog no~
if is_qmark($n) == saintarea_quest_geminimask 100000
        mpdel_qmark $n saintarea_quest_geminimask
        say 好吧, 那就請您自己逛逛吧
endif
~
>give_prog 9316~
if is_qmark($n) == saintarea_quest_geminimask 100001
        mpjunk helmet
        mpmod_qmark $n saintarea_quest_geminimask v1 = 1
        if is_qmark($n) == saintarea_quest_geminimask 300001
                mpmod_qmark $n saintarea_quest_geminimask v0 = 2
                say 好啊, 你真的都拿回來了....看我的....
                mpecho [1;31m叮-----鏘-----叮-----鏘-----叮-----鏘[m
                mpoload 9317 $n viclv target
                mpechoat $n $I 把 雙面幻盔(gemini helmet) 給你.
                mpechoaround $n $I 把 雙面幻盔(gemini helmet) 給了 $n.
                if class($n) < 5
                        mpexp $n 1000
                endif
                mpexp $n 2000
                say 好了, 這才是雙子座最強的聖衣
                mpechoat $n $I狂笑著：我是最厲害的神匠啦...哈哈哈哈...
        else
                say 嗯, 這是薩卡的善之盔, 卡諾的惡之盔呢?
        endif
endif
~
>give_prog 9318~
if is_qmark($n) == saintarea_quest_geminimask 100001
        mpjunk helmet
        mpmod_qmark $n saintarea_quest_geminimask v2 = 1
        if is_qmark($n) == saintarea_quest_geminimask 200001
                mpmod_qmark $n saintarea_quest_geminimask v0 = 2
                say 好啊, 你真的都拿回來了....看我的....
                mpecho [1;31m叮-----鏘-----叮-----鏘-----叮-----鏘[m
