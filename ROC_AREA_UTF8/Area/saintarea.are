~
>talk_prog inlay~
if is_qmark($n) == saintarea_perseus 100004
  mpmod_qmark $n saintarea_perseus v0 + 1
  mpecho 你向$I說出事情的經過...
  ponder
  say 知道是知道啦...不過美杜莎之首這種危險物品要加工的話...
  say 得先拿個東西給他包(pack)起來才行...
  say 你去問問穆吧, 他對處理這些事情蠻拿手的...
else
  break
endif
~
>give_prog 9356~
if is_qmark($n) == saintarea_perseus 100014
  mpmod_qmark $n saintarea_perseus v0 + 1
  nod
  mpjunk box
  say 把盾牌也拿來吧, 我幫你鑲上去.
else
  if is_qmark($n) == saintarea_perseus 100015
    nod
    mpadd_qmark $n work_delay 12 0 0 0 0 1
    mpmod_qmark $n saintarea_perseus v0 + 1
    mpjunk box
    say 工作時間需要12小時, 請稍後再來取貨(get).
  else
    break
  endif
endif
~
>give_prog 9352~
if is_qmark($n) == saintarea_perseus 100014
  mpmod_qmark $n saintarea_perseus v0 + 1
  nod
  mpjunk shield
  say 把美杜莎的頭也拿來吧, 我幫你鑲上去.
else
  if is_qmark($n) == saintarea_perseus 100015
    mpmod_qmark $n saintarea_perseus v0 + 1
    nod
    mpjunk shield
    mpadd_qmark $n work_delay 12 0 0 0 0 1
    say 工作時間需要12小時, 請稍後再來取貨(get).
  else
    break
  endif
endif
~
>talk_prog get~
if is_qmark($n) == work_delay
  say 工作尚在進行中, 請稍後再來.
else
  if is_qmark($n) == saintarea_perseus 100016
    mpmod_qmark $n saintarea_perseus v0 + 1
    nod
    say 我沒想到結合之後力量變的這麼強....
    mpechoat $n $I把蛇髮女之盾給了你.
    mpechoaround $I把蛇髮女之盾給了$N
    mpoload 9357 $n target
  else
    break
  endif
endif
~
