#60678
失落森林深處的古塔~
古塔的門被你打開之後，你腳下是古老的魔法陣，十三個點構築
成帶有強大的力量的十三芒星紋，直接蝕刻在黑色的堅石上，你發現
古塔中央有個高聳的祭壇，祭壇上有尖銳的十三芒星構成的尖角，角
上有特殊的凹槽，凹槽延伸到周旁魔法陣的十三個點上，看來要啟動
這個魔法陣似乎需要某種儀式。
~
0 8|1048576 4
>room_command devote blood~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100012
                echoat $n 你忍著痛將自己的手如同祭壇石雕上那般狠狠穿刺！
                callout 1 echoat $n 雖然你是這麼想的，但實際上你竟然一點痛覺都沒有！
                callout 2 echoat $n 但是祭壇上的十三芒星角確實刺穿了你的手心，血也毫不留情的流著！
                callout 3 echoat $n 很快的你的手幾乎喪失了血色，而四周也慢慢泛起奇特的血光......
                callout 4 echoat $n 就在血的十三芒星陣完成的瞬間，你感覺有股力量將你的手推離了祭壇的星角！
                callout 6 echoat $n 你簡直不敢相信，你的手依然完好如初，只是蒼白了些...
                callout 8 transfer $n 60697
                callout 8 mod_qmark $n lf_hunter v0 = 13
                callout 8 echoat $n 等你睜開眼睛...你已經來到了一處陌生的地方...
                callout 8 echoat $n 你腳下的十三芒星陣發出了令人無法逼視的強烈紅光！
        endif
break
endif
if is_qmark($n) > lf_hunter 300001
~
>room_command search altar~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100011
                echoat $n 你小心的搜索著祭壇，接著你看到祭壇四周刻劃著一些東西
                callout 1 echoat $n 上面刻劃著一個人將自己的手掌刺過祭壇上的尖角
                callout 2 echoat $n 血透過祭壇快速的往十三個角落流去，最後組成血的十三芒星陣
                callout 3 echoat $n 似乎這就是進入血族世界的方式，貢獻你的血(devote blood)
                callout 3 mod_qmark $n lf_hunter v0 = 12
        endif
endif
~
>room_command search default~
        echoat $n 你環顧四週...腳下是個巨大的魔法陣
        callout 1 echoat $n 地上是罕見的十三芒星陣，即使在古代文獻也鮮少出現
        callout 2 echoat $n 因為十三被認為是不吉祥的數字，但卻是血族認為榮耀的數字
        callout 3 echoat $n 你觀看著四周，最顯眼的還是古塔中央那座高聳的祭壇(altar)
~
