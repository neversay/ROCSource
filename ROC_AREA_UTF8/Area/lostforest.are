>room_command search default~
if is_qmark($n) != lf_hunter
  if is_qmark($n) >= lf_search 10003
        if roomtimer($0) == 0
                echoat $n 你發現樹身上有攀爬(climb)的痕跡，或許爬上樹會找到些什麼。
                mod_qmark $n lf_search v1 = 1
                mod_qmark $n lf_search timer = -1
                mod_qmark $n lf_search death = 0
                mod_qmark $n lf_search save = 1
                modrvt t0 = 6
        else
                echoat $n 四周一片凌亂，看來才有人走過。
        endif
  else
        echoat $n 你發現這裡有棵特別高大粗壯的樹，顯得格外突出！
  endif
else
        echoat $n 你發現樹身上有攀爬(climb)的痕跡，或許爬上樹會找到些什麼。
endif
~
>room_command climb tree~
if is_qmark($n) != lf_hunter
  if is_qmark($n) == lf_search 200001
        if roomvalue($0) == 0
                echoat $n 你費力往上爬入了樹屋之中。
                echoaround $n $n 忽然往樹上爬去！他想當熊嗎？
                transfer $n 60751
                modrvt v0 = 1
                modrvt t0 = 6
        else
                echoat $n 你想爬上樹卻滑了下來...不知道哪個人先把立足點踩滑了
                echoaround $n $n 七手八腳往樹上爬，然後又滑了下來。
        endif
  endif
else
        echoat $n 你手腳俐落的往上爬入了樹屋之中。
        echoaround $n $n 忽然手腳俐落的爬上樹去！他是熊投胎的嗎？！
        transfer $n 60751
endif
~
|
