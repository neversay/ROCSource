~
>room_command search default~
if is_qmark($n) != lf_hunter
if roomtimer($0) == 0
        echoat $n 你環顧四週，發現了在碎石中的記號(mark)！
        if is_qmark($n) == lf_search 100001
                mod_qmark $n lf_search v0 = 3
                mod_qmark $n lf_search timer + 6
        else
                add_qmark $n lf_search 12 2 0 0 1 0
        endif
        modrvt t0 = 6
else
        echoat $n 四周一片凌亂，看來才有人走過。
endif
else
        echoat $n 你環顧四週，發現了在碎石中的記號(mark)！
endif
~
