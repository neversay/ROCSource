>room_enter 6 50~
if is_qmark($n) >= lf_hunter 200005
        echoat $n 西方有條模模糊糊的獸徑！
endif
~
>room_command search default~
echoat $n 你小心翼翼的搜索著四周的動靜。
if is_qmark($n) == lf_hunter 200004
        if is_qmark($n) >= lf_hunter 100151
                callout 1 echoat $n 你在西方發現了一條嶄新的獸徑！
                mod_qmark $n lf_hunter v1 = 5
                mod_qmark $n lf_hunter v0 = 0
                break
        else
                echoat $n 你什麼都沒發現
        endif
break
endif
if is_qmark($n) >= lf_hunter 200005
        callout 1 echoat $n 你在西方發現了一條嶄新的獸徑！
break
endif
	echoat $n 你什麼都沒發現
~
>room_mask west default~
if is_qmark($n) >= lf_hunter 200005
        echoat $n 你小心的隨著獸徑上模糊的足跡走入了樹叢之中...
        echoaround $n $N 忽然走進了樹叢之中消失了身影！
        transfer $n 60656
else
        echoat $n [0;33m哎呀，此路不通。[m
endif
~
