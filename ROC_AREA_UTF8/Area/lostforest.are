#60617
古塔內部~
只見四周到處都是零散的碎石，塔內原本似乎是有一座螺旋的石
梯，但現今也只剩下零碎的石磚而已，一塊巨石落在往下的一個狹口
上，沉重得你根本無法抬起這片巨石，零碎的磚石更散落在這片巨石
上堆成了小山，天空就在你的上頭，一望無際。
~
0 0 4
>room_command search default~
if day($) == 1
or day($) == 7
or day($) == 13
or day($) == 19
or day($) == 25
or day($) == 31
if roomtimer($0) == 0
  if mobcount(60530) < 1
        if is_qmark($n) == lf_hunter 300002
                echoat $n 你簡直不敢相信！
                callout 1 echoat $n 正當你試圖搜索地板上碎石的時候
                callout 2 echoat $n 閃耀著血紅光芒的銅鑼大眼自碎石中猛然睜開盯著你！
                callout 3 force stone-lf mpkill $n
                callout 3 echoat $n 傳說中的石龍出現在你眼前啊！
                callout 3 mload 60530
                modrvt t0 = 720
        endif
        if is_qmark($n) == lf_hunter 300001
                echoat $n 你發現碎石似乎曾經有什麼龐然巨物輾壓過的痕跡...
                callout 1 echoat $n 你不禁想著不知道是怎樣的怪物能夠造成這損傷...
        endif
  endif
endif
endif
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100004
          echoat $n 這裡看來除了碎石外什麼也沒有...
          echoat $n 沒有發現血族的蹤跡似乎讓你有些安心但也有些遺憾...
          mod_qmark $n lf_hunter v0 = 5
        else
          if mobcount(60530) < 1
                echoat $n 碎裂的石板地在觸目所及的所有地方...
                echoat $n 在南方有光從石壁間的空洞透了進來，看來是出口！
                modrvt v1 = 1
          else
                echoat $n 石龍龐大的身軀幾乎佔滿了整個房間！
                echoat $n 你也看不到任何的出口！
                modrvt v1 = 0
          endif
        endif
else
        if mobcount(60530) < 1
                echoat $n 碎裂的石板地在觸目所及的所有地方...
                echoat $n 在南方有光從石壁間的空洞透了進來，看來是出口！
                modrvt v1 = 1
        else
                echoat $n 石龍龐大的身軀幾乎佔滿了整個房間！
                echoat $n 你也看不到任何的出口！
                modrvt v1 = 0
        endif
endif
~
>room_mask south default~
if roomvalue($1) == 1
        echoat $n 你穿過南方狹窄的洞穴走到了石塔之外
        transfer $n 60611
        modrvt v1 = 0
else
        echoat $n [1;33m哎呀，此路不通。[m
endif
~
|
S
#60618
失落森林~
往東而走，森林看起來變得黑暗陰沉，四周佈滿了薄薄的霧氣，
樹梢間、樹叢後隱隱有種詭異的視線，不時有低沉的吼聲從森林的深
處傳出來，這趟旅途似乎也更加危險了。
~
