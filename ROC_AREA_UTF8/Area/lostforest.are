#60530
Dragon Stone-lf~
石龍(Dragon of Stone)~
一頭有著石灰色鱗甲的巨龍(Dragon)正潛伏在黑暗之中。
~
牠跟你一般所知道知道的龍不同，牠的身體是細長的蛇形，有點像是
某些異國傳說中的生物，在異國中，這種生物被稱為神龍，擁有神格
與特異的能力，牠們能夠無翅而飛，盤雲而上，但眼前這個生物似乎
並沒有飛行的能力，牠只是不斷地壓碎身體下的巨石並往碎石下鑽。
~
67|2048|4096|8192|16384|262144|1048576|8388608 8|32|128|512|8192|32768|8589934592|137438953472|549755813888 0 S
45 2000 0 -10d50+-500 -100d0+0
0 0
0 8 0
R Dragon~
P 1|2|4|8|128|256|32768|65536|1048576|2097152|4194304|8388608|67108864|268435456
C 3
>fight_prog 100~
if rand(25)
        mpcallout 1 skilldrv multihit $n
        mpcallout 1 skilldrv multihit $n
        mpcallout 1 skilldrv multihit $n
        mpcallout 1 skilldrv multihit $n
        mpcallout 1 mpchoat $n $I 直立盤起，四對龍爪朝你猛烈刨抓！
else
        if rand(33)
                mpecho $I 張口猛咬了一口四周的碎石！
                mpcallout 1 mpecho $I 咀嚼間似乎慢慢補充了體力！
                mpcallout 1 mpforcer here modhmv $i 02.500 1000 0
        else
                if rand(50)
                        c 'acid breath'
                        mpnowait
                        c 'gas breath'
                        mpnowait
                else
                        mpechoat $n $I 捲曲後如彈簧般撞向你！
                        mpcallout 1 mpechoat $n $I 的衝撞打得你[1;33m猛噴鮮血，齒牙迸裂[m！
                        mpcallout 1 mpforcer here modhmv $n 01.601 700 0
                endif
        endif
endif
if is_equ_obj($n) != 60568
        if rand(50)
                mpechoat $n $I 狂暴的在狹小的房間中四處竄動！
                mpechoat $n 轉眼間你身上竟然多了許多傷痕！
                mpforcer here add_affect $n 'disease' 0 5 1 -1 1099511627776
                mpforcer here add_affect $n 'disease' 0 5 2 -1 1099511627776
                mpforcer here add_affect $n 'disease' 0 5 5 -1 1099511627776
        endif
else
        mpechoat $n $I 狂暴的在狹小的房間中四處竄動！
        mpechoat $n 在揚起的沙塵中你只覺得手中提起的盾被頻頻重擊！
endif
if is_equ_obj($n) != 60569
        if hitprcn($i) < 50
                mpechoat $n $I 忽然高舉起龐大的身軀，斗大的頭顱上聳立著黑色的巨角！
                mpechoat $n $I 頭上的黑色巨角忽然發出了一陣恐怖的低鳴聲！
                mpcallout 1 mpforcer here add_affect $n 'stone skin' 0 24 -10 268435456
                mpcallout 1 mpechoat $n 震攝人心的恐怖低鳴竟從四面八方湧入了你的腦海！
                mpcallout 2 mpechoat $n 你被石化低鳴震攝了！
                mpcallout 3 mpechoat $n $I 趁著你石化的同時潛入地底下消失了...
                mpcallout 3 mppurge self
        else
                mpecho $I 巨嘴一張噴出了致命的疫病毒霧！
                mpechoat $n 你首當其衝，吸入毒霧的你全身感覺不舒服...
                mpechoarund $n $I 朝著 $n 噴出了黑色的毒霧，毒霧噴出時的風壓衝擊了你！
                mpforcer here add_affect $n 'disease' 0 24 1 -2 1099511627776
                mpforcer here add_affect $n 'disease' 0 24 2 -2 1099511627776
                mpforcer here add_affect $n 'disease' 0 24 5 -2 1099511627776
                mpforcer here modhmv pc 03.10 20 0
        endif
else
        if rand(80)
                mpecho $I 巨嘴一張吐出了致命的疫病毒霧！
                mpechoat $n 你所幸有覆面盔將毒氣給濾去才沒有中毒，但噴吐的風壓衝擊了你...
                mpechoaround $n $I 朝著 $n 噴出了黑色的毒霧，毒霧噴出時的風壓衝擊了你！
                mpforcer here modhmv pc 03.10 20 0
        else
                mpechoat $n $I 忽然高舉起龐大的身軀，斗大的頭顱上聳立著黑色的巨角！
                mpechoat $n 四周似乎以石龍頭上的黑角為中心產生了一股極大的共鳴震動！
                mpcallout 1 mpechoat $n 你戴著的覆面盔將石龍的石化低鳴給阻絕了！
        endif
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
~
>death_prog 100~
if is_qmark($n) > lf_hunter 200006
        mpcallout 1 mpoload 60522 1 floor
        mpcallout 1 mpechoat $n $I 頭上的巨大黑角脫落掉在一旁地上！
        mpcallout 1 mpechoat $n $I 死時掉進了原本牠鑽出的洞穴......
endif
if is_equ_obj($n) != 60568
        mpechoat $n $I 死前忽然發狂亂刨，你身上遍佈沾染疫病毒的傷口！
        mpforcer here add_affect $n 'disease' 0 30 1 -10 1099511627776
        mpforcer here add_affect $n 'disease' 0 30 2 -10 1099511627776
        mpforcer here add_affect $n 'disease' 0 30 5 -10 1099511627776
else
        mpechoat $n $I 死前忽然發狂亂刨，所幸你有絨盾將其毒爪全數擋下！
endif
if is_equ_obj($n) != 60569
        mpechoat $n $I 死前爆散出劇毒的疫病雲，你不慎吸入了許多！
        mpforcer here add_affect $n 'disease' 0 30 1 -10 1099511627776
        mpforcer here add_affect $n 'disease' 0 30 2 -10 1099511627776
        mpforcer here add_affect $n 'disease' 0 30 5 -10 1099511627776
else
        mpechoat $n $I 死前忽然爆散出劇毒的疫病雲，所幸你的覆面盔將毒氣濾去！
endif
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100005
                mpechoat $n $I 死時掉進了原本牠鑽出的洞穴......
                mpechoat $n $I 頭上的巨大黑角脫落掉在一旁地上！
                mpoload 60522 1 floor
                mpmod_qmark $n lf_hunter v0 = 6
                mpcallout 1 mpechoat $n 你看到地上的石龍角，直覺想到應該先回去跟獵戶報個喜才是
                mppurge self
        endif
endif
~
