#60751
獵戶的樹屋~
你爬上了這個大樹上的隱密居所，這是獵戶的秘密住所，整間木
屋牢靠的釘在大樹的枝幹上，一旁還有許多的日常用品與床，看來這
裡也可以當作臨時的據點。
~
0 1024|1048576 0
>room_mask list default~
if insameroom(hunter-lf)
  if is_qmark($n) >= lf_hunter 300001
        force hunter-lf mpechoat $n 獵戶將東西攤在你面前，你看到了...
        callout 1 echoat $n 一些飲食還有酒(food)
        callout 1 echoat $n 一些橙色藥水(orange potion)
        if roomvalue($0) > 0
                callout 1 echoat $n 一些普通的木桿箭(wooden arrow)
        endif
        if roomvalue($1) > 0
                if is_qmark($n) != lf_beast
                        if class($n) == 17
                                if is_inv_obj($n) != 60521
                                if is_equ_obj($n) != 60521
                                        callout 1 echoat $n 幾束強化獵箭(arrow)
                                endif
                                endif
                        endif
                else
                        callout 1 echoat $n 幾把剛做好的獵弓(bow)
                endif
        endif
        callout 2 force hunter-lf tell $n 要買什麼就跟我說吧(talk hunter buy 物品英文)
  else
        echoat $n 你無法這麼做 .
  endif
else
  echoat 什麼？
endif
~
