>talk_prog gate~
if is_qmark($n) > lf_hunter 300001
        tell $n 好的，請稍等
        mpcallout 1 mpechoat $n 守衛(guard)大聲的朝著村內喊了些話，北方的木閘開始緩緩拉起...
        mpcallout 2 mpechoat $n [0;33m嘰咂...嘰咂...[m
        mpcallout 3 tell $n 好了，快進去吧！
        mpcallout 3 mpforcer here modrvt v0 = 1
else
        tell $n 你不該出現在這的！
        mpechoat $n 你感覺一股神秘的力量將你拋出了這！
        transfer $n 4580
endif
~
>talk_prog topic~
if is_qmark($n) > lf_hunter 300001
        tell $n 有什麼事嗎？
        mpechoat $n --．我要進村，請幫我開門(gate)
else
        tell $n 你不該出現在這的！
        mpechoat $n 你感覺一股神秘的力量將你拋出了這！
        mpechoaround $n 你看到 $N 被拋出了這！
        mpforcer 4580 echo 你看到 $N 被拋到了這裡！
        transfer $n 4580
endif
~
>defun_prog lf_guard~
if is_qmark($n) > lf_hunter 300001
else
        if is_qmark($n) == lf_hunter 200006
                if is_qmark($n) == lf_hunter 100013
                        mpechoat $n 守衛(guard)緊張的看著你，似乎很久沒有人來到此處
                        if is_affacted($n) & 16384
                                mpechoat $n 他輕彈了拇指跟食指，你全身的偽裝都褪去了！
                                mpdis_magic $n all
                        endif
                        if race($n) == vampire
                                tell $n 久違的血族子弟，近百年來你是少數來到這的血族啊
                                tell $n 在這村內你不需要擔心莫名的襲擊，我們將會保障你的安全
                                tell $n 那些膽敢鬧事的傢伙都會永永遠遠的消失在這世界上
                                smile $n
                        else
                                tell $n 非血族的外來者啊，你能到這裡表示你已經贏得森林之主的承認
                                tell $n 但是我依然要提醒你，別在村子裡面鬧事，不然你將會永遠生不如死
                        endif
                        mpcallout 1 mpechoat $n $I 講完這些話後回頭朝著村內喊了些話，北方的木閘開始緩緩拉起...
                        mpcallout 2 mpmod_qmark $n lf_hunter v2 = 2
                        mpcallout 2 mpechoat $n [0;33m嘰咂...嘰咂...[m
                        mpcallout 3 tell $n 好了，快進去吧！
                        mpcallout 3 forcer here modrvt t0 = 1
                endif
        else
                tell $n 你不該來這的！
                mpechoat $n 你被一股神秘的力量給拋了出去！
                transfer $n 4580
        endif
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
if insameroom(arst-lf)
mpgroup self art-lf 1 0
endif
~
