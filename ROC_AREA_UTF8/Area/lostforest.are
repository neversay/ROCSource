>talk_prog topic~
if being($b)
        mpechoat $n $I 現在看起來很忙
        break
endif
if is_qmark($n) == lf_hate
        angry
        tell $n 滾滾滾，別礙到老子做事。
        mpechoat $n 看來 $I 對你之前不敬的態度還耿耿於懷。
break
endif
if is_qmark($n) != lf_hunter
        if is_qmark($n) == lf_search 200001
        tell $n 喔，難得有人來到這座森林，你有什麼事？
        mpechoat $n --．為什麼森林中沒有動物？(animal)
        mpechoat $n --．老子沒事走走礙到你啦？(nothing)
        endif
else
        tell $n 這回又有什麼事？
if is_qmark($n) >= lf_hunter 300001
        mpechoat $n --．買東西用 list 先查看物品量
        if is_qmark($n) == lf_hunter 200004
        or is_qmark($n) == lf_hunter 200005
                mpechoat $n --．森林可能還有地方沒搜尋過，或是你的能力還不足
                mpechoat $n 　　想確定自己的能力可以找獵戶檢定(check)
        endif
endif
if is_qmark($n) >= lf_hunter 300002
  if is_qmark($n) != lf_hunter_horn2
        if is_qmark($n) != lf_hunter_horn
                mpechoat $n --．製造石龍號角(horn)
        else
                if is_qmark($n) != lf_hunter_horn 100000
                or is_qmark($n) != lf_hunter_horn 200000
                or is_qmark($n) != lf_hunter_horn 300000
                  if is_qmark($n) == lf_hunter_horn 100000
                        mpechoat $n --．石龍角已經收到
                  else
                        mpechoat $n --．石龍角還沒收到
                  endif
                  if is_qmark($n) == lf_hunter_horn 200000
                        mpechoat $n --．骨之碎片已經收到
                  else
                        mpechoat $n --．骨之碎片還沒收到
                  endif
                  if is_qmark($n) == lf_hunter_horn 300000
                        mpechoat $n --．火界獸之瞳已經收到
                  else
                        mpechoat $n --．火界獸之瞳還沒收到
                  endif
                  if is_inv_obj($i) == 32143
                        mpechoat $n --．駝獸牙刃已經收到
                  else
                        mpechoat $n --．駝獸牙刃還沒收到
                  endif
                else
                  if is_inv_obj($i) == 32143
                        mpechoat $n --．石龍號角的原料收集完成了(finish)
                  else
                        mpechoat $n --．只剩下駝獸牙刃還沒收到
                  endif
                endif
        endif
  else
        if is_qmark($n) != lf_hunter_horn
                tell $n 喔！我已經完工了！
                tell $n 這就是你要的石龍號角！
                mpcallout 1 tell $n 但交給你之前我必須要警告你
                mpcallout 2 tell $n 石龍號角使用時除了本人免疫外，極可能會傷及無辜
                mpcallout 3 tell $n 非有必要絕對不要輕易使用，此外使用也會耗損號角'
                mpcallout 4 tell $n 最重要的一點就是，一個人一次只能持有一個石龍號角
                mpcallout 5 tell $n 這東西太邪門了，持有超過一個就會開始給主人帶來強烈的厄運
                mpcallout 6 tell $n 只要你還持有一個，我就不會幫你做第二個，這千萬要記住
                mpcallout 7 mpechoat $n $I 將完工的石龍號角交給了你
                mpcallout 7 tell $n 大概就這些了，那號角就交給你吧！
                mpcallout 7 mpoload 60523 $n viclv target
                mpcallout 7 mpdel_qmark $n lf_hunter_horn2
        else
                tell $n 石龍號角還沒製好，有點耐心吧
                mpechoat $n $I 回完你的話又繼續手頭上正在趕工的石龍號角...
        endif
  endif
endif
if is_qmark($n) == lf_hunter 200001
        mpechoat $n 我打到獵物了，你檢查看看吧！(check)
endif
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) >= lf_hunter 100008
                if is_qmark($n) <= lf_hunter 100014
                sigh $n
                tell $n 原來是你啊...竟然在別人說話的時候跑掉...
                tell $n 我暫時不想教你...等我氣消了再來吧...
                mpadd_qmark $n lf_hate 72 0 0 0 0 1
                mpmod_qmark $n lf_hunter v0 = 7
                endif
        endif
        if is_qmark($n) == lf_hunter 100007
          mpechoat $n --．我準備好進行最後階段了。(final training)
        endif
        if is_qmark($n) <= lf_hunter 100003
        if is_qmark($n) == lf_hunter_lord
          mpechoat $n --．我想再聽一次森林之主的消息(Forest Lord)。
        else
          mpechoat $n --．我考慮看看(thinking)
          mpechoat $n --．我做(do)
        endif
        endif
        if is_qmark($n) == lf_hunter 100004
          mpechoat $n --．我取得了遇見森林之主的證物了！(thing)
        endif
        if is_qmark($n) == lf_hunter 100005
          tell $n 喔，我知道啦，那傢伙把你的屍體扔在我眼前。
          tell $n 看在你這麼“拼命”的份上，我就破例指導你吧！
          tell $n 當你準備好的話我們就進入最後課程(final training)。
          mpmod_qmark $n lf_hunter v0 = 7
        endif
        if is_qmark($n) == lf_hunter 100006
          mpechoat $n --．給獵戶物證(give object hunter)
        endif
endif
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100000
                mpechoat $n --．我發現有座詭異的黑色石塔！(blacktower)
        endif
        if is_qmark($n) == lf_hunter 100002
                mpechoat $n --．我想問怎麼打倒石龍(Dragon of Stone)
        endif
        if is_qmark($n) == lf_hunter 100003
                if is_qmark($n) == lf_hunter_leather
                        if is_qmark($n) != lf_hunter_leather 100000
                        or is_qmark($n) != lf_hunter_leather 200000
                        or is_qmark($n) != lf_hunter_leather 300000
                          if is_qmark($n) != lf_hunter_leather 100000
                                mpechoat $n --兔皮還沒收集齊全
                          else
                                mpechoat $n --兔皮已經收集齊全
                          endif
                          if is_qmark($n) != lf_hunter_leather 200000
                                mpechoat $n --狐皮還沒收集齊全
                          else
                                mpechoat $n --狐皮已經收集齊全
                          endif
                          if is_qmark($n) != lf_hunter_leather 300000
                                mpechoat $n --熊皮還沒收集齊全
                          else
                                mpechoat $n --熊皮已經收集齊全
                          endif
                        else
                                mpechoat $n --防護皮件的材料收集完成了(finish)
                        endif
                endif
        endif
        if is_qmark($n) == lf_hunter 100004
                if is_qmark($n) != lf_hunter_leather
                        tell $n 喔！我已經完工了！
                        tell $n 這就是你所需要的皮件啦，記得戰鬥中絕對不要脫下來！
                        mpcallout 1 tell $n 不然萬一被石龍傷到可不是好玩的！
                        mpcallout 2 tell $n 好啦，這就將皮件交給你...
                        mpcallout 3 mpmod_qmark $n lf_hunter v0 = 5
                        mpcallout 3 mpoload 60568 $n viclv target
                        mpcallout 3 mpoload 60569 $n viclv target
                        mpcallout 3 mpechoat $n $I 將完工的絨盾和覆面盔交給了你
                else
                        tell $n 皮件還沒製好，有點耐心吧
                        mpechoat $n $I 回完你的話又繼續手頭上正在趕工的皮件...
                endif
        endif
        if is_qmark($n) == lf_hunter 100006
                if is_inv_obj($n) == 60522
                        tsk $n
                        mpcallout 1 good $n
                        mpcallout 2 tell $n 沒想到你竟然真的打倒了石龍取得了石龍角...
                        mpcallout 4 tell $n 這東西可是獵人一生夢寐以求的至寶啊！
                        mpcallout 6 tell $n 你一定很懷疑這東西為啥稱得上獵人至寶吧？
                        mpcallout 8 tell $n 其實光是角還不行的，但只要稍微加工一下
                        mpcallout 10 tell $n 把這石龍角製成號角的話，一吹響起來，只要是動物沒有不屈服的！
                        mpcallout 12 tell $n 甚至連森林之主那傢伙都很懼怕這號角的音色呢！
                        mpcallout 14 tell $n 喔，對了，你應該還有事情要去問森林之主吧？
                        mpcallout 15 tell $n 等你把這件事情解決之後，有空我們再來談石龍號角吧！
                        mpcallout 16 wave $n
                        mpcallout 16 mpmod_qmark $n lf_hunter v0 = 7
                endif
        endif
endif
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100000
                tell $n 沒事就多花點時間去探索這森林吧！
        break
        endif
        if is_qmark($n) == lf_hunter 100002
        if is_inv_obj($n) == 60518
                mpechoat $n --．我發現森林中有座石塔！(tower)
        endif
        endif
        if is_qmark($n) == lf_hunter 100003
                tell $n 沒事就快去找森林之主吧！
        endif
        if is_qmark($n) == lf_hunter 100004
                mpechoat $n 你跟 $I 講述著森林之主說給你聽的故事...
                mpcallout 1 think $n
                mpcallout 2 tell $n 那你有去過石塔仔細檢查過了嗎？
                mpcallout 3 tell $n 或許你會有什麼發現也不一定呢。
        endif
        if is_qmark($n) == lf_hunter 100005
                mpdef_rembch $n
                mpechoat $n 你跟 $I 講述著石塔搜尋後的結果...
                mpcallout 1 nod $n
                mpcallout 2 tell $n 雖然你什麼也沒發現，但你也長了一分知識啊。
                mpcallout 4 tell $n 好好努力下去，或許這森林還有更多秘密等你發掘啊。
                mpcallout 6 tell $n 喔，對了。
                mpcallout 7 tell $n 沒想到你能做得如此出色，真不愧是我教出來的。
                                mpcallout 8 mpcall search_arrowX
                mpcallout 12 mpcall hunter_mark
                mpcallout 11 mpechoat $n --．取得獵戶住所的購物權(list/buy)
                mpcallout 11 tell $n 以後有需要的話可以來找我啊！
                mpcallout 10 mpmod_qmark $n lf_hunter v1 = 4
                mpcallout 10 mpmod_qmark $n lf_hunter v0 = 0
                mpcallout 10 mpmod_qmark $n lf_hunter v2 = 1
        endif
endif
endif
~
>defun_prog search_arrowX~
if class($n) == 17
        if is_qmark($n) == lf_beast 100001
                        mpcallout 1 tell $n 我這邊有一些自製的弓箭，就送給你當禮物吧！
                        mpcallout 2 mpoload 60516 $n viclv target
                        mpcallout 2 mpoload 60517 $n viclv target
                        mpcallout 2 mpechoaround $n $I 將獵弓與一袋箭交給了 $N。
                        mpcallout 2 mpechoat $n $I 將獵弓與一袋箭交給了你。
        else
                if is_qmark($n) == lf_beast 100002
                        tell $n 但勉強算是合格了。
                        tell $n 雖然你在森林之主那邊表現得不是很有勇氣
                        mpcallout 1 tell $n 只要我還有剩下的話我會便宜的賣給你的！
                        mpcallout 2 tell $n 要是你有需要什麼日常用品的話，自己看下列表(list)
                        mpcallout 2 mpexp $n 100
                        mpcallout 2 mpgold $n 25000
                else
                        mpcallout 1 tell $n 我這邊有一些自製的弓箭，就送給你當禮物吧！
                        mpcallout 2 mpoload 60520 $n viclv target
                        mpcallout 2 mpoload 60521 $n viclv target
                        mpcallout 2 mpechoaround $n $I 將獵弓與一袋箭交給了 $N 。
                        mpcallout 2 mpechoat $n $I 將獵弓與一袋箭交給了你。
                endif
        endif
else
        tell $n 要是你有需要什麼日常用品的話，自己看下列表(list)
        mpcallout 1 tell $n 只要我還有剩下的話我會便宜的賣給你的！
        mpcallout 2 mpexp $n 2000
        mpcallout 2 mpgold $n 500000
endif
~
>talk_prog p dragon of stone~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100002
                mpechoat $n 你迫不及待的跟獵戶講述著森林之主交代的事情
                mpcallout 2 cackle
                mpcallout 4 tell $n 後生可畏啊，即使我最強壯的時候都不敢挑戰的石龍你竟要打倒牠！
                mpcallout 6 tell $n 其實石龍之所以難以對付是來自於他可怕的天賦
                mpcallout 8 tell $n 石龍頭上生有巨大的尖角，從哪角中會發出令人震攝的恐怖低鳴
                mpcallout 10 tell $n 沒有準備的人往往在剛開始的時候就已經注定敗給石龍了
                mpcallout 12 tell $n 這樣吧，其實只要找齊了材料我就能幫你製造可以幫你的器具
                mpcallout 14 tell $n 首先，你需要可以阻擋石龍攝人低鳴的耳罩
                mpcallout 15 tell $n 耳罩和面罩我會幫你組合成一頂覆面盔
                mpcallout 15 tell $n 接著，你需要一頂可以抵抗石龍致命毒氣的面罩
                mpcallout 16 tell $n 最後，你需要一面可以抵禦石龍毒爪的絨皮盾
                mpcallout 17 tell $n 這些東西需要大量的毛皮，而這森林出產的是最適合的
                mpcallout 18 tell $n 這些東西總共需要25張兔皮，15張狐狸皮，還有10張熊皮
                mpcallout 20 tell $n 沒問題的話你就快點去獵回來吧！
                mpcallout 20 mpmod_qmark $n lf_hunter v0 = 3
                mpcallout 20 mpadd_qmark $n lf_hunter_leather -1 25 15 10 0 1
        endif
endif
~
>talk_prog blacktower~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100000
        hmm $n
        mpcallout 1 good $n
        mpcallout 2 tell $n 你還記得你之前說過森林之主告訴你的故事嗎？
        mpcallout 3 mpechoat $n 你想起來當初所聽到...一間堆放物品...
        mpcallout 4 mpechoat $n 另一間...通向血族的住所！
        mpcallout 5 nod $n
        mpcallout 6 tell $n 看來你是想起來了，沒錯，或許你已經步入了史上最大的謎團之中
        mpcallout 8 tell $n 但是呢，關於什麼魔法啊有的沒的我一點都不熟
        mpcallout 10 tell $n 這點或許你該去問森林之主看看，他應該會懂的
        mpcallout 10 mpmod_qmark $n lf_hunter v0 = 1
        endif
endif
~
>give_prog 60518~
if is_qmark($n) == lf_hunter 200003
  if is_qmark($n) == lf_hunter 100002
        mpjunk stone
        mpechoat $n 臉上充滿了驚訝的神情！
        mpcallout 1 tell $n 看來你的能力確實已經超過我了，或許你真的發現了什麼吧
        mpcallout 1 good $n
        mpcallout 2 mpechoat $n 你忽然覺得背脊有一股涼意...
        mpcallout 2 tell $n 這樣的話...你需要的是最精通這森林的傢伙的幫忙啊...
        mpcallout 3 tell $n 是的，就是森林之主啦，畢竟這是牠的森林啊！
        mpcallout 3 grin $n
        mpcallout 3 tell $n 當然，要說到這森林的傳說，應該沒人比那傢伙更熟悉了
        mpcallout 4 tell $n 你就去跟森林之主談談看吧，牠應該會幫忙的。
        mpcallout 4 mpmod_qmark $n lf_hunter v0 = 3
  endif
else
  hmm
  tell $n 隨便拿塊石頭也想耍我啊？
  sigh $n
  mpadd_qmark $n lf_hate 24 0 0 0 0 1
endif
~
>talk_prog tower~
if is_inv_obj($n) == 60518
        mpechoat $n 你很高興地跟獵戶講述著發現石塔的經過！
        mpechoat $n 但獵戶看起來半信半疑的...
        mpcallout 1 tell $n 這種聽起來荒謬的事情，還真讓人難以相信啊...
        mpcallout 2 mpechoat $n --．你想起來應該把塔石交給獵戶！
endif
~
>defun_prog lf_hunter_break~
if pcnum($) == 0
        break
endif
~
>talk_prog p final training~
if is_qmark($n) == lf_hate
        angry
        tell $n 滾滾滾，別礙到老子做事。
        mpechoat $n 看來 $I 對你之前不敬的態度還耿耿於懷。
break
endif
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100007
                nod $n
                mpcallout 2 tell $n 那我們就展開這段訓練的最後階段吧。
                mpcallout 3 tell $n 最後的部分或許有點冗長無趣，但你可要聽到最後啊！
                mpcallout 4 mpechoat $n $I 開始滔滔不絕的傳授你森林中討生活的手段...
                mpcallout 4 mpmod_qmark $n lf_hunter v0 = 8
        endif
        mpcallout 5 if is_qmark($n) == lf_hunter 100008
        mpcallout 5 mpcall lf_hunter_break
                mpcallout 10 mpechoat $n $I 似乎還沒有停下來的打算，仍然滔滔不絕的講著...
                mpcallout 10 mpmod_qmark $n lf_hunter v0 = 9
        endif
        mpcallout 11 if is_qmark($n) == lf_hunter 100009
        mpcallout 11 mpcall lf_hunter_break
                mpcallout 16 mpechoat $n $I 似乎還沒有停下來的打算，仍然滔滔不絕的講著...
                mpcallout 16 mpmod_qmark $n lf_hunter v0 = 10
        endif
        mpcallout 17 if is_qmark($n) == lf_hunter 100010
        mpcallout 17 mpcall lf_hunter_break
                mpcallout 26 mpechoat $n $I 似乎還沒有停下來的打算，仍然滔滔不絕的講著...
                mpcallout 26 mpmod_qmark $n lf_hunter v0 = 11
        endif
        mpcallout 27 if is_qmark($n) == lf_hunter 100011
        mpcallout 27 mpcall lf_hunter_break
                mpcallout 42 mpechoat $n $I 似乎還沒有停下來的打算，仍然滔滔不絕的講著...
                mpcallout 42 mpmod_qmark $n lf_hunter v0 = 12
        endif
        mpcallout 43 if is_qmark($n) == lf_hunter 100012
        mpcallout 43 mpcall lf_hunter_break
                mpcallout 64 mpechoat $n $I 講得興起，彷彿已入無人之境...
                mpcallout 64 mpmod_qmark $n lf_hunter v0 = 13
        endif
        mpcallout 65 if is_qmark($n) == lf_hunter 100013
        mpcallout 65 mpcall lf_hunter_break
                mpcallout 92 mpechoat $n $I 終於講完了一串長似阿婆裹腳步的陳年故事...
                mpcallout 92 mpmod_qmark $n lf_hunter v0 = 14
        endif
        mpcallout 93 if is_qmark($n) == lf_hunter 100014
        mpcallout 93 mpcall lf_hunter_break
                mpcallout 94 tell $n 嗯，那整個課程就到這邊結束了。
                mpcallout 94 mpmod_qmark $n lf_hunter v0 = 15
        endif
        mpcallout 95 if is_qmark($n) == lf_hunter 100015
        mpcallout 95 mpcall lf_hunter_break
                mpcallout 96 tell $n 其實狩獵的訣竅就是如此而已，就是多多練習多多搜尋
                mpcallout 97 tell $n 只要你每到新的地方都用心搜尋，相信會發掘到更多的東西
                mpcallout 98 mpecho $I 稍微吞了下口水
                mpcallout 99 tell $n 這片森林中還有很多地方是未曾有人踏入的
                mpcallout 100 tell $n 甚至連我都只探索了這森林的極小部分而已
                mpcallout 101 tell $n 或許你的發現將會在我之上也不一定。
                mpcallout 102 tell $n 最後還是提醒你，坐而言不如起而行
                mpcallout 103 tell $n 聽我說了這麼多，最後你還是必須身體力行
                mpcallout 104 tell $n 只要你別忘了這些基本規則
                mpcallout 105 tell $n 最後，祝你好運，若你遇到什麼問題還是能來找我
                mpcallout 106 wave $n
                mpcallout 106 bless $n
                mpcallout 106 mpmod_qmark $n lf_hunter v0 = 0
                mpcallout 106 mpmod_qmark $n lf_hunter v1 = 3
        endif
endif
~
>talk_prog thing~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100004
                tsk
                tell $n 是嗎？快把東西拿來我看看！
                mpmod_qmark $n lf_hunter v0 = 6
        endif
endif
~
>give_prog 60519~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100006
                mpjunk object
                hmm
                mpcallout 2 mpechoat $n $I 仔細打量著你給的物品。
                mpcallout 3 tell $n 好！有前途！
                mpcallout 4 tell $n 這樣我們可以開始進入最後階段(final training)了
                mpcallout 5 tell $n 準備好之後就告訴我吧！
                mpcallout 5 mpmod_qmark $n lf_hunter v0 = 7
        endif
endif
~
>talk_prog p Forest Lord~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter_lord 300004
                tell $n 森林之主會在一個月的某幾天出沒
                mpcallout 2 tell $n 但我只知道他可能會出現在北面小徑盡頭的泉水處
                mpcallout 3 tell $n 【在月光的導引下，在子夜時分之時，道路將顯現】
                mpcallout 4 tell $n 或許這一小段傳說能幫你找到路
                mpcallout 5 tell $n 好啦，快點出發吧，我等你好消息啊！
        else
                if is_qmark($n) == lf_hunter_lord 300003
                        tell $n 還找不到？
                        mpcallout 2 hmm
                        mpcallout 3 tell $n 會不會我忘了什麼沒告訴你呢...
                        mpcallout 4 think
                        mpcallout 5 duh
                        mpcallout 6 tell $n 我想起來了！
                        mpcallout 7 tell $n 抱歉、抱歉，我竟然忘了這麼重要的事情
                        mpcallout 8 tell $n 其實呢，有個關於森林之主的傳說
                        mpcallout 9 tell $n 【在月光的導引下，在子夜時分之時，道路將顯現】
                        mpcallout 10 tell $n 或許這一小段傳說能幫你找到路
                        mpcallout 11 tell $n 快去吧！
                        mpmod_qmark $n lf_hunter_lord v2 + 1
                else
                        tell $n 這簡單
                        tell $n 這個森林之主會在一個月的某幾天出沒
                        tell $n 但我只知道他可能會出現在北面小徑盡頭的泉水處
                        tell $n 好啦，快點出發吧，我等你好消息啊！
                        mpmod_qmark $n lf_hunter_lord v2 + 1
                endif
        endif
endif
~
>talk_prog animal~
if is_qmark($n) == lf_hate
        angry
        tell $n 滾滾滾，別礙到老子做事。
        mpechoat $n 看來 $I 對你之前不敬的態度還耿耿於懷。
break
endif
if is_qmark($n) != lf_hunter
        if is_qmark($n) == lf_search 200001
        tell $n 動物？你沒發現到嗎？
        cackle $n
        tell $n 小子，這就表示你太嫩啦，你們這些城市仔當然找不到。
        tell $n 當然，後天的努力還是來得及的。
        tell $n 你願意的話，只要十萬枚金幣我就可以當你的老師。
        tell $n 教你一些在這座森林需要的生存技巧。
        mpechoat $n --．給獵戶學費(give 100000 coins hunter)
        mpechoat $n --．我去你的！(talk hunter curse you)
        endif
endif
~
>talk_prog track~
if is_qmark($n) == lf_hunter 200001
        if class($n) == 9
        or class($n) == 17
                nod
                mpcallout 2 tell $n 因為你曉得追蹤的基礎了，那我也省得廢話了。
                mpcallout 3 tell $n 只是你們以前學習的應該是看到獵物才能追蹤的技巧。
                mpcallout 4 tell $n 我現在要教授的的是追蹤獵物足跡的方法。
                mpcallout 5 tell $n 簡單來說就是，搜尋(search)，還有慢行(sneak)。
                mpcallout 6 tell $n 記得，森林中往往有許多不注意就找不到的線索。
                mpcallout 7 tell $n 而慢行是因為你是要當獵人不是要當獵物。
                mpcallout 8 tell $n 謹記這兩點原則，那你就能夠輕易的獵捕到獵物。
                mpcallout 9 tell $n 好啦，坐而言不如起而行，接著你就去抓獵物吧。
                mpcallout 10 tell $n 到時候我會依照你獵捕回來的獵物決定你的程度。
                mpcallout 11 tell $n 等你程度夠的時候，我就會教授你下一步。
        else
                sigh
                mpcallout 2 tell $n 啊......門外漢門外漢......
                mpcallout 3 tell $n 好啦，既然我收了你的錢，我自然會教你該怎麼做。
                mpcallout 4 tell $n 追蹤的技巧只有一個，就是不放過你所發現的每個線索。
                mpcallout 5 tell $n 在感覺到不知道該怎麼走的時候，搜尋(search)一下。
                mpcallout 6 tell $n 別小看這個動作，往往在你平時未留意的地方有著小小的線索。
                mpcallout 7 tell $n 而這點小線索就能成為你成功獵捕的關鍵！
                mpcallout 8 tell $n 接下來呢，我出給你的課題是到這森林中去狩獵。
                mpcallout 9 tell $n 根據你帶回來的戰利品，會決定我對你的看法。
                mpcallout 10 tell $n 只要我覺得你程度夠了，我自然就會教授你下一步。
        endif
endif
~
>talk_prog check~
if is_qmark($n) >= lf_hunter 200005
        tell $n 你已盡得我真傳
        tell $n 我沒有東西能夠教你了
break
endif
if is_qmark($n) == lf_hunter 200004
        if is_qmark($n) < lf_hunter 100030
                look $n
                mpcallout 1 shake
                mpcallout 2 tell $n 你還需要多多磨練才是
        break
        endif
        if is_qmark($n) < lf_hunter 100060
                look $n
                mpcallout 1 hmm $n
                mpcallout 2 tell $n 你比之前更進步了些
        break
        endif
        if is_qmark($n) < lf_hunter 100090
                look $n
                mpcallout 1 think $n
                mpcallout 2 tell $n 你在搜尋方面的能力已經比一般獵人更強了
        break
        endif
        if is_qmark($n) < lf_hunter 100120
                look $n
                mpcallout 1 think $n
                mpcallout 2 tell $n 你幾乎快要到達我所不及的地方了
        break
        endif
        if is_qmark($n) < lf_hunter 100150
                look $n
                mpcllout 1 good $n
                mpcallout 2 tell $n 你已經出類拔萃了，似乎離巔峰只差那麼一點！
        break
        endif
        if is_qmark($n) >= lf_hunter 100151
                look $n
                mpcallout 1 good $n
                mpcallout 2 tell $n 你已經青出於藍而勝於藍了！
                mpcallout 3 tell $n 這個森林應該沒有什麼你找不到的了！
                mpcallout 4 tell $n 搜尋這森林中你覺得可疑之處吧，或許曾經沒發現之處會有意外發現。
        endif
break
endif
if is_qmark($n) == lf_hunter 200001
        nod
        mpcallout 2 tell $n 我們這就來看看你到底獵了啥。
        mpcallout 3 look $n
        mpcallout 4 mpcall lf_huntingX
else
        if is_qmark($n) >= lf_hunter 200004
                hmm
                mpcallout 2 tell $n 你已經盡得我真傳了
                mpcallout 3 tell $n 我沒什麼能夠教你的了
        else
                tell $n 啥？檢查啥？你的腦子嘛？
                cackle $n
        endif
endif
~
>defun_prog lf_huntingX~
if is_qmark($n) >= lf_hunter 100030
        good $n
        mpcallout 1 tell $n 嗯嗯嗯，以業餘的來說，你的表現已經很好了。
        mpcallout 2 tell $n 那我們就來進入下一階段(advance training)吧！
        mpcallout 2 mpmod_qmark $n lf_hunter v1 = 2
        mpcallout 2 mpmod_qmark $n lf_hunter v0 = 0
else
        shake
        mpcallout 1 tell $n 你還需要再努力一些，多獵點再回來找我吧。
endif
~
>talk_prog p advance training~
if is_qmark($n) == lf_hunter 200002
        tell $n 那我們現在就開始展開進階訓練課程
        mpcallout 2 tell $n 這次不只是叫你去獵捕森林裡的小動物而已
        mpcallout 3 tell $n 整個過程有一定的危險性，你要有所覺悟
        mpcallout 4 tell $n 這是個古老的森林，其中棲息著上古的神獸，森林的主人
        mpcallout 5 tell $n 統馭萬獸的獸王，這就是你的下一個課題。
        mpcallout 6 tell $n 我要你去打倒這個森林之主並且取得證據，證明你打倒牠了。
        mpcallout 7 tell $n 別露出那種怪表情，這並非不可能的任務，只是比較艱難罷了。
        mpcallout 8 hehe $n
        mpcallout 9 tell $n 當然，你可以不要做，那我就沒有必要教導你。
        mpcallout 10 tell $n 你連這點試練都過不了，是沒辦法成為一個成功的冒險者的！
        mpcallout 11 mpechoat $n --．我做(do)
        mpcallout 11 mpechoat $n --．我考慮一下(thinking)
endif
~
>talk_prog do~
if is_qmark($n) == lf_hunter 200002
        nod $n
        tell $n 很好，聽說森林之主平時只在某些日子裡會出沒
        tell $n 但我沒在調查這個，只是我大概知道牠會在哪裡出沒
        tell $n 只要你沿著北面的小徑直走，會通到一個泉水
        tell $n 傳說中那就是牠的聖泉，快去吧，我等你好消息
        mpadd_qmark $n lf_hunter_lord -1 0 0 0 0 1
endif
~
>talk_prog thinking~
if is_qmark($n) == lf_hunter 200002
        tell $n 慢慢考慮，我一點都不急啊
        whistle
endif
~
>talk_prog nothing~
smoking
tell $n 是啊、是啊，是不干我事，在森林中被襲擊或迷路就別喊救命啊。
mpechoat $n $I 一臉不屑的繼續做著自己的事。
mpadd_qmark $n lf_hate 24 0 0 0 0 1
~
>talk_prog p curse you~
angry $n
tell $n 不爽學就別學啊！
tell $n 就去追在兔子的尾椎後面跑吧你！
mpechoat $n $I 一臉不屑的繼續做著自己的事。
mpadd_qmark $n lf_hate 48 0 0 0 0 1
~
