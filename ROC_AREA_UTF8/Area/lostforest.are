~
>room_command insert p the horn in the fillister~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100010
                is_inv_obj($n) == 60522
                        purge $n horn-lf
                        echoat $n 你將石龍角按照石板上的方式插入了石雕的凹槽中...
                        callout 2 echoat $n 一時之間似乎什麼事情都沒有發生......
                        callout 4 echoat $n 但是慢慢的...慢慢的...一種莫名的嗡嗡聲慢慢大了起來...
                        callout 5 echo 嗡嗡～～～嗡～～～嗡～～～
                        callout 6 echoat $n 這聲音讓你有種不舒服的感覺...
                        callout 7 echo 嗡嗡～～～嗡～～～嗡～～～
                        callout 8 echoat $n 忽然！四周安靜了下來！就像什麼要發生了一般！
                        callout 10 echoat $n 你聽到一種像是空氣忽然被劃破的尖銳聲響！
                        callout 11 echoat $n 原本北面那兩扇沉重無法移動的巨大石門忽然在你眼前打開了！
                        callout 11 mod_qmark $n lf_hunter v0 = 11
                else
                        echoat $n 你需要一根石龍角，不然你是打算插什麼東西？
                endif
        endif
endif
~
>room_command search fillister~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100009
                echoat $n 你仔細的搜索著凹槽四周，你發現在凹槽旁有一塊平滑的小石板(board)
                echoat $n 石板上似乎刻了一些奇特的圖樣...
                mod_qmark $n lf_hunter v0 = 10
        endif
endif
~
>room_command search default~
echoat $n 你搜尋了一下四周
if is_qmark($n) > lf_hunter 300001
        echoat $n 這是座巨大的古塔，北邊是解開封印後半敞著的石門...
        break
endif
if is_qmark($n) == lf_hunter 200005
        echoat $n 你發現在古塔整體是座巨大的石雕
        callout 1 echoat $n 就在石雕的臺座上你發現了一個雕工精細的石門
        callout 2 echoat $n 你試圖推開石門但卻徒勞無功，門上有著未見過的魔封法陣
        callout 3 echoat $n 或許獵戶知道關於這方面的傳說也不一定？
        callout 3 mod_qmark $n lf_hunter v1 = 6
endif
if is_qmark($n) == lf_hunter 200006
        callout 1 echoat $n 你發現在古塔整體是座巨大的石雕
        callout 2 echoat $n 你試圖推開石門但卻徒勞無功，門上有著未見過的魔封法陣
        callout 2 echoat $n 就在石雕的臺座上你發現了一個雕工精細的石門
        callout 3 rcall lf_greatgateX
endif
~
>room_defun lf_greatgateX~
if is_qmark($n) == lf_hunter 100000
        echoat $n 或許獵戶知道關於這方面的傳說也不一定？
endif
if is_qmark($n) == lf_hunter 100008
        echoat $n 你不死心的在四周更仔細的搜尋著...
        callout 1 echoat $n 你想著森林之主所告訴你的......雕像上的凹槽
        callout 3 echoat $n 終於！你在雕像高舉的右手發現了一個不尋常的凹槽(fillister)
        callout 5 echoat $n 或許這就是要插入石龍角的地方？
        callout 5 mod_qmark $n lf_hunter v0 = 9
endif
if is_qmark($n) >= lf_hunter 100009
        echoat $n 你已經在一旁的石雕上發現了凹槽(fillister)
        callout 1 echoat $n 這個可疑的凹槽似乎需要好好的搜索看看
endif
~
|
