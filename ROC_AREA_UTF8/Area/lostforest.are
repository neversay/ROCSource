0 0 60640
>room_rand 100~
if hour($) == 0
or hour($) == 1
or hour($) == 2
        if pcnum($) == 1
        echo 草叢南方散發著微光...
        endif
endif
~
>room_mask south default~
if is_qmark($n) >= lf_hunter 200003
        echoat $n 你快步穿過了那天發現的小徑到達了密境之池。
        echoaround $n $n 轉身衝進草叢之中不見了！
        transfer $n 60642
        modrvt t0 = 0
else
        if is_qmark($n) == lf_hunter 200002
                if roomtimer($0) > 0
                        echoat $n 你小心翼翼的沿著發光的小徑走到了一個水池邊！
                        echoaround $n 轉身衝進草叢之中不見了！
                        transfer $n 60642
                        modrvt t0 = 0
                else
                        echoat $n [0;33m哎呀，此路不通。[m
                endif
        else
                echoat $n [0;33m哎呀，此路不通。[m
        endif
endif
~
>room_command search default~
if pcnum($) > 1
        echoat $n 旁邊的人走來走去，害你無法專心搜尋。
else
    if is_qmark($n) == lf_hunter 200002
        if roomtimer($0) == 0
                if hour($) == 0
                or hour($) == 1
                or hour($) == 2
                  echoat $n 你細心搜尋下，發現草叢南方有一條發光的小徑。
                  modrvt t0 = 2
                else
                  if is_qmark($n) == lf_hunter_lord 300004
                        echoat $n 你想到了獵戶跟你提到的那段傳說...
                        callout 2 echoat $n 【在月光的導引下，在子夜時分之時，道路將顯現】
                        callout 3 echoat $n 或許應該等到午夜月亮高掛天際時再來找看看吧。
                  else
                        echoat $n 你找來找去，就是沒發現什麼小徑。
                  endif
                endif
        else
                echoat $n 四周實在太凌亂了，你什麼都找不到。
        endif
    endif
    if is_qmark($n) >= lf_hunter 200003
        echoat $n 你很快就發現南邊草叢中有條不明顯的小徑。
    endif
endif
~
|
