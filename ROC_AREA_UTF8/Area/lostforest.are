        callout 2 echoaround $n $n 發現了石像底座上有一個血手印！
        callout 2 echoat $n 你發現石像底座上有一個血手印，或許該把手壓上去(press handprint)？
else
        callout 2 echoaround $n $n 發現了石像底座上有一個綠色手印！
        callout 2 echoat $n 你發現石像底座上有一個血手印，或許該把手壓上去(press handprint)？
endif
~
