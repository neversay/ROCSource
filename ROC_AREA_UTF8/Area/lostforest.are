~
0 20|8192|1048576 3
D1
~
~
0 0 60505
E
statue~
整個石像是以大理石雕刻而成，高大的巨石像在四周的杉木下也顯
得渺小起來，石樣的外觀是一個高大英挺的男性，背後有著怒張的
蝠翼，整尊石像栩栩如生，你在石像的底座上看到一段銘文。
==========================================================
跟隨我，你將發現通往地獄的路！                         tnt
==========================================================
~
>room_rand 40~
if roomvalue($0) == 0
        break
else
        echo 微風吹過，石像底座上的綠色手印慢慢冒出鮮血，將手印染成了深暗的血紅....
        modrvt v0 = 0
endif
~
>room_command search default~
echoat $n 你試著在石像周圍搜索有無可疑之處....
echoaround $n $n 仔細地在石像四周搜索著....
if roomvalue($0) == 0
        callout 2 echoaround $n $n 發現了石像底座上有一個血手印！
        callout 2 echoat $n 你發現石像底座上有一個血手印，或許該把手壓上去(press handprint)？
else
        callout 2 echoaround $n $n 發現了石像底座上有一個綠色手印！
        callout 2 echoat $n 你發現石像底座上有一個血手印，或許該把手壓上去(press handprint)？
endif
~
>room_command press handprint~
if roomvalue($0) == 0
        echoat $n 你感覺整個人被吸入了血手印之中！
        echoat $n 當你清醒時發現自己已經不在原地了！
        echoaround $n $n 整個人忽然被吸入了血手印之中！
        echoaround $n 原本的血手印忽然變成了綠色！
        transfer $n 60510
        modrvt v0 = 1
else
        echoaround $n $n 將手壓在綠色手印上，但什麼事都沒發生。
        echoat $n 你將手壓在綠色手印上，等著接下來可能發生的任何事。
        callout 2 echo 但是似乎什麼事都沒有，四周依然幽暗嚇人。
endif
~
|
