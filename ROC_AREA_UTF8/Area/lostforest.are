#60529
lord of forest king beast lord-lf~
森林之主(Lord of Forest)~
傳說中掌管了失落之森的獸王(King of Beast)漫步在此。
~
牠擁有著公羚羊的頭部，虎斑的皮毛，如同野牛的身軀，與粗壯的羊
蹄足部，以及鹿尾；牠深邃的祖母綠眼瞳中閃爍著蘊含一切生機的光
芒，威猛莊嚴的氣息在牠到來的時候也同時瀰漫在你的四周。
~
1|2|64|128|2048|4096|8192|16384|262144|1048576|8388608 8|32|128|512|8192|32768|8589934592|137438953472|549755813888 0 S
40 2000 0 20d20+-300 -50d-300+0
0 0
0 8 0
R God~
P 1|2|4|8|128|256|32768|65536|1048576|2097152|4194304|8388608|67108864|268435456
C 1
>defun_prog lf_beast~
        mpdis_magic self mute
        mpdis_magic self 'seal magic'
        shout $N 小子不知好歹！膽敢犯吾-森林之主-！
        mpecho $I 召喚了森林的聖力！
        yell 接下森林之怒吧！
        yell 綠之牙！
        mpecho 無數的綠色枝脈自四周穿出，貫穿了你的身體！
        mpforcer here modhmv pc 03.200 200 0
        combat howling
        mpnowait
        cast 'earthquake'
        mpnowait
        mpcallout 2 cast 'wind screaming'
        mpnowait
        mpcallout 3 cast 'angry fire storm'
        mpnowait
~
>fight_prog 100~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) != lf_hunter 100003
        mpcall lf_beast $n
        else
if rand(25)
        cast 'fireball'
        mpnowait
else
        if rand(33)
                cast 'flamestrike'
                mpnowait
        else
                if rand(50)
                        cast 'star fire'
                        mpnowait
                else
                        cast 'high explosive'
                        mpnowait
                endif
        endif
endif
        endif
else
        mpcall lf_beast $n
endif
~
>talk_prog question~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100003
                mpechoat $n 你小心翼翼的問著 $I 關於石塔的問題
                think $n
                mpmod_qmark $i lf_beast_time timer + 2
                mpcallout 1 tell $n 先讓我問問你...
                mpcallout 1 tell $n 小心你的問題，你正在涉入這個森林最大的秘密
                mpcallout 2 tell $n 即使可能死亡也不能使你退卻嗎？(Yes/No)
        endif
endif
~
>talk_prog inside~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100003
                mpmod_qmark $i lf_beast_time timer + 1
                mpechoat $n 你問著 $I 到底石塔內有什麼呢？
                mpcallout 1 tnink $n
                mpcallout 2 tell $n 這告訴你也沒什麼關係
                mpcallout 4 tell $n 石塔有兩個，一個堆放物品，一個通往最後的血族村落
                mpcallout 6 tell $n 血族在當年遷城後曾經又派人回到地面上建立了村落
                mpcallout 8 tell $n 為的是指引那些迷途的血族可以回到故鄉
                mpcallout 10 tell $n 但是經過這麼長久的歲月，血族是否還在我就不知道了
                mpcallout 12 tell $n 我勸你不要跟血族扯上關係，血的聯繫是比你所能想像得更為可怕...
                mpcallout 12 mpmod_qmark $n lf_hunter v0 = 4
                mpcallout 13 mppurge self
                mpcallout 13 mpechoat $n $I 慢慢消失在泉影中...
                mpcallout 13 mpechoat $n $I 的這席話讓你更激起入石塔冒險的念頭，你是否要再探石塔呢？
        endif
endif
~
>talk_prog yes~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100003
                nod $n
                tell $n 我沒有辦法拒絕求知的慾望
                mpcallout 1 tell $n 如你所願的我將告訴你想知道的事情
                mpcallout 1 mpmod_qmark $i lf_beast_time timer + 1
                mpcallout 2 tell $n 當然，你必須小心的聆聽與利用你的知識
                mpcallout 4 tell $n 石塔是這個森林最古老的秘密，也是這座森林為何存在的原因
                mpcallout 6 tell $n 在失落的年代，這個森林曾經是血族的王城所在
                mpcallout 8 tell $n 血族，也就是現代被你們稱為吸血鬼(Vampire)的生物
                mpcallout 10 tell $n 在那個古老的年代裡，他們可比現在威風得多
                mpcallout 12 tell $n 而這些輝煌的歷史在失落的年代的最後之戰被迫畫下了句點
                mpcallout 14 tell $n 各種族的聯軍踐踏了血族們的城鎮，血族也因此分裂成兩支
                mpcallout 16 tell $n 主戰的血族留在地上，主和的血族連同王城一起沉入了地底
                mpcallout 18 tell $n 不過還有些旅居世界他處的血族也被迫留在地上
                mpcallout 20 tell $n 畢竟這場戰役來得太突然，來不及回城的都被留在地上
                mpcallout 22 tell $n 取代原本高聳的王城的就是你現在所處的這片森林
                mpcallout 24 tell $n 而那些石塔，則是血族在地面上最後光耀的遺跡
                mpcallout 26 mpechoat $n --．你想到或許牠會知道塔內有什麼(inside)
                mpcallout 26 tell $n 這就是你所想要知道的
                mpcallout 26 mpmod_qmark $i lf_beast_time timer + 1
        endif
endif
~
>talk_prog no~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100002
                nod $n
                tell $n 很好，珍惜你的生命，或許等你哪天不要命的時候
                tell $n 你也可以回到這裡來，屆時，我會告訴你的
                mpechoat $n $I 的身影慢慢消失在泉影間...
                mppurge self
        endif
endif
~
>talk_prog blacktower~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100001
                sigh $n
                mpcallout 1 tell $n 果然你還是步入了不可預知的境地了
                mpcallout 2 tell $n 那個魔法封印其實是我下的，為血族們掌守通路
                mpcallout 4 tell $n 解開的方法只有一個，你將會需要石龍的角，這也是唯一的解咒法
                mpcallout 6 tell $n 石龍喜歡出沒在古老的石製遺跡中
                mpcallout 8 tell $n 或許在之前的石塔你可以發現他的蹤跡吧
                mpcallout 10 tell $n 但是我並非獵人，而且石龍可以說是我的天敵
                mpcallout 12 tell $n 所以要如何打倒牠可能就不是我能幫你的了
                mpcallout 14 tell $n 但我的老鄰居，也就是你的師傅應該知道怎麼殺石龍吧
                mpcallout 16 tell $n 祝你幸運吧！
                mpcallout 16 mpmod_qmark $n lf_hunter v0 = 2
                mpcallout 17 mppurge self
                mpcallout 17 mpecho $I 的身影漸漸消失在泉影之中...
        endif
endif
~
>talk_prog horn~
if is_qmark($n) == lf_hunter 200006
        if is_qmark($n) == lf_hunter 100007
                if is_inv_obj($n) == 60522
                        look $n
                        mpcallout 1 nod $n
                        mpcallout 2 tell $n 正如我們之前約定好的
                        mpcallout 3 tell $n 我將告訴你解開封印的方法
                        mpcallout 5 tell $n 首先你回到高塔的門前，徹底的搜尋一番
                        mpcallout 7 tell $n 在石雕上你可以找到一個凹槽
                        mpcallout 9 tell $n 只要將石龍角插入(insert)凹槽就可以了
                        mpcallout 11 tell $n 屆時，無論你願意與否，你都將步入陌生的血族世界
                        mpcallout 13 tell $n 保重吧，小子...
                        mpcallout 14 mppurge self
                        mpcallout 14 mpmod_qmark $n lf_hunter v0 = 8
                        mpcallout 14 mpecho $I 慢慢消失在泉影之中......
                endif
        endif
endif
~
>talk_prog topic~
if is_qmark($n) == lf_hunter 200006
        tell $n 汝復前來，所為何事？
        if is_qmark($n) == lf_hunter 100001
                mpechoat $n --．其實我發現了黑塔(blacktower)
        endif
        if is_qmark($n) == lf_hunter 100007
                mpechoat $n --．我已經取得了石龍角(horn)
        endif
endif
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100003
                tell $n 汝復前來，所為何事？
                mpechoat $n --．其實我是來請教您一些問題(question)
        endif
endif
if is_qmark($n) == lf_hunter 200002
        ? $n
        tell $n 來此所為何事？
        if is_qmark($n) == lf_hunter 100000
          mpechoat $n --．我是來打倒你的！(fight)
          mpmod_qmark $n lf_hunter v0 = 1
        endif
        if is_qmark($n) == lf_hunter 100002
          mpechoat $n --．強者生來就是要戰啊！(fight)
          mpechoat $n --．其實我是奉獵戶之命而來的(hunter)...
          mpechoat $n --．磕頭求饒不知道有沒有用...
        endif
endif
if is_qmark($n) < lf_hunter 200002
or is_qmark($n) != lf_hunter
        mpechoat $n $I 的聲音出現在你的腦海中
        mpechoat $n 【心靈】 $I ：「迷惘的生命啊，快點離開此地吧」
        mpechoat $n $I 的身影慢慢消失了...
        mpforcer here modrvt t0 = 60
        mppurge self
endif
~
>act_prog kowtow~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100002
                cackle
                mpcallout 2 tell $n 孺子可教！
                mpcallout 3 tell $n 此物拿回去吧！
                mpcallout 4 mppurge self
                mpcallout 4 mpechoat $n $I 的身影漸漸消失在泉水間...
                mpcallout 4 mpoload 60519 floor
                mpcallout 4 mpechoat $n $I 從身上抖落了一樣物品！
                mpmod_qmark $n lf_hunter v0 = 4
                mpadd_qmark $n lf_beast -1 2 0 0 0 1
                mpdel_qmark $n lf_hunter_lord
                mpforcer here modrvt t0 = 120
        endif
endif
~
>talk_prog hunter~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100002
          chuckle
          mpcallout 2 grin $n
          mpcallout 2 tell $n 又是此事......
          mpcallout 3 tell $n 年復一年，日復一日，今夕何夕。
          mpcallout 4 mpoload 60519 floor
          mpcallout 4 mpechoat $n $I 從身上抖落了某件東西。
          mpcallout 4 tell $n 此物就交給你吧......
          mpcallout 5 mppurge self
          mpcallout 5 mpechoat $n $I 的身影漸漸消失在泉水間...
          mpcallout 5 tell $n 快快離去！
          mpmod_qmark $n lf_hunter v0 = 4
          mpadd_qmark $n lf_beast -1 1 0 0 0 1
          mpdel_qmark $n lf_hunter_lord
          mpforcer here modrvt t0 = 120
        endif
endif
~
>talk_prog fight~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100002
                cackle
                mpcallout 2 tell $n 就讓你領教神威！
                mpcallout 2 tell $n 初生之犢不畏虎！
                mpcallout 3 mpkill $n
                mpmod_qmark $i lf_beast_time timer = -1
                mpmod_qmark $n lf_hunter v0 = 3
                mpdel_qmark $n lf_hunter_lord
        endif
        if is_qmark($n) == lf_hunter 100001
                chuckle
                mpcallout 2 tell $n 你知道你要挑戰的是怎樣的存在嗎？
                mpcallout 3 mpecho $I 看來閃爍著神光，天生的皇者霸氣難以抵擋。
                mpcallout 3 tell $n 吾乃森林之主、野獸之王！
                mpcallout 4 tell $n 即使如此你還是執意要挑戰我嗎？
                mpmod_qmark $n lf_hunter v0 = 2
        endif
endif
~
>kill_prog 100~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100003
                mpmod_qmark $n lf_hunter v0 = 5
                mpadd_qmark $n lf_beast -1 2 0 0 0 1
                mpcallout 2 mpat $n mpechoat $n 你想或許該去找獵戶談談才是...
                mpcallout 1 mpat $n mpechoat $n $I 將你的屍體扔到了獵戶(hunter)家
                mptransfer $n hunter-lf
        endif
endif
~
>tick_prog 100~
if is_qmark($i) != lf_beast_time
or pcnum($) == 0
        mpecho $I 的身影漸漸消失在泉水的光影之中
        mppurge self
endif
~
>death_prog 100~
if is_qmark($n) == lf_hunter 200002
        if is_qmark($n) == lf_hunter 100003
                mpechoat $n $I 半跪在地，口邊流著血沫說著：「後生可畏...」
                mpechoat $n $I 慢慢化成點點星光消散了...
                mpmod_qmark $n lf_hunter v0 = 4
                mpoload 60519 floor
                mpechoat $n $I 原本站立的地方似乎有著什麼閃閃發光著。
                mppurge self
        endif
endif
mpforcer here modrvt t0 = 120
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self lf_beast_time 4 0 0 0 1 0
~
