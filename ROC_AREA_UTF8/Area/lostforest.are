~
0 0 3
D2
~
~
0 0 60606
>room_leave 511 100~
        modrvt v1 = 0
~
>room_command search default~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) >= lf_hunter 100001
if roomtimer($0) == 0
  if rand(50)
        echoat $n 草叢實在太大，你一時之間還找不到什麼...
  else
        if rand(33)
          echoat $n 你在北邊找到了一條隱密的小路！
          modrvt v1 = 1
          modrvt t0 = 5
        else
          if rand(50)
                echoat $n 你在東邊找到了一條隱密的小路！
                modrvt v1 = 2
                modrvt t0 = 5
          else
                echoat $n 你在西邊找到了一條隱密的小路！
                modrvt v1 = 3
                modrvt t0 = 5
          endif
        endif
  endif
else
        echoat $n 這裡似乎剛被踐踏過，四周一片凌亂...
endif
        else
          echoat $n 你找了半天卻什麼也找不到......
        endif
endif
if is_qmark($n) >= lf_hunter 200004
        echoat $n 你在北邊找到了之前走過的小路！
        modrvt v1 = 1
        modrvt t0 = 5
endif
if is_qmark($n) != lf_hunter
or is_qmark($n) < lf_hunter 200003
        echoat $n 你找了半天卻什麼也找不到......
endif
~
>room_mask north default~
if roomvalue($1) == 1
                echoat $n 你小心地穿越草叢往北走去！
                transfer $n 60608
else
                echoat $n [0;33m哎呀，此路不通。[m
endif
~
>room_mask east default~
if roomvalue($1) == 2
                echoat $n 你小心地穿越草叢往東走去！
                transfer $n 60608
else
                echoat $n [0;33m哎呀，此路不通。[m
endif
~
>room_mask west default~
if roomvalue($1) == 3
                echoat $n 你小心地穿越草叢往西走去！
                transfer $n 60608
else
                echoat $n [0;33m哎呀，此路不通。[m
endif
~
