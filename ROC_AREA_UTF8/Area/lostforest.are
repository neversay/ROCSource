#60606
迷失草叢~
這真的是一條路嗎？你才走沒兩步就快要走不下去了，草叢與濃
霧完全阻礙了你的視線，眼前似乎一點路都沒有，沒有受過特殊訓練
的你根本無法找出正確的路徑，除了走來的地方，放眼望去就是無止
境的迷霧與草叢而已。
~
0 0 3
D1
~
~
0 0 60605
>room_command search default~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100000
          echoat $n 你細心的搜查下，發現北邊有條隱密的小路！
          mod_qmark $n lf_hunter v0 = 1
        else
          if is_qmark($n) >= lf_hunter 100001
          echoat $n 你細心的搜查下，發現北邊有條隱密的小路！
          endif
        endif
endif
if is_qmark($n) >= lf_hunter 200004
        echoat $n 你細心的搜查下，發現北邊有條隱密的小路！
endif
if is_qmark($n) != lf_hunter
or is_qmark($n) < lf_hunter 200003
        echoat $n 你找了半天卻什麼也找不到......
endif
~
>room_mask north default~
if is_qmark($n) == lf_hunter 200003
        if is_qmark($n) == lf_hunter 100000
                echoat $n [0;33m哎呀，此路不通。[m
        else
          if is_qmark($n) >= lf_hunter 100001
                echoat $n 你小心地穿越草叢往北走去！
                transfer $n 60607
          endif
        endif
endif
if is_qmark($n) >= lf_hunter 200004
        echoat $n 你小心地穿越草叢往北走去！
        transfer $n 60607
endif
if is_qmark($n) != lf_hunter
or is_qmark($n) < lf_hunter 200003
        echoat $n [0;33m哎呀，此路不通。[m
endif
~
|
