			c shock $n
			mpnowait
		else
			c earthquake
			mpnowait
		endif
	endif
endif
~
>fight_prog 100~
if is_qmark($i) == gh_stone_timer
	break
endif
if hitprcnt($i) < 20
	if is_qmark($i) != gh_gargoyle_stone
		mpadd_qmark self gh_gargoyle_stone -1 0 0 0 0 1
		mpecho $I見傷勢嚴重，飛到一旁牆邊。
		mpmodify pdr + 500
		mpmodify mdr - 500
		mpgoto self
		stone
	endif
endif
~
>death_prog 100~
mpgreward exp $n -36 500
~
