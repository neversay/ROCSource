skilldrv onehit $r
~
>death_prog 100~
mpat 37371 mpforcer here modrvt v1 = 0
if rand(3)
	if sex($n) == 2
		mpecho [1;32m兄貴(aniki)說著「不！我珍藏的寶物啊！」[0m
		mpecho 兄貴(aniki)還來不及撕毀身上的衣服便倒了下去
		mpgreward exp $n -36 1000
		mpoload 37210 1
	else
		mpecho [1;32m兄貴(aniki)說著「我不會讓你們拿到我的寶物的！」[0m
		mpecho 兄貴(aniki)用盡最後的力氣撐爆了身上的衣服！
		break
	endif
else
	mpecho [1;32m兄貴(aniki)說著「我不會讓你們拿到我的寶物的！」[0m
	mpecho 兄貴(aniki)用盡最後的力氣撐爆了身上的衣服！
endif
~
