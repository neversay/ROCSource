#MOBILES
#37200
shadow elf-ghouse~
虛影(shadow)~
一道透明的身影(shadow)在這靜立
~
他在此負責看守身後的木門，如果想進去請試著詢問他(talk shadow enter)
~
1|2|64 8|32|512 0 S
100 0 0 0d0+0 0d0+0
1 0
0 8 1
R Elf~
P 1|2|4|8|128
S 16 -9999
S 41 9999
S 42 9999
S 45 9999
S 46 9999
>greet_prog 100~
if is_qmark($n) == ghouse_enter_count 100005
	mpechoat $n [1;32m虛影(shadow)說著「你怎麼又來了？」[0m
else
	if is_qmark($n) == ghouse_enter_count 100004
		mpechoat $n [1;32m虛影(shadow)說著「你為什麼要一直進進出出的？」[0m
		mpechoat $n [1;32m虛影(shadow)說著「$n我再給你一次機會，這次進去如果你依然不認真的解決問題」[0m
		mpechoat $n [1;32m虛影(shadow)說著「那麼短時間內我都不會讓你進去了。」[0m
		mpechoat $n [1;32m虛影(shadow)說著「自己考慮清楚還要不要進去(talk shadow enter)」[0m
	else
		mpechoat $n [1;32m虛影(shadow)說著「$n你要進去嗎？(talk shadow enter)」[0m
	endif
endif
~
>talk_prog enter~
if is_qmark($n) == ghouse_enter_count 100005
	mpechoat $n [1;32m虛影(shadow)說著「你一直進進出出的讓我很困擾...」[0m
	mpechoat $n [1;32m虛影(shadow)說著「去去去...不想認真挑戰就別待在這煩我」[0m
	mpechoat $n [1;32m虛影(shadow)說著「等你過段時間想通後再來，好，現在你可以滾了！」[0m
	mpechoat $n 一陣輕煙環繞在四周，轉瞬間你回到史卡拉貝廣場...
	mptransfer $n 3014
else
	if class($n) >= 5
		if level($n) >= 36
			mpechoat $n [1;32m虛影(shadow)說著「這裡已不適合你了，去別處尋求挑戰吧」[0m
		else
			mpechoat $n [1;32m虛影(shadow)說著「如你所願...」[0m
			mpechoat $n 一陣輕煙環繞在四周，轉瞬間你已身在木門之後了...
			mpmod_qmark $n ghouse_enter_count timer + 5
			mpmod_qmark $n ghouse_enter_count v0 + 1
			mpadd_qmark $n ghouse_enter_count 10 1 0 0 0 1
			mptransfer $n 37203
		endif
	else
		mpechoat $n [1;32m虛影(shadow)說著「如你所願...」[0m
		mpechoat $n 一陣輕煙環繞在四周，轉瞬間你已身在木門之後了...
		mpmod_qmark $n ghouse_enter_count timer + 5
		mpmod_qmark $n ghouse_enter_count v0 + 1
		mpadd_qmark $n ghouse_enter_count 10 1 0 0 0 1
		mptransfer $n 37203
	endif
endif
~
