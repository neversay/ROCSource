>rand_prog 5~
sigh
say 我的孩子們...
~
>talk_prog topic~
if is_qmark($i) != ghouse_marie
	smile
	say 你好，我已經很久沒見到活人了
	say 你願意聽我說說故事嗎？(yes/no)
endif
~
>defun_prog ghouse_talk_one~
mpecho 正當瑪莉(marie)要繼續說下去時，一陣稚嫩的聲音響起...
mpecho 不明人物[1;32m說著「主人，來陪我玩～」[0m
mpecho 瑪莉(marie)一聲哀叫，消失在你的眼前...
mppurge self
break
~
>defun_prog ghouse_talk_two~
say 我在這裡致力於生命的製造，雖然軀體的製作很容易
say 但最難的還是'魂'的製作
say 第一個心智不會成長，第二對也失敗了，第三個情緒無法控制
say 第四個則是喪失了所有情緒，終於在第五個終於成功了...
if rand(50)
	mpcallout 2 mpcall ghouse_talk_one $n
else
	mpcallout 2 mpcall ghouse_talk_three $n
endif
~
>defun_prog ghouse_talk_three~
say 第五個可以說是我心血的結晶，因此我全副心力都花在這孩子身上
say 因此也造成了悲劇...，其他孩子害怕她，害怕自己會被'捨棄'
say 所以她們殺了我，並且趕走了第五個孩子
say 這也是我當初沒有預料到的...
if rand(50)
	mpcallout 2 mpcall ghouse_talk_one $n
else
	mpcallout 2 mpcall ghouse_talk_four $n
endif
~
>defun_prog ghouse_talk_four~
say 在我死後，這裡著實沉靜了好一陣子，其他的孩子們守著我的屍體
say 認為這樣等於從第五個孩子那裡搶回了我，但屍體是沒有反應的
say 一直到某一天，一個死靈法師也看上了這個地方，想在這裡從事他的研究
say 孩子們為了守護這裡而和他的骷髏、殭屍們發生了戰鬥
say 最後死靈法師無奈之下，提出了一個交易，將我的靈魂招回此處
say 換來與孩子們和平共存的協定，但這個秘法卻也造成了冥界的缺口
say 吸引了許多邪惡的力量前來此處，包括'他'在內...
if rand(50)
	mpcallout 2 mpcall ghouse_talk_one $n
else
	mpcallout 2 mpcall ghouse_talk_five $n
endif
~
>defun_prog ghouse_talk_five~
sigh
say 我還是很想念被趕走的那孩子...
say 可惜我為她準備的禮物被'他'搶走了，其他孩子也不願幫我搶回來
say 她現在究竟在那裡呢...
say 小西...
mpecho 瑪莉(marie)的身驅逐漸變淡，慢慢地消失了...
mpexp $n 800
mppurge self
~
>talk_prog yes~
if is_qmark($i) != ghouse_marie
	mpadd_qmark self ghouse_marie -1 0 0 0 0 1
	say 這已經是兩百年前的往事了...
	say 那時我醉心於煉金術的研究，卻不像一般的煉金師專注於法術的威力
	say 而另闢奚徑，希望能達成煉金術的另一個極致─創造生命
	say 於是我離開了居住多年的地方，來到這沒人打攪的地方
	say 建造了這棟房子...
	if rand(50)
		mpcallout 2 mpcall ghouse_talk_one $n
	else
		mpcallout 2 mpcall ghouse_talk_two $n
	endif
endif
~
>talk_prog no~
if is_qmark($i) != ghouse_marie
	say 這樣啊...
	mpecho 瑪莉(marie)轉過頭去繼續發呆
endif
~
|
