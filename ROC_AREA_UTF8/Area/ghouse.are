~
>talk_prog topic~
if is_qmark($i) == ghouse_girl_four 100000
	if rand(10)
		mpmod_qmark self ghouse_girl_four v0 = 1
		say 主人...有新的命令嗎？
		mpecho 她說妳可以休息(rest)，不用再待在這裡了
		mpecho 她要妳把這裡的幽靈全部清除(clear)
		mpecho 她有要緊的事情(thing)找妳，要妳馬上去找她
		break
	else
		if rand(11)
			mpmod_qmark self ghouse_girl_four v0 = 2
			say 你們...真的認識主人？
			say 那麼...請說出我在五姊妹中的排行(1-5)
			break
		else
			if rand(13)
				mpmod_qmark self ghouse_girl_four v0 = 3
				say 你們...真的是主人的朋友？
				say 那麼...請告訴我主人的職業
				mpecho 巫師(wizard) 鍊金師(alchemist) 幻法師(sorcerer)
				break
			else
				if rand(14)
					mpmod_qmark self ghouse_girl_four v0 = 4
					say 主人找你來...是為了死靈法師...？
					mpecho 是的，她要妳把死靈法師"消除"(destroy)
					mpecho 不，她沒告訴我任何事情(nothing)
					mpecho 我就是來幫忙打倒死靈法師的，妳知道他在那(where)嗎？
					break
				else
					if rand(17)
						mpmod_qmark self ghouse_girl_four v0 = 5
						say ...有事嗎？
						mpecho 我想知道妳的"主人"現在在那裡(where)
						mpecho 妳的主人拋棄妳了，妳現在是我的所有物(own)了
						mpecho 妳知道主人口中的"他"是誰(who)嗎？
						break
					else
						if rand(20)
							mpmod_qmark self ghouse_girl_four v0 = 6
							mpecho 最終人形(final flesh)欲言又止，似乎想說什麼
							say 請問...我們和一般人何處不同...？
							mpecho 心(heart) 魂(soul) 腦(brain)
							break
						else
							if rand(25)
								mpmod_qmark self ghouse_girl_four v0 = 7
								say ...有需要幫忙的地方嗎？
								mpecho 可以幫我治療(heal)一下傷勢嗎？
								mpecho 可以告訴我這裡有什麼秘道(secret)嗎？
								mpecho 請問妳的三圍(measurements)...？
								break
							else
								if rand(33)
									mpmod_qmark self ghouse_girl_four v0 = 8
									say 你...真的認識主人？
									say 那麼...請說出主人的種族...
									mpecho 人類(human) 精靈(elf) 黑精靈(drow)
									break
								else
									if rand(50)
										mpmod_qmark self ghouse_girl_four v0 = 9
										mpecho 最終人形(final flesh)欲言又止，似乎想說什麼
										say 請問...主人她現在好嗎？
										mpecho 人都死(dead)了還有好不好的
										mpecho 我不清楚(forget)，妳不知道她在那嗎？
										mpecho 妳在說誰(who)？
										break
									else
										mpmod_qmark self ghouse_girl_four v0 = 10
										say ...有事嗎？
										mpecho 不，什麼事都沒有(nothing)
										mpecho 請問妳在這裡守著(protect)什麼東西？
										mpecho 請問妳可以幫忙(help)我打倒這裡的怪物嗎？
									endif
								endif
							endif
						endif
					endif
				endif
			endif
		endif
	endif
endif
