	break
endif
if is_qmark($i) == ghouse_gargoyle 100001
	if rand(60)
		mpecho $I的身軀漸漸化成飛龍，舞動雙翼刮起狂風！
		cast shock
		mpnowait
	else
		mpecho $I的身軀漸漸化成飛龍，吐出洶湧烈燄！
		cast fireball
		mpnowait
	endif
endif
