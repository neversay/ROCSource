>talk_prog award~
if level($n) >= 36
  if is_qmark($n) != baseball_2003
	mpadd_qmark $n baseball_2003 -1 0 0 0 0 1
	say 來，這就是紀念球棒
	mpecho 棒球小天使(baseball angel)把球棒交給了$N
	mpoload 37222 $n 36 target
  else
  	say 你已經領過紀念品囉
  endif
else
	say 你還太小了，還不能領紀念品喔
	pat $n
endif
~
