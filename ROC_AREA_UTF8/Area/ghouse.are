S 16 1000
S 41 -100
S 42 -100
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
~
>fight_prog 10~
if rand(50)
mpechoat $n 兄貴(amiki)牙齒的耀目光芒讓你睜目如盲！
c bli $n
mpnowait
else
mpechoat $r 兄貴(amiki)牙齒的耀目光芒讓你睜目如盲！
c bli $r
mpnowait
endif
~
>fight_prog 5~
