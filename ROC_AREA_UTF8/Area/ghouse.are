>fight_prog 20~
if is_qmark($i) == gh_gargoyle_stone
	break
endif
if is_qmark($i) == ghouse_gargoyle 100002
	mpecho $I的身軀伸出許多觸手展開攻擊！
	if rand(50)
		skilldrv multihit $n
		mpnowait
	else
		if pcnum($) > 0
			skilldrv multihit $r
			mpnowait
		endif
	endif
endif
~
>fight_prog 20~
if is_qmark($i) == gh_gargoyle_stone
	break
endif
if is_qmark($i) == ghouse_gargoyle 100003
	mpecho $I的身軀漸漸變成惡魔的模樣，喃喃唸起了咒語！
	if rand(33)
		c chill $n
		mpnowait
	else
