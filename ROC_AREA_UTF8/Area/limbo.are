~
>fight_prog 50~
if mpnum($i) < 100
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.100 100 0
cast heal $b
if is_qmark($b) >= max_water_mobs 300001
	cast heal $i
	mpnowait
endif
if is_qmark($b) >= max_water_mobs 300002
	cast heal $b
	mpnowait
endif
