		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv0 v2 r 4
		endif
	endif
	mpecho 契約的效力到期了，$I化作塵土回歸大地.
	remove all
	drop all
	mppurge self
endif
if sector($) == 9
	if being($b)
		mpat $b mpmod_qmark $b max_earth_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_earth_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_earth_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv0 v2 r 4
		endif
	endif
	mpecho $I往下掉了下去.
	mppurge self
endif
if being($b)
	if is_qmark($b) != max_earth_mobs
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		remove all
		drop all
		mppurge self
	endif
	if insameroom($b)
	else
		if is_qmark($i) & summon_mob_states 100002
			mpecho 依照契約的約定，$I又回$B的身邊了.
			mpteleport $b
			mpecho 依照契約的約定，$I又回$B的身邊了.
		endif
	endif
	if is_qmark($i) & summon_mob_states 100001
		if mpnum($b) >= 150
			if isfight($i)
				mpforcer here modhmv $i 12.1000 1000 0
			else
				mpforcer here modhmv $i 12.1500 1500 0
			endif
			mpat $b mpforcer here modhmv $b 11.150 150 0
			mpat $b mpechoat $b $I少量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_earth_lv0 v0 - 1
			mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_earth_lv0 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_earth_lv0 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_earth_lv0 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	else
		if mpnum($b) >= 90
			if isfight($i)
				mpforcer here modhmv $i 12.1500 1500 0
			else
				mpforcer here modhmv $i 12.2000 2000 0
			endif
			mpat $b mpforcer here modhmv $b 11.90 90 0
			mpat $b mpechoat $b $I微量吸收著你的魔力。
		else
