	if isaffected($b) / earth elemental
	else
		mpechoat $b $I使周圍的石塊飄浮，環繞於你的身邊。
		if skillexp($b) > 286 5
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -15 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -350 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 40 0
