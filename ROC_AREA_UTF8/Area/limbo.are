>talk_prog return~
if rembch($n)
	if is_qmark($i) == sum_life_time
		if is_qmark($i) >= sum_life_time 1005
			mpechoat $b $I的存在時間還很長，不願回到異界！
		else
			mpdel_qmark self sum_life_time
		endif
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n 你切斷與$I的連結.
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		mpat $b mpmod_qmark $b max_wind_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_wind_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 4
		endif
		remove all
		drop all
		mppurge self
	endif
endif
~
>tick_prog 100~
if is_qmark($i) != sum_life_time
	if being($b)
		mpat $b mpmod_qmark $b max_wind_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_wind_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 4
		endif
	endif
	mpecho 契約的效力到期了，$I伴隨著旋風就消散了.
	remove all
	drop all
	mppurge self
endif
if sector($) == 8
	if being($b)
		mpat $b mpmod_qmark $b max_wind_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_wind_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_wind_lv0 v2 r 4
		endif
	endif
	mpecho $I的身軀瞬間變成泡泡往水面上浮去！
	mppurge self
endif
if being($b)
	if is_qmark($b) != max_wind_mobs
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		remove all
		drop all
		mppurge self
	endif
	if insameroom($b)
	else
		if is_qmark($i) & summon_mob_states 100002
			mpecho 依照契約的約定，$I又回$B的身邊了.
			mpteleport $b
			mpecho 依照契約的約定，$I又回$B的身邊了.
		endif
	endif
	if is_qmark($i) & summon_mob_states 100001
		if mpnum($b) >= 150
			if isfight($i)
				mpforcer here modhmv $i 12.1000 1000 0
			else
				mpforcer here modhmv $i 12.1500 1500 0
			endif
			mpat $b mpforcer here modhmv $b 11.150 150 0
			mpat $b mpechoat $b $I少量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_wind_lv0 v0 - 1
			mpat $b mpmod_qmark $b max_wind_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	else
		if mpnum($b) >= 90
			if isfight($i)
				mpforcer here modhmv $i 12.1500 1500 0
			else
				mpforcer here modhmv $i 12.2000 2000 0
			endif
			mpat $b mpforcer here modhmv $b 11.90 90 0
			mpat $b mpechoat $b $I微量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_wind_lv0 v0 - 1
			mpat $b mpmod_qmark $b max_wind_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_wind_lv0 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	endif
else
	mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
	remove all
	drop all
	mppurge self
endif
if insameroom($b)
	if isaffected($b) / wind elemental
	else
		mpechoat $b $I在空中旋轉著身子，你的周圍吹拂起微風。
		if skillexp($b) > 287 5
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -15 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -250 0
			mpforcer here add_affect $b 'wind elemental' 1130 10 14 1200 0
			break
		endif
		if skillexp($b) > 287 4
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -12 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -200 0
			mpforcer here add_affect $b 'wind elemental' 1130 10 14 800 0
			break
		endif
		if skillexp($b) > 287 3
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -8 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -160 0
			mpforcer here add_affect $b 'wind elemental' 1130 10 14 600 0
			break
		endif
		if skillexp($b) > 287 2
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -6 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -130 0
			mpforcer here add_affect $b 'wind elemental' 1130 10 14 400 0
			break
		endif
		if skillexp($b) > 287 1
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -5 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -110 0
			mpforcer here add_affect $b 'wind elemental' 1130 10 14 300 0
			break
		else
			mpforcer here add_affect $b 'wind elemental' 1130 10 31 -2 524288
			mpforcer here add_affect $b 'wind elemental' 1130 10 39 -100 0
		endif
	endif
endif
~
