S 40 10
S 43 120
S 44 20
S 29 40
S 30 -45
W shocking grasp~ 50 50
W whirlwind~ 50 50
W storm slash~ 50 50
W mute~ 50 50
W tardy~ 50 50
W sleep~ 50 50
W acid blast~ 200 200
W earthquake~ 200 200
W meteor shower~ 200 200
W seal magic~ 200 200
W earth slash~ 200 200
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self summon_mob_states -1 3 0 0 0 1
~
>fight_prog 50~
if isaffected($n) / tardy
	break
endif
if mpnum($i) < 150
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_wind_mobs 300006
	mpforcer here modhmv $i 12.100 100 0
endif
mpforcer here modhmv $i 11.150 150 0
cast 3 tardy
mpnowait
~
>fight_prog 15~
if isaffected($n) / mute
	break
endif
if mpnum($i) < 150
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_wind_mobs 300006
	mpforcer here modhmv $i 11.150 150 0
	cast mute
	mpnowait
endif
~
