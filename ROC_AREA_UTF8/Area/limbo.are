~
>fight_prog 70~
if mpnum($i) < 300
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.300 300 0
rescue $b
~
>fight_prog 100~
if mpnum($i) < 300
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_earth_mobs 300006
	mpforcer here modhmv $i 11.300 300 0
	rescue $b
	break
endif
if rand(80)
	mpforcer here modhmv $i 11.300 300 0
	rescue $b
endif
