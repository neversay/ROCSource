>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self summon_mob_states -1 3 0 0 0 1
~
>fight_prog 50~
skilldrv multihit $n
~
>fight_prog 25~
if mpnum($i) < 500
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.500 500 0
if is_qmark($b) == max_lightning_mobs 300006
	c 3 'lightning breath'
	mpnowait
	break
endif
if is_qmark($b) >= max_lightning_mobs 300005
	c 2 'lightning breath'
	mpnowait
	break
endif
c 'lightning breath'
mpnowait
~
>fight_prog 30~
if mpnum($i) < 400
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.400 400 0
if is_qmark($b) >= max_lightning_mobs 300005
	c 2 'thunder strike'
	mpnowait
	break
endif
c 'thunder strike'
mpnowait
~
