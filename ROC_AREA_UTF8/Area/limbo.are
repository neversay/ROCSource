>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self disable_round_hit -1 0 0 0 1 0
mpadd_qmark self summon_mob_states -1 3 0 0 0 1
~
>fight_prog 15~
cast chill
~
>fight_prog 30~
cast colour
~
>fight_prog 20~
if mpnum($i) < 50
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.50 50 0
cast 'double heal' $b
if is_qmark($b) == max_water_mobs 300006
	cast 'double heal' $b
	mpnowait
	cast 'double heal'
	mpnowait
endif
~
>fight_prog 40~
if mpnum($i) < 50
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if hitprcnt($b) <= 50
	mpforcer here modhmv $i 11.50 50 0
	cast 'double heal' $b
	mpnowait
	cast 'double heal'
	mpnowait
endif
~
>fight_prog 25~
if mpnum($i) < 250
or isaffected($b) / divine light
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_water_mobs 300006
	mpforcer here modhmv $i 12.100 100 0
endif
if isaffected($b) !& 128
	mpforcer here modhmv $i 11.250 250 0
	cast san $b
	cast san $i
endif
~
>fight_prog 40~
if mpnum($i) < 400
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.400 400 0
if is_qmark($b) == max_water_mobs 300006
	mpforcer here modhmv $i 12.150 150 0
endif
cast 'mass heal'
mpnowait
if rand(40)
	cast 'mass heal'
	mpnowait
endif
