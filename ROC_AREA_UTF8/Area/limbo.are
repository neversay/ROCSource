>rand_prog 30~
if mpnum($i) < 300
or isaffected($b) / divine light
or isfight($i)
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_water_mobs 300006
	mpforcer here modhmv $i 12.100 100 0
endif
if is_qmark($b) >= max_water_mobs 300005
	if isaffected($b) !& 128
		mpforcer here modhmv $i 11.300 300 0
		mpecho $I誠心的祈禱.
		cast san $b
		cast san $i
	endif
endif
~
>rand_prog 50~
if mpnum($i) < 50
or hitprcnt($b) > 50
or isfight($i)
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.50 50 0
if is_qmark($b) >= max_water_mobs 300003
	cast heal $b
	cast heal $i
endif
cast heal $b
cast heal $i
~
>talk_prog topic~
if rembch($n)
	mpechoat $n 召喚物狀態：
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n 耗魔行為(pwful / saving)               [1;36m魔力全開[m.
	else
		mpechoat $n 耗魔行為(pwful / saving)               [1;31m節約魔力[m.
	endif
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n 返回狀態(back / stay)                  [1;36m自動返回[m.
	else
		mpechoat $n 返回狀態(back / stay)                  [1;31m原地停留[m.
	endif
	mpechoat $n 存在時間(life time)
	mpechoat $n 切斷連結(return)
endif
~
>talk_prog pwful~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n $I已經為[1;36m魔力全開[m模式.
	else
		mpechoat $n $I切換為[1;36m魔力全開[m模式，將大量使用耗魔行為.
		mpmod_qmark self sum_count v2 + 4
		mpmod_qmark self summon_mob_states v0 | 1
	endif
endif
~
>talk_prog saving~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100001
		mpechoat $n $I已經為[1;31m節約魔力[m模式.
	else
		mpechoat $n $I切換為[1;31m節約魔力[m模式，將減少魔力使用行為.
		mpmod_qmark self sum_count v2 - 4
		mpmod_qmark self summon_mob_states v0 r 1
	endif
endif
~
>talk_prog back~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
	else
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
		mpmod_qmark self summon_mob_states v0 | 2
	endif
endif
~
>talk_prog stay~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100002
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
	else
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
		mpmod_qmark self summon_mob_states v0 r 2
	endif
endif
~
>talk_prog p life time~
if rembch($n)
	if is_qmark($i) >= sum_life_time 1048
		mpechoat $n $I還能在現世活動兩天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1024
		mpechoat $n $I還能在現世活動一天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1012
		mpechoat $n $I還能在現世活動半天以上.
		break
	endif
	if is_qmark($i) == sum_life_time 1011
		mpechoat $n $I還能在現世活動 12 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1010
		mpechoat $n $I還能在現世活動 11 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1009
		mpechoat $n $I還能在現世活動 10 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1008
		mpechoat $n $I還能在現世活動 9 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1007
		mpechoat $n $I還能在現世活動 8 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1006
		mpechoat $n $I還能在現世活動 7 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1005
		mpechoat $n $I還能在現世活動 6 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1004
		mpechoat $n $I還能在現世活動 5 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1003
		mpechoat $n $I還能在現世活動 4 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1002
		mpechoat $n $I還能在現世活動 3 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1001
		mpechoat $n $I還能在現世活動 2 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n $I還能在現世活動 1 小時，可以提前切斷連結(return).
		break
	endif
endif
~
>talk_prog return~
if rembch($n)
	if is_qmark($i) == sum_life_time
		if is_qmark($i) >= sum_life_time 1005
			mpechoat $b $I的存在時間還很長，不願回到異界！
		else
			mpdel_qmark self sum_life_time
		endif
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n 你切斷與$I的連結.
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		mpat $b mpmod_qmark $b max_water_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_water_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 4
		endif
		remove all
		drop all
		mppurge self
	endif
endif
~
>tick_prog 100~
if is_qmark($i) != sum_life_time
	if being($b)
		mpat $b mpmod_qmark $b max_water_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_water_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 4
		endif
	endif
	mpecho 契約的效力到期了，$I蒸散在四周.
	remove all
	drop all
	mppurge self
endif
if sector($) == 10
	if being($b)
		mpat $b mpmod_qmark $b max_water_lv0 v0 - 1
		mpat $b mpmod_qmark $b max_water_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_water_lv0 v2 r 4
		endif
	endif
	mpecho $I純淨的身軀緩緩消逝在周圍的沙漠中...
	mppurge self
endif
if being($b)
	if is_qmark($b) != max_water_mobs
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		remove all
		drop all
		mppurge self
	endif
	if insameroom($b)
	else
		if is_qmark($i) & summon_mob_states 100002
			mpecho 依照契約的約定，$I又回$B的身邊了.
			mpteleport $b
			mpecho 依照契約的約定，$I又回$B的身邊了.
		endif
	endif
	if is_qmark($i) & summon_mob_states 100001
		if mpnum($b) >= 150
			if isfight($i)
				mpforcer here modhmv $i 12.1000 1000 0
			else
				mpforcer here modhmv $i 12.1500 1500 0
			endif
			mpat $b mpforcer here modhmv $b 11.150 150 0
			mpat $b mpechoat $b $I少量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_water_lv0 v0 - 1
			mpat $b mpmod_qmark $b max_water_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	else
		if mpnum($b) >= 90
			if isfight($i)
				mpforcer here modhmv $i 12.1500 1500 0
			else
				mpforcer here modhmv $i 12.2000 2000 0
			endif
			mpat $b mpforcer here modhmv $b 11.90 90 0
			mpat $b mpechoat $b $I微量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_water_lv0 v0 - 1
			mpat $b mpmod_qmark $b max_water_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_water_lv0 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	endif
else
	mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
	remove all
	drop all
	mppurge self
endif
if insameroom($b)
	if isaffected($b) / water elemental
	else
		mpechoat $b $I制造出一顆大型泡泡，輕輕地將你包覆進去。
		if skillexp($b) > 285 5
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -15 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 600 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 40 0
			break
		endif
		if skillexp($b) > 285 4
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -12 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 450 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 30 0
			break
		endif
		if skillexp($b) > 285 3
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -8 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 350 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 20 0
			break
		endif
		if skillexp($b) > 285 2
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -6 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 300 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 10 0
			break
		endif
		if skillexp($b) > 285 1
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -5 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 250 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 5 0
			break
		else
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -2 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 200 2097152
		endif
	endif
endif
