		if is_qmark($b) == max_flame_mobs 300006
			mpecho [1;31m$I的身軀忽然燃燒起熾熱的火焰！[m
			mpmod_qmark $b max_flame_lv2 v0 - 1
			mpmod_qmark $b max_flame_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_flame_lv2 v2 r 1
