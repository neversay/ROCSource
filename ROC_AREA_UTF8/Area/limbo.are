		if skillexp($b) > 285 1
			mpforcer here add_affect $b 'water elemental' 1130 10 28 -5 17179869184
			mpforcer here add_affect $b 'water elemental' 1130 10 13 250 2097152
			mpforcer here add_affect $b 'water elemental' 1130 10 42 5 0
