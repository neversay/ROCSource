or isfight($i)
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
if is_qmark($b) == max_water_mobs 300005
	mpecho $I誠心的祈禱.
	mpforcer here add_affect $b bless 1041 20 24 -8 0
	mpforcer here add_affect $b bless 1041 20 35 -8 0
	mpechoat $b 你感覺受到祝福.
else
	if is_qmark($b) == max_water_mobs 300006
		mpecho $I誠心的祈禱.
		mpforcer here add_affect $b bless 1041 30 24 -12 0
		mpforcer here add_affect $b bless 1041 30 35 -12 0
		mpechoat $b 你感覺受到祝福.
	endif
endif
if isaffected($i) / divine light
	break
else
	if is_qmark($b) != water_divine_light
		cast 'divine light'
		mpadd_qmark self water_divine_light 20 0 0 0 0 1
		if is_qmark($b) == max_water_mobs 300006
			mpmod_qmark self water_divine_light timer = 10
		endif
	endif
endif
