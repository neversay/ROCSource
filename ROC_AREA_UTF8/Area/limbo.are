|
#17
lightning elemental~
雷元素(Lightning Elemental)~
全身散發出強烈閃光的元素(Elemental)站在這裡.
~
從異次元召喚出來的雷元素看起來並不是很樂意
在這個次元待著，不過在契約的時間內它仍然會
盡力殲滅召喚者眼前的敵人。
~
1|2|64|256 8|32|16384|4194304 200 S
1 1100 0 0d0+-100 0d0+0
0 0
0 8 0
P 1|8|32|32768|65536|536870912
R Elemental~
S 3 25
S 44 25
S 27 60
S 31 -20
W thunder strike~ 50 50
W lightning bolt~ 50 50
W chain lightning~ 50 50
W fulgurant slash~ 50 50
W powerball~ 200 200
W magic missile~ 200 200
W curse~ 200 200
>repop_prog 100~
mpadd_qmark self summon_mob_states -1 3 0 0 0 1
~
>fight_prog 70~
if mpnum($i) < 300
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
mpforcer here modhmv $i 11.300 300 0
mpecho $I全身發出閃亮的雷電.
cast 'thunder strike'
if is_qmark($b) >= max_lightning_mobs 300003
	cast 'lightning bolt'
endif
if is_qmark($b) >= max_lightning_mobs 300005
	cast 'lightning bolt'
endif
~
>talk_prog topic~
if rembch($n)
	mpechoat $n 召喚物狀態： 
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n 耗魔行為(pwful / saving)               [1;36m魔力全開[m.
	else
		mpechoat $n 耗魔行為(pwful / saving)               [1;31m節約魔力[m.
	endif
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n 返回狀態(back / stay)                  [1;36m自動返回[m.
	else
		mpechoat $n 返回狀態(back / stay)                  [1;31m原地停留[m.
	endif
	mpechoat $n 存在時間(life time)
	mpechoat $n 切斷連結(return)
endif
~
>talk_prog pwful~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n $I已經為[1;36m魔力全開[m模式.
	else
		mpechoat $n $I切換為[1;36m魔力全開[m模式，將大量使用耗魔行為.
		mpmod_qmark self sum_count v2 + 2
		mpmod_qmark self summon_mob_states v0 | 1
	endif
endif
~
>talk_prog saving~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100001
		mpechoat $n $I已經為[1;31m節約魔力[m模式.
	else
		mpechoat $n $I切換為[1;31m節約魔力[m模式，將減少魔力使用行為.
		mpmod_qmark self sum_count v2 - 2
		mpmod_qmark self summon_mob_states v0 r 1
	endif
endif
~
>talk_prog back~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
	else
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
		mpmod_qmark self summon_mob_states v0 | 2
	endif
endif
~
>talk_prog stay~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100002
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
	else
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
		mpmod_qmark self summon_mob_states v0 r 2
	endif
endif
~
>talk_prog p life time~
if rembch($n)
	if is_qmark($i) >= sum_life_time 1048
		mpechoat $n $I還能在現世活動兩天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1024
		mpechoat $n $I還能在現世活動一天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1012
		mpechoat $n $I還能在現世活動半天以上.
		break
	endif
	if is_qmark($i) == sum_life_time 1011
		mpechoat $n $I還能在現世活動 12 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1010
		mpechoat $n $I還能在現世活動 11 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1009
		mpechoat $n $I還能在現世活動 10 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1008
		mpechoat $n $I還能在現世活動 9 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1007
		mpechoat $n $I還能在現世活動 8 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1006
		mpechoat $n $I還能在現世活動 7 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1005
		mpechoat $n $I還能在現世活動 6 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1004
		mpechoat $n $I還能在現世活動 5 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1003
		mpechoat $n $I還能在現世活動 4 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1002
		mpechoat $n $I還能在現世活動 3 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1001
		mpechoat $n $I還能在現世活動 2 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n $I還能在現世活動 1 小時，可以提前切斷連結(return).
		break
	endif
endif
~
>talk_prog return~
if rembch($n)
	if is_qmark($i) == sum_life_time
		if is_qmark($i) >= sum_life_time 1005
			mpechoat $b $I的存在時間還很長，不願回到異界！
		else
			mpdel_qmark self sum_life_time
		endif
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n 你切斷與$I的連結.
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		mpat $b mpmod_qmark $b max_lightning_lv0 v0 - 1
