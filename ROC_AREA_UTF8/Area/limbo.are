~
>talk_prog p mass heal~
if rembch($n)
	if is_qmark($i) == mhe_time
		mpechoat $n $I還沒準備好下次施法.
		break
	endif
	if mpnum($i) < 1700
		mpechoat $n $I向你搖搖頭表示她魔力不足.
		break
	endif
	mpforcer here modhmv $i 11.1700 1700 0
	if is_qmark($b) == max_water_mobs 300006
		mpforcer here modhmv $i 12.500 500 0
	endif
	cast 'mass heal'
	mpnowait
	mpadd_qmark self mhe_time 2 0 0 0 1 0
	mpcallout 3 mpdel_qmark self mhe_time
	mpcallout 3 mpechoat $b $I準備好施放[1;36m群體治療術(mass heal)[m.
	break
endif
