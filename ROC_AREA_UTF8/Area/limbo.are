			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_wind_lv1 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	endif
else
	mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
	remove all
	drop all
	mppurge self
endif
if insameroom($b)
	if isaffected($b) / wind elemental
	else
