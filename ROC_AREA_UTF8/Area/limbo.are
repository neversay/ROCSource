>rand_prog 50~
if hitprcnt($b) > 50
or isfight($i)
	break
endif
if is_qmark($i) !& summon_mob_states 100001
	if rand(85)
		break
	endif
endif
cast 'double heal' $b
mpnowait
cast 'double heal'
mpnowait
~
>rand_prog 30~
