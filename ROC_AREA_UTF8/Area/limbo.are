>talk_prog topic~
if rembch($n)
	mpechoat $n 召喚物狀態：
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n 耗魔行為(pwful / saving)               [1;36m魔力全開[m.
	else
		mpechoat $n 耗魔行為(pwful / saving)               [1;31m節約魔力[m.
	endif
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n 返回狀態(back / stay)                  [1;36m自動返回[m.
	else
		mpechoat $n 返回狀態(back / stay)                  [1;31m原地停留[m.
	endif
	mpechoat $n 存在時間(life time)
	mpechoat $n 切斷連結(return)
	mpechoat $n ----------------------------------------------
	mpechoat $n 擁有技能：
	if is_qmark($i) == mhe_time
		mpechoat $n 群體治療術(mass heal)                  [1;31m還沒準備好施放[m.
	else
		if mpnum($i) < 1500
			mpechoat $n 群體治療術(mass heal)                  [1;31m魔力不足施放[m.
		else
			mpechoat $n [1;36m群體治療術(mass heal / mh)[m.
		endif
	endif
	if is_qmark($i) == gdb_time
		mpechoat $n 群體雙重治療術(gdouble heal)           [1;31m還沒準備好施放[m.
	else
		if mpnum($i) < 2000
			mpechoat $n 群體雙重治療術(gdouble heal)           [1;31m魔力不足施放[m.
		else
			mpechoat $n [1;36m群體雙重治療術(gdouble heal / gdb)[m.
		endif
	endif
	if is_qmark($b) < max_water_mobs 300006
	else
		if is_qmark($b) == gfull_time 1024
			mpechoat $n 群體完全治癒術(gfull heal)      還要 [1;31m24[m 小時才能再次施放.
		endif
		if is_qmark($b) == gfull_time 1023
			mpechoat $n 群體完全治癒術(gfull heal)      還要 [1;31m23[m 小時才能再次施放.
		endif
		if is_qmark($b) == gfull_time 1022
			mpechoat $n 群體完全治癒術(gfull heal)      還要 [1;31m22[m 小時才能再次施放.
		endif
		if is_qmark($b) == gfull_time 1021
			mpechoat $n 群體完全治癒術(gfull heal)      還要 [1;31m21[m 小時才能再次施放.
		endif
		if is_qmark($b) == gfull_time 1020
			mpechoat $n 群體完全治癒術(gfull heal)      還要 [1;31m20[m 小時才能再次施放.
