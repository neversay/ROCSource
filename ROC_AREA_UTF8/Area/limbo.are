>talk_prog pwful~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100001
		mpechoat $n $I已經為[1;36m魔力全開[m模式.
	else
		mpechoat $n $I切換為[1;36m魔力全開[m模式，將大量使用耗魔行為.
		mpmod_qmark self sum_count v2 + 4
		mpmod_qmark self summon_mob_states v0 | 1
	endif
endif
~
>talk_prog saving~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100001
		mpechoat $n $I已經為[1;31m節約魔力[m模式.
	else
		mpechoat $n $I切換為[1;31m節約魔力[m模式，將減少魔力使用行為.
		mpmod_qmark self sum_count v2 - 4
		mpmod_qmark self summon_mob_states v0 r 1
	endif
endif
~
>talk_prog back~
if rembch($n)
	if is_qmark($i) & summon_mob_states 100002
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
	else
		mpechoat $n $I開始每小時會[1;36m自動返回[m持有者身邊.
		mpmod_qmark self summon_mob_states v0 | 2
	endif
endif
~
>talk_prog stay~
if rembch($n)
	if is_qmark($i) !& summon_mob_states 100002
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
	else
		mpechoat $n $I停止跟隨後將[1;31m原地停留[m.
		mpmod_qmark self summon_mob_states v0 r 2
	endif
endif
~
>talk_prog p defensive~
if rembch($n)
	if is_qmark($b) < max_earth_mobs 300006
		mpechoat $b $I向你搖搖頭表示他不會.
		break
	endif
	if is_qmark($n) != def_time
		mpforcer here add_affect $i defensive 1040 3 41 50 0
		mpforcer here add_affect $i defensive 1040 3 42 50 0
		mpadd_qmark $n def_time 24 0 0 0 1 0
		mpechoat $n $I集中全力，運起護身罡氣。
	else
		mpechoat $n $I還沒從上次施法的損耗中回復過來。
	endif
endif
~
>talk_prog p def~
if rembch($n)
	if is_qmark($b) < max_earth_mobs 300006
		mpechoat $b $I向你搖搖頭表示他不會.
		break
	endif
	if is_qmark($n) != def_time
		mpforcer here add_affect $i defensive 1040 3 41 50 0
		mpforcer here add_affect $i defensive 1040 3 42 50 0
		mpadd_qmark $n def_time 24 0 0 0 1 0
		mpechoat $n $I集中全力，運起護身罡氣。
	else
		mpechoat $n $I還沒從上次施法的損耗中回復過來.
	endif
endif
~
>talk_prog p life time~
if rembch($n)
	if is_qmark($i) >= sum_life_time 1048
		mpechoat $n $I還能在現世活動兩天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1024
		mpechoat $n $I還能在現世活動一天以上.
		break
	endif
	if is_qmark($i) >= sum_life_time 1012
		mpechoat $n $I還能在現世活動半天以上.
		break
	endif
	if is_qmark($i) == sum_life_time 1011
		mpechoat $n $I還能在現世活動 12 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1010
		mpechoat $n $I還能在現世活動 11 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1009
		mpechoat $n $I還能在現世活動 10 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1008
		mpechoat $n $I還能在現世活動 9 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1007
		mpechoat $n $I還能在現世活動 8 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1006
		mpechoat $n $I還能在現世活動 7 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1005
		mpechoat $n $I還能在現世活動 6 小時.
		break
	endif
	if is_qmark($i) == sum_life_time 1004
		mpechoat $n $I還能在現世活動 5 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1003
		mpechoat $n $I還能在現世活動 4 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1002
		mpechoat $n $I還能在現世活動 3 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) == sum_life_time 1001
		mpechoat $n $I還能在現世活動 2 小時，可以提前切斷連結(return).
		break
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n $I還能在現世活動 1 小時，可以提前切斷連結(return).
		break
	endif
endif
~
>talk_prog return~
if rembch($n)
	if is_qmark($i) == sum_life_time
		if is_qmark($i) >= sum_life_time 1005
			mpechoat $b $I的存在時間還很長，不願回到異界！
		else
			mpdel_qmark self sum_life_time
		endif
	endif
	if is_qmark($i) != sum_life_time
		mpechoat $n 你切斷與$I的連結.
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		mpat $b mpmod_qmark $b max_earth_lv2 v0 - 1
		mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 4
		endif
		remove all
		drop all
		mppurge self
	endif
endif
~
>tick_prog 100~
if is_qmark($i) != sum_life_time
	if being($b)
		mpat $b mpmod_qmark $b max_earth_lv2 v0 - 1
		mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 4
		endif
	endif
	mpecho 契約的效力到期了，$I化作塵土回歸大地.
	remove all
	drop all
	mppurge self
endif
if sector($) == 9
	if being($b)
		mpat $b mpmod_qmark $b max_earth_lv2 v0 - 1
		mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv2 v2 r 4
		endif
	endif
	mpecho $I往下掉了下去.
	mppurge self
endif
if being($b)
	if is_qmark($b) != max_earth_mobs
		mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
		remove all
		drop all
		mppurge self
	endif
	if insameroom($b)
	else
		if is_qmark($i) & summon_mob_states 100002
			mpecho 依照契約的約定，$I又回$B的身邊了.
			mpteleport $b
			mpecho 依照契約的約定，$I又回$B的身邊了.
		endif
	endif
	if is_qmark($i) & summon_mob_states 100001
		if mpnum($b) >= 400
			if isfight($i)
				mpforcer here modhmv $i 12.1000 1000 0
			else
				mpforcer here modhmv $i 12.1500 1500 0
			endif
			mpat $b mpforcer here modhmv $b 11.400 400 0
			mpat $b mpechoat $b $I大量吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_earth_lv2 v0 - 1
			mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	else
		if mpnum($b) >= 240
			if isfight($i)
				mpforcer here modhmv $i 12.1500 1500 0
			else
				mpforcer here modhmv $i 12.2000 2000 0
			endif
			mpat $b mpforcer here modhmv $b 11.240 240 0
			mpat $b mpechoat $b $I吸收著你的魔力。
		else
			mpat $b mpechoat $b 你的魔力不足以維持$I的血之契約
			mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
			mpat $b mpmod_qmark $b max_earth_lv2 v0 - 1
			mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
			if is_qmark($i) & sum_count 100001
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 1
			endif
			if is_qmark($i) & sum_count 100002
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 2
			endif
			if is_qmark($i) & sum_count 100004
				mpat $b mpmod_qmark $b max_earth_lv2 v2 r 4
			endif
			remove all
			drop all
			mppurge self
		endif
	endif
else
	mpecho 失去了血之契約的牽絆，$I回到它該去的地方了.
	remove all
	drop all
	mppurge self
endif
if insameroom($b)
	if isaffected($b) / earth elemental
	else
		mpechoat $b $I使周圍的石塊飄浮，環繞於你的身邊。
		if skillexp($b) > 286 5
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -15 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -350 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 40 0
			break
		endif
		if skillexp($b) > 286 4
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -12 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -250 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 30 0
			break
		endif
		if skillexp($b) > 286 3
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -8 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -200 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 20 0
			break
		endif
		if skillexp($b) > 286 2
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -6 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -170 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 10 0
			break
		endif
		if skillexp($b) > 286 1
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -5 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -120 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 5 0
