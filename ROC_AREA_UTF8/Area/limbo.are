			break
		endif
		if skillexp($b) > 286 3
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -8 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -200 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 20 0
			break
		endif
		if skillexp($b) > 286 2
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -6 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -170 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 10 0
			break
		endif
		if skillexp($b) > 286 1
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -5 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -120 0
			mpforcer here add_affect $b 'earth elemental' 1130 10 41 5 0
			break
		else
			mpforcer here add_affect $b 'earth elemental' 1130 10 30 -2 8192
			mpforcer here add_affect $b 'earth elemental' 1130 10 17 -100 0
		endif
	endif
endif
~
>entry_prog 100~
if sector($) == 9
	if being($b)
		mpat $b mpmod_qmark $b max_earth_lv1 v0 - 1
		mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
		if is_qmark($i) & sum_count 100001
			mpat $b mpmod_qmark $b max_earth_lv1 v2 r 1
		endif
		if is_qmark($i) & sum_count 100002
			mpat $b mpmod_qmark $b max_earth_lv1 v2 r 2
		endif
		if is_qmark($i) & sum_count 100004
			mpat $b mpmod_qmark $b max_earth_lv1 v2 r 4
		endif
	endif
	mpecho $I往下掉了下去.
	mppurge self
endif
~
>death_prog 100~
if being($b)
	mpat $b mpmod_qmark $b max_earth_lv1 v0 - 1
	mpat $b mpmod_qmark $b max_earth_mobs v0 - 1
	if is_qmark($i) & sum_count 100001
		mpat $b mpmod_qmark $b max_earth_lv1 v2 r 1
	endif
	if is_qmark($i) & sum_count 100002
		mpat $b mpmod_qmark $b max_earth_lv1 v2 r 2
	endif
	if is_qmark($i) & sum_count 100004
		mpat $b mpmod_qmark $b max_earth_lv1 v2 r 4
	endif
endif
