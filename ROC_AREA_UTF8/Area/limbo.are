	mpecho $I火焰的身軀瞬間熄滅在周圍的水中！
	mppurge self
endif
~
>death_prog 100~
if being($b)
	mpat $b mpmod_qmark $b max_flame_lv1 v0 - 1
	mpat $b mpmod_qmark $b max_flame_mobs v0 - 1
	if is_qmark($i) & sum_count 100001
		mpat $b mpmod_qmark $b max_flame_lv1 v2 r 1
	endif
	if is_qmark($i) & sum_count 100002
		mpat $b mpmod_qmark $b max_flame_lv1 v2 r 2
	endif
	if is_qmark($i) & sum_count 100004
		mpat $b mpmod_qmark $b max_flame_lv1 v2 r 4
	endif
endif
