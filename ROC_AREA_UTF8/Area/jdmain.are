~
>greet_prog 10~
sigh
~
>give_prog 11143~
if is_qmark($n)== jd_liu 100006
    mpjunk package
    tell $n 沒想到...最後竟是這樣的結局。
    sigh
    tell $n 大恩不言謝，在下有一薄禮致贈少俠。
    thank $n
    mpechoat $n $I走進內室，過了一會，手上捧著一把劍走了出來。
    tell $n 這是柳家代代相傳的一把寶劍。本來我是不該把它送人的，但是
    tell $n 因為家父之事，在下無心再涉足武林，因此這柄劍就送給閣下，
    tell $n 以報閣下大恩。
    mpoload 11165 $n viclv target
    mpechoat $n $I把劍交給了你
    mpmod_qmark $n jd_liu v0 = 7
    wave $n
  else
  	say 這東西根本就是假的，還敢拿來騙我！
  	mpjunk package
  	mpkill $n
	endif
endif
~
>talk_prog trouble~
	if is_qmark($n) == jd_liu 100007
		tell $n 謝謝少俠相助，柳某已無心再涉足江湖。
	else
		if is_qmark($i) == jd_liu_self
			tell $n 我已經委託一位少俠去處理了，謝謝你的關心。
		else
			if is_qmark($n) == jd_liu
	  		say 那件事查得怎麼樣了，有結果了嗎？
 			else
 				if resp($n) > 20
 					hmm
 					tell $n 一言難盡....
 					sigh
 					tell $n 事情是這樣的...
 					mpechoaround $n $I說：...
 					mpechoat $n $I說道：「[1;32m
 					mpechoat $n
 					mpechoat $n 家父柳雲風(Liu Yun-fon)，與前任鎮長陳秋雨(Chen Chow-yu)，
 					mpechoat $n 當年人稱「風雨雙俠」，在江湖上行俠仗義，著實闖出了一番名號......
	 				mpechoat $n 　
	 				mpechoat $n 在大約七年前，家父與陳世伯本已不問世事，但二人為了處理一場紛爭而
 					mpechoat $n 雙雙趕往名劍山莊，不幸的是，家父卻沒能平安回來。這件事過後不久，
 					mpechoat $n 陳世伯就當了鎮長，和我們也不再往來，不禁令人懷疑當年名劍山莊一行
 					mpechoat $n 究竟發生什麼事情。不曉得能否想託您代為查探一番莊主與家父是相當要
 					mpechoat $n 想必知道一些什麼，也好了卻在下一件心事。
 					mpechoat $n 只要告訴莊主我的名字(Gin-ming)，莊主應該就知道了。[0m
 					mpechoat $n   」
 					mpadd_qmark $n jd_liu -1 1 0 0 0 1
 					mpadd_qmark $i jd_liu_self 200 0 0 0 0
 					mpechoat $n [1;33m聽完這段話，你決定往名劍山莊跑一趟。[0m
 				else
 					tell $n 我還是無法信任您，畢竟您在武林中沒什麼名聲...
 					sorry $n
 				endif
 			endif
		endif
	endif
~
>give_prog 11144~
	if is_qmark($n) == jd_liu 100003
		mpechoat $n $I讀完了信，淚也滴了下來
		tell $n 謝謝少俠幫我找到這封遺書...
		mpechoat $n $I從懷裡拿出一個玉做成的羅漢。
		tell $n 這個玉羅漢本是一對，家父與家母各持其一，父親失蹤後不久，
		tell $n 母親也過世了，留下這玉羅漢給我，請您一併帶去，我父母在天
		tell $n 之靈也會保佑少俠的。願少俠能替我報這殺父之仇！
		bow $n
		mpat 5 c 'dis magic'
 		mpat 5 c 'de inv'
 		mpat 5 c 'de hid'
 		mpat 5 c inf
 		mpoload 64140 36
 		give jade $n
 		mpmod_qmark $n jd_liu v0 = 4
 		mpechoat $n 現在該去問莊主陳秋雨跑哪去了(where is chow-yu)
	else
		?
		tell $n 你給我這個做什麼？
		drop letter
	endif
~	
