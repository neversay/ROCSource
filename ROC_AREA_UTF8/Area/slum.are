>talk_prog complete~
  if is_qmark($n) & slum_libei_quest 200008
    	say 你不是早就完成了？
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300008
    	if is_qmark($n) == slum_woman_damage
      		mpmod_qmark $n slum_libei_quest v2 r 8
		mpdel_qmark $n slum_dex_quest
      		mpdel_qmark $n slum_woman_damage
      		say 你這個白癡！白癡！
      		angry $n
      		mpcallout 1 say 我不是叫你不要傷害他們了嗎？你是耳聾啦！
      		mpcallout 2 say 滾！你給我滾得遠遠的！
      		mpcallout 2 mpechoat $n $i將你一路罵出酒吧......
      		mpcallout 3 mpforce $n w
      		break
    	endif
    	if is_qmark($n) <= slum_dex_quest 200001
      		say 騙鬼！你根本沒有給我任何東西！
      		break
    	endif
    	say 很好！
    	mpmod_qmark $n slum_libei_quest v1 | 8
    	if is_qmark($n) & slum_dex_quest 200002
      		mpgold $n 1200
    	endif
    	if is_qmark($n) & slum_dex_quest 200004
      		mpgold $n 1200
    	endif
    	if is_qmark($n) & slum_dex_quest 200008
      		mpgold $n 1200
    	endif
    	if is_qmark($n) & slum_dex_quest 200016
      		mpgold $n 1200
    	endif
    	if is_qmark($n) & slum_dex_quest 200032
      		mpgold $n 1200
    	endif
    	if is_qmark($n) & slum_dex_quest 200064
      		mpgold $n 1200
    	endif
      	say 這樣的獎賞不錯吧！
      	mpoload 9418
      	mpechoat $n $I將紫色信函簽了名。
      	mpcallout 1 give signed $n
      	mpcallout 2 say 回去把這封信交給利拜就可以了。
      	break
  endif
  say 你在說什麼呀？
~
