  if int($n) >= 12
  or is_qmark($n) == slum_witch_herb  
    	if rand(60)
      		oload 9403 1 $n floor
      		echoat $n 你從地上拔出一枝黑色枯藤。
      		echoaround $n $n從地上拔出一枝黑色枯藤。
      		break
    	endif
    	echoat $n 你找了一會兒，卻什麼也沒找到。
    	break
  endif
  echoat $n 你無法判斷這叢植物那一株能拔起來作藥。
