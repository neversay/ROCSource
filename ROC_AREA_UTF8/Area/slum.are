>talk_prog help~
if is_qmark($n) & slum_libei_quest 300008
	mpdel_qmark $n slum_libei_womancycle
	mpechoat $n $I低聲告訴你每個家庭主婦的作息時間......
	mpcallout 1 mpechoat $n 你慢慢記下每個人的作息時間......
	if int($n) < 13
		mpcallout 2 mpadd_qmark $n slum_libei_womancycle 12 1 0 0 1 0
		mpcallout 2 mpechoat $n 你記下來了，以你的智力大概能記住半天。
		break
	endif
	if int($n) < 20
		mpcallout 2 mpadd_qmark $n slum_libei_womancycle 24 1 0 0 1 0
		mpcallout 2 mpechoat $n 你記下來了，以你的智力大概能記住一天。
		break
	endif
	if int($n) < 25
		mpcallout 2 mpadd_qmark $n slum_libei_womancycle 48 1 0 0 1 0
		mpcallout 2 mpechoat $n 你記下來了，以你的智力大概能記住兩天。
		break
	endif
	mpcallout 2 mpadd_qmark $n slum_libei_womancycle -1 1 0 0 1 0
	mpcallout 2 mpechoat $n 你記下來了，你超人的腦力讓你永不忘懷，除非死亡或離去。
endif
say 啥？你要我幫你什麼？
