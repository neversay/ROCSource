>talk_prog complete~
  if is_qmark($n) & slum_libei_quest 200032
    	say 你不是做完了嗎？
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300032
    	if is_qmark($n) <= slum_con_quest 200001
      		say 哼，你根本沒有作任何工作！
      		break
    	endif
    	mpmod_qmark $n slum_libei_quest v1 | 32
    	if is_qmark($n) <= slum_con_quest 200007
      		say 這樣的量有點少了......
      		mpgold $n 2000
      		mpcall end_1 $n
      		break
      	endif
    	if is_qmark($n) <= slum_con_quest 200013
      		say 這樣的量差不多夠了。
      		mpgold $n 3000
      		mpcall end_1 $n
      		break
      	endif
    	if is_qmark($n) <= slum_con_quest 200019
      		say 嗯，你的收穫量蠻多的嘛！
      		mpgold $n 4000
      		mpcall end_1 $n
      		break
      	endif
    	if is_qmark($n) <= slum_con_quest 200025
      		say 今天可真是大豐收呀！
      		mpgold $n 5000
    	else
      		say 太棒了，我作了這麼久管理員還沒一次見過這個多的貨！
      		mpgold $n 7000
    	endif
    	mpcall end_1 $n
      	break
  endif
  say 你在說什麼呀？
~
