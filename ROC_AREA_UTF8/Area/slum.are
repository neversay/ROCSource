>room_time 100~
  if hour($) == 14
    	echo 你看到幾艘雙桅帆船遠遠駛來......
    	callout 1 echo 一名水手登上船頭，大喊：「到貨啦！漁船讓道！」
    	callout 2 echo 帆船群緩緩靠岸，準備卸貨。
    	callout 3 echo 船錨從船弦丟了下來，船版撤了下來，船口開了。
    	callout 3 makedoor 2 船艙甲板 board 1 -1 9452
    	callout 3 force 9452 echo 船版撤下來了，你到達貧民區港口了。
    	break
  endif
  if hour($) > 14
	if hour($) <= 16
	  	echo 水手和搬運工從船上搬下一箱又一箱的貨物，經過你身邊。
	  	callout 1 echo 一群搬運工擔著重物走過。
	  	callout 2 echo 「嘿修--嘿修--」
	  	break
	endif
  endif
  if hour($) == 17
  	deldoor 2
  	echo 遠方帆船群起帆，離開港口了.....
   	force 9452 echo 船版收回來了，你準備離開貧民區港口了。
  	break
  endif
  if hour($) ==3
    	echo 你看到一艘小黑船迅捷地靠岸，放下暗門。
    	makedoor 2 黑暗的小船版 board 1 -1 9454
    	callout 1 echo 一群工人鬼鬼祟祟地登上小船......
    	callout 2 echo 一群工人神經兮兮地搬著貨物進倉庫。
    	break
  endif
  if hour($) ==4
    	echo 你看到一艘小黑船快速地駛離港口，往下游而去。
    	deldoor 2
    	break
  endif
~
