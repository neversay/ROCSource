>talk_prog topic~
  say 可惡的黑幫！竟敢把我趕出來！
~
>talk_prog hint~
if is_qmark($n) & slum_libei_quest 300064
  	mpcall job_3 $n
  	mpcallout 1 mpcall job_4 $n
endif
~
>talk_prog wis~
say 所謂智慧(wis)，就是你待人處事能力的總和，當你的智慧越高，你談判和
say 討價還價的能力也越高。所以，如果你自覺智慧不夠，可別來接這個任務。
say 如果你生得孔武有力，你可以試試看強硬的立場；相反地，如果你是屬於
say 智慧型的人物，那你可以試著用分析的立場來對付他。
~
>talk_prog strong man~
  say 他應該在[1;37m馬戲團的觀眾席[0m那邊，監視著我們手下。
~
>give_prog 9422~
  mpjunk mail
  if is_qmark($n) & slum_libei_quest 100064
  	mpadd_qmark $n slum_wis_quest -1 1 1 0 0 1
    	say 啊，你來的剛好，那個傢伙竟然再度關閉協商大門，
    	say 我們正好需要一個密使來當作溝通橋樑，就你來吧！
    	say 我想你應該知道他在哪裡了吧(hint)？
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300064
    	mpecho $I專心地看完手上的信函。
    	mpadd_qmark $n slum_wis_quest -1 1 1 0 0 1
    	mpcallout 1 hmm
    	mpcallout 1 say 嘖，利拜怎麼老是派這種臨時工給我......
    	mpcallout 2 say 好，你知道我的工作是什麼嗎？
    	mpcallout 3 mpcall job_1 $n
    	mpcallout 4 mpcall job_2 $n
    	mpcallout 5 mpcall job_3 $n
    	mpcallout 6 mpcall job_4 $n
    	break
  endif
~
>defun_prog job_1~
  say 沒錯，我是一名談判專家，負責為巢穴牟取最大利益。
  say 最近北邊那個馬戲團來我們這裡公演，賺進大把銀子，
  say 但我們卻得不到任何利益！因為全給黑幫佔去了，真是可惡！
  angry
~
>defun_prog job_2~
  say 更可惡的是，他們竟然關閉協商大門，把我這個專家趕了出來！
  say 真是目中無人呀！我可是史卡拉貝大學院畢業的高材生呀！
  mpechoat $n 你突然明白他為什麼會被趕出來了
~
>defun_prog job_3~
  say 唉，你！你幫我進馬戲團，找一個[1;37m彪形大漢(strong man)[0m，
  say 傳達我的憤怒與不滿！
  hmm
~
>defun_prog job_4~
  say 北邊有一條便道可以直接進馬戲團，你就從那邊進去吧。
  say 不過[1;37m可別傷害他[0m，我們不想「現在」跟黑幫打起來，懂嗎？
~
>all_greet_prog 100~
  if is_qmark($n) != slum_libei_quest
	break
  endif
  if is_qmark($n) & slum_libei_quest 300064
    if is_qmark($n) == slum_representative_nojob
      	say 天哪！利拜竟然派了一個只懂拳頭的白癡過來！
      	say 啊！你把我多時的心血全部搞砸了！
      	say 你給我滾回去吃老米飯吧你！
      	mpmod_qmark $n slum_libei_quest v1 r 64
      	mpmod_qmark $n slum_libei_quest v2 r 64
      	mpdel_qmark $n slum_wis_quest
      	mpadd_qmark $n slum_libei_nojob 25 1 0 0 1 1
      	mpcallout 1 mpechoat $n $I完全不顧形象地大罵你，將你罵下瞭望台......
      	mpcallout 2 mpforce $n d
      	break
    endif
    mpdel_qmark $n slum_strong_notalk
    if is_qmark($n) & slum_wis_quest 232768
      	mpmod_qmark $n slum_libei_quest v1 | 64
      	mpechoat $n [1;37m你將對方的話傳給了$I聽，他閉起眼苦思......[0m
      	mpmod_qmark $n slum_wis_quest v1 r 65025
      	mpoload 9417 1
      	if is_qmark($n) >= slum_wis_quest 200060
        	mpcallout 1 say 哈哈，他果然早就技窮了，只會用這種騙小孩的手段耍賴，這下我們勝算大增！
        	mpgold $n 10000
      	else
        	mpcallout 1 say 唉，黑幫勢力會這麼強盛不是沒有原因的，這下要與利拜好好商討對策了。
        	mpgold $n 5000
      	endif
      	mpcallout 1 mpecho $I拿起隨身羽筆，在信封上簽名。
      	mpcallout 2 give signed $n
      	mpcallout 2 say 把這封信拿給利拜就行了。
	mpcallout 3 c 2 'cure critical' $n
      	break
    endif
    if is_qmark($n) & slum_wis_quest 208192
      	mpmod_qmark $n slum_wis_quest v1 | 16384
      	mpechoat $n 你詳述了對方的反應......
      	mpcallout 1 say 哈，他果然技窮了，很好！
      	mpcallout 2 mpechoaround $n $I突然靠在$N耳旁，對$e說悄悄話。
      	mpcallout 2 mpcall secret_2 $n
      	mpcallout 3 dance
	mpcallout 4 c 'cure critical' $n
      	break
    endif
    if is_qmark($n) & slum_wis_quest 202048
      	mpmod_qmark $n slum_wis_quest v1 | 4096
      	mpechoaround $n $N將黑幫代言人的話老老實實地講給談判專家聽。
      	mpechoat $n 你將黑幫代言人的話老老實實地講給談判專家聽。
      	say 嗯..............
      	hmm
      	mpcallout 1 say 哼，你再去跟他談一次，我猜他講不出新花樣的。
      	mpcallout 2 c 2 'cure critical' $n
	break
    endif
    if is_qmark($n) & slum_wis_quest 200512
      	mpmod_qmark $n slum_wis_quest v1 | 1024
      	mpechoaround $n $N將黑幫代言人的話老老實實地講給談判專家聽。
      	mpechoat $n 你將黑幫代言人的話老老實實地講給談判專家聽。
      	say 可惡的黑幫混混，以為先佔了地盤就如此猖狂！
      	say 哼，不過現在不是意氣用事的時候......
      	mpechoat $n $I突然靠在你耳旁。
      	mpechoaround $n $I突然靠在$N耳旁，對$e說悄悄話。
      	mpcallout 1 mpcall secret_1 $n
      	mpcallout 2 say 去吧，把我的訊息傳達給那些混混！
      	mpcallout 3 c 2 'cure critical' $n
	break
    endif
  endif
~
>defun_prog secret_1~
  mpechoat $n $I悄悄說：「其實，現在老大並不想與他們起衝突，但是我們也」
  mpechoat $n $I悄悄說：「不能失了威風，所以你必須在強硬與退讓之間取平」
  mpechoat $n $I悄悄說：「衡點，這就要靠你的智慧(wis)了......」
~
>defun_prog secret_2~
  mpechoat $n $I悄悄說：「現在，我們離勝利不遠了，繼續向他施壓，
  mpechoat $n 直到他受不了為止！到時候我們就為巢穴立下大功了！」
  dance
~
