7 -1 9458
>room_enter 15 100~
  if rand(80)
	modhmv $n 03.7 15 12000001 
	echoat $n 唉呀，你被暗處的機關劃傷了！
	if ispc($n)
		echoaround $n $n被機關劃傷了。
	else
		echoaround $n $N被機關劃傷了。
	endif
  endif
if exitinfo($3) & 4
  if wis($n) >= 13
	echoat $n 你發現西邊有一道鎖住的舊門。
	if dex($n) >= 16
		echoat $n 似乎可以撬開(knock west)。
		break
	endif
	if int($n) >= 16
		echoat $n 似乎可以用魔法轟開(knock west)。
		break
	endif
	if str($n) >= 16
		echoat $n 似乎可以撞開(knock west)。
		break
	endif
	if wis($n) >= 19
		echoat $n 且經過你的分析，這道門很容易被[1;35m撬開[0m。
	endif
  endif
endif
~
>room_command knock west~
  if dex($n) >= 18
  	modhmv $n 23.5 8 00000000
	echoat $n 你試圖撬開這道門......
	echoaround $n $n試圖撬開這道門......
	if rand(70)
		callout 1 echoat $n [1;37m你成功地將門撬開！[0m
		callout 1 echoaround $n $n將門撬開了。
		callout 1 modrvt d3 == 1
		callout 1 force 9458 modrvt d1 == 1
		callout 1 force 9458 echo 東邊的門被撬開了！
	else
		callout 1 echoat $n 你失敗了！
	endif
	break
  endif
  if int($n) >= 18
  	modhmv $n 13.5 8 00000000
	echoat $n 你試圖使用魔法轟開這道門......
	echoaround $n $n試圖使用魔法轟開這道門......
	callout 1 echoat $n [1;35m你手上開始聚集一道純粹的魔法能量。[0m
	callout 1 echoaround $n [1;35m$n手上開始聚集一道純粹的魔法能量。[0m
	if rand(70)
		callout 2 echoat $n [1;37m你的魔法能量狠狠地轟開了這道門！[0m
		callout 2 rcall cool $n
		callout 2 modrvt d3 == 1
		callout 2 force 9458 modrvt d1 == 1
		callout 2 force 9458 echo 東邊的門被轟開了！
	else
		callout 2 echoat $n 你失敗了！
	endif
	break
  endif
  if str($n) >= 18
  	modhmv $n 03.5 8 00000000
	echoat $n 你退後兩三步，準備撞開這道門......
	echoaround $n $n退後兩三步，準備撞開這道門......
	callout 1 echoat $n [1;31m你開始往前猛衝！[0m
	callout 1 echoaround $n [1;31m$n開始往前猛衝！[0m
	if rand(70)
		callout 2 echoat $n [1;37m你用力撞開這道門！[0m
		callout 2 rcall cool $n
		callout 2 modrvt d3 == 1
		callout 2 force 9458 modrvt d1 == 1
		callout 2 force 9458 echo 東邊的門被撞開了！
	else
		callout 2 echoat $n 你失敗了！
	endif
	break
  endif
~
>room_defun cool~
if int($n) >= 16
	echoaround $n $n的開門魔法對這道門造成了
else
	echoaround $n $n的猛力一撞對這道門造成了
endif
	echoaround $n .               [5;1;31m化  成  齎  粉[0m
        echoaround $n .                   [5;1;31m灰  飛  湮  滅[0m的傷害！
	echo [1;37m門被打開了！[0m
~
