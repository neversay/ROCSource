>talk_prog topic~
  say 想要好好休息一下(rest)嗎？
~
>talk_prog rest~
  if ispc($n)
    	if is_qmark($n) & slum_libei_quest 10512
      		say 啊，原來你就是那個拯救我們貧民區的英雄！
      		say 這樣好了，我算你一塊錢就夠了。
      		bow $n
      		break
    	endif
    	mpechoat $n 旅館主人打量你全身上下......
    	if level($n) <= 7
      		say 不二價，五百史幣。
      		mpcall negotiate $n 
      		break
    	endif
    	if level($n) <= 14
      		say 不二價，一千史幣。
      		mpcall negotiate $n
      		break
    	endif
    	if level($n) <= 21
      		say 不二價，兩千史幣。
      		mpcall negotiate $n
      		break
    	endif
    	if level($n) <= 28
      		say 不二價，三千史幣。
      		mpcall negotiate $n
      		break
    	endif
    	if level($n) <= 35
      		say 不二價，五千史幣。
      		mpcall negotiate $n
      		break
    	endif
    	if level($n) <= 42
      		mpechoat $n 
      		mpechoat $n [1;37m婦人的眼中突然發出光芒。[0m
      		say 不二價，一萬史幣！
      		mpcall negotiate $n
    	endif
  endif
~
>defun_prog negotiate~
  if wis($n) >15
  or int($n) >19
  or resp($n) > 3
    	mpechoat $n 經過一陣討價還價之後，你終於砍掉一些價錢。
    	if level($n) <= 7
      		mpcallout 1 say 好啦，算你三百就好了。
      		break
    	endif
    	if level($n) <= 14
      		mpcallout 1 say 好啦，算你六百就好了。
      		break
    	endif
    	if level($n) <= 21
      		mpcallout 1 say 好啦，算你一千二就好了。
      		break
    	endif
    	if level($n) <= 28
      		mpcallout 1 say 好啦，算你一千八就好了。
      		break
    	endif
    	if level($n) <= 35
      		mpcallout 1 say 好啦，算你三千就好了。
      		break
    	endif
    	if level($n) <= 42
      		mpcallout 1 say 好啦，算你六千就好了。
      		mpcallout 2 mpechoat $n 你有一種進了黑店的感覺。
      		break
    	endif
  endif
~
