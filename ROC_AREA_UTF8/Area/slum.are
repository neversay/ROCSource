E
herb~
這裡有幾顆矮小的紫斑野草，你似乎可以將它拔出來(dig herb)。
~
>room_command dig default~
echoat $n 你要拔什麼？
~
>room_command dig herb~
if robjcount(9405) >= 2
	echoat $n 這裡的藥材似乎被你採完了。
	break
endif
if int($n) >= 15
or is_qmark($n) == slum_witch_herb
	if rand(50)
		oload 9405 1 $n floor
		echoat $n 你從地上拔出一顆紫斑野草。
		echoaround $n $n從地上拔出一顆紫斑野草。
		break
	endif
	echoat $n 你找了一會兒，卻什麼也沒找到。
	break
endif
echoat $n 你無法判斷這叢植物那一株能拔起來作藥。
~
>room_enter 15 30~
if hour($) == 14
	echo 你看到幾艘雙桅帆船遠遠駛來......
	callout 1 echo 一名水手登上船頭，大喊：「到貨啦！漁船讓道！」
	callout 2 echo 帆船群緩緩靠岸，準備卸貨。
endif
if hour($) > 14
	if hour($) <= 16
		echo 水手和搬運工成群結隊搬運貨物，經過你身邊。
		callout 1 echo 一群搬運工擔著重物走過。
		break
	endif
endif
if hour($) == 17
	echo 遠方帆船群起帆，離開港口了.....
	break
endif
if mobcount(9429) > 0
	if hour($) == 3
		echo 你看到一艘小黑船迅捷地靠岸。
		callout 1 echo 一群工人鬼鬼祟祟地登上小船......
		callout 2 echo 一群工人神經兮兮地搬著貨物進倉庫。
		break
	endif
	if hour($) == 4
		echo 你看到一艘小黑船快速地駛離港口，往下游而去。
		break
	endif
endif
if rand(50)
	echoat $n 一陣涼風吹來......
	break
endif
if hour($) > 9
	echoat $n 你聽到街道的紛擾，有如潮水般湧來。
	break
endif
echoat $n 街上冷冷清清，除了遠方幾聲狗吠，皆無人聲。
~
|
