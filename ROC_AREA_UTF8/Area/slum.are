#AREADATA
Name        巢穴貧民區~
Identity    slum~
Builders    Neversay~
Translator  ----~
Modifier    ----~
VNUMs	      9400 9499
Security    1
Recall      3001
F_toggle    0
End



#MOBILES
#9400
libei-slum~
貧民窟之王利拜(Libei)~
醜陋至極的貧民區之王利拜(Libei)顫抖地看著你。
~
一位醜陋不堪的老頭子，握著柺杖，留著口水，顫抖地看著你，他是這個區
域的地下統治者，也許你可以向他要一份工作(job)來作。
~
1|2|64|2048|67108864 8|32|128|512 0 S
1 700 300 10d10+-150 0d-150+0
-1 0
0 8 1
R Human~
C 2
P 8
>fight_prog 100~
  if is_qmark($n) != slum_all_enemy
    	mpadd_qmark $n slum_all_enemy 40 0 0 0 1 1
    	yell 不要欺人太甚！
    	c 'magic missile' $n 
  endif
  if rand(60)
  	say [1;36m恐---懼---的---總---和---！[0m
  	c 2 'magic missile' $n
  	mpechoat $n 你心中突然冒出一股莫名的恐懼！
  	mpforce $n flee
  	mpforce $n flee
  	mpforce $n flee
  endif
~
>all_greet_prog 100~
  if is_qmark($n) == slum_all_enemy
    	say 你要為你的暴行付出代價！
    	mpkill $n
    	break
  endif
  if is_qmark($n) != slum_libei_quest
  or is_qmark($n) == slum_libei_quest 300001
    	mpadd_qmark $n slum_libei_quest -1 0 0 1 0 1
    	say 歡迎光臨巢穴，冒險者，你需要工作(job)嗎？
    	break
  endif
  if level($n) >= 12
    	sigh
    	say 女兒呀......
  endif
~
>talk_prog topic~
  if is_qmark($n) != slum_libei_quest
  	mpadd_qmark $n slum_libei_quest -1 0 0 1 0 1
 	say 你好呀，冒險者，想要找工作(job)嗎？
	break
  endif
  if is_qmark($n) > slum_libei_quest 300001
	say 好好努力完成任務吧。
	break
  endif
  if is_qmark($n) == slum_libei_quest
	if is_qmark($n) & slum_libei_quest 100512
      		say 真是太感謝你了，巢穴的英雄$n。
		break
	endif
	if is_qmark($n) & slum_libei_quest 100256
	        say 啊，感謝你破除了我女兒身上的詛咒，$n。
		break
	endif
	if is_qmark($n) & slum_libei_quest 100128
	        say 謝謝你救了我唯一的寶貝，巢穴的英雄$n。
		break
	endif
	if is_qmark($n) & slum_libei_quest 100002
	        say 準備好要為我工作(job)了嗎？
		break
	endif
  endif
~
>talk_prog job~
  if is_qmark($n) == slum_libei_nojob
    	say 懶惰者！等我氣消了再說吧！
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300510
    	say 先把我交代的事情辦完再說吧。
    	break
  endif
  if is_qmark($n) & slum_libei_quest 100512
    	say 啊，你已經完成我能給你的所有任務了，謝謝你了，冒險者。
    	break
  endif
  if is_qmark($n) & slum_libei_quest 100002
    	if level($n) >= 12
      		if is_qmark($n) & slum_libei_quest 100128
        		say /*save slum1*/
        		say /*mpmod_qmark $n slum_libei_quest v2 | 256*/
        		say /*mpmod_qmark $n slum_libei_quest v1 | 1*/
        		say /*remove curse use eilien's qmark*/
        		say /*mpadd_qmark $n slum_libei_saveslum -1 1 0 0 0 1*/
        		break
      		endif
      		if is_qmark($n) & slum_libei_quest 100002     
        		mpechoat $n $I突然以嚴肅的眼光看著你。
        		mpcallout 1 say 冒險者呀，你可知失去與獲得的痛苦？
        		mpcallout 1 mpoload 9425 1
        		mpcallout 2 give secret $n
        		mpcallout 3 mpechoat $n $I低聲說：「去吧，冒險者，這個任務我只有信任你了。」
        		mpcallout 3 mpmod_qmark $n slum_libei_quest v2 | 128
        		mpcallout 3 mpmod_qmark $n slum_libei_quest v1 | 1
        		mpcallout 3 mpadd_qmark $n slum_libei_eilien -1 1 0 0 0 1
      		endif
      		break
    	endif
    	say 最近年紀大了，不大愛講長篇大論......
    	mpechoat $n $I將手伸進袖子裡，開始找東西......
    	if rand(20)
      		mpoload 9420 1
      		mpmod_qmark $n slum_libei_quest v2 | 4
      		mpcallout 1 mpcall job_1 $n
		break
    	endif
    	if rand(25)
      		mpoload 9421 1
      		mpmod_qmark $n slum_libei_quest v2 | 16
      		mpcallout 1 mpcall job_1 $n
		break
    	endif
    	if rand(33)
      		mpoload 9422 1
      		mpmod_qmark $n slum_libei_quest v2 | 64
      		mpcallout 1 mpcall job_1 $n
		break
    	endif
    	if rand(50)
      		mpoload 9423 1
      		mpmod_qmark $n slum_libei_quest v2 | 8
      		mpcallout 1 mpcall job_1 $n
		break
    	endif
    	mpoload 9424 1
    	mpmod_qmark $n slum_libei_quest v2 | 32
    	mpcallout 1 mpcall job_1 $n
    	break
  endif
  mpadd_qmark $n slum_libei_quest -1 1 0 0 0 1
  mpmod_qmark $n slum_libei_quest v2 | 2
  mpechoat $n $I睜起一隻眼，左右打量你......
  say 嗯，我看你資質還不錯，應該是可以託付重任的人。
  say 這樣吧，你先到上面，找依普西隆(epsilon)，要他跟你介紹巢穴的
  say 大略地理環境(environment)吧！
  mpecho $I又想了一下......
  mpcallout 1 say 如果聽完介紹，記得回來報備(complete)一聲。
~
>defun_prog job_1~
      say 這封信拿去吧，裡面已經詳細交代一切了。
      give mail $n
      break
~
>talk_prog complete~
  if is_qmark($n) & slum_libei_quest 100002
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300002
    	if is_qmark($n) & slum_libei_quest 200002
      		mpmod_qmark $n slum_libei_quest v0 | 2
      		mpmod_qmark $n slum_libei_quest v1 = 0
      		mpmod_qmark $n slum_libei_quest v2 = 0
      		say 很好，看來你已經有替我辦事的能力與認知了，現在，如果你需要
      		say 工作(job)，就跟我說吧。
      		mpexp $n 200
      		mpgold $n 3000
    	endif
  endif
~
>talk_prog restart~
  mpechoat $n 你跟$I取消正在進行中的任務。
  mpechoaround $n $N跟$I取消任務。
  if is_qmark($n) == slum_libei_deny
    	say 不行，你重新任務的頻率太頻繁了，等一下再說吧。
    	say 我不會雇用懶惰者的。
    	break
  endif
  if is_qmark($n) & slum_libei_quest 300124
    	mpmod_qmark $n slum_libei_quest v2 r 124
	mpdel_qmark $n slum_str_quest
	mpdel_qmark $n slum_dex_quest
	mpdel_qmark $n slum_int_quest
	mpdel_qmark $n slum_wis_quest
	mpdel_qmark $n slum_con_quest
    	mpmod_qmark $n slum_libei_quest v1 = 0
    	mpadd_qmark $n slum_libei_deny 10 1 0 0 1 1
    	say 好，任務重新開始。
  endif
  if is_qmark($n) & slum_libei_quest 300128
    	mpmod_qmark $n slum_libei_quest v2 r 128
	mpdel_qmark $n slum_libei_eilien
    	say 好，那請你再重新拯救我女兒吧。
  endif
  if is_qmark($n) & slum_libei_quest 300512
    	mpmod_qmark $n slum_libei_quest v2 r 256
	mpdel_qmark $n slum_libei_saveslum
    	say 好，請你再重新保衛巢穴一次吧。
  endif
~
>talk_prog epsilon~
  if is_qmark($n) > slum_libei_quest 100002
    	say 你不是知道他了嗎？就是樓上那位呀。
    	break
  endif
  say 在入口彈琴說故事的就是了。
~
