>room_time 100~
  if hour($) == 14
    	echo 雙桅帆船群緩緩靠向史卡拉貝貧民區的港口......
    	echo 一名水手大喊：「到岸啦，準備卸貨！」
    	force 9453 echo 一名水手大喊：「到岸啦，準備卸貨！」
    	echo 水手將船版降了下去，讓港口工人上來搬運。
	makedoor 0 貧民區港口 door 0 0 9439
	break
  endif
  if hour($) == 15
  or hour($) == 16
    	echo 你看見搬運工上船來，忙著將貨物搬下去。
    	break
  endif
  if hour($) == 17
    	echo 水手將船錨收了上來。
    	echo 一陣騷亂，水手們將船帆升了起來。
    	echo 一名水手大喊：「準備啟航啦！」
    	force 9453 echo 一名水手大喊：「準備啟航啦！」
    	echo 雙桅帆船群緩緩駛離史卡拉貝貧民區港口......
	deldoor 0
    	break
  endif
  if hour($) == 2
    	echo 雙桅帆船群緩緩靠向望鄉港港阜。
    	echo 一名水手大喊：「到岸啦，準備裝貨！」
    	force 9453 echo 一名水手大喊：「到岸啦，準備裝貨！」
    	echo 水手將船版降了下去，讓港口工人搬貨上來。
    	break
  endif
  if hour($) == 3
  or hour($) == 4
    	echo 你看見搬運工忙著將貨物搬上來。
    	break
  endif
  if hour($) == 5
    	echo 水手將船錨收了上來。
    	echo 一陣騷亂，水手們將船帆升了起來。
    	echo 一名水手大喊：「準備啟航啦！」
    	force 9453 echo 一名水手大喊：「準備啟航啦！」
    	echo 雙桅帆船群緩緩駛離望鄉港。
    	break
  endif
  if rand(50)
    	echo 船沿著史卡拉貝河航行著，四周壯麗的風光盡收眼底。
    	break
  endif
  echo 幾隻不知名的水鳥悠悠飛過船弦左右，再倏忽飛離。
~
>room_command survey view~
  if hour($) == 0
  or hour($) == 1
    	echoat $n [1;33m這艘船順著史卡拉貝河航行，兩旁原始的黑森林不時傳來騷動聲。[0m
    	break
  endif
  if hour($) >= 14
    	if hour($) <= 17
      		echoat $n [1;36m這艘船目前停泊在史卡拉貝貧民區，眼前的景象是一片髒亂。[0m
      		break
    	endif
      	echoat $n [1;33m這艘船順著史卡拉貝河航行，兩旁原始的黑森林不時傳來騷動聲。[0m
      	break
  endif
  if hour($) >= 2
    	if hour($) <= 5
      		echoat $n [1;31m這艘船目前停泊在望鄉港，深夜散發紅暈的大地只能讓你看到城鎮大概的輪廓。[0m
      		rcall moon $n
    		break
    	endif
  endif
  echoat $n [1;33m這艘船沿著史卡拉貝河逆流而上，兩旁原始的黑森林不時傳來騷動聲。[0m
~
>room_defun moon~
  if day($) <= 11
    	echoat $n [1;31m你也看到上弦月掛在夜空中，散發著淒冷的紅光。[0m
	break
  endif
  if day($) <= 23
    	echoat $n [1;31m你也看到美麗的滿月掛在夜空中，散發著飽滿的紅暈。[0m
	break
  endif
  echoat $n [1;31m你也看到下弦月懸在夜空中，散發著詭異的紅光。[0m
  break
~
