		break
        endif
  	if hour($) > 5
    		echoat $n [1;32m你看到遠方街上熱鬧非凡，夏天的氣息讓萬物欣欣向榮。[0m
  	endif
	break
endif
if month($) <= 12
  	if hour($) <= 5
  	or hour($) >= 21
    		echoat $n [1;36m你看到遠方秋風吹起，冷夜寒星讓街道顯得空曠寂寞，[0m
    		rcall moon $n
		break
  	endif
        if hour($) > 16
                echoat $n [1;33m圓扁的太陽緩緩降入群山間，微寒的秋日讓你感傷莫名。[0m
		break
        endif
  	if hour($) > 5
    		echoat $n [1;36m你看到遠方街上眾人事務繁忙，忙著儲糧過冬。[0m
	ebdif
	break
endif
  if hour($) <= 5
  or hour($) >= 21
    	echoat $n [1;37m你看到街上大雪剛停，大雪夜的寒意讓你不禁縮著脖子吐氣，[0m
    	rcall moon $n
	break
  endif
  if hour($) > 16
        echoat $n [1;31m凜冽的冬風將黃昏的垂陽吹得毫無熱度，只看到微弱的紅火降下大地。[0m
	break
  endif
  if hour($) > 5
    	echoat $n [1;37m你看到遠方街上眾人皆裹著大衣厚服而行，毫無暖意的太陽晾在天空。[0m
  endif
~
>room_defun moon~
  if day($) == 0
    	echoat $n [1;36m天空灑滿銀星，不見紅月。[0m
	break
  endif
  if day($) <= 11
    	echoat $n [1;31m你也看到上弦月掛在夜空中，散發著淒冷的紅光。[0m
	break
  endif
  if day($) <= 23
    	echoat $n [1;31m你也看到美麗的滿月掛在夜空中，散發著飽滿的紅暈。[0m
	break
  endif
  	echoat $n [1;31m你也看到下弦月懸在夜空中，散發著詭異的紅光。[0m
	break
~
