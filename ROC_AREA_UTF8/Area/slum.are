		break
        endif
  	if hour($) > 5
    		echoat $n [1;32m你看到遠方街上熙熙攘攘，活潑的春天氣氛也傳進了宅院。[0m
  	endif
	break
endif
if month($) <= 8
  	if hour($) <= 5
