	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == ofcol_anc_eq 100001
	mpadd_qmark self talking
	mpcallout 3 mpdel_qmark self talking
	mpdel_qmark $n ofcol_anc_eq
	if is_qmark($n) == commerce_subquest
		mpmod_qmark $n commerce_subquest v0 | 8
	else
		mpadd_qmark $n commerce_subquest -1 8 0 0 0 1
	endif
	tell $n 也對...我穿成這樣你當然會認不出來。
	mpcallout 1 tell $n 總之，上次多虧有你幫忙，讓我避免掉一些不必要的麻煩。
	mpcallout 2 tell $n 還真想不到你會是這裡的會員呢....
	mpcallout 2 tell $n 不過呀，人還真不可貌相呢。
	mpcallout 3 ponder
	mpcallout 4 tell $n 我就特例也賣你，當作是答謝。
	mpcallout 4 tell $n 這樣好了，我這有些幫 V.I.P. 特別備的貨。
	mpcallout 5 giggle
	mpcallout 5 tell $n 但就算私下有交情，生意上的價格也不能少喔！
endif
