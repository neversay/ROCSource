	mpechoat $n 你還沒蒐集到的龍晶有：
	if is_qmark($n) !& commerce_crystal_quest 200001
		mpechoat $n [1;31m紅龍晶(crystal of red dragon)[0m
	endif
	if is_qmark($n) !& commerce_crystal_quest 200002
		mpechoat $n [1;30m黑龍晶(crystal of black dragon)[0m
	endif
	if is_qmark($n) !& commerce_crystal_quest 200004
		mpechoat $n [1;37m白龍晶(crystal of white dragon)[0m
	endif
	if is_qmark($n) !& commerce_crystal_quest 200008
		mpechoat $n [1;32m綠龍晶(crystal of green dragon)[0m
	endif
	if is_qmark($n) !& commerce_crystal_quest 200016
		mpechoat $n [1;36m藍龍晶(crystal of blue dragon)[0m
	endif
else
	mpmod_qmark $n commerce_crystal_quest v0 = 3
	smile
	mpcallout 1 say 材料終於齊全了，我立刻著手打造寶石！
	mpcallout 2 mpecho $I將寶石放到車床上打磨......
	mpcallout 3 mpecho 車床傳來尖銳的摩擦聲......
	mpcallout 5 mpecho 車床傳來尖銳的摩擦聲......
	mpcallout 7 mpecho 車床傳來尖銳的摩擦聲......
	mpcallout 9 mpecho 車床傳來尖銳的摩擦聲......
	mpcallout 10 mpoload 35020 $n viclv target
	mpcallout 10 say 終於完成了！
	mpcallout 11 mpecho $I將五色龍晶對準太陽，細細察看......
	mpcallout 12 sigh
	mpcallout 13 shake
	mpcallout 14 say 這並不是我想要的「五色龍魂」。
	mpcallout 15 mpechoat $n $I將寶石交給了你。
	mpcallout 16 say 這顆寶石很漂亮，但是沒有「魂魄」(soul)，不是我所要的。
	mpcallout 17 say 這顆寶石就送給你吧，我再想辦法吧。
endif
