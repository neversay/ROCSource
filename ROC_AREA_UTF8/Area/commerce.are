10 0 0 0d0+-100 0d0+0
0 0
0 8 1
P 1|8|128|16384
>talk_prog topic~
if level($n) <= 40
	tell $n 等你有充足的歷練，再來跟我交易吧。
	break
endif
tell $n 你看起來是個厲害的冒險者，想來筆交易嗎？(trade)
~
>talk_prog p trade~
if level($n) <= 40
	break
endif
tell $n 這裡交易的物品不是黃金也不是白銀，而是靈魂。
tell $n 我能幫你把靈魂實體化作為寶石，只要讓我從中抽取一些作為代價就行。
tell $n 有興趣嗎？(yes)
~
>talk_prog p yes~
if isnpc($n)
	break
endif
if level($n) <= 40
	break
endif
tell $n 製作一個基本的靈魂寶石需要 4 點練習點數及工本費一萬元。(sell my soul)
tell $n 製作一個較大的靈魂寶石需要 40 點練習點數及工本費十萬元。(sell huge soul)
tell $n 製作一個巨大的靈魂寶石需要 400 點練習點數及工本費一百萬元。(sell great soul)
tell $n 如果持有過多的靈魂寶石，我能免費把寶石作成大顆(larger)點的。
tell $n 想作什麼交易，直接跟我說就能開始了。
~
>talk_prog p larger~
if level($n) <= 40
	break
endif
tell $n 每十個靈魂寶石，能混合成一個較大顆的。(mix to huge)
tell $n 每十個較大顆的，能混合成一個非常大顆的。(mix to great)
tell $n 雖然靈魂的總量不變，但這行為是不可逆的，沒辦法變小。
tell $n 只要你身上帶有足夠的數量，直接跟我說要怎麼作就行。
~
>talk_prog p sell my soul~
if level($n) <= 40
	break
endif
if cancarry($n) < 1
	mpechoat $n 你拿不動更多東西了.
	break
endif
if practice($n) < 4
	tell $n 你的練習點數不夠。
	break
endif
if goldamt($n) < 10000
	tell $n 你帶的錢不夠勒。
	break
endif
mpechoat $n $I把你的靈魂抽取出來化作實體。
mpechoat $n $I給了你靈魂寶石(Soul Gem).
mppractice $n -4
mpgold $n -10000
mpoload 35121 $n 1 target
~
>talk_prog p sell huge soul~
if level($n) <= 40
	break
endif
if cancarry($n) < 1
	mpechoat $n 你拿不動更多東西了.
	break
endif
