	if is_qmark($i) <= ped_herbs 300020
		if rand(30)
			mpmod_qmark self ped_herbs v2 + 1
			mpecho $I跟人買了一株草藥。
		endif
	endif
endif
if area($i) == shire
	mpcall herb_sell peddler-comm-travel
	mpcall things_sell_1 peddler-comm-travel
	if is_qmark($i) & ped_weapon_making 100002
		if is_qmark($i) !& ped_things 100002
			mpmod_qmark self ped_weapon_making v0 r 2
			mpmod_qmark self ped_things v0 | 2
			mpecho $I委託別人製作東西。
		endif
	endif
	if is_qmark($i) & ped_weapon_making 100004
		if is_qmark($i) !& ped_things 100004
			mpmod_qmark self ped_weapon_making v0 r 4
			mpmod_qmark self ped_things v0 | 4
			mpecho $I委託別人製作東西。
		endif
	endif
endif
