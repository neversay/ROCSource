		mpgold $n 200000
		mpcall resp_gold $n
		break
	endif
	if level($n) <= 25
		tell $n 依照你的等級你可以領到 250000 元的金幣。
		mpgold $n 250000
		mpcall resp_gold $n
		break
	endif
	if level($n) <= 30
		tell $n 依照你的等級你可以領到 300000 元的金幣。
		mpgold $n 300000
		mpcall resp_gold $n
		break
	endif
	if level($n) <= 35
		tell $n 依照你的等級你可以領到 370000 元的金幣。
