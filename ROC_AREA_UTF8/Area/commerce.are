>talk_prog cancel~
if is_qmark($n) == commerce_enemy
	tell $n 由於你已經退出公會了，就算完成任務也沒辦法領取獎賞。
	tell $n 所以我這就直接幫你把任務取消。
	mpechoat $n $I把你的名字從任務記錄本上刪去。
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpdel_qmark $n adv_do_mission
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_do_mission_3
else
	if is_qmark($n) == adv_do_mission_2 300002
		tell $n 取消當前任務需要酌收費用１０萬金幣，直接把錢交給我就可以完成取消了。
		break
	endif
	if is_qmark($n) == adv_mission_failed
		tell $n 有人回報說你執行的任務失敗了。
		if goldamt($n) > 100000
			mpdel_qmark $n adv_mission_failed
			mpdel_qmark $n adv_mission_mark
			mpcallout 1 mpgold $n -100000
			mpcallout 1 tell $n 那麼...公會將收取１０萬金幣作為遮羞費。
		else
			tell $n 不過你身上的錢帶不夠，所以沒辦法幫你取消任務。
		endif
	else
		if is_qmark($n) == adv_mission_mark
			tell $n 取消當前任務需要酌收費用１０萬金幣，直接把錢交給我就可以完成取消了。
		else
			break
		endif
	endif
endif
~
>talk_prog failed~
if is_qmark($n) == adv_mission_failed 100004
	if goldamt($n) > 100000
		mpechoat $n 你向公會的櫃檯報告任務失敗了...
		mpdel_qmark $n adv_mission_failed
		mpdel_qmark $n adv_mission_mark
		mpcallout 1 tell $n 你連那麼簡單的任務都會失敗...這要公會的顏面往哪擺呀？
		mpcallout 1 gasp $n
		mpcallout 2 sigh
		mpcallout 3 mpgold $n -100000
		mpcallout 3 mpechoat $n 櫃檯小姐用纖細的小手壓著你簽了一張１０萬金幣的本票。
		mpcallout 3 tell $n 那麼...公會將收取１０萬金幣作為遮羞費。
	else
		tell $n 等錢準備好了我再來聽你懺悔！
	endif
endif
if is_qmark($n) == adv_mission_failed 100008
	if goldamt($n) > 100000
		mpechoat $n 你向公會的櫃檯轉達侍女的說法...
		mpdel_qmark $n adv_mission_failed
		mpdel_qmark $n adv_mission_mark
		mpcallout 1 mpechoat $n $I嘟著小嘴，生氣地瞪著你。
		mpcallout 1 tell $n 笨蛋笨蛋大笨蛋！！！
		mpcallout 2 tell $n 你到底懂不懂少女纖細的內心呀？！
		mpcallout 3 mpgold $n -100000
		mpcallout 3 mpechoat $n 櫃檯小姐丟下一張１０萬金幣的本票，轉頭對你生悶氣。
	else
		tell $n 等錢準備好了我再來聽你懺悔！
	endif
endif
if is_qmark($n) == adv_mission_failed 200001
	if goldamt($n) > 100000
		mpechoat $n 你向公會的櫃檯轉達魔法屋的說法...
		mpdel_qmark $n adv_mission_failed
		mpdel_qmark $n adv_mission_mark
		mpcallout 1 ponder
		mpcallout 2 smirk
		mpcallout 2 tell $n 還以為你是個高手，沒想到那麼弱。
		mpcallout 3 mpgold $n -100000
		mpcallout 3 mpechoat $n 櫃檯小姐指了指桌上１０萬金幣的本票，示意要你簽下去。
	else
		tell $n 等錢準備好了我再來聽你懺悔！
	endif
endif
~
>bribe_prog 100000~
if is_qmark($n) == adv_do_mission_2 300002
	tell $n 好的，剛好委託人也將任務取消了。
	mpechoat $n $I把你的名字從任務記錄本上刪去。
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpdel_qmark $n adv_do_mission_2
	break
endif
if is_qmark($n) == adv_quest_object
	mpdel_qmark $n adv_quest_object
	tell $n 要記得，以後跟別人借的東西要保管好！
endif
if is_qmark($n) == adv_mission_failed
	mpdel_qmark $n adv_mission_failed
	mpdel_qmark $n adv_mission_mark
	tell $n 知道自己任務失敗要乖乖繳錢
	tell $n 看不出來你還滿有長進的嘛～
else
	if is_qmark($n) == adv_mission_mark
		tell $n 好的，這就幫你取消任務。
		mpechoat $n $I把你的名字從任務記錄本上刪去。
		mpdel_qmark $n adv_mission_mark
		mpdel_qmark $n adv_do_mission
		mpdel_qmark $n adv_do_mission_2
		mpdel_qmark $n adv_do_mission_3
	else
		gasp $n
		tell $n 給我這麼大一筆錢幹嘛？你該不會是暗戀我吧？
		mpcallout 1 look $n
		mpcallout 2 tell $n 抱歉，你是個好人，可以找到更好的對象。
		mpcallout 2 niceman $n
		mpcallout 3 bow $n
		mpcallout 3 tell $n 但還是謝謝你的贊助，錢我就收下囉！^_^
	endif
endif
~
>give_prog all~
tell $n 你給我這個幹嘛？
mpechoat $n $I將東西摔出櫃檯...
drop $o
