>give_prog 35099~
if goldamt($n) >= 2000000000
	tell $n 你持有太多的錢，已經裝不下更多錢了。
	mpjunk $o
	mpechoat $n $I將金條退還給你。
	mpoload 35099 $n 1 target
	break
endif
mpcall au_pur_pay $n
if rand(90)
	if is_qmark($i) > au_price_count 100000
		mpmod_qmark self au_price_count v0 - 1
	endif
endif
if rand(30)
	if is_qmark($i) > au_price_count 100000
		mpmod_qmark self au_price_count v0 - 1
	endif
endif
if rand(95)
	mpmod_qmark self au_price_count v1 - 1
endif
if rand(30)
	mpmod_qmark self au_price_count v1 - 1
endif
if is_qmark($i) > au_item_purchase 100000
	mpmod_qmark self au_item_purchase v0 - 1
endif
tell $n 謝謝惠顧。
bow $n
mpjunk $o
~
>give_prog all~
if goldamt($n) >= 2000000000
	tell $n 你持有太多的錢，已經裝不下更多錢了。
	give $o $n
	drop $o
	break
endif
if material($o) == gold
	if is_qmark($i) == au_item_purchase 100000
		tell $n 目前我們不缺黃金製品了。
		sorry $n
		give $o $n
		drop $o
		break
	else
		mpgold $n 100000
		tell $n 謝謝惠顧。
		if is_qmark($i) > au_item_purchase 100000
			mpmod_qmark self au_item_purchase v0 - 1
		endif
		if rand(70)
			if is_qmark($i) > au_price_count 200000
				mpmod_qmark self au_price_count v1 - 1
			endif
		endif
		if rand(50)
			mpmod_qmark self au_price_count v1 - 1
		endif
		mpjunk $o
	endif
else
	tell $n 我們不收這種東西。
	give $o $n
	drop $o
endif
~
