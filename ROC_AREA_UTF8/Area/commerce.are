	or is_qmark($n) !& ianua_quest 100002
		mpadd_qmark $n ianua_quest -1 0 0 0 0 1
		mpmod_qmark $n ianua_quest v0 | 1
		mpmod_qmark $n ianua_quest v0 | 2
	endif
	mpechoat $n $I用星之碎片作成兩顆傳送者之石(teleport stone)給你。
	mpoload 13204 $n 1 target
	mpoload 13204 $n 1 target
	mpjunk $o
	break
endif
