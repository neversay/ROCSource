#35098
mounts~
牧場契約(mounts)~
一張牧場契約(mounts)被放置在這裡。~
~
12 1|8|64|256|4194304 1
0~ 0~ 0~ 0~
0 200000 0
Z 4
E
mounts~
這是一張你跟牧場的契約，你可以從上面確認(check)合約內容。
~
X paper~
>obj_command check default~
echoat $n 牧場契約(mounts) - [1;33m紙質(paper)[0m
echoat $n 這是一張牧場的合同，領取輸入(hreceive mounts 下列名稱)。
echoat $n 你在牧場中所持有的座騎：
echoat $n 　
if objval3($o) & 1
	echoat $n 　輕型戰馬(light-cavalry-horse)
endif
if objval3($o) & 2
	echoat $n 　重型戰馬(heavy-cavalry-horse)
endif
if objval3($o) & 4
	echoat $n 　幽靈戰馬(ghost-cavalry-horse)
endif
if objval3($o) & 8
	echoat $n 　冬狼(snow-wolf)
endif
if objval3($o) & 16
	echoat $n 　厄運流星戰駒(misfortune-meteor-warhorse)
endif
if objval3($o) & 32
	echoat $n 　大型兇暴狼(dire-wolf)
endif
if objval3($o) & 64
	echoat $n 　魔導機獸(machine-beast)
endif
if objval3($o) & 128
	echoat $n 　金羽鳳凰(golden-feather-phoenix)
endif
if objval3($o) & 256
	echoat $n 　[1;30m殺人熊[0m(blood-thirsty-bear)
endif
if objval3($o) & 512
	echoat $n 　[1;31m真‧殺人熊[0m(super-blood-thirsty-bear)
endif
if objval3($o) & 1024
	echoat $n 　[1;31m聖誕[0m[33m馴鹿[0m(Christmas-Reindeer)
endif
echoat $n 　
~
>obj_command hstore default~
if inroom($n) == 35048
	if is_equ_obj($n) == 10679
	or is_equ_obj($n) == 10680
	or is_equ_obj($n) == 37117
	or is_equ_obj($n) == 38267
	or is_equ_obj($n) == 64143
	or is_equ_obj($n) == 66111
	or is_equ_obj($n) == 70855
	or is_equ_obj($n) == 70937
	or is_equ_obj($n) == 70939
	or is_equ_obj($n) == 71000
	or is_equ_obj($n) == 11091
		if goldamt($n) >= 1000000
			if is_equ_obj($n) == 10679
				if objval3($o) !& 1
					oset self value3 | 1
					oforce $n ride
					oforcer here force light-h visible
					oforce light-h drop all
					echoat $n 你將輕型戰馬(light cavalry horse)交給緋珮絲(Fiapeyth)照顧。
					oforce light-h mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 10680
				if objval3($o) !& 2
					oset self value3 | 2
					oforce $n ride
					oforcer here force heavy-h visible
					oforce heavy-h drop all
					echoat $n 你將重型戰馬(heavy cavalry horse)交給緋珮絲(Fiapeyth)照顧。
					oforce heavy-h mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 37117
				if objval3($o) !& 4
					oset self value3 | 4
					oforce $n ride
					oforcer here force ghosthorse-h visible
					oforce ghosthorse-h drop all
					echoat $n 你將幽靈戰馬(ghost cavalry horse)交給緋珮絲(Fiapeyth)照顧。
					oforce ghosthorse-h mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 38267
				if objval3($o) !& 8
					oset self value3 | 8
					oforce $n ride
					oforcer here force wolf2-labyrinth visible
					oforce wolf2-labyrinth drop all
					echoat $n 你將冬狼(snow wolf)交給緋珮絲(Fiapeyth)照顧。
					oforce wolf2-labyrinth mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 64143
				if objval3($o) !& 16
					oset self value3 | 16
					oforce $n ride
					oforcer here force met-rebelsp visible
					oforce met-rebelsp drop all
					echoat $n 你將厄運流星戰駒(misfortune meteor warhorse)交給緋珮絲(Fiapeyth)照顧。
					oforce met-rebelsp mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 66111
				if objval3($o) !& 32
					oset self value3 | 32
					oforce $n ride
					oforcer here force dire-mob2 visible
					oforce dire-mob2 drop all
					echoat $n 你將大型兇暴狼(dire wolf)交給緋珮絲(Fiapeyth)照顧。
					oforce dire-mob2 mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 70855
				if objval3($o) !& 64
					oset self value3 | 64
					oforce $n ride
					oforcer here force soul-s visible
					oforce soul-s drop all
					echoat $n 你將魔導機獸(machine beast)交給緋珮絲(Fiapeyth)照顧。
					oforce soul-s mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經托育一名小女孩在裡面了。
				endif
			endif
			if is_equ_obj($n) == 70937
				if objval3($o) !& 128
					oset self value3 | 128
					oforce $n ride
					oforcer here force phoenix-is visible
					oforce phoenix-is drop all
					echoat $n 你將金羽鳳凰(golden feather phoenix)交給緋珮絲(Fiapeyth)照顧。
					oforce phoenix-is mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 70939
				if objval3($o) !& 256
					oset self value3 | 256
					oforce $n ride
					oforcer here force realbear2-is visible
					oforcer here force bear2-is drop all
					echoat $n 你將[1;30m殺人熊[0m(blood-thirsty bear)交給緋珮絲(Fiapeyth)照顧。
					oforcer here force bear2-is mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 71000
				if objval3($o) !& 512
					oset self value3 | 512
					oforce $n ride
					oforcer here force realbear2-is visible
					oforcer here force realbear2-is drop all
					echoat $n 你將[1;31m真‧殺人熊[0m(super blood-thirsty bear)交給緋珮絲(Fiapeyth)照顧。
					oforcer here force realbear2-is mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
			if is_equ_obj($n) == 11091
				if objval3($o) !& 1024
					oset self value3 | 1024
					oforce $n ride
					oforcer here force Reindeer-horse-xmas visible
					oforcer here force Reindeer-horse-xmas drop all
					echoat $n 你將[1;31m聖誕[0m[33m馴鹿[0m(Christmas Reindeer)交給緋珮絲(Fiapeyth)照顧。
					oforcer here force Reindeer-horse-xmas mppurge self
					oforce fiapeyth-comm mpgold $n -1000000
				else
					echoat $n 你已經寄養一隻這種座騎在裡面了。
				endif
			endif
		else
			oforce fiapeyth-comm tell $n 你身上的錢不夠囉。
		endif
	else
		oforce fiapeyth-comm tell $n 抱歉，無法受理呦。
	endif
else
	echoat $n 什麼？
endif
~
>obj_command hreceive p light-cavalry-horse~
if inroom($n) == 35048
	if objval3($o) & 1
		oset self value3 r 1
		oforcer here mload 10654
		oforcer here force light-h visible
		echoat $n 緋珮絲(Fiapeyth)將輕型戰馬(light cavalry horse)牽還給你。
		echoaround $n 緋珮絲(Fiapeyth)將輕型戰馬(light cavalry horse)牽還給$N。
		oforce light-h mpdef_rembch $n
		oforce light-h follow $n
	else
		echoat $n 你在牧場中沒有這隻座騎。
	endif
else
	echoat $n 什麼？
endif
~
>obj_command hreceive p heavy-cavalry-horse~
if inroom($n) == 35048
	if objval3($o) & 2
		oset self value3 r 2
