>give_prog 35052~
if is_qmark($n) & adv_quest_object 100016
	if is_qmark($n) & adv_quest_object 100001
		mpechoat $n 你如實回報看過的內容。
		mpcallout 1 tell $n 你..你這個意思是說我..我看不懂囉？！！
		mpcallout 1 mpechoat $n $I漲紅臉並激動的對你大聲說：
		mpcallout 2 tell $n 這...這一切都要怪他的字寫得太醜了！！！
		mpcallout 2 tell $n 我當然知道這是奧夫卡文！人..人家怎麼可能會看不懂！
		mpcallout 3 mpechoat $n $I發現自己的表現失態後，努力壓抑情緒跟你說。
		mpcallout 4 tell $n 嗯....算..算了，這些都不重要，總之你有打算要接下的話再跟我說喔！
		mpcallout 5 mpechoat $n $I轉過頭去忙自己的事了。
		mpcallout 6 sting $n
		mpdel_qmark $n adv_quest_object
		mpjunk letter-receptionist
	else
		mpechoat $n 你如實回報看過的內容。
		mpcallout 1 tell $n 對吧！！我就說他的字寫得很醜，完全不知道他想表達什麼。
		mpcallout 2 hmm
		mpcallout 3 tell $n 算要接下來的話，再跟我說喔。
		mpcallout 3 tell $n 面對這種委託人線索過少連是不是惡作劇都不清楚的困難任務，如果你還是打
		mpcallout 4 addoil $n
		mpcallout 4 tell $n 畢竟要有適當的考驗才會有所成長！
		mpdel_qmark $n adv_quest_object
		mpjunk letter-receptionist
	endif
endif
~
>talk_prog prescription~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 200001
			if class($n) == 11
			or class($n) == 12
			or class($n) == 17
			or class($n) == 18
			or class($n) == 19
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 這是由商會廣場上專門賣魔法藥品的店家所委託的任務。他們希望公會能派出
				tell $n 具備用藥〝常識〞的冒險者幫忙他們尋找一些藥物，用作新配方的參考。
				tell $n 而關於酬勞的部分，對方開價３０萬金幣。
				mpcallout 1 look $n
				mpcallout 2 ponder
				mpcallout 3 tell $n 良好的對策可以應付委託人！所以你想要接受這個任務也是沒問題的喔！
				mpcallout 3 tell $n 雖然你看起來不像具有藥品〝常識〞的冒險者....不過關於這點公會也有
				mpcallout 4 tell $n 但是呢～
				mpcallout 5 smile $n
				mpcallout 5 tell $n 任務如果不幸失敗的話，還是要記得繳交罰金喔！^_^
			endif
			if class($n) == 5
			or class($n) == 14
			or class($n) == 15
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 這是由商會廣場上專門賣魔法藥品的店家所委託的任務。他們希望公會能派出
				tell $n 具備用藥〝常識〞的冒險者幫忙他們尋找一些藥物，用作新配方的參考。
				tell $n 而關於酬勞的部分，對方開價３０萬金幣。
				mpcallout 1 look $n
				mpcallout 2 ponder
				mpcallout 3 tell $n 一些奇怪的東西熬煮，像是指甲、頭髮、老鼠尾巴、蝙蝠翅膀之類的....
				mpcallout 3 tell $n 這個任務對你來說應該很容易吧！畢竟你在對人下詛咒的時候也常會收集
				mpcallout 4 mpechoat $n $I腦補了一下，突然覺得你陰沉的可怕....
				mpcallout 5 tell $n 所...所以這對你應該不算什麼大不了的問題！
			endif
			if class($n) == 6
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 這是由商會廣場上專門賣魔法藥品的店家所委託的任務。他們希望公會能派出
				tell $n 具備用藥〝常識〞的冒險者幫忙他們尋找一些藥物，用作新配方的參考。
				tell $n 而關於酬勞的部分，對方開價３０萬金幣。
				mpcallout 1 mpechoat $n $I捏著鼻子打量著你。
				mpcallout 2 tell $n 光從你一身的藥味就知道這個任務根本難不倒你。
				mpcallout 3 mpechoat $n $I捏著鼻子揮了揮手，示意要你快點離開。
			endif
			if class($n) == 7
			or class($n) == 8
			or class($n) == 13
			or class($n) == 16
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 這是由商會廣場上專門賣魔法藥品的店家所委託的任務。他們希望公會能派出
				tell $n 具備用藥〝常識〞的冒險者幫忙他們尋找一些藥物，用作新配方的參考。
				tell $n 而關於酬勞的部分，對方開價３０萬金幣。
				mpcallout 1 look $n
				mpcallout 3 addoil $n
				mpcallout 3 tell $n 適合交給你解決！
				mpcallout 3 tell $n 身為神院出來的你，應該有學習過藥物基本的知識，我認為這個任務會很
			endif
			if class($n) == 9
			or class($n) == 10
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 這是由商會廣場上專門賣魔法藥品的店家所委託的任務。他們希望公會能派出
				tell $n 具備用藥〝常識〞的冒險者幫忙他們尋找一些藥物，用作新配方的參考。
				tell $n 而關於酬勞的部分，對方開價３０萬金幣。
				mpcallout 1 look $n
				mpcallout 2 ponder
				mpcallout 3 tell $n 清楚毒跟藥差在哪，不過製毒跟製藥應該都是差不多的東西吧....
				mpcallout 3 tell $n 呃....時常下毒的你，對於製作這類的東西應該也很擅常吧？雖然我也不
			endif
		else
			break
		endif
	else
		break
	endif
else
	break
endif
~
>talk_prog p accept 06~
if is_qmark($n) != adv_quest_object
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) != adv_mission_mark
			if is_qmark($n) !& adv_mission_complete 200001
				mpadd_qmark $n adv_mission_mark -1 0 1 0 0 1
				tell $n 好的，我立即幫您登記上此任務。
				mpechoat $n $I翻開了桌上的任務記錄本將你的名字登記上去。
				if class($n) == 11
				or class($n) == 12
				or class($n) == 17
				or class($n) == 18
				or class($n) == 19
					tell $n 跟魔法屋的老闆說你是冒險者公會(adventurer guild)派來的。
					tell $n 不用擔心他會懷疑你的能力，我們會先打點好。
					mpechoat $n 櫃檯小姐從抽屜中拿出一張紙，請旁邊的人送去給老闆。
					addoil $n
				else
					tell $n 那麼請去跟魔法屋的老闆直接說是冒險者公會(adventurer guild)派來的就行囉！
					addoil $n
				endif
			else
				break
			endif
		else
			break
		endif
	else
		break
	endif
else
	tell $n 你還沒把上次的東西還給我喔！你該不會弄丟了吧？這樣要賠我１０萬金幣！
endif
~
>talk_prog p lost property~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 200002
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 前陣子有一個商人急急忙忙的跑進來說要委託公會幫忙找東西。據他所說，東
			tell $n 西是他的商品，可能是在路途中不小心弄丟了。
			mpcallout 1 mpechoat $n 櫃檯小姐自言自語的說：這種冒失的白癡居然也能當商人....
			mpcallout 2 smirk
			mpcallout 3 tell $n 能性，像這種忘記回來取消委託的也大有人在。
			mpcallout 3 tell $n 委託的時間也有點久了，雖然他沒回來取消委託，但也存在已經找到東西的可
			mpcallout 3 tell $n 部分也沒有作太多的說明，所以我也沒辦法解釋實際的任務內容。並且距離他
			mpcallout 3 tell $n 他因為很著急，所以只簡單的留下聯絡地點跟基本資料就離開了，對於細節的
			mpcallout 4 sigh
			mpcallout 5 mpechoat $n 櫃檯小姐自言自語的說：就是有這種以自我中心的委託人才會造成公會旁大的負擔。
			mpcallout 6 tell $n 託人是不是還需要你來解決問題。
			mpcallout 6 tell $n 總之呢，如果你有打算接受這個任務，我再把詳細的聯絡方式給你。但我不能保證這個委
		else
			break
		endif
	else
		break
	endif
else
	break
endif
