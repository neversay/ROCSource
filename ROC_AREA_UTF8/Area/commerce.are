#35021
scar-commerce adventurerbar3-commerce~
傷疤的冒險者(scar adventurer)~
一位臉上有傷疤的冒險者(adventurer)獨自待在這裡。
~
他看起來經驗非常豐富，但臉上的傷疤讓他看起來有點可怕，不易親近。
~
1|2|64|2048|16384|262144 8|32|128 0 S
45 10000 0 50d50+-600 -10d-50+0
1000 0
0 8 1
C 1|4|8|32
S 13 50000
S 40 100
S 44 200
R Human~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 0 1
~
>tick_prog 100~
if being($b)
	if isfight($i)
		break
	endif
	if is_qmark($i) != scar_adv_qtimer
		tell $b 你的動作太慢了，我要去找別人幫忙了。
		mpechoat $b $I往史卡拉貝的方向走去。
		follow self
		group leave
		mpgoto 35020
		mpat $b mpdel_qmark $b scar_adv_helping_start
		mpat $b mpdel_qmark $b scar_adv_helping
		mpdel_qmark self scar_adv_crazy
		mpdel_qmark self scar_adv_qtimer
		mpdef_rembch null-tar
	endif
else
	if is_qmark($i) == scar_adv_qtimer
		mpdel_qmark self scar_adv_crazy
		mpdel_qmark self scar_adv_qtimer
		mpgoto 35020
		mpdef_rembch null-tar
	endif
endif
~
>rand_prog 100~
if is_qmark($i) == scar_adv_crazy
	if isfight($i)
		break
	endif
	if is_qmark($i) == scar_adv_crazy 100001
		mpdis_magic self blindness
		if insameroom($b)
			mpechoat $b $I的表情冷靜許多，或許能跟他溝通了。
			mpmod_qmark self scar_adv_crazy v0 = 2
		else
			tell $b 你居然對我見死不救，這件事我絕對不會忘記的！
			mpdel_qmark self scar_adv_crazy
			mpdel_qmark self scar_adv_qtimer
			mpat $b mpdel_qmark $b scar_adv_helping
			if is_qmark($b) != commerce_subquest
				mpat $b mpadd_qmark $b commerce_subquest -1 0 2 0 0 1
			else
				mpat $b mpmod_qmark $b commerce_subquest v1 | 2
			endif
			follow self
			group leave
			mpgoto 35020
			mpdef_rembch null-tar
		endif
	endif
else
	if being($b)
		if insameroom($b)
			break
		else
			mpgoto $b
			follow $b
			mpechoat $b $I從不遠處跑回來找你。
		endif
	else
		if rand(2)
			if rand(50)
				mpoload 35030 1
				beer self
				drink lager
				mpjunk lager
			else
				mpoload 35029 1
				beer self
				drink ale
				mpjunk ale
			endif
		endif
	endif
endif
~
>talk_prog topic~
if is_qmark($n) == scar_adv_helping 300001
	mpdel_qmark $n scar_adv_helping
	if is_qmark($n) != commerce_subquest
		mpadd_qmark $n commerce_subquest -1 2 0 0 0 1
	else
		mpmod_qmark $n commerce_subquest v0 | 2
	endif
endif
if is_qmark($n) == scar_adv_helping 300002
	mpdel_qmark $n scar_adv_helping
	if is_qmark($n) != commerce_subquest
		mpadd_qmark $n commerce_subquest -1 0 2 0 0 1
	else
		mpmod_qmark $n commerce_subquest v1 | 2
	endif
endif
if is_qmark($i) == scar_adv_crazy 100002
	if rembch($n)
		if is_qmark($b) == scar_adv_helping 100005
			mpdel_qmark $b scar_adv_helping
			if is_qmark($b) != commerce_subquest
				mpadd_qmark $b commerce_subquest -1 2 0 0 0 1
			else
				mpmod_qmark $b commerce_subquest v0 | 2
			endif
			glare
			mpcallout 2 tell $b 真是沒想到公會派出的冒險者會被殲滅...
			mpcallout 3 tell $b 這件事讓我失去一位好戰友...
			mpcallout 4 hand $b
			mpcallout 4 tell $b 不過我也因此而多了一位新的戰友。
			mpcallout 6 tell $b 朋友呀，這次多虧你的幫忙，我才能順利替他們報仇。
			mpcallout 7 tell $b 但是我身上沒有什麼好東西能夠給你，只有這個....
			mpcallout 8 mpechoat $b $I在行囊裡翻來翻去...最後拿出了一個球體
			mpcallout 9 tell $b 這是我以前在任務中所以得到的魔導器，雖然內部有強大的魔力，但正確的使用法我也不清楚。
			mpcallout 10 tell $b 因此請你收下吧。
			mpcallout 10 tell $b 也許擁有強大潛力的你，會知道它的使用方法。
			mpcallout 11 mpoload 35067 $b 46 target
			mpcallout 11 mpresp $b 1
			mpcallout 11 mpskillexp $b 5000
			mpcallout 11 mpexp $b 10000
			mpcallout 11 mpechoat $b $I將球體給了你。
			mpcallout 12 follow self
			mpcallout 12 group leave
			mpcallout 12 mpgoto 35020
			mpcallout 12 tell $b 那麼，我先回去了，再見了，我的朋友！
			mpcallout 14 mpdel_qmark self scar_adv_qtimer
			mpcallout 14 mpdel_qmark self scar_adv_crazy
			mpcallout 14 mpdef_rembch null-tar
		endif
	else
		mpechoat $n $I正在忙，沒空理你。
	endif
else
	if is_qmark($i) != scar_adv_crazy
		if being($b)
			if rembch($n)
				tell $b 離他們最後一次聯繫的時間有點久了，要稍微加快腳步了。
			else
				mpechoat $n $I正在忙，沒空理你。
			endif
		else
			if is_qmark($n) & commerce_subquest 200002
				mpechoat $n $I完全無視你的存在。
				break
			endif
			if is_qmark($n) & commerce_subquest 100002
				tell $n 上次真是多謝你的幫忙了！
				tell $n 有空就坐下來喝一杯吧！
				beer $n
				break
			endif
			if is_qmark($n) & adv_guild_level 300002
				look $n
				tell $n 喔，這不是最近公會裡的紅人嗎。
				tell $n 你找我有什麼事嗎？
			else
				mpechoat $n 他看起來很可怕，你確定要找他搭訕？
			endif
		endif
	else
		mpechoat $n 他怒火中燒，完全沒注意到你。
	endif
endif
~
>talk_prog p the group~
if is_qmark($n) == scar_adv_helping 300001
	if is_qmark($n) != commerce_subquest
		mpadd_qmark $n commerce_subquest -1 2 0 0 0 1
	else
		mpmod_qmark $n commerce_subquest v0 | 2
	endif
endif
if is_qmark($n) == scar_adv_helping 300002
	if is_qmark($n) != commerce_subquest
		mpadd_qmark $n commerce_subquest -1 0 2 0 0 1
	else
		mpmod_qmark $n commerce_subquest v1 | 2
	endif
endif
if is_qmark($n) !& ianua_info 100001
	break
endif
if area($i) != commerce
	break
endif
if is_qmark($n) & commerce_subquest 200002
	mpechoat $n $I完全無視你的存在。
	break
endif
if is_qmark($i) == talking
	mpechoat $n 他正在說話。
	break
endif
if is_qmark($i) == scar_adv_qtimer
	tell $n 我現在沒空。
	break
endif
if is_qmark($n) & commerce_subquest 100002
	if is_qmark($n) & adv_guild_level 300002
		if is_qmark($i) == bothynus_info
			mpadd_qmark self talking
			mpcallout 1 mpdel_qmark self talking
			tell $n 我剛剛才解說過這個團體...讓我休息一段時間再講吧...
			mpcallout 1 tell $n 在各山丘的附近搜尋，或許能發現些蹤跡。
			mpcallout 1 tell $n 總之，有事找他們就朝黑森林的西邊去找吧。
			break
		endif
	endif
endif
if is_qmark($n) & commerce_subquest 100002
	if is_qmark($n) & adv_guild_level 300002
		mpadd_qmark self talking
		mpcallout 11 mpdel_qmark self talking
		mpadd_qmark self bothynus_info 6 0 0 0 0 1
		tell $n 呃...你想知道那群麻煩人物的事嗎...
		mpcallout 1 ponder
		mpcallout 2 tell $n 看在你幫過我的份上，我就告訴你吧。
		mpcallout 3 tell $n 我猜他們的目標應該是前往有山丘的高處吧！
		mpcallout 3 tell $n 前些時間有看到團員的幾個人朝黑森林西邊去。
		mpcallout 3 tell $n 這個團體全由法師組成，不分種族性別大概有六、七人吧。
		mpcallout 4 tell $n 要說為什麼會知道他們往高處走呢....
		mpcallout 5 glare
		mpcallout 7 tell $n 最終我跟他們間發生了些不愉快。
		mpcallout 7 tell $n 其實......我曾經參加過他們的追星活動。
		mpcallout 8 tell $n 而星之碎片這東西，在當時剛好又在冒險者間掀起一段浪潮。
		mpcallout 8 tell $n 會去參加他們的活動，是我身為冒險者對神秘的事物抱持著憧憬。
		mpcallout 9 tell $n 又或是握著碎片念一段咒語許願後，金銀財寶就會從天而降之類的...
		mpcallout 9 tell $n 像是身上戴著碎片作成的飾品能抵抗各種龍息、魔法的傷害。
		mpcallout 10 tell $n 浪潮自然就消退了。
		mpcallout 10 tell $n 但現在看來，碎片也只是比較難取得的石塊，本身不具有特別的價值。
		mpcallout 10 tell $n 總之，各方流言都把星之碎片說成像是賢者之石一樣神。
		mpcallout 11 tell $n 不然以前可是一片碎片一塊金呢！
	else
		mpadd_qmark self talking
		mpcallout 2 mpdel_qmark self talking
		tell $n 呃...你想知道那群麻煩人物的事嗎...
		mpcallout 1 ponder
		mpcallout 2 wave $n
		mpcallout 2 tell $n 為了你的前途，不要跟這群怪咖扯上關係比較好。
		mpcallout 2 tell $n 看在你幫過我的份上，良心奉勸你還是打消這念頭吧。
	endif
else
	mpechoat $n 他看起來很可怕，你確定要找他搭訕？
endif
~
>talk_prog p centaur camp~
if area($i) != commerce
	break
endif
if is_qmark($n) == scar_adv_helping
or is_qmark($n) & commerce_subquest 100002
or is_qmark($n) & commerce_subquest 200002
	break
endif
if is_qmark($i) != scar_adv_qtimer
	if is_qmark($n) == scar_adv_helping_start 100001
		mpmod_qmark $n scar_adv_helping_start v0 = 2
		tell $n 你要問人馬營地的事嗎？
		mpcallout 1 look $n
		mpcallout 2 hmm
		mpcallout 2 tell $n 有聽說你幫公會解決不少麻煩事，看來也算是個有能力的冒險者。
		mpcallout 4 tell $n 好吧，我把事情的來龍去脈告訴你，也許你能夠派得上用場。
		mpcallout 5 tell $n 星期前完成了小隊的組成。
		mpcallout 5 tell $n 位有實力的冒險者組成小隊來解決人馬營地的事情。公會則是在二
		mpcallout 5 tell $n 事情是這樣的，前陣子公會接到奧夫卡的密函，說想要公會挑選幾
		mpcallout 6 tell $n 說應該是相當充裕的，但這支隊伍到現在都依然沒有回音。
		mpcallout 6 tell $n 從史卡拉貝到目的地大概需要四天的時間，以去程跟回程的時間來
		mpcallout 7 tell $n 消息傳回，我擔心他可能發生什麼事情了。
		mpcallout 7 tell $n 那種在完成任務後會第一時間進行回報的人，但是到現在都沒半點
		mpcallout 7 tell $n 剛好在隊伍裡的魔法師剛好是我熟識的人，依我對他的了解，他是
		mpcallout 8 worry
		mpcallout 8 tell $n 究竟發生了什麼事，才會到現在都沒有回應.....
		mpcallout 8 tell $n 所以我打算追蹤他們走過的路徑一路到達人馬營地，看看這支隊伍
		mpcallout 10 tell $n 跟我進去一探究竟。
		mpcallout 10 tell $n 麼我一個人單獨闖入也只是找死而已。因此我想找有能力的冒險者
		mpcallout 10 tell $n 但是如你所想的，最壞的情況是這支隊伍已經被人馬給殲滅了，那
		mpcallout 11 tell $n 你看起來不像個等閒之輩。怎樣，有興趣跟我去嗎？(yes/no)
		mpadd_qmark $n scar_adv_helping -1 0 0 0 0 1
	else
		mpechoat $n 他看起來很可怕，你確定要找他搭訕？
	endif
else
	tell $n 我現在沒空。
endif
~
>talk_prog yes~
if area($i) != commerce
