mpechoat $n 　
mpcall au_price_chart $n
~
>talk_prog gold~
if weight($n) >= 999
	tell $n 你拿不動了，請先整理你的行囊。
	sorry $n
	break
endif
mpcall au_pur_check $n
if rand(5)
	if is_qmark($i) < au_price_count 100006
		mpmod_qmark self au_price_count v0 + 1
	endif
endif
if rand(25)
	if is_qmark($i) < au_price_count 200010
		mpmod_qmark self au_price_count v1 + 1
	endif
endif
if rand(7)
	if is_qmark($i) < au_price_count 200000
		mpmod_qmark self au_price_count v1 = 0
	endif
endif
if rand(50)
	if is_qmark($i) < au_item_purchase 100020
		mpmod_qmark self au_item_purchase v0 + 1
	endif
endif
