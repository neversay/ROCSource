>talk_prog bone~
say 是的，我是商會(commerce)派駐在迷霧之島，負責蒐集珍貴恐龍骨骼的商人，
say 如果您有龍骨可以賣我的話，我會高價收買，我也接受客戶單獨的訂貨(order)，
say 可以幫您量身打造精緻加工強化過的龍骨裝備。
mpechoat $n $I突然靠近你，在你耳旁說話......
mpechoaround $n $I突然靠近$n，在他耳旁說話......
mpcallout 1 tell $n 我這邊也秘密兼營龍晶、龍珠買賣，如果你有多餘的，賣給我吧！
mpcallout 2 tell $n 這玩意對冒險者也沒有用，不如賣給我吧！
~
>talk_prog commerce~
say 商會是史卡拉貝建成以來就存在的商業同盟，也是我的老東家，我們的商會
say 控制了史卡拉貝聯邦的貨物流動，運有販無，是史卡拉貝賴以生存的命脈！
mpcallout 1 say 沒有了商會，我想整個大陸都會因此陷入混亂吧！
~
>talk_prog bone~
mpcall list_1 $n
~
>talk_prog topic~
mpcall list_1 $n
~
>defun_prog list_1~
 mpechoat $n [1;37m您可以訂購的龍骨裝備種類與價錢：[0m
 if is_qmark($i) > cholecyst_count 100003
 	if is_qmark($i) > horn_count 100002
 		mpechoat $n 生機之杖(staff of life)			160000 枚金幣
 	else
 		mpechoat $n 生機之杖(staff of life)			缺少原料：銳利的犄角
 	endif
 else
 	mpechoat $n 生機之杖(staff of life)			缺少原料：鯨龍的膽
 endif
 if is_qmark($i) > sternum_count 100003
 	if is_qmark($i) > teeth_count 100004
 		mpechoat $n 棘龍巨骨盾(shield of Spinosaurus bone) 1920000 枚金幣
 	else
 		mpechoat $n 棘龍巨骨盾(shield of Spinosaurus bone)	缺少原料：銳利的尖牙
 	endif
 else
 	mpechoat $n 棘龍巨骨盾(shield of Spinosaurus bone)	缺少原料：棘龍胸骨
 endif
 if is_qmark($i) > huge_count 100003
 	if is_qmark($i) > marrow_count 100002
 		mpechoat $n 龍霸槍(lance of tyrannosaurus)		340000 枚金幣
 	else
 		mpechoat $n 龍霸槍(lance of tyrannosaurus)		缺少原料：恐龍脊髓
 	endif
 else
 	mpechoat $n 龍霸槍(lance of tyrannosaurus)		缺少原料：銳利的巨大尖牙
 endif
 if is_qmark($i) > skin_count 100005
 	if is_qmark($i) > orb_count 100002
 		mpechoat $n 白月劍套(scabbard of moon)		320000 枚金幣
 	else
 		mpechoat $n 白月劍套(scabbard of moon)		缺少原料：各色龍晶(珠)
 	endif
 else
 	mpechoat $n 白月劍套(scabbard of moon)		缺少原料：恐龍皮
 endif
 if is_qmark($i) > horn_count 100002
 	if is_qmark($i) > claw_count 100002
