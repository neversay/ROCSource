#35038
maid-commerce~
侍女(maid)~
穿著一身潔白的侍女(maid)忙碌地整理環境。
~
你看她時她並沒有多問什麼，只是對你點頭微笑？
~
1|64 8|32 1000 S
19 0 0 0d0+0 0d0+0
10 0
0 8 2
P 8
R Fairy~
>greet_prog 80~
if isnpc($n)
	break
endif
if is_qmark($n) == adv_mission_mark 100008
	if rand(50)
		smile $n
		mpechoat $n 你發覺她的笑容中似乎隱藏了一絲憂鬱....
		mpadd_qmark $n adv_do_mission -1 1 0 8 0 1
	else
		mpechoat $n $I 說：賈霸大人每天都工作到很晚，對我們要求也很嚴格。
		mpechoat $n 你從她的語調中發覺她有一些難言之隱....
		mpadd_qmark $n adv_do_mission -1 1 0 8 0 1
	endif
else
	if rand(50)
		smile $n
	else
		mpechoat $n $I 說：賈霸大人每天都工作到很晚，對我們要求也很嚴格。
	endif
endif
~
>talk_prog topic~
if is_qmark($n) == adv_mission_mark 100008
	if is_qmark($n) == adv_do_mission 300008
		mpmod_qmark $n adv_mission_mark v0 = 0
		mpechoat $n 你向$I表明自己來自於冒險者公會。
		mpcallout 1 mpforce $n follow $i
		mpcallout 1 tell $n 我們到旁邊去說！如果被其他人聽到就不好了！
		mpcallout 1 gasp $n
		mpcallout 2 mpechoat $n $I將你帶到人煙稀少的角落旁...
		mpcallout 4 mpechoat $n $I小心地打量周圍，確定沒有人才開口說話。
		mpcallout 5 tell $n 而且還是個政局不穩當的國家中裡....
		mpcallout 5 tell $n 我真高興冒險者公會居然會接受來自於其他國家的委託，
		mpcallout 6 mpechoat $n 你心想綠樹王國？政局不穩？
		mpcallout 8 mpechoat $n $I看見你臉上訝異的表情，不等你開口問就緊接著說
		mpcallout 9 mpechoat $n $I說到這裡突然緊張地四處張望....
		mpcallout 9 tell $n 通婚所引起的，但實際上背後存在有更大的陰謀...
		mpcallout 9 tell $n 近的小妖精部落發生戰爭。表面上衝突的原因是異種族間
		mpcallout 9 tell $n 是的，綠樹王國現在相當不穩定，主要來自於隨時會跟臨
		mpcallout 10 worry self
		mpcallout 10 tell $n 抱歉，在這件事上我不能說太多了，不然會有生命危險。
		mpcallout 11 tell $n 要麻煩您完成。請問可以嗎？(yes/no)
		mpcallout 11 tell $n 在小妖精部落，但我現在的身份不適合進入那邊，所以想
		mpcallout 11 tell $n 至於我的委託是想請您幫忙送一封信給一個人。他現在人
		mpcallout 11 mpmod_qmark $n adv_do_mission v0 = 1
	else
		mpecho $I緊張地四處張望：
		say 對不起，賈霸大人不喜歡我們在工作中閒聊。
	endif
else
	mpecho $I緊張地四處張望：
	say 對不起，賈霸大人不喜歡我們在工作中閒聊。
endif
~
>talk_prog yes~
if is_qmark($n) == adv_do_mission 300008
	if is_qmark($n) == adv_do_mission 100001
		mpmod_qmark $n adv_do_mission v0 = 2
		thank $n
		tell $n 真是太感謝您了！他人在部落禁區中的白色高塔當守衛。
		tell $n 因為那座塔是禁區，裡面的守衛會不分青紅皂白的攻擊入侵者。
		tell $n 不過他生性溫柔，知道您來的原因他就不會攻擊你了。
		tell $n 這個是要給他的信，請您務必要小心！
		mpechoat $n $I把信交給了你。
		mpoload 35049 $n 1 target
	else
		break
	endif
else
	break
endif
~
>talk_prog no~
if is_qmark($n) == adv_do_mission 300008
	if is_qmark($n) == adv_do_mission 100001
		mpdel_qmark $n adv_do_mission
		mpadd_qmark $n adv_mission_failed -1 8 0 0 0 1
		tell $n 是嗎...那真是可惜....
		tell $n 但還是要感謝您肯聽我訴說。
		tell $n 如果可以的話，請您回去跟公會報告說再請其他人來。(failed)
		bow $n
	else
		break
	endif
else
	break
endif
~
>talk_prog report~
if is_qmark($n) == adv_maid_revenge 100001
	mpdel_qmark $n adv_maid_revenge
	mpforce $n follow $i
	bow $n
	tell $n 感謝您幫忙除掉一個女人的公敵。
	mpcallout 1 tell $n 剩下的只有這個了。
	mpcallout 1 tell $n 我身上最好的東西已經交給公會當作委託的報酬了。
	mpcallout 2 tell $n 這條綢緞是我身上僅剩的寶物了。
	mpcallout 2 mpechoat $n $I從手臂上卸下一條純白的綢緞。
	mpcallout 3 mpoload 35051 $n 36 target
	mpcallout 3 mpechoat $n $I把綢緞放到你手上。
	mpcallout 3 tell $n 如果不嫌棄的話，我想把它送給您當作報酬。
	mpcallout 4 wave $n
	mpcallout 4 tell $n 再次感謝您的幫忙，那麼再見了！
else
	break
endif
~
>give_prog 35050~
if is_qmark($n) == adv_do_mission 100004
	if sex($n) == 2
		mpforce $n follow $i
		mpjunk letter-guard
		mpdel_qmark $n adv_do_mission
		mpdel_qmark $n adv_mission_mark
		mpmod_qmark $n adv_mission_complete v0 | 8
		mpmod_qmark $n adv_mission_reward v0 | 8
		mpechoat $n $I從妳手中接過回信後連忙拆開來讀。
		mpcallout 1 mpechoat $n 妳發現$I的表情有一些不對勁，女人的直覺告訴你事情不單純...
		mpcallout 2 mpechoat $n 妳發現$I的神情中充滿怒火。
		mpcallout 3 mpechoat $n $I把手中的信揉爛了。
		mpcallout 4 mpechoat $n $I的眼神變得平靜....那是看破塵世的眼神。
		mpcallout 5 mpechoat $n 妳似乎完成公會的任務了，會去領賞吧。(reward)
		mpcallout 5 bow $n
		mpcallout 5 tell $n 感謝你的幫忙，我的委託就到此結束了。
		mpcallout 6 mpechoat $n $I好像還有話想對妳說....
		mpcallout 7 mpechoat $n $I小聲的對晢妳說：「不好意思，我想同樣身為女性的妳，應該能了解我現在的心情。」
		mpcallout 8 mpechoat $n $I小聲的對著妳說：「我所愛慕的男人根本是個人渣。」
		mpcallout 9 mpechoat $n $I堅定的對著妳說：「因此我還有個不情之請」
		mpcallout 10 mpechoat $n $I對著妳說：「完成後再跟我回報(report)，報酬我會再另外給妳。」
		mpcallout 10 mpechoat $n $I冷靜的對著妳說：「麻煩幫我把這個渣男從世界上除掉。」
		mpadd_qmark $n adv_maid_revenge -1 0 0 0 0 1
	else
		mpforce $n follow $i
		mpjunk letter-guard
		mpdel_qmark $n adv_do_mission
		mpdel_qmark $n adv_mission_mark
		mpmod_qmark $n adv_mission_complete v0 | 8
		mpmod_qmark $n adv_mission_reward v0 | 8
		mpechoat $n $I從你手中接過回信後連忙拆開來讀。
		mpcallout 1 mpechoat $n 你發現$I的表情有一些不對勁。
		mpcallout 2 mpechoat $n 你發現$I的神情中充滿怒火。
		mpcallout 3 mpechoat $n $I把手中的信揉爛了。
		mpcallout 4 mpechoat $n $I的眼神變得平靜....那是看破塵世的眼神。
		mpcallout 5 mpechoat $n 你似乎完成公會的任務了，會去領賞吧。(reward)
		mpcallout 5 bow $n
		mpcallout 5 tell $n 感謝你的幫忙，我的委託就到此結束了。
	endif
else
	break
endif
~
