if is_qmark($n) & adv_mission_reward 300008
	tell $n 你完成少女的請求的任務，因此可以獲得靈魂寶石(soul gem)一個。
	mpmod_qmark $n adv_mission_reward v1 r 8
	mpoload 35121 $n 1 target
	mpexp $n 10000
