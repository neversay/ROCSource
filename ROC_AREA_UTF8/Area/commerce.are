灼燄的紅榴石(burning-flame garnet)~
一顆火紅光澤的紅榴石(garnet)被放置在這裡。~
~
8 2|8|64|256 1
0~ 0~ 0~ 0~
0 200000 0
Z 4
E
burning-flame garnet~
這是一顆全美的紅榴石，看起來應該被魔法加持過，因此整顆
寶石呈現出如同燃燒一樣的光澤，或許能賣個好價錢。
~
X garnet~
>obj_command set falcata~
if is_qmark($n) >= anc_ofcol_gemwp 100000
	if is_inv_obj($n) == 5566
		echoat $n 放入寶石的瞬間，身上的戰刀突然閃現出灼熱的熾燄。
		echoaround $n $N身上的戰刀突然閃現出灼熱的熾燄。
		if class($n) == 9
		or class($n) == 10
		or class($n) == 17
			purge $n falcata.gstchxsys
			oforcer here oload 5568 viclv $n target
			oset burning-flame-f value3 = 11
			purge self
		else
			purge $n falcata.gstchxsys
			oforcer here oload 5568 viclv $n target
			purge self
		endif
	endif
	if is_equ_obj($n) == 5566
		echoat $n 放入寶石的瞬間，手中的戰刀突然閃現出灼熱的熾燄。
		echoaround $n $N手中的戰刀突然閃現出灼熱的熾燄。
		if class($n) == 9
		or class($n) == 10
		or class($n) == 17
			purge $n falcata.gstchxsys
			oforcer here oload 5568 viclv $n target
			oset burning-flame-f value3 = 11
			oforce $n wear burning-flame-f
			purge self
		else
			purge $n falcata.gstchxsys
			oforcer here oload 5568 viclv $n target
			oforce $n wear burning-flame-f
			purge self
		endif
	endif
endif
~
>obj_command set buckler~
if is_qmark($n) >= anc_ofcol_gemwp 100000
	if is_inv_obj($n) == 5567
		echoat $n 放入寶石的瞬間，身上的圓盾突然閃現出灼熱的熾燄。
		echoaround $n $N身上的圓盾突然閃現出灼熱的熾燄。
		purge $n buckler.gstchxsys
		oforcer here oload 5569 viclv $n target
		purge self
	endif
	if is_equ_obj($n) == 5567
		echoat $n 放入寶石的瞬間，手中的圓盾突然閃現出灼熱的熾燄。
		echoaround $n $N手中的圓盾突然閃現出灼熱的熾燄。
		purge $n buckler.gstchxsys
		oforcer here oload 5569 viclv $n target
		oforce $n wear burning-flame-b
		purge self
	endif
endif
~
|

