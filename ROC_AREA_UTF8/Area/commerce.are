	break
endif
if is_qmark($n) >= comm_bounty_timer 1012
	tell $n 你還要等不到一天的時間才能接單。
	break
endif
if is_qmark($n) <= comm_bounty_timer 1011
	tell $n 你還要等半天左右的時間才能接單。
	break
endif
tell $n 目前手上有不少委託，如果你確定要接單(ok)。
tell $n 我將從中挑選出適合你的委託。
