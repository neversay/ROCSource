	if is_qmark($n) !& pharmacist_level 100004
		if is_qmark($n) != pharmacist_quest_chief
			tell $n 你是要問說胭紅草嗎？
			hmm
			mpcallout 1 tell $n 拿捏恰當，且經過適當的處理，就不會造成身體上的危害了。
			mpcallout 1 tell $n 這種草雖然有毒性，但在食譜上被規類成一種高級香料。只要在用量上
			mpcallout 2 tell $n 知道我也可以告訴你，反正也不算是什麼商業機密。
			mpcallout 2 tell $n 不過整個流程所製作出來的東西是藥品，我根本用不到，如果你真得想
			mpcallout 2 tell $n 這是之前一位作藥的客人告訴我的，他還教我如何把草的毒性去除掉，
			mpcallout 3 tell $n 對了，我要青色的！
			mpcallout 3 tell $n 不過凡事都需要一點代價，我現在手上缺兩顆地瓜，你去幫我拿來。
			mpcallout 3 mpadd_qmark $n pharmacist_quest_chief -1 0 0 0 0 1
		else
			tell $n 東西先拿來我才會告訴你！
		endif
	else
		tell $n 不要吵我！已經把知道的都告訴你了！
	endif
else
	tell $n 不要吵！我沒空理你！
endif
~
>give_prog 10273~
if is_qmark($n) == pharmacist_quest_chief
	mpmod_qmark $n pharmacist_quest_chief v0 + 1
	good $n
	mpjunk rutabaga
	if is_qmark($n) == pharmacist_quest_chief 100002
		mpdel_qmark $n pharmacist_quest_chief
		mpmod_qmark $n pharmacist_level v0 | 4
		tell $n 那麼我只說一次，兩株胭紅草要跟一株具有治療力的草藥同時混合，
		tell $n 比例上不能有錯，並且一次也不能放入太多，如此就可以除去毒性。
		tell $n 好了，方法就這樣而已，我要去忙了。
	endif
else
	say 這什麼鬼東西？
	drop $o
endif
