~
>talk_prog p adventurer guild~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == adv_mission_mark 200016
	mpmod_qmark $n adv_mission_mark v1 = 0
	mpadd_qmark $n adv_do_mission_2 -1 0 0 16 0 1
	mpechoat $n 你告訴他自己是公會派來的人。
	tell $n 你好，我叫作馬庫斯是這家裝備店的學徒。
	tell $n 在這裡學習著裝備的知識(knowledge)。
endif
~
>talk_prog p knowledge~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) == adv_do_mission_2 100000
		mpmod_qmark $n adv_do_mission_2 v0 = 1
		tell $n 我老家是在光明鎮附近偏僻小鎮中開裝備店。
		tell $n 為了繼承家業幾年前我離開家鄉到各地(places)進修。
	endif
endif
~
>talk_prog p places~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) == adv_do_mission_2 100001
		mpadd_qmark self talking
		nod $n
		tell $n 為了學習世界上各地裝備的特色，我完成迷霧之島的學習後來到風之大陸。
		mpcallout 1 tell $n 精靈鎮、矮人王國及賽伐斯拖普等地待過。
		mpcallout 1 tell $n 我以史卡拉貝作為起點，前後分別在囤墾區、奧夫卡、
		mpcallout 2 tell $n 而這裡也將作為我風之大陸旅程的最終站。
		mpcallout 2 tell $n 探訪各地後，最後又回到史卡拉貝跟這個老闆學習品質鑑定(identify)的知識。
		mpcallout 2 mpat $n mpmod_qmark $n adv_do_mission_2 v0 = 2
		mpcallout 2 mpdel_qmark self talking
	endif
endif
~
>talk_prog p identify~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) == adv_do_mission_2 100002
		mpadd_qmark self talking
		tell $n 如何分辨裝備的優劣是一門深奧的學問。
		tell $n 只有資深的工匠跟老道的冒險者能倚靠長期的經驗來判斷。
		mpcallout 1 tell $n 因此只能跟著有能力判定良劣的裝備商學習這門知識。
		mpcallout 1 tell $n 但我畢竟不是長年敲打裝備的工匠也不是成天揮劍的冒險者。
		mpcallout 2 tell $n 當他的學徒真得是滿辛苦的呢。
		mpcallout 2 tell $n 然而這位看起來慵懶的老闆正是史卡拉貝中學習這門技藝的不二人選...
		mpcallout 3 shrug
		mpcallout 4 tell $n 但為了成為獨當一面的裝備商人，我必須學會這技巧並找到一些特別的裝備....(arms)
		mpcallout 4 mpat $n mpmod_qmark $n adv_do_mission_2 v0 = 3
		mpcallout 4 mpdel_qmark self talking
	endif
endif
~
>talk_prog p arms~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) == adv_do_mission_2 100003
		mpadd_qmark self talking
		mmm
		tell $n 在離開家鄉時，父親跟我說過。
		tell $n 想成為一流的裝備商人，一定要先培養自己的眼界。
		mpcallout 1 tell $n 還說如果我有幸見到這些裝備，相信對我的眼光一定能有所提升。
		mpcallout 1 tell $n 身為裝備商人不能只看外表，還要能清楚參透裝備的本質。
		mpcallout 1 tell $n 也提到過，他曾經見過一些外觀普通但卻有著特殊能力的裝備。
		mpcallout 2 ponder
		mpcallout 4 tell $n 然而卻還沒有看過父親所說的這些裝備。
		mpcallout 4 tell $n 不過隨著時間推移，我的旅程也及將結束。
		mpcallout 4 tell $n 雖然現在的我應該對裝備有著一定的判斷能力。
		mpcallout 5 tell $n 只能作為一個平庸的商人在家鄉渡過一生吧....
		mpcallout 5 tell $n 如果就這樣回家，這輩子大概再也沒機會成為一流的裝備商人了。
		mpcallout 7 tell $n 這次委託公會也是抱著一線希望能夠找到這些裝備(list)。
		mpcallout 7 mpat $n mpmod_qmark $n adv_do_mission_2 v0 = 4
		mpcallout 7 mpdel_qmark self talking
	endif
endif
~
>defun_prog arms_list_check~
if is_qmark($n) == adv_do_mission_2 200127
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_do_mission_2
	mpmod_qmark $n adv_mission_complete v1 | 16
	mpmod_qmark $n adv_mission_reward v1 | 16
	mpadd_qmark $n comm_arms_bonus -1 0 0 0 0 1
	tell $n 這些特別的裝備的確讓我大開眼界。
	tell $n 對我的技術有著極大的幫助。
	mpcallout 1 bow
	mpcallout 1 tell $n 感謝你的協助。
	mpcallout 2 mpforcer here at $n echoat $n 看來是完成任務了，回去領賞吧(reward)。
else
	tell $n 那麼我還缺少這些東西：
	if is_qmark($n) !& adv_do_mission_2 200001
		mpechoat $n 　裝備後能治癒傷害的杖
	endif
	if is_qmark($n) !& adv_do_mission_2 200002
		mpechoat $n 　握住後會失去語言能力的長劍
	endif
	if is_qmark($n) !& adv_do_mission_2 200004
		mpechoat $n 　破壞聖物的邪器
	endif
	if is_qmark($n) !& adv_do_mission_2 200008
		mpechoat $n 　帶有流動魔力的斬首刀
	endif
	if is_qmark($n) !& adv_do_mission_2 200016
		mpechoat $n 　能飛上天空的羽毛鞋
	endif
	if is_qmark($n) !& adv_do_mission_2 200032
		mpechoat $n 　能儲蓄魔力的水藍寶石
	endif
	if is_qmark($n) !& adv_do_mission_2 200064
		mpechoat $n 　祈禱就能發出雷光的裝備
	endif
	if is_qmark($n) >= adv_do_mission_2 100008
		tell $n 如果你真得找不到了，可以跟我說一聲(done)。
	endif
endif
~
>talk_prog p list~
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) >= adv_do_mission_2 100005
		mpcall arms_list_check $n
		break
	endif
	if is_qmark($i) == talking
		mpechoat $n 他正在說話。
		break
	else
		if is_qmark($n) == adv_do_mission_2 100004
			mpadd_qmark self talking
			tell $n 這些裝備他沒說在哪見過，但有形容特徵給我聽，分別是：
			tell $n 裝備後能治癒傷害的杖、握住後會失去語言能力的長劍、破壞聖物的邪器、
			tell $n 帶有流動魔力的斬首刀、能飛上天空的羽毛鞋、能儲蓄魔力的水藍寶石、
			tell $n 最後是仰賴祈禱就能發出雷光退敵的裝備。
			mpcallout 1 tell $n 畢竟我自己也找好幾年都找不到呢...
			mpcallout 1 tell $n 如果真的找不到超過三樣，我也不會強人所難(done)。
			mpcallout 1 tell $n 我希望你至少能幫忙找到三樣，當然能全找到是最好啦。
			mpcallout 2 bow $n
			mpcallout 2 tell $n 另外要是你忘記找哪些東西，可以再來跟我確認(list)。
			mpcallout 2 mpat $n mpmod_qmark $n adv_do_mission_2 v0 = 5
			mpcallout 2 mpdel_qmark self talking
		endif
	endif
endif
~
>talk_prog p done~
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) >= adv_do_mission_2 100008
		mpdel_qmark $n adv_mission_mark
		mpdel_qmark $n adv_do_mission_2
		mpmod_qmark $n adv_mission_complete v1 | 16
		mpmod_qmark $n adv_mission_reward v1 | 16
		tell $n 這些特別的裝備的確讓我大開眼界。
		tell $n 對我的技術有著極大的幫助。
		mpcallout 1 bow
		mpcallout 1 tell $n 感謝你的協助。
		mpcallout 2 mpforcer here at $n echoat $n 看來是完成任務了，回去領賞吧(reward)。
	else
		tell $n 畢竟我也花了不少積蓄從公會請你來幫忙。
		tell $n 希望你能夠再努力找一下。
	endif
endif
~
>give_prog 4217~
if is_qmark($n) == adv_do_mission_2 300016
	if is_qmark($n) >= adv_do_mission_2 100005
