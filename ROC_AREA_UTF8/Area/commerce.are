~
>obj_command type stick~
if isaffected($n) & 268435456
	echoat $n 你麻痺了。
	break
endif
if is_equ_obj($n) == 35024
	echoat $n 你手上已經拿著百式機關了
else
	echoat $n 你要將百式機關拿在手上才能組合。
endif
~
>obj_command type scythe~
if isaffected($n) & 268435456
	echoat $n 你麻痺了。
	break
endif
if is_equ_obj($n) == 35024
	echoat $n 你靈巧的將百式機關組合成一把大鐮！
	echoaround $n 你看到$N巧妙的將手裡的武器組合成一把大鐮！
	oforcer here oload 35025 36 $n target
	oforce $n wear scythe-type
	purge self
else
	echoat $n 你要將百式機關拿在手上才能組合。
endif
~
>obj_command type crossbow~
if isaffected($n) & 268435456
	echoat $n 你麻痺了。
	break
endif
if is_equ_obj($n) == 35024
	echoat $n 你靈巧的將百式機關組合成一把巨弩！
	echoaround $n 你看到$N巧妙的將手裡的武器組合成一把巨弩！
	oforcer here oload 35026 36 $n target
	oforce $n wear crossbow-type
	purge self
else
	echoat $n 你要將百式機關拿在手上才能組合。
endif
~
