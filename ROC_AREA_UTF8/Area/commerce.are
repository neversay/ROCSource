>talk_prog mission~
if is_qmark($n) == adv_guild_lvup
	tell $n 副會長在辦公室等你，先去跟他見一面吧。
	mpcallout 1 tell $n 辦公室的門在我的左手邊。
	break
endif
if is_qmark($n) != adv_quest_object
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) == adv_mission_failed
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 你還沒有繳交任務失敗的罰金１０萬金幣喔！(failed)
			break
		else
			if is_qmark($n) != adv_mission_mark
				if is_qmark($n) & adv_guild_level 300001
					if is_qmark($n) != adv_mission_complete 100031
						tell $n 對於想了解任務的內容請直接告訴我任務的名稱，我會解說內容給你聽。
						tell $n 如果確定要接受，直接跟我說想要接受的任務編碼(accept <編碼>)就行囉。
						tell $n 每人同時間只能接受一種公會任務，完成後可以回到公會領取獎賞(reward)。
						tell $n 如果因任務難度過高無法完成而想取消當前任務(cancel)。
						tell $n 則依當前任務難度收取不同數量的金幣作為公會補償。
						tell $n 所以請仔細評估自身的實力，盡全力完成任務。
						mpechoat $n $I翻了翻桌上的任務記錄本....
						tell $n 目前公會的任務有：
						mpcall guild_q_list $n
					else
						if is_qmark($n) !& adv_guild_level 300002
							mpadd_qmark $n adv_guild_lvup -1 1 0 0 0 1
							mpechoat $n $I翻了翻桌上的任務記錄本....
							tell $n 公會目前沒有需要你來執行的任務喔。
							mpcallout 1 hmm
							mpcallout 2 tell $n 對了，副會長有條給你的留言：請你有空到會長辦公室找他，有事情要跟你說。
						else
							if is_qmark($n) != adv_mission_complete 200031
								tell $n 對於想了解任務的內容請直接告訴我任務的名稱，我會解說內容給你聽。
								tell $n 如果確定要接受，直接跟我說想要接受的任務編碼(accept <編碼>)就行囉。
								tell $n 每人同時間只能接受一種公會任務，完成後可以回到公會領取獎賞(reward)。
								tell $n 如果因任務難度過高無法完成而想取消當前任務(cancel)。
								tell $n 則依當前任務難度收取不同數量的金幣作為公會補償。
								tell $n 所以請仔細評估自身的實力，盡全力完成任務。
								mpechoat $n $I翻了翻桌上的任務記錄本....
								tell $n 目前公會的任務有：
								mpcall guild_q_list $n
							else
								if is_qmark($n) !& adv_guild_level 300004
									mpadd_qmark $n adv_guild_lvup -1 0 1 0 0 1
									mpechoat $n $I翻了翻桌上的任務記錄本....
									tell $n 公會目前沒有需要你來執行的任務喔。
									mpcallout 1 tell $n 不過副會長有留言說：你有空到會長辦公室找他，有事情要跟你說。
								else
									if is_qmark($n) == adv_mission_complete 300031
										tell self (第三階quest用 將 == 改成 != )
										tell $n 對於想了解任務的內容請直接告訴我任務的名稱，我會解說內容給你聽。
										tell $n 如果確定要接受，直接跟我說想要接受的任務編碼(accept <編碼>)就行囉。
										tell $n 每人同時間只能接受一種公會任務，完成後可以回到公會領取獎賞(reward)。
										tell $n 如果因任務難度過高無法完成而想取消當前任務(cancel)。
										tell $n 則依當前任務難度收取不同數量的金幣作為公會補償。
										tell $n 所以請仔細評估自身的實力，盡全力完成任務。
										mpechoat $n $I翻了翻桌上的任務記錄本....
										tell $n 目前公會的任務有：
										mpcall guild_q_list $n
									else
										mpechoat $n $I翻了翻桌上的任務記錄本....
										tell $n 公會目前沒有需要你來執行的任務喔。
									endif
								endif
							endif
						endif
					endif
				else
					break
				endif
			else
				mpechoat $n $I翻了翻桌上的任務記錄本....
				tell $n 你已經有任務在身囉，請先完成當前的任務，或是取消這次任務(cancel)。
			endif
		endif
	else
		break
	endif
else
	tell $n 你還沒把上次的東西還給我喔！你該不會弄丟了吧？這樣要賠我１０萬金幣！
endif
