>repop_prog 100~
mpadd_qmark self enable_detect_nightstalk -1 0 0 0 0 1
~
>fight_prog 100~
mpgoto self
~
>tick_prog 100~
if inroom($i) != 35001
	mpgoto 35001
endif
~
>greet_prog 100~
if is_qmark($n) == commerce_enemy
	break
endif
if is_qmark($n) != adv_book_1_main
	tell $n 您想要加入(join)史卡拉貝商會的冒險者公會嗎？
else
	if is_qmark($n) != adv_member_mark
		mpadd_qmark $n adv_member_mark -1 0 0 0 0 1
		mpechoat $n $I幫你補上了紀錄用的表格。
	endif
	tell $n 您想要得到什麼冒險者公會提供給您的服務(serve)嗎？
endif
~
>talk_prog leave~
if is_qmark($n) != adv_member_mark
	tell $n 你並不是公會的成員，不需要脫離公會。
else
	tell $n 一旦脫離公會將無法再使用公會提供的任何服務及委託任務。
	tell $n 並且你將會被列入黑名單中，終生不得再次入會。
	tell $n 確認過上敘內容後，您還堅持要脫離公會嗎？(I do confirm)
endif
~
>talk_prog p I do confirm~
if is_qmark($n) == adv_member_mark
	tell $n 好，這就將你於公會裡除名。
	angry
	mpadd_qmark $n commerce_enemy -1 0 0 0 0 1
	mpdel_qmark $n adv_member_mark
endif
~
>talk_prog join~
if is_qmark($n) == commerce_enemy
	tell $n 對不起，根據本公會的記錄，曾脫離過公會的人將不得再入公會。
	break
endif
if is_qmark($n) != adv_member_mark
	tell $n 是的，只要報名費一萬元，您就能加入冒險者公會。
else
	tell $n 您已經加入公會了！
endif
~
>talk_prog reissue~
if is_qmark($n) != adv_member_mark
	tell $n 您並非公會的成員，很抱歉無法為您服務！
else
	if is_qmark($n) != adv_book_2_1
		tell $n 我這就為您補單。
		mpcallout 1 mpadd_qmark $n adv_book_2_1 -1 0 0 0 0 1
		mpcallout 1 tell $n 可以了，目前公會將會為您紀錄您在迷霧半島的戰區進度。
	else
		tell $n 你已經完成補單動作。
	endif
endif
~
>talk_prog serve~
if is_qmark($n) != adv_member_mark
	tell $n 您並不是公會的成員，無法享用公會的服務！
else
	mpechoat $n 您所能得到的服務項目：
	if is_qmark($n) != enable_level_41
		mpechoat $n .	英雄稱號(hero)
	endif
	mpechoat $n .	查詢商會戰區任務(area)
	mpechoat $n .	脫離冒險者公會(leave) － 脫離公會者將列入黑名單，終生不得再入會
	mpechoat $n .	補發迷霧半島戰區任務表單(reissue)
	mpechoat $n .	購買冒險者手冊(booklet)
endif
~
>talk_prog booklet~
if is_qmark($n) == adv_member_mark
	tell $n 冒險者手冊上頭記錄公會當前的目標，並且會隨時間自動更新。
	tell $n 一本 50 萬金幣，如果有需要直接給我錢就行了。
endif
~
>talk_prog hero~
if is_qmark($n) == adv_member_mark
	mpcall enable_level_41_check $n
else
	tell $n 您並未參加冒險者公會，無法得到公會的承認！
endif
~
>defun_prog enable_level_41_check~
if level($n) > 39
if is_qmark($n) != enable_level_41
if is_qmark($n) == adv_member_mark 116383
			tell $n 恭喜你完成商會所交代的所有任務！
			rumor $n完成了史卡拉貝商會所賦予的征伐任務，成為冒險者中的英雄！
			mpadd_qmark $n enable_level_41 -1 0 0 0 0 1
else
	tell $n 很抱歉，您還有公會賦予的任務尚未完成，無法得到公會的認證。
endif
else
	mpechoat $n .	[1;37m您已經是史卡拉貝商會所冊封的英雄了！[0m
endif
endif
~
