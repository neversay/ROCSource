>tick_prog 100~
mpmod_qmark self ped_stay_timer v0 + 1
if area($i) == commerce
	mpcall herb_sell peddler-comm-travel
	mpcall things_sell_1 peddler-comm-travel
	mpcall things_sell_2 peddler-comm-travel
endif
if area($i) == haon
	if is_qmark($i) <= ped_herbs 100020
		if rand(30)
			mpmod_qmark self ped_herbs v0 + 1
			mpecho $I從地上拔起一株雜草。
		endif
	endif
	if is_qmark($i) <= ped_herbs 200020
		if rand(30)
			mpmod_qmark self ped_herbs v1 + 1
			mpecho $I從地上拔起一株雜草。
		endif
	endif
	if is_qmark($i) !& ped_weapon_making 100004
		if rand(20)
			mpmod_qmark self ped_weapon_making v0 | 4
			mpecho $I從地上撿起一根木頭。
		endif
	endif
endif
if area($i) == greenwoods
	if is_qmark($i) <= ped_herbs 100020
		if rand(40)
			mpmod_qmark self ped_herbs v0 + 1
			mpecho $I跟人買了一株草藥。
