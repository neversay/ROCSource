					echoat $n 你精煉出一罐藥水。
				endif
			else
				oforcer here oload 35086 1 $n target
				oset alchemist-pot value3 = 0
				echoat $n 你精煉出一罐藥水。
			endif
		endif
	else
		echoat $n 你攪動著藥釜中的水。
	endif
endif
~
