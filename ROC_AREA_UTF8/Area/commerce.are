>bribe_prog 15000~
if is_qmark($i) == talking
	tell $n 你等等，我一次只能跟一個人說話。
	mpgold $n 15000
	break
endif
if is_qmark($n) & commerce_subquest 100004
or is_qmark($n) == sauc_info
	mpadd_qmark self talking
	if is_qmark($n) == sauc_info 100000
		mpmod_qmark $n sauc_info v0 = 1
	endif
	mpcallout 8 mpdel_qmark self talking
	mpechoat $n $I隨手點了點你給的金額...
	tell $n 沒問題，這就把我所知道的告訴你。
	mpcallout 1 tell $n 而該組織的最有權力的人又是主導商會的大佬之一。
	mpcallout 1 tell $n 由各大工會的頭領共同領導，主要研討商業發展策略的組織。
	mpcallout 1 tell $n 你或許有聽過商人自治會吧？
	mpcallout 2 tell $n 在裡面進行著見不得光的非法買賣。
	mpcallout 2 tell $n 利用在商會中的職權，建立了一間隱密的會員制招待所。
	mpcallout 2 tell $n 據聞，該位人士為了巴結國內外的貴族及政治人物。
	mpcallout 3 tell $n 也可能是他的對手為了打擊他而放出的假消息。
	mpcallout 3 tell $n 不過這也只是謠言，連有沒有這個地方都沒人知道。
	mpcallout 4 ponder
	mpcallout 5 tell $n 說他終於入手會員證(member card)了，接下來只要找到入口按鈕就行了。
	mpcallout 5 tell $n 不過我曾經聽過一個有點胖的商人在喝醉後講出奇怪的話。
	mpcallout 6 mmm
	mpcallout 7 tell $n 大概是我想太多了，可能這兩件事根本沒關連吧。
	mpcallout 8 tell $n 以上就是我知道的所有內容了。
else
	tell $n 感謝您康慨的贊助。
	bow $n
endif
~
>bribe_prog 11000~
if is_qmark($i) == talking
	tell $n 你等等，我一次只能跟一個人說話。
	mpgold $n 11000
	break
endif
if is_qmark($n) & adv_guild_level 300002
	mpadd_qmark self talking
	mpcallout 6 mpdel_qmark self talking
	mpechoat $n $I隨手點了點你給的金額...
	tell $n 沒問題，這就把我所知道的告訴你。
	mpcallout 1 tell $n 的黑森林。
	mpcallout 1 tell $n 奪貨物。而其中最常發生襲擊事件的地點是在進入塔前所必經
	mpcallout 1 tell $n 最近時常發生從史卡拉貝到永恆之塔的商隊在路上遭人襲擊搶
	mpcallout 2 tell $n 與附近的曼托爾牛頭人及獸人部落交易為生。
	mpcallout 2 tell $n 在森林的周邊建立了一個小型的據點，並靠著搶劫過路人還有
	mpcallout 2 tell $n 據有利的情報指出，攻擊商隊的是一群從北方來的山賊，他們
	mpcallout 3 tell $n 大規模掃蕩也會存在一定的壓力。
	mpcallout 3 tell $n 在曼托爾堡壘跟獸人部落之間，因此就算是公會想對他們進行
	mpcallout 3 tell $n 之前就已經有在注意他們的動向了，不過由於他們所處的地點
	mpcallout 3 tell $n 事實上，這支北方來的山賊還頗有"名氣"的，所以公會在很早
	mpcallout 4 tell $n 不像一盤散沙，因此危險性也不是一般的小混混比得上的。
	mpcallout 4 tell $n 另外這支山賊之所以強大是因為他們具有一定程度的組織性，
	mpcallout 5 tell $n 一些老練的成員，應該能提供你不少情報(robber camp)。
	mpcallout 5 tell $n 你如果想知道更多關於這群山賊的習性，可以去公會中試著問
	mpcallout 6 tell $n 以上就是我知道的所有內容了。
else
	tell $n 感謝您康慨的贊助。
	bow $n
endif
