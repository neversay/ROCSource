>obj_rand 100~
if objextra(self , v0) == 5
	echoat $n 你的身體正在大量出血。
	echoaround $n $N的身體莫名的大量出血。
	oforcer here modhmv $n 03.50 50 0
	oforcer here modhmv $n 01.500 500 0
endif
if objextra(self , v0) == 4
	opmodvt self v0 + 1
	echoat $n 你的身體正在大量出血。
	echoaround $n $N的身體莫名的大量出血。
	oforcer here modhmv $n 03.40 40 0
	add_affect $n 'blood thirsty' 1040 -1 19 5 0
endif
if objextra(self , v0) == 3
	opmodvt self v0 + 1
	echoat $n 你的身體正在大量出血。
	echoaround $n $N的身體莫名的大量出血。
	oforcer here modhmv $n 03.35 35 0
	add_affect $n 'blood thirsty' 1040 -1 19 5 0
endif
if objextra(self , v0) == 2
	opmodvt self v0 + 1
	echoat $n 你的身體正在大量出血。
	echoaround $n $N的身體莫名的大量出血。
	oforcer here modhmv $n 03.30 30 0
	add_affect $n 'blood thirsty' 1040 -1 19 5 0
endif
if objextra(self , v0) == 1
	opmodvt self v0 + 1
	echoat $n 你的身體正在大量出血。
	echoaround $n $N的身體莫名的大量出血。
	oforcer here modhmv $n 03.25 25 0
	add_affect $n 'blood thirsty' 1040 -1 19 5 0
endif
~
>obj_command oblation default~
if is_equ_obj($n) == 35129
	if hpnum($n) >= 900
		opmodvt self v0 + 1
		echoat $n 你的身體突然開始大量出血，但隨之得到一股強大的力量。
		echoaround $n $N的身體莫名的大量出血。
		oforcer here modhmv $n 01.1000 1000 0
		add_affect $n 'blood thirsty' 1040 -1 19 5 0
	else
		echoat $n 你的生命力不足。
	endif
else
	echoat $n 你必須要穿著短刀才能獻血。
endif
~
>obj_act remove~
if objextra(self , v0) >= 1
	echoat $n 你的身體停止出血。
	del_affect $n 'blood thirsty'
	opmodvt self v0 = 0
endif
~
|

