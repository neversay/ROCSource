>talk_prog p my road~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 200004
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 這是一位法師公會的巫師所委託的內容。他希望公會派人幫他到各地找尋一些
			tell $n 魔法書。酬勞的部分，由於委託人已經交給公會基本的仲介費了....所以他希
			tell $n 望能夠自己將酬勞發給委派人員。
			mpcallout 1 tell $n 據說工作內容簡單，報酬以十萬起跳，至於是不是真的，我們也不知道。
			mpcallout 2 tell $n hmm
			mpcallout 3 tell $n 此後續的酬勞也不是由我們給付給你。
			mpcallout 3 tell $n 也就是說，當你與委託人接觸的當下，本公會就會認定你已經完成任務了。因
			mpcallout 5 mpechoat $n 櫃檯小姐自言自語的唸著：能多一些只要仲介服務的人，我就可以更輕鬆了呢。
		else
			break
		endif
	else
		break
	endif
else
	break
endif
