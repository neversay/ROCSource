#35014
virgin-commerce mage-commerce~
新手魔法師(virgin mage)~
新手魔法師(mage)在這裡仔細的整理裝備。
~
這是他第一次接受公會的任務，在心情上難免有些緊張，所以很仔細的整理
裝備，避免在任務上出現差錯。也許你可以找他搭話看看，問他有沒有什麼
事情需要你幫忙。
~
1|2|64 0 800 S
30 0 5000 0d0+0 0d0+0
1000 0
0 8 1
C 2
R Human~
>rand_prog 5~
if rand(60)
	think
	mpcallout 1 say 我不會使用治癒術，在任務中受傷會很麻煩。
	mpcallout 2 say 看來還是去補充一些藥水會比較保險。
else
	think
	callout 1 say 這次的任務是探查禁斷之塔。
	callout 2 say 聽前輩說那裡的空間會阻隔聲音傳播而讓人無法說話、念咒。
	callout 3 say 我身為魔法師卻無法使用魔法..這可真讓人頭疼呢...
	callout 4 think
	callout 5 say 看來還是要去一趟光明之鎮購買一些暢言藥丸才行。
endif
~
>talk_prog topic~
if rand(60)
	mpechoat $n $I正在專心的整理裝備，沒注意到你。
	break
else
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) == commerce_noob_mage 300001
		or is_qmark($n) & commerce_subquest 100001
			if is_qmark($n) == commerce_noob_mage
				mpdel_qmark $n commerce_noob_mage
				if is_qmark($n) != commerce_subquest
					mpadd_qmark $n commerce_subquest -1 1 0 0 0 1
				else
					mpmod_qmark $n commerce_subquest v0 | 1
				endif
			endif
			say 上次真是麻煩你了。
			bow $n
		else
			if is_qmark($n) != commerce_noob_mage
				mpechoat $n $I整理裝備到一半，發現你站在身旁。
				mpadd_qmark $n commerce_noob_mage -1 1 0 0 0 1
				mpcallout 1 say 請問有事嗎？
				mpcallout 1 say 你也是公會的冒險者吧？
				mpcallout 1 ? $n
				mpcallout 2 mpechoat $n 看見他緊張的樣子，也許能問他有沒有需要你幫忙的地方(help)。
			else
				mpechoat $n $I正在專心的整理裝備，沒注意到你。
				break
			endif
		endif
	else
		if is_qmark($n) == commerce_enemy
			if is_qmark($n) == commerce_noob_mage 300001
			or is_qmark($n) & commerce_subquest 100001
				if is_qmark($n) == commerce_noob_mage
					mpdel_qmark $n commerce_noob_mage
					if is_qmark($n) != commerce_subquest
						mpadd_qmark $n commerce_subquest -1 1 0 0 0 1
					else
						mpmod_qmark $n commerce_subquest v0 | 1
					endif
				endif
				say 上次真是麻煩你了！聽說你脫離公會了？祝你找到更好的歸宿。
				bow $n
			else
				if is_qmark($n) == commerce_noob_mage
					mpechoat $n $I整理裝備到一半，發現你站在身旁。
					mpdel_qmark $n commerce_noob_mage
					if is_qmark($n) != commerce_subquest
						mpadd_qmark $n commerce_subquest -1 0 1 0 0 1
					else
						mpmod_qmark $n commerce_subquest v1 | 1
					endif
					mpcallout 1 bow $n
					mpcallout 1 say 你居然已經不是公會成員了，上次未完成的委託也不好意思麻煩你了。
				else
					break
				endif
			endif
		else
			say 你不是公會的冒險者吧？請問有事嗎？
			mpcallout 1 ? $n
			break
		endif
	endif
endif
~
>talk_prog help~
if is_qmark($n) == commerce_noob_mage 100001
	mpmod_qmark $n commerce_noob_mage v0 = 2
	tell $n 事情是這樣的....
	mpcallout 1 tell $n 如你所見我是一個魔法師，如果沒辦法使用魔法，這次的任務可能會無法完成。
	mpcallout 1 tell $n 但是我聽公會的前輩說，在塔內聲音無法順利的傳導，因此也不能詠唱魔法。
	mpcallout 1 tell $n 這次是我第一次接公會的任務，內容是探查禁斷之塔。
	mpcallout 2 ponder
	mpcallout 3 tell $n 請問可以嗎？(yes/no)
	mpcallout 3 tell $n 如果方便的話，想麻煩你幫我帶十顆回來。
	mpcallout 3 tell $n 但是我還有其他的東西要準備，沒有時間去光明之鎮一趟。
