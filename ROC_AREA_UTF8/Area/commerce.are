>give_prog 35053~
if is_qmark($n) & adv_quest_object 200008
	if is_qmark($n) & adv_quest_object 200001
		mpechoat $n 你如實回報看過的內容。
		mpcallout 1 tell $n 是是是...那麼這麼簡單的任務你一定會接吧？
		mpcallout 1 mpechoat $n $I冷冷地看著你說：
		mpcallout 2 tell $n 想必閣下必定能成功，不需要另外準備任務失敗金吧。
		mpcallout 3 mpechoat $n $I低下頭繼續忙自己的事。
		mpdel_qmark $n adv_quest_object
		mpjunk letter2-receptionist
	else
		mpechoat $n 你如實回報看過的內容。
		mpcallout 1 tell $n 連委託內容都看不懂也難怪沒有冒險者敢承接。
		mpcallout 1 tell $n 你看，奧夫卡人寫的字果然很醜吧！
		mpcallout 2 shrug
		mpcallout 4 tell $n 如果依然要接我也不會阻止你，記得失敗後要付錢就是了。
		mpdel_qmark $n adv_quest_object
		mpjunk letter2-receptionist
	endif
endif
