>room_defun check_world_stars~
if roomvalue($n10328v1) < 0
	break
endif
if day($) == 6
	if hour($) > 21
	or hour($) < 3
		if month($) == 14
			if rand(9)
				mod_qmark $n find_count v0 + 1
				mod_qmark $n find_count v1 + 1
				at 10328 modrvt v1 - 1
			endif
		else
			if rand(6)
				mod_qmark $n find_count v0 + 1
				mod_qmark $n find_count v1 + 1
				at 10328 modrvt v1 - 1
			endif
		endif
	endif
else
	if hour($) > 21
	or hour($) < 3
		if rand(3)
			mod_qmark $n find_count v0 + 1
			mod_qmark $n find_count v1 + 1
			at 10328 modrvt v1 - 1
		endif
	endif
endif
~
