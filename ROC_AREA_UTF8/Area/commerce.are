0 0 35046
>room_time 100~
if month($) == 0
or month($) == 1
or month($) == 2
or month($) == 3
	modrvt v0 = 1
	setroom desc N 眼前的石階被白雪掩蓋，走起來格外危險，步道周邊的枝頭上結出大量晶瑩
	setroom desc A 剔透的樹冰，通過光線折射，產生出如夢似幻的美麗場景，朝山下看去能將整座
	setroom desc A 商會廣場盡收眼底。
endif
if month($) == 4
or month($) == 5
or month($) == 6
or month($) == 7
or month($) == 8
	modrvt v0 = 2
	setroom desc N 你走在鳥語花香的山丘上。草木在轉暖的季節百花綻放，把石階步道點綴得
	setroom desc A 五彩繽紛。身邊不時有健行的登山客擦身而過，人們把握春暖花開的時節盡情地
	setroom desc A 享受大自然。朝山下看去，能將擠滿人潮的商會廣場盡收眼底，又來到春季特賣
	setroom desc A 的時節了。
endif
if month($) == 9
or month($) == 10
or month($) == 11
or month($) == 12
	modrvt v0 = 3
	setroom desc N 你走在涼爽的綠蔭步道中。生長茂密的樹林形成自然的遮蔽物，阻隔陽光直
	setroom desc A 照地面，林木間不時傳來此起彼落的蟬鳴，成為自然的協奏曲。炎熱的日子裡，
	setroom desc A 待在樹蔭乘涼是再適合不過了。朝山下看去，能將擁擠的商會廣場盡收眼底，廣
	setroom desc A 場的人潮散發出的熱量，足以讓空氣產生波紋。
endif
if month($) == 13
or month($) == 14
or month($) == 15
or month($) == 16
	modrvt v0 = 4
	setroom desc N 你走在佈滿落葉的石階道。微風吹過道旁的芒草，在眼前形成金色的浪潮。
	setroom desc A 山林的植被開始轉黃，不時隨風搖曳，發出蕭瑟的颯颯聲，帶來些鄉愁。身旁不
	setroom desc A 時有採集樹果的農民，想在凜冬降臨前囤積食糧。朝山下看去，能將人群稀疏的
	setroom desc A 商會廣場盡收眼底。年末將近，大多數外國商人已踏上歸途。
endif
if month($) == 4
	if day($) <= 10
		if roomvalue($0) != 5
			modrvt v0 = 5
			setroom desc N 覆蓋山丘的白雪緩緩消退，地面上探出新綠的嫩芽。雖然氣溫開始轉暖，但
			setroom desc A 融雪的時節依然能感受到空氣帶有寒意。朝山下看去，能將整座商會廣場盡收眼
			setroom desc A 底。歸鄉的商人們漸漸返回商會，準備起一年一度的特賣會。
		endif
	endif
endif
if month($) == 8
	if day($) >= 15
		if roomvalue($0) != 6
			modrvt v0 = 6
			setroom desc N 石階上有許多被雨水打落的花苞，潮濕的地面傳來泥土的氣息。氣溫開始變
			setroom desc A 高，花朵逐漸萎縮，結起青澀的果實。朝山下看去，能將人潮眾多的商會廣場盡
			setroom desc A 收眼底。
		endif
	endif
endif
if month($) == 12
	if day($) >= 15
		if roomvalue($0) != 7
			modrvt v0 = 7
			setroom desc N 翠綠的草木逐漸泛黃，樹果漸漸成熟。潮溼的空氣吹起涼風，山丘上的日夜
			setroom desc A 溫差開始變大。朝山下看去，能將忙碌的商會廣場盡收眼底。年末將近，商人們
			setroom desc A 籌備著出清活動，作為今年的最後一搏。
		endif
	endif
endif
if month($) == 16
	if day($) >= 20
		if roomvalue($0) != 8
			modrvt v0 = 8
			setroom desc N 泛黃的草木皆已枯萎，風景轉變為單調的冷色系。山丘刮起刺骨的寒風，不
			setroom desc A 時還會飄起粉雪。朝山下看去，能將冷清的商會廣場盡收眼底。氣候轉冷，宣告
			setroom desc A 著一年即將結束。
		endif
	endif
endif
~
|
