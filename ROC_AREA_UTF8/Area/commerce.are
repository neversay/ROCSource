~
>talk_prog reward~
if is_qmark($n) == adv_mission_reward
	if is_qmark($n) == commerce_enemy
		mpdel_qmark $n adv_mission_reward
		mpdel_qmark $n adv_mission_mark
		mpdel_qmark $n adv_do_mission
		mpdel_qmark $n adv_do_mission_2
		mpdel_qmark $n adv_do_mission_3
		tell $n 你已經脫離公會了，所以完成任務我們也不發放獎賞。
		sorry $n
	else
		mpcall guild_reward_list $n
	endif
else
	break
endif
~
>talk_prog p obtaining scroll~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 100001
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 這是一位史卡拉貝的青年所委託公會的任務。希望公會能幫忙取得一件卷軸，
			tell $n 委託人開出的價碼為１０萬金幣。公會將此任務的難度分類為最低等級的Ｅ級
			tell $n 寶物尋找任務。
		else
			break
		endif
	else
		break
	endif
else
	break
endif
~
>talk_prog p accept 01~
if is_qmark($n) != adv_quest_object
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) != adv_mission_mark
			if is_qmark($n) !& adv_mission_complete 100001
				mpadd_qmark $n adv_mission_mark -1 1 0 0 0 1
				tell $n 好的，我立即幫您登記上此任務。
				mpechoat $n $I翻開了桌上的任務記錄本將你的名字登記上去。
				tell $n 委託人的特徵為黑髮、年輕，他會在每日的早上十點至下午兩點之間於史卡拉
				tell $n 貝露天咖啡廳等你出現。請於接洽時說來自於公會(adventurer guild)，他就
				tell $n 會把詳細的任務內容告訴你了。
			else
				break
			endif
		else
			break
		endif
	else
		break
	endif
else
	tell $n 你還沒把上次的東西還給我喔！你該不會弄丟了吧？這樣要賠我１０萬金幣！
endif
~
>talk_prog p noble hobby~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 100002
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 這個是來自於一位史卡拉貝貴族的依賴，委託人希望能取得黑曜石山丘的火蠑
			tell $n 螈打造的一柄斧頭。據他的敘述，這柄斧頭碰到心地善良的人會自動彈開....
			mpcallout 1 mpechoat $n 櫃檯小姐自言自語的說：「這還真是奇特的癖好....」
			mpcallout 2 mpechoat $n $I發現你在看著她，立刻停止腦內的幻想，繼續解釋任務給你聽。
			mpcallout 3 tell $n 程中必定會發生戰鬥，所以委託人願意開２０萬的獎金為酬勞。
			mpcallout 3 tell $n 是說把你取得的斧頭交給我就行囉！雖然任務的難度被公會評定為Ｄ級，但過
			mpcallout 3 tell $n 這位委託人不希望讓別人知道自己的身份，因此斧頭將由公會代為收取。也就
			mpcallout 4 mpechoat $n 櫃檯小姐小聲的說了一句：「有錢人果然都是變態呢....」
		else
			break
		endif
	else
		break
	endif
else
	break
endif
~
>talk_prog p accept 02~
if is_qmark($n) != adv_quest_object
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) != adv_mission_mark
			if is_qmark($n) !& adv_mission_complete 100002
				mpadd_qmark $n adv_mission_mark -1 2 0 0 0 1
				mpadd_qmark $n adv_do_mission -1 0 0 2 0 1
				tell $n 好的，我立即幫您登記上此任務。
				mpechoat $n $I翻開了桌上的任務記錄本將你的名字登記上去。
				tell $n 那麼快將任務中的斧頭帶回來吧！
				addoil $n
			else
				break
			endif
		else
			break
		endif
	else
		break
	endif
else
	tell $n 你還沒把上次的東西還給我喔！你該不會弄丟了吧？這樣要賠我１０萬金幣！
endif
