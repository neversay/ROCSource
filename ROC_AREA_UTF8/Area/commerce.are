~
>talk_prog topic~
if is_qmark($i) != ped_talking
	mpadd_qmark self ped_talking 1 0 0 0 0 1
	if area($i) == commerce
		tell $n 你好，我是個專門從國外進口舶來品的商人。
		tell $n 現在正為了下次出遠門作準備。
		mpcallout 1 tell $n 如果你有需要我可以賣給你。
		mpcallout 1 tell $n 我現在備有一些從外國進口的東西(things)。
		mpcallout 1 mpdel_qmark self ped_talking
	endif
	if area($i) == mega1
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			if rand(50)
				ponder
				mpcallout 1 tell $n 現任的市長真是糟蹋了這個有文化的美好城都呢。
				mpcallout 1 tell $n 沒想到從前的歷史古都─麥格城，現在居然變成治安那麼差的地方了....
				mpcallout 3 sigh
				mpcallout 3 mpdel_qmark self ped_talking
			else
				tell $n 我聽人說過，以前商人要來麥格城貿易不像現在都走海路。
				tell $n 而是穿過史卡拉貝東邊的矮人森林及峽谷接到東方沙漠從而進城。
				mpcallout 1 tell $n 但這條路線充滿盜匪跟野獸而逐漸被商人們破棄。
				mpcallout 3 tell $n 如果你有興趣可以去找看看。
				mpcallout 3 tell $n 不知道這條歷史悠久的古道還存不存在呢。
				mpcallout 3 mpdel_qmark self ped_talking
			endif
		endif
	endif
	if area($i) == forest
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 雖然大家都以為蠻荒森林的人未開化，很野蠻不容易接近。
			tell $n 但只要了解一下他們的語言跟文化，就會發現這裡的人對外來客還滿友善的呢！
			mpcallout 1 giggle
			mpcallout 2 tell $n 所以我時常會來這裡跟他們以物易物進行交易。
			mpcallout 2 mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == hobbitcity
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 真不愧是美食之都賽伐斯拖普！
			tell $n 不管來幾次，這裡的東西都一樣好吃呢！
			mpcallout 1 mpdel_qmark self ped_talking
			mpcallout 1 mmm
		endif
	endif
	if area($i) == elftown
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 精靈的排他性很強，所以在村中比起其他地方相對安全很多。
			tell $n 因為這種一板一眼的種族個性，從交易上來說也絕對是公平公正！
			tell $n 而且這裡也算是個好地方呢！能沐浴在森林中，吸收很多的芬多精讓人心情放鬆！
			mpcallout 1 mpechoat $n $I深深的吸了一口氣。
			mpcallout 2 mpdel_qmark self ped_talking
			mpcallout 3 smile
		endif
	endif
	if area($i) == wyvern
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 雖然這裡只是一個小小的交易所，不算是個村莊，所以也沒什麼客人會來買東西。
			tell $n 但可以買到很多不錯的皮毛，所以我偶爾還是會來跟當地的獵人交易。
			mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == eternity
		if inroom($i) == 13599
			if rand(25)
				tell $n 你好，我是個從史卡拉貝來的商人。
				mpcallout 1 tell $n 如果有需要可以參考看看！
				mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
				mpcallout 1 mpdel_qmark self ped_talking
			else
				tell $n 從塔底逛到這，覺得永恆之塔經營者真是個充滿商業頭腦厲害傢伙！
				tell $n 不僅以魔法訓練收取大量學費，連最底層都作為一般平民的遊樂場。
				tell $n 真是值得商人們效法的經營模式。
				mpcallout 1 tsk
				mpcallout 1 mpdel_qmark self ped_talking
			endif
		else
			if rand(25)
				tell $n 你好，我是個從史卡拉貝來的商人。
				mpcallout 1 tell $n 如果有需要可以參考看看！
				mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
				mpcallout 1 mpdel_qmark self ped_talking
			else
				tell $n 永恆之塔一樓的遊戲不只是有娛樂的功能，還充滿一些挑戰性呢！
				tell $n 更重要的是，遊戲的獎勵裡又都是相當優良的魔法物品。
				mpcallout 1 think
				mpcallout 2 tell $n 也許就是靠著名貴的獎品來吸金的吧。
				mpcallout 2 mpdel_qmark self ped_talking
			endif
		endif
	endif
	if area($i) == greenwoods
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 妖精靠著纖細的身軀，能靈活的在森林中穿梭。
			tell $n 也因此只有他們才能找到許多森林中罕見的草藥。
			mpcallout 1 mpdel_qmark self ped_talking
			mpcallout 1 beer self
		endif
	endif
	if area($i) == shire
		if rand(25)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 由於史卡拉貝人口密度過高，所以當時才建立起這個囤墾區。
			tell $n 據說當時許多名工匠為了開發此地，也跟著搬遷到這裡定居。
			mpcallout 2 tell $n 且來這裡的目的也是為了請他幫忙製作一些商品。
			mpcallout 2 tell $n 像是在這我就認識一位隨著移居潮搬來的工匠，
			mpcallout 2 mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == hitower
		if rand(40)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 2 tell $n 如果有需要可以參考看看！
			mpcallout 2 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 2 mpdel_qmark self ped_talking
		else
			hmm
			mpcallout 1 tell $n 因此他們也不能保證旅人的安全....
			mpcallout 1 tell $n 這座高塔僅讓旅客待在一樓，再往上的話會有許多魔法生物，
			mpcallout 3 tell $n 據說位於塔層越高的法師能力就越強大，通常有所求才會冒險進入高樓層。
			mpcallout 3 mmm
			mpcallout 5 tell $n 但是魔法加持的費用非常驚人，以我的財力也沒辦法讓每件商品都接受強化。
			mpcallout 5 tell $n 而有些在高樓層的法師會抽空下來這個酒吧休息，我都是這時候委託他們加持商品。
			mpcallout 5 tell $n 不過像我這種小商人只要能進來就足夠了！來這是為了請塔中的法師用魔法幫商品強化，
			mpcallout 7 sigh
			mpcallout 7 tell $n 而且作為商品還是得考慮一下客群才行....畢竟也不是人人都買得起高價品。
			mpcallout 7 mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == ofcol
		if rand(30)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 2 tell $n 如果有需要可以參考看看！
			mpcallout 2 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 2 mpdel_qmark self ped_talking
		else
			tell $n 奧夫卡村相對於都市化較高的地方，人民相對比較純樸。
			tell $n 而且他們產的農產品與史卡拉貝有著極大的差異，因此在
			tell $n 史卡拉貝也算是相當有人氣呢！
			mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == ofcol2
		if rand(30)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 2 tell $n 如果有需要可以參考看看！
			mpcallout 2 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 2 mpdel_qmark self ped_talking
		else
			tell $n 因為嚴格的治安，想進入奧夫卡城作生意要先經過層層的審查。
			tell $n 而且人民當相當的高傲，跟他們交易真得是很累人...
			sigh
			mpcallout 2 tell $n 如果沒必要，我還真得不想來這裡呢....
			mpcallout 2 mpdel_qmark self ped_talking
		endif
	endif
	if area($i) == eastern
		if rand(30)
			tell $n 你好，我是個從史卡拉貝來的商人。
			mpcallout 1 tell $n 如果有需要可以參考看看！
			mpcallout 1 tell $n 我手上有一些從外國進口的舶來品(things)。
			mpcallout 1 mpdel_qmark self ped_talking
		else
			tell $n 如果不是要前往麥格城還真不想來東方大沙漠呢....
			tell $n 空氣散發的熱度都快可以烤肉了！
			mpcallout 1 sweat
			mpcallout 2 tell $n 只有先在這休息一下再出發了。
			mpcallout 2 tell $n 而且出海本身也是件很累人的事...
			mpcallout 2 mpdel_qmark self ped_talking
		endif
	endif
else
	mpechoat $n 他正在忙，沒空理你。
endif
~
>defun_prog adv_pedd_things~
if is_qmark($i) > ped_herbs 100000
	mpechoat $n 　　＄10000　治療疾病的草藥(cure herb)
endif
if is_qmark($i) > ped_herbs 200000
	mpechoat $n 　　＄10000　回復體力的草藥(heal herb)
endif
if is_qmark($i) > ped_herbs 300000
	mpechoat $n 　　＄30000　充滿魔力的草藥(mana herb)
endif
if is_qmark($i) & ped_things 100001
	mpechoat $n 　　＄200000　妝扮用的髮帶(headband)
endif
if is_qmark($i) & ped_things 100002
	mpechoat $n 　　＄200000　輕便的皮甲(vest)
endif
if is_qmark($i) & ped_things 100004
	mpechoat $n 　　＄200000　旅行用的手杖(cane)
endif
if is_qmark($i) & ped_things 100008
	mpechoat $n 　　＄200000　射箭用的指套(finger tab)
endif
if is_qmark($i) & ped_things 100016
	mpechoat $n 　　＄200000　防禦力不錯的綴甲(lamellar armour)
endif
if is_qmark($i) & ped_things 100032
	mpechoat $n 　　＄200000　防禦力不錯的脛甲(leggings)
endif
if is_qmark($i) & ped_things 100064
	mpechoat $n 　　＄500000　輕巧的秘銀鎖子甲(chain mail)
endif
if is_qmark($i) & ped_things 200001
	mpechoat $n 　　＄500000　魔法強化過的拳爪(claw)
endif
if is_qmark($i) & ped_things 200002
	mpechoat $n 　　＄500000　魔法強化過的法杖(staff)
endif
if is_qmark($i) & ped_things 200004
	mpechoat $n 　　＄500000　魔法強化過的長兵器(long weapon)
endif
if is_qmark($i) & ped_things 200008
	mpechoat $n 　　＄500000　魔法強化過的鞭子(whip)
endif
if is_qmark($i) & ped_things 200016
	mpechoat $n 　　＄500000　魔法強化過的箭(arrow)
endif
if is_qmark($i) & ped_things 200032
	mpechoat $n 　　＄800000　閃亮的魔法短劍(magical dagger)
endif
~
>talk_prog things~
if is_qmark($i) != ped_talking
	tell $n 想要的東西直接告訴我名字就好了，錢會直接跟你收。
	tell $n 我現在手上有：
	mpcall adv_pedd_things $n
else
	mpechoat $n 他正在忙，沒空理你。
endif
~
>talk_prog p about herbs~
if is_qmark($i) != ped_talking
	mpadd_qmark self ped_talking 1 0 0 0 0 1
	tell $n 你是問草藥嗎？
	mpcallout 1 hmm
	mpcallout 2 tell $n 我本身有跟人學過一點點草藥學，所以這些草藥都是在旅行的途中看到採來的。
	mpcallout 3 shurg
	mpcallout 3 tell $n 雖然懂一些，但我可以精準辨識的草藥只有三種，所以目前能賣的也只有三種。
	mpcallout 4 tell $n 主要是有不少店家都會用到。
	mpcallout 4 tell $n 菫紫色(pansy)草藥及帶有魔力但具毒性的胭紅色(carmine)草藥。會進這些草藥
	mpcallout 4 tell $n 至於三種草藥分別是具有排毒能力的淺綠色(palegreen)草藥、加速傷口復原的
	mpcallout 5 tell $n 那位廚師常購買胭紅色草藥，不過還真搞不懂餐廳要這個作什麼....
	mpcallout 5 tell $n 具我所知，常常買草藥的客人是史卡拉貝商會的魔法店跟某間餐廳的廚師。其中
	mpcallout 6 tell $n 總之，也許你可以自己去請教(teach herbs)他們看看。
	mpcallout 6 mpdel_qmark self ped_talking
else
	mpechoat $n 他正在忙，沒空理你。
endif
~
>talk_prog p cure herb~
if cancarry($n) <= 0
or canweight($n) < 1
	mpechoat $n 你無法再拿動更多東西了.
	break
endif
if is_qmark($i) != ped_talking
	if is_qmark($i) >= ped_herbs 100001
		if goldamt($n) >= 10000
			mpmod_qmark self ped_herbs v0 - 1
			mpgold $n -10000
			mpoload 35071 $n 1 target
			mpechoat $n $I給了你一株草藥。
		else
			tell $n 你的錢不夠喔。
		endif
	else
		tell $n 我現在沒有賣這個東西喔。
	endif
else
	mpechoat $n 他正在忙，沒空理你。
endif
