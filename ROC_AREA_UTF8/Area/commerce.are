	mpmod_qmark $n adv_mission_reward v1 r 16
	mpgold $n 500000
	mpexp $n 10000
	mpskillexp $n 2000
endif
if is_qmark($n) & adv_mission_reward 300001
	tell $n 你完成取得卷軸的任務，因此可以獲得１０萬金幣。
	mpmod_qmark $n adv_mission_reward v1 r 1
	mpgold $n 100000
	mpexp $n 10000
	mpskillexp $n 2000
endif
if is_qmark($n) & adv_mission_reward 300002
	tell $n 你完成貴族的嗜好的任務，因此可以獲得２０萬金幣。
	mpmod_qmark $n adv_mission_reward v1 r 2
	mpgold $n 200000
	mpexp $n 10000
	mpskillexp $n 2000
endif
if is_qmark($n) & adv_mission_reward 300004
	tell $n 你完成代理送貨的任務，因此可以獲得１０萬金幣。
	mpmod_qmark $n adv_mission_reward v1 r 4
	mpgold $n 100000
