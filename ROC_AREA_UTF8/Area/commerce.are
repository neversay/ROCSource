>give_prog 2911~
if is_qmark($n) == adv_do_mission 300002
	mpdel_qmark $n adv_do_mission
	mpdel_qmark $n adv_mission_mark
	mpmod_qmark $n adv_mission_complete v0 | 2
	mpmod_qmark $n adv_mission_reward v0 | 2
	cong $n
	tell $n 恭喜您完成了委託，現在可以領取獎賞囉！(reward)
	mpjunk axe
	mpcallout 1 mpechoat $n 櫃檯小姐最後喃喃的唸了一句：「唉...副會長居然要我親自把東西交給變態貴族....」
else
	tell $n 你給我這個幹嘛？
	mpechoat $n $I心情不悅的將東西摔出櫃檯...
	drop $o
endif
~
>talk_prog p helping deliver~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 100004
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 這是由一位史卡拉貝食材商所委託的內容，他們負責商會大道的送貨員昨天在
			tell $n 路上被馬車撞斷了腿，一時找不到能幫忙送貨到商會大道的人，只能找公會幫
			tell $n 忙。不過今天只有商會大道高級餐廳的這一筆訂單，所以也不會太複雜。
			mpcallout 1 hmm
			mpcallout 2 tell $n 簡單來說，他需要一名負責幫餐廳主廚跑腿的人！
			mpcallout 3 tell $n 任務完成後，委託人願意出１０萬金幣及預先支付跑腿所需的車資及購物金。
			mpcallout 4 tell $n 為時間拖太久食材會不新鮮，而使他們的商譽受損。
			mpcallout 4 tell $n 但本任務是有時限性的，他們要求跟餐廳主廚接洽後要於１２小時內完成，因
			mpcallout 5 tell $n 在此提醒，如果無法如期完成則會變成任務失敗，公會將收１０萬金幣作為補償。
		else
			break
		endif
	else
		break
	endif
else
	break
endif
