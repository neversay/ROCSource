#35041
anxious-comm merchant-comm~
焦慮的商人(anxious merchant)~
一位看起來心情很糟的商人(merchant)在這裡咒罵著。
~
他是個有點胖的商人，不知道碰到什麼鳥事，一整個氣急敗壞的樣子。
~
1|64 8|32 -200 S
20 200000 0 0d0+0 -200d-10000+0
0 0
0 8 1
>repop_prog 100~
mpadd_qmark self change_present -1 0 0 0 0 1
~
>tick_prog 100~
if rand(20)
	if rand(50)
		mpmod_qmark self change_present v0 + 2
	endif
	mpmod_qmark self change_present v0 + 1
	if is_qmark($i) >= change_present 100010
		mpmod_qmark self change_present v0 = 0
		say 該不會是剛剛被扒走(steal)了....
		break
	endif
	if is_qmark($i) == change_present 100000
	or is_qmark($i) == change_present 100002
	or is_qmark($i) == change_present 100004
	or is_qmark($i) == change_present 100006
	or is_qmark($i) == change_present 100008
		say 可惡...掉哪去了...按鈕也還沒找到...
	endif
	if is_qmark($i) == change_present 100001
	or is_qmark($i) == change_present 100003
	or is_qmark($i) == change_present 100005
	or is_qmark($i) == change_present 100007
	or is_qmark($i) == change_present 100009
		mpecho $I朝地面四處尋找東西。
	endif
endif
~
>rand_prog 5~
mpmod_qmark self change_present v0 + 1
if rand(50)
	mpmod_qmark self change_present v0 + 2
endif
if is_qmark($i) >= change_present 100010
	mpmod_qmark self change_present v0 = 0
	say 該不會是剛剛被扒走(steal)了....
	break
endif
if is_qmark($i) == change_present 100000
or is_qmark($i) == change_present 100002
or is_qmark($i) == change_present 100004
or is_qmark($i) == change_present 100006
or is_qmark($i) == change_present 100008
	say 可惡...掉哪去了...按鈕也還沒找到...
endif
if is_qmark($i) == change_present 100001
or is_qmark($i) == change_present 100003
or is_qmark($i) == change_present 100005
or is_qmark($i) == change_present 100007
or is_qmark($i) == change_present 100009
	mpecho $I朝地面四處尋找東西。
endif
~
>talk_prog topic~
if rand(50)
	tell $n 你有沒有看到一個粉紅色的錢包？
else
	tell $n 我發現錢包不見了，在想是不是掉在哪了。
	tell $n 裡面有重要的通...
	tell $n 總之，要是你有看到請拿來給我。
	bow $n
endif
~
>talk_prog p member card~
if is_qmark($n) == sauc_info 100001
	dunno $n
endif
~
>talk_prog p steal~
if is_qmark($n) == sauc_info 100001
	if is_qmark($n) == sauc_info 200000
		tell $n 我在想錢包會不會被剛剛撞到我的人(man)偷了...
		mpmod_qmark $n sauc_info v1 = 1
		break
	endif
endif
tell $n 我錢包好像被偷了。
~
>talk_prog p man~
if is_qmark($n) == sauc_info 100001
	if is_qmark($n) == sauc_info 200001
		tell $n 應該不是，撞到我手掌時壓到(press)的觸感....
		drool
	endif
endif
~
>talk_prog p press~
if is_qmark($n) == sauc_info 100001
	if is_qmark($n) == sauc_info 200001
		fondle
		drool
	endif
endif
~
|

#35042
vexed-comm merchant-comm man-comm~
憂鬱的商人(vexed merchant)~
一位帥氣的年輕男子(man)若有所思地坐在水池邊。
~
他是一位年輕且外表高帥的男子，從穿著上你可以看出他的職業是商人，
而能夠住在錢尼街的商人通常都具備一定的財力。以他的條件看來，應該
就是所謂的高、富、帥吧。不過從他憂愁的表情上看來，似乎正被什麼事
情煩惱著。
~
1|2 8|32|64|32768|524288 800 S
20 200000 0 0d0+0 -200d-10000+0
0 0
0 8 1
S 41 100000
S 42 100000
P 1|2|4|8|64|128|512|1024|16384|32768|65536|131072|1048576|8388608|67108864|536870912|2147483648
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 0 0 0 0 1
~
>tick_prog 100~
if is_qmark($i) == vexed_talking
	break
endif
if is_qmark($i) == vexed_searching_npc
	if being($b)
	else
		say 居然中途跑掉了...
		mpdel_qmark self vexed_searching_npc
		mpdef_rembch null-tar
	endif
endif
if area($i) == commerce
	if hour($) == 17
		mpgoto 3141
		mpecho 憂鬱的商人(vexed merchant)來了。
	endif
endif
if area($i) == skarabrae
	if being($b)
		break
	else
		if hour($) >= 22
		or hour($) < 17
			mpecho 憂鬱的商人(vexed merchant)離開了這裡。
			mpgoto 35000
		endif
	endif
endif
~
>defun_prog vexed_reward_list~
if is_qmark($n) == adv_do_mission_2 100000
	tell $n 辛苦你了...雖然最後還是沒找到東西...但是你沒有功勞也有苦勞。
	tell $n 這是我給你的雇用費。
	bow $n
	mpgold $n 500
	mpexp $n 500
	mpskillexp $n 250
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
if is_qmark($n) == adv_do_mission_2 100001
	tell $n 感謝你的幫忙，這是給你的額外酬勞。
	tell $n 獎金再請你另外去公會領取。
	bow $n
	mpgold $n 10000
	mpexp $n 1000
	mpskillexp $n 1000
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpmod_qmark $n adv_mission_reward v1 | 2
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
if is_qmark($n) == adv_do_mission_2 100002
	tell $n 感謝你的幫忙，這是給你的額外酬勞。
	tell $n 獎金再請你另外去公會領取。
	bow $n
	mpgold $n 20000
	mpexp $n 2000
	mpskillexp $n 2000
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpmod_qmark $n adv_mission_reward v1 | 2
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
if is_qmark($n) == adv_do_mission_2 100003
	tell $n 感謝你的幫忙，這是給你的額外酬勞。
	tell $n 獎金再請你另外去公會領取。
	bow $n
	mpgold $n 30000
	mpexp $n 3000
	mpskillexp $n 3000
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpmod_qmark $n adv_mission_reward v1 | 2
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
if is_qmark($n) == adv_do_mission_2 100004
	tell $n 感謝你的幫忙，這是給你的額外酬勞。
	tell $n 獎金再請你另外去公會領取。
	bow $n
	mpgold $n 40000
	mpexp $n 4000
	mpskillexp $n 4000
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpmod_qmark $n adv_mission_reward v1 | 2
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
if is_qmark($n) == adv_do_mission_2 100005
	tell $n 感謝你的幫忙，沒想到你能幫我找回所有的東西！
	tell $n 這是給你的額外酬勞，獎金再請你另外去公會領取。
	tell $n 然後這個多出來的備品也送給你。
	bow $n
	mpdef_rembch null-tar
	mpgold $n 50000
	mpexp $n 5000
	mpskillexp $n 5000
	mpdel_qmark self vexed_searching_npc
	mpdel_qmark $n vexed_searching_pc
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_mission_failed
	mpmod_qmark $n adv_mission_reward v1 | 2
	mpadd_qmark $n ofcol_anc_eq -1 0 0 0 0 1
	if rand(25)
		mpoload 35094 $n 1 target
	else
		if rand(33)
			mpoload 35095 $n 1 target
		else
			if rand(50)
				mpoload 35096 $n 1 target
			else
				mpoload 35097 $n 1 target
			endif
		endif
	endif
	mpechoat $n $I塞了一個東西給你。
	mpcallout 1 mppurge self
	mpcallout 1 mpecho $I離開了這裡。
endif
~
>greet_prog 100~
if is_qmark($n) == adv_do_mission_2 300002
	if rembch($n)
		if is_qmark($i) != vexed_searching_npc
			tell $n 你來啦，三天的時間已經到了。
			mpcall vexed_reward_list
			break
		endif
		if is_inv_obj($n) == 2616
			mpechoat $n 你身上的黑色盒子自動飛到$I的身上！
			mpmod_qmark $n adv_do_mission_2 v0 + 1
			mppurge $n sealed-5-vexed
		endif
		if is_inv_obj($n) == 35090
			mpechoat $n 你身上的綠色盒子自動飛到$I的身上！
			mpmod_qmark $n adv_do_mission_2 v0 + 1
			mppurge $n sealed-1-vexed
		endif
		if is_inv_obj($n) == 35091
			mpechoat $n 你身上的紅色盒子自動飛到$I的身上！
			mpmod_qmark $n adv_do_mission_2 v0 + 1
			mppurge $n sealed-2-vexed
		endif
		if is_inv_obj($n) == 35092
			mpechoat $n 你身上的藍色盒子自動飛到$I的身上！
			mpmod_qmark $n adv_do_mission_2 v0 + 1
			mppurge $n sealed-3-vexed
		endif
		if is_inv_obj($n) == 35093
			mpechoat $n 你身上的黃色盒子自動飛到$I的身上！
			mpmod_qmark $n adv_do_mission_2 v0 + 1
			mppurge $n sealed-4-vexed
		endif
		if is_qmark($n) == adv_do_mission_2 100005
			mpcall vexed_reward_list
			break
		endif
	endif
endif
~
>talk_prog topic~
if is_qmark($i) == vexed_searching_npc
	if is_qmark($n) == adv_do_mission_2 300002
		if rembch($n)
			tell $n 還有時間，請慢慢找。但如果真得找不到請直接跟我說。(done)
			tell $n 這樣我至少還有時間可以請其他人幫忙，千萬不要不告而別。
			break
		else
			tell $n 你這個人怎麼突然說跑就跑了！
			tell $n 連作人的基本誠信都沒嗎？
			tell $n 去去去...我不想再看到你了！
			mpdel_qmark self vexed_searching_npc
			mpdel_qmark $n adv_do_mission_2
			mpdel_qmark $n adv_mission_mark
			break
		endif
	else
		mpechoat $n 他正在忙，沒空理你。
		break
	endif
else
	if is_qmark($n) == adv_do_mission_2 300002
		if rembch($n)
			tell $n 你來啦，三天的時間已經到了。
			mpcall vexed_reward_list
			break
		else
			tell $n 你這個人怎麼突然說跑就跑了！
			tell $n 連作人的基本誠信都沒嗎？
			tell $n 去去去...我不想再看到你了！
			mpdel_qmark $n adv_do_mission_2
			mpdel_qmark $n adv_mission_mark
			break
		endif
	endif
endif
if is_qmark($i) == vexed_talking
	break
endif
if is_qmark($n) == adv_mission_mark 200002
	mpadd_qmark self vexed_talking 4 0 0 0 0 0
	mpmod_qmark $n adv_mission_mark v1 = 0
	say 請問有什麼事嗎？
	mpcallout 1 mpechoat $n 你向$I表明自己是公會派來的人....
	mpcallout 2 bow $n
	mpcallout 2 tell $n 請容我自我介紹一下。
	mpcallout 2 tell $n 原來是公會派來的人呀！剛剛真是失禮了。
	mpcallout 3 tell $n 水及附魔道具等....
	mpcallout 3 tell $n 學習過魔法，所以我的主要業務是專門針對魔法物品，例如法杖、藥
	mpcallout 3 tell $n 我是一位在各國間作貿易的商人，因為我在成為商人前有在法師工會
	mpcallout 4 tell $n 有持續接受這類型的委託....
	mpcallout 4 tell $n 合商會的法令，但達成委託後，買家往往會給予雄厚的報酬。因此我
	mpcallout 4 tell $n 封印法器或詛咒物品的運送。雖然這類的委託風險較高，且有部份不
	mpcallout 4 tell $n 由於我所擁有魔法的經歷，讓我能另外接一些比較特別的委託。像是
	mpcallout 5 tell $n 魔法道具遺失....
	mpcallout 5 tell $n 但也因如此，在這次運送封印法器的過程中出了些差錯，而造成數件
	mpcallout 6 sigh
	mpcallout 7 tell $n 法仔細的說明任務的內容，也造成這個委託遲遲沒有冒險者敢接受。
	mpcallout 7 tell $n 因為我所作的事情在商會中是不合法的，所以我當時委託公會時沒辦
	mpcallout 8 tell $n 在找的過程中半途而廢，這樣我也比較好請其他人幫忙。(yes/no)
	mpcallout 8 tell $n 知道這是不合法的事情你還願意接受嗎？如果願意的話，我不希望你
	mpcallout 8 mpadd_qmark $n vexed_yes_no -1 0 0 0 0 1
else
	say 請問有什麼事嗎？
endif
~
>talk_prog yes~
if is_qmark($n) == vexed_yes_no
	if being($b)
		tell $n 已經有人再幫我找了。
		break
	endif
	mpadd_qmark self vexed_talking 2 0 0 0 0 0
	mpmod_qmark self vexed_talking timer = 2
	mpdel_qmark $n vexed_yes_no
	mpadd_qmark $n adv_do_mission_2 -1 0 0 2 0 1
	mpadd_qmark self vexed_searching_npc 75 0 0 0 0 1
	mpadd_qmark $n vexed_searching_pc -1 0 0 0 0 0
	mpadd_qmark $n adv_mission_failed -1 0 0 0 0 0
	mpmod_qmark $n adv_mission_complete v1 | 2
	mpdef_rembch $n
	tell $n 真是太謝謝你了，那麼我把上次經商的路線告訴你。
	mpcallout 1 tell $n 中，最後再由我用更大的箱子附魔加封。
	mpcallout 1 tell $n 作為我一部分的酬勞。貨物的包裝是分別將每件都放在封印過的盒子
	mpcallout 1 tell $n 其中一件是備品，要送到委託人手中的只有四件，如果完成後備品將
	mpcallout 1 tell $n 的魔法道具，他希望能請我幫忙送到麥格城中。內容物一共有五件，
	mpcallout 1 tell $n 我從史卡拉貝出發後，穿過西方森林，到達魔法高塔領取委託人交付
	mpcallout 2 tell $n 後從古道進入麥格城。
	mpcallout 2 tell $n 森林，途中有經過矮人王國休息了幾天，再到永恆之塔內辦些事，最
	mpcallout 2 tell $n 堡。在這些地方我還有接到其它的委託，因此我決定從東方穿過矮人
	mpcallout 2 tell $n 北區小鎮幽冥深淵附近、囤墾區、綠樹王國跟小妖精草原及銀蛇武士
	mpcallout 2 tell $n 帶著委託品，我從魔法高塔折回後，還經過一些城鎮作買賣，分別是
	mpcallout 3 tell $n 在裡面的五件委託品也因此不見了。
	mpcallout 3 tell $n 連日的趕路下，到達麥格城後，我發現大箱子居然產生了破洞，存放
	mpcallout 4 tell $n 盒子，而離解封大約還有三天的時間。
	mpcallout 4 tell $n 完全解封前都無法打開，不過慢慢的會變得連力量強的人都可以移動
	mpcallout 4 tell $n 易打開或移動的，但上面的封印會隨著時間推移而漸漸失效，雖然在
	mpcallout 4 tell $n 我的委託人表示這些盒子上有他施放的封印，所以一般人是沒辦法輕
	mpcallout 5 tell $n 回當然還是最好的啦。
	mpcallout 5 tell $n 真得一件也找不到我也會支付雇用你的酬勞(done)，不過有辦法全找
	mpcallout 5 tell $n 有所交代....如果真得沒辦法找回那麼多，我會計件給予酬勞，就算
	mpcallout 5 tell $n 所以我希望能在盒子魔力消散前盡可能的尋回四件好讓我能跟委託人
	mpcallout 6 mpechoat $n $I突然對你的身體施咒。
	mpcallout 7 tell $n 抓住(catch)，盒子就會自動進入你的行囊，到時再來我這就行囉！
	mpcallout 7 tell $n 我剛在你身上施加魔法，是委託人教我的魔法。要是有找到盒子只要
	mpcallout 8 addoil $n
	mpcallout 8 tell $n 那麼接下來的三天要麻煩你努力尋找了！當然我也會跟著去找！
	mpcallout 8 mpdel_qmark self vexed_talking
	mpcallout 8 mpat 35000 mpoload 2616 1 floor
	mpcallout 8 mpat 5 mpoload 35090
	mpcallout 8 mpat 5 mpoload 35091
	mpcallout 8 mpat 5 mpoload 35092
	mpcallout 8 mpat 5 mpoload 35093
else
	break
