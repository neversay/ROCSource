#35052
letter-receptionist~
一封信(letter)~
一封信(letter)掉落在地上.~
~
13 0 1
0~ 0~ 0~ 0~
1 0 0
X paper~
E
letter~
這是一封看起來很普通的信，也許你可以研究(study)上面寫些什麼。
~
>obj_command study default~
if is_qmark($n) == adv_quest_object 100016
	if int($n) >= 19
	or wis($n) >= 19
		echoat $n 一封信(letter) - [1;33m紙質(paper)[0m
		echoat $n 上面用奧夫卡文寫著：
		echoat $n 致  史卡拉貝冒險者公會：
		echoat $n 　
		echoat $n 　　　　本人是奧夫卡的鐵匠，正在研究古代的鍛造技術，所以現在定居在奧夫卡村。
		echoat $n 　　　　但是村莊所在位置較為偏僻，對於研究的材料取得不易，因此想委託貴公會的
		echoat $n 　　　　冒險者幫忙找尋一些研究用的素材。需要協尋的素材只有三樣，分別是：
		echoat $n 　　　　磁石(lodestone)、平衡之劍(neutralizer)及鋼條(bar of adamantite)
		echoat $n 　　　　據我跟商人打聽及考證後，這些東西所在的地點分別為：
		echoat $n 　　　　元素峽谷、矮人陵墓及魔法高塔，但詳細位置就無法確定了。
		echoat $n 　　　　
		echoat $n 　　　　任務順利完成後，我將給予２０萬金幣及素材所製作出的成品作為報酬。如果
		echoat $n 　　　　貴公會願意接受我的委託，請派遣冒險者至奧夫卡村與我接洽。
		echoat $n 　
		echoat $n 　　　　　　　　　　　　　　　　　　　　　　　　　　　　　鐵匠狄柯茲(Dickz)
		echoat $n 　　
		echoat $n 你看完內容了，把信還給櫃檯小姐吧。
		oforcer here mod_qmark $n adv_quest_object v0 | 1
	else
		echoat $n 一封信(letter) - [1;33m紙質(paper)[0m
		echoat $n 上面用你看不懂的奧夫卡文寫著：
		echoat $n 致  史＄＆＃貝冒＊＠公會：
		echoat $n 　
		echoat $n 　　　　％＆＃沃夫卡的＠＆，正在＊）︿！＠造＄＊，所＄％現％！居！＠＆＊村。
		echoat $n 　　　　但是＄％＆＃）︿＠＆＊僻，對！％＆＃）︿＠＆＊委託％＃）＠＆＊＠公會
		echoat $n 　　　　＊＃）︿＠＆～％研＄）％！＆＃。︿＠需要＆＊︿＠％＆︿＠＆＊％～：
		echoat $n 　　　　磁＃(＠＆stone)、＄衡︿劍(＆＃r ～z％)％＊條(ba＆ ＊f ％～！＆＊)
		echoat $n 　　　　︿＆＃＠＆＊︿％︿＠＆＊）︿％！︿％＃＊＆＠％＆＠＆:
		echoat $n 　　　　元＠＆谷、矮＠︿＠墓＊！法％塔，但＊％︿！＠＆）％確定＊。
		echoat $n 　　　　
		echoat $n 　　　　％＆順）％＆！＆我＄％︿＠＆＃％！︿％素＊＃）％＆︿＠＆）︿！＆＃～
		echoat $n 　　　　＠公會＠＆％＆委託，％＆︿＠＆％＆＄＆奧夫卡＄＠＆＆@%洽。
		echoat $n 　
		echoat $n 　　　　　　　　　　　　　　　　　　　　　　　　　　　　　＆＊︿＠％＆＊）＊
		echoat $n 　　
		echoat $n 你完全看不懂他在寫些什麼....把信還給櫃檯小姐吧。
	endif
else
	echoat $n 一封信(letter) - [1;33m紙質(paper)[0m
	echoat $n 這是一封看起來很普通的信。
endif
~
