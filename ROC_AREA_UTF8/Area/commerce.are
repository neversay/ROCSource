	mpmod_qmark $n ianua_supplies v0 = 13
	mpadd_qmark self talking
	tell $n 你剛剛一定覺得我不爽你，挾怨報復對吧？
	mpcallout 1 tell $n 沒有碎片一切都免談。
	mpcallout 1 tell $n 不行的原因是缺少必要的材料，星之碎片一塊。
	mpcallout 1 tell $n 我的確有點不爽，但身為一個研究員沒那麼幼稚，ok？
	mpcallout 2 tell $n 想測試就去拿碎片過來，不然就快滾，別影響我工作。
	mpcallout 2 tell $n 你這下懂了吧？
	mpcallout 2 mpdel_qmark self talking
else
	if rand(20)
		mpechoat $n 他專心作著研究沒理會你。
	endif
endif
