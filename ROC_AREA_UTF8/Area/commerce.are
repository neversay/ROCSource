>talk_prog p used~
if is_qmark($n) & adv_mission_complete 200001
	if is_qmark($n) == cloaked_test1
		mpadd_qmark $n pharmacist_level -1 3 0 0 0 1
		mpdel_qmark $n cloaked_test1
		tell $n 最基本的使用方法就是放入(into)適當的被煉物然後攪拌(stir)鍋釜混合。
		tell $n 而我使用的精煉物是草藥(herb)，主要的取得管道是商會的某個行商人。他
		tell $n 販賣的草藥雖然只有三種，但是品質還算穩定。
		mpcallout 1 tell $n 常識才對....
		mpcallout 1 tell $n 至於被煉物的用量，只要同種不放入太多就不會產生大問題。這應該算是個
		mpcallout 2 tell $n 超過或配方不正確可能會煉製失敗，而產生奇怪的東西....
		mpcallout 2 tell $n 合，而療傷藥水則是放入一株淺綠色草藥跟兩株堇紫色草藥攪拌。如果用量
		mpcallout 2 tell $n 的藥水。疾病藥水分別是放入兩株淺綠色草藥跟一株堇紫色草藥加以攪拌混
		mpcallout 2 tell $n 配方的部分我可以提供你兩種，一種是治療疾病用的藥水，另一種是療傷用
		mpcallout 3 wave $n
		mpcallout 3 tell $n 對於這三種草藥不太熟悉的話，可以去問請教(about herbs)賣草藥的商人。
	else
		if is_qmark($n) == pharmacist_level
			tell $n 最基本的使用方法就是放入(into)適當的被煉物然後攪拌(stir)鍋釜混合，
			tell $n 而我使用的精煉物是草藥(herb)，主要的取得管道是商會的某個行商人。他
			tell $n 販賣的草藥雖然只有三種，但是品質還算穩定。
			tell $n 不熟悉三種草藥的話，可以去問請教(about herbs)賣草藥的商人。
		endif
	endif
endif
~
>talk_prog p adventurer guild~
if is_qmark($n) == adv_mission_mark 200001
	if class($n) == 11
	or class($n) == 12
	or class($n) == 17
	or class($n) == 18
	or class($n) == 19
		mpmod_qmark $n adv_mission_mark v1 = 0
		mpadd_qmark $n adv_do_mission_2 -1 0 0 1 0 1
		tell $n 我看過公會送來的藥師修業證明了。
		tell $n 那麼我們直接進入主題吧。
		mpcallout 1 tell $n 上敘的東西至少帶二樣給我，如果忘記要找什麼可以再問我(list)。
		mpcallout 1 tell $n 巨魔藥水、具有寒冰之力的魔力藥水、最後是能產生結界的金黃色藥丸。
		mpcallout 1 tell $n 製作新藥的配方需要一些靈感，所以我需要可以讓人強化力量的巨魔藥水
		mpcallout 2 tell $n 那麼快點將這些東西帶來給我吧。
	else
		if class($n) == 6
		or class($n) == 7
		or class($n) == 8
		or class($n) == 13
			mpmod_qmark $n adv_mission_mark v1 = 0
			mpadd_qmark $n cloaked_test1 -1 0 0 0 0 1
			look $n
			mpcallout 1 tell $n 你似乎對藥物也有一些研究，那麼請先跟我切磋一下吧。
			mpcallout 2 tell $n 回答1 ,2 ,3 ,4 ,5中選一個。
			mpcallout 2 tell $n 首先藥品最多能附有幾種魔力？
		else
			mpmod_qmark $n adv_mission_mark v1 = 0
			mpadd_qmark $n cloaked_test2 -1 0 0 0 0 1
			look $n
			mpcallout 1 tell $n 對於以下的問題，要請你回答。
			mpcallout 1 tell $n 我很懷疑你是否真得具備藥物的基本知識，所以告訴你委託內容前我想先測試你。
			mpcallout 2 tell $n 回答1 ,2 ,3 ,4 ,5中選一個。
			mpcallout 2 tell $n 首先藥品最多能附有幾種魔力？
		endif
	endif
else
	break
endif
