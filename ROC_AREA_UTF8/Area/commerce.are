46 100000
>greet_prog 100~
if is_qmark($n) == skarabrae_joe_quest 100002
	if is_qmark($n) != commerce_gem_quest
	if is_qmark($n) == skarabrae_joe_quest 300002
		break
	endif
		mpadd_qmark $n commerce_gem_quest -1 1 0 0 0 1
		mpechoat $n 你將你的來意向$I說了出來......
		mpcallout 1 mpcall gem_talk_1 $n
		mpcallout 2 soga
		mpcallout 3 mpcall gem_talk_2 $n
		break
	endif
	tell $n 如何？有新進度了嗎？
	break
endif
if is_qmark($n) != commerce_crystal_quest
if is_inv_obj($n) == 2288
or is_inv_obj($n) == 2289
or is_inv_obj($n) == 2290
or is_inv_obj($n) == 2291
or is_inv_obj($n) == 2292
	echoat $n $I盯著你身上的龍晶瞧個不停。
	say 啊，那不是傳說中的「龍晶」(crystal)嗎？
else
	if rand(20)
		say 唉，誰能幫我找到龍晶(crystal)呢？
	endif
endif
endif
~
>defun_prog gem_talk_1~
say 你怎麼知道五彩寶石的？這事情應該除了招屍家族的族人沒人會知道啊！
mpechoat $n 你將事情的原委通盤告訴$I
~
>defun_prog gem_talk_2~
say 原來是這樣啊！既然是涵涵的要求，就幫你一回，不過你得拿到幾樣東西。
say 要不然我也沒辦法做出來。五彩寶石是數種不同性質的寶石(things)融合
say 而成，是一種難度不低的高級寶石，想要做出五彩寶石，要有幾樣條件：
say 材質(material)、硬度(hardness)、光澤(gloss)、魂(spirit)。
~
>talk_prog material~
if is_qmark($n) == commerce_gem_quest
	mpmod_qmark $n commerce_gem_quest v2 | 1
	say 這個很簡單，只要去到這附近撿紅藍色寶石、赭紅色、青色寶石、
	say 淡紫色寶石，再交給我便可以了。
	if is_qmark($n) == commerce_gem_quest 300015
		mpcall gem_judge $n
	endif
endif
~
>talk_prog hardness~
if is_qmark($n) == commerce_gem_quest
	mpmod_qmark $n commerce_gem_quest v2 | 2
	say 一個好的寶石當然要有高的硬度，這樣才不會遭刮損，才能長久保
	say 持光澤，因此需要一顆閃亮的鑽石來作為硬度的底基。
	if is_qmark($n) == commerce_gem_quest 300015
		mpcall gem_judge $n
	endif
endif
~
>talk_prog gloss~
if is_qmark($n) == commerce_gem_quest
	mpmod_qmark $n commerce_gem_quest v2 | 4
	say 漂亮的寶石光澤是不可缺少的，你去拿一個賽伐斯拖普幻象，藉由
	say 它的水晶材質，增亮五彩寶石的光澤是再好也不過的。
	if is_qmark($n) == commerce_gem_quest 300015
		mpcall gem_judge $n
	endif
endif
~
>talk_prog spirit~
if is_qmark($n) == commerce_gem_quest
	mpmod_qmark $n commerce_gem_quest v2 | 8
	say 好的寶石再漂亮沒有魂也是無用的。一個有魂的寶石才能深深吸引
	say 人的目光，發出光彩。去吧，我需要一顆虎眼石。
	if is_qmark($n) == commerce_gem_quest 300015
		mpcall gem_judge $n
	endif
endif
~
>talk_prog things~
mpcall gem_judge $n
~
>defun_prog gem_judge~
mpechoat $n 你還沒給的東西有：
if is_qmark($n) !& commerce_gem_quest 200001
	mpechoat $n .	[1;31m紅[36m藍[0m色寶石
endif
if is_qmark($n) !& commerce_gem_quest 200002
	mpechoat $n .	[1;31m赭紅[0m色寶石
endif
if is_qmark($n) !& commerce_gem_quest 200004
	mpechoat $n .	[1;36m青[0m色寶石
endif
