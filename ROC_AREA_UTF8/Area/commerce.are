		if rand(20)
			mpmod_qmark self ped_herbs v0 + 1
			mpecho $I從地上拔起一株雜草。
		endif
	endif
	if is_qmark($i) <= ped_herbs 200020
		if rand(20)
			mpmod_qmark self ped_herbs v1 + 1
			mpecho $I從地上拔起一株雜草。
		endif
	endif
endif
if area($i) == ofcol
	mpcall herb_sell peddler-comm-travel
	if is_qmark($i) & ped_weapon_making 100001
		if is_qmark($i) !& ped_things 100001
			mpmod_qmark self ped_weapon_making v0 r 1
			mpmod_qmark self ped_things v0 | 1
