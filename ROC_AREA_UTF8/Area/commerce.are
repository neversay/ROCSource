>talk_prog order~
if is_qmark($n) != comm_bounty_hunter
	break
endif
if is_qmark($n) == comm_bounty_order 200000
	tell $n 你手上還有委託沒完成呢。
	tell $n 如果想取消這次的任務，需要繳50萬的取消費，並且要
	tell $n 等十五天後才能再接單。如果覺得沒差，就拿錢來吧。
	break
else
	if is_qmark($n) == comm_bounty_order 200001
		tell $n 先回報完成的依賴內容(report)。
		break
	endif
	if is_qmark($n) == comm_bounty_order 200002
		tell $n 你東西取得了嗎？拿到的話就交給我吧。
		break
	endif
endif
if is_qmark($n) >= comm_bounty_timer 1240
	tell $n 你還要等十天以上的時間才能接單。
	break
endif
if is_qmark($n) >= comm_bounty_timer 1168
	tell $n 你還要等一星期以上的時間才能接單。
	break
endif
if is_qmark($n) >= comm_bounty_timer 1144
