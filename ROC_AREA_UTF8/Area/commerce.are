>repop_prog 100~
mpadd_qmark self enable_detect_nightstalk -1 0 0 0 0 1
~
>talk_prog topic~
if is_qmark($n) != adv_quest_object
	if is_qmark($n) == commerce_enemy
		if is_qmark($n) == adv_mission_mark
			tell $n 由於你在任務執行中退出公會，因此你當前的任務也不用執行了。
			mpechoat $n $I把你的名字從任務記錄本上刪去。
			mpdel_qmark $n adv_mission_mark
			mpdel_qmark $n adv_do_mission
			mpdel_qmark $n adv_do_mission_2
			mpdel_qmark $n adv_do_mission_3
			mpdel_qmark $n adv_mission_reward
		else
			tell $n 抱歉，一旦退出過公會就不能再次接受公會任務了。
		endif
	else
		if is_qmark($n) == adv_member_mark
			if class($n) < 5
			or level($n) < 30
				tell $n 您的能力還不足以執行公會的委託。
			else
				tell $n 您想要接受公會的任務(mission)嗎？
				mpadd_qmark $n adv_mission_complete -1 0 0 0 0 1
				mpadd_qmark $n adv_mission_reward -1 0 0 0 0 1
				mpadd_qmark $n adv_guild_level -1 0 0 1 0 1
			endif
		else
			tell $n 您還不是公會的冒險者喔！請先到公會入口找秘書加入。
		endif
	endif
else
	tell $n 你還沒把上次的東西還給我喔！你該不會弄丟了吧？這樣要賠我１０萬金幣！
endif
~
