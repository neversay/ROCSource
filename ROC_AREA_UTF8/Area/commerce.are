>tick_prog 100~
if is_qmark($i) == vice_weapon_use 100002
	if isfight($i)
		break
	else
		mpat 5 mpdis_magic self 'seal magic'
		mpat 5 mpdis_magic self mute
		mpat 5 c 'full heal'
		mpmod_qmark self vice_weapon_use v0 = 1
		mpecho $I在傷口上塗藥膏。
		remove all
	endif
else
	break
endif
~
>greet_prog 100~
if is_qmark($n) == adv_guild_lvup 100001
	look $n
	mpcallout 1 tell $n 歡迎，你就是$N吧？
	mpcallout 2 tell $n 我看了近期的任務報告，因為有你的活躍而幫公會解決了不少麻煩的委託。
	mpcallout 3 tell $n 由於你近期優異的表現，所以我決定配給你公會庫藏的武器及防具(arms)。
	mpcallout 3 mpmod_qmark $n adv_guild_lvup v0 = 2
endif
if is_qmark($n) == adv_guild_lvup 200001
	tell $n 啊，$N你來啦。
	mpcallout 1 tell $n 多虧有你，讓公會中堆積不少的屎差...呃，艱鉅的任務得已解決。
	mpcallout 2 tell $n 因為你優異的表現，我決定分配給你更強大的裝備(arms)。
	mpcallout 3 mpmod_qmark $n adv_guild_lvup v1 = 2
endif
~
>talk_prog p arms~
if is_qmark($n) == adv_guild_lvup 100002
	tell $n 你只要去儲藏室前跟守衛說一聲(equipment)，她會把東西拿給你了。
	tell $n 希望你之後也能對公會有更多的貢獻。
	addoil $n
	mpmod_qmark $n adv_guild_lvup v0 = 3
	mpmod_qmark $n adv_guild_level v0 = 1
	mpmod_qmark $n adv_guild_level v2 | 2
	mpechoat $n [1;37m你在公會的地位提升了！[m
endif
if is_qmark($n) == adv_guild_lvup 200002
	tell $n 我已經知會過儲藏室的守衛囉，去跟她說一聲就行了(equipment)。
	tell $n 希望你之後也能有豐富的貢獻。
	addoil $n
	mpmod_qmark $n adv_guild_lvup v1 = 3
	mpmod_qmark $n adv_guild_level v0 = 2
	mpmod_qmark $n adv_guild_level v2 | 4
	mpechoat $n [1;37m你在公會的地位提升了！[m
endif
~
>talk_prog topic~
if rand(33)
	smile $n
	say 歡迎，今天有什麼事嗎？
else
	if rand(50)
		say 會長現在外出不在，有什麼事情告訴我就行了。
	else
		mpechoat $n 他陷入自己的腦內小劇場中，沒發現到你。
	endif
endif
~
>rand_prog 5~
if rand(60)
	mpecho 副會長狠狠的碎唸著：「該死的會長又溜班了...回來一定要狠狠的教訓他！」
	aluba
else
	mpecho 副會長自言自語的唸著：「啊啊...會長堆積事務也太多了吧！再繼續作下去一定會死掉呀...」
	worry self
endif
~
>fight_prog 30~
if is_qmark($i) == vice_weapon_use 100001
	if rand(50)
		mpechoat $n $I對你使出快速的串刺拳。
		mpechoaround $n $I對$N使出快速的串刺拳。
		skilldrv speedhit $n
		skilldrv speedhit $n
		skilldrv speedhit $n
		skilldrv speedhit $n
		skilldrv speedhit $n
	else
		mpechoat $n $I對你使出一連串的體技。
		mpechoaround $n $I對$N使出一連串的體技。
		bashhead
		kick
		bashhead
		kick
		skilldrv heavyhit $n
		skilldrv monehit $n
		bashhead
		kick
		skilldrv heavyhit $n
		skilldrv monehit $n
	endif
endif
~
>fight_prog 30~
if is_qmark($i) == vice_weapon_use 100002
	if rand(50)
		if rand(10)
			mpecho $I從腰間抽出了短劍。
			wear small twohand
			mpgoto self
			bs $n
			mpnowait
			mpkill $n
			skilldrv speedhit $n
			skilldrv speedhit $n
			skilldrv speedhit $n
		else
			mpecho $I從身旁拿起一把巨斧。
			wear axe twohand
			circular
			mpnowait
			circular
			mpnowait
			circular
			mpnowait
			skilldrv heavyhit $n
			skilldrv heavyhit $n
		endif
	else
		if rand(60)
			cast fireball
			mpnowait
			cast fireball
			mpnowait
			cast powerball
			mpnowait
		else
			mpecho $I從地上抓起一把長劍。
			wear long twohand
			flaming
			mpnowait
			sprinkle
			mpnowait
			fulgurant
			mpnowait
		endif
	endif
endif
~
>hitprcnt_prog 40~
if is_qmark($i) == vice_weapon_use 100001
	if isfight($i)
		mpmod_qmark self vice_weapon_use v0 = 2
		say 沒辦法，只有使用武器了。
		mpecho $I從背後拔出長劍。
		wear long twohand
		perform empslash
		mpnowait
		perform empslash
		mpnowait
	else
		break
	endif
else
	break
endif
~
