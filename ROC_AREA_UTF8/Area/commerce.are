~
>defun_prog check_object_05~
if is_qmark($n) & adv_mission_mark 100016
	tell $n 沒..沒辦法嘛！他的字寫得那麼醜！人家看不懂他在鬼畫符什麼嘛！所以才會
	tell $n 搞到現在只有你想接這個任務呀。
else
	mpadd_qmark $n adv_quest_object -1 16 0 0 0 1
	mpoload 35052 $n 1 target
	tell $n 沒..沒辦法嘛！他的字寫得那麼醜！人家看不懂他在鬼畫符什麼嘛！所以才會
	tell $n 搞到現在都沒有冒險者要接呀！不..不信的話你自己拿去看嘛！
	mpechoat $n 櫃檯小姐把信丟給了你。
	mpcallout 1 tell $n 總之，內容大概就是這樣！想接下來的話跟我說一聲就行囉！(accept 05)
	mpcallout 2 tell $n 另外委託人的物件都要存證，看完要馬上還給我喔！弄丟的話要賠償１０萬金幣。
endif
~
>talk_prog p material request~
if is_qmark($n) != adv_quest_object 100016
	if is_qmark($n) == adv_member_mark
		if is_qmark($n) != adv_mission_mark
			if is_qmark($n) !& adv_mission_complete 100016
				mpechoat $n $I從桌上抽屜裡翻出一封泛黃信....
				tell $n 前幾天有一封從奧夫卡寄來的信，大概是寫說希望公會能達成他的委託。
				mpcallout 1 mpechoat $n ..............
				mpcallout 2 mpechoat $n 你心想：信紙都黃成這樣了，至少幾個月了吧.....
				mpcallout 3 mpechoat $n ............................
				mpcallout 5 mpechoat $n 一陣沉默後，櫃檯小姐就像你肚子裡的蛔蟲，看穿了你的心思。
				mpcallout 6 mpcall check_object_05 $n
			else
				break
			endif
		else
			break
		endif
	else
		break
	endif
else
	tell $n 我不是把信給你了？你還沒看過嗎？
endif
