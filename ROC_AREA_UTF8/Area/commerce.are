>defun_prog food_list~
if is_qmark($n) != adv_do_mission 100031
	mpechoat $n 你還沒給主廚：
	if is_qmark($n) !& adv_do_mission 100001
	mpechoat $n 　[1;37m綠樹王國的芭樂(guava)[m
	endif
	if is_qmark($n) !& adv_do_mission 100002
	mpechoat $n 　[1;37m綠樹王國的鳳梨(pineapple)[m
	endif
	if is_qmark($n) !& adv_do_mission 100004
	mpechoat $n 　[1;37m地精村的大大紅蘿蔔(carrot)[m
	endif
	if is_qmark($n) !& adv_do_mission 100008
	mpechoat $n 　[1;37m清河鎮的豆漿(bean milk)[m
	endif
	if is_qmark($n) !& adv_do_mission 100016
	mpechoat $n 　[1;37m清河鎮的陳年紹興(ale)[m
	endif
else
	mpdel_qmark $n food_deliver
	mpdel_qmark $n adv_mission_mark
	mpdel_qmark $n adv_do_mission
	mpmod_qmark $n adv_mission_complete v0 | 4
	mpmod_qmark $n adv_mission_reward v0 | 4
	good $n
	tell $n 我收到所有的貨了！合作愉快！
	mpechoat $n $I說完話後轉頭又開始在廚房中忙進忙出。
	mpechoat $n 看來任務是順利的達成了，回去領取獎賞吧！(reward)
endif
