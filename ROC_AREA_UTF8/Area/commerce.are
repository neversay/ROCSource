X elemental alloy~
>obj_repop 100~
oset self v0 = 500
oset self v1 = 5
oset self v2 = 5
~
>obj_command pourmana default~
if mpnum($n) >= 1000
	echoat $n 你對箭袋輸入魔力，產生出許多魔法箭。
	oset self v0 = 500
	oforcer here modhmv $n 11.1000 1000 0
else
	echoat $n 你的魔力不足。
endif
~
>obj_command pourfire default~
if mpnum($n) >= 1000
	echoat $n 你輸入火燄魔力轉換箭袋的性質。
	oforcer here modhmv $n 11.1000 1000 0
	ogoto $n
	oforcer here oload 35133 viclv $n target
	purge self
else
	echoat $n 你的魔力不足。
endif
~
