	tell $n 至少給我兩樣東西，都給齊了跟我說一聲(finish)。
	mpechoat $n 物品清單：
	if is_qmark($n) !& adv_do_mission_2 100001
		mpechoat $n 　　[1;37m強化力量的巨魔藥水[m
	endif
	if is_qmark($n) !& adv_do_mission_2 100002
		mpechoat $n 　　[1;37m寒冰之力的魔力藥水[m
	endif
	if is_qmark($n) !& adv_do_mission_2 100004
		mpechoat $n 　　[1;37m產生結界的金黃色藥丸[m
	endif
else
	mpdel_qmark $n adv_do_mission_2
	mpdel_qmark $n adv_mission_mark
	mpmod_qmark $n adv_mission_complete v1 | 1
	mpmod_qmark $n adv_mission_reward v1 | 1
	nod $n
	tell $n 我收到全部的東西了。
	mpcallout 1 mpechoat $n 看來你完成任務了，回去領賞(reward)吧。
	if is_qmark($n) == cloaked_test1
		mpcallout 2 mpoload 35085 $n viclv target
		mpcallout 2 mpechoat $n $I塞給你一個藥釜。
		mpcallout 2 tell $n 看來你對於藥物真得有相當程度的了解。
		mpcallout 3 tell $n 我把這個隨身用的藥釜送你，希望你以後也能繼續鑽研。
		mpcallout 5 mpechoat $n 你突然發現，自己似乎不知道使用方法(used)。
	endif
endif
