>talk_prog p result~
if is_qmark($n) == cloaked_test1
	if is_qmark($n) == cloaked_test1 200003
		mpadd_qmark $n adv_do_mission_2 -1 0 0 1 0 1
		tell $n 果然是專業的，那麼我們還是進入主題吧。
		mpcallout 1 tell $n 上敘的東西至少帶二樣給我，如果忘記要找什麼可以再問我(list)。
		mpcallout 1 tell $n 巨魔藥水、具有寒冰之力的魔力藥水、最後是能產生結界的金黃色藥丸。
		mpcallout 1 tell $n 製作新藥的配方需要一些靈感，所以我需要可以讓人強化力量的巨魔藥水
		mpcallout 2 tell $n 麻煩將這些東西帶來給我吧。
	else
		mpdel_qmark $n cloaked_test1
		mpadd_qmark $n adv_do_mission_2 -1 0 0 1 0 1
		tell $n 看來你太久沒複習以前所學的東西。
		tell $n 不過沒關係，至少你還是了解一些皮毛。
		mpcallout 1 tell $n 那麼我們還是進入主題吧。
		mpcallout 2 tell $n 上敘的東西至少帶二樣給我，如果忘記要找什麼可以再問我(list)。
		mpcallout 2 tell $n 巨魔藥水、具有寒冰之力的魔力藥水、最後是能產生結界的金黃色藥丸。
		mpcallout 2 tell $n 製作新藥的配方需要一些靈感，所以我需要可以讓人強化力量的巨魔藥水
		mpcallout 3 tell $n 麻煩將這些東西帶來給我吧。
	endif
endif
if is_qmark($n) == cloaked_test2
	if is_qmark($n) == cloaked_test2 200003
		mpadd_qmark $n adv_do_mission_2 -1 0 0 1 0 1
		mpdel_qmark $n cloaked_test2
		nod $n
		tell $n 你及格了，這次總算來個稍微懂一點的。
		mpcallout 1 tell $n 那麼我們進入主題吧。
		mpcallout 2 tell $n 上敘的東西至少帶二樣給我，如果忘記要找什麼可以再問我(list)。
		mpcallout 2 tell $n 巨魔藥水、具有寒冰之力的魔力藥水、最後是能產生結界的金黃色藥丸。
		mpcallout 2 tell $n 製作新藥的配方需要一些靈感，所以我需要可以讓人強化力量的巨魔藥水
		mpcallout 3 tell $n 快將這些東西帶來給我吧。
	else
		mpdel_qmark $n cloaked_test2
		mpadd_qmark $n adv_mission_failed -1 0 1 0 0 1
		tell $n 你其實根本不懂藥品吧？
		tell $n 回去公會叫他們找個懂的來。
		mpcallout 1 mpechoat $n 看來你的委託失敗了(failed)，回去報告吧。
	endif
endif
