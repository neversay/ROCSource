~
>talk_prog p maid please~
if is_qmark($n) == adv_member_mark
	if is_qmark($n) != adv_mission_mark
		if is_qmark($n) !& adv_mission_complete 100008
			mpechoat $n $I翻了翻桌上的任務記錄本....
			tell $n 這個任務比較特別，委託人來自於綠樹王國，雖然我們與綠樹王國有邦交，但
			tell $n 委託人是皇宮中的侍女，所以在各方面來說難免會有些敏感。尤其是綠樹王國
			tell $n 算是比較封閉的國家，外加最近有傳聞說他們國內有點不太安定...
			worry
			mpcallout 1 tell $n 費，且冒險者在國外闖出的禍都與商會無關！
			mpcallout 1 tell $n 商會底下，作事還是要稍微有些分寸。因此公會不主動提供往來綠樹王國的旅
			mpcallout 1 tell $n 雖然屬於灰色地帶的冒險者公會沒有政治的問題，但畢竟還是隸屬於史卡拉貝
			mpcallout 2 mpechoat $n 你心想這真是個無良的公會....
			mpcallout 3 mpechoat $n $I彷彿看穿了你的思緒，輕咳兩聲要你仔細聽下面的內容...
			mpcallout 4 tell $n 失敗的話，公會將收１０萬金幣作為名譽上的補償。
			mpcallout 4 tell $n 請自行尋找。如果能順利完成任務，委託人將開出一件寶物作為報酬，但如果
			mpcallout 4 tell $n 任務的內容要等您見到委託人後在親自詢問，委託人為皇宮中的侍女(maid)，
		else
			break
		endif
	else
		break
	endif
else
	break
endif
