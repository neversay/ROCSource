>room_time 100~
if month($) == 0
or month($) == 1
or month($) == 2
or month($) == 3
	modrvt v0 = 1
	setroom desc N 粉雪遮蓋一切事物，把山丘轉變成寂靜銀白的世界。凜冽的寒風使覆雪的樹
	setroom desc A 木結出一根根晶瑩的冰錐，眼前是片夢幻的美景，此時如果再下起雪來，更堪稱
	setroom desc A 絕景。通往高處的石階已被降雪半掩，現在入山會是不智的舉動。
endif
if month($) == 4
or month($) == 5
or month($) == 6
or month($) == 7
or month($) == 8
	modrvt v0 = 2
	setroom desc N 風中飄來陣陣花香，眼前的山丘百花綻放，呈現五顏六色的景致。比起人聲
	setroom desc A 鼎沸的大廳，這裡的空氣清新宜人，如果接下來沒有行程，可以考慮坐在長椅上
	setroom desc A 享受自然，渡過悠閒的午後時光。西邊有條長滿花草的石階往高處延伸而去。
endif
if month($) == 9
or month($) == 10
or month($) == 11
or month($) == 12
	modrvt v0 = 3
	setroom desc N 溫暖潮濕的氣候，讓草木生長更加翠綠，整片山丘顯得綠意盎然，鳥語蟬鳴
	setroom desc A 此起彼落，使山丘裡充滿生氣。如果受不了炎熱的高溫，也許能考慮從西邊的長
	setroom desc A 石階進入山林裡避暑。
endif
if month($) == 13
or month($) == 14
or month($) == 15
or month($) == 16
	modrvt v0 = 4
	setroom desc N 微風吹拂壓低長草，黃化的植被將眼前的山丘染成一片金黃色。如果閒來無
	setroom desc A 事，乘著秋風的涼意延著石階漫步入山，也有一番風情。西邊是佈滿落葉的石階
	setroom desc A 往山丘高處延伸而去。
endif
if month($) == 4
	if day($) <= 10
		if roomvalue($0) != 5
			modrvt v0 = 5
			setroom desc N 覆蓋在樹林間的積雪漸漸褪去，山丘的草樹逐漸探出枝芽，看來春天的腳步
			setroom desc A 近了。雖然氣溫有回暖的跡象，但還是偏低，這個時節依然有降雪的可能。西邊
			setroom desc A 通往高處的石階在融雪後已經能清楚的看見。
		endif
	endif
endif
if month($) == 8
	if day($) >= 15
		if roomvalue($0) != 6
			modrvt v0 = 6
			setroom desc N 山丘上的花朵逐漸凋落，草木開始結出一顆顆青澀的果實，盛夏即將來臨。
			setroom desc A 濕暖的東風吹來，使氣溫逐漸升高，天空也頻繁地降起小雨。西邊有條長石階往
			setroom desc A 山丘高處延伸而去。
		endif
	endif
endif
if month($) == 12
	if day($) >= 15
		if roomvalue($0) != 7
			modrvt v0 = 7
			setroom desc N 山丘上的果實成熟，草木逐漸轉黃，季節即將進入豐收作物的食慾之秋。夜
			setroom desc A 晚的山林吹起徐徐涼風，空氣裡挾帶著一絲涼意，氣溫不再讓人感到潮濕悶熱。
			setroom desc A 西邊有條長石階往山丘高處延伸而去。
		endif
	endif
endif
if month($) == 16
	if day($) >= 20
		if roomvalue($0) != 8
			modrvt v0 = 8
			setroom desc N 草木逐漸凋零，整座山丘在秋末時已經變成光禿禿的一片，準備迎接嚴寒的
			setroom desc A 冬季。夜間的氣溫驟降，開始有機會降雪，晚上在外需要多加件外套保暖。西邊
			setroom desc A 有條長石階往山丘高處延伸而去。
		endif
	endif
endif
if hour($) < 8
or hour($) > 20
	if rmobcount(35046) != 0
		transfer chelimon-cme 35000
		echo 榭莉門(Chelimon)推著攤車離開這裡。
	endif
	if rmobcount(35047) != 0
		transfer atifthino-cme 35000
		echo 安蒂妃諾(Atifthino)推著攤車離開這裡。
	endif
	if rmobcount(35048) != 0
