#35002
冒險者公會藏書庫~
這裡是冒險者公會的藏書庫，牆面擺設幾十層樓的大書架，上面擺放著各類
典籍(record)。豐富的內容從宇宙成形史到美食導覽都能找到，當中甚至能
發現上古魔法的教學書，不過使用的文字你看不懂，所以無法閱讀。在書庫
的中央放有一個架子放著一本書(book)可以讓你查看(check)。
~
0 8|262144 0
E
book~
書上的痕跡顯示出這本書曾經被許多人翻閱(check)過。
~
E
record~
內容大多是關於風之大陸的各種報告，大量的資料在架上被分成數個類別(catelog)。
碰到不了解的事情，能從中尋求出(search)解答。
~
D1
有著許多冒險者的公會大廳。
~
~
0 0 35001
>room_command search default~
if is_qmark($n) == comm_search_recoard
	break
endif
add_qmark $n comm_search_recoard 1 0 0 0 1 0
callout 1 at $n del_qmark $n comm_search_recoard
echoat $n 你發現書架上的分類有：
echoat $n 　
echoat $n 歷史(history)
echoat $n 遊記(travel)
echoat $n 生物(creature)
echoat $n 魔法(magic)
echoat $n 神話(myth)
~
>room_command search p catelog~
if is_qmark($n) == comm_search_recoard
	break
endif
add_qmark $n comm_search_recoard 1 0 0 0 1 0
callout 1 at $n del_qmark $n comm_search_recoard
echoat $n 你發現書架上的分類有：
echoat $n 　
echoat $n 歷史(history)
echoat $n 遊記(travel)
echoat $n 生物(creature)
echoat $n 魔法(magic)
echoat $n 神話(myth)
~
>room_command search p history~
if is_qmark($n) == comm_search_recoard
	break
endif
add_qmark $n comm_search_recoard 1 0 0 0 1 0
callout 1 at $n del_qmark $n comm_search_recoard
echoat $n 你在歷史(history)的分類下找到：
echoat $n 　
echoat $n 史卡拉貝簡史(Skara Brae)
echoat $n 奧夫卡(Ofcol)
echoat $n 麥格城(Mega City)
echoat $n 銀蛇武士堡(Silver Serpent Stronghold)
echoat $n 羅胡城堡(Castle Reinhold)
echoat $n 泰洛斯(Thalos)
echoat $n 高塔(The Towers)
~
>room_command search p Skara Brae~
~
>room_command search p travel~
if is_qmark($n) == comm_search_recoard
	break
endif
add_qmark $n comm_search_recoard 1 0 0 0 1 0
callout 1 at $n del_qmark $n comm_search_recoard
echoat $n 你在遊記(travel)的分類下找到：
echoat $n 　
echoat $n 歡樂賀比特 - 我在賽伐斯拖普的十一天(Hobbit City)
echoat $n 地精之村行商記(Gnome Village)
echoat $n 大樹、櫻花、精靈之森(Elf Town)
echoat $n ＪＫ、王女、深土之城(Deepland)
echoat $n 矮人王國的地底之旅(Dwarven Kingdom)
echoat $n 探索祕境 - 人馬村(Centaur Village)
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) !& mist_clean_quest 200004
		echoat $n 歐米拉冒險大全(handbook)
	endif
endif
~
>room_command search p creature~
echoat $n 你在生物(creature)的分類下找到：
echoat $n 　
echoat $n 
~
>room_command search p magic~
echoat $n 你在魔法(magic)的分類下找到：
echoat $n 　
echoat $n 咒文概論(spell theory)
echoat $n 探索秘傳法術(arcane)
~
>room_command search p myth~
echoat $n 你在神話(myth)的分類下找到：
echoat $n 　
echoat $n 月之女神 黛妮亞(Dynia)
echoat $n 航海商業之神 迪利恩(Deliun)
echoat $n 戰神 奧瑟蘭(Ocelaen)
echoat $n 異族神祇(Deities)
~
>room_command search p record~
stun $n 15
echoaround $n $N從架上隨手拿起一本書看....
if rand(25)
	echoat $n 你發現一本名為「風之大陸常用火星文範本」的書籍...
	callout 1 echoat $n 但沒什麼吸引人的內容，所以你又放了回去。
	callout 1 echoaround $n $N 大喊著 '嘿！威瑪 -- YABBA DABBA DOO!'
else
	if rand(33)
		echoat $n 你發現一本名為「火球術料理大全」的書籍...
		callout 1 echoat $n 但沒什麼吸引人的內容，所以你又放了回去。
		callout 1 echoaround $n $N一個不小心，口水滴了滿地。
	else
		if rand(50)
			echoat $n 你發現一本名為「魔物品嚐評鑑刊 ＮＯ. 1337」的雜誌...
			callout 1 echoat $n 但沒什麼吸引人的內容，所以你又放了回去。
			callout 1 echoaround $n $N的肚子咕嚕咕嚕地叫的好大聲
		else
			echoat $n 你發現一本名為「完全解析！史卡拉貝花街攻略集」的文獻...
			callout 1 echoat $n 但內容太過刺激，所以你又放了回去。
			callout 1 echoaround $n $N的臉害羞的紅了起來！
		endif
	endif
endif
~
>room_command search p handbook~
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) !& mist_clean_quest 200004
		echoat $n 這本名為「歐米拉冒險大全」的小冊子，或許有你正在收集的資料(gather literature)。
	else
		echoat $n 大量的書本讓你眼花撩亂，這裡並沒有什麼美妙的小冊子。
	endif
else
	echoat $n 什麼？
endif
~
>room_command gather literature~
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) !& mist_clean_quest 200004
		echoat $n 你從架上把名為「歐米拉冒險大全」的小冊子拿下來。
		echoaround $n $N偷偷摸摸的從架上幹走一本書塞進行囊內。
		oload 4268 1 $n target
		mod_qmark $n mist_clean_quest v1 | 4
	else
		echoat $n 你已經找過這裡了。
	endif
else
	echoat $n 什麼？
endif
~
|
S
