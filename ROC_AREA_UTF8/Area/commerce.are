>obj_command study default~
if race($n) == fairy
or race($n) == pixie
	echoat $n 侍女的信(letter) - [1;33m紙質(paper)[0m
	echoat $n 上面寫著：
	echoat $n 　　　　親愛的，雖然我們的出身不同，但那夜中的激情我一輩子都不會忘記！
	echoat $n 　　我們這段超越種族的戀情是絕對不會被國家的政策所擊倒的！
	echoat $n 　　　　　　　　　　　　　　　　　　　　　　　　　　　　　愛你的欣兒
	echoat $n 　　
