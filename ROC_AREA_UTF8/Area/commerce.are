~
>talk_prog topic~
if is_qmark($i) == talking
	mpechoat $n 他正在忙。
	break
endif
if is_qmark($n) == ofcol_anc_eq 100000
	tell $n 有需要交易什....啊，居然是你呀！
	mpechoat $n 他是誰？(who)
	mpmod_qmark $n ofcol_anc_eq v0 = 1
	break
endif
if is_qmark($n) !& commerce_subquest 100008
	tell $n 呦，你想找什麼嗎？(trade)
else
