>defun_prog au_pur_check~
if is_qmark($i) == au_price_count 100006
	if is_qmark($i) <= au_price_count 200000
		if goldamt($n) < 10350000
			tell $n 你身上的資金不足喔。
			break
		else
			mpgold $n -10350000
			mpoload 35099 $n 1 target
			tell $n 謝謝惠顧。
			bow $n
		endif
	endif
