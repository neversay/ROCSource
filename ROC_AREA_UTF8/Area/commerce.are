>talk_prog p adventurer guild~
if is_qmark($n) == adv_mission_mark 100001
	mpmod_qmark $n adv_mission_mark v0 = 0
	mpadd_qmark $n adv_do_mission -1 0 0 0 0 1
	mpechoat $n 你向$I表示自己是公會派來的人....
	mpcallout 1 tell $n 不論城中的哪一位醫生都束手無策..........
	mpcallout 1 tell $n 察結束回到史卡拉貝後，她的視力卻快速的衰退，之後就像生重病一樣躺在床上動彈不得。
	mpcallout 1 tell $n 我走在隊伍最前方的女友，也因此被彈出的長槍割傷了，雖然傷口沒什麼大礙，但在考
	mpcallout 1 tell $n 探察的過程中，有一位團員不小心觸動了裡面的機關，前方道路道瞬間彈出許多的長槍。
	mpcallout 1 tell $n 我跟我的女朋友都是考古學家，前陣子跟著考察團進入一座沙漠裡的金字塔中進行調查。
	mpcallout 1 tell $n 事情是這樣的....
	mpcallout 1 tell $n 沒想到公會真的派人了！因為時間急迫，讓我們直接切入主題吧！
	mpcallout 2 tear self
	mpcallout 3 tell $n 萬事拜託了！
	mpcallout 3 tell $n 因此希望你能取得這本密語卷軸並且交給我。
	mpcallout 3 tell $n 古代居住於岩壁的沙漠之民所持的密語卷軸上有記載，不過該地在很久以前就被黃龍所佔據了。
	mpcallout 3 tell $n 之後幾星期中，我在考古書上找到某一個文獻上有說明同樣的症狀，上面提到治癒的方法在
	mpcallout 3 mpmod_qmark $n adv_do_mission v2 | 1
	mpcallout 4 bow $n
else
	break
endif
~
>give_prog 5022~
if is_qmark($n) == adv_do_mission 300001
	mpdel_qmark $n adv_do_mission
	mpdel_qmark $n adv_mission_mark
	mpmod_qmark $n adv_mission_complete v0 | 1
	mpmod_qmark $n adv_mission_reward v0 | 1
	thank $n
	mpjunk encrypted
	mpcallout 1 mpgoto 35000
	mpcallout 1 mpechoat $n 你完成公會交代的任務了，回去領取獎賞(reward)吧！
	mpcallout 1 mpechoat $n $I高興的跑了出去！
	mpcallout 1 tell $n 真是太感謝你了！
else
	break
endif
