            callout 1 echo 小雪狼忽然感到不適
            callout 2 echo 最後衝出了雪后堡
            callout 3 echoat $n 看來雪后再也不用煩惱牠的事了
            callout 3 mod_qmark $n southend_snowqueen_worry v0 = 3
        endif
     else
        echoat $n [1;33m你吶喊：「AP-ZA-FAZSX」[m
        echoaround $n [1;33m$N[1;33m吶喊：「AP-ZA-FAZSX」[m
        echoat $n 不過一點作用都沒有
