>hurt_prog 1000~
 mpechoat $n [1;30m你的奮力擊打讓$I的骨架開始不穩[m
 mpechoaround $n [1;30m$N[m[1;30m的奮力擊打讓$I的骨架開始不穩[m
 mpmod_qmark self hurt v0 + 1
 if is_qmark(self) > hurt 100199
     mpecho .
     mpecho $I對天狂吼了一聲
     mpecho $I倒在地上化成一堆無法行動的骨頭
     mpecho .
     mpoload 1813 floor
     mpforcer here modrvt v0 = 1
     mpforcer here modrvt v2 = 1
     mppurge self
     break
 else
        if is_qmark(self) > hurt 100149
            mpecho $I開始站不穩了
            break
        else
            if is_qmark(self) > hurt 100099
                mpecho $I搖搖欲墜
            endif
        endif
 endif
