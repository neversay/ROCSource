E
book~
這是一本能讓你快速學會企鵝語的基礎書，
別多話了，趕快開始研讀吧！
~
X paper~
>obj_command study default~
if is_qmark($n) & southend_quest 100002
	echoat $n 你都會了，還看甚麼？
	break
endif
if is_qmark($n) == southend_study
	echoat $n 你已經在看了
	break
endif
if is_qmark($n) == southend_study_rest
	echoat $n 你需要再休息一下
	break
endif
if is_qmark($n) == southend_study_dream
	echoat $n 你還在作夢不想碰書
	break
endif
oforcer here add_qmark $n southend_study 3 0 0 0 1 0
echoat $n 你努力的翻著第一頁......
oforcer here callout 1 at $n echoat $n 你興奮的看著第二頁......
oforcer here callout 2 at $n echoat $n 你不耐煩的研讀第三頁......
oforcer here callout 3 at $n echoat $n ......你快速的翻到最後一頁
oforcer here callout 3 at $n force $n yell 北七速讀法～～～
if int($n) <= 13
	if rand(10)
		oforcer here callout 4 at $n echoat $n 你對企鵝語有了少少的了解，不過對話應該不是問題
		oforcer here callout 4 at $n echoat $n 你費盡千辛萬苦勉強讀完這本書
		oforcer here callout 4 at $n mod_qmark $n southend_quest v0 | 2
		oforcer here callout 5 at $n del_qmark $n southend_study
		break
	endif
	if rand(23)
		oforcer here callout 4 at $n add_qmark $n southend_study_rest 3 0 0 0 0 1
		oforcer here callout 4 at $n force $n rest
		oforcer here callout 4 at $n echoat $n 你感到疲累，需要休息一下
		oforcer here callout 5 at $n del_qmark $n southend_study
		break
	endif
	if rand(26)
		oforcer here callout 4 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 5 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 6 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 7 at $n force $n sleep
		oforcer here callout 7 at $n add_qmark $n southend_study_rest 9 0 0 0 0 1
		oforcer here callout 7 at $n del_qmark $n southend_study
		break
	endif
	if rand(37)
		oforcer here callout 4 at $n echoat $n 你的上眼皮和下眼皮親密的親在一起了
		oforcer here callout 5 at $n echoat $n 你感到美麗的新世界在你的腦海裡傳播開來
		oforcer here callout 6 at $n transfer $n 1890
		oforcer here callout 6 at $n force $n sleep
		oforcer here callout 6 at $n add_qmark $n southend_study_dream 17 0 0 0 0 1
		oforcer here callout 6 at $n del_qmark $n southend_study
	else
		oforcer here callout 4 at $n echoat $n 你一氣之下，就將這本北七書給撕了
		oforcer here callout 4 at $n echoaround $n $N一氣之下將一本書給撕了
		oforcer here callout 4 at $n echoat $n 看不懂就是看不懂
		oforcer here callout 7 at $n echoat $n 你望著你手上的碎紙......
		oforcer here callout 8 at $n echoat $n 天啊！！你到底做了甚麼！？
		oforcer here callout 9 at $n echoat $n 看來只好再去找布布拿本新的了
		oforcer here callout 9 at $n del_qmark $n southend_study
		purge self
		break
	endif
endif
if int($n) <= 16
	if rand(20)
		oforcer here callout 4 at $n echoat $n 你對企鵝語有了少少的了解，不過對話應該不是問題
		oforcer here callout 4 at $n echoat $n 你費盡千辛萬苦終於讀完這本書
		oforcer here callout 4 at $n mod_qmark $n southend_quest v0 | 2
		oforcer here callout 4 at $n del_qmark $n southend_study
		break
	endif
	if rand(32)
		oforcer here callout 4 at $n add_qmark $n southend_study_rest 3 0 0 0 0 1
		oforcer here callout 4 at $n force $n rest
		oforcer here callout 4 at $n echoat $n 你感到疲累，需要休息一下
		oforcer here callout 4 at $n del_qmark $n southend_study
		break
	endif
	if rand(37)
		oforcer here callout 4 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 5 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 6 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 7 at $n force $n sleep
		oforcer here callout 7 at $n add_qmark $n southend_study_rest 9 0 0 0 0 1
		oforcer here callout 7 at $n del_qmark $n southend_study
		break
	else
		oforcer here callout 4 at $n echoat $n 你的上眼皮和下眼皮親密的親在一起了
		oforcer here callout 5 at $n echoat $n 你感到美麗的新世界在你的腦海裡傳播開來
		oforcer here callout 6 at $n transfer $n 1890
		oforcer here callout 6 at $n force $n sleep
		oforcer here callout 6 at $n add_qmark $n southend_study_dream 17 0 0 0 0 1
		oforcer here callout 6 at $n del_qmark $n southend_study
		break
	endif
endif
if int($n) <= 19
	if rand(50)
		oforcer here callout 4 at $n echoat $n 你或多或少對企鵝語有初步的了解
		oforcer here callout 4 at $n echoat $n 你終於將這本書給讀完了
		oforcer here callout 4 at $n mod_qmark $n southend_quest v0 | 2
		oforcer here callout 4 at $n del_qmark $n southend_study
		break
	endif
	if rand(50)
		oforcer here callout 4 at $n add_qmark $n southend_study_rest 3 0 0 0 0 1
		oforcer here callout 4 at $n force $n rest
		oforcer here callout 4 at $n echoat $n 你感到疲累，需要休息一下
		oforcer here callout 4 at $n del_qmark $n southend_study
		break
	else
		oforcer here callout 4 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 5 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 6 at $n echoat $n 你的眼皮越來越重了......
		oforcer here callout 7 at $n force $n sleep
		oforcer here callout 7 at $n add_qmark $n southend_study_rest 9 0 0 0 0 1
		oforcer here callout 7 at $n del_qmark $n southend_study
		break
	endif
endif
if int($n) <= 25
	if rand(50)
		oforcer here callout 4 at $n echoat $n 這對你來說，只比從史卡拉貝水池走回家還難一點點而已
		oforcer here callout 4 at $n echoat $n 你輕輕鬆鬆的將這本書給讀完了
		oforcer here callout 4 at $n mod_qmark $n southend_quest v0 | 2
		oforcer here callout 4 at $n del_qmark $n southend_study
		break
	else
		oforcer here callout 4 at $n add_qmark $n southend_study_rest 3 0 0 0 0 1
		oforcer here callout 4 at $n force $n rest
		oforcer here callout 4 at $n echoat $n 你感到疲累，需要休息一下
		oforcer here callout 4 at $n del_qmark $n southend_study
	endif
endif
