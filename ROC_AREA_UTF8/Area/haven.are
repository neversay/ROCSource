X bone~
>obj_command knock default~
 if is_qmark($n) >= southend_kent_tion 100007
     oforcer here echoat $n 你舉起手往這紅色的骨頭擊去
     oforcer here echoaround $n $N舉起手往這紅色的骨頭擊去
     oforcer here callout 1 echoat $n 你的武器被這骨頭彈開了
     oforcer here callout 1 echoaround $n $N的武器被這骨頭彈開了
     oforcer here callout 2 echoat $n 這是！？
     oforcer here callout 4 echoat $n 忽然，你手上的藍光化作一把利刃將這骨頭擊碎
     oforcer here callout 4 echoaround $n 忽然，$N手上的藍光化作一把利刃將這骨頭擊碎
     oforcer here callout 5 echo 從骨骸之中跑出了一道紅色的光芒
     oforcer here callout 6 echo $N手中的藍光和天空之中的紅光交錯飛舞著......
     oforcer here callout 7 echo 互相撞擊著......
     oforcer here callout 8 echo 互相撞擊著......
     oforcer here callout 9 echo 互相撞擊著......
     oforcer here callout 12 echo 最後兩道光芒強烈的發出光與熱
     oforcer here callout 14 echo 慢慢的...光芒逐漸平息
     oforcer here callout 17 mod_qmark $n southend_kent_tion v2 = 4
     oforcer here callout 17 oload 1824 40 $n target
     oforcer here callout 17 echoaround $n 穩穩的躺在$N的手中
     oforcer here callout 17 echoat $n 穩穩的躺在你的手中
     oforcer here callout 17 echo 最後天空降下了一把由冰所打造的刀刃
     purge self
 endif
~
