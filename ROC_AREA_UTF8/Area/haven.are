>give_prog 1781~
 if is_qmark($i) != talking
    if is_qmark($n) == southend_booboo_language 100010
        mpadd_qmark self talking 3 1 0 0 1 0
        mpechoat $n $I[1;33m告訴你「喔喔，牛奶冰淇淋耶！」[m
        mpechoat $n $I[1;33m告訴你「真是太好了，太久沒吃冰淇淋，都快忘記是什麼滋味了」[m
        mpecho $I三口兩口地把牛奶冰淇淋吞了下去
        mpjunk all
        mpecho $I滿意地舔了舔嘴巴
        mpechoat $n $I[1;33m告訴你「果然是艾甌娜特製的冰淇淋好吃」[m
        mpcallout 1 ponder
        mpcallout 2 mpgold $n 10000
        mpcallout 2 mpechoat $n $I[1;33m告訴你「對了，買東西的錢先拿給你」[m
        mpcallout 2 hop
        mpcallout 2 mpechoat $n $I[1;33m告訴你「這樣你就可以繼續幫我買東西了」[m
        mpcallout 2 mpechoat $n $I[1;33m告訴你「為了答謝你幫我跑腿，那我就教你企鵝語好了」[m
        mpcallout 2 mpechoat $n $I[1;33m告訴你「看你幫我買東西買了這麼久，你一定是很難跟其他村民溝通吧？」[m
        mpcallout 3 mpechoat $n $I[1;33m告訴你「好了，我要開始說了」[m
        mpcallout 4 mpechoat $n 雖然$I很努力在教，但是你覺得你完全聽不懂他在教什麼.
        mpcallout 4 mpechoat $n $I[1;33m告訴你「把字母這樣跟那樣後，再前後顛倒取代對消就沒問題了」[m
        mpcallout 4 mpechoat $n $I[1;33m告訴你「企鵝話很簡單，只不過要這樣這樣還有那樣就可以了」[m
        mpcallout 5 mpechoat $n $I[1;33m告訴你「算了，直接給你這本還比較快」[m
        mpcallout 6 mpdel_qmark self talking
        mpcallout 6 mpdel_qmark $n southend_booboo_language
        mpcallout 6 mpmod_qmark $n southend_quest v0 | 1
        mpcallout 6 mpskillexp $n 5000
        mpcallout 6 mpexp $n 10000
        mpcallout 6 mpechoat $n $I[1;33m告訴你「好啦，自己慢慢唸吧」[m
        mpcallout 6 drop book
        mpcallout 6 give book $n
        mpcallout 6 mpoload 1751 $n
        mpcallout 6 mpechoat $n $I拿給你企鵝語課本(Book).
    else
        mpechoat $n $I[1;33m告訴你「喔喔，牛奶冰淇淋耶！」[m
        mpechoat $n $I[1;33m告訴你「真是太好了，太久沒吃冰淇淋，都快忘記是什麼滋味了」[m
        mpecho $I三口兩口地把牛奶冰淇淋吞了下去
        mpjunk all
        mpecho $I滿意地舔了舔嘴巴
        mpechoat $n $I[1;33m告訴你「果然是艾甌娜特製的冰淇淋好吃」[m
        if is_qmark($n) & southend_quest 100001
            mpcallout 1 drop book
            mpcallout 1 give book $n
            mpcallout 1 mpoload 1751 $n
            mpcallout 1 mpechoat $n $I[1;33m告訴你「這是你要的」[m
            mpcallout 2 mpdel_qmark self talking
        endif
    endif
 else
    mpecho $I[1;33m大喊著：「企鵝奧義－冰凍之風」[m
    mpechoat $n 你感覺你正要張開的嘴，被冰封起來了。
    mpechoaround $n 你感覺有個不禮貌的傢伙嘴被冰起來了。
    mpcallout 1 mpechoat $n 啊......冰淇淋被$I偷吃了。
    mpcallout 1 mpjunk all
    mpcallout 1 mpechoat $n $I突然愣了一下......
 endif
