>tick_prog 100~
 if pcnum($) > 0
     if is_qmark($r) != southend_study_dream
        mpechoat $r 一陣刺痛後，你從夢的世界驚醒回來......
        mpechoat $r 不過你真懷疑 怎麼會回到這邊來呢
        mptransfer $r 1840
        mpforcer 1840 force all look
        break
     endif
     if is_qmark($r) < southend_study_dream 1003
        mpechoat $r 越來越遠......這匹馬越來越遠了......
        break
     endif
     if is_qmark($r) == southend_study_dream 1003
        mpechoat $r 這匹黑色的駿馬狠狠的從你身上踏過去
        mpforcer here modhmv $r 03.95 99 0
        mpforcer here modhmv $r 13.45 55 0
        mpforcer here modhmv $r 24.50 100 0
        break
     endif
     if is_qmark($r) < southend_study_dream 1007
        mpechoat $r 越來越近......這匹馬越來越近了......
        break
     endif
     if is_qmark($r) == southend_study_dream 1007
        mpechoat $r 一轉眼，白髮蒼蒼的老人不見了.......
        mpechoat $r 迎面而來的...是一匹帥氣的黑色駿馬
        break
     endif
     if is_qmark($r) < southend_study_dream 1011
        mpechoat $r 老人走了一步棋，你也馬上跟著走了一步
        break
     endif
     if is_qmark($r) == southend_study_dream 1011
        mpechoat $r 漂亮的山水忽然不見了
        mpechoat $r 轉眼間，你來到了一間小竹屋裡面
        mpechoat $r 在你眼前坐著一個正在下棋的白髮老頭
        break
     endif
     if is_qmark($r) < southend_study_dream 1015
        mpechoat $r 美麗的山水風光讓你不禁陶醉在這裡面
        mpforcer here modhmv $r 04.40 80 0
        break
     endif
     if is_qmark($r) == southend_study_dream 1015
        mpechoat $r 在你面前，忽然出現了壯麗河山的景緻
     endif
 endif
~
