        callout 1 echoat $n 你仔細的聆聽著......
        callout 2 echoat $n ......好像有細小聲音
        callout 3 echoat $n 你仔細的聆聽著......
        callout 4 echoat $n ......細碎的聲音越來越清楚
        callout 5 echoat $n 你仔細的聆聽著......
        callout 6 echoat $n ......從房子裡面傳來了聲音
        callout 8 echoat $n 艾利多(Elido)吶喊著：「北七萬歲～～」
        callout 9 echoat $n 這是......？？
     else
        echoat $n 你仔細的聆聽著......
        echoaround $n $N仔細的聆聽著......似乎有什麼聲音引起了他很大的興趣
        callout 1 echoat $n 你仔細的聆聽著......
