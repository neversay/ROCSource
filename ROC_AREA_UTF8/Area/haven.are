~
>talk_prog yes~
 if is_qmark($i) == talking
        mpechoat $n $I正和別人說話著.
        break
 endif
 if inroom($i) == 1593
        break
 endif
 if is_qmark($n) == ghostday_2005_mb 100002
        mpadd_qmark self talking 3 0 0 0 1 0
        say 太好了.......
        mpecho 你看到$I的眼睛裡泛著淚光.
        mpcallout 2 mpechoat $n 你等到$I心情稍微平復後，就告訴她有關牛郎的事情.
        mpcallout 3 ponder
        mpcallout 4 say 她們指出今年有人遊說了眾喜鵲，讓牠們今年不再來搭建鵲橋。
        mpcallout 4 say 這件事情我也有注意到，前幾天奴家的姊妹已經通知了奴家
        mpcallout 6 say 奴家才可以度過這邊和夫君還有孩子們見面。
        mpcallout 6 say 可是要和夫君見面，唯有召齊七七四十九隻喜鵲搭成鵲橋
        mpcallout 8 say 英雄，可不可以請您四處去將那些喜鵲們勸說回來？(Yes/No)
        mpcallout 8 mpdel_qmark self talking
        mpcallout 8 mpmod_qmark $n ghostday_2005_mb v0 = 3
 endif
 if is_qmark($n) == ghostday_2005_mb 100000
 or is_qmark($n) == ghostday_2005_mb 100003
        mpadd_qmark self talking 3 0 0 0 1 0
        say 太好了！真是太感謝您了。
        mpcallout 1 say 我記得牠們對薄荷草的味道特別的喜歡，你可以找這個去試試看。
        mpcallout 1 say 對了！喜鵲們很怕生的，你最好帶點吃的東西來吸引牠們的注意。
        mpcallout 3 say 讓牠們違背上天的意思。請您務必將牠們勸說回來。
        mpcallout 3 say 如果能夠成功的留住牠們的話，和牠們談談也許就可以知道是誰慫恿牠們
        mpcallout 5 say 牠們雖然是動物不過也頗有靈性的，聽的懂人語言。您大可放心溝通的問題！
        mpcallout 6 say 唯有這個方法，奴家才能和夫君還有孩子們見上一面。
        mpcallout 7 say 英雄，拜託您了！
        mpcallout 7 mpdel_qmark self talking
        mpcallout 7 mpmod_qmark $n ghostday_2005_mb v0 = 4
 endif
~
