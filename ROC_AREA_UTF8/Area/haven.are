>hitprcnt_prog 50~
 mpat 5 c 'full heal'
 mpgoto self
~
>talk_prog topic~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_kent_tion 100018
        if mobcount(1790) == 0
            if mobcount(1801) == 0
                mpecho $I[1;32m說著「結束了.......」[m
                mpecho $I[1;32m說著「....一切都結束了......」[m
                break
            endif
        endif
        mpadd_qmark self talking 3 0 0 0 1 0
        mpecho $I[1;32m說著「手印結界！？」[m
        mpcallout 1 mpecho $I[1;32m說著「那很簡單啊，只要是高級法師應該都會掌控自身能量的流向」[m
        mpcallout 2 mpecho $I[1;32m說著「所以只要在石碑之前，將法力引到手掌上，然後結出結界手勢就好了」[m
        mpcallout 3 mpecho $I[1;32m說著「手勢結法是先將食指扣在拇指上，然後運用手掌讓小指押在中指上」[m
        mpcallout 4 mpecho $I[1;32m說著「最後在依序作出下列動作就可以了」[m
        mpcallout 5 mpecho 你強記下$I所比的結印法(display Sn-De-Ca-Sn)
        mpcallout 5 mpecho $I[1;32m說著「不過要注意幾點」[m
        mpcallout 6 mpecho $I[1;32m說著「首先是只有高級法師才能掌控好自己的能量」[m
        mpcallout 7 mpecho $I[1;32m說著「要是能量沒掌控好的話，可是會反嗜自己的」[m
        mpcallout 8 mpecho $I[1;32m說著「第二是，引發結界之後能量會一直被吸走」[m
        mpcallout 9 mpecho $I[1;32m說著「假設能量不足的話，結界是會失去效用的」[m
        mpcallout 10 mpecho $I[1;32m說著「加油了！勇者們」[m
        mpcallout 10 mpdel_qmark self talking
        mpcallout 10 mpmod_qmark $n southend_kent_tion v0 = 19
     else
        mpecho $I[1;32m說著「可惡！熊王出現的太急太快了」[m
        mpecho $I[1;32m說著「我只來得及救出基娜，可是南夏和理麗娜就......」[m
     endif
 else
     mpechoat $n $I忙的很
 endif
~
