>talk_prog topic~
 if is_qmark($n) & southend_quest 100002
     if rand(25)
        mpechoat $n $I[1;33m告訴你「上次我發現布布又偷吃冰淇淋了」[m
        mpechoat $n $I[1;33m告訴你「結果他居然逃到極光之湖裡面」[m
        mpechoat $n $I[1;33m告訴你「害我好擔心他喔」[m
     else
        if rand(33)
            mpechoat $n $I[1;33m告訴你「南夏還有理麗娜老是在那邊曬太陽」[m
            mpechoat $n $I[1;33m告訴你「不知道布布會不會一起去聊天」[m
            mpechoat $n $I[1;33m告訴你「如果這樣的話，我得趕快準備防曬油」[m
        else
            if rand(50)
                mpechoat $n $I[1;33m告訴你「布布老是一直在吃冰淇淋」[m
                mpechoat $n $I[1;33m告訴你「真擔心他吃太多會吃壞肚子」[m
            else
                mpechoat $n $I[1;33m告訴你「住在街尾的人類真的好厲害喔」[m
                mpechoat $n $I[1;33m告訴你「她每次都會做一些有用的東西給我們用」[m
                mpechoat $n $I[1;33m告訴你「不知道上次跟她買的東西」[m
                mpechoat $n $I[1;33m告訴你「布布用起來合不合適」[m
            endif
        endif
     endif
 else
     mpadd_qmark self talking 3 0 0 0 0 1
     mpechoat $n $I[1;33m告訴你「淇吃直是布布老一在冰淋」[m
     mpechoat $n $I[1;33m告訴你「吃會多心擔真太吃他子肚壞」[m
     if is_qmark($n) & southend_quest 100001
        break
     endif
     if is_qmark($n) != southend_booboo_language
        mpadd_qmark $n southend_booboo_language -1 4 0 0 0 1
        mpcallout 1 mpechoat $n 冰淋？冰淇淋？？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
     else
        mpmod_qmark $n southend_booboo_language v0 | 4
     endif
     if is_qmark($n) == southend_booboo_language 100007
        mpcallout 1 mpechoat $n 難道這麼冷的天氣裡，還會有人想吃冰淇淋？？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
        break
     endif
     if is_qmark($n) == southend_booboo_language 100005
     or is_qmark($n) == southend_booboo_language 100006
        mpcallout 1 mpechoat $n 好像剛剛他也有提到冰淇淋？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
     endif
 endif
~
