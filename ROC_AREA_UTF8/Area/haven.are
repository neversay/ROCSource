>greet_prog 100~
 if is_qmark($i) == talking
 or is_qmark($n) & southend_question 100032
     break
 endif
 if is_inv_obj($n) == 1816
 or is_equ_obj($n) == 1816
     if is_qmark($n) != southend_alc_research
        mpadd_qmark $n southend_alc_research -1 1 0 0 0 1
        tell $n 你....你身上的那個是傳說中的企鵝至寶嗎？？
        tell $n 可以借我看看嗎？
     endif
 endif
~
>give_prog 1816~
 mpjunk silence
 if is_qmark($i) == talking
     tell $n 不理你捏
     mpoload 1816 $n 40 target
     break
 endif
 if is_qmark($n) & southend_question 100032
     tell $n 你不是幫助過我了嗎？
     mpoload 1816 $n 40 target
     break
 endif
 if is_qmark($n) == southend_alc_research 100001
     mpadd_qmark self talking 3 0 0 0 1 0
     tell $n 謝謝你的幫忙.
     mpcallout 1 tell $n 我從企鵝村中的文獻曾經看過這樣的寶物
     mpcallout 2 tell $n 傳說它擁有五行神奇力量
     mpcallout 3 tell $n 我覺得很有趣的，於是我就留在這裡，就是希望有一日可以看到實物
     mpcallout 4 tell $n 假設我能查出這東西的秘密，一定是一個很大的榮譽
     mpcallout 5 tell $n 不知道你願不願意將它留在我這邊讓我好好的查查它的秘密。
     mpcallout 6 tell $n 三天！三天就好了
     mpcallout 7 tell $n 拜託你啦～～
     mpcallout 8 mpechoat $n 你是要借她研究呢(Lend)？還是要強行討回來(Demand)？
     mpcallout 8 mpechoat $n $I似乎不打算將東西還給你
     mpcallout 8 mpmod_qmark $n southend_alc_research v0 = 2
     mpcallout 8 mpdel_qmark self talking
 endif
 if is_qmark($n) == southend_alc_research 100007
     tell $n 謝謝你的幫忙.
     tell $n 現在請幫我找來５００個魔力寶石
     mpmod_qmark $n southend_alc_research v0 = 8
 endif
~
>talk_prog lend~
 if is_qmark($i) == talking
     tell $n 不理你捏
     break
 endif
 if is_qmark($n) == southend_alc_research 100002
     tell $n 真是太謝謝你了，三天之後就會有結果了(Result)。
     mpadd_qmark $n southend_alc_wait 72 0 0 0 0 1
     mpmod_qmark $n southend_alc_research v0 = 3
 endif
 if is_qmark($n) == southend_alc_research 100004
     tell $n 真是太謝謝你了，這一陣子一定會有結果(Result)。
     mpadd_qmark $n southend_alc_wait 170 0 0 0 0 1
     mpmod_qmark $n southend_alc_research v0 = 5
 endif
~
>talk_prog demand~
 if is_qmark($i) == talking
     tell $n 不理你捏
     break
 endif
 if is_qmark($n) == southend_alc_research 100002
 or is_qmark($n) == southend_alc_research 100004
     tell $n 好吧！
     tell $n 這也是沒辦法的事情
     mpoload 1816 $n 40 target
     mpdel_qmark $n southend_alc_research
     mpmod_qmark $n southend_quest v0 | 32
 endif
~
>talk_prog result~
 if is_qmark($i) == talking
     tell $n 不理你捏
     break
 endif
 if is_qmark($n) == southend_alc_wait
     tell $n 有耐心點，我就快查出來了。
     break
 endif
 if is_qmark($n) == southend_alc_research 100003
     mpadd_qmark self talking 3 0 0 0 1 0
     tell $n 你終於來了
     mpcallout 1 tell $n 這三天以來，我發現了這項寶物的最大秘密。
     mpcallout 2 tell $n 可是他的魔力卻超乎我的想像
     mpcallout 3 tell $n 想要破除這道守護之牆，我還需要再七天的時間。
     mpcallout 4 tell $n 你願意再借給我嗎？
     mpcallout 5 mpechoat $n 你是要繼續借她研究呢(Lend)？還是要強行討回來(Demand)？
     mpcallout 5 mpmod_qmark $n southend_alc_research v0 = 4
     mpcallout 5 mpdel_qmark self talking
 endif
 if is_qmark($n) == southend_alc_research 100005
     mpadd_qmark self talking 5 0 0 0 1 0
     tell $n 你終於又回來了喔！
     mpcallout 2 tell $n 在這一個星期之中，我終於知道隱藏在這手環之中的秘密了。
     mpcallout 4 tell $n 這個冰靜手環，其實只是個未打開的寶藏
     mpcallout 6 tell $n 因此，它現在只是個幻影罷了。
     mpcallout 8 tell $n 如果我有更多的魔力的話，我一定能夠將這層幻影給破除。
     mpcallout 9 tell $n 破除幻影之後才能顯現出它存在的力量。
     mpcallout 10 tell $n 除此之外，搭配上了五元素的力量的話
     mpcallout 11 tell $n 這手環會從「靜」的狀態變成「動」的狀態
     mpcallout 12 tell $n 到時它的能力一定會更強大，可惜「動」狀態還需要某種神秘的力量來克制
     mpcallout 13 tell $n 否則，強迫啟動其力量的話，一定會給使用者帶來強大的反噬。
     mpcallout 14 ponder
     mpcallout 15 ponder
     mpcallout 16 ponder
     mpcallout 17 ponder
     mpcallout 18 ponder
     mpcallout 19 tell $n 煩惱那些也沒用，我現在連最基礎的破除幻影都做不到了。
     mpcallout 20 tell $n 不過還是謝謝你慷慨的贊助。
     mpcallout 21 sigh
     mpcallout 22 tell $n 可以的話，還真的很希望有人可以幫助我破除幻影
     mpcallout 23 sigh
     mpcallout 24 tell $n 對了，這些是我一點的謝意，還有你的手環。
     mpcallout 25 mpoload 1816 $n 36 target
     mpcallout 25 mpgold $n 50000
     mpcallout 25 mpexp $n 5000
     mpcallout 25 mpdel_qmark self talking
     mpcallout 25 mpmod_qmark $n southend_alc_research v0 = 6
 endif
