            mpcallout 12 mpadd_qmark tion-image talking 3 0 0 0 1 0
            mpcallout 12 mpmload 1792
            mpcallout 13 mpecho $I在 泫幻影(Tion's image)耳旁悄悄的說了幾句話
            mpcallout 14 mpecho $I和 泫幻影(Tion's image)之間的悄悄話越來越大聲
            mpcallout 15 mpecho 這談話的內容......！？
            mpcallout 16 mpecho ......
            mpcallout 17 mpecho ............
            mpcallout 18 mpecho ..................
            mpcallout 19 mpecho ......(不耐煩)...............
            mpcallout 20 mpecho .....................(怒！！)
            mpcallout 21 mpechoaround $n $N的手高高舉起，往$I的頭上狠狠地敲了下去，打得他眼冒金星。
            mpcallout 21 mpechoat $n 你的手高高舉起，往$I的頭上狠狠地敲了下去，打得他眼冒金星。
            mpcallout 22 mpechoaround $n $N[1;32m憤怒的說著「 談正事的時候，不要給我談情說愛。」[m
            mpcallout 22 mpechoat $n [1;32m你憤怒的說著「 談正事的時候，不要給我談情說愛。」[m
            mpcallout 23 mpechoaround $n $I難過的望著$N
            mpcallout 23 mpechoat $n $I難過的望著你
            mpcallout 24 mpechoat $n $I[1;32m告訴你「 好啦！！好啦！！我就快說完了。」[m
            mpcallout 25 mpecho $I說完話後，又轉身回去和　泫幻影(Tion's image)說悄悄話
            mpcallout 26 mpecho ......
            mpcallout 27 mpecho ............
            mpcallout 28 mpechoat $n $I[1;33m告訴你「 我說完了，換你說了。」[m
            mpcallout 29 mpechoat $n $I[1;33m告訴你「 把詳細情形仔細的和她說吧。」[m
            mpcallout 30 mpdel_qmark self talking
            mpcallout 30 mpdel_qmark tion-image talking
            mpcallout 30 mpmod_qmark $n southend_kent_tion v0 = 11
        else
            mpechoat $n $I[1;33m告訴你「你先等一下，讓我把話說完你再進來。」[m
            mpforce $n south
        endif
     endif
