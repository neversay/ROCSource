     if rand(70)
        mpecho $N的熱情讓$I快速的溶化了.
        mpmod_qmark self melt v0 + 3
     else
        mpecho $N的熱情似乎沒什麼用處.
     endif
 endif
 if is_qmark($i) > melt 100015
     mpecho $I因為$N的熱情完全溶化了.
     mpecho 地上也掉滿著$I溶化後所剩的冰塊.
     if rand(20)
        mpoload 1757 floor
        if rand(25)
            mpoload 1757 floor
            if rand(33)
                mpoload 1757 floor
                if rand(50)
                    mpoload 1757 floor
                endif
            endif
        endif
     endif
     mpoload 1757 floor
     mpoload 1757 floor
     mpoload 1757 floor
     mppurge self
 endif
~
>act_prog love~
