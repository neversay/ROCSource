>talk_prog topic~
 if is_qmark($i) != talking
     if mobcount(1790) == 0
        if mobcount(1801) == 0
            say 極地熊王終於被消滅了.
            say 這下可歹好好的重建整個企鵝村了.
            break
        endif
     endif
     say 居然會發生這種事情.
     ponder
     say 不過這個地方真的是十分有趣呢
     say 也許是這裡也是利用鍊金術(alchemy)做出來的.
 else
      tell $n 不理你捏
 endif
~
>talk_prog alchemy~
 if is_qmark($i) != talking
     say 鍊金術是很實用的技術．
     say 最終目標是為了做出賢者之石(philosopher's stone)
     say 那是練金術士的最高夢想，也是我努力的目標
     say 不過我還在修行，只能製造出一些日用品(supplies)來
     pat marie-human
 else
     tell $n 不理你捏
 endif
~
>talk_prog p philosopher's stone~
 if is_qmark($i) != talking
     mpadd_qmark self talking 3 0 0 0 1 0
     say 賢者之石，是傳說中能把任何的劣金屬轉為黃金的萬能催化劑，
     say 或是泡水溶解即能做成長生不死之藥，也是稱之為萬靈藥(elixir)的東西．
     say 最近有聽到流言說，好像有人在一間屋子裡利用賢者之石來賦予無機體生命？
     say 也不知道後來怎麼了，只希望不要做壞事就好了．
     mpcallout 1 shrug
     if is_qmark($n) == southend_alc_elie 100001
        mpcallout 2 mpecho 你覺得她的說話語氣跟身影，好像在哪邊看過的樣子．．．
        mpcallout 2 mpmod_qmark $n southend_alc_elie v0 = 2
     endif
     mpcallout 2 mpdel_qmark self talking
 else
     tell $n 不理你捏
 endif
~
>talk_prog elie~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_alc_elie 100002
        mpadd_qmark self talking 3 0 0 0 1 0
        say 艾莉(Elie)啊？
        say 的確是好久不見了，也不知道她研究出來賢者之石了沒．
        mpcallout 1 echo $I忽然想起了什麼事......
        mpcallout 2 swing $n
        mpcallout 2 say 你有看過艾莉？！你知道他現在在哪裡嗎？
        mpcallout 3 mpecho 你心中在想：艾莉？不就是在迷航之海(mistocean)嗎？
        mpcallout 3 mpmod_qmark $n southend_alc_elie v0 = 3
        mpcallout 3 mpdel_qmark self talking
     else
        say 她是我一個很好的朋友喔，可是不知道她到哪研究去了。
     endif
 else
     tell $n 不理你捏
 endif
~
>talk_prog mistocean~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_alc_elie 100003
        mpadd_qmark self talking 3 0 0 0 1 0
        say 喔，你確定她真的在那邊嗎？
        mpcallout 1 say 如果你碰的到她的話，可以幫我捎個信給她嗎？
        mpcallout 2 say 那邊的進度如何了^^？(Yes/No)
        mpcallout 2 say 因為我們都是在研究著賢者之石，所以我想問看看她
        mpcallout 2 mpmod_qmark $n southend_alc_elie v0 = 4
        mpcallout 2 mpdel_qmark selk talking
     else
        say 那是？
     endif
 else
     tell $n 不理你捏
 endif
~
>talk_prog yes~
 if is_qmark($n) != talking
     if is_qmark($n) == southend_alc_elie 100004
        mpadd_qmark self talking 3 0 0 0 1 0
        say 真是太好了，那請你稍微等候一下，我寫信很快的．
        mpcallout 1 mpecho 瑪莉轉身從後面櫃子中取出了筆跟一疊羊皮紙．
        mpcallout 2 mpecho 瑪莉坐在桌前，手中的筆刷刷地飛舞著．
        mpcallout 3 meecho 瑪莉忽然間停下了筆，嘴巴叼著筆桿開始沉思．
        mpcallout 4 mpecho 過了不久，瑪莉又刷刷地寫起信來．
        mpcallout 7 give letter $n
        mpcallout 7 mpoload 1755 1
        mpcallout 8 say 也麻煩你拿過來好嗎，那就辛苦你了^^
        mpcallout 8 say 這封信就麻煩你交給她了，如果她有請你拿什麼東西給我，
        mpcallout 8 mpmod_qmark $n southend_alc_elie v0 = 5
        mpcallout 8 mpdel_qmark self talking
        break
     endif
     if is_qmark($n) == southend_alc_elie 100007
        mpadd_qmark self talking 3 0 0 0 1 0
        say 嗯，那就請你幫我收集兩個材料就好，
        mpcallout 1 say 另一個則是蘊涵著這南極凜冽氣息的東西，
        mpcallout 1 say 一個是有著太陽光輝之物，
        mpcallout 2 say 當然我這邊也會有東西可以給你喔^^
        mpcallout 2 say 如果你拿來這兩個東西的話，我就有可能把這把杖修好^^
        mpcallout 2 mpmod_qmark $n southend_alc_elie v0 = 8
        mpcallout 2 mpdel_qmark self talking
     endif
 else
     tell $n 不理你捏
 endif
~
>give_prog 1797~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_alc_elie 100006
        mpadd_qmark self talking 3 0 0 0 1 0
        say 嗯，的確是這把杖沒錯．
        mpcallout 1 say 不過怎麼會壞的這麼嚴重啊？！
        mpcallout 2 say 雖然說常用也是好事，但是壞的太可怕了吧......
        mpcallout 3 mpecho 瑪莉的右手輕輕撫摸著破破爛爛的杖身......
        mpcallout 4 mpecho 左手也輕輕觸碰著杖頂已失去光芒的寶石．
        mpcallout 6 say 連珠子都因為使用出太多力量都變成黯淡無光，
        mpcallout 7 say 看來要修好真的會很棘手了．
        mpcallout 8 mpechoat $n 瑪莉打量了你一眼．
        mpcallout 8 mpechoaround $n 瑪莉往$n那邊看了一眼．
        mpcallout 10 say 不知道你是否還有空呢？
        mpcallout 11 say 想請你幫我收集一些東西，不知道你能否幫忙(Yes/No)？
        mpcallout 11 mpmod_qmark $n southend_alc_elie v0 = 7
        mpcallout 11 mpdel_qmark self talking
     else
        say 這是？
        drop all
     endif
 else
     tell $n 不理你捏
     drop all
 endif
~
>give_prog 32040~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_alc_elie 100008
