                mpechoat $n $I[1;33m告訴你「你答應要帶我去觀光的，別忘記了。」[m
        endif
 else
        if is_qmark($i) == to_see_mist
                mpdel_qmark self to_see_mist
        endif
        if is_qmark($i) == to_see_solace
                mpdel_qmark self to_see_solace
        endif
        if is_qmark($i) == to_see_forest
                mpdel_qmark self to_see_forest
        endif
        if is_qmark($i) == to_see_gtown
                mpdel_qmark self to_see_gtown
        endif
        if is_qmark($i) == to_see_dead
