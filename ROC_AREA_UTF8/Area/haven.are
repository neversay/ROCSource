#1856
magpie_ghostday-2005-a bird~
喜鵲(Magpie)~
一隻小小的鳥(bird)在這邊飛翔著.
~
　　牠是一隻愉快的喜鵲，正在這邊飛翔遊玩著。
只是......平常的這個時候，他們應該要準備著去
幫助牛郎織女，不過今年牠們似乎特別的奇怪，到
現在這個時候還在這邊逗留著。
~
1|2|64|1048576 8|32|549755813888 -600 S
25 30000 0 0d0+0 0d0+0
0 0
0 8 2
R Animal~
P 1|2|4|8|128|32768|65536|131072|1048576|2097152|67108864
>repop_prog 100~
 follow magpie-king_ghostday-2005
 mpforce magpie-king_ghostday-2005 group all
 mpadd_qmark self staytime -1 0 0 0 1 0
 if rand(50)
        mpteleport recall1
 else
        mpteleport recall2
 endif
~
>talk_prog topic~
 if isfollow($i)
        break
 endif
 if is_qmark($i) == talking
        mpechoat $n $I正和別人說話著.
        break
 endif
 if is_qmark($n) == ghostday_2005_mb 100004
        mpadd_qmark self talking 5 0 0 0 0 1
        mpechoat $n 你仔細地將牛郎織女的願望告知了$I。
        mpcallout 1 mpechoat $n 於是你又再一次將事情原委說了一次。
        mpcallout 1 mpechoat $n $I似乎有聽沒有懂
        mpcallout 2 mpecho $I[1;32m說著「人家也知道該去幫助牛郎織女.....可是人家......」[m
        mpcallout 5 mpecho $I[1;32m說著「....人家完全迷路了嘛......」[m
        mpcallout 6 mpecho $I[1;32m說著「可以的話，請你帶人家過去吧。」[m
        mpcallout 7 mpecho $I[1;32m說著「不然給人家一張古老地圖(Old Map)，人家自己就可以過去了。」[m
        mpcallout 8 mpecho $I[1;32m說著「決定好了話請拿給人家地圖或是跟人家說ＯＫ」[m
        mpcallout 8 mpdel_qmark self talking
 endif
~
>talk_prog ok~
 if isfollow($i)
        break
 endif
 if is_qmark($i) == talking
        mpechoat $n $I正和別人說話著.
        break
 endif
 if is_qmark($n) == ghostday_2005_mb 100004
        mpecho $I[1;32m說著「那就...拜託了」[m
        bow $n
        follow $n
        mpdef_rembch $n
 endif
~
>give_prog 5013~
 if isfollow($i)
        break
 endif
 if is_qmark($i) == talking
        mpechoat $n $I正和別人說話著.
        drop all
        break
 endif
 if is_qmark($n) == ghostday_2005_mb 100004
        mpjunk all.map
        mpecho $I[1;32m說著「真是太感謝你了，這下我就可以找到路了。」[m
        mpecho 話一說完，$I立刻展翅飛走了.
        mpechoat $n 　
        mpechoat $n 雖然$I信心滿滿的說著，不過你還是非常的擔心......
        mpechoat $n 不過無論如何，希望牠能真的找到正確的路。
        mpechotoall [1;36m天上的一顆星星正閃耀著[m
        mpforcer 1593 modrvt v0 + 1
        mpmod_qmark $n ghostday_2005_mb v1 + 1
        mppurge self
 endif
~
>entry_prog 100~
 if is_qmark($i) == talking
        break
 endif
 if inroom($i) == 1594
 or inroom($i) == 1595
        mpecho $I[1;32m說著「真是太感謝你了，這下我就找到路了。」[m
        mpecho 話一說完，$I便化作天上的一顆星星.
        mpechotoall [1;36m天上的一顆星星正閃耀著[m
