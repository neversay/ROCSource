>obj_rand 50~
if is_equ_obj($n) != 1819
	break
endif
if mpnum($n) < 125
	break
endif
if objval3($o) >= 3
	break
endif
echoat $n 你感受到一道火焰燃燒著你的心頭，可是你卻一點也沒受傷！
modhmv $n 11.75 125 0
oforcer here at $n mod_qmark $n southend_quest v1 + 1
if is_qmark($n) >= southend_quest 200010
	echoat $n 鑲在 冰火手環(Ice-Fire Bracer) 上的紅寶石，其中一個發出了亮眼的光彩！
	oforcer here at $n mod_qmark $n southend_quest v1 = 0
	oset self value3 + 1
endif
~
>obj_act remove~
 oset self value3 = 0
 echoat $n 冰火手環(Ice-Fire Bracer) 的力量消散在四周！
~
