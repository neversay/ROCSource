        if is_qmark($n) >= southend_booboo_language 100009
        or is_qmark($n) & southend_quest 100001
                mpadd_qmark self talking 3 1 0 0 1 0
                mpechoat $n $I[1;33m告訴你「人客位這，賒意本小生不帳」[m
                mpechoat $n $I[1;33m告訴你「意滿你淋淇冰店本的產特令定一」[m
                mpcallout 1 mpcall step1 $n
