>room_command search green dragon corpse~
 if roomtimer($0) == 0
     break
 endif
 if roomvalue($0) > 0
     break
 endif
 modrvt v0 = 1
 echoaround $n $N努力的搜索著綠龍的屍體
 echoat $n 你努力的搜索著綠龍的屍體
 callout 1 modrvt v0 = 0
 callout 1 echoat $n 這隻綠龍窮酸透了，看來只好拔了他的牙，扒了他的鱗當作紀念
~
>room_command pluck teeth~
 if roomtimer($0) == 0
     break
 endif
 if roomvalue($0) > 0
     break
 endif
 modrvt v0 = 1
 echoaround $n $N努力的拔著綠龍的牙齒
 echoat $n 你努力的拔著綠龍的牙齒
 if roomvalue($1) <= 3
     callout 1 echoaround $n 不過看起來徒勞無功
     callout 1 echoat $n 這牙齒根本拔不起來，再努力一下吧！
     callout 1 modrvt v1 + 1
     callout 1 modrvt v0 = 0
     break
 endif
 if roomvalue($1) <= 6
     callout 1 echoaround $n 不過看起來徒勞無功
     callout 1 echoat $n 這牙齒開始鬆動了，再努力一下吧！
     callout 1 modrvt v1 + 1
     callout 1 modrvt v0 = 0
 endif
 if roomvalue($1) >= 7
     callout 1 echoaround $n $N從綠龍的嘴裡拔出一顆牙齒了
     callout 1 echoat $n 你從綠龍的嘴裡拔出一顆牙齒了
     callout 1 oload 1811 1 $n target
     callout 1 modrvt v1 = 0
     callout 1 modrvt v0 = 0
 endif
~
