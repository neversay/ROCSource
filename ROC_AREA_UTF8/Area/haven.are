>talk_prog topic~
 if is_qmark($i) != talking
     if mobcount(1790) == 0
        if mobcount(1801) == 0
            mpecho $I[1;32m說著「重建啊.....」[m
            mpecho $I[1;32m說著「各位加油了！」[m
            break
        endif
     endif
     mpechoat $n $I[1;33m說著「想不到還是讓他復活了......」[m
     if is_qmark($n) == southend_kent_tion 100017
        mpadd_qmark self talking 3 0 0 0 1 0
        ponder
        mpcallout 1 mpecho $I[1;32m說著「進攻的戰略啊......」[m
        mpcallout 2 mpecho $I[1;32m說著「其實還蠻簡單的」[m
        mpcallout 3 mpecho $I[1;32m說著「首先你們得先讓一些高級法師在石碑附近設下結界」[m
        mpcallout 4 mpecho $I[1;32m說著「只要法師們的魔力不散，我想除了熊王之外沒有一隻熊可以突破」[m
        mpcallout 5 mpecho $I[1;32m說著「所以在設下結界的同時，你們必須想辦法纏住熊王，讓牠無法分身」[m
        mpcallout 6 mpecho 你心裡想著：是啊！出一張嘴是很簡單啊，去做可就難了。
        mpcallout 6 mpecho $I[1;32m說著「很簡單對吧！只可惜我們企鵝族安逸太久了，現今只能靠你們了」[m
        mpcallout 7 mpecho $I[1;32m說著「加油吧！各位勇者。」[m
        mpcallout 8 mpecho $I[1;32m說著「對了！只要向石碑祈禱就可以傳送力量給泫了」[m
        mpcallout 9 mepcho $I[1;32m說著「然後只要高級法師結出特殊手印就可以設下結界」[m
        mpcallout 10 mpecho $I[1;32m說著「手印的結法你們可以去問布布，他是我們村裡最強的智者」[m
        mpcallout 11 mpecho $I[1;32m說著「他同時精通各種劍技，還會通曉各種知識，以及神秘的古力量」[m
        mpcallout 12 mpecho $I[1;32m說著「手印結界法，就是他最擅長的了，可惜他就是貪嘴了點」[m
        mpcallout 12 mpdel_qmark self talking
        mpcallout 12 mpmod_qmark $n southend_kent_tion v0 = 18
     endif
 else
     mpechoat $n $I忙著很
 endif
~
