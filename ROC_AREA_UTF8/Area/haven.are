     oforcer here at $n forcer $n look
 else
     echoaround $n $N試著去觸摸[1;37m冰雪尖碑[m(ice-snow stele)
     echoaround $n 可是為何$N露出一臉寂寞樣呢！？
     echoat $n 一陣寒冰氣息穿過你手上，你感到空虛！寂寞！覺得冷！
     oforcer here modhmv $n 13.20 30 0
