>act_prog kiss~
 if is_qmark($i) == dissolve
     if rand(50)
        mpecho $N的熱情一吻讓$I緩緩的溶化了.
        mpmod_qmark self melt v0 + 1
     else
        mpecho $N給了$I熱情一吻.
        mpcallout 1 mpecho $N的嘴卻因此黏在$I身上拔不下來.
     endif
 endif
 if is_qmark($i) > melt 100015
     mpecho $I因為$N的熱情完全溶化了.
     mpecho 地上也掉滿著$I溶化後所剩的冰塊.
     if rand(50)
        mpoload 1808 floor
        if rand(33)
            mpoload 1808 floor
            if rand(25)
                mpoload 1808 floor
                if rand(20)
                    mpoload 1808 floor
                endif
            endif
        endif
     endif
     mpoload 1808 floor
     mppurge self
 endif
~
>act_prog sm!~
