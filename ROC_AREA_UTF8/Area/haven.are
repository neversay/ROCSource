        endif
        if is_qmark($i) == to_see_malathar
                mpdel_qmark self to_see_malathar
        endif
        if is_qmark($i) == to_see_ageemephy
                mpdel_qmark self to_see_ageemephy
        endif
        if is_qmark($i) == to_see_purgator
                mpdel_qmark self to_see_purgator
        endif
        if is_qmark($i) >= staytime 100010
                mpecho $I振翅飛走了.
                mpteleport recall2
                mpmod_qmark self staytime v0 = 0
        endif
 endif
