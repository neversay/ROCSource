                mpechoat $n $I[1;33m告訴你「那可是本村最大的智慧結晶呢」[m
        endif
     else
        if rand(33)
                mpechoat $n $I[1;33m告訴你「香甜好滋味........」[m
        else
                if rand(50)
                        mpechoat $n $I[1;33m告訴你「牛奶、草莓、巧克力......」[m
                else
                        mpechoat $n $I[1;33m告訴你「冰冰涼涼........」[m
                endif
        endif
     endif
 else
        mpecho $I[1;33m大喊著：「企鵝奧義－冰凍之風」[m
        mpechoat $n 你感覺你正要張開的嘴，被冰封起來了。
        mpechoaround $n 你感覺有個不禮貌的傢伙嘴被冰起來了。
 endif
