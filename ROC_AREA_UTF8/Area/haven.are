>tick_prog 70~
 if is_qmark($i) == talking
     break
 endif
 if hour($) >= 18
 or hour($) < 6
     if is_qmark($i) >= marie_material 100001
     if is_qmark($i) >= marie_material 200003
        mpecho 瑪莉從櫃子裡取出了一個珠子，一罐罐子，一個小包包，跟一根管子．
        mpecho 瑪莉從管子裡取出三個黑球，並從包包內拿出三個魔晶石，並在每一個
        mpecho 黑球內塞入一個魔晶石，之後把這三個黑球兩兩相靠，壓緊固定住後放
        mpecho 珠子的空心部份，之後把珠子緊緊密封好，慢慢放進了一個上面標示著
        mpecho 「爆裂物」的箱子內.
        mpmod_qmark self marie_material v0 - 1
        mpmod_qmark self marie_material v1 - 3
        mpmod_qmark self marie_makeitem v0 + 1
        break
     endif
     endif
     if is_qmark($i) >= marie_material 100001
     if is_qmark($i) >= marie_material 200002
     if is_qmark($i) >= marie_material 300001
        mpecho 瑪莉從櫃子裡取出了一個珠子，一罐罐子，一個小包包，跟一根管子，
        mpecho 瑪莉從包包內拿出一個魔晶石，從罐子裡挖出一杓藥膏，瑪莉把魔晶石
        mpecho 輕輕壓在藥膏上，開始激發魔晶石的魔力，藥膏在一陣閃光之後由黑綠
        mpecho 色轉為紅色，之後瑪莉從管子裡拿出兩個小球，在小球內各塞入兩個從
        mpecho 小包包內拿出的魔晶石，然後在兩球中間用紅色藥膏黏住，之後把這兩
        mpecho 個球放入珠子內部，把這珠子合上後瑪莉把這個珠子放進一個上面貼有
        mpecho 「極危險，勿搖晃」的小箱子內．
        mpmod_qmark self marie_material v0 - 1
        mpmod_qmark self marie_material v1 - 2
        mpmod_qmark self marie_material v2 - 1
        mpmod_qmark self marie_makeitem v1 + 1
        break
     endif
     endif
     endif
     if is_qmark($i) >= marie_material 100001
     if is_qmark($i) >= marie_material 300002
        mpecho 瑪莉從櫃子裡取出了一個珠子，一罐罐子跟一個小包包，
        mpecho 然後開始從罐子裡挖出幾匙藥膏，塞進掰開的珠子裡，然
        mpecho 後把珠子合起從小包包裡拿出四個魔晶石，夾住珠子，開
        mpecho 始激發魔晶石所含的魔力，而珠子慢慢地變小，變成一個
        mpecho 藥丸的形狀．當藥丸完成後，瑪莉把藥丸放進隨身的小包中
        mpmod_qmark self marie_material v0 - 1
        mpmod_qmark self marie_material v2 - 2
        mpmod_qmark self marie_makeitem v2 + 1
        break
     endif
     endif
     mpadd_qmark self talking 3 0 0 0 1 0
     mpcall makeitem self
 endif
