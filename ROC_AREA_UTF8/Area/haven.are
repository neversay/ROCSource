>fight_prog 100~
 mpgoto self
~
>talk_prog topic~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_kent_tion 300003
        if is_qmark($n) == southend_kent_tion 100019
            mpadd_qmark self talking 3 0 0 0 0 1
            say 感謝你的幫忙，拯救了南極地區，還有這個世界
            mpcallout 1 mpecho 忽然，$I好像發現了什麼
            mpcallout 2 mpecho $I開始沉思著......
            mpcallout 3 mpecho $I繼續沉思著......
            mpcallout 4 mpecho $I沉思著...
            mpcallout 5 mpecho $I沉思著......
            mpcallout 6 mpecho $I沉思著.........
            mpcallout 7 mpecho $I居然沉思到睡著了......
            mpcallout 8 mpforce $n -
            mpcallout 9 mpechoaround $n $N奮力的將$I搖醒
            mpcallout 9 mpechoat $n 你奮力的將$I搖醒
            mpcallout 10 say 啊！！剛剛我們說到哪裡了！？
            mpcallout 11 say 對了！！我知道了
            mpcallout 12 say 熊王的冷冽氣息居然在你身上結合了
            mpcallout 12 say 想不到之前我賦予你的冰凍之力和
            mpcallout 13 say 看來這是你的機緣啊！
            mpcallout 14 mpecho $I唸起不知名的咒語
            mpcallout 15 mpechoaround $n 忽然間，從$N身上湧出一股冰的力量，讓$N冷得直發抖
            mpcallout 15 mpechoat $n 忽然間，從你身上湧出一股冰的力量，你被冷到動彈不得！
			mpcallout 15 mpforcer here stun $n 50
			mpcallout 16 say 就送給你當作禮物吧！畢竟這是你的機緣。
            mpcallout 16 say 這把冰劍擁有著冰凍之力和冷冽氣息，是一把神奇的武器
			mpcallout 16 mpoload 1834 $n 40 target
            mpcallout 16 mpdel_qmark $n southend_kent_tion
            mpcallout 16 mpmod_qmark $n southend_quest v0 | 8
			mpcallout 17 mpecho $I從手上拿下一個手環
            mpcallout 17 say 另外，這是回報你這麼辛苦找尋熊王的獎賞。
            mpcallout 18 mpoload 1816 $n 36 target
            mpcallout 18 mpechoaround $n $I將手環送給$N
            mpcallout 18 mpechoat $n $I將手環送給你
            mpcallout 19 say 好了，我得幫助村長整建企鵝村
            mpcallout 20 say 就不送你了，你要好好保重啊！
            mpcallout 20 mpdel_qmark self talking
            break
        endif
     endif
     if mobcount(1790) == 0
        if mobcount(1801) == 0
            say 看來要花上好一段時間才能回復企鵝村的光彩了.
            break
        endif
     endif
     if is_qmark($n) == southend_kent_tion 100007
     or is_qmark($n) == southend_kent_tion 100008
        mpadd_qmark self talking 3 0 0 0 0 1
        say 孩子！我等你們很久了
        mpcallout 1 say 沒想到還是讓那位暴君復活了......
        mpcallout 2 sigh
        mpcallout 3 say 我耗盡了全力才將這些村民救到這裡來。
        mpcallout 4 say 這裡是極地的中心點
        mpcallout 5 say 在這邊，我們非常的安全
        mpcallout 6 say 很久以前我們就是躲在這邊生存的
        mpcallout 7 say 直到湯瑪士擊敗了熊王我們才可以在外面生存一直到今日
        mpcallout 8 say 可是居然有人讓這個暴君回到這裡來
        mpcallout 9 say 我想這次雪后也不會幫我們了，畢竟她還有她頭痛的事情
        mpcallout 10 say 廢話不多說了，英雄們！！
        mpcallout 11 say 你們願意幫我們再次擊敗熊王嗎(Yes/no)？
        mpcallout 11 mpdel_qmark self talking
        mpcallout 11 mpmod_qmark $n southend_kent_tion v0 = 16
     endif
 else
     tell $n 插嘴的人該受到應有的處罰
     mpforcer here add_affect $n 'mute' 1050 5 int -25 8388608
 endif
~
>talk_prog no~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_kent_tion 100016
        mpadd_qmark self talking 3 0 0 0 0 1
        say 好吧！人各有志，我就不勉強你了。
        mpcallout 1 say 不過，衷心給你個建議。
        mpcallout 2 echoat $n $I給你個打從心裡發寒的笑容
        mpcallout 2 say 過馬路的時候，請注意有沒有奔馳中的馬
        mpcallout 3 mpgold $n 1000000
        mpcallout 3 mpexp $n 50000
        mpcallout 3 say 另外，這是給你當作之前辛勞的心意。
        mpcallout 3 mpdel_qmark self talking
        mpcallout 3 mpdel_qmark $n southend_kent_tion
        mpcallout 3 mpmod_qmark $n southend_quest v0 | 8
     endif
 else
     tell $n 插嘴的人該受到應有的處罰
     mpforcer here add_affect $n 'mute' 1050 5 int -25 8388608
 endif
~
>talk_prog yes~
 if is_qmark($i) != talking
     if is_qmark($n) == southend_kent_tion 100016
        mpadd_qmark self talking 3 0 0 0 1 0
        say 好啊！果然是英雄出少年
        mpcallout 1 mpecho 你心裡想著：這句話是這樣說的嗎？
        mpcallout 1 say 畜生之虎不餵犢
        mpcallout 2 say 廢話不多說，我們直接切入正題
        mpcallout 3 say 想要擊敗極地熊王首先要讓牠無法藉用冷冽之氣的力量
        mpcallout 4 say 熊王只要擁有冷冽之氣的力量，他就擁有了不死的力量
        mpcallout 5 say 而切斷冷冽之氣的方法的話，就必須使用大量的神聖法力來瓦解其連結
        mpcallout 6 say 可是我現在變成了幻影實在沒有這樣的力量
        mpcallout 7 say 希望你們可以找到神聖的賢者或主教在這座塔之外向著這座塔祈禱
        mpcallout 8 say 這樣就會將神聖之力傳給我，然後讓我有足夠的能力切斷熊王的冷冽之氣
        mpcallout 9 say 不過你們要注意，在祈禱的時候，主教或賢者一定要專心不能受到外界的打擾
        mpcallout 10 say 詳細的方法你們可以去問湯瑪士(Tomas)，他可是很有統領的才能的。
        mpcallout 10 mpdel_qmark self talking
        mpcallout 10 mpmod_qmark $n southend_kent_tion v0 = 17
     endif
 else
     tell $n 插嘴的人該受到應有的處罰
     mpforcer here add_affect $n 'mute' 1050 5 int -25 8388608
 endif
~
>talk_prog Tomas~
 if is_qmark($i) != talking
     tell $n 他就是每任的村長啊，也是我永恆的愛人
     blush $n
 else
     tell $n 插嘴的人該受到應有的處罰
     mpforcer here add_affect $n 'mute' 1050 5 int -25 8388608
 endif
~
>tick_prog 30~
 if pcnum($) <= 3
     if pcnum($) > 0
        mpgoto 1898
        mpecho $I消失在這一片白銀大地，回到肯特的身邊.
     endif
 endif
~
