>room_time 10~
 if rmobcount(1777) > 0
     echo 艾利多(Elido)無聊到開始整理房間
     modrvt v0 = 0
 endif
~
>room_mask yell 北七萬歲～～~
 echoat $n [1;33m你喊叫：「北七萬歲～～」[m
 echoaround $n [1;33m$N[1;33m喊叫：「北七萬歲～～」[m
 callout 1 echoat $n 就在你喊完的時候，房間裡面忽然被一片黑暗給籠罩著
 callout 2 echoat $n 黑暗散去之後，你發現你身在一個完全不同的地方
 callout 3 at 1891 echoaround $n $N忽然出現在這邊
 callout 3 at 1891 force $n look
 callout 3 transfer $n 1891
 callout 3 echoaround $n $N忽然不見了
~
>room_command search around~
 echoaround $n $N四處翻翻......
 echoat $n 你四處翻翻......
 if is_qmark($n) & southend_kent_lostobj 100008
     if roomvalue($0) !& 1
        callout 1 echoat $n 一堆衣服(clothes)堆在房子右邊
        callout 1 echoat $n .
     else
        callout 1 echoat $n 不過好像有人翻過的痕跡
        callout 1 echoat $n 一堆衣服(clothes)堆在房子右邊
        callout 1 echoat $n .
     endif
     if roomvalue($0) !& 2
        callout 1 echoat $n 一堆書本(books)堆在房子左邊
        callout 1 echoat $n .
     else
        callout 1 echoat $n 不過好像有人翻過的痕跡
        callout 1 echoat $n 一堆書本(books)堆在房子左邊
        callout 1 echoat $n .
     endif
     if roomvalue($0) !& 4
        callout 1 echoat $n 一個椅子(chair)躺在房子前面
        callout 1 echoat $n .
     else
        callout 1 echoat $n 不過好像有人翻過的痕跡
        callout 1 echoat $n 一個椅子(chair)躺在房子前面
        callout 1 echoat $n .
     endif
     if roomvalue($0) !& 8
        callout 1 echoat $n 一堆垃圾(junks)藏在房子後面
        callout 1 echoat $n .
     else
        callout 1 echoat $n 不過好像有人翻過的痕跡
        callout 1 echoat $n 一堆垃圾(junks)藏在房子後面
        callout 1 echoat $n .
     endif
 else
     if rmobcount(1777) > 0
        echoat $n 艾利多(Elido)嫌你太吵把你趕出去了
        echoaround $n 艾利多(Elido)嫌$N太吵把他趕出去了
        open east
        force $n east
     endif
 endif
~
>room_command search clothes~
 if roomvalue($0) & 16
     echoat $n 看來這邊甚麼都沒有.
     modrvt v0 | 1
     break
 endif
 if is_qmark($n) & southend_kent_lostobj 100008
     echoaround $n $N翻翻衣服......
     echoat $n 你翻翻衣服......
     if roomvalue($0) !& 1
        modrvt v0 | 1
        if roomvalue($0) !& 16
            if rand(25)
                callout 1 oload 1752 1 $n target
                callout 1 echoaround $n $N找到了一個小槌子
                callout 1 echoat $n 你找到了一個小槌子
                modrvt v0 | 16
