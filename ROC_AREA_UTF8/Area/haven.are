        break
 endif
 if being($b)
        if insameroom($b)
        else
                mpgoto $b
                mpecho $I飛來這了.
                mpechoat $n $I[1;33m告訴你「你答應要帶我去看美女的，別忘記了。」[m
        endif
 else
        if is_qmark($i) == to_see_sa
                mpdel_qmark self to_see_sa
        endif
        if is_qmark($i) == to_see_chrisana
                mpdel_qmark self to_see_chrisana
        endif
        if is_qmark($i) == to_see_wind
                mpdel_qmark self to_see_wind
        endif
        if is_qmark($i) == to_see_jacklyn
                mpdel_qmark self to_see_jacklyn
        endif
        if is_qmark($i) == to_see_alleina
                mpdel_qmark self to_see_alleina
        endif
        if is_qmark($i) >= staytime 100010
