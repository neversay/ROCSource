#1781
ice bear-king~
極地熊王(bear-king)~
曾經君臨南極的熊王(bear-king)在這凝視遠方.
~
  牠就是曾經君臨南極的極地熊王。經過多年的休養，如今牠已
經復活了。牠的熊掌就有一匹馬那麼的大，你在牠身上感覺到了
死亡的氣息，曾經你在蠻荒森林裡也有過如此的感覺。但從極地
熊王身上散發的氣魄卻是上古巨龍所不能比擬的。
~
1|32|64|2048 8|32|128 -500 S
55 80000 5000
70d100+-500 -35d-500+0
1500000 0
0 8 0
S 16 -9999
S 40 50
C 1|2|4|8
R Bear~
P 1|2|4|8|128|256|2048|32768|65536|131072|1048576|8388608
>repop_prog 100~
mpadd_qmark self reborn -1 0 0 0 1 0
~
>kill_prog 100~
if ispc($n)
	if class($n) == 7
	or class($n) == 8
		if isgood($n)
			mpmod_qmark self reborn v0 | 1
			mpecho [0;31m$I用著$N[m[0;31m聖潔的鮮血，染紅了雙手[m
		endif
	endif
	if class($n) == 14
	or class($n) == 19
		if isneutral($n)
			mpmod_qmark self reborn v0 | 2
			mpecho [0;31m$I用著$N[m[0;31m純淨的鮮血，染紅了雙腳[m
		endif
	endif
	if class($n) == 6
	or class($n) == 9
		if isevil($n)
			mpmod_qmark self reborn v0 | 4
			mpecho [0;31m$I用著$N[m[0;31m邪惡的血液，染紅了雙眼[m
		endif
	endif
endif
if is_qmark($i) == reborn 100007
	mpforcer here echotoall .
	mpforcer here echotoall [1;31m在鮮血的祭祀下[m
	mpforcer here echotoall .
	mpforcer here echotoall ...............[1;31m南極冰熊王完全復活了[m...............
	mpat 1896 mpoload 1817 floor
	mpmload 1790
	mppurge self
endif
~
>tick_prog 100~
if is_qmark($i) == reborn 100007
	mpforcer here echotoall .
	mpforcer here echotoall [1;31m在鮮血的祭祀下[m
	mpforcer here echotoall .
	mpforcer here echotoall ...............[1;31m南極冰熊王完全復活了[m...............
	mpat 1896 mpoload 1817 floor
	mpmload 1790
	mppurge self
else
	mpecho [1;36m冷冽的氣息讓$I元氣回復了一點點[m
	mpforcer here modhmv self 02.10 15 0
endif
~
