>obj_command callout default~
 if is_qmark($n) & southend_quest 300002
     if objval3($o) > 0
        echoat $n 你試著引發 冰火手環(Ice-Fire Bracer) 潛藏的力量.
        echoat $n 　
        echoat $n 一股火焰的力量強化了你的戰意.
        oset self value3 - 1
        oforcer here add_affect $n 'adrenaline control' 1000 3 19 10 134217728
     else
        echoat $n 你試著引發 冰火手環(Ice-Fire Bracer)潛藏的力量.
        echoat $n 　
        echoat $n 可是似乎 冰火手環(Ice-Fire Bracer) 的力量還未恢復.
     endif
 else
     echoat $n 你試著引發 冰火手環(Ice-Fire Bracer) 潛藏的力量.
     echoat $n 　
     echoat $n 可是你卻控制不住這股強大的力量，反而受傷了。
     modhmv $n 03.95 99 0
 endif
~
