>all_greet_prog 100~
 if is_qmark($n) == southend_kent_tion 100006
     mpadd_qmark self talking 3 0 0 0 0 1
     mpforce $n look
     mpechoat $n [1;30m一陣聲音傳到你的心裡面[m
     mpcallout 3 mpechoat $n [1;30m吾乃企鵝村之守衛者－泫(Tion)[m
     mpcallout 6 mpechoat $n [1;30m吾喚你來此處乃因[m
     mpcallout 9 mpechoat $n [1;30m最近企鵝村中有著極地熊王(Bear-King)的氣息[m
     mpcallout 12 mpechoat $n [1;30m似乎有人刻意要讓南極回到極地熊統領的年代[m
     mpcallout 15 mpechoat $n [1;30m南極雪后最近又被雜事煩身，無法抽身警告企鵝村眾[m
     mpcallout 18 mpechoat $n [1;30m吾希望你可以去找尋藏於企鵝村之極地熊王的身骨[m
     mpcallout 21 mpechoat $n [1;30m在其尚未完全復活之際，徹底消滅其之身骨[m
     mpcallout 24 mpechoat $n [1;30m如此才能防止極地熊王再一次回到南極大地上來[m
     mpcallout 27 mpechoat $n [1;30m願冰凍之力與你同在[m
     mpcallout 30 mpmod_qmark $n southend_kent_tion v0 = 7
     mpcallout 30 mpechoat $n [1;36m一陣藍光在你手上聚集起來[m
     mpcallout 30 mpechoaround $n [1;36m一陣藍光在$N手上聚集起來[m
     mpcallout 33 mpat $n mpforce $n look
     mpcallout 33 mptransfer $n 1857
     mpcallout 33 mpat 1857 mpechoaround $n 一陣炫光後，$N出現在你眼前
     mpcallout 33 mpechoat $n 轉眼間，你回到了企鵝村神殿
     mpcallout 34 mpdel_qmark self talking
     if mobcount(1780) > 0
     or mobcount(1781) > 0
     or mobcount(1790) > 0
     or mobcount(1793) > 0
     else
        mpcallout 35 mpat 1892 mpmload 1780
     endif
 endif
