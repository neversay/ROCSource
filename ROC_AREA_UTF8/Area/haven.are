        mpechoat $n $I[1;33m告訴你「聽說上次布布還跑到了極光之湖中央」[m
        mpechoat $n $I[1;33m告訴你「雖然說村莊是圍繞著湖建立的」[m
        mpechoat $n $I[1;33m告訴你「不過，平常的時候，大家都不敢去那邊」[m
     else
        if rand(50)
            mpechoat $n $I[1;33m告訴你「南夏好幽默喔」[m
            mpechoat $n $I[1;33m告訴你「每次都逗的人家好開心喔」[m
        else
            mpechoat $n $I[1;33m告訴你「布布老是窩在家裡吃冰淇淋」[m
            mpechoat $n $I[1;33m告訴你「他會不會出來陪我們玩呢？」[m
            mpechoat $n $I[1;33m告訴你「大家一起來聽南夏說笑話一定很有趣」[m
        endif
     endif
 else
     mpadd_qmark self talking 3 0 0 0 0 1
     mpechoat $n $I[1;33m告訴你「吃裡家老布布在窩是淋淇冰」[m
     mpechoat $n $I[1;33m告訴你「玩我來會會他不出陪們呢？」[m
     if is_qmark($n) & southend_quest 100001
        break
     endif
     if is_qmark($n) != southend_booboo_language
        mpadd_qmark $n southend_booboo_language -1 1 0 0 0 1
        mpcallout 1 mpechoat $n 冰淋？冰淇淋？？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
     else
        mpmod_qmark $n southend_booboo_language v0 | 1
     endif
     if is_qmark($n) == southend_booboo_language 100007
        mpcallout 1 mpechoat $n 難道這麼冷的天氣裡，還會有人想吃冰淇淋？？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
        break
     endif
     if is_qmark($n) == southend_booboo_language 100003
     or is_qmark($n) == southend_booboo_language 100005
        mpcallout 1 mpechoat $n 好像剛剛他也有提到冰淇淋？
        mpcallout 1 mpechoat $n 你心想：在說啥啊！？
        mpcallout 1 mpdel_qmark self talking
     endif
 endif
