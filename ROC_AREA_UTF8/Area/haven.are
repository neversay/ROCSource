        endif
 else
        if is_qmark($i) >= staytime 100010
                mpecho $I振翅飛走了.
                if rand(50)
                        mpteleport recall1
                        mpmod_qmark self staytime v0 = 0
                else
                        mpteleport recall2
                        mpmod_qmark self staytime v0 = 0
                endif
        endif
 endif
 if roomvalue($n1593v1) & 1
        mpecho $I化作繁星點點.
        mppurge self
 endif
~
>all_greet_prog 100~
 if isfollow($i)
        break
 endif
 if is_qmark($i) == talking
        break
 endif
 if isnpc($n)
        break
 endif
 if is_inv_obj($n) == 37083
        mpechoat $n $I聞到你身上薄荷草的味道，逗留在你身邊。
