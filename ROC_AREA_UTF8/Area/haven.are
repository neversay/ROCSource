>give_prog 23~
 mpjunk all
 if is_qmark($i) == talking
     tell $n 不理你捏
     break
 endif
 say 謝謝你的贊助
 if is_qmark($n) == southend_alc_research 100008
     mpmod_qmark $n southend_alc_research v1 + 1
     if is_qmark($n) == southend_alc_research 200100
        say 加油！！還有４００個
        break
     endif
     if is_qmark($n) == southend_alc_research 200200
        say 加油！！還有３００個
        break
     endif
     if is_qmark($n) == southend_alc_research 200300
        say 加油！！還有２００個
        break
     endif
     if is_qmark($n) == southend_alc_research 200400
        say 加油！！還有１００個
        break
     endif
     if is_qmark($n) >= southend_alc_research 200500
        mpadd_qmark self talking 5 0 0 0 1 0
        tell $n 終於，這下足夠了。
        mpcallout 1 tell $n 請等一下下，我馬上破除這道幻影
        mpcallout 2 mpecho $I 專注著唸著咒語
        mpcallout 3 mpecho 四周的氣溫開始快速下降
        mpcallout 4 mpecho 越來越冷......
        mpcallout 5 mpecho 越來越冷......
        mpcallout 6 mpecho 越來越冷......
        mpcallout 7 mpecho 越來越冷......
        mpcallout 8 mpecho 越來越冷......
        mpcallout 9 mpecho 越來越冷......
        mpcallout 10 mpecho 寒冷的氣息原來是從$I手中的手環傳來的
        mpcallout 11 mpecho 四周真的好冷好冷......
        mpcallout 12 mpecho 四周真的好冷好冷......
        mpcallout 13 mpecho 四周真的好冷好冷......
        mpcallout 14 mpecho 四周真的好冷好冷......
        mpcallout 15 mpecho 四周真的好冷好冷......
        mpcallout 16 mpecho 四周真的好冷好冷......
        mpcallout 17 mpecho 你轉頭看著$I......她正專心破除著幻影
        mpcallout 18 mpecho 隨著$I手中的魔力寶石的減少，溫度也越來越低
        mpcallout 19 mpecho 手環也漸漸不再透明了
        mpcallout 20 mpecho .............
        mpcallout 21 mpecho .............
        mpcallout 22 mpecho .............
        mpcallout 23 mpecho .............
        mpcallout 24 mpecho .............
        mpcallout 25 sweat
        mpcallout 26 say 終於好了
        mpcallout 27 tell $n 這個就是破除偽裝之後的冰靜手環
        mpcallout 28 tell $n 真的是非常謝謝你的幫忙才能達成我的心願。
        mpcallout 29 tell $n 為了報答你......
        mpcallout 30 tell $n 請告訴我你想要哪種狀態的手環
        mpcallout 31 tell $n 既然破了這道偽裝，那變化狀態對我來說不是難事
        mpcallout 32 mpechoat $n 靜(Silence),火(Fire),風(Wind),水(Water),雷(Lightning),地(Earth)
        mpcallout 32 mpdel_qmark self talking
        mpcallout 32 mpmod_qmark $n southend_alc_research v0 = 9
     endif
 endif
