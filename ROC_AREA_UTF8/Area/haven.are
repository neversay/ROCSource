>tick_prog 100~
mpmod_qmark self reborntime v0 - 1
if is_qmark($i) <= reborntime 100000
	mpdel_qmark self reborntime
endif
mpecho [1;36m冷冽的氣息讓$I元氣回復了一點點[m
mpforcer here modhmv self 02.10 15 0
if is_qmark($i) != reborntime
	mpat 1833 mpmload 1781
	mpforcer here echotoall ...............[1;35m企鵝村出現大危機！極地熊王復活了！[m...............
	mpecho ...............[1;35m企鵝村出現大危機！極地熊王復活了！[m...............
	mppurge self
endif
~
>hurt_prog 1000~
mpechoat $n [1;30m你的奮力擊打讓$I的骨架開始不穩[m
mpechoaround $n $N[1;30m的奮力擊打讓$I的骨架開始不穩[m
mpmod_qmark self hurt v0 + 1
if is_qmark(self) > hurt 100199
	mpecho .
	mpecho $I對天狂吼了一聲
	mpecho $I倒在地上化成一堆無法行動的骨頭
	mpecho .
	mpecho 看來你們是擊敗他了
	mpecho 趕快去和企鵝村長回報這件好消息
	mpmod_all_qmark $n southend_kent_tion v2 = 1
	mpoload 1813 floor
	mpforcer here modrvt v0 = 1
	mpforcer here modrvt v2 = 1
	mppurge self
	break
else
	if is_qmark(self) > hurt 100149
		mpecho $I開始站不穩了
		break
	else
		if is_qmark(self) > hurt 100099
			mpecho $I搖搖欲墜
		endif
	endif
endif
~
>hurt_prog 1007~
 mpechoat $n [1;30m你的萬鈞力搥讓$I的骨架開始不穩[m
 mpechoaround $n $N[1;30m的萬鈞力搥讓$I的骨架開始不穩[m
 mpmod_qmark self hurt v0 + 1
 if is_qmark(self) > hurt 100199
     mpecho .
     mpecho $I對天狂吼了一聲
     mpecho $I倒在地上化成一堆無法行動的骨頭
     mpecho .
     mpecho 看來你們是擊敗他了
     mpecho 趕快去和企鵝村長回報這件好消息
     mpmod_all_qmark $n southend_kent_tion v2 = 1
     mpoload 1813 floor
     mpforcer here modrvt v0 = 1
     mpforcer here modrvt v2 = 1
     mppurge self
     break
 else
        if is_qmark(self) > hurt 100149
            mpecho $I開始站不穩了
            break
        else
            if is_qmark(self) > hurt 100099
                mpecho $I搖搖欲墜
            endif
        endif
 endif
~
