>talk_prog topic~
 if is_qmark($i) == talking
     break
 endif
 if is_qmark($n) & southend_quest 100064
     say 上次真是麻煩你了，你永遠是雪堡的好朋友。
     break
 endif
 if is_qmark($n) == southend_snowqueen_worry 100002
     if is_equ_obj($n) == 1825
        mpadd_qmark self talking 3 0 0 0 1 0
        say 天啊！想不到你真的馴服牠了。
        mpcallout 1 tell $n 那這個麻煩就送給你吧！
        mpcallout 2 tell $n 另外這是額外感謝你的.
        mpcallout 2 mpoload 1808 $n 1 target
        mpcallout 2 mpdel_qmark self talking
        mpcallout 2 mpdel_qmark $n southend_snowqueen_worry
        mpcallout 2 mpmod_qmark $n southend_quest v0 | 64
        mpcallout 2 mpskillexp $n 5000
        break
     endif
 endif
 if is_qmark($n) == southend_snowqueen_worry 100003
     mpadd_qmark self talking 3 0 0 0 1 0
     say 牠跑走了啊，想不到牠的反應會這麼大。
     mpcallout 1 tell $n 不管如何，還是謝謝你！
     mpcallout 2 tell $n 另外這是額外感謝你的.
     mpcallout 2 mpoload 1808 $n 1 target
     mpcallout 2 mpdel_qmark self talking
     mpcallout 2 mpdel_qmark $n southend_snowqueen_worry
     mpcallout 2 mpmod_qmark $n southend_quest v0 | 64
     mpcallout 2 mpskillexp $n 5000
     mpcallout 2 mpexp $n 5000
     break
 endif
 if is_qmark($n) == southend_snowqueen_worry 100004
     mpadd_qmark self talking 3 0 0 0 1 0
     say 想不到你手上的寶物居然收服了牠。
     mpcallout 1 tell $n 那這個東西你就好好收藏吧！
     mpcallout 2 tell $n 另外這是額外感謝你的.
     mpcallout 2 mpoload 1808 $n 1 target
     mpcallout 2 mpdel_qmark self talking
     mpcallout 2 mpdel_qmark $n southend_snowqueen_worry
     mpcallout 2 mpmod_qmark $n southend_quest v0 | 64
     mpcallout 2 mpskillexp $n 5000
     mpcallout 2 mpexp $n 5000
     mpcallout 2 mpgold $n 1000000
     break
 endif
 say 對不起，請恕我無法招待你們.
 say 我正煩惱著.
~
>talk_prog worry~
 if is_qmark($i) == talking
     break
 endif
 if is_qmark($n) & southend_quest 100064
     break
 endif
 if is_qmark($n) != southend_snowqueen_worry
     mpadd_qmark self talking 3 0 0 0 1 0
     say 其實也沒什麼大不了的。
     mpcallout 1 say 我的那隻小狼犬實在是很煩人
     mpcallout 2 say 三天兩頭就給我鬧脾氣
     mpcallout 3 say 當初我是看牠流落在外，才一時好心收留牠
     mpcallout 4 say 可是如今牠越來越麻煩了。
     mpcallout 5 say 真希望有人可以幫我收服牠。
     mpcallout 6 look $n
     mpcallout 7 tell $n 你願意幫我的忙嗎？
     mpcallout 7 mpadd_qmark $n southend_snowqueen_worry -1 1 0 0 0 1
     mpcallout 7 mpdel_qmark self talking
 endif
~
>talk_prog yes~
 if is_qmark($i) == talking
     break
 endif
 if is_qmark($n) == southend_snowqueen_worry 100001
     mpadd_qmark self talking 3 0 0 0 1 0
     tell $n 太好了，真是太謝謝你了。
     mpcallout 1 tell $n 其實收服牠也不是件難事
     mpcallout 2 tell $n 只要你能夠騎在牠的頭上，也許牠就不會那麼的高傲了。
     mpcallout 3 tell $n 不然的話，你念著下面的咒語牠也會安靜的。
     mpcallout 4 tell $n 這咒語其實也不難，注意聽了
     mpcallout 5 tell $n 「AP-ZA-FAZSX」
     mpcallout 6 tell $n 而且一定要大聲的唸，不然牠感受不到。
     mpcallout 6 tell $n 不過你需要注意的就是，這咒語挺耗魔力和體力的，
     mpcallout 7 tell $n 還有一件要注意的事情，牠身上有著神秘的力量，是一種冰雪的力量
     mpcallout 8 tell $n 牠身上的魔力，似乎和某個東西有著密切的牽連
     mpcallout 9 tell $n 可是我就是想不起來，我在哪個地方看過牠身上的魔力
     mpcallout 10 ponder
     mpcallout 11 tell $n 去吧！孩子，願你成功，了卻我一個麻煩。
     mpcallout 11 mpdel_qmark self talking
     mpcallout 11 mpmod_qmark $n southend_snowqueen_worry v0 = 2
 endif
~
>talk_prog no~
 if is_qmark($i) == talking
     break
 endif
 if is_qmark($n) == southend_snowqueen_worry 100001
    tell $n 好吧！！那我不勉強你了
    mpmod_qmark $n southend_quest v0 | 64
    mpdel_qmark $n southend_snowqueen_worry
 endif
~
