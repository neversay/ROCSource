>room_time 10~
 echo 強烈的暴風雪把一切都給埋沒了
 purge all
~
>room_enter 127 100~
 echoat $n 這裡刮著強烈的暴風雪
 echoat $n 這麼強烈的暴風雪會把一切都埋沒的
 if is_qmark($n) !& southend_kent_lostobj 100004
     if is_qmark($n) > southend_kent_lostobj 200012
        echoat $n 真的找不到方法下水，回去找村長幫忙吧！
        mod_qmark $n southend_kent_lostobj v0 | 4
        break
     endif
     if is_qmark($n) > southend_kent_lostobj 200008
        echoat $n 你實在找不到方法下水
        echoat $n 會不會是村長在晃點你
        mod_qmark $n southend_kent_lostobj v1 + 1
        break
     endif
     if is_qmark($n) > southend_kent_lostobj 200004
        echoat $n 一直找不到下水的方法
        echoat $n 你開始失去你的耐心了
        mod_qmark $n southend_kent_lostobj v1 + 1
        break
     endif
     if is_qmark($n) == southend_kent_lostobj 100003
        echoat $n 你四處尋找可以下水的地方
        echoaround $n $N四處尋找可以下水的地方
        mod_qmark $n southend_kent_lostobj v1 + 1
     endif
 endif
~
>room_command knock default~
 echoat $n 你想敲啥？？
~
>room_command knock ice~
 if race($n) == beholder
     echoaround $n $N試著用觸手往他腳下的冰塊捶去，看起來還挺有笑果的
     echoat $n 你試著用觸手往你腳下的冰塊捶去，不過看起來沒有效果
     callout 2 echoaround $n $N從眼睛發出一道亮眼的射線，朝著他腳下的冰塊射去
     callout 2 echoat $n 你從眼睛發出一道亮眼的射線，朝著你腳下的冰塊射去
     callout 3 echoaround $n 突然間，$N腳下的冰塊裂開了
     callout 3 echoat $n 你腳下的冰塊裂開了
     callout 4 echoaround $n $N就要掉到冰層裂縫中
     callout 4 echoat $n 你就要掉了下去
     callout 5 at 1866 force $n look
     callout 5 transfer $n 1866
     callout 5 echoaround $n 也許，你再也看不到$N了
     callout 5 echoaround $n 裂開的冰層很快的又冰封起來了
     callout 5 echoaround $n 你試著去拉$N，可是你失敗了
     break
 endif
 if is_inv_obj($n) == 1752
     echoat $n 你沒裝上槌子要怎麼敲？？
     echoat $n 難不成你想要用你的頭去撞？
 else
     if is_equ_obj($n) == 1752
        echoaround $n $N帥氣地拿著小槌槌，大力的往他腳下的冰塊砸去
        echoat $n 你帥氣地拿著小槌槌，大力的往你腳下的冰塊砸去
        callout 2 echoaround $n $N又再一次的大力的往腳下的冰塊砸去
        callout 2 echoat $n 你又再一次的大力的往腳下的冰塊砸去
        callout 3 echoaround $n 突然間，$N腳下的冰塊裂開了
        callout 3 echoat $n 你腳下的冰塊裂開了
        callout 4 echoaround $n $N就要掉到冰層裂縫中
        callout 4 echoat $n 你就要掉了下去
        callout 5 at 1866 force $n look
        callout 5 transfer $n 1866
        callout 5 echoaround $n 也許，你再也看不到$N了
        callout 5 echoaround $n 裂開的冰層很快的又冰封起來了
        callout 5 echoaround $n 你試著去拉$N，可是你失敗了
     else
        echoat $n 你想用啥去敲冰塊？？
        echoat $n 難不成你想要用你的頭去撞？
     endif
 endif
~
