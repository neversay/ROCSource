>talk_prog topic~
 if is_qmark($i) != talking
     if is_qmark($n) & southend_quest 100002
        if is_qmark($n) == southend_kent_tion 100011
            mpadd_qmark self talking 5 0 0 0 1 0
            mpechoat $n 你仔細的和$I敘述著事情的經過......
            mpechoaround $n $N仔細的和$I敘述著事情的經過......
            mpcallout 1 mpechoat $n 你仔細的和$I敘述著事情的經過......
            mpcallout 1 mpechoaround $n $N仔細的和$I敘述著事情的經過......
            mpcallout 2 mpechoat $n 你仔細的和$I敘述著事情的經過......
            mpcallout 2 mpechoaround $n $N仔細的和$I敘述著事情的經過......
            mpcallout 3 say 我知道了！
            mpcallout 4 say 感謝$N您為這個企鵝村所做的一切
            if is_qmark($n) == southend_kent_tion 300001
                mpcall thxforhelp $n
                mpcallout 16 mpdel_qmark self talking
				mpcallout 16 mpskillexp $n 15000
                mpcallout 16 mpexp $n 30000
                mpcallout 16 mpdel_qmark $n southend_kent_tion
                mpcallout 16 mpmod_qmark $n southend_quest v0 | 8
            endif
            if is_qmark($n) == southend_kent_tion 300002
                mpcall thxforhelp $n
                mpcallout 16 mpdel_qmark self talking
                mpcallout 16 mpskillexp $n 10000
				mpcallout 16 mpexp $n 50000
                mpcallout 16 mpdel_qmark $n southend_kent_tion
                mpcallout 16 mpmod_qmark $n southend_quest v0 | 8
            endif
            if is_qmark($n) == southend_kent_tion 300004
                mpcallout 5 say 這是感謝你為我們所做的一切
                mpcallout 6 say 這樣東西擁有神奇的力量
                mpcallout 7 say 希望你能好好的保存
                mpcallout 8 mpecho $I從手上拿下一個手環
                mpcallout 9 mpskillexp $n 15000
				mpcallout 9 mpexp $n 50000
                mpcallout 9 mpoload 1816 $n 36 target
                mpcallout 9 mpechoaround $n $I將手環送給$N
                mpcallout 9 mpechoat $n $I將手環送給你
                mpcallout 9 mpdel_qmark self talking
                mpcallout 9 mpdel_qmark $n southend_kent_tion
                mpcallout 9 mpmod_qmark $n southend_quest v0 | 8
            endif
        endif
     else
        mpechoat $n 他聽不懂你說的話......
        mpechoat $n 你也聽不懂他說的話....
     endif
 else
     mpecho $I[1;33m大喊著：「企鵝奧義－冰凍之風」[m
     mpechoat $n 你感覺你正要張開的嘴，被冰封起來了。
     mpechoaround $n 你感覺有個不禮貌的傢伙嘴被冰起來了。
 endif
~
>defun_prog thxforhelp~
 mpcallout 5 say ！！！
 mpcallout 6 say 這種感覺是？！
 mpcallout 7 say 難道......
 mpcallout 8 ponder
 mpcallout 9 mpecho $I陷入了思考的泥沼中......
 mpcallout 10 mpecho $I陷入了思考的泥沼中......
 mpcallout 11 mpecho $I陷入了思考的泥沼中......
 mpcallout 12 say 看來極地熊王並沒有被完全的消滅
 mpcallout 13 say 不過他想再度完全復活危害整個南極，我想也是很難了
 mpcallout 14 say 這都是因為大家的努力啊
 mpcallout 15 tell $n 這點心意是為了感謝您為大家所做的一切
 mpcallout 16 mpoload 1816 $n 40 target
 mpcallout 16 mpechoaround $n $I將手環送給$N
 mpcallout 16 mpechoat $n $I將手環送給你
 mpcallout 16 mpecho $I從手上拿下一個手環
~
>tick_prog 50~
 if pcnum($) == 0
     mpecho $I漸漸的消失了......
     mpecho 村長肯特(chief kent)也回到他的辦公室了
     mpforce kent-southend mpgoto 1859
     mppurge self
 endif
~
