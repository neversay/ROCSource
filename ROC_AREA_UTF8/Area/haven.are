 else
     echo 忽然間，從門後面的秘室之中跑出一群的兄貴地精
     echoat $n 嘿咻嘿咻的把你推了出去
     echoaround $n 嘿咻嘿咻的把$N推了出去
     transfer $n 1809
 endif
~
