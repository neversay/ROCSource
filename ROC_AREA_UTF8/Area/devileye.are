>fight_prog 30~
mpechoat $n 你看到 $I 正朝著你眼前襲擊而來。
mpechoaround $n 你看 $I 正朝著 $N 襲擊過去。
skilldrv speedhit $n
skilldrv onehit $n
skilldrv onehit $n
if rand(30)
        if race($n) == vampire
                break
        endif
        if rand(70)
                mpechoat $n 被 $I 咬到的你中毒了！
                mpechoaround $n 不一會兒你便看到 $N 臉色發青，看來是中毒了。
                mpforcer here add_affect $n 'poison' 1120 10 5 -5 4096
                mpforcer here add_affect $n 'poison' 1120 10 1 -7 4096
        else
                mpechoat $n 被 $I 咬到的你，不一會兒便覺徥渾身都不舒服。
                mpechoaround $n 你看到 $N 全身都在顫抖著，感覺很像是生病了。
                mpforcer here add_affect $n 'disease' 1130 5 1 -5 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 2 -5 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 3 -5 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 4 -5 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 5 -5 1099511627776
        endif
endif
~
>fight_prog 100~
if is_qmark($i) == dragonbay_devil_eye 100022
or isaffected($i) & 1
        break
else
        if is_qmark($i) < dragonbay_devil_eye 100021
                mpmod_qmark self dragonbay_devil_eye v0 + 1
                if is_qmark($i) < dragonbay_devil_eye 100005
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼正逐漸地張開。[0m
                        break
                endif
                if is_qmark($i) <= dragonbay_devil_eye 100010
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經越張越開了。[0m
                        if is_qmark($i) == dragonbay_devil_eye 100010
                                mpecho [1;35m四周的溫度也跟著逐漸提升，你感到體力正不斷的流失。[0m
                                mpforcer here modhmv pc 23.10 10 0
                        endif
                break
                endif
                if is_qmark($i) <= dragonbay_devil_eye 100016
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經張開了一半。[0m
                        mpforcer here modhmv pc 23.10 10 0
                        if is_qmark($i) == dragonbay_devil_eye 100016
                                mpecho [1;32m四周的溫度也越來越高，而汗水也就越流越多了。[0m
                                mpforcer here modhmv pc 21.100 100 0
                        endif
                else
                mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經快要完全張開了。[0m
                        if is_qmark($i) == dragonbay_devil_eye 100020
                                mpecho [1;36m四周開始不斷的吹起陣陣的焚風，讓你飽受身心煎熬。[0m
                                mpforcer here modhmv pc 23.20 20 0
                                mpforcer here modhmv pc 21.100 100 0
                        else
                                mpforcer here modhmv pc 23.15 15 0
                                mpforcer here modhmv pc 21.50 50 0
                        endif
                endif
        else
                mpecho $I [1;31m背上的惡魔之眼已經完全張開了。[0m
                mpcall dragonbay_devil_eye_open $r
        endif
endif
~
