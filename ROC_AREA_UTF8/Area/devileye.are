看來這堆骸骨應該就是大長老的孫子的遺骸吧。
~
>obj_rand 100~
if hour($$) > 18
or hour($) < 6
        if mobcount(24209) == 0
                break
        else
                if inroom($o) > 24200
                if inroom($o) < 24271
                        if objval1($o) > 2
                                echoat $n 你身上的骸骨突然又騷動了起來並且掉落在地上，瞬間便凝聚成一個完整的軀體形狀。
                                echoaround $n 你看到 $N 身上的骸骨突然掉落在地，瞬間凝聚成一個完整的軀體形狀。
                                oforcer here echo 更可怕的是，它竟然像有生命似地站了起來！
                                oforcer here mload 24213
                                purge self
                        else
                                echoat $n 你身上的骸骨在瞬間產生了些許騷動。
                                echoaround $n 你看到 $N 身上的骸骨在瞬間產生了些許騷動。
                                oset self value1 + 1
                        endif
                endif
                endif
        endif
endif
~
>obj_tick 100~
if hour($$) > 18
or hour($) < 6
        if mobcount(24209) == 0
                break
        else
                if inroom($o) > 24200
                if inroom($o) < 24271
                        if objval1($o) > 2
                                oforcer here echo 那一堆骸骨突然又騷動了起來，瞬間便凝聚成一個完整的軀體形狀。
                                oforcer here echo 更可怕的是，它竟然像有生命似地站了起來！
                                oforcer here mload 24213
                                purge self
                        else
                                oforcer here echo 你看到地上的骸骨在瞬間似乎產生了些許騷動。
                                oset self value1 + 1
                        endif
                endif
                endif
        endif
endif
~
|
