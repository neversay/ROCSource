        if isaffected($r) !& 1
        if isaffected($r) !& 131072
                mpechoat $r [1;33m瞬間，你感到你的喉嚨發不出任何聲音。[0m
                mpechoat $r [1;33m而就在你還來不及慌張通知隊友時，你已失去了知覺。[0m
                mpechoaround $r [1;33m你看到[0m $R [1;33m原地倒頭大睡。[0m
                mptransfer $r
                mpforce $r sleep
                mpforcer here add_affect $r 'sleep' 1130 5 0 0 131072
                mpforcer here add_affect $r 'mute' 1130 5 1 -3 8388608
        endif
        endif
endif
~
