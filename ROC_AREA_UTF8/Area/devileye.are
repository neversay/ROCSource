echo [1;31m當整個叢林停止晃動時，你發現在你所處的位置似乎整個都往東移了似的。[0m
modrvt v0 r 7
modrvt v0 r 448
deldoor 0
setdoor 2 vnum 24266
modrvt v1 | 1
~
>room_defun dragonbay_exit_change2~
echo [1;31m在一瞬間，你明顯感受到周遭的地形產生了劇烈的晃動！但一下子又停止了。[0m
echo [1;31m當整個叢林停止晃動時，你發現在你東邊和西邊的叢林似乎整個都往南移了似的。[0m
modrvt v1 | 2
~
>room_defun dragonbay_exit_reset~
echo [1;32m周遭的地形再次產生一次劇烈的晃動！一切似乎又再度回復原樣。[0m
if roomvalue($1) & 1
        makedoor 0 魔眼叢林 無 0 0 24257
        setdoor 2 vnum 24265
        modrvt v1 r 1
        modrvt v0 r 448
endif
if roomvalue($1) & 2
        modrvt v1 r 2
endif
~
>room_defun dragonbay_north_linkroom~
~
>room_defun dragonbay_south_linkroom~
