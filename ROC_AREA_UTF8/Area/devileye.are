echo [1;32m周遭的地形再次產生一次劇烈的晃動！一切似乎又再度回復原樣。[0m
if roomvalue($1) & 1
        setdoor 0 vnum 24212
        setdoor 2 vnum 24220
        modrvt v1 r 1
        modrvt v0 r 7
        modrvt v0 r 448
endif
if roomvalue($1) & 2
        deldoor 1
        modrvt v1 r 2
        modrvt v0 r 56
endif
~
