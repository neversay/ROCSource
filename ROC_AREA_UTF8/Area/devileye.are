>fight_prog 50~
mpechoat $r [1;31m你看到[0m $I [1;31m的右前足掃向你身邊。[0m
mpechoaround $r [1;31m你看到[0m $I [1;31m的右前足掃向[0m$R[1;31m身邊。[0m
skilldrv monehit $r
skilldrv speedhit $r
skilldrv speedhit $r
mpechoat $n [1;31m而左前足則是對著你而來。[0m
mpechoaround $n [1;31m而左前足則是對著[0m $N [1;31m而去。[0m
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv speedhit $n
skilldrv speedhit $n
skilldrv multihit $n
skilldrv multihit $n
mpgoto self
~
>fight_prog 30~
frenzy
mpnowait
mpforcer here modhmv npc 04.10 10 0
mpforcer here modhmv npc 02.500 500 0
~
>death_prog 100~
if inroom($i) == 24270
        mpechotoall [1;35m【幻世謠傳】：「魔域第二層的[0m$I[1;35m終於被英勇的冒險者消滅了！！」[0m
        mpgreward merit $n +36 100
        mpadd_all_qmark $n merit_dungeon -1 0 0 0 0 1
        mpmod_all_qmark $n merit_dungeon v0 | 2
        mpecho [1;36m一陣濃煙之後，你看到[0m $I [1;36m死後幻化成一件護臂。[0m
        mpoload 24222 38 floor
        mpmod_all_qmark $n dragonbay_quest_list v0 | 16
        mpforcer here modrvt t0 = 1000
        mpforcer here makedoor 5 密道 密道 0 -1 14281
        mpforcer here setroom desc N 這裡原是魔眼蜘蛛皇后的巢穴，不過眼前所見，四處都有打鬥過的痕跡。
        mpforcer here setroom desc A 而且也不見什麼蜘蛛影子，看來魔眼蜘蛛皇后已經被冒險者們消滅了才是，只
        mpforcer here setroom desc A 可惜你慢了一步。在巢穴的下方，你看到一條密道繼續通往魔域下一層。
endif
if pcnum($) > 20
        mpgreward exp $n 30 10000
else
        if pcnum($) > 15
                mpgreward exp $n 30 11000
        else
                if pcnum($) > 10
                        mpgreward exp $n 30 12000
                else
                        if pcnum($) > 5
                                mpgreward exp $n 30 13000
                        else
                                mpgreward exp $n 30 15000
                        endif
                endif
        endif
endif
mppurge self
~
