if is_qmark($i) > roc_nian_shock 100009
        mpmod_qmark self roc_nian_shock v0 - 10
        mpecho $I 瘋狂地四竄，甩掉身上一切的火焰！
        mpecho 你受到四散的火焰波及而受傷！
        mpforcer here modhmv pc 01.700 1100 0
else
        if is_qmark($i) > roc_nian_shock 100004
                if rand(15)
                        mpmod_qmark self roc_nian_shock v0 - 4
			untan
			mpnowait
                        combat
			mpnowait
                        flee
                        flee
                endif
        endif
endif
~
