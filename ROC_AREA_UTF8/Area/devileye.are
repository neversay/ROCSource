9 2|4|16|64|128|512|2048|4096|134217728 1|256
0~ 0~ 100~ 0~
10 50000 0
C 100000
E
devil-eye sleeves~
這是魔眼蜘蛛皇后死後所化成的一件護臂。在護臂上頭，共有著八個凹槽，似
乎是可以插入某些東西似的。仔細觀看的話，那八個凹槽似乎形狀大小也都不
一樣。在黑暗之中，你更能清楚的看到那八個凹槽正散發出淡淡的紅光，感覺
相當的詭譎。也許你可以再仔細查看一下(check sleeves) 。
~
X devil-eye crystal~
A
40 2
A
44 10
P 1|1048576
>obj_command check default~
if objval3($o) == 0
        echoat $n 在魔眼邪臂上有著八個凹槽，看起來似乎可以插入(insert)某些東西似的。
else
        if objval3($o) & 1
                echoat $n 你看到在邪臂上頭鑲了一顆[1;31m魔眼晶石[0m(red)。
        endif
        if objval3($o) & 2
                echoat $n 你看到在邪臂上頭鑲了一顆[1;32m魔眼晶石[0m(green)。
        endif
        if objval3($o) & 4
                echoat $n 你看到在邪臂上頭鑲了一顆[1;33m魔眼晶石[0m(yellow)。
        endif
        if objval3($o) & 8
                echoat $n 你看到在邪臂上頭鑲了一顆[1;34m魔眼晶石[0m(blue)。
        endif
        if objval3($o) & 16
                echoat $n 你看到在邪臂上頭鑲了一顆[1;35m魔眼晶石[0m(purple)。
        endif
        if objval3($o) & 32
                echoat $n 你看到在邪臂上頭鑲了一顆[1;36m魔眼晶石[0m(azure)。
        endif
        if objval3($o) & 64
                echoat $n 你看到在邪臂上頭鑲了一顆[1;37m魔眼晶石[0m(white)。
        endif
        if objval3($o) & 128
                echoat $n 你看到在邪臂上頭鑲了一顆[1;30m魔眼晶石[0m(dark)。
        endif
        echoat $n 當然，你也可以把這些晶石再度取下來(draw sleeves XXXX)。
endif
~
>obj_command draw red~
if objval3($o) & 1
        echoat $n 你將[1;31m魔眼晶石[0m從魔眼邪臂中取了出來。
        echoaround $n 你看到 $N 從魔眼邪臂中取下了[1;31m魔眼晶石[0m。
        echo [1;31m你在瞬間感到周遭的魔氣又更加的濃厚了。[0m
        oset sleeves-devil-eye value3 r 1
        oforcer here oload 24213 36 $n target
else
        echoat $n 在你的魔眼邪臂中，並沒有塞入那麼一顆[1;31m魔眼晶石[0m啊！
endif
~
>obj_command draw green~
if objval3($o) & 2
        echoat $n 你將[1;32m魔眼晶石[0m從魔眼邪臂中取了出來。
