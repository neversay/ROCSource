~
~
0 0 24251
D2
~
~
0 0 24269
D3
~
~
0 0 24249
>room_command search default~
if roomvalue($n24269v0) & 8192
        echoat $n 下方的土地早已被撞開了。
else
        if roomvalue($n24269v0) & 4096
                echoat $n 你看到下方的土地似乎有些鬆動，也許可以試著撞看看。
        else
                echoat $n 在搜查之後，你發覺下方的土地有些鬆動，也許可以試著撞看看。
                makedoor 5 鬆動的土地 鬆動的土地 103 -1 24270
                at 24269 modrvt v0 | 4096
        endif
endif
~
