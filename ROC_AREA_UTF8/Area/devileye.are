        rcall dragonbay_rand_message $r
endif
~
>room_defun dragonbay_exit_change1~
echo [1;31m在一瞬間，你明顯感受到周遭的地形產生了劇烈的晃動！但一下子又停止了。[0m
echo [1;31m當整個叢林停止晃動時，你發現在你南邊的叢林似乎整個都往東移了似的。[0m
makedoor 2 魔眼叢林 無 0 0 24247
modrvt v1 | 1
~
>room_defun dragonbay_exit_change2~
echo [1;31m在一瞬間，你明顯感受到周遭的地形產生了劇烈的晃動！但一下子又停止了。[0m
echo [1;31m當整個叢林停止晃動時，你發現在你所處的位置似乎整個都往南移了似的。[0m
