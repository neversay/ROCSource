>obj_act wear~
if is_qmark($n) != devileye_timer
	if isaffected($n) / mental empower
        	oforcer here del_affect $n 'mental empower'
	endif
	oforcer here add_affect $n 'mental empower' 1130 2 40 4 0
	oforcer here add_affect $n 'mental empower' 1130 2 3 3 0
	oforcer here add_qmark $n devileye_timer 24 0 0 0 1 0
endif
echoat $n [1;36m你感到一股聖潔之氣瞬間流竄你全身肌膚。[0m
echoaround $n [1;36m你看到一股聖潔之氣籠罩著 $N [1;36m全身，感覺相當莊嚴神聖。[0m
~
