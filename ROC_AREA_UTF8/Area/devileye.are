endif
~
>fight_prog 30~
mpechoat $n 你看到 $I 正朝著你眼前襲擊而來。
mpechoaround $n 你看 $I 正朝著 $N 襲擊過去。
skilldrv multihit $n
skilldrv multihit $n
skilldrv multihit $n
if rand(40)
        if race($n) == vampire
                break
        endif
        if rand(70)
                mpechoat $n 被 $I 咬到的你中毒了！
                mpechoaround $n 不一會兒你便看到 $N 臉色發青，看來是中毒了。
                mpforcer here add_affect $n 'poison' 1120 10 5 -3 4096
                mpforcer here add_affect $n 'poison' 1120 10 1 -5 4096
        else
                mpechoat $n 被 $I 咬到的你，不一會兒便覺徥渾身都不舒服。
                mpechoaround $n 你看到 $N 全身都在顫抖著，感覺很像是生病了。
                mpforcer here add_affect $n 'disease' 1130 5 1 -3 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 2 -3 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 3 -3 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 4 -3 1099511627776
                mpforcer here add_affect $n 'disease' 1130 5 5 -3 1099511627776
        endif
endif
~
>fight_prog 100~
if is_qmark($i) == dragonbay_devil_eye 100017
or isaffected($i) & 1
        break
else
        if is_qmark($i) < dragonbay_devil_eye 100016
                mpmod_qmark self dragonbay_devil_eye v0 + 1
                if is_qmark($i) < dragonbay_devil_eye 100003
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼正逐漸地張開。[0m
                        break
                endif
                if is_qmark($i) <= dragonbay_devil_eye 100008
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經張開了一半。[0m
                        if is_qmark($i) == dragonbay_devil_eye 100008
                                mpecho [1;35m四周的邪氣也慢慢地聚集了起來。[0m
                        endif
                break
                endif
                if is_qmark($i) <= dragonbay_devil_eye 100012
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經張開了一半。[0m
                        if is_qmark($i) == dragonbay_devil_eye 100012
                                mpecho [1;32m周遭的氣息也讓你感覺越來越恐怖。[0m
                        endif
                else
                        mpecho [1;31m你看到[0m $I [1;31m背上的惡魔之眼已經快要完全張開了。[0m
                        if is_qmark($i) == dragonbay_devil_eye 100015
                                mpecho [1;36m你的內心也開始逐漸地焦慮了起來。[0m
                        endif
                endif
        else
                mpecho $I [1;31m背上的惡魔之眼已經完全張開了。[0m
                mpdef_rembch $r
                mpcall dragonbay_devil_eye_open
        endif
endif
~
>defun_prog dragonbay_devil_eye_open~
mpecho [1;37m四周的邪氣彷彿在瞬間炸開，強大的狂風吹得讓你眼睛張都張不開。[0m
mpcallout 1 mpcall dragonbay_devil_eye_open_message $b
~
>defun_prog dragonbay_devil_eye_open_message~
mpechoat $b [1;37m不一會兒風停了之後，在你正想張開雙眼時，卻看到一隻惡魔之眼就在你眼前。[0m
mpechoaround $b [1;37m在狂風停止之後，你張開眼睛之後卻看到[0m $I [1;37m正吊在 $B 的面前。[0m
mpcallout 1 mpcall dragonbay_devil_eye_open_end $b
~
