>defun_prog nian_control~
mpdel_qmark self roc_nian_skill
mpat 5 c 'double heal'
if rand(20)
        mpforce $n flee
        mpforce $n flee
        mpforce $n flee
        combat
        mpat $n mpforce $n sleep
        mpat $n mpforcer here add_affect $r 'sleep' 1130 3 0 0 131072
        break
endif
if rand(50)
        if rand(33)
                mpforce $n shout 年獸太可怕了！大家快逃啊！
                mpforcer here cast mute $n 60
        else
                mpforcer here cast fear $n 60
                mpforcer here cast disease $n 60
                mpforcer here cast poison $n 60
        endif
endif
~
>defun_prog nian_shock~
