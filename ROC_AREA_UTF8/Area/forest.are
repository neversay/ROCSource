~
這個土人村民穿著整齊，跟你腦中一般土人的印象不太一樣。
~
193 0 1000 S
28 300 0 0d0+0 0d0+0
-1 0
0 8 1
>defun_prog enemy_check~
if is_qmark($n) != forest_quest
	mpechoat $n $I 口中不知道喃喃唸著什麼東西！
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
else
	mpechoat $n $I [1;32m說著「為什麼濫殺我們族裏的人！」[m
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
endif
~
>greet_prog 100~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if isnpc($n)
or rand(80)
or is_qmark($n) == forest_barbarian_exam
or is_qmark($n) == forest_quest 100007
        break
endif
if class($n) == 14
or class($n) == 18
or class($n) == 19
        if is_qmark($n) != forest_quest
                break
        else
                mpechoat $n $I [1;32m說著「你到魔力之塔的二樓進行野蠻人試煉了嗎？」[m
        endif
endif
~
>talk_prog topic~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($n) != forest_quest
        mpechoat $n $I [1;32m說著「ASDF RE GSD  HDF AST AE RWTA ARTW Q SAD FGYYY。」[m
        mpechoat $n 你完全聽不懂他到底在說些什麼。
else
        if is_qmark($n) == forest_quest 100007
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「您好，我們蠻荒森林的英雄！」[m
                break
        endif
        if rand(20)
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「離這邊不遠的北邊，有個活火山，裡面有一隻巨大的上古火龍。」[m
                break
        endif
        if rand(25)
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「距離此處相當遠的東方大沼澤，據說有一隻巨大的蛇后。」[m
                break
        endif
        if rand(30)
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「如果你能夠殺死獅子族群的王，他身上的毛相當的有用處。」[m
                break
        endif
        if rand(30)
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「據說洞穴巨人的骨骼十分的堅硬，用來當護具相當不錯。」[m
                break
        endif
        if rand(35)
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「我們的首領身負許多野蠻人的進階技巧，你可以找他去學。」[m
        endif
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) != forest_enemy
        mpadd_qmark $n forest_enemy 50 0 0 0 1 1
else
        mpmod_qmark $n forest_enemy timer + 30
endif
~
