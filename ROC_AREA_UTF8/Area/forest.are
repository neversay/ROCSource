	mpechoat $n $I [1;32m說著「村中的食糧是大家共同享有的，在每次進行狩獵後都會分配給每個家庭，」[m
	mpechoat $n $I [1;32m說著「但分配的量會以每個家庭對狩獵的貢獻度作為參考，」[m
	mpechoat $n $I [1;32m說著「在食糧有限的環境下，採取這種方法才得以讓村落延續下去。」[m
	mpechoat $n $I [1;32m說著「這個家庭所分配到的食糧目前還夠生活，不過碰到缺糧的季節時，可能就會變得困難了。」[m
	mpechoat $n $I [1;32m說著「畢竟，他們家中唯一的男性生病倒下了，對村中貢獻也會變低許多....」[m
	mpcallout 2 mpdel_qmark self thorba_talking
	mpcallout 2 mpechoat $n 你或許可以追問看看是生什麼病。(sick)
	mpcallout 2 mpmod_qmark $n mist_clean_quest v0 = 2
endif
