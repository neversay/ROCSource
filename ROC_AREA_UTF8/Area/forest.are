#4351
試煉的開始~
這裡是戰王試煉的起點，你可以打開往北的門，開始你的試煉。
~
0 73740 0
D0
~
~
3 0 4356
>room_enter 4 100~
if class($n) == 18
        if is_qmark($n) == forest_barbarian_exam 100002
                echoat $n 你已經通過試練了！
                echoat $n 你忽然感覺到自己被傳送出來了。
                transfer $n 4337
        endif
        if is_qmark($n) <= forest_barbarian_exam 100001
                echoat $n 遠方傳來一陣聲響：試煉已經開始！！
                echoat $n 　
        else
                echoat $n 遠方傳來一陣聲響：請以正常方式進入戰王的試煉。
                echoat $n 你忽然感覺到自己被傳送出來了。
                transfer $n 4337
        endif
else
        echoat $n 這裡是戰王試煉的地方，其他職業請勿進入！！
        echoat $n 你忽然感覺到自己被傳送出來了。
        transfer $n 4337
endif
~
|
