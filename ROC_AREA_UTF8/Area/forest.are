>defun_prog enemy_check~
if is_qmark($n) != forest_quest
	mpechoat $n $I 口中不知道喃喃唸著什麼東西！
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
else
	mpechoat $n $I [1;32m說著「為什麼濫殺我們族裏的人！」[m
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
endif
~
>greet_prog 100~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($n) == forest_oimyra_finding 100001
        if is_inv_obj($n) == 4232
        or is_equ_obj($n) == 4232
                mpecho $I 似乎注意到 $n 身上的歐米拉頭蓋骨...
                faint $n
                cry $n
                mpecho $I 嘆氣地搖著頭。
                mpechoaround $n $I 對 $n 說了一些重要的話....。
                mpechoat $n $I [1;32m說著「去....魔力..塔，拿....它去..開門。」[m
                mpoload 4243 36
                give key $n
                mpmod_qmark $n forest_oimyra_finding v0 + 1
        endif
endif
~
>talk_prog topic~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($n) >= forest_quest 100007
	if rand(30)
		smile $n
		mpechoaround $n $n 正用熟練的土語與 $I 說話....。
		mpechoat $n $I [1;32m說著「如果需要魔力之塔野蠻人試煉的鑰匙(key)，」[m
		mpechoat $n $I [1;32m說著「就跟我說一聲就行了。」[m
		break
	else
		mpechoaround $n $n 正用熟練的土語與 $I 說話....。
		mpechoat $n $I [1;32m說著「您好，我們蠻荒森林的英雄！」[m
		break
	endif
endif
if is_qmark($n) == forest_oimyra_finding 100000
or is_qmark($n) >= forest_oimyra_finding 100003
        break
endif
if is_qmark($n) == forest_oimyra_finding 100002
        mpechoat $n $I [1;32m說著「快....去魔力..塔....去！」[m
        break
endif
if is_qmark($n) != forest_quest
        mpechoat $n $I 用很不熟練的人類語言跟你說話....。
        mpechoat $n $I [1;32m說著「你....人類....？嗎？」[m
        mpechoat $n $I [1;32m說著「史卡拉貝(skara brae)？從那裡來....去？」[m
        mpadd_qmark $n forest_oimyra_finding -1 0 0 0 0 1
        break
endif
if is_qmark($n) == forest_quest 100000
        mpechoaround $n $n 正用熟練的土語與 $I 說話....。
        mpechoat $n $I [1;32m說著「你好，我們的英雄！」[m
        mpechoat $n $I [1;32m說著「請你與我們的首領討論有關抵擋洞穴巨人入侵的事宜吧！」[m
        mpechoat $n $I [1;32m說著「他是個驍勇善戰的偉大野蠻人....。」[m
        mpmod_qmark $n forest_quest v0 + 1
else
        mpechoaround $n $n 正用熟練的土語與 $I 說話....。
        mpechoat $n $I [1;32m說著「你好，我們的英雄。」[m
endif
