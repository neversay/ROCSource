        if is_qmark($n) != forest_quest
                mpechoat $n $I [1;32m說著「GEWR AG AEWTABTS SDY ESVEUUs SEVY QW！」[m
                mpechoat $n 你完全聽不懂她到底在說些什麼。
                break
        endif
        if is_qmark($n) & forest_quest 302048
                if rand(50)
                        blush $n
                        mpechoat $n $I [1;32m說著「我現在跟霍克過的很好。」[m
                else
                        blush $n
                        mpechoat $n $I [1;32m說著「霍克現在不在，他出去打獵了。」[m
                endif
                break
        endif
        if is_qmark($n) < forest_quest 100004
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                sigh
                mpechoat $n $I [1;32m說著「歐米拉當初在我們村落中幫了我們很多忙。」[m
                mpechoat $n $I [1;32m說著「也教了我不少史卡拉貝城的有趣魔法。」[m
                mpechoat $n $I [1;32m說著「但是卻為了我們而....。」[m
                break
        endif
        if is_qmark($n) == forest_quest 100004
        or is_qmark($n) == forest_quest 100005
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                mpechoat $n $I [1;32m說著「趕緊去擊敗可惡的火龍賽巴洛司吧！」[m
                addoil $n
                break
        endif
        if is_qmark($n) > forest_quest 100005
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                clap $n
                mpechoat $n $I [1;32m說著「恭喜你消滅了火龍賽巴洛司，」[m
                mpechoat $n $I [1;32m說著「此後我們的部落就可以過著太平日子了。」[m
                bow $n
        endif
        break
endif
if is_qmark($i) == forest_fiesta 100000
        if is_qmark($n) != forest_quest
                mpechoat $n 她似乎心中在想著一些事情，根本不想理你。
                mpechoat $n 由於你也不懂得土人的語言，你也不知道從何幫起。
        else
                sm $n
                mpechoat $n $I [1;32m說著「希望你能夠在我們的豐年祭中玩得愉快....。」[m
                mpechoat $n 可以明顯看的出來 $I 好像心中有些事情在困擾著她。
                mpechoat $n 雖然你很想幫她，卻又不知道從何幫起。
                mpechoat $n 也許，參加土人的豐年祭，順便觀察 $I 便可得到線索。
                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                bow $n
        endif
