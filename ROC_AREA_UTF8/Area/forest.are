			smile $n
		else
			mpechoat $n $I [1;32m說著「祭師說哥哥再過一段時間就能跟著部落出去狩獵了。」[m
			mpechoat $n $I [1;32m說著「也終於能朝著成為村中第一勇士的夢想前進了。」[m
			mpechoat $n $I [1;32m說著「一切都要感謝你！」[m
		endif
	else
		mpechoat $n $I [1;32m說著「哥哥真是太可憐了....。」[m
		sad
	endif
else
	mpechoat $n $I [1;32m說著「AGD TFA AEG G TQ YP A」[m
	sad
	mpechoat $n 你雖然聽不懂，但能感受到她的心情很難過。
endif
