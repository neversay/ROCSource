if is_qmark($n) != forest_quest
        mpechoat $n $I [1;32m說著「ASGA E TA SSA ASYT AEST FDSTATAS G F SA TRE WAT AS！！」[m
        mpechoat $n 你完全聽不懂他到底在說些什麼。
else
        bow $n
        mpechoaround $n $n 正用熟練的土語與 $I 說話....。
        mpechoat $n $I [1;32m說著「歡迎你來到我們的村落，請多多和我們族人聊一聊。」[m
        mpechoat $n $I [1;32m說著「我立刻就為您打開門，您可以進入村莊了。」[m
        unlock w
        open w
endif
~
>tick_prog 100~
if is_qmark($i) == forest_enemy
        mpdel_qmark self forest_enemy
endif
if hour($) == 8
        mpgoto 4270
        mpecho 土人忽然跪下來往遠方的太陽拜了一拜....。
        unlock w
        open w
endif
if hour($) == 23
        mpgoto 4270
        mpecho 土人忽然跪下來往遠方的月亮拜了一拜。
        close w
        lock w
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) != forest_enemy
        mpadd_qmark $n forest_enemy 50 0 0 0 1 1
else
        mpmod_qmark $n forest_enemy timer + 30
endif
~
