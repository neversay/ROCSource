                mpecho [1;32m男的忽然對女的說了一些你聽不懂的話，似乎是叫女的先走。[m
                mpecho [1;32m然後他忽然就向你攻了過來....！[m
                mpmod_qmark self forest_fiesta v0 = 4
                mpmod_qmark alleina-forest forest_fiesta v0 = 4
                mpkill $n
        else
                mpecho 你忽然看到艾蓮娜(Alleina) 與另一名男子霍克(Hawk)在此約會。
                mpecho 霍克(Hawk)看到你的出現，顯得十分的緊張....。
                mpechoat $n $I 大叫：[1;34m艾蓮娜(Alleina)快走，我來擋住他們....！[m
                mpecho 接著 $I 就轉身向你攻擊過來！
                mpdef_rembch $n
                mpforce alleina-forest mpdef_rembch $n
                mpmod_qmark self forest_fiesta v0 = 5
                mpmod_qmark alleina-forest forest_fiesta v0 = 5
                mpkill $n
        endif
endif
