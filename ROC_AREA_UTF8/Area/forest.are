#4250
ako ako-fiesta~
雅克(Ako)~
土人首領-雅克(Ako)的雙眼中散發出深不可測的武士精神。
~
經年累月的戰鬥洗禮，讓土人首領眼睛看起來炯炯有神。你似乎在何處看到一樣
的有神眼神...，啊！不就是野蠻人工會的會長暴那(Boara)嘛！
~
11841603 8872 500 S
60 1000 0 40d20+-150 0d0+0
50000 0
0 8 1
C 1
P 229380|4194304
>greet_prog 100~
if is_qmark($i) == forest_fiesta 300001
        if rembch($n)
                mpechoat $n 你見到了$I，心想：該怎麼開始(start)跟他說呢？
                if is_qmark($i) <= forest_fiesta 200048
                        mpmod_qmark self forest_fiesta v1 = 49
                endif
        endif
endif
~
>talk_prog topic~
if is_qmark($i) == forest_fiesta
        if is_qmark($i) >= forest_fiesta 200025
                if is_qmark($i) <= forest_fiesta 200047
                        mpechoat $n $I 正在靜靜的祈禱，完全不想理你。
                        break
                endif
        endif
        if is_qmark($n) != forest_quest
                mpechoat $n $I [1;32m說著「AST Q ADHGDY GDYRER VHX DDY DSYTVESTV」[m
                mpechoat $n 你完全聽不懂他到底在說些什麼。
                mpechoat $n 不過你可以明顯感覺出來這裡豐年祭的熱鬧氣氛....。
        else
                if is_qmark($i) <= forest_fiesta 200012
                or is_qmark($i) >= forest_fiesta 200048
                        if rand(50)
                                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                mpechoat $n $I [1;32m說著「你好， $n ，要不要一起跳個舞....。」[m
                                mpechoat $n 接著 $I 拉著你的手，就跳起舞來了....。
                                mpechoaround $n $I 拉著 $n 的手跳起舞來了....。
                        else
                                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                mpechoat $n $I [1;32m說著「這不是 $n 吧！歡迎參加我們的豐年祭。」[m
                                mpechoat $n $I [1;32m說著「這是我們狩獵動物的肉，來，你吃吃看....。」[m
                                mpoload 4253
                                give leg $n
                                mpforce $n eat leg
                                gig
                                mpechoat $n $I [1;32m說著「如何？感覺不錯吧！」[m
                        endif
                        break
                endif
                if is_qmark($i) >= forest_fiesta 200013
                        if is_qmark($i) <= forest_fiesta 200024
                                if rand(50)
                                        mpechoat $n $I [1;32m說著「哇！吃的好飽，你自己玩吧！」[m
                                        gig
                                else
                                        mpechoat $n $I 醉的不省人事，你還是不要管他好了。
                                endif
                                break
                        endif
                endif
        endif
endif
~
>talk_prog start~
if is_qmark($i) == forest_fiesta 300001
        if rembch($n)
                if insameroom(hawka-forest)
                        if insameroom(alleina-forest)
                                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                mpechoaround $n [1;32m他們好像爭吵了起來....！[m
                                mpechoat $n $I [1;32m說著「 霍克你來做什麼？難道你去求 $n 幫忙？」[m
                                mpechoat $n $I [1;32m說著「你難道不瞭解你的經歷仍然不夠嗎？」[m
                                mpechoat $n $I [1;32m說著「竟敢去麻煩我們土人部落的恩人....！」[m
                                mpforce alleina-forest shake
                                mpechoat $n 艾蓮娜(Alleina) [1;32m說著「爸爸，你誤會了，是我找來的....。」[m
                                mpechoat $n [1;32m當他們吵的不可開交時你心想：是你自己該出面的時候了(stop)！[m
                        endif
                endif
        endif
endif
~
>talk_prog stop~
if is_qmark($i) == forest_fiesta 300001
        if rembch($n)
                if insameroom(hawka-forest)
                        if insameroom(alleina-forest)
                                mpechoaround $n $n 開始開口調停他們的紛爭....。
                                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                mpechoat $n [1;32m你向 $I 表明了自己願意協助霍克成長的意願。[m
                                gasp $n
                                mpechoat $n $I [1;32m說著「當一個訓練的老師是相當繁瑣累人的，」[m
                                mpechoat $n $I [1;32m說著「您真的願意訓練(train)這不成材的小子，幫助他成長？」[m
                        endif
                endif
        endif
endif
~
>talk_prog train~
if is_qmark($i) == forest_fiesta 300001
        if rembch($n)
                if insameroom(hawka-forest)
                        if insameroom(alleina-forest)
                                bow $n
                                mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                mpechoat $n $I [1;32m說著「實在太感謝您了，希望您能帶著小子出去見見世面。」[m
                                mpechoat $n $I [1;32m說著「霍克根本不知道外面世界的凶險。」[m
                                mpforce hawka-forest blush
                                mpechoat $n $I [1;32m說著「隨著霍克戰鬥經驗的提升，他會慢慢進步。」[m
                                mpechoat $n $I [1;32m說著「[1;36m當霍克真正的由戰鬥中瞭解野蠻人戰鬥技巧的精髓時，」[m
                                mpechoat $n $I [1;32m說著「[1;36m我就把女兒嫁給他。如果霍克準備(ready)好，就可以出發。」[m
                                mpforce alleina-forest follow self
                                mpforce alleina-forest group leave
                                mpmod_qmark self forest_fiesta v2 = 2
                                mpmod_qmark hawka-forest forest_fiesta v0 = 8
                        endif
                endif
        endif
endif
~
>talk_prog qualify~
if is_qmark($i) == forest_fiesta 300002
        if rembch($n)
                if is_qmark($n) & forest_quest 300064
                        if insameroom(alleina-forest)
                                if insameroom(hawka-forest)
                                        mpecho $I 的臉上露出十分欣喜的笑容....。
                                        mpechoaround $n $n 正用熟練的土語與 $I 說話....。
                                        mpechoat $n $I [1;32m說著「我們的恩人，沒想到還得麻煩你做這種雞毛蒜皮的事。」[m
                                        mpechoat $n $I [1;32m說著「我相信你訓練的成果，我同意他們的婚事了。」[m
                                        mpechoat $n 艾蓮娜(Alleina)與霍克(Hawk)兩個人緊緊的抱在一起。
                                        mpechoat $n $I [1;32m說著「[1;36m好了，你們兩個先離開吧！我有話(words)要跟 $n 說。」[m
                                        mpecho 霍克與艾蓮娜手牽著手到外面去逛了....。
                                        mppurge hawka-forest
                                        mppurge alleina-forest
                                endif
                        endif
                endif
        endif
endif
~
>talk_prog words~
if is_qmark($i) == forest_fiesta 300002
	if rembch($n)
		if is_qmark($n) & forest_quest 300064
			mpechoat $n $I 見霍克與艾蓮娜都離開了之後，忽然向你跪了下來。
				mpechoaround $n $I 見霍克與艾蓮娜都離開了之後，忽然向 $n 跪了下來。
				mpechoat $n 你連忙將 $I 給扶了起來....。
				mpechoround $n $n 連忙將 $I 給扶了起來。
				mpechoat $n $I [1;32m說著「謝謝，連我女兒的終生大事都要麻煩您，真是....。」[m
				mpechoat $n $I [1;32m說著「我都不知道怎麼感謝您了。」[m
				mpechoat $n [1;32m你心想：是否應該問問他們何時舉辦婚禮(marriage)呢？[m
			endif
		endif
	endif
endif
~
>talk_prog marriage~
if is_qmark($i) == forest_fiesta 300002
        if rembch($n)
                if is_qmark($n) & forest_fiesta 300064
                        hop
                        mpechoat $n $I [1;32m說著「您能夠來參加當然是最好不過的了。」[m
                        mpechoat $n $I [1;32m說著「如果小女與霍克的婚禮舉行，我一定立刻去通知您。」[m
                        mpechoat $n $I [1;32m說著「不過您幫了我們土人部落這麼多的忙，我時在無以回報。」[m
                        mpechoat $n $I [1;32m說著「我這把隨身的[1;36m魔法鋼刀(Magicla Steel Knife)[1;32m就送給您吧！」[m
                        mpmod_qmark self forest_fiesta v2 = 3
                        mpmod_qmark $n forest_quest v2 | 128
                        mpdef_rembch null-tar
                        mpoload 4215 36
                        give knife $n
                        wave $n
                endif
        endif
endif
~
