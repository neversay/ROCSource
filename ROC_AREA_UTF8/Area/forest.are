>give_prog 9233~
if is_qmark($n) == forest_enemy
	curse $n
	drop $o
	break
endif
if isfight($i)
	drop $o
	break
endif
if is_qmark($n) == mist_clean_quest 100019
	mpjunk $o
	mpmod_qmark $n mist_clean_quest v0 = 20
	mpechoaround $n $n 正用熟練的土語與 $I 說話....。
	mpechoat $n $I [1;32m說著「原來這就是歐米拉口中說的能治療百病的靈藥呀！」[m
	mpechoat $n $I [1;32m說著「那麼我會幫忙拿給生病的土人使用。」[m
	mpechoat $n $I [1;32m說著「感謝你完成了歐米拉生前的願望。」[m
	mpechoat $n $I [1;32m說著「這件部落儀式所使用的法器就作為謝禮送給你吧！」[m
	mpechoat $n $I給了你一條項鍊。
	if is_qmark($n) & mist_clean_quest 200128
		mpoload 4271 $n viclv target
	else
		mpoload 4270 $n viclv target
	endif
	mpcallout 1 mpresp $n 2
	mpcallout 1 mpskillexp $n 5000
	mpcallout 1 mpexp $n 20000
	mpcallout 1 bow $n
	mpcallout 1 mpechoat $n $I [1;32m說著「再會了，善良的外地人。」[m
else
	? $n
	drop $o
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mplog killed by $n
if is_qmark($n) != forest_enemy
        mpadd_qmark $n forest_enemy 100 0 0 0 1 1
else
        mpmod_qmark $n forest_enemy timer + 80
endif
~
