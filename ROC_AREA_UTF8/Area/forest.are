>talk_prog restart~
if is_qmark($n) == forest_enemy
        break
endif
if class($n) == 14
or class($n) == 18
or class($n) == 19
        if is_qmark($n) == forest_barbarian_exam 100000
        or is_qmark($n) == forest_barbarian_exam 100001
                mpechoat $n 遠方傳來一陣聲響：有關野蠻人試煉已經重新開始，請你加油。
                mpdel_qmark $n forest_barbarian_exam
                break
        if is_qmark($n) == forest_barbarian_exam 100002
                mpechoat $n 遠方傳來一陣聲響：你已經完成野蠻人試煉了。
        endif
endif
~
>tick_prog 100~
if is_qmark($i) == forest_enemy
        mpdel_qmark self forest_enemy
endif
if is_qmark($i) == forest_fiesta
        mpmod_qmark self forest_fiesta v1 + 1
        if inroom($i) != 4297
                mpecho $I 往土人聚集的大廣場走去....。
                mpgoto 4297
        endif
        if is_qmark($i) == forest_fiesta 200012
                mpmod_qmark self forest_fiesta v0 = 1
                mpmod_qmark alleina forest_fiesta v0 + 1
                break
        endif
        if is_qmark($i) == forest_fiesta 200024
                mpmod_qmark self forest_fiesta v0 = 2
                mpmod_qmark alleina forest_fiesta v0 + 1
                mpecho $I [1;32m忽然大喝一聲，接著在廣場中央跪了下來....。[m
                mpecho $I [1;32m不斷的向廣場中央的神像喃喃唸著聽不懂的話。[m
                break
        endif
        if is_qmark($i) >= forest_fiesta 200025
                if is_qmark($i) <= forest_fiesta 200047
                        if rand(30)
                                mpecho $I [1;32m不斷的向廣場中央神像說些你聽不懂的話。[m
                        else
                                if mobcount(4227) > 0
                                        mptransfer thorba-forest
                                        if rand(20)
                                                mpecho 索巴(Thorba) [1;32m在地上慢慢爬行接近神像，好像代表什麼特殊意義。[m
                                                break
                                        endif
                                        if rand(20)
                                                mpecho 索巴(Thorba) [1;32m開始念一些咒語，好像是祈求平安的。[m
                                        endif
                                endif
                        endif
                        break
                endif
        endif
        if is_qmark($i) == forest_fiesta 200048
                mpecho $I [1;32m似乎不繼續向廣場中央神像參拜了。[m
                mpecho $I [1;32m起身結束祈禱儀式，豐年祭的熱鬧氣氛又再度開始了。[m
                break
        endif
        if is_qmark($i) >= forest_fiesta 200072
                mpdel_qmark self forest_fiesta
                rumor [1;32m據聞蠻荒森林土人豐年祭已經結束了。[m
                if mobcount(4227) > 0
                        mpat 4304 mptransfer thorba-forest
                        mpdel_qmark thorba-forest forest_fiesta
                endif
                mpgoto 4305
                if mobcount(4246) > 0
                        mptransfer alleina-forest
                        mpdel_qmark alleina-forest forest_fiesta
                endif
                if mobcount(4226) > 0
                        mptransfer ako-leader
                        if being($b)
                                mpforce ako-leader mpat $b mpdef_rembch $b
                        endif
                endif
                mppurge self
        endif
endif
