>talk_prog restart~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($n) < forest_quest 100004
        if is_qmark($n) >= forest_quest 100002
                mpmod_qmark $n forest_quest v0 = 0
                mpmod_qmark $n forest_quest v2 = 0
                mpechoat $n 遠方傳來一陣聲響：你的任務已經重新開始了！
        endif
endif
if is_qmark($n) != forest_oimyra_finding
        if is_qmark($n) != forest_quest
                mpechoat $n 遠方傳來一陣聲響：你從未接過此項任務！
        endif
        break
endif
if is_qmark($n) == forest_oimyra_finding
        mpechoat $n 遠方傳來一陣聲響：你的任務已經重新開始了！
        mpdel_qmark $n forest_oimyra_finding
endif
