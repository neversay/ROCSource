>room_rand 10~
if rand(50)
        echo 你聽到遠處傳來的清脆的鳥叫聲，不禁讓你心曠神怡。
else
        echo 你聽到不遠處竟然傳來老虎的吼聲，你開始感到有些擔心。
endif
~
