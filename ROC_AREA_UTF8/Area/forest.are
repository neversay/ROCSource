這裡是地道的盡頭，在你前面的是一扇小門。這個小門可以勉強讓你一個人
側身爬過去。不過你在此處感覺到一陣陣強大的魔法力量。這個魔法力量讓你覺
得....十分的不安。
~
0 8217 0
D0
~
~
3 0 4335
D2
~
~
0 0 4333
S
#4335
奇異的空間~
你感到天旋地轉，突然間你失去了你所有的方向感。唯一的出口只有在你的
北邊。
~
0 8217 0
D0
~
~
0 0 4336
S
#4336
蟲蟲之王的休息室~
這裡是蟲蟲之王Dqqqqqq的休息室。
他是世界所有昆蟲的主宰，當然包括你肚子裡頭的蛔蟲。
~
0 1028 0
S
#4337
魔力之塔~
這裡是當初歐米拉與土人祭師研究魔法技巧、野蠻人攻擊技能的地方，
也是許多歐米拉文件與著作的所在地。這裡有個樓梯可以往上通往魔力之塔
的第二層，但是似乎被鎖住了。
~
0 4|8|1024 0
D1
~
~
55 4243 4303
D4
~
~
55 4243 4345
>room_enter 2 100~
if is_qmark($n) == forest_oimyra_finding 100002
        if is_equ_obj($n) == 4232
        or is_inv_obj($n) == 4232
                if roomvalue($1) == 0
                        mod_qmark $n forest_oimyra_finding v0 + 1
                        echoat $n [1;32m一進到這個房間，歐米拉的頭骨忽然發出刺眼的光芒，然後飛到空中消失。[m
                        if is_equ_obj($n) == 4232
                                force $n remove cobbrax
                        endif
                        purge $n cobbrax
                        echoat $n [1;32m接著四周傳來人說話的聲音....，似乎跟頭骨內發出的聲音一樣。[m
                        echoat $n 奇怪的聲音[1;32m說著「你終於來了， $n ，我已經等你很久了。[m」
                        modrvt v0 = 1
                        modrvt v1 = 1
                endif
        endif
endif
~
>room_rand 35~
if pcnum($) == 1
        if roomvalue($0) == 1
                echo 奇怪的聲音[1;32m說著「我就是你一直在找的歐米拉(Oimyra)，史卡拉貝的史學家。」[m
                echo 奇怪的聲音[1;32m說著「數年前，我來到此處，找到了這個部落，與土人們生活在一起。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 2
                echo 歐米拉[1;32m說著「這裡的土人其實擁有相當高度的文化與戰鬥技巧。」[m
                echo 歐米拉[1;32m說著「可惜在語言上與我們不通。」[m
                echo 歐米拉[1;32m說著「因此我留在此處希望能學會他們的語言。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 3
                echo 歐米拉[1;32m說著「漸漸的我已經學會了他們的語言，也與他們生活的十分快樂。」[m
                echo 歐米拉[1;32m說著「但是....，傳說中的火龍再世，影響附近環境，」
                echo 歐米拉[1;32m說著「使得住在火山山腳下的洞穴巨人往此處遷徙。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 4
                echo 歐米拉[1;32m說著「為了抵抗可怕的洞穴巨人，我教他們使用金屬來製作護具與武器。」[m
                echo 歐米拉[1;32m說著「並且將史卡拉貝城的建築技術，教授給他們。」[m
                echo 歐米拉[1;32m說著「因此，他們才會在村落的外面蓋了一圈的防禦工事。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 5
                echo 歐米拉[1;32m說著「同時也與他們部落中智慧最高的祭師，共同研究彼此間的魔法。」[m
                echo 歐米拉[1;32m說著「後來發覺，土人們除了野蠻人系的戰鬥技巧，其他一概不通。」[m
                echo 歐米拉[1;32m說著「因此我教會了他們的祭師使用一些基礎的魔法。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 6
                echo 歐米拉[1;32m說著「但是我們這樣的實力，仍然不足以與洞穴巨人們抵抗。」[m
                echo 歐米拉[1;32m說著「因此我冒險進入洞穴巨人的巢穴中，」
                echo 歐米拉[1;32m說著「希望能夠獲得一些他們身體的弱點方面的資訊。」[m
                echo 歐米拉[1;32m說著「但是....，我失敗了。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 7
                echo 歐米拉[1;32m說著「我為什麼失敗與死亡的原因我沒辦法跟你說，因為我的時間不多了。」[m
                echo 歐米拉[1;32m說著「我需要你們的幫忙，前往火山的深處，」
                echo 歐米拉[1;32m說著「將造成洞穴巨人騷動遷徙的主因-上古火龍賽巴洛司給消滅。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 8
                echo 歐米拉[1;32m說著「首先你得先學會土人的語言，才能夠與他們溝通。」[m
                echo 歐米拉[1;32m說著「也才能夠知道有關火龍與洞穴巨人的一些資訊。」[m
                echo 歐米拉[1;32m說著「我剩餘的魔力可以將土人語言的知識灌輸給你。」[m
                echo 歐米拉[1;32m說著「但是，我的能力極限只能灌輸給一個人。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 9
                echo 歐米拉[1;32m說著「為了不讓整個魔力灌輸的過程失敗。」[m
                echo 歐米拉[1;32m說著「其他人不相關的人都不能夠待在這邊房間之內。」[m
                echo 歐米拉[1;32m說著「否則魔力灌輸的過程會變得十分的不順利。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 10
                echo 歐米拉[1;32m說著「有許多這邊的資訊，我沒有太多的時間告訴你們。」[m
                echo 歐米拉[1;32m說著「因此只好先讓你學會土人的語言，其他的你自己去問土人們吧！」[m
                echo 歐米拉[1;32m說著「現在請不相關的人員走出這個房間，整個過程要12小時。」[m
                modrvt v0 + 1
                break
        endif
        if roomvalue($0) == 11
                mload 4240
                echo [1;32m在眾人出去之後，歐米拉的魂魄忽然出現了。[m」
                echo 歐米拉[1;32m說著「如果你準備好，就跟我說可以開始了(ready)。」[m
                modrvt v0 + 1
                modrvt v1 = 0
        endif
endif
~
>room_rand 100~
if roomvalue($0) == 11
                if pcnum($) > 1
                        echo 歐米拉[1;32m說著「請不相關的人員出去吧！我的時間有限啊！」[m
                endif
        endif
        if roomvalue($0) == 12
                if pcnum($) > 1
                        if insameroom(oimyra ghost)
                                echo 忽然有人闖進了房間，歐米拉消失了。
                                purge oimyra
                        endif
                endif
        endif
~
>room_command gather literature~
if is_qmark($n) == mist_clean_quest 100010
	if is_qmark($n) !& mist_clean_quest 200008
		echoat $n 你在這裡發現了一疊署名歐米拉(Oimyra)的紙張。
		oload 4269 1 $n target
		mod_qmark $n mist_clean_quest v1 | 8
	else
		echoat $n 你已經找過這裡了。
	endif
else
	echoat $n 什麼？
endif
~
|
