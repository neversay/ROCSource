		mpecho [1;32m然後，歐米拉的魂魄(Oimyra ghost)忽然再度的出現....。[m
		mpadd_qmark oimyra forest_ceballos 50 0 2 0 1 0
	else
		mpecho [1;32m$I 大叫一聲，接著就倒在地上了....。[m
		mpecho [1;32m然後，歐米拉的魂魄(Oimyra ghost)忽然再度的出現....。[m
		mpadd_qmark oimyra forest_ceballos 50 0 3 0 1 0
	endif
else
	mpecho [1;31m$I 死前怪叫一聲，忽然吐出了許多火焰向你們飛過來。[m
	mpat 5 c 'full heal'
	mpnowait
	if rand(50)
		c 'fire breath'
		mpnowait
	else
		c 'fire breath' $r
		mpnowait
	endif
endif
