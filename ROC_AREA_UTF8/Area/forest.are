	mpcall enemy_check $n
endif
if is_qmark($i) == thorba_talking
	mpechoat $n $I 正在說話。
	break
endif
if is_qmark($n) == forest_quest
	mpechoaround $n $n 正用熟練的土語與 $I 說話....。
	mpechoat $n $I [1;32m說著「外地的英雄呀，我們所居住的地域就如你所見隨時伴隨著危險，」[m
	mpechoat $n $I [1;32m說著「並且土地貧瘠無法種植養活夠多人的食糧，只能靠著狩獵為生；」[m
	mpechoat $n $I [1;32m說著「因此村子需要大量的人力，用來抵禦兇猛野獸的侵擾及打獵。」[m
	mpechoat $n $I [1;32m說著「在性別上，男人的戰鬥力又比女人更強，而力量越強在村中的地位也會更高，」[m
	mpechoat $n $I [1;32m說著「所以村中往往以男人作為部落的領袖。」[m
	mpechoat $n $I [1;32m說著「像是雅克(Ako)，他就是以驚人的戰鬥能力成為村中首領的。」[m
	if is_qmark($n) == mist_clean_quest 100000
		mpcallout 1 mpechoat $n 你或許可以跟他談談生病土人家庭的情況。(family)
		mpcallout 1 mpmod_qmark $n mist_clean_quest v0 = 1
	endif
endif
~
