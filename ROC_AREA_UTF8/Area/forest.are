>talk_prog p sick~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($i) == thorba_talking
	mpechoat $n $I 正在說話。
	break
endif
if is_qmark($n) == mist_clean_quest 100002
	mpadd_qmark self thorba_talking -1 0 0 0 0 1
	mpechoaround $n $n 正用熟練的土語與 $I 說話....。
	mpechoat $n $I [1;32m說著「他得的病是蠻荒森林特有的一種風土病，」[m
	mpechoat $n $I [1;32m說著「數十年前首次出現在村中，隨之有半數的族人紛紛發病；」[m
	mpechoat $n $I [1;32m說著「發病的人會漸漸的喪失活力，並且變得虛弱，最終在數年內死亡。」[m
	mpechoat $n $I [1;32m說著「雖然當時我跟著前任祭師有想辦法治療這種疾病，但最後依然失敗了....」[m
	mpechoat $n $I [1;32m說著「造成半數的族人在數年內相繼離世了。」[m
	sigh
	mpcallout 2 glare
	mpcallout 2 mpechoat $n $I [1;32m說著「如果數十年前的大流行再次爆發，就將會是場惡夢呢。」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「當時還有歐米拉在村中，他似乎有想到些解決的方法(solve)，但現在他也不在了....」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「但沒想到兩三年前那個家庭的哥哥突然產生同樣的症狀，」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「本來以為這種病症已經完全滅絕.......」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「所幸這病症不會傳染給周邊的人，且數十年前發病的人也都早已不在世上了，」[m
	mpcallout 2 mpdel_qmark self thorba_talking
	mpcallout 2 mpmod_qmark $n mist_clean_quest v0 = 3
endif
