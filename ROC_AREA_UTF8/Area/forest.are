>tick_prog 100~
if is_qmark($i) == forest_enemy
	mpdel_qmark self forest_enemy
endif
if inroom($i) == 4200
or is_qmark($i) == forest_ako_wait
	break
endif
if month($) == 0
or month($) == 2
or month($) == 4
or month($) == 6
or month($) == 8
or month($) == 10
or month($) == 12
or month($) == 14
	if day($) == 16
		if hour($) == 6
			rumor [1;32m據聞兩個月一度的蠻荒森林土人豐年祭即將開始。[m
		endif
	endif
	if day($) == 18
		mpcall start_fiesta $i
		break
	endif
endif
if hour($) == 1
	mpgoto 4305
	mpecho $I 打了一個哈欠，然後倒頭便睡。
	sleep
endif
if hour($) == 6
	wak
	mpgoto 4305
	mpecho $I 起床伸了伸懶腰，似乎要去巡視了。
	open e
	e
	close w
	e
	e
endif
if hour($) == 13
	mpgoto 4296
	mpecho $I 點了點頭，然後往自己的住處走去。
	w
	w
	open w
	w
	close e
	rest
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self delayed_stun -1 99999 0 0 1 0
if insameroom(alleina-forest)
        mpgroup alleina-forest self 1 0
        protect alleina-forest
endif
~
>fight_prog 100~
wak
wear knife
disarm
mpnowait
if is_equ_obj($i) == 4263
else
        if is_inv_obj($i) == 4263
                wear shield
        endif
endif
skilldrv heavyhit $n
skilldrv heavyhit $n
skilldrv speedhit $n
skilldrv speedhit $n
if rand(50)
        bashhead
        mpnowait
        bashhead
        mpnowait
        bashhead
        mpnowait
else
        kick
        mpnowait
        kick
        mpnowait
        kick
        mpnowait
endif
if insameroom(alleina-forest)
        if isaffected($i) & 16777216
                mpdis_magic self 'seal magic'
                mpecho $I[1;31m身上的魔法封印忽然解除了....！[m
        endif
        if isaffected($i) & 1
                mpforce alleina-forest c 'cure blindness' ako-leader
        endif
        if isaffected($i) & 4096
                mpforce alleina-forest c 'cure poison' ako-leader
        endif
        if isaffected($i) !& 128
                mpforce alleina-forest c sanc ako-leader
                frenzy
                mpnowait
        endif
        if isaffected($i) & 268435456
                mpforce alleina-forest c vivi ako-leader
        endif
        if rand(50)
                mpforce alleina-forest c blindness $r
        else
                mpforce alleina-forest c curse $r
        endif
        if hitprcnt($i) < 70
                mpforce alleina-forest c 'double heal' ako-leader
        endif
        if hitprcnt($i) < 50
                mpforce alleina-forest c 2 'double heal' ako-leader
        endif
        if hitprcnt($i) < 30
                mpforce alleina-forest c 3 'double heal' ako-leader
        endif
else
        if mobcount(4246) > 0
                mptransfer alleina-forest
        endif
endif
if rand(30)
        frenzy
        mpnowait
endif
if rand(20)
        mpat 5 invoke
        frenzy
        mpnowait
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mpmod_all_qmark $n adv_book_1_east v0 | 1
mplog killed by $n
if is_qmark($n) != forest_enemy
        mpadd_qmark $n forest_enemy 100 0 0 0 1 1
else
        mpmod_qmark $n forest_enemy timer + 80
endif
~
