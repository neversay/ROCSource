mpadd_qmark thorba-forest forest_fiesta 100 0 0 0 1 0
mpadd_qmark alleina-forest forest_fiesta 100 0 0 0 1 0
mpforce ako-fiesta mpgroup ako-fiesta thorba 1 1
mpforce ako-fiesta mpgroup ako-fiesta alleina 1 1
mpmload 4243
mpadd_qmark native-a forest_fiesta 100 0 0 0 1 0
mpmload 4243
mpadd_qmark native-a forest_fiesta 100 0 0 0 1 0
mpmload 4243
mpadd_qmark native-a forest_fiesta 100 0 0 0 1 0
mpmload 4243
