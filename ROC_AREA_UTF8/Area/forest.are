>room_enter 32 100~
if is_qmark($n) != forest_quest
        echoat $n 你忽然被傳送回到此處，不知道發生什麼事情。
        transfer $n 4337
        break
endif
if class($n) == 14
or class($n) == 18
or class($n) == 19
        if is_qmark($n) == forest_barbarian_exam 100002
                echoat $n 遠方傳來一陣聲響：你已經通過了野蠻人的試煉了。
                echoat $n 忽然間，你感覺到你被傳送了出來。
                transfer $n 4337
        else
                echoat $n 遠方傳來一陣聲響：歡迎來到野蠻人試煉的塔。
                echoat $n 遠方傳來一陣聲響：這裡是歐米拉研究同時訓練野蠻人技巧的地方。
                echoat $n 遠方傳來一陣聲響：請多多利用他來增進自己野蠻人的戰鬥技巧。
                echoat $n 　
        endif
else
        echoat $n 遠方傳來一陣聲響：抱歉，你的職業不是野蠻人，因此請不要進入這邊。
        echoat $n 忽然間，你感覺到你被傳送了出來。
        transfer $n 4337
endif
~
|
