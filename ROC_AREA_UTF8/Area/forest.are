                mpdel_qmark self forest_ako_wait
                mpechoat $n 你看見 $I 將五項物品交給了索巴(Thorba)。
                mpechoat $n 接著 $I 對你一個微笑又走了出去。
                open n
                close n
                mpechoat $n 你心想：剛剛首領說的[1;31m火焰神珠(Flame Orb)[m，正好趁現在問一問索巴。
                mpgoto 4305
                break
        endif
endif
if isnpc($n)
or rand(40)
or is_qmark($n) == forest_barbarian_exam
or is_qmark($n) == forest_quest 100007
        break
endif
if class($n) == 14
or class($n) == 18
or class($n) == 19
        if is_qmark($n) != forest_quest
        else
                mpechoat $n $I [1;32m說著「你到魔力之塔的二樓進行野蠻人試煉了嗎？」[m
        endif
endif
