        endif
        break
endif
if is_qmark($i) == forest_fiesta 100002
        mpmload 4247
        mpforce hawka-forest mpoload 4213
        mpforce hawka-forest mpoload 4218
        mpforce hawka-forest mpoload 4223
        mpforce hawka-forest mpat 5 wear all
        mpadd_qmark hawka-forest forest_fiesta 80 3 0 0 1 0
