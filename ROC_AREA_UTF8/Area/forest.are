>greet_prog 100~
if name($n) == ddavid
                think
                mpechoat $n $I [1;32m說著「[1;32m雖然我不太好意思一直催你做事....。[m
                mpechoat $n $I [1;32m說著「[1;32m但是我不相信你沒有時間做，因為現在大學比我們那時候更輕鬆。[m
                mpechoat $n $I [1;32m說著「[1;32m所以....至少把那星幻夢大陸弄成可以逛吧！[m
                break
        endif
        if name($n) == pecker
                grin
                mpechoat $n $I [1;32m說著「[1;32m聽說我們的Homepage已經很久沒有動了喔！！[m
                mpechoat $n $I [1;32m說著「[1;32m已經發霉咯！ Pecker 大人....！[m
                laugh
                break
        endif
        if name($n) == zcecil
                ponder
                mpechoat $n $I [1;32m說著「[1;32m你的G-Force 256的狀況怎麼樣？[m
                mpechoat $n $I [1;32m說著「[1;32mWindows 2000有灌成功嗎？有的話跟我說怎麼成功的。[m
                bow $n
                break
        endif
        if name($n) == zeel
                sm
                mpechoat $n $I [1;32m說著「[1;32m你的楓樹葉子生了幾片啦？[m
                mpechoat $n $I [1;32m說著「[1;32m趕緊把葉子們快一點生出來吧！[m
                break
        endif
        if name($n) == amenda
                bow $n
                mpechoat $n $I [1;32m說著「[1;32mHi，我最欣賞的大神....。[m
                mpechoat $n $I [1;32m說著「[1;32m你的護士女朋友現在情況如何？[m
                grin $n
                break
        endif
        if name($n) == dqqqqqq
                ponder
                look $n
                mpechoat $n $I [1;32m說著「[1;32m怎麼我會看見我自己呢？[m
                think
                break
        endif
        if name($n) == match
                hello $n
                miss $n
                mpechoat $n $I [1;32m說著「[1;32mHi，我老弟的馬子....啊！不能這樣說，應該說我未來的弟妹！[m
                gig
                break
        endif
        if name($n) == pluto
                hello $n
                miss $n
                mpechoat $n $I [1;32m說著「[1;32mHi，我的老弟....！[m
                mpechoat $n $I [1;32m說著「[1;32m找時間再一起去撞個球如何？[m
                break
        endif
        if isimmort($n)
                bow $n
                break
        endif
        if isnpc($n)
                say [1;32mMob 請不要到我的房間來。[m
                mppurge $n
                mpecho [1;32mDqqqqqq 把 Mob 給傳送走了。[m
        else
                say [1;32mHi，我就是混沌幻世大魔神Pluto的老哥，蟲蟲之王Dqqqqqq。[m
                say [1;32m有什麼需要我幫忙的事嗎？[m
        endif
