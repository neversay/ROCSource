        if inroom($i) != 4304
                mpecho $I 轉身往自己的住處走去...
                mpgoto 4304
        endif
else
        if inroom($i) != 4297
                mpecho $I 轉身往土人聚會的大廣場走去...
                mpgoto 4297
        endif
endif
