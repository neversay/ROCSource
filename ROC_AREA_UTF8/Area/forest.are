	if isaffected($i) & 1
		c 'cure blindness'
		mpnowait
	endif
	if isaffected($i) & 4096
		c 'cure poison'
		mpnowait
	endif
	if isaffected($i) & 8388608
		mpdis_magic self mute
	endif
	if isaffected($i) !& 128
		if hitprcnt($i) < 30
