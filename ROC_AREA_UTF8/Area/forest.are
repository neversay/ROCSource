		mpecho [1;32m然後，歐米拉的魂魄(Oimyra ghost)忽然再度的出現....。[m
		mpadd_qmark oimyra forest_ceballos 50 0 1 0 1 0
	endif
	if is_inv_obj($n) == 4249
		mpecho [1;32m忽然 $n 身上的火焰神珠(Flame Orb)脫離 $n 飛到空中。[m
		mppurge $n flameorb
