>defun_prog enemy_check~
if is_qmark($n) != forest_quest
	mpechoat $n $I 口中不知道喃喃唸著什麼東西！
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
else
	mpechoat $n $I [1;32m說著「為什麼濫殺我們族裏的人！」[m
	mpechoaround $n $I 忽然提起武器往 $n 衝了過去！
	mpechoat $n $I 忽然提起武器往你衝了過來！
	mpat 5 invoke
	mpnowait
	hunt $n
	break
endif
