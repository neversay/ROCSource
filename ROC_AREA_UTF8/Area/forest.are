>talk_prog quest~
if is_qmark($n) == forest_enemy
	mpcall enemy_check $n
endif
if is_qmark($n) == forest_quest 100003
        mpechoaround $n $n 正用熟練的土語與 $I 說話....。
        mpechoat $n $I [1;32m說著「你已經完成我需要你做的所有任務....。」[m
        break
endif
if is_qmark($n) == forest_quest 100002
        mpechoat $n $I [1;32m說著「以下是我希望你能夠完成的任務：」
        mpechoat $n $I [1;32m說著「想要接哪一項任務，記得 talk ako <quest name>。」[m
        if is_qmark($n) !& forest_quest 300002
                mpechoat $n $I [1;32m說著「   ‧[1;36m取得沼澤蛇后的鱗片(Scale of Snake Queen)[m」
        endif
        if is_qmark($n) !& forest_quest 300004
                mpechoat $n $I [1;32m說著「   ‧[1;36m取得獅子之王的眼睛(Eyes of Lion King)[m」
        endif
        if is_qmark($n) !& forest_quest 300008
                mpechoat $n $I [1;32m說著「   ‧[1;36m取得洞穴巨人王的皮膚(Skin of Troll King)[m」
        endif
        if is_qmark($n) !& forest_quest 300016
                mpechoat $n $I [1;32m說著「   ‧[1;36m取得神木之頂的嫩芽(Burgeon of Old Tree)[m」
        endif
        if is_qmark($n) !& forest_quest 300032
                mpechoat $n $I [1;32m說著「   ‧[1;36m取得巨型火蠑螈的心臟(Heart of Fire Newt)[m」
        endif
        mpechoat $n $I [1;32m說著「以上那些東西，可以幫助祭師做出可以抵抗火龍高熱的物品。」[m
        mpechoat $n $I[1;32m說著「請你將上述物品交給我，以證明你有資格前往消滅火龍賽巴洛司。」[m
endif
