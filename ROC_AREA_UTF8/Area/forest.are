#4252
native-mother mother~
土人母親(native's mother)~
生病的土人母親(native's mother)站在這邊照顧自己的兒子。
~
她的表情十分的哀戚，畢竟天下父母心，沒有一對父母願意看著自己的
小孩苦。
~
1|2|64 8|32|64 500 S
42 1000 0 0d0+0 0d0+0
-1 0
0 8 2
P 1|2|4|8|128|32768|65536|8388608|67108864|536870912
>tick_prog 100~
if is_qmark($i) == forest_enemy
	mpdel_qmark self forest_enemy
endif
if insameroom(sick-native)
	if ispc($r)
		if is_qmark($r) == mist_clean_quest 100020
			if rand(15)
				mpechoat $r $I 悉心的照顧重病的土人(sick native)，希望他能夠早日康復。
			endif
		else
			if rand(15)
				if rand(50)
					if rand(30)
						mpechoat $r $I 趴在重病的土人(sick native)的身邊啜泣....。
					endif
				else
					if rand(30)
						mpechoat $r $I 悉心的照顧重病的土人(sick native)，希望他能夠早日康復。
					else
						mpechoat $r $I 偷偷的在牆角啜泣，令人看了十分的感傷。
					endif
				endif
			endif
		endif
	endif
endif
~
>talk_prog topic~
if is_qmark($n) == forest_quest
	mpechoaround $n $n 正用熟練的土語與 $I 說話....。
	if is_qmark($n) == mist_clean_quest 100020
		if rand(50)
			mpechoat $n $I [1;32m說著「善良的旅人，有空請來坐坐，讓我們好好招待你。」[m
			tea $n
		else
			mpechoat $n $I [1;32m說著「我兒子喝了你的藥後狀況已經逐漸轉好。」[m
			mpechoat $n $I [1;32m說著「祭師說身體再調理一段時間，就能恢復健康了。」[m
			mpechoat $n $I [1;32m說著「這一切都要感謝你的幫助！」[m
		endif
	else
		mpechoat $n $I [1;32m說著「誰能救救我這可憐的兒子呀！」[m
		sob
	endif
else
	mpechoat $n $I [1;32m說著「ST AgST！ FGATAS Yv Vgh！！」[m
	sob
	mpechoat $n 你雖然聽不懂，但能感受到她的心情很難過。
endif
~
>give_prog 9233~
if is_qmark($n) == forest_enemy
	drop $o
	mpechoat $n $I似乎不想接受你的贈予。
	break
endif
if isfight($i)
	mpechoat $n $I似乎不想接受你的贈予。
	drop $o
	break
endif
if is_qmark($n) == mist_clean_quest 100019
	mpjunk $o
	mpmod_qmark $n mist_clean_quest v0 = 20
	mpechoaround $n $n 正用熟練的土語與 $I 說話....。
	mpechoat $n $I [1;32m說著「用這藥就能能治療他的病了嗎？」[m
	mpechoat $n $I立刻讓重病的土人的土人喝下藥。
	mpcallout 1 mpechoat $n 重病的土人(sick native)蒼白的臉色逐漸轉為紅潤。
	mpcallout 2 mpechoat $n $I [1;32m說著「只能把這條祖傳的手鍊能給你當謝禮。」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「感謝你的幫忙，但我們沒什麼好答謝你的。」[m
	mpcallout 2 mpechoat $n $I [1;32m說著「他的情況真的變好了！再過一段時間應該就能康復了。」[m
	mpcallout 3 mpechoat $n $I給了你一條手鍊。
	if is_qmark($n) & mist_clean_quest 200064
		mpcallout 3 mpoload 4273 $n viclv target
	else
		mpcallout 3 mpoload 4272 $n viclv target
	endif
	mpcallout 4 mpresp $n 2
	mpcallout 4 mpskillexp $n 5000
	mpcallout 4 mpexp $n 20000
	mpcallout 4 bow $n
	mpcallout 4 mpechoat $n $I [1;32m說著「再會了，善良的旅人。」[m
else
	? $n
	drop $o
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 cast inf
if is_qmark($n) != forest_enemy
	mpadd_qmark $n forest_enemy 100 0 0 0 1 1
else
	mpmod_qmark $n forest_enemy timer + 80
endif
~
