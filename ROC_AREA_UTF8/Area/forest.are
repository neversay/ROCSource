>fight_prog 60~
if rand(20)
        c 3 fireball $r
        mpnowait
        c poi $r
        mpnowait
endif
if rand(25)
        c 3 flamestrik $r
        mpnowait
        c chill $r
        mpnowait
endif
if rand(30)
        c 3 'burning hand' $r
        mpnowait
        c blind $r
        mpnowait
endif
if rand(35)
        c 'double heal' $n
        mpnowait
        c weaken $n
        mpnowait
endif
if rand(40)
        mpecho $I 的眼睛忽然發出紅光....。
        mpat 5 invoke
        mpnowait
        frenzy
        mpnowait
        if rand(30)
                c 'full heal'
                mpnowait
        endif
endif
~
>hitprcnt_prog 60~
if inroom($i) == 4297
        mpat 5 c 'full heal'
        mpnowait
        mpecho [1;36m忽然雕像降下一道閃電到索巴上，雕像似乎將他身上的傷給治癒了。[m
endif
if rand(80)
        if isaffected($i) !& 128
                mpat 5 c sanctuary
                mpnowait
        endif
endif
if rand(80)
        if isaffected($i) & 1
                c 'cure blindness'
                mpnowait
        endif
endif
wear staff
disarm
mpnowait
