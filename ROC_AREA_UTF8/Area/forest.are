        mpecho 艾蓮娜(Alleina)與霍克(Hawk)正在竊竊私語....。
        mpecho 他們看起來似乎是一對情侶....。
        mpecho 你在旁邊偷窺別人的約會好像不太對....。
        break
endif
if is_qmark($i) == forest_fiesta 100004
        mpecho $I [1;32m趁著你與霍克戰鬥的時候，就離開了此處....。[m
        mpgoto 4200
