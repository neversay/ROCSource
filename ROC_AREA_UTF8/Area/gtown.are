>rand_prog 50~
if is_qmark($i) != gtown_death_kasshu_one
	if rand(30)
		say 神啊！我在這向你禱告
		say 希望死亡谷的那群魔物早日死光
		mpcallout 1 say 不對，它們本來就死了..
		break
	endif
	if rand(45)
		say ...zzZz..zZZ..zzzZZZz
		say ..Zzz..嗯？
		say 我又睡著啦？悶在這裡真的無聊到快瘋掉
		say 師匠為什麼叫我待在這呢...
		break
	endif
	if rand(100)
		mpecho 卡修抬頭看了看天空
		say 結界(enchantment)又變弱了..
		say 再不想辦法補強，死亡谷的軍隊會又攻過來的
	endif
endif
