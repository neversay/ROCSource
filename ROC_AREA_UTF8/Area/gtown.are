	break
endif
if is_qmark($i) == gtown_death_war_death 100017
	mpmod_qmark $i gtown_death_war_death v0 - 1
	yell 又有一批魔物闖入鬼鎮了！請盡快消滅他們！
	mpcall gtown_death_war_four $i
	break
endif
if is_qmark($i) > gtown_death_war_death 100012
	if is_qmark($i) < gtown_death_war_death 100017
		mpmod_qmark $i gtown_death_war_death v0 - 1
		break
	endif
endif
if is_qmark($i) == gtown_death_war_death 100012
	mpmod_qmark $i gtown_death_war_death v0 - 1
	yell 我又感到有邪惡的力量入侵鬼鎮了！快點消滅他們！
	yell 結界已經開始崩壞了！
	mpcall gtown_death_war_five $i
	break
endif
if is_qmark($i) > gtown_death_war_death 100007
	if is_qmark($i) < gtown_death_war_death 100012
		mpmod_qmark $i gtown_death_war_death v0 - 1
		break
	endif
endif
if is_qmark($i) == gtown_death_war_death 100007
	mpmod_qmark $i gtown_death_war_death v0 - 1
	yell 有股極度邪惡的力量進入鬼鎮了！快點消滅他們！
	yell 結界要撐不住了！
	mpcall gtown_death_war_six $i
	break
endif
if is_qmark($i) > gtown_death_war_death 100002
	if is_qmark($i) < gtown_death_war_death 100007
		mpmod_qmark $i gtown_death_war_death v0 - 1
		break
	endif
endif
if is_qmark($i) == gtown_death_war_death 100002
	mpat 37000 mpdel_qmark seal-gtown gwar_lv
	yell 該死！只剩這個辦法了嗎？
	mpforce kasshu-gtown yell 師匠！不！
	mpechotoall 一陣耀目的白光籠罩住整個鬼鎮，鎮長犧牲自己強行恢復了結界！
	rumor 由於一群無能的冒險者，鬼鎮喪失了重要的精神領袖！
	mpat 5 rumor 由於一群無能的冒險者，鬼鎮喪失了重要的精神領袖！
	mpadd_qmark kasshu-gtown gtown_death_end_fail -1 0 0 0 0 1
	mpforce kasshu-gtown mpcall gtown_death_end_kasshu_fail $i
	mptransfer kasshu-gtown 37061
	mppurge self
	break
endif
