>defun_prog gtown_death_end_end~
say 卡修你也回去神殿吧
mpforce kasshu-gtown say 是的！師匠
mppurge kasshu-gtown
mpat 37011 mpmload 37027
rumor $b守住鬼鎮的結界，成功地維護了迷霧之島的和平！
mpat 5 rumor $b守住鬼鎮的結界，成功地維護了迷霧之島的和平！
if is_qmark($b) == gtown_quest_list
	if is_qmark($b) & gtown_quest_list 100001
	else
		say 如果你有需要的話，可以到旅店找阿爾瓦(Alva)購買馬匹(horse)，相信對你會有幫助的
		mpmod_qmark $b gtown_quest_list v0 | 1
		mpresp $b 3
	endif
else
	mpadd_qmark $b gtown_quest_list -1 1 0 0 0 1
	say 如果你有需要的話，可以到旅店找阿爾瓦(Alva)購買馬匹(horse)，相信對你會有幫助的
	mpresp $b 3
endif
wave $b
mpmload 37028
mppurge self
