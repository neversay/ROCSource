if race($n) == vampire
	say 您好，尊貴的血族，小的是這裡的管家
	say 您有什麼需要都可以跟小的說，小的定會讓您滿意
	bow
	break
endif
if race($n) != vampire
	say 大膽賤民！竟敢踏足這神聖之地！
	say 用你的鮮血來禰補你的罪過吧！
	cast 2 whirlwind
	mpnowait
endif
~
