>entry_prog 100~
if inroom($i) == 37061
	if inroom($b) == 37061
		if insameroom(mayor-gtown)
			if is_qmark($i) == gtown_death_kasshu_one
				if is_qmark($i) != gtown_death_kasshu_two
					say 師匠！有冒險者要幫忙修復結界了！
					mpechoat $b 原本一直低頭不語的鎮長抬起頭來，銳利的目光讓你渾身不自在
					mpechoaround $b 原本一直低頭不語的鎮長抬起頭來，仔細打量著$b
					mpcallout 1 mpforce mayor-gtown say 你好，冒險者，我代表全鎮感謝你的勇氣，但是這個任務十分兇險
					mpcallout 2 mpforce mayor-gtown say 你真的願意為本鎮、不，為整個迷霧之島冒生命的危險嗎？(talk mayor yes/no)
				endif
			endif
		endif
	endif
endif
