>greet_prog 100~
if race($n) != vampire
	if ispc($n)
		if pcnum($) <= 1
			say 無禮的傢伙！這裡不是下賤種族該來的地方！
			cast 2 whirlwind
			mpnowait
		else
			mpkill $n
		endif
	endif
endif
if race($n) == vampire
	if is_qmark($n) != gtown_vampire_finish
		if insameroom(ruru-gtown)
		else
			say 您好，尊貴的血族，歡迎來到吸血鬼之館
			say 如果您是來拜見我們尊貴的王，請告訴我(talk steward visit)
			bow $n
		endif
	endif
	if is_qmark($n) == gtown_vampire_finish 100001
		say 您好，尊貴的血族，歡迎再度瀕臨吸血鬼之館
		say 王吩咐小的要好好照顧您，有什麼需要請盡量命令
		bow $n
	endif
	if is_qmark($n) == gtown_vampire_finish 100002
		say 叛逆！奉王之命將你就地正法！
		cast 2 whirlwind
		mpnowait
	endif
endif
~
