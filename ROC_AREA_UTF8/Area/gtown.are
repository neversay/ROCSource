>greet_prog 100~
if name($n) == kasshu-gtown
	if is_qmark(kasshu-gtown) == gtown_death_kasshu_one
		if is_qmark(kasshu-gtown) == gtown_death_kasshu_two 200000
			say 祭司大人，您駕臨此地真是讓我惶恐
			mpforce kasshu-gtown say 你用這種口氣說話很噁心欸...
			mpcallout 1 mpcall gtown_death_vicecaptain $n
		endif
	endif
endif
~
>defun_prog gtown_death_vicecaptain~
say 呵呵，開玩笑的，這些是來幫忙的冒險者吧
say 吸血鬼之館裡的惡魔們大都是魔法的高手，請各位多加戒備
say 希望卡修不會扯你們的後腿啊
gig
unlock north
open north
wave
~
>defun_prog gtown_gate_vicecaptain~
mpecho 你注意到副隊長在聽到聲音時畏縮了一下
say ...你如果要進去的話，跟我說一聲(talk vice enter)，我會放你進去...
~
>greet_prog 100~
if isnpc($n)
break
endif
if race($n) == vampire
	if insameroom(ruru-gtown)
	else
		if insameroom(kasshu-gtown)
		else
			if mobcount(37016) != 0
				angry $n
				say 無恥的吸血蟲，你又來找你的同類了嗎
				say 總有一天你們會全部化為飛灰的！
				mpecho 正當副隊長擋住去路，僵持不下時，一股低沉的聲音從館中傳出...
				mpecho [1;31m「小女孩，你只是負責監視我，沒必要連我的客人也擋在門外吧」[0m
				mpcallout 2 mpcall gtown_gate_vicecaptain $n
			else
				angry $n
				say 無恥的吸血蟲，你又來找你的同類了嗎
				say 總有一天你們會全部化為飛灰的！
				mpechoat $n 副隊長擋住去路，僵持不讓你過去...
				mpechoaround $n 副隊長擋住去路，僵持不讓$n過去...
			endif
		endif
	endif
endif
if race($n) != vampire
	tell $n 你好，我奉派在此鎮守吸血鬼之館
	tell $n 裡面危險萬分，若沒有鎮長的命令我不能放你進去，抱歉
endif
~
>talk_prog enter~
if race($n) == vampire
	if mobcount(37016) != 0
		say 知道了...
		mpoload 37095
		unlock north
		open north
		mpecho $I把你趕了進去...
		mpforce $n north
		close north
		lock north
		mpjunk key
	else
		say 你們的王已經死了，我還會讓你進去嗎？
		say 快滾，不然我要斬奸除惡了！
		break
	endif
endif
~
|
