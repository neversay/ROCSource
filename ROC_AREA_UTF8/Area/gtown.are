>room_command dig thing~
if is_qmark($n) == gtown_fantasy_flower 100005
mod_qmark $n gtown_fantasy_flower v0 + 1
oload 37081 1 $n target
echoat $n [1;36m你從岩縫中拔出了藍色的火燄！[0m
echoaround $n [1;36m$n從岩縫中拔出了藍色的火燄！[0m
else
