>bribe_prog 10000~
if is_qmark($n) & gtown_quest_list 100002
	if is_qmark($i) != gtown_hawker_bomb
mpoload 37085 $n 1 target
mpadd_qmark $i gtown_hawker_bomb 5 0 0 0 0 1
mpcallout 1 mpechoat $n $I給了你一顆黑色的圓球
mpcallout 1 mpechoaround $n $I給了$n一顆黑色的圓球
mpcallout 2 say 如果還有需要再來找我吧，好兄弟
mpcallout 3 wave $n
else
say 那東西剛好沒有了，你晚點再來看看吧
mpgold $n 10000
mpechoat $n $I把錢還給你
endif
endif
