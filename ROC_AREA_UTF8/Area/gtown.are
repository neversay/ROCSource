>talk_prog yes~
if inroom($i) == 37061
	if inroom($n) == 37061
		if insameroom(kasshu-gtown)
			if is_qmark(kasshu-gtown) == gtown_death_kasshu_one
				if is_qmark(kasshu-gtown) != gtown_death_kasshu_two
					if is_qmark($n) == gtown_death_player_one
						say 好的，那就拜託你了！
						say 要修復結界需要兩樣充滿冥界之力的物品，分別是鬼幽石(gs stone)和血晶(blood crystal)
						say 它們分別在恐龍墳場的深處和吸血鬼之館的吸血鬼王身上，請拿這兩樣東西給我
						say 卡修也跟你們去好了，希望他不會對你們造成防礙
						mpadd_qmark $n gtown_death_player_two -1 0 0 0 0 1
						mpadd_qmark kasshu-gtown gtown_death_kasshu_two -1 0 0 0 0 1
						mpdef_rembch $n
						wave
					endif
				endif
			endif
		endif
	endif
endif
~
>talk_prog no~
