>talk_prog restart~
if is_qmark($n) == gtown_death_player_one
	say 什麼？這種重要的事情$n你怎能隨便放棄
	say 師匠一定會很生氣的...
	mpdel_qmark $n gtown_death_player_one
	mpdel_qmark $n gtown_death_player_two
	mpdel_qmark $n gtown_death_player_three
	mpdel_qmark $n gtown_death_kasshu_time
	mpdel_qmark $i gtown_death_kasshu_one
	mpdel_qmark $i gtown_death_kasshu_two
	mpdel_qmark $i gtown_death_kasshu_three
	break
endif
