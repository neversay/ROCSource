if rand(40)
	c 5 powerball $n
	mpnowait
	break
endif
if rand(100)
	yell [1;31m燄＊＊＊＊嵐＊＊＊＊地＊＊＊＊獄[0m
	mpnowait
	wear all
	mpnowait
	mpdis_magic $n sanctuary
	flaming
	mpnowait
	storm
	mpnowait
endif
~
>fight_prog 50~
wear all
mpnowait
invoke
mpnowait
frenzy
mpnowait
~
>fight_prog 60~
c 2 'energy drain' $n
mpnowait
~
>fight_prog 60~
c 2 'energy drain' $r
mpnowait
~
>fight_prog 40~
c 'sun flash'
mpnowait
~
>hitprcnt_prog 50~
if rand(50)
	mpat 5 c 5 'double heal'
	mpnowait
	break
endif
if rand(100)
	say Evil is my strength！
	mpnowait
	c 3 lifesteal $n
	mpnowait
	c 3 lifesteal $r
	mpnowait
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
mpadd_qmark self gtown_death_war_death -1 6 0 0 0 1
mpoload 37071 37
mpoload 37115 37
mpoload 37107 39
wear all
~
>defun_prog gtown_death_mob_death~
mpecho 在新的結界的影響下，四翼墮天使振翅飛去，轉瞬間便不見蹤影...
mppurge self
~
>tick_prog 100~
if is_qmark($i) > gtown_death_war_death 100002
	mpmod_qmark self gtown_death_war_death v0 - 1
	break
endif
if is_qmark($i) == gtown_death_war_death 100002
	mpcallout 2 mpcall gtown_death_mob_death $i
endif
~
>death_prog 100~
if rand(50)
	mppurge anti-heaven
endif
mpmod_all_qmark $n adv_book_2_1 v1 | 2
if mobcount(37057) == 0
if mobcount(37058) == 0
if mobcount(37060) == 0
if mobcount(37061) == 0
if mobcount(37062) == 0
if mobcount(37063) == 0
if mobcount(37064) == 0
if mobcount(37065) == 0
if mobcount(37066) == 0
if mobcount(37067) == 0
if mobcount(37068) <= 1
	mpcall gt_war_ending $n
endif
endif
endif
endif
endif
endif
endif
endif
endif
endif
endif
~
