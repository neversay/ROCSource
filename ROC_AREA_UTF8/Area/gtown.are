>talk_prog wrong~
if level($n) > 36
	say 是這樣啦..最近結界不知道為何開始減弱了
	say 師匠想找人幫忙重新補強結界
	mpechoat $n 卡修仔細打量了你一下
	mpechoaround $n 卡修仔細打量了$n一下
	say 不知道你是否願意幫這個忙(talk kasshu help)
else
	say 是這樣啦..最近結界不知道為何開始減弱了
	say 師匠想找人幫忙重新補強結界
	say 但是一直找不到合適的人選
	shrug
endif
~
>talk_prog yes~
if level($n) > 36
	say 你知道啊，那我就不用再說一次了
	say 想必你也知道我們的結界正逐漸減弱中
	say 不知道你是否願意幫這個忙(talk kasshu help)
else
	say 你知道啊，那我就不用再說一次了
endif
~
>talk_prog help~
if level($n) > 36
	if is_qmark($n) != gtown_death_player_one
		say 你真的要幫忙？太好了
		say 那我們先去找師匠吧，他就是鬼鎮的鎮長
		say 他會告訴你怎麼修復結界的
		mpmload 37027
		mpforce kasshu-gtown mpgroup $n kasshu-gtown
		mpadd_qmark kasshu-gtown gtown_death_kasshu_one -1 0 0 0 0 1
		mpadd_qmark $n gtown_death_player_one -1 0 0 0 0 1
		mpforce kasshu-gtown mpdef_rembch $n
		mppurge self
	endif
endif
