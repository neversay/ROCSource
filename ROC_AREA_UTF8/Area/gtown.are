>talk_prog come~
if inroom($i) == 37061
	if inroom($b) == 37061
		if is_qmark($i) == gtown_death_kasshu_one
			if is_qmark($i) == gtown_death_kasshu_two
				if is_qmark($b) == gtown_death_player_one
					if is_qmark($b) == gtown_death_player_two
						if is_qmark($b) == gtown_death_player_three
							if is_qmark($i) == gtown_death_end_fail
								say 這是鎮長要我交給你的
