>tick_prog 100~
if is_qmark($i) == gtown_death_kasshu_time 100010
	tell $b 不管你了，我得回神殿去了
	mpgoto $b
	mpdel_qmark $b gtown_death_kasshu_time
	mpgoto 37011
	mpmload 37027
	mppurge self
endif
if is_qmark($i) == gtown_death_kasshu_time 200025
	tell $b 真是..半途而廢，我回神殿去了
	mpgoto $b
	mpdel_qmark $b gtown_death_kasshu_time
	mpgoto 37011
	mpmload 37027
	mppurge self
endif
~
>tick_prog 100~
if is_qmark($i) == gtown_death_kasshu_one
	if is_qmark($i) != gtown_death_kasshu_two
		if being($b)
		else
			mpgoto 37011
			mpmload 37027
			mppurge self
		endif
		if insameroom($b)
		else
			if is_qmark($i) == gtown_death_kasshu_time
				mpmod_qmark $i gtown_death_kasshu_time v0 + 1
				if rand(40)
					tell $b 你不是要幫忙修復結界嗎，跑那去啦？
				endif
			endif
			if is_qmark($i) != gtown_death_kasshu_time
				mpadd_qmark $i gtown_death_kasshu_time -1 1 1 1 0 1
				tell $b 你不是要幫忙修復結界嗎，跑那去啦？
			endif
		endif
	endif
	if is_qmark($i) == gtown_death_kasshu_two
		if is_qmark($n) != gtown_death_kasshu_three
			if being($b)
			else
				mpgoto 37011
				mpmload 37027
				mppurge self
			endif
			if insameroom($b)
			else
				if is_qmark($i) == gtown_death_kasshu_time
					mpmod_qmark $i gtown_death_kasshu_time v1 + 1
					if rand(50)
						tell $b 我們現在要去蒐集恢復結界要用的物品，你怎麼不見了？
					endif
				endif
				if is_qmark($i) != gtown_death_kasshu_time
					mpadd_qmark $i gtown_death_kasshu_time -1 1 1 0 0 1
					tell $b 我們現在要去蒐集恢復結界要用的物品，你怎麼不見了？
				endif
			endif
		endif
	endif
endif
~
