>talk_prog rose~
if isnpc($n)
	break
endif
if level($n) < 36
	say 我很喜歡這種花
	say 可惜它枯死了...
	sigh
	break
endif
if level($n) >= 36
	say 我很喜歡這種花
	say 可惜它枯死了...
	sigh
	mpcallout 1 mpechoat $n $I仔細打量了你一下
	mpcallout 2 say 您看來是一位成熟的冒險者，不知道可否幫我一個忙(help)
	mpcallout 3 say 我會感謝您的
endif
~
>talk_prog help~
if isnpc($n)
	break
endif
if level($n) < 36
	break
endif
if level($n) >= 36
	say 希望您能幫我弄到一朵玫瑰，或告訴我那裡可以找到這種花
	mpcallout 1 say 請問您願意幫忙嗎？(yes/no)
endif
~
>talk_prog yes~
if isnpc($n)
	break
endif
if level($n) < 36
	break
endif
if level($n) >= 36
	if isnpc($n)
		break
	endif
	if is_qmark($n) >= gtown_fantasy_flower 100001
	or is_qmark($n) & gtown_quest_list 100004
		say 謝謝您之前的幫忙，我不好意思再麻煩你了
		bow $n
	else
		mpadd_qmark $n gtown_fantasy_flower -1 0 0 0 0 1
		say 謝謝您，為這種小事麻煩您真是抱歉
		say 一切就拜託您了
		break
	endif
endif
~
>talk_prog no~
if isnpc($n)
	break
endif
if level($n) < 36
	break
endif
if level($n) >= 36
	say 這樣啊...麻煩您這種小事是我不好，真是失禮了
	sorry
	break
endif
~
