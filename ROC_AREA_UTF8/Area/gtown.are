>greet_prog 100~
if race($n) != vampire
	if ispc($n)
		say 你竟然到的了這裡...
		say 為了讚揚你的努力，特別讓你在這永遠的沉眠吧！
		cast sleep $n
		mpnowait
		cast curse $n
		mpnowait
	endif
endif
if race($n) == vampire
	if is_qmark($n) != gtown_vampire_finish
		if insameroom(ruru-gtown)
		else
			say 年輕的血族，歡迎來到吸血鬼之館
			say 這裡沒有其他低賤的種族，你可以在此放心的休息
			say 如果要離開這裡的話，跟我說一聲就行了(talk king leave)
		endif
	endif
	if is_qmark($n) == gtown_vampire_finish 100001
		say 歡迎！我親愛的朋友，是什麼事情讓你又來造訪我這老朽的吸血鬼呢？
		say 儘管在此休息吧，你可是族裡年輕一輩的佼佼者呢
		c 'full refresh' $n
		mpnowait
		smile $n
	endif
	if is_qmark($n) == gtown_vampire_finish 100002
		say 該死！你這背棄自身尊貴血統的傢伙還敢來找我？
		say 我今天就要除掉你這叛逆！
		brandish
		mpnowait
		feed $n
		mpnowait
		feed $n
		mpnowait
	endif
endif
~
>talk_prog topic~
if race($n) == vampire
	if is_qmark($n) != gtown_vampire_finish
		if is_qmark($n) != gtown_vampire_love
			say 年輕的血族啊，不知你是否願意和我這老吸血鬼聊聊..
			say 難得來到這裡，就聽聽我的一些經驗吧..(talk king chatting)
		else
			say 還沒帶她來嗎..我現在只能拜託你了
			say 請努力吧..
		endif
	endif
	if is_qmark($n) == gtown_vampire_finish 100001
		say 歡迎！我親愛的朋友，是什麼事情讓你又來造訪我這老朽的吸血鬼呢？
		say 儘管在此休息吧，你可是族裡年輕一輩的佼佼者呢
		smile $n
	endif
	if is_qmark($n) == gtown_vampire_finish 100002
		say 該死！你這背棄自身尊貴血統的傢伙還敢來找我？
		say 我今天就要除掉你這叛逆！
		brandish
		feed $n
		feed $n
	endif
else
	say 你是那裡來的賤民！竟敢踏足此地！
	say 化為塵土消逝吧！
	c 2 whirlwind
	mpnowait
endif
~
>talk_prog leave~
if race($n) == vampire
	say 有空歡迎再來拜訪啊
	mpechoat $n [1;36m你的周圍被一陣強烈的藍光圍繞，眼前的景象逐漸糢糊起來[0m
	mpechoaround $n [1;36m$n的周圍被一陣強烈的藍光圍繞，轉眼間便消失了[0m
	mpechoat $n [1;36m當你回過神來，已經回到吸血鬼之館的大門前了[0m
	mptransfer $n 37030
endif
~
>talk_prog chatting~
if race($n) == vampire
	say 我們吸血鬼對於陽光總是十分的厭惡，它的存在不但使我們力量減弱
	say 還會燒傷我們的肌膚..，稍有不慎便可能因此喪生
	say 因此，白天時我們若能待在地底是最好不過，不然血液便非常重要..
	mpecho 吸血鬼王沉默了一會，似乎還有話要說..(talk king continue)
	break
endif
~
>talk_prog continue~
if race($n) == vampire
	say 其他卑賤的種族..，他們唯一的用處便是作為我們的食糧
	say 藉由吸收他們的鮮血，我們得以恢復我們的活力，甚至青春..
	say 說到這個，你知道鎮上有一位年輕巫女吧..，她是那麼的美好..
	say 我想得到她..，但她不認同我們尊貴的一族，不知你是否能勸服她
	say 帶她到我這兒來..(talk king yes/no)
endif
~
>talk_prog yes~
if race($n) == vampire
	if is_qmark($n) == gtown_vampire_finish
		say 你已經解過這個任務囉
		break
	endif
	if is_qmark($n) != gtown_vampire_finish
		if is_qmark($n) != gtown_vampire_love
			if level($n) >= 36
				mpadd_qmark $n gtown_vampire_love -1 1 1 1 0 1
				say 太好了，一切就拜託你了..那位少女當作食糧太可惜了
				say 你跟她說，我們不會危害她，請她放心過來一趟就行了(talk ruru invite)
			else
				say 嗯，你還太小了，我不太放心拜託你去辦
				say 等你成長些再來吧
				pat $n
			endif
		endif
	endif
endif
~
>talk_prog no~
if race($n) == vampire
say 怎麼？不願幫助我這老人嗎？
say 你這小子真是驕傲啊，算了，等你回心轉意的話再來找我吧..
endif
~
>talk_prog obey~
if inroom($i) == 37091
	if inroom($n) == 37091
		if insameroom(ruru-gtown)
			if is_qmark($n) == gtown_vampire_love
				mpechoat $n 你最後還是決定臣服於吸血鬼王，一起享用露露這隻可愛的'羔羊'
				mpechoaround $n $n站到吸血鬼王身邊，決定臣服於自身的血統
				mpcallout 2 mpcall gtown_vampire_love_king_three $n
			endif
		endif
