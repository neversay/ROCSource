	say 或許該考慮請他加入鬼鎮護衛隊...
	pon
else
if is_qmark($n) & gtown_quest_list 100002
	say 你是說瑞德嗎，別看他那副弱不禁風的樣子
	say 他可是有辦法打倒霸王龍的"狠角色"喔
	gig
	say 或許該考慮請他加入鬼鎮護衛隊...
	pon
else
	say 瑞德？你說那個弱不禁風的小販？
	say 他啊，做商人是蠻不錯的，卻老是來煩我，說什麼想加入護衛隊
	say 憑他那個樣子，想保護誰啊，沒被恐龍吃掉就不錯了
	laugh
	break
endif
endif
