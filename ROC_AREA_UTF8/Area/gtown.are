>bribe_prog 200000~
if insameroom(ruru-gtown)
	if is_qmark(ruru-gtown) != gtown_vampire_love_ruru_three
		if is_qmark($n) == gtown_vampire_love
			say 客人你真有眼光，這老鷹可是從外地來的，得來不易呢
			mpecho 布魯把老鷹交給了露露，露露馬上便把牠放走了
			mpadd_qmark ruru-gtown gtown_vampire_love_ruru_three -1 0 0 0 0 1
			mpmod_qmark $n gtown_vampire_love v0 + 1
			mpechoat $n 你看著消失在雲端的老鷹，暗自為牠的未來禱告
			mpforce ruru-gtown say 謝謝..我們走吧
			break
		endif
	endif
endif
