>talk_prog topic~
if isnpc($n)
	break
endif
if is_qmark($n) & gtown_quest_list 100002
	say 哎呀，這不是我們的好兄弟$n嗎，怎麼？有什麼需要幫忙的嗎？
	say 如果需要我們祖傳的秘寶，給我一萬元就行了
	smile $n
	break
endif
if is_qmark($n) == gtown_hawker_blue 100002
	if is_qmark($n) == gtown_hawker_red 100002
		if is_qmark($n) == gtown_hawker_yellow 100002
			clap $n 
			mpdel_qmark $n gtown_hawker_blue
			mpdel_qmark $n gtown_hawker_red
			mpdel_qmark $n gtown_hawker_yellow
			if is_qmark($n) == gtown_quest_list
				mpmod_qmark $n gtown_quest_list v0 | 2
			else
				mpadd_qmark $n gtown_quest_list -1 2 0 0 0 1
			endif
			say 看樣子你已經幫我們兄弟解決了不少困難
			mpcallout 1 say 今天起你也是我們的好哥兒們了
			mpcallout 2 say 有什麼困難儘管說，我們會幫你的！
			mpcallout 3 say 對了，這是我們祖傳的秘寶
			mpcallout 4 say 就送給你當謝禮吧
			mpcallout 5 mpoload 37085 $n 36 target
			mpcallout 6 mpechoat $n $I給了你煙霧彈(smoke bomb)
			mpcallout 6 mpechoaround $n $I給了$n煙霧彈(smoke bomb)
			mpcallout 7 say 如果還需要的話再跟我說就行了！
			break
		endif
	endif
endif
if is_qmark($n) == gtown_hawker_blue 100002
	if is_qmark($n) == gtown_hawker_red 100002
		if is_qmark($n) != gtown_hawker_yellow 100002
			say 嗨！上次真是多虧你幫忙啦，不過我的兄弟好像也遇上麻煩了
			say 麻煩你去看看他們出了什麼狀況吧
			gig
			break
		endif
	endif
endif
if is_qmark($n) == gtown_hawker_blue 100002
	if is_qmark($n) != gtown_hawker_red 100002
		if is_qmark($n) == gtown_hawker_yellow 100002
			say 嗨！上次真是多虧你幫忙啦，不過我的兄弟好像也遇上麻煩了
			say 麻煩你去看看他們出了什麼狀況吧
			gig
			break
		endif
	endif
endif
if is_qmark($n) == gtown_hawker_blue 100002
	if is_qmark($n) != gtown_hawker_red 100002
		if is_qmark($n) != gtown_hawker_yellow 100002
			say 嗨！上次真是多虧你幫忙啦，不過我的兄弟好像也遇上麻煩了
			say 麻煩你去看看他們出了什麼狀況吧
			gig
			break
		endif
	endif
endif
if is_qmark($n) != gtown_hawker_blue 100002
	if is_qmark($n) == gtown_hawker_blue
		say 怎麼？棘龍巨骨盾(shield of Spinosaurus bone)還沒拿給戴里克(derrick)嗎？
		say 真糟糕，我的腳還在痛，現在一切都只能靠你了
		say 加油吧！
		break
	endif
endif
if is_qmark($n) != gtown_hawker_blue 100002
	if level($n) >= 36
		say 歡迎歡迎，我們這裡有各式各樣的草藥
		say 小本經營，不二價還請見諒
		mpcallout 1 mpechoat $n $I忽然盯著你不停地打量...
		mpcallout 2 mpechoat $n $I偷偷把你拉到一旁，似乎有話要說
		mpcallout 3 tell $n 這位冒險者，我在這看了那麼多人，就屬你最雄壯威武、氣勢凜人
		mpcallout 4 tell $n 不用說，你一定是這些人裡面最厲害的，所以..不知你是否可以幫我個忙？（yes/no）
		break
	endif
endif
if is_qmark($n) != gtown_hawker_blue 100002
	if level($n) < 36
		say 歡迎歡迎，我們這裡有各式各樣的草藥
		say 小本經營，不二價還請見諒
		smile $n
		break
	endif
endif
~
>talk_prog yes~
if isnpc($n)
	break
endif
if level($n) >= 36
if is_qmark($n) & gtown_quest_list 100002
else
	if is_qmark($n) != gtown_hawker_blue
		tell $n 是這樣子的，你也知道我們商人為了賺錢那裡都得去闖
		tell $n 自然練就了一身好武藝，一般的怪物根本不是我們的對手
		mpcallout 1 tell $n 而我又是其中的佼佼者，我還曾經一個人殺死棘龍！
		mpcallout 1 mpecho $I展示了一下身上貧弱的肌肉
		mpcallout 2 tell $n 沒想到戴里克(derrick)居然不相信！枉費他是我的老顧客
		mpcallout 3 tell $n 所以我就跟他打賭啦，我要拿一個棘龍巨骨盾(shield of Spinosaurus bone)給他
		mpcallout 3 mpadd_qmark $n gtown_hawker_blue -1 0 0 0 0 1
		mpcallout 4 tell $n 才能證明我的實力，不過不巧我的腳昨天扭到了，看樣子短時間是好不了了
		mpcallout 5 tell $n 所以麻煩你幫我拿一面棘龍巨骨盾給他吧，事成後少不了你的好處的
	endif
endif
endif
