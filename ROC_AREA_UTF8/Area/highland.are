R Hobbit~
>talk_prog restart~
mpdis_magic self blindness
if is_qmark($n)<for_rose 100005
               mpechoat $n 你的任務「玫瑰之書(for rose)」已經從頭開始。
               mpdel_qmark $n for_rose
endif
~
>greet_prog 60~
if ispc($n)
        if is_qmark($n)!=for_rose
              mpecho $I 深深的嘆口氣，眉頭皺著的走來走去。
        endif
endif
~
>talk_prog topic~
if is_qmark($n)!=for_rose
        mpecho $I 停下來看了你一眼。
        mpecho $I 興奮的說：「你可以幫我一個忙嗎？(yes/no)」
endif
~
>talk_prog yes~
if is_qmark($n)!=for_rose
        mpcall quest_start $n
        mpcallout 1 ponder
        mpcallout 2 mpcall quest_2 $n
endif
if is_qmark($n)==for_rose 100001
        mpecho $I 露出驚喜的表情。
        say 真的嗎？那就麻煩你把這封信拿給那花藝
        say 房的老闆，我把詳細的情況都寫在上面了。
        mpmod_qmark $n for_rose v0 + 1
        mpoload 11525 $n viclv target
        mpechoat $n $I給了你一封信。
        mpechoaround $n $I給了$N一封信。
endif
~
>defun_prog quest_start~
        say 就如你所見到的，我是玫瑰花的愛好者，不管
        say 是哪裡有了新的玫瑰花種子、或是特殊品種，
        say 我一定會想盡辦法給找尋到並且移植回來。
~
>defun_prog quest_2~
        say 可是，最近我得到了一個從未見過的玫瑰種子
        say ，可是卻一直種不活，聽說在遙遠另一個大陸
        say 的某個地方開著一家花藝房，我想那裡的老闆
        say 一定知道要怎麼做。可是我又不能離開這裡。
        say 你可以幫我跑一趟那花藝房嗎？(yes/no)
        mpadd_qmark $n for_rose -1 1 0 0 0 1
~
>give_prog 13648~
mpjunk letter
if is_qmark($n)==for_rose 100003
        mpecho $I 迅速的把信拆開閱讀。
        say 信上寫著種植這種子需要深土的土壤、南極冰洋
        say 的海水、以及用神木所製造的花盆才可以培養出
        say 來。而其中的土壤和海水我之前已經有蒐集到了
        say ，可是那花盆似乎被奈圖城堡的人給收藏在城堡
        say 內的某個房間。我們和奈圖城堡不和好久了，也
        say 不好意思去跟奈圖要。我想，就由你去幫我把這
        say 花盆拿回來給我好了。
        mpmod_qmark $n for_rose v0 = 4
endif
~
>give_prog 10666~
mpjunk wood
if is_qmark($n)==for_rose 100004
        mpecho $I 露出高興的表情。
        say 太好了，總算蒐集到所有需要的器材了。這樣一來，
        say 一定可以很順利的把玫瑰給種出來。為了感謝你的幫
        say 忙，這裡有一把我自己雕刻成的玫瑰權杖，就送給你
        say 當作謝禮吧。
        mpoload 11531 $n 1 target
        mpechoat $n $I給了你一把杖。
        mpechoaround $n $I給$N一把杖。
        mpexp $b 2000
        mpmod_qmark $n for_rose v0 = 5
endif
~
|
