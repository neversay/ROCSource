~
0 0 5
D1
~
~
0 0 11587
D3
~
~
0 0 11585
>room_enter 10 100~
if rand(30)
	if ispc($n)
		echo 轟隆！轟隆！轟轟轟...隆隆隆...！
		if rand(70)
			echoat $n 忽然，一塊山崖上的石頭向你滾了過來....幸好，你閃過去了。
			echoaround $n 忽然，一塊山崖上的石頭向$N滾了過去....但他驚險的閃過了。
		else
			echoat $n 忽然，一塊山崖上的石頭向你滾了過來....好痛！石頭重重砸在你身上。
			echoaround $n 忽然，一塊山崖上的石頭向$N滾了過去....石頭重重砸在他身上，看起來好痛。
			callout 2 modhmv $n 03.36 56 1
		endif
	endif
endif
~
>room_rand 20~
if rand(30)
	if ispc($r)
		echo 轟隆！轟隆！轟轟轟...隆隆隆...！
		if rand(70)
			echoat $r 忽然，一塊山崖上的石頭向你滾了過來....幸好，你閃過去了。
			echoaround $r 忽然，一塊山崖上的石頭向$R滾了過去....但他驚險的閃過了。
		else
			echoat $r 忽然，一塊山崖上的石頭向你滾了過來....好痛！石頭直接砸在你身上。
			echoaround $r 忽然，一塊山崖上的石頭向$R滾了過去....石頭直接砸在他身上，看起來好痛。
			callout 2 modhmv $r 03.36 56 1
		endif
	endif
endif
~
