        c 'cure blindness'
        mpnowait
endif
if isaffected($i) & 4096
        mpecho $I [1;33m從口袋中拿出解毒散來服下..。[m
        mpdis_magic self poison
endif
if isaffected($i) & 8388608
        mpdis_magic self mute
        say 禁言對我是沒用的。
endif
if isaffected($i) & 268435456
        mpecho [1;33m一道靈光閃現，$I的身體又可以行動自如..。[m
        mpdis_magic self paralyze
endif
