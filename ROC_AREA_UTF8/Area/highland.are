>talk_prog topic~
if is_qmark($n) == fight_naytil
        break
endif
if is_qmark($n)== naytil_quest 100008
        mpechoat $n $I轉過身來瞪著你。
        mpechoaround $n $I轉過身來瞪著$N。
        say 就是你！就是你把我招換出來擾亂奈圖城堡的惡魔
        say 給打死的。怪不得我還在想說惡魔的氣息怎麼消失
        say 了。你說！你和我們蠻人堡有什麼深仇大恨？
        mpechoat $n 你要跟她解釋清楚呢？(explain)
        mpechoat $n 還是為了正義而戰才是對的？(fight for justice)
        mpmod_qmark $n naytil_quest v0 = 9
else
        mpecho $I 驚訝的轉過來。
        say 你是什麼時候潛入這裡的，你難道不知道這裡
        say 是不准外人進來的嗎？你受死吧！
        mpmload 11515
        mpgroup self elemental 1 0
        mpmload 11515
        mpgroup self elemental 1 0
        c 2 fireball $n
endif
~
>talk_prog p fight for justice~
if is_qmark($n)== naytil_quest 100009
        say 可惡，竟然說我們是邪惡的，看來不給你一點教訓是不行的！
        mpmload 11515
        mpgroup self elemental 1 0
        mpmload 11515
        mpgroup self elemental 1 0
        mpadd_qmark $n fight_highland -1 1 0 0 0 1
        c fireball $n
endif
~
>talk_prog explain~
if is_qmark($n)==naytil_quest 100009
        mpechoat $n 你急急忙忙的開始跟$I 解釋原因。
        mpechoaround $n $n急急忙忙的開始跟$I 解釋原因。
        mpcallout 1 mpechoat $n $I 聽了你的原因之後開始沉思。
        mpcallout 1 mpechoaround $n $I 聽了$n的原因之後開始沉思。
        mpcallout 2 mpcall explain_1 $n
endif
~
>defun_prog explain_1~
        say 那既然當時的你，不知道事情輕重而犯
        say 下這個過錯，那我想或許你應該為你的
        say 過錯做些補償。你願意嗎？(yes/no)
~
>talk_prog yes~
if is_qmark($n)==naytil_quest 100009
        say 既然你有心想要為你的過錯做些補償，那麼，就麻煩你
        say 去奈圖城堡裡面打探一下消息吧。我想這次的惡魔必定
        say 會使的奈圖有些防備措施。而我也要快點去找博得(boldar)
        say 商量一下往後該怎麼做。
        mpadd_qmark $n fight_naytil -1 1 0 0 0 1
        mpmod_qmark $n naytil_quest v0 = 10
endif
~
>talk_prog no~
if is_qmark($n)==naytil_quest 100009
        say 什麼！犯了錯還不認錯補償，你實在太敷衍了！
        say 你把這地方當成什麼了！接招吧！
        mpmload 11515
        mpgroup self elemental 1 0
        mpmload 11515
        mpgroup self elemental 1 0
        mpdel_qmark $n fight_naytil
        mpadd_qmark $n fight_highland -1 1 0 0 0 1
        mpmod_qmark $n naytil_quest v0 = 10
        c fireball $n
endif
~
>talk_prog boldar~
        say 提起博得，就不得不提起當初。在許多年以前
        say 博得輔佐年輕的高地王統治高地，除掉了許多
        say 妄想奪取權力的貴族、領主，更成功的使用計
        say 謀打擊了我們高地的宿敵 - 奈圖王國，我們
        say 人民今日能夠在高地生存至今，全都得感謝博得。
~
>talk_prog p report the news~
if is_qmark($n)==fight_naytil 100002
        mpechoat $n $I聽完了你所探聽到的消息之後大叫了一聲。
        mpechoaround $n $I聽完了$N所探聽到的消息之後大叫了一聲。
        mpmod_qmark $n fight_naytil v0 = 3
        say 什麼！沒想到奈圖的動作那麼的快，看來我們不
        say 採取主動是不行的了。我要先去找博得商量一下
        say 。你快點跟過來吧，我們還有需要你的地方。
        mpecho $I急急忙忙地離開了。
        mpgoto boldar
endif
~
>talk_prog restart~
        if is_qmark($n) < fight_naytil 100008
                mpechoat $n 遠方傳來一陣聲響「你的任務(決戰奈圖)可以重解了....。」
                mpdel_qmark $n fight_naytil
                mpmod_qmark $n naytil_quest v0 = 8
        endif
~
