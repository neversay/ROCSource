>talk_prog topic~
if mobcount(11518) > 0
	break
endif
if is_qmark($n) == fight_highland 100003
	say 你....你是怎麼進來這裡的，難道那些殺手沒有攔住你嗎！看來
	say 那些殺手都已經死在你的手下了吧。那我認了，這次就算我們蠻
	say 人堡輸了，可惜的是枉費另外一邊就快要成功了。唉，多說無益
	say ，這東西你拿去吧。拿去給尼可拉斯吧。
	mpmod_qmark $n fight_highland v0 = 4
	mpoload 11528 $n viclv target
	mpechoat $n $I將惡魔之翼交給你。
	mpechoaround $n $I將惡魔之翼交給$N。
endif
