>give_prog 10670~
if is_qmark($n) == fight_naytil 100007
	mpecho $I 看了這徽章一眼。
	say 太好了，這徽章就象徵著奈圖城堡，看來這次奈圖敗的很慘，連
	say 這徽章都交出來了。這次真的太感謝你了，這徽章就送給你吧，
	say 我也不屑留著奈圖的東西。
	mppurge medal
	mpoload 10671 $n viclv target
	mpechoat $n $I將徽章交給你。
	mpechoaround $n $I將徽章交給$N。
	mpresp $n 1
	mpexp $n 2000
	mpmod_qmark $n fight_naytil v0 = 8
endif
