~
0 0 5
D1
~
~
0 0 11586
D3
~
~
0 0 11552
>room_enter 10 30~
echoat $n 忽然，一大捆的乾草從你頭上應聲砸下。
echoaround $n 忽然，一大捆的乾草從$N頭上應聲砸下。
if rand(50)
	echoat $n 不幸的，你完全閃不掉這一大捆的乾草。
	echoaround $n $N被砸傷了！
	modhmv $n 03.36 56 1
	break
endif
echoat $n 你幸運地在最後一刻往旁邊一閃，避免了被砸到的危險。
echoaround $n $N幸運地在最後一刻往旁邊一閃，避免了被砸到的危險。
~
|
S
#11586
沿著懸崖的小徑~
