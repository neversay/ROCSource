#11524
通往山上的小徑~
這條通往山上的小徑，越往山上越是陡峭。同時地面也是越加難以去攀爬。
地面變得更加滑溜，使得你一不小心就會跌傷了自己。
~
0 1 4
D1
~
~
0 0 11525
D3
~
~
0 0 11523
>room_enter 10 40~
if ispc($n)
        echoat $n 可惡，你的腳一滑，身體忽然失去重心，眼看著你就要跌倒了。
        echoaround $n $N的腳一滑，幾乎就要跌倒了！
        if pcnum($11524) >= 2
               if rand(70)
                      echoat $n 還好，你後面的人扶了你一把，你總算可以站穩了。
                      echoaround $n 還好$e及時被人扶助。
                      break
               endif
               echoat $n 哇！連後面的人都不想扶你一把，你重重的摔在地上。
               echoaround $n $N重重摔在地上。
               modhmv $n 03.36 56 1
        endif
               if rand(30)
                       echoat $n 還好，你及時的用手撐在地上。總算是勉強的站穩了。
                       echoaround $n 還好$e及時用手撐住，免於跌倒。
                       break
               endif
               echoat $n 哇！在你自己還沒有任何的反應時，你已經重重的摔在地上了。
               echoaround $n $N重重摔在地上！
               modhmv $n 03.40 56 1
endif
~
|
