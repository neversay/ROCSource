or robjcount(15475) > 0
        echoat $n 你開始搜尋這個被挖出來的小洞....
        echoaround $n $n 開始搜尋這個被挖出來的小洞....
        if robjcount(15474) > 0
                modrvt v1 | 1024
                callout 1 echoat $n 你在小洞中挖出了一個東西....
                callout 1 echoaround $n $n 在小洞中挖出了一個東西....
                callout 1 oload 15476 10 $n target
                callout 1 modrvt v1 r 1024
                callout 1 purge hole1-prehist
                callout 1 oload 15475 99 floor
        endif
        if robjcount(15475) > 0
                callout 1 echoat $n 這裡頭沒有什麼東西。
        endif
else
        echoat $n 這裡沒有你想要搜尋的東西。
endif
~
>room_command dig tree~
