skilldrv multihit $n
if rand(50)
        mete
        mpnowait
endif
if hitprcnt($i) < 30
        if mobcount(15612) > 0
                if insameroom(yao-prehist)
                        mpforce yao-prehist c 'double heal' wuu-prehist
