        if roomvalue($0) == 0
                if hasdoor(0)
                        callout 1 echo 輪盤(turntable) 似乎已經無法轉動了。
                else
                        callout 1 echo 輪盤(turntable) 似乎可以轉動(turnaround)。
                endif
                callout 1 echo 輪盤(turntable) 的尖端指著 0 的位置。
                break
        endif
        if roomvalue($0) == 1
                if hasdoor(0)
                        callout 1 echo 輪盤(turntable) 似乎已經無法轉動了。
                else
                        callout 1 echo 輪盤(turntable) 似乎可以轉動(turnaround)。
                endif
                callout 1 echo 輪盤(turntable) 的尖端指著 1 的位置。
                break
