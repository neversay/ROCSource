                callout 1 echoaround $n $n 將 輪盤(turntable) 轉到刻度 1 的位置....
                callout 1 modrvt v0 = 1
                callout 1 modrvt v1 | 64
                callout 1 modrvt v1 r 1024
                callout 2 echo 你聽到「喀！」的一聲，但是卻沒有發生什麼事情。
        endif
        break
endif
if roomvalue($1) & 8
        if roomvalue($1) & 64
                callout 1 echoat $n 你將 輪盤(turntable) 轉到刻度 1 的位置....
                callout 1 echoaround $n $n 將 輪盤(turntable) 轉到刻度 1 的位置....
                callout 1 modrvt v0 = 1
                callout 1 modrvt v1 | 128
                callout 1 modrvt v1 r 64
                callout 1 modrvt v1 r 1024
                callout 2 echo 你聽到「喀！」的一聲，但是卻沒有發生什麼事情。
                break
