if hitprcnt($i) <= 70
        if is_qmark(golden-summoned) > prehist_heal_elder 100000
                mpecho [1;33m黃金刀客(golden knifeman)發出了黃金刀氣，緩緩的治療了 $I 身上的傷。[m
                mpforce golden-summoned mpat 5 c 'cure blindness'
                mpforce golden-summoned c double golden-prehist
                mpmod_qmark golden-summoned prehist_heal_elder v0 - 1
        else
                if is_qmark(golden-summoned) == prehist_heal_elder 100000
                        mpforce golden-summoned say 我願消散生命，以復原金長老身上的傷口。
                        mpforce golden-summoned c 'full heal' golden-prehist
                        mppurge golden-prehist
                endif
        endif
endif
wear sleep-prehist
disarm
mpnowait
wear sleep-prehist
disarm
mpnowait
if mobcount(15434) < 5
        say 我向元素之神祈求，讓黃金元素聚合成形！
        mpmload 15434
        mpgroup self golden-summoned 1 0
        mpforce golden-summoned rescue golden-prehist
        mpadd_qmark golden-summoned prehist_heal_elder -1 10 0 0 0 0
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
mpjunk all.sleep-prehist
