or is_qmark($n) == prehist_wuu_quest
or is_qmark($i) == prehist_talkiing
        break
endif
if is_qmark($n) & prehist_quest 200256
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpforce $n say 您是不滿意現在手上的箭嗎？
        mpadd_qmark $n prehist_wuu_quest -1 1 0 0 0 1
        nod $n
        say 是的....，
        mpcallout 1 say 在遠古森林中的森天古木....，
        mpcallout 2 say 雖然堅硬有餘，卻都彈性不足....，
        mpcallout 3 say 用來做建材是相當的不錯....，
        mpcallout 4 say 用來做弓箭可能在彈性方面就不太夠....，
        mpcallout 5 say 我這把「極樂火傷」也是當初我到史卡拉貝大陸遊覽的時候....，
        mpcallout 6 say 在一次因緣際會下獲得的....，
        mpcallout 7 say 可惜回到這邊之後卻沒辦法找到一捆跟她匹配的箭....，
        mpcallout 8 say 真是可惜了這把好弓了。
        mpcallout 8 mpdel_qmark self prehist_talking
endif
~
>talk_prog p in bad mood~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100512
or is_qmark($n) == prehist_wuu_quest
or is_qmark($i) == prehist_talkiing
        break
endif
