white jade axe~
這一把斧頭是由白玉製成，整把斧頭製工精細，材質晶瑩剔透，斧柄鑲有三個寶石，
不知道有什麼用處，仔細看看(check)也許能發現什麼。
~
>obj_repop 100~
opmodvt self used = 1
oset self v1 = 62
oset self v2 = 72
~
>obj_command coutjde default~
if is_qmark($n) & green_counter 100001
	opmodvt self v0 | 1
endif
if is_qmark($n) & green_counter 100002
	opmodvt self v0 | 2
endif
if is_qmark($n) & green_counter 100004
	opmodvt self v0 | 4
endif
if is_qmark($n) & yellow_counter 100008
	opmodvt self v0 | 8
endif
if is_qmark($n) & yellow_counter 100016
	opmodvt self v0 | 16
endif
if is_qmark($n) & yellow_counter 100032
	opmodvt self v0 | 32
endif
if is_qmark($n) & red_counter 100064
	opmodvt self v0 | 64
endif
if is_qmark($n) & red_counter 100128
	opmodvt self v0 | 128
endif
if is_qmark($n) & red_counter 100256
	opmodvt self v0 | 256
endif
~
>obj_command check default~
nonechoat $n 斧柄的三個寶石
if objextra ( $o , v0 ) & 1
	if objextra ( $o , v0 ) & 2
		if objextra ( $o , v0 ) & 4
			echoat $n 皆為綠色。
			break
		endif
	endif
endif
if objextra ( $o , v0 ) & 8
	if objextra ( $o , v0 ) & 16
		if objextra ( $o , v0 ) & 32
			echoat $n 皆為黃色。
			break
		endif
	endif
endif
if objextra ( $o , v0 ) & 64
	if objextra ( $o , v0 ) & 128
		if objextra ( $o , v0 ) & 256
			echoat $n 皆為紅色。
			break
		endif
	endif
endif
if objextra ( $o , v0 ) & 1
	nonechoat $n 由上而下依序為綠色、
endif
if objextra ( $o , v0 ) & 8
	nonechoat $n 由上而下依序為黃色、
endif
if objextra ( $o , v0 ) & 64
	nonechoat $n 由上而下依序為紅色、
endif
if objextra ( $o , v0 ) & 2
	nonechoat $n 綠色、
endif
if objextra ( $o , v0 ) & 16
	nonechoat $n 黃色、
endif
if objextra ( $o , v0 ) & 128
	nonechoat $n 紅色、
endif
if objextra ( $o , v0 ) & 4
	echoat $n 及綠色。
endif
if objextra ( $o , v0 ) & 32
	echoat $n 及黃色。
endif
if objextra ( $o , v0 ) & 256
	echoat $n 及紅色。
endif
~
|

