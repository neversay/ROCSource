~
>greet_prog 100~
if is_qmark($n) == prehist_enemy
        yell 魔刀村的敵人 $n ，你給我納命來！
        hunt $n
        flaming
        mpnowait
        earth
        mpnowait
        circular
        mpnowait
endif
~
>talk_prog topic~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
say 您好，我是魔刀村的藍，請問有何指教嗎？
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) & prehist_quest 200001
        mpechoat $n -- ‧請問一下有關「幻魔高塔(Phantom Tower)」的事情。
endif
if is_qmark($n) == prehist_xue_quest 100001
        mpechoat $n -- ‧請問一下您都是用什麼招數取悅(please)其他人們的？
endif
if is_qmark($n) & prehist_quest 200016
        mpechoat $n -- ‧抱歉，我剛剛有聽你談到「遠古巨獸(behemoth)」這種生物是吧？
endif
if is_qmark($n) & prehist_quest 200032
        mpechoat $n -- ‧請問一下，你知不知道建造幻魔高塔的魔法師(magician)是誰？
endif
if is_qmark($n) == prehist_pii_quest 100015
        mpechoat $n -- ‧我奉金長老之命，帶著小痞來向藍老師您學習刀技(learn skills of knife)了。
endif
if is_qmark($n) == prehist_pii_quest 100023
        mpechoat $n -- ‧藍老師，小痞已經順利地擊敗人偶(defeat golem)，順利通過這一關。
endif
~
>talk_prog p defeat golem~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_pii_quest 100023
        if insameroom(pii2-prehist)
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                mpmod_qmark $n prehist_pii_quest v0 = 24
                mpmod_qmark pii2-prehist prehist_pii_quest v0 = 10
                mpforce $n say 藍老師，小痞已經順利地擊敗人偶(defeat golem)，順利通過這一關。
                sm
                mpcallout 1 say 這真是太棒了....，
                mpcallout 2 say 沒想到小痞在這麼短的時間內就能夠擊敗人偶....，
                mpcallout 3 mpforce pii2-prehist agree lan-prehist
                mpcallout 3 say 看到小痞成長，我想小痞的爺爺也會很高興....，
                mpcallout 4 say $n ，趕快帶小痞回去見金長老吧！
                mpcallout 4 mpdel_qmark self prehist_talking
                mpcallout 5 mpforce pii2-prehist tell $n 我們回去見金長老爺爺吧！
        else
                say 小痞呢？我並沒有看到他的人。
        endif
endif
~
>talk_prog p learn skills of knife~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_pii_quest 100015
        if insameroom(pii2-prehist)
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                mpmod_qmark $n prehist_pii_quest v0 = 16
                mpmod_qmark pii2-prehist prehist_pii_quest v0 = 1
                mpmod_qmark pii2-prehist prehist_pii_quest timer + 6
                mpforce $n say 我奉金長老之命，帶著小痞來向藍老師您學習刀技(learn skills of knife)了。
                nod $n
                mpcallout 1 say 小痞，金長老有跟我說過....，
                mpcallout 1 sm pii2-prehist
                mpcallout 2 say 你對於刀心已經有相當程度的認識了....，
                mpcallout 3 mpforce pii2-prehist say 這都是 $n 的功勞....，
                mpcallout 3 mpforce pii2-prehist blush
                mpcallout 4 mpforce pii2-prehist say 很多疑問都是他幫我解答的....，
                mpcallout 5 sm $n
                mpcallout 6 say 我知道，金長老對於 $n 也是讚譽有加....，
                mpcallout 7 mpecho $I 深呼吸一口氣....
                mpcallout 8 say 那麼我們回歸正題了....，
                mpcallout 9 mpforce pii2-prehist nod lan-prehist
                mpcallout 9 say 今天我的任務，就是訓練小痞你用刀的技巧....，
                mpcallout 10 say 在西邊的房間內有著我準備好的訓練人偶....，
                mpcallout 11 say 如果小痞你能夠獨立打敗它....
                mpcallout 12 mpforce pii2-prehist nod lan-prehist
                mpcallout 12 say 那麼就算通過第一關....，
                mpcallout 13 mpecho $I 的表情忽然嚴肅了起來....
                mpcallout 14 say 但是我必須要警告你們....，
                mpcallout 15 say $n 你絕對不能夠在「戰鬥」中幫助小痞....，
                mpcallout 16 say 否則整個試煉就算是失敗了....，
                mpcallout 17 open w
                mpcallout 18 say 去吧！小痞，讓你的刀技能夠在實戰中獲得增進。
                mpcallout 18 mpat 15595 mpmload 15435
                mpcallout 18 sm
                mpcallout 18 mpdel_qmark self prehist_talking
                mpcallout 18 mpmod_qmark $n prehist_pii_quest v0 = 17
                mpcallout 18 mpmod_qmark pii2-prehist prehist_pii_quest v0 = 2
                mpcallout 18 mpmod_qmark pii2-prehist prehist_pii_quest timer + 18
                mpcallout 19 mpforce pii2-prehist tell $n 我們到西邊的訓練房間去吧。
        else
                say 小痞呢？我並沒有看到他的人。
        endif
endif
