>give_prog 15488~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($n) !& prehist_quest 216384
	drop $o
	break
endif
if is_qmark($n) == prehist_golden_remolding_sword
or is_qmark($n) == prehist_golden_remolding_armor
or is_qmark($n) == prehist_golden_remolding_axe
	say 你上次的東西還沒作完。
	drop $o
	break
endif
mpadd_qmark $n prehist_golden_remolding_sword -1 0 0 0 0 1
mpjunk $o
nod $n
say 我收到 $n 的 白玉短劍(white jade short sword) 了，
say 這上頭可以鑲嵌兩顆晶玉寶石，
