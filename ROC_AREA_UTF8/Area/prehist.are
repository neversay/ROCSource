~
>talk_prog background~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prhist_enemy
        break
endif
mpforce $n say 請問一下有關魔刀村的背景或由來。
mpadd_qmark self prehist_talking 5 0 0 0 1 0
sm $n
say 魔刀村的歷史背景....，
mpcallout 1 say 我知道的反而沒有長老們多呢....，
mpcallout 2 say 不過最近倒是聽說魔刀村有把重要的刀失竊....，
mpcallout 2 mpcall prehist_clue_9 $n
mpcallout 3 say 刀王他緊張的要死....，
mpcallout 4 say 但是最近遠古森林的事情很多....，
mpcallout 5 say 使得他無暇去管這件事情....，
mpcallout 6 say 或許你可以去問問他....，
mpcallout 7 say 不過這項任務尚未完成....，
mpcallout 8 say 等完成了你再去問他吧！
mpcallout 8 mpdel_qmark self prehist_talking
~
>defun_prog prehist_clue_9~
if is_qmark($n) != prehist_quest
        mpadd_qmark $n prehist_quest -1 0 512 0 0 1
else
        if is_qmark($n) !& prehist_quest 200512
                mpmod_qmark $n prehist_quest v1 | 512
        endif
endif
~
>talk_prog p prehist forest~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prhist_enemy
        break
endif
mpforce $n say 請問一下有關遠古森林的一些事情。
mpadd_qmark self prehist_talking 5 0 0 0 1 0
say 當你進入魔刀村的時候應該也可以感受到了....，
mpcallout 1 say 遠古森林最近似乎被那座幻魔高塔影響很大....，
mpcallout 2 say 非但以往一些溫馴的動物變得十分的兇暴....，
mpcallout 3 say 還出現了一些十分強大的怪物在森林中徘徊....，
mpcallout 4 say 例如可怕的泰坦巨人(titan)與遠古巨獸(behemoth)....，
mpcallout 4 mpcall prehist_clue_7 $n
mpcallout 5 say 不知道奪走了多少冒險者的生命。
mpcallout 5 mpdel_qmark self prehist_talking
~
>defun_prog prehist_clue_7~
if is_qmark($n) != prehist_quest
        mpadd_qmark $n prehist_quest -1 0 144 0 0 1
else
        if is_qmark($n) !& prehist_quest 200016
                mpmod_qmark $n prehist_quest v1 | 16
        endif
        if is_qmark($n) !& prehist_quest 200128
                mpmod_qmark $n prehist_quest v1 | 128
        endif
endif
~
>talk_prog class~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
mpforce $n say 請問一下您是做什麼的？
say 我是魔刀村中的霧(Wuu)老師，
say 教導魔刀村中的學徒一些使用弓箭的技巧。
~
>talk_prog topic~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
say 您好，我是霧，請問 $n 您有什麼事嗎？
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) !& prehist_quest 100512
        if is_qmark($n) & prehist_quest 200256
                if is_qmark($n) != prehist_wuu_quest
                        mpechoat $n -- ‧您是不滿意(not satisfied)現在手上的箭嗎？
                endif
                if is_qmark($n) == prehist_wuu_quest 100001
                        mpechoat $n -- ‧我可以幫您到其他地方找更好的箭支(better arrow)回來。
                endif
                if is_qmark($n) == prehist_wuu_quest 100002
                        if is_inv_obj($n) == 931
                                mpechoat $n -- ‧我帶來了奧林帕斯山的銀雕箭(silver arrow)。
                        endif
                        if is_inv_obj($n) == 2470
                                mpechoat $n -- ‧我帶來了創世紀的星光閃焰矢(star arrow)。
                        endif
                        if is_inv_obj($n) == 4553
                                mpechoat $n -- ‧我帶來了光明之鎮的奔騰之箭(pentium the arrow)。
                        endif
                        if is_inv_obj($n) == 4561
                                mpechoat $n -- ‧我帶來了光明之鎮的水晶箭矢(crystal arrow)。
                        endif
                        if is_inv_obj($n) == 10322
                                mpechoat $n -- ‧我帶來了索雷斯城的奇蹟之箭(wonder arrow)。
                        endif
                        if is_inv_obj($n) == 32062
                                mpechoat $n -- ‧我帶來了炎紅之塔的炎紅巨箭(flame-red arrow)。
                        endif
                        if is_inv_obj($n) == 37016
                                mpechoat $n -- ‧我帶來了鬼鎮的羈絆之箭(fetter arrow)。
                        endif
                        if is_inv_obj($n) == 40008
                                mpechoat $n -- ‧我帶來了迷航之海的清音(clear voice)。
                        endif
                        if is_qmark($n) > prehist_wuu_quest 200000
                                mpechoat $n -- ‧這些就是我所蒐集的箭支(gathered arrow)。
                        endif
                endif
        endif
endif
~
>talk_prog restart~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100512
or is_qmark($i) == prehist_talkiing
        break
endif
if is_qmark($n) <= prehist_wuu_quest 100002
        mpechoat $n 遠方傳來一陣聲響「本項任務你已經可以重新開始！」
        mpdel_qmark $n prehist_wuu_quest
endif
~
>talk_prog p gathered arrow~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100512
or is_qmark($i) == prehist_talkiing
        break
endif
if is_qmark($n) == prehist_wuu_quest 100002
        if is_qmark($n) > prehist_wuu_quest 200000
                mpadd_qmark self prehist_talking
                mpdel_qmark $n prehist_wuu_quest
				mpmod_qmark $n prehist_quest v0 | 512
                mpforce $n say 這些就是我所蒐集的箭支。
                bow $n
                mpcallout 1 say 謝謝你的熱情幫助....，
                mpcallout 2 say 我會好好的珍惜你提供的箭支的....，
                mpcallout 3 mpexp $n 3000
                mpcallout 3 mpskillexp $n 1500
                mpcallout 4 wave $n
                mpcallout 4 say 最後還是跟你說聲謝謝。
                mpcallout 4 mpdel_qmark self prehist_talking
        endif
endif
