>room_time 100~
if mobcount(15613) == 0
        if mobcount(15656) == 0
                if mobcount(15657) == 0
                        mload 15613
                endif
        endif
endif
if mobcount(15604) == 0
        if roomvalue($0) == 0
                force 15631 mload 15604
        endif
        if roomvalue($0) == 1
                force 15598 mload 15604
        endif
        if roomvalue($0) == 2
                force 15588 mload 15604
        endif
endif
if hasdoor(0)
else
        if roomvalue($0) == 0
                makedoor 0 破爛的門(door) door 3 0 15631
                force 15631 makedoor 2 破爛的門(door) door 3 0 15634
        endif
        if roomvalue($0) == 1
                makedoor 0 通往廢墟(exit) exit 0 0 15598
                force 15598 makedoor 2 通往廢墟(exit) exit 0 0 15634
        endif
        if roomvalue($0) == 2
                makedoor 0 通往房子(exit) exit 0 0 15588
                force 15588 makedoor 2 通往街道(exit) exit 0 0 15634
        endif
endif
~
