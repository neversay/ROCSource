~
>talk_prog p crystal jade~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) & prehist_quest 208192
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpforce $n say 長老，雷領事叫我來問你有關晶玉寶石的事情。
        hmm
        mpcallout 1 say 晶玉寶石啊！那可是迷霧之島的至寶啊....！
        mpcallout 2 say 各種顏色的寶石各有其特別的魔力....，
        mpcallout 3 say 如果能夠與遠古森林的特產 - 白玉融合在一起....，
        mpcallout 4 say 那麼更可以發揮其強大的功能....，
        mpcallout 5 say 目前為止，我也只能知道綠色、黃色與紅色晶玉的功能....，
        mpcallout 6 say 綠色與白玉武器結合可以增加其傷害力....，
        mpcallout 7 say 若與護甲結合反而可以增加使用者抵抗物理傷害的能力....，
        mpcallout 8 say 黃色與武器結合可以增加其命中率....，
        mpcallout 9 say 與護甲結合則可以增加使用者的閃避力....，
        mpcallout 10 say 紅色與武器結合則可以增加其魔法潛力....，
        mpcallout 11 say 若與護甲結合則可以增加使用者抗魔法傷害的能力....，
        mpcallout 12 say 至於是否還有其他顏色我就不太清楚了....，
        mpcallout 13 say 先不用說這些珍奇的晶玉....，
        mpcallout 14 say 連白玉材質的武器或護甲都不容易見到....，
        mpcallout 15 say 如果你真的擁有這些珍奇的東西....，
        mpcallout 16 say 儘管跟來跟我說，我會幫你改造(remold)的。
        mpcallout 16 mpmod_qmark $n prehist_quest v1 | 16384
        mpcallout 16 mpdel_qmark self prehist_talking
endif
~
>talk_prog p passed test 1~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
or is_qmark($i) == prehist_talking
        break
endif
if insameroom(pii2-prehist)
        if is_qmark($n) == prehist_pii_quest 100024
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                mpmod_qmark $n prehist_pii_quest v0 = 25
                mpmod_qmark pii2-prehist prehist_pii_quest v0 = 11
                mpforce $n say 長老，小痞已經順利地通過了藍老師的第一關(passed test 1)。
                mpecho $I 笑得合不攏嘴....
                mpcallout 1 say 真的嗎？小痞你的進展真是快啊....，
                mpcallout 2 mpforce pii2-prehist say 這一切都是 $n 他的幫忙....，
                mpcallout 3 mpforce pii2-prehist say 否則我還是以前那不知天高地厚的小痞....，
                mpcallout 4 agree pii2-prehist
                mpcallout 5 say 非常好，事實上藍老師早在你們過來前就捎來訊息....，
                mpcallout 6 say 告訴我有關小痞你在用刀技巧上的神速進步....，
                mpcallout 7 say 不過，往後還有不少的用刀技巧需要你去鑽研....，
                mpcallout 8 say 可別因此就志得意滿喔....！
                mpcallout 9 mpforce pii2-prehist say 是的，爺爺！我知道....。
                mpcallout 10 nod pii2-prehist
                mpcallout 11 say 那麼小痞，你先去忙你的吧....。
                mpcallout 12 mpforce pii2-prehist nod golden-prehist
                mpcallout 13 mpforce pii2-prehist bye $n
                mpcallout 14 mpecho 小痞(Pii) 歡天喜地地離開了這裡....
                mpcallout 14 mppurge pii2-prehist
                mpcallout 14 mpat 15634 mpmload 15657
                mpcallout 15 say $n ，真的很謝謝您....，
                mpcallout 16 say 由於您的幫忙....，
                mpcallout 17 say 才能夠讓小痞那小子將野放的心性給收了回來....，
                mpcallout 18 say 我想往後小痞不用其他人的鞭策也能夠自己用功了....，
                mpcallout 19 say 由於 $n 您的悉心教導....，
                mpcallout 20 mpcall prehist_golden_pii-test4 $n
                mpcallout 23 say 往後我希望小痞也能夠跟您一樣....，
                mpcallout 24 say 成為一個十分優秀的冒險者。
                mpcallout 25 wave $n
                mpcallout 25 mpdel_qmark self prehist_talking
else
        say 小痞？那小痞人呢？我沒看到他的人。
endif
~
>defun_prog prehist_golden_pii-test4~
if is_qmark($n) & prehist_pii_quest 300001
        say 讓小痞能夠活用身體的技巧來輔助戰鬥....，
        mpskillexp $n 3000
endif
if is_qmark($n) & prehist_pii_quest 300002
        say 讓小痞明瞭揮刀速度對於用刀的重要性....，
        mpexp $n 5000
endif
if is_qmark($n) & prehist_pii_quest 300004
        mpcallout 1 mpexp $n 8000
        mpcallout 1 say 而且小痞更知道如何使用腕力來增加揮刀力道....
endif
if is_qmark($n) & prehist_pii_quest 300008
        mpcallout 1 mpskillexp $n 5000
        mpcallout 1 say 而且小痞更學會了利用精準的眼力來捕捉對手的動態....，
else
