>fight_prog 100~
if is_qmark($n) != prehist_enemy
        mpadd_all_qmark $n prehist_enemy -1 0 0 0 1 1
endif
if insameroom(guard-prehist)
        if isaffected(guard-prehist) & 1
                c 'cure blindness' guard-prehist
                mpnowait
                c 'cure blindness' 2.guard-prehist
                mpnowait
        endif
endif
if rmobcount(15649) < 2
        say 守衛，快來幫我！
        mpmload 15649
        mpgroup self guard-prehist 1 0
endif
mpforce guard-prehist hunt $n
if rmobcount(15649) < 2
        mpmload 15649
        mpgroup self guard-prehist 1 0
endif
mpforce guard-prehist hunt $n
hunt $n
mpnowait
