or is_qmark($n) & prehist_quest 100064
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_lei_quest 100002
        if is_qmark($n) == prehist_lei_quest 200001
                if is_inv_obj($n) == 15478
