>room_command retrieve rope~
if robjcount(15437) > 0
        echoat $n 你將 繩索(rope) 給收了起來。
        echoaround $n $n 將 繩索(rope) 給收了起來。
        force 15677 echo 擺在洞旁的 繩索(rope) 忽然被收了回去。
        purge rope3-prehist
        force 15677 purge rope2-prehist
        oload 15435 viclv $n target
else
        echoat $n 這裡沒有你要收的東西。
endif
~
>room_command pullup rope~
if robjcount(15437) > 0
        echoat $n 你攀爬 繩索(rope) 通過了樓板到達了樓上。
        echoaround $n $n 攀爬 繩索(rope) 通過了樓板到達了樓上。
        force 15677 echo $n 藉著攀爬 繩索(rope) 到達了這邊。
        transfer $n 15677
else
        echoat $n 這裡並沒有這項東西。
endif
~
>room_command flutter up~
if ispc($n)
        if race($n) == Orc
        or race($n) == Lizardman
        or race($n) == Dwarf
                echoat $n 你的身軀太大，無法穿過樓梯間的裂縫。
                echoaround $n $n 的身軀太大，無法穿過樓梯間的裂縫。
                break
        endif
        if isaffected($n) & 524288
        or race($n) == Beholder
        or race($n) == Vampire
        or race($n) == Imp
                echoat $n 你往上飄浮穿過了樓梯間的裂縫，來到了下一層樓。
                echoaround $n $n 往上飄浮穿過了樓梯間的裂縫....
                force 15677 echo $n 由 洞口(hole) 飄了上來....
                transfer $n 15677
        else
                echoat $n 你沒有辦法飛起來。
        endif
endif
~
>room_command climb up~
if ispc($n)
        if race($n) == Orc
        or race($n) == Lizardman
        or race($n) == Dwarf
                echoat $n 你的身軀太大，無法爬過樓梯間的裂縫。
                echoaround $n $n 的身軀太大，無法爬過樓梯間的裂縫。
                break
        endif
        if race($n) == Imp
        or race($n) == Beholder
        or race($n) == Vampire
                echoat $n 你往上飄浮穿過了樓梯間的裂縫，來到了下一層樓。
                echoaround $n $n 往上飄浮穿過了樓梯間的裂縫....
                force 15677 echo $n 由 洞口(hole) 飄了上來....
                transfer $n 15677
        else
                echoat $n 你往上慢慢的爬過裂縫，來到了下一層樓。
                echoaround $n $n 往上爬過了樓梯間的裂縫....
                force 15677 echo $n 由 洞口(hole) 爬了上來....
                transfer $n 15677
        endif
endif
~
