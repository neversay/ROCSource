>entry_prog 100~
if inroom($i) == 15608
        if is_qmark($i) == prehist_pii_quest 100002
                if insameroom($b)
                        mpmod_qmark self prehist_pii_quest v0 = 3
                        mpmod_qmark self prehist_pii_quest timer = 30
                        mpmod_qmark $b prehist_pii_quest v0 = 9
                        nod
                        say 這裡就是金長老爺爺所說的破舊道場嗎....？
                        mpcallout 1 say 讓我在這邊好好的觀摩一個刀客對刀應有的態度吧....！
                        mpcallout 2 say $b 如果你可以在這邊陪我的話....，
                        mpcallout 3 say 那麼我有問題就可以馬上問你....，
                        mpcallout 4 say 但是如果你有事得先離開的話....，
                        mpcallout 5 say 過了一天請記得回到這邊....，
                        mpcallout 6 say 我們得一起回去見金長老爺爺。
                        mpcallout 7 mpecho $I 話說完便在道場裡頭認真地學習起刀技了....
                else
                        tell $b 我已經到了破舊的道場，你到哪裡去了？
                endif
        endif
endif
~
>tick_prog 100~
if is_qmark($i) == prehist_pii_quest 100003
        if inroom($i) == 15608
                if insameroom($b)
                        if is_qmark($i) == prehist_pii_quest 1026
                                sm $b
                                say $b，我有個問題想要問你，
                                say 刀與心非得在這種破舊的環境中才能夠獲得一統嗎？
                                mpechoat $b -- ‧小痞，我想破舊的環境(old and shabby environment)不過是磨練刀技的方法之一。
                                mpechoat $b -- ‧小痞，心與刀的合一是不用在乎身在何方(body anywhere is little significance)的。
                                break
                        endif
                        if is_qmark($i) == prehist_pii_quest 1022
                                blush $b
                                say $b，我有個問題想要問你，
                                say 為何世上用劍者多，用刀者少，刀客真比劍客弱嗎？
                                mpechoat $b -- ‧小痞，用刀者少，只因本世界創造者創造了太多的劍，太少的刀(damn it Pluto)。
                                mpechoat $b -- ‧小痞，無人，無我，無他，無壽者；心者亦劍，心者亦刀(four images of humanbeing)。
                                break
                        endif
                        if is_qmark($i) == prehist_pii_quest 1018
                                if is_qmark($i) & prehist_pii_quest 200001
                                or is_qmark($i) & prehist_pii_quest 200002
                                        if is_qmark($i) & prehist_pii_quest 200004
                                        or is_qmark($i) & prehist_pii_quest 200008
                                                mpecho 你見到 $I 的表情堅毅地站了起來....
                                                say 我想雖然時間未到，但是由於 $b 您的幫忙，
                                                say 我已經完全知道心與刀的基本內涵了，我們去找金長老爺爺吧！
                                                mpmod_qmark self prehist_pii_quest v0 = 4
                                                mpmod_qmark $b prehist_pii_quest v0 = 10
                                                mpmod_qmark self prehist_pii_quest timer + 12
