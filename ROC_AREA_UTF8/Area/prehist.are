#15638
xue-prehist xue~
小雪(Xue)~
一個美麗的白衣少女小雪(Xue)在這招呼客人。
~
小雪是魔刀村中的鬼靈精，也是冰長老疼愛的孫女。如果你對她有意思，至少得先經過冰
長老的同意，否則被凍成冰棒的感覺一定不太好受。
~
2|64|1073741824 32 0 S
48 0 0 0d0+0 0d0+30
3000 0
8 8 2
P 8|4194304
C 1|2
>talk_prog topic~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
sm $n
say 您好， $n 。請問有什麼事情嗎？
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) & prehist_quest 200002
        mpechoat $n -- ‧請問一下「梅杜莎(Medusa)」是什麼樣的一種生物？
endif
if is_qmark($n) & prehist_quest 200004
        if is_qmark($n) !& prehist_quest 100002
                if is_qmark($n) != prehist_xue_quest
                        mpechoat $n -- ‧我聽村民說過最近冰長老脾氣不太好是嗎(ill-temper)？
                endif
        endif
endif
if is_qmark($n) == prehist_xue_quest 100001
        if is_qmark($n) >= prehist_xue_quest 300001
                mpechoat $n -- ‧我已經蒐集(gathered)到有關如何取悅冰長老的方法了。
        endif
endif
if is_qmark($n) == prehist_xue_quest 100004
        mpechoat $n -- ‧小雪，我想我失敗(fail)了，冰長老並沒有因此而高興。
endif
if is_qmark($n) == prehist_xue_quest 100005
        mpechoat $n -- ‧小雪，冰長老叫我跟你說他的心情好多了(much better)。
endif
~
>talk_prog p much better~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
if is_qmark($n) == prehist_xue_quest 100005
	mpdel_qmark $n prehist_xue_quest
	mpmod_qmark $n prehist_quest v0 | 2
	mpadd_qmark self prehist_talking 5 0 0 0 1 0
	mpforce $n say 小雪，冰長老叫我跟你說他的心情好多了(much better)。
	hop
	dance $n
	mpcallout 1 say 真的嗎？您真是太厲害了....，
	mpcallout 2 kiss $n
	mpcallout 3 blush
	mpcallout 4 say 我想您不要誤會....，
	mpcallout 5 mpexp $n 5000
	mpcallout 5 mpskillexp $n 5000
	mpcallout 5 say 這是我感激您的方式....，
	mpcallout 6 say 謝謝您的幫忙了。
	mpcallout 6 smile $n
endif
~
>talk_prog restart~
if is_qmark($n) == prehist_enemy
        break
endif
if is_qmark($n) & prehist_quest 100002
        tell $n 您已經完成這項任務了。
        break
endif
if is_qmark($n) == prehist_xue_quest 100004
        tell $n 您可能必須等一段時間後冰長老爺爺氣消了才能再回來喔！
        break
endif
if is_qmark($n) <= prehist_xue_quest 100003
        tell $n 您的這項任務已經可以重新開始了。
        mpdel_qmark $n prehist_xue_quest
endif
