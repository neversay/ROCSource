	mpechoaround $b $I [1;33m忽然出現向$B啄了過去....[m
	hunt $b
	mpnowait
	skilldrv multihit $b
	mpdef_rembch null-tar
	mpdel_qmark self prehist_buzzard_unique-skill
endif
