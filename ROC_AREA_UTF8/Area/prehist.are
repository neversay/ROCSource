>room_time 100~
if roomtimer($0) < 0
	modrvt t0 = 0
	break
endif
if roomtimer($0) == 0
	if rnplayer($) > 0
		break
	else
		if mobcount(15418) == 2
			at 15651 mload 15418
		endif
		if mobcount(15418) == 1
			at 15635 mload 15418
			at 15651 mload 15418
		endif
		if mobcount(15418) == 0
			at 15635 mload 15418
			at 15649 mload 15418
			at 15651 mload 15418
		endif
	endif
endif
~
