>room_command enter hole~
if ispc($n)
        echoat $n 你往洞口游了過去，嘗試進入洞口....
        echoaround $n $n 往洞口游了過去....
        if str($n) <= 20
        or dex($n) <= 20
                if dex($n) <= 20
                        callout 2 rcall prehist_poolhole_fail $n
                        callout 2 echoat $n 你的速度不夠迅速，被激烈的水流給捲了回來。
                        callout 2 echoarond $n $n 的速度不夠迅速，被激烈的水流給捲了回來。
                        break
                endif
                if str($n) <= 20
                        callout 2 rcall prehist_poolhole_fail $n
                        callout 2 echoat $n 你的力量不足，在激烈水流中無法控制身軀而被捲了回來。
                        callout 2 echoaround $n $n 在激烈水流中無法控制身軀而被捲了回來。
                endif
                break
        endif
        if roomvalue($0)  == 0
                callout 2 transfer $n 15481
        else
                callout 2 transfer $n 15484
        endif
        callout 2 echoat $n 經過一番努力，你順利地進入了洞口。
        callout 2 echoaround $n $n 用力地游入了洞口。
endif
~
