skilldrv speedhit $n
skilldrv speedhit $n
skilldrv speedhit $n
        mpechoat $n $I的重重一拳打得你[1;32m*** 鮮血直流 ***[m.
        mpechoaround $n $I的重重一拳打得$N[1;32m*** 鮮血直流 ***[m.
        mpechoat $n $I的重重一拳打得你[1;32m*** 鮮血直流 ***[m.
        mpechoaround $n $I的重重一拳打得$N[1;32m*** 鮮血直流 ***[m.
        mpechoat $n $I的重重一拳打得你[1;32m*** 鮮血直流 ***[m.
        mpechoaround $n $I的重重一拳打得$N[1;32m*** 鮮血直流 ***[m.
mpforcer here modhmv $n 01.280 330 0
mpforcer here modhmv $n 01.280 330 0
mpforcer here modhmv $n 01.280 330 0
if ispc($r)
        c 'shocking grasp' $r
        mpnowait
endif
if rand(10)
	mpat 5 c 'con wea'worse
endif
~
>entry_prog 100~
mpasound 忽然你感到四周的地面在震動....
if ispc($r)
        mpechoat $r $I進入了這邊，忽然就對你展開了猛烈的攻擊....
        mpechoaround $r $I進入了這邊，忽然就對$R展開了猛烈的攻擊....
        hunt $r
        mpnowait
        if rand(50)
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
                skilldrv heavyhit $r
        else
                skilldrv speedhit $r
                skilldrv speedhit $r
                skilldrv speedhit $r
                skilldrv speedhit $r
                skilldrv speedhit $r
        endif
endif
~
>greet_prog 100~
if ispc($n)
        mpechoat $n $I忽然對你展開了猛烈的攻擊....
        mpechoaround $n $I忽然對$N展開了猛烈的攻擊....
        hunt $n
        mpnowait
        if rand(50)
                skilldrv heavyhit $n
                skilldrv heavyhit $n
                skilldrv heavyhit $n
                skilldrv heavyhit $n
                skilldrv heavyhit $n
        else
                skilldrv speedhit $n
                skilldrv speedhit $n
                skilldrv speedhit $n
                skilldrv speedhit $n
                skilldrv speedhit $n
        endif
endif
~
>hurt_prog 137~
if rand(30)
        if ispc($n)
                mpechoaround $n [1;33m$I迅速地閃避$N的狂暴攻擊，轉而攻擊$N！[m
                mpechoat $n [1;33m$I迅速地閃避你的狂暴攻擊，轉而攻擊你！[m
                mpgoto self
                hunt $n
                mpnowait
                frenzy
                mpnowait
        endif
endif
~
>hurt_prog 190~
if rand(30)
        if ispc($n)
                mpechoaround $n [1;33m $N的流星箭引得$I猛烈攻向$N！[m
                mpechoat $n [1;33m你的流星箭引得$I猛烈攻向你！[m
                mpgoto self
                hunt $n
                mpnowait
                c 3 'shocking grasp' $n
                mpnowait
        endif
endif
~
>hurt_prog 101~
if ispc($n)
        mpechoaround $n [1;33m由於$N的繞刺，使得$I轉而猛烈攻向$N！[m
        mpechoat $n [1;33m由於你的繞刺，使得$I轉而猛烈攻向你！[m
        mpgoto self
        hunt $n
        mpnowait
        disarm
        mpnowait
        get all
        kick
        mpnowait
        bashhead
        mpnowait
endif
~
>hurt_prog 138~
if ispc($n)
        mpechoaround $n [1;33m $N的頭錘攻擊非但沒用，反而讓$I猛烈攻向$N！[m
        mpechoat $n [1;33m你的頭錘攻擊非但沒用，還讓$I猛烈攻向你！[m
        mpgoto self
        hunt $n
        mpnowait
        bashhead
        mpnowait
        bashhead
        mpnowait
        bashhead
        mpnowait
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if rand(13)
        if rand(33)
                mpoload 15483 10
        else
                if rand(50)
                        mpoload 15484 10
                else
                        mpoload 15485 10
                endif
        endif
endif
if pcnum($) > 20
	mpgreward exp $n 30 5000
else
	if pcnum($) > 15
        	mpgreward exp $n 30 5500
	else
        	if pcnum($) > 10
                	mpgreward exp $n 30 6000
        	else
                	if pcnum($) > 5
                        	mpgreward exp $n 30 6500
                	else
                        	mpgreward exp $n 30 7000
			endif
                endif
        endif
endif
