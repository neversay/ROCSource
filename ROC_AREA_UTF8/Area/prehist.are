>room_command check junks~
if robjcount(15442) > 0
	echoat $n 你嘗試檢查這些雜物....
	echoaround $n $n 嘗試檢查地上的雜物....
	callout 2 echoat $n 你發覺雜物的上頭沾滿了灰塵，而且重量相當的重....
else
	echoat $n 這裡沒有這個東西。
