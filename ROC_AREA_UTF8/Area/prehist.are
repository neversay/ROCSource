~
>defun_prog prehist_pii2_test1~
if mobcount(15435) > 0
        if insameroom(golem1-prehist)
        else
                mptransfer golem1-prehist
        endif
else
        mpmload 15435
endif
mpecho $I 深呼吸一口氣....
mpat 5 c 'full heal'
mpforcer here modhmv golem1-prehist 04.100 100 0
mpcallout 1 mpecho $I 拿起了武器，再度準備攻向訓練人偶....
mpcallout 2 mpkill golem1-prehist
mpcallout 2 mpdel_qmark self prehist_talking
~
>fight_prog 100~
if vnum($n) != 15435
        break
endif
if hitprcnt($i) < 30
        if is_qmark($i) == prehist_pii_quest 100004
                say 哇！ $N 好強，我打不過他....！
                mpecho $I 趕緊終止了戰鬥....。
                mpgoto self
                mpmod_qmark self prehist_pii_quest v0 = 5
                if insameroom($b)
                        mpmod_qmark $b prehist_pii_quest v0 = 19
                        mpcallout 1 mpechoat $b -- ‧小痞，你太執著於攻擊，應該多利用一些身體的技巧(skill up)。
                        mpcallout 1 mpechoat $b -- ‧小痞，你的攻擊速度太慢，可以嘗試在揮刀時更快一點(speed up)。
                        mpcallout 1 say $b ，請問為何我會失敗？我該在哪方面加強？
                else
                        mpat $b mpmod_qmark $b prehist_pii_quest v0 = 13
                        mpat $b mpadd_qmark $b prehist_pii_waiting 72 0 0 0 0 1
                        tell $b 你竟然不在我身邊！
                        mppurge self
                endif
                break
        endif
        if is_qmark($i) == prehist_pii_quest 100006
                say 哇！ $N 好強，我打不過他....！
                mpecho $I 趕緊終止了戰鬥....。
                mpgoto self
                mpmod_qmark self prehist_pii_quest v0 = 7
                if insameroom($b)
                        mpmod_qmark $b prehist_pii_quest v0 = 21
                        mpcallout 1 mpechoat $b -- ‧小痞，你揮刀的力道太弱，需要在腕力上加強(power up)。
                        mpcallout 1 mpechoat $b -- ‧小痞，你揮刀的命中率太低了，需要在動態視力上加強(accuracy up)。
                        mpcallout 1 say $b ，請問為何我會再度失敗？我該在哪方面加強？
                else
                        mpat $b mpmod_qmark $b prehist_pii_quest v0 = 13
                        mpat $b mpadd_qmark $b prehist_pii_waiting 72 0 0 0 0 1
                        tell $b 你竟然不在我身邊！
                        mppurge self
                endif
                break
        endif
endif
if rand(50)
        if is_equ_obj($i) != 15622
                wear knife
        endif
endif
if rand(50)
        if is_qmark($i) & prehist_pii_quest 200001
                mpecho [1;32m$I 運用了身體的技巧....[m
                if rand(33)
                        wear knife
                        disarm
                        mpnowait
                else
                        if rand(50)
                                mpecho 小痞(Pii)的凌空飛踢讓基本訓練人偶(basic pracitced golem)[1;35m稍感疼痛[m!
                                mpforcer here modhmv golem1-prehist 01.40 60 0
                        else
                                mpecho 小痞(Pii)的頭部猛擊讓基本訓練人偶(basic pracitced golem)[1;35m稍感疼痛[m!
                                mpforcer here modhmv golem1-prehist 01.40 60 0
                        endif
                endif
        endif
        if is_qmark($i) & prehist_pii_quest 200002
                mpecho [1;32m$I 忽然增加了揮刀的速度....[m
                if rand(50)
                        skilldrv multihit $n
                else
                        skilldrv heavyhit $n
                        skilldrv heavyhit $n
                        skilldrv heavyhit $n
                endif
        endif
endif
~
