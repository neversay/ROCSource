			echo 滾滾的黃沙落下蓋住了拉桿，掩埋了小洞....
		endif
		if hasdoor(0)
			echo 滾滾的岩石落下，擋住了北面的出口....
			deldoor 0
			force 15596 echo 滾滾的岩石落下，擋住了南面岩壁的入口....
			force 15596 deldoor 2
		endif
	endif
endif
if pcnum($) > 0
	if rand(40)
		if roomvalue($0) & 1
			if roomtimer($0) <= 36
				if roomtimer($0) > 24
					echo 不知是不是空氣不流通的關係，你開始覺得這裡有些熱....
				endif
			endif
			if roomtimer($0) <= 24
				if roomtimer($0) > 12
					echo 能夠呼吸的空氣越來越稀薄，你開始感到身體不適、頭暈目眩....
					modhmv pc 01.10 15 0
				endif
			endif
			if roomtimer($0) <= 12
				if roomtimer($0) > 6
					if rand(50)
						echo 你開始感到呼吸困難，連心臟跳動的聲音也聽的一清二楚....
					else
						echo 由於空氣不足，你開始覺得噁心，並且呼吸困難....
					endif
					modhmv pc 01.30 40 0
				endif
			endif
			if roomtimer($0) <= 6
				if roomtimer($0) > 2
					if rand(50)
						echo 耳朵中心臟的跳動聲如打雷一般的響亮，你感覺到快要窒息了....
					else
						echo 你幾乎無法呼吸，連根手指都難以抬起....
					endif
					modhmv pc 01.60 80 0
				endif
			endif
			if roomtimer($0) <= 2
				echo 這裡的空氣已經用盡，你完全無法在裡頭呼吸....
				modhmv pc 01.100 100 0
			endif
		endif
	endif
endif
~
>room_enter 8 100~
if ispc($n)
	if roomvalue($0) == 0
