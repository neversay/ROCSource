>talk_prog p directly present~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_pii_quest
or is_qmark($i) == prehist_talking
or is_qmark($n) & prehist_quest 100004
or is_qmark($n) == prehist_pii_quest 100002
        break
endif
if is_qmark($n) == prehist_pii_quest 100004
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpforce $n say 小痞，你爺爺說除非你能夠有點長進，不然他不會教你的(directly present)。
        faint $n
        say 他....我爺爺他真的這麼說....，
        if resp($n) > 15
                mpcallout 1 mpecho $I 淚眼汪汪地看著你....
                mpcallout 2 say $n 你在史卡拉貝大陸與迷霧之島的名氣都那麼大....，
                mpcallout 3 say 去幫我說個情好不好(yes/no)？
                mpcallout 3 mpdel_qmark self prehist_talking
                mpcallout 3 mpmod_qmark $n prehist_pii_quest v0 = 5
        else
                mpcallout 1 mpmod_qmark $n prehist_pii_quest timer = 72
                mpcallout 1 mpmod_qmark $n prehist_pii_quest v0 = 2
                mpcallout 1 curse
                mpcallout 1 mpexp $n -5000
                mpcallout 2 say 老不死的，不要就不要....，
                mpcallout 3 say 以後我自己找人學....，
                mpcallout 4 say 到時候我們就等著瞧....！
                mpcallout 5 mpechoat $n $I 抬頭看著你....
                mpcallout 5 mpechoaround $n $I 抬頭惡狠狠地看著 $n
                mpcallout 6 say 話傳完了吧？那麼你可以滾了....。
