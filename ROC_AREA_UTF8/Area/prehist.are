if is_equ_obj($i) != 15620
        wield iron twohand
endif
if ispc($r)
        if is_qmark($r) == prehist_enemy
                yell 來人啊！捉住這個魔刀村的敵人！
                        if rmobcount(15649) < 2
                                mpmload 15649
                                mpgroup self guard-prehist 1 0
                        endif
                        mpforce guard-prehist hunt $r
                        if rmobcount(15649) < 2
                                mpmload 15649
                                mpgroup self guard-prehist 1 0
                        endif
                        mpforce guard-prehist hunt $r
                        hunt $r
                        mpnowait
                endif
        endif
endif
