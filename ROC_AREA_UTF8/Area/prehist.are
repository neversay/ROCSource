	mpdef_rembch $n
	mpecho $I [1;33m忽然往高空飛去....[m
	mpgoto 5
	mpcallout 8 mpcall prehist_buzzard_unique-skill $b
else
	if ispc($r)
		mpechoat $r [1;33m$I 忽然向你的眼睛啄了過來....[m
		mpechoaround $r [1;33m$I 忽然向$R的眼睛啄了過去....[m
