if is_qmark($n) & prehist_quest 200032
        mpechoat $n -- ‧你說路克的房子壞掉了，難道他不修理(fix)嗎？
endif
if is_qmark($n) & prehist_quest 200064
        if is_qmark($n) !& prehist_quest 100016
                if is_qmark($n) != prehist_cute_quest
                        mpechoat $n -- ‧心情不好(bad mood)為何要跑到樹洞去躲啊？
                        mpechoat $n -- ‧那麼那個樹洞一定是相當的隱密了(enshrouded)。
                endif
                if is_qmark($n) == prehist_cute_quest 100001
                        mpechoat $n -- ‧可以告訴我為什麼(tell me why)你不能夠再到那裡去了嗎？
                        mpechoat $n -- ‧說說看為什麼，如果我可以幫你就幫你(i can help you)。
                endif
                if is_qmark($n) == prehist_cute_quest 100002
                        if is_inv_obj($n) == 15476
                                mpechoat $n -- ‧小女孩，我幫你找回你的寶藏(found your treasure)了。
                        endif
                        if mobcount(15426) == 0
                                if mobcount(15427) == 0
                                        if mobcount(15438) == 0
                                                mpechoat $n -- ‧小女孩，我幫你清光全部的泰坦巨人(clear titans)了。
                                        endif
                                endif
                        endif
                endif
        endif
endif
if is_qmark($n) & prehist_quest 200128
        mpechoat $n -- ‧你所說的泰坦巨人(titan)是怎麼樣的一種生物？
endif
