>entry_prog 100~
if inroom($i) != 15450
        if being($b)
                say 我的隨從$B，隨我回到我們的空間吧。
                mptransfer $b 15450
                mpgoto 15450
                if pcnum($) > 1
                        c 3 whirlwind
                        mpnowait
                else
                        say 你的利用價值已經沒有了。
                        c 3 powerball $b
                        mpnowait
                        mpdef_rembch null-tar
                        group leave
                        follow self
                        mpnowait
                endif
        else
                mpgoto 15450
                mpdef_rembch null-tar
        endif
endif
~
>greet_prog 100~
if is_qmark($i) == prehist_medusa_skill
or isaffected($n) & 1
or is_equ_obj($n) == 9357
        break
endif
if ispc($n)
        mpadd_qmark self prehist_medusa_skill 2 0 0 0 1 0
        tell $n 我的隨從，睡吧！看著我的眼，睡吧！
        c sleep $n
        mpnowait
        mpcallout 5 c 'star fire' $n
        mpcallout 5 tell $n 我的隨從，也是你該迎接死亡的時刻了。
endif
~
>fight_prog 100~
if is_equ_obj($i) == 15649
        if ispc($r)
                if rand(50)
                        if isaffected($r) !& 536870912
                                c 'demon tremor'
                                mpnowait
                                mpat 5 c double
                                mpnowait
                        else
                                c 2 whir
                                mpnowait
                                mpat 5 c 5 double
                                mpnowait
                        endif
                else
                        c 2 lifesteal $r
                        mpnowait
                endif
        endif
else
        wear medusa's
        disarm
        mpnowait
        mpgoto self
        hunt $r
        mpnowait
        c 2 'energy drain' $n
        mpnowait
endif
if rand(33)
        c 2 'chill touch' $n
        mpnowait
else
        if rand(50)
                c 2 fireball $n
                mpnowait
        else
                if insameroom(black-leopard)
                        if ispc($r)
                                say 豹兒，咬他！
                                mpforce black-leopard mpgoto self
                                mpforce black-leopard hunt $r
                                mpforce black-leopard skilldrv multihit $r
                        endif
                endif
        endif
endif
if being($b)
        if insameroom($b)
                echoaround $b [1;33m$I的眼睛發出一道光芒射向$B....[m
                echoat $b [1;33m$I的眼睛忽然對你射出一道光芒....[m
                mpforce $b group leave
                mpforce $b follow self
                mpgroup $b self 1 1
                mpforce $b protect medusa-prehist
                mptransfer $b
                c fireball $r
                mpnowait
        else
                if area($b) != prehistoria
                        mpdef_rembch null-tar
                else
                        echo [1;33m$I忽然開始喃喃念起咒語，接著眼睛發出一道光芒....[m
                        echo [1;33m$B忽然出現在這邊....[m
                        mpforce $b protect medusa-prehist
                        mptransfer $b
                        c fireball $r
                        mpnowait
                endif
        endif
else
        if isaffected($n) !& 1
                if is_equ_obj($n) != 9357
                        mpdef_rembch $n
                endif
        endif
endif
if ispc($r)
        if isaffected($r) & 1
                break
        endif
        if is_equ_obj($r) == 9357
                if rand(50)
                        mpechoat $r [1;33m你手上裝備的 蛇髮女之盾(medusa's shield) 擋住了$I的控制....[m
                        mpechoaround $r [1;33m $R手上裝備的 蛇髮女之盾(medusa's shield) 擋住了$I的控制....[m
                        break
                endif
        endif
        if class($r) == 5
                mpforcer here add_affect $r 'demon tremor' 0 5 2 -3 536870912
                mpdef_rembch $n
                mpgoto self
                mpforce $r kill $b
                if rand(33)
                        mpforce $r c 'magic missile' $b
                        mpecho [1;33m$R忽然不受控制地往$B施展魔法飛彈法術....[m
                else
                        if rand(50)
                                mpforce $r c 'star fire' $b
                                mpecho [1;33m$R忽然不受控制地往$B施展星星之火法術....[m
                        else
                                mpforce $r c powerball $b
                                mpecho [1;33m$R忽然不受控制地往$B施展能量球法術....[m
                        endif
                endif
                mpkill $r
                mpdef_rembch null-tar
        endif
        if class($r) == 6
                mpforcer here add_affect $r 'demon tremor' 0 5 2 -3 536870912
                mpdef_rembch $n
                mpgoto self
                mpforce $r kill $b
                if rand(33)
                        mpforce $r c 3 'magic missile' $b
                        mpecho [1;33m$R忽然不受控制地往$B施展魔法飛彈法術....[m
                else
                        if rand(50)
                                mpforce $r c 'lightning bolt' $b
                                mpecho [1;33m$R忽然不受控制地往$B施展宙斯之雷法術....[m
                        else
                                mpforce $r c 3 'fire breath' $b
                                mpecho [1;33m$R忽然不受控制地往$B施展龍之灼熱吐息法術....[m
                        endif
                endif
                mpkill $r
                mpdef_rembch null-tar
        endif
        if class($r) == 7
        or class($r) == 8
                mpforcer here add_affect $r 'demon tremor' 0 5 2 -3 536870912
                if hitprcnt($i) < 30
                        mpforce $r c 'full heal' $i
                        mpecho [1;33m$R忽然不受控制地往$I施展完全治癒法術....[m
                endif
                if isaffected($i) !& 128
                        mpforce $r c sanc $i
                        mpecho [1;33m$R忽然不受控制地往$I施展聖光術....[m
                endif
                if class($r) == 7
                        mpforce $r c 'gfull heal'
                        mpecho [1;33m$R忽然不受控制地隨便施展群體完全治癒法術....[m
                endif
        endif
        if class($r) == 9
                mpforcer here add_affect $r 'demon tremor' 0 5 2 -3 536870912
                mpdef_rembch $n
                mpgoto self
                mpforce $r kill $b
                mpforce $r circle
                mpecho [1;33m$R忽然不受控制地往$B施展繞刺技巧....[m
                mpkill $r
                mpdef_rembch null-tar
        endif
        if class($r) == 12
                mpforcer here add_affect $r 'demon tremor' 0 5 2 -3 536870912
                mpdef_rembch $n
                mpgoto self
                mpforce $r kill $b
                if rand(33)
                        mpforce $r perform emplash
                        mpecho [1;33m$R忽然不受控制地往$B施展霸皇劍....[m
                else
                        if rand(50)
                                mpforce $r flaming
                                mpecho [1;33m$R忽然不受控制地往$B施展烈焰斬....[m
                        else
                                mpforce $r storm
                                mpecho [1;33m$R忽然不受控制地往$B施展狂風斬....[m
                        endif
                        mpkill $r
                        mpdef_rembch null-tar
                endif
        endif
endif
