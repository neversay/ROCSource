>defun_prog prehist_kila_schedule_1~
if insameroom(xue-prehist)
        say 小雪，你爺爺在嗎？
        if mobcount(15630) > 0
                mpforce xue-prehist say 他在裡頭的房間，您可以進去找他。
                mpcallout 1 mpforce xue-prehist say 刀王，您太客氣了。
                mpcallout 1 say 好的，謝謝你，小雪。
                mpcallout 2 open e
                mpcallout 3 mpgoto 15613
                mpcallout 3 e
                mpcallout 4 mpforce ice-prehist say 刀王，您來啦，我這邊相當安全。
                mpcallout 4 say 您好啊！冰長老，我又來了。
                mpcallout 5 wave ice-prehist
                mpcallout 5 say 如果這樣我就放心了。
                mpcallout 6 mpgoto 15612
                mpcallout 6 w
                mpcallout 7 w
        else
                mpforce xue-prehist say 他現在不在魔刀村內，刀王您有事要找他嗎？
                mpcallout 1 say 沒什麼事情，想要找他聊一聊而已。
                mpcallout 2 say 最近店裡頭的生意怎麼樣？
                mpcallout 3 mpforce xue-prehist say 一切都還不錯，生活勉強過的去。
                mpcallout 4 mpfroce xue-prehist say 您別這麼說，刀王您言重了。
                mpcallout 4 say 冰長老他年紀也大了，往後的衣缽將會由你傳承下去了。
                mpcallout 5 mpforce xue-prehist say 那麼刀王您請慢走。
                mpcallout 5 say 好吧！如果長老不在的話，下次有機會我再來找他。
                mpcallout 6 wave xue-prehist
                mpcallout 7 w
        endif
endif
~
>defun_prog prehist_kila_schedule_2~
if insameroom(fire-prehist)
        say 火長老，今天在家啊？
        mpforce fire-prehist say 今天在啊！刀王又來巡視了。
        mpcallout 1 mpforce fire-prehist say 一切都還好，托您的福。
        mpcallout 1 say 最近對於一些火器研究進展還順利吧？
        mpcallout 2 mpforce fire-prehist say 刀王您言重了，一切都有賴您的領導啊！
        mpcallout 2 say 魔刀村有了您在火器方面的研究，才能夠一直安全藏在遠古森林中。
        mpcallout 3 mpforce fire-prehist say 那麼我不送了，刀王您慢走。
        mpcallout 3 say 我想我得繼續到其他地方看看了。
        mpcallout 4 wave fire-prehist
        mpcallout 5 open s
        mpcallout 6 s
        mpcallout 7 close n
else
        say 火長老，您今天在家嗎？
        mpcallout 1 say 看樣子他今天不在，下次再來找他好了。
        mpcallout 2 open s
        mpcallout 3 s
        mpcallout 4 close n
endif
~
>defun_prog prehist_kila_schedule_3~
if rand(50)
        say 去拜訪一下金長老好了，順便請教一下他的武器鑄造技術。
        open s
        s
        close n
        mpgoto 15629
        if insameroom(golden-prehist)
                mpcallout 1 mpforce golden-prehist say 刀王您好，又是新的一天的巡守工作了嗎？
                mpcallout 1 say 金長老在嗎？
                mpcallout 2 mpforce golden-prehist say 也是因為您這樣的認真，魔刀村才能夠在遠古森林中立足。
                mpcallout 2 say 是啊！不過為了魔刀村的安全，我想這是值得的。
                mpcallout 2 nod
                mpcallout 3 mpforce golden-prehist say 刀王快別這麼說，總不能讓那渾小子拿走刀王的頭銜吧！
                mpcallout 3 say 要沒有你們五大長老的支持，我想我是沒有辦法當上刀王的。
                mpcallout 3 blush
                mpcallout 4 mpforce golden-prehist comf kila-prehist
                mpcallout 4 say 那些都是不堪回首的往事了。
                mpcallout 4 sigh
                mpcallout 5 mpforce golden-prehist nod kila-prehist
                mpcallout 5 say 我想時間也差不多了，我該到其他地點去巡視了。
                mpcallout 5 sm
                mpcallout 6 say 長老您就留步吧！我自己走就好了。
                mpcallout 6 mpforce golden-prehist say 那麼老朽我就不送刀王您了。
                mpcallout 7 close s
                mpcallout 7 n
                mpcallout 7 open n
        else
                mpcallout 1 say 請問金長老在家嗎？
                mpcallout 2 ponder
                mpcallout 3 say 看樣子金長老今天不在家，下次再來找他好了。
                mpcallout 7 close s
                mpcallout 7 n
                mpcallout 7 open n
        endif
else
        say 今天去找風長老好了，也不知道他製作風箏的技巧是否又更純熟了。
        e
        open n
        n
        close s
        if insameroom(wind-prehist)
                mpcallout 1 mpforce wind-prehist say 原來是刀王駕臨啊！失敬失敬。
                mpcallout 1 say 請問一下，風長老在家嗎？
                mpcallout 2 mpforce wind-prehist say 老咯！不中用咯！倒是你現在正職黃金壯年。
                mpcallout 2 gig
                mpcallout 2 say 路過這邊，特地來看看長老最近的身體狀況。
                mpcallout 3 mpforce wind-prehist comf kila-prehist
                mpcallout 3 say 最近遠古森林中一連串的意外，讓晚輩我也感到有些力不從心。
                mpcallout 3 sigh
                mpcallout 4 mpforce wind-prehist say 真的嗎？難道「它」又要回來了？
                mpcallout 4 gasp wind-prehist
                mpcallout 4 mpforce wind-prehist say 迷霧之島最近的風向中，我嗅出了一股奇怪的味道。
                mpcallout 5 nod wind-prehist
                mpcallout 5 mpforce wind-prehist say 我不知道，但是我想「它」一定很不甘心。
                mpcallout 5 mpforce wind-prehist shake
                mpcallout 6 say 那麼刀王您慢走，至於風向的事情我會繼續調查的。
                mpcallout 6 mpforce wind-prehist nod kila-prehist
                mpcallout 6 say 我想我也該走了，我需要到土長老那裡看看。
                mpcallout 7 w
                mpcallout 7 close n
                mpcallout 7 s
                mpcallout 7 open s
        else
                mpcallout 1 say 請問風長老在家嗎？
                mpcallout 2 think
                mpcallout 3 say 難道風長老今天有事外出了？下次再來找他好了。
                mpcallout 7 w
                mpcallout 7 close n
                mpcallout 7 s
                mpcallout 7 open s
        endif
endif
~
>defun_prog prehist_kila_schedule_4~
if insameroom(mud-prehist)
        say 抱歉，請問土長老在不在家呢？
        mpforce mud-prehist sm kila-prehist
        mpforce mud-prehist say 當然在，刀王大駕光臨，有失遠迎，失敬失敬！
        mpcallout 1 mpforce mud-prehist say 如果不這樣，我怎能像現在般那麼的年輕美麗。
        mpcallout 1 mpforce mud-prehist laugh
        mpcallout 1 say 長老您果然是五位長老最愛開我玩笑的。
        mpcallout 2 mpforce mud-prehist sigh
        mpcallout 2 say 我希望五位魔刀村的長老都如你這邊永遠年輕健壯。
        mpcallout 2 sm
        mpcallout 3 mpforce mud-prehist say 不是的，我是擔心遠古森林中的對立勢力又有崛起的跡象。
        mpcallout 3 say 長老您也會有不開心的事嗎？
        mpcallout 3 ? mud-prehist
        mpcallout 4 mpforce mud-prehist say 「它」回來絕對不是件好事，不過....。
        mpcallout 4 say 我最近也曾聽風長老說過有關遠古森林風向開始改變的問題。
        mpcallout 4 agree mud-prehist
        mpcallout 5 mpforce mud-prehist say 沒錯，本村就是有著像你這種年輕人，才能夠欣欣向榮。
        mpcallout 5 mpforce mud-prehist good kila-prehist
        mpcallout 5 say 長老您放心，不管「它」是否會回來，魔刀村的安危都是我必須付出生命來保衛的。
        mpcallout 6 mpforce mud-prehist say 好吧！你去吧！
        mpcallout 6 mpforce mud-prehist nod kila-prehist
        mpcallout 6 say 我想長老我該去看看守衛村子安全的柵門是否安全。
        mpcallout 7 close n
        mpcallout 7 s
        mpcallout 7 open s
else
        say 請問一下，土長老在不在家呢？
        mpcallout 1 think
        mpcallout 2 say 看樣子是不在家，也許他出門去找陶藝的材料了。
        mpcallout 7 close n
        mpcallout 7 s
        mpcallout 7 open s
endif
~
>defun_prog prehist_kila_schedule_5~
if insameroom(yao-prehist)
        say 老婆，我回來了。
        mpforce yao-prehist say 老公您回來啦！今天真是辛苦您了。
        mpcallout 1 mpforce yao-prehist say 難道，村子中盛傳「它」要回來尋你的晦氣的事情是真的嗎？
        mpcallout 1 mpforce yao-prehist gasp kila-prehist
        mpcallout 1 say 我今天聽幾位長老提到了「它」的事情。
        mpcallout 2 mpforce yao-prehist say 「它」回來也不能夠改變些什麼，你已經成為刀王那麼久了。
        mpcallout 2 mpforce yao-prehist nod kila-prehist
        mpcallout 2 say 我不知道，但是為了村子裡大小村民著想，我不能讓「它」回到村子中。
        mpcallout 3 mpforce yao-prehist say 不管如何，如果「它」真的回來了，我拼死也要幫你全力阻止「它」。
        mpcallout 3 say 執念是很可怕的東西，長老說過「身無長物，何況於名」，但是「它」就是放不下。
        mpcallout 3 sigh
        mpcallout 4 mpforce yao-prehist say 我還不累，你先睡吧！
        mpcallout 4 say 今天也累了，我們睡吧！
        mpcallout 4 sm yao-prehist
        mpcallout 5 nod yao-prehist
        mpcallout 6 sleep
else
        say 老婆，我回來了。
        mpcallout 1 ?
        mpcallout 2 say 老婆似乎有事出去了。
        mpcallout 3 say 算了，我想她應該能夠自行應付一些危險狀況才是。
        mpcallout 4 say 只要不要遇上「它」的話....。
        mpcallout 5 say 先睡吧！
endif
