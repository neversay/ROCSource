>talk_prog p better arrow~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100512
or is_qmark($i) == prehist_talkiing
        break
endif
if is_qmark($n) == prehist_wuu_quest 100001
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpmod_qmark $n prehist_wuu_quest v0 = 2
        mpforce $n say 我可以幫您到其他地方找更好的箭支回來。
        say 真的嗎....？
        mpcallout 1 say 那真是太好了....，
        mpcallout 2 say 最近魔刀村的事情比較多....，
        mpcallout 3 say 要離開遠古森林去找更好的箭支有點困難....，
        mpcallout 4 say 因此你們肯幫忙當然是最好了....，
        mpcallout 5 say 那麼找到的新的箭支....，
        mpcallout 6 say 就麻煩您帶回來給我....，
        mpcallout 7 say 當然箭支夠好的話....，
        mpcallout 8 say 酬勞也會更加豐厚的。
        mpcallout 8 wave $n
        mpcallout 8 mpdel_qmark self prehist_talking
endif
