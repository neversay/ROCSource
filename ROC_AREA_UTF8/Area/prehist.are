>obj_command compose hook~
if is_inv_obj($n) == 5703
	echoat $n 你將 鐵鉤(iron hook) 與 繩索(rope) 結合為 繩鉤(rope hook) 了！
	echoaround $n $n 將 鐵鉤(iron hook) 與 繩索(rope) 結合為 繩鉤(rope hook)。
	opforcer here oload 5704 1 target
	purge $n hook1-firetop
	purge self
else
	echoat 你身上並沒有 鐵鉤(rook) 這項東西。
endif
~
|
