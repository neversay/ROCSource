>talk_prog topic~
if is_qmark($i) == prehist_talking
        break
endif
say 您好，我是魔刀村的金長老，請問有什麼事嗎？
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) == prehist_xue_quest 100001
        mpechoat $n -- ‧請問一下您都是用什麼招數取悅(please)其他人們的？
endif
if is_qmark($n) == prehist_pii_quest 100003
        mpechoat $n -- ‧聽說長老您的孫子小痞希望您能夠為他打造一把專屬的刀(pii's owned knife)。
endif
if is_qmark($n) == prehist_pii_quest 100006
        mpechoat $n -- ‧長老，我將小痞帶來了，他願意接受您的教導(accept your teaching)。
endif
if is_qmark($n) == prehist_pii_quest 100010
        mpechoat $n -- ‧長老，我想我已經完成了你交代的事情(finished your job)了。
endif
if is_qmark($n) == prehist_pii_quest 100024
        mpechoat $n -- ‧長老，小痞已經順利地通過了藍老師的第一關(passed test 1)。
endif
if is_qmark($n) & prehist_quest 208192
        if is_qmark($n) !& prehist_quest 216384
                mpechoat $n -- ‧長老，雷領事叫我來問你有關晶玉寶石(crystal jade)的事情。
        else
                mpechoat $n -- ‧長老，我想請您幫我改造(remold)裝備。
        endif
endif
~
>talk_prog remold~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
or is_qmark($n) !& prehist_quest 216384
	break
endif
mpforce $n say 長老，我想請您幫我改造裝備。
say 請先將白玉材質的裝備拿給我。
