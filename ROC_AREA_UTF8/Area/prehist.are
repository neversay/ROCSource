if roomvalue($0) == 0
        modrvt v0 = 1
        modrvt timer = 48
        callout 2 echoat $n 你發現了一個玻璃製的容器(container)....
        callout 2 echoaround $n $n 發現了一個玻璃製的容器(container)....
        callout 2 oload 15631 viclv $n floor
        break
endif
if roomvalue($0) == 1
        callout 2 echoat $n 你並沒有發現什麼特別的東西。
        callout 2 echoaround $n $n 並沒有發現什麼特別的東西。
endif
