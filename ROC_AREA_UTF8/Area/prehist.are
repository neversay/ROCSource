                        or is_qmark($b) == prehist_pii_quest 100022
                                mpmod_qmark $b prehist_pii_quest v0 = 23
                                mpmod_qmark self prehist_pii_quest v0 = 9
                                yell 哇！我成功擊敗人偶了！
                                dance $n
                                say 我們去找 藍 老師告訴他這個好消息吧。
                                mpgroup $b self 1 0
                        endif
                else
                        mpat $b mpmod_qmark $b prehist_pii_quest v0 = 13
                        mpat $b mpadd_qmark $b prehist_pii_waiting 72 0 0 0 0 1
                        tell $b 你竟然不在我身邊！
                        mppurge self
                endif
        else
                sigh
                mppurge self
        endif
endif
~
>rand_prog 50~
if is_qmark($i) != prehist_pii-quest_life
        if being($b)
                tell $b 任務週期已到。
        endif
        mppurge self
endif
~
>talk_prog p are you ready~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_pii_quest
        break
endif
if is_qmark($n) == prehist_pii_quest 100014
        mpmod_qmark $n prehist_pii_quest v0 = 15
        mpforce $n say 小痞你準備好了嗎(are you ready)？我們要出發去找 藍(Lan) 老師學習刀技了。
        dance $n
        say 那麼我們一起出發吧！
        mpdef_rembch $n
        mpgroup $b self 1 0
        mpadd_qmark self prehist_pii_quest 12 0 0 0 1 0
endif
~
>talk_prog p skill up~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
        break
endif
if rembch($n)
        if is_qmark($n) == prehist_pii_quest 100019
                if is_qmark($i) == prehist_pii_quest 100005
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpmod_qmark self prehist_pii_quest v0 = 6
                        mpmod_qmark $n prehist_pii_quest v0 = 20
                        mpmod_qmark self prehist_pii_quest v1 | 1
                        mpmod_qmark $n prehist_pii_quest v2 | 1
                        mpforce $n say 小痞，你太執著於攻擊，應該多利用一些身體的技巧(body skills)。
                        nod $n
                        mpcallout 1 say 是這樣嗎....？
                        mpcallout 2 say 那麼我在接下來的戰鬥中會多用一些身體的技巧的。
                        mpcallout 3 mpcall prehist_pii2_test1 $n
                endif
        endif
endif
~
>talk_prog p speed up~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
        break
endif
if rembch($n)
        if is_qmark($n) == prehist_pii_quest 100019
                if is_qmark($i) == prehist_pii_quest 100005
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpmod_qmark self prehist_pii_quest v0 = 6
                        mpmod_qmark $n prehist_pii_quest v0 = 20
                        mpmod_qmark self prehist_pii_quest v1 | 2
                        mpmod_qmark $n prehist_pii_quest v2 | 2
                        mpforce $n say 小痞，你的攻擊速度太慢，可以嘗試在揮刀時更快一點(speed up)。
                        nod $n
                        mpcallout 1 say 是這樣嗎....？
                        mpcallout 2 say 那麼我在接下來的戰鬥中我會讓揮刀速度更快一點。
                        mpcallout 3 mpcall prehist_pii2_test1 $n
                endif
        endif
endif
~
>talk_prog p power up~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100004
        break
endif
if rembch($n)
        if is_qmark($n) == prehist_pii_quest 100021
                if is_qmark($i) == prehist_pii_quest 100007
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpmod_qmark self prehist_pii_quest v0 = 8
                        mpmod_qmark $n prehist_pii_quest v0 = 22
                        mpmod_qmark self prehist_pii_quest v1 | 4
                        mpmod_qmark $n prehist_pii_quest v2 | 4
                        mpforce $n say 小痞，你揮刀的力道太弱，需要在腕力上加強(power up)。
                        nod $n
                        mpat 5 remove all
                        mpat 5 mpjunk all.knife
                        mpat 5 mpoload 15440
                        mpat 5 wear knife
                        mpcallout 1 say $b 您說的沒錯....。
                        mpcallout 2 say 那麼我在接下來的戰鬥中我會多用些腕力到刀身上頭。
                        mpcallout 3 mpcall prehist_pii2_test1 $n
                endif
        endif
