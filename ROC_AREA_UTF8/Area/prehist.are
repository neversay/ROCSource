>talk_prog ill-temper~
if is_qmark($n) !& prehist_quest 200004
or is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_xue_quest
        break
endif
mpadd_qmark self prehist_talking 5 0 0 0 1 0
force $n say 我聽村民說過最近冰長老脾氣不太好是嗎(ill-temper)？
if resp($n) < 10
        angry $n
        mpcallout 1 say 我很抱歉對一個外來的客人這樣說話....，
        mpcallout 2 say 但是你會不會覺得你管得太多了？
        mpcallout 2 mpdel_qmark self prehist_talking
else
        sigh
        say 爺爺其實他是覺得用他的法力來製冰很無趣....，
        mpcallout 1 say 加上最近魔刀村又比以往還要安寧....，
        mpcallout 2 say 因此多少讓他脾氣變得有點暴躁了起來....，
        mpcallout 3 say 我曾經想過讓他在製冰的時候能夠有些消遣....，
        mpcallout 4 say 但是卻不知道爺爺需要些什麼....？
        mpcallout 4 shrug
        mpcallout 5 say 請問你願意幫幫我解決這個問題嗎(yes/no)？
        mpcallout 5 mpadd_qmark $n prehist_xue_quest -1 0 0 0 0 1
        mpcallout 5 mpdel_qmark self prehist_talking
endif
~
