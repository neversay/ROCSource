>give_prog 40008~
if is_qmark($n) == prehist_wuu_quest 100002
        if is_qmark($n) !& prehist_wuu_quest 200128
                mpjunk voice
                mpmod_qmark $n prehist_wuu_quest v1 | 128
                nod $n
                say 我收到你的清音了。
                mpexp $n 7000
        else
                drop voice
                say 你曾經給過我這捆箭了。
        endif
else
        drop voice
        say 你給我這個東西做什麼？
endif
