        echoat $n [1;31m你被如利刀般水流給割傷了....[m
        echoaround $n [1;31m $n 被如利刀般水流給割得傷痕累累....[m
        modhmv $n 03 100 150 0
        break
endif
if rand(33)
        echoat $n [1;33m你被強勁的水流給捲到池塘其他地方了....[m
        echoround $n [1;33m $n 被強勁的水流給捲走了....[m
        if rand(20)
                transfer $n 15477
                if rand(50)
                        echoat $n [1;31m當你被捲到這裡，忽然出現了一隻巨型的蠕蟲向你攻擊！[m
                        at 15477 mload 15436
                        at 15477 force worm-prehist hunt $n
                endif
                break
        endif
        if rand(25)
