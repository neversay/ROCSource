>defun_prog prehist_rook_reward~
mpmod_qmark $b prehist_rook_quest v0 = 5
mpadd_qmark self prehist_talking 5 0 0 0 1 0
say 我的房子已經完成了，總算有個可以安居的地方....，
mpcallout 1 say 我要好好地謝謝你曾經幫助過我的事情....，
mpcallout 1 mpcall prehist_rook_reward_1 $b
mpcallout 2 say 那麼根據我們先前的約定，這是我給你另外的獎賞....，
if is_qmark($b) & prehist_rook_quest 200001
	mpcallout 3 mpskillexp $b 2000
else
	mpcallout 3 mpgold $b 500000
endif
mpcallout 3 mpdel_qmark $b prehist_rook_quest
mpcallout 3 mpmod_qmark $b prehist_quest v0 | 8
mpcallout 4 say 謝謝你的幫忙，再見了。
mpcallout 4 mpdel_qmark self prehist_talking
mpcallout 4 mpdef_rembch null-tar
mpcallout 4 mpdel_qmark self prehist_rook_building
mpcallout 4 mpmod_qmark self prehist_rook_quest timer = 240
~
>defun_prog prehist_rook_reward_1~
if is_qmark($b) & prehist_rook_quest 300001
	say $b 你幫我解決了建築定位方面的困擾。
	mpskillexp $b 1500
endif
if is_qmark($b) & prehist_rook_quest 300002
	say $b 也解決了牆體連結的問題。
	mpskillexp $b 1500
endif
if is_qmark($b) & prehist_rook_quest 300004
	say $b 更幫我拿來的水平儀，幫助我平面定平。
	mpskillexp $b 1500
endif
if is_qmark($b) & prehist_rook_quest 300008
	say 最後，$b 你幫我完成了防水工程。
	mpskillexp $b 1500
endif
~
>talk_prog p what can i do now~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100002
        mpmod_qmark $n prehist_rook_quest v0 = 3
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        if is_qmark($n) & prehist_rook_quest 200001
                mpforce $n say 先別說報酬了，那麼我現在應該怎麼做(what can I do now)？
                sm $n
                mpcallout 1 say 你真是一個好心的冒險者....，
        endif
        if is_qmark($n) & prehist_rook_quest 200002
                好， 50萬 金幣可以接受，那麼我現在該做些什麼(what can I do now)？
                nod $n
                mpcallout 1 say 50 萬金幣也是我的極限了....，
        endif
        mpcallout 2 say 那麼我就開始說了，請記清楚....，
        mpcallout 3 say 首先你必須蒐集能夠幫助我重建的材料....，
        mpcallout 4 say 我聽說在盜賊要塞山上有質地相當不錯的木材(wood)....，
        mpcallout 5 say 而在遠古森林的池塘邊也有可供作建材的鵝卵石(pebble)。
        mpcallout 5 mpdel_qmark self prehist_talking
endif
~
>talk_prog wood~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100003
        say 盜賊要塞在迷霧之島北邊的高山上，
        say 聽說長有一些奇形怪狀的樹，
        say 但是質地卻非常的堅韌，適合拿來做建材，
        say 請多拿一點來給我。
endif
~
>talk_prog pebble~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100003
        say 在遠古森林中池塘裡頭的鵝卵石粒徑大小恰好，
        say 拿來當作牆壁的粒材最好了，
        say 不過那邊有一點危險，可要小心才行。
        say 就請多拿一點來給我吧。
endif
~
>talk_prog p are you kidding~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100002
        if is_qmark($n) & prehist_rook_quest 200002
                mpforce $n say 才 50 萬金幣，你別開玩笑了(are you kiding)，我不願意幫你。
                mpmod_qmark $n prehist_rook_quest v0 = 0
                mpmod_qmark $n prehist_rook_quest v1 = 0
                mpmod_qmark $n prehist_rook_quest timer = 72
                say 不要就拉倒，最近也最好都不要出現在這裡。
                wave $n
        endif
endif
~
>talk_prog p fix compulsarily~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100001
        mpforce $n say 您別生氣，我可以義務幫您修理房子，只要您願意(fix compulsarily)。
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpmod_qmark $n prehist_rook_quest v0 = 2
        mpmod_qmark $n prehist_rook_quest v1 | 1
        gasp
        mpcallout 1 say 真的嗎？如果你願意幫忙當然最好....，
        mpcallout 2 say 不過先別說什麼義務不義務的....，
        mpcallout 3 say 你有這樣的心....，
        mpcallout 4 say 若能夠幫上忙，我當然會重重酬謝你的。
        mpcallout 4 mpdel_qmark self prehist_talking
endif
~
>talk_prog p fix costly~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100008
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) == prehist_rook_quest 100001
        mpforce $n say 別生氣，我可以幫你修理房子，只要你願意付出一些代價(fix costly)。
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpmod_qmark $n prehist_rook_quest v0 = 2
        mpmod_qmark $n prehist_rook_quest v1 | 2
        ponder $n
        say 我頂多付你 50萬 金幣當作酬勞....，
        mpcallout 1 say 再多就不行了....，
        mpcallout 2 say 如果你不能接受就拉倒....，
        mpcallout 3 say 我可以拿這些錢雇用更多的人。
        mpcallout 3 mpdel_qmark self prehist_talking
endif
~
>talk_prog broken~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehsit_quest 100008
or is_qmark($n) == prehist_rook_quest
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
if is_qmark($n) & prehist_quest 200032
        mpforce $n say 你好，路克，聽說你的房子壞掉(broken)了是嗎？
        if inroom($i) == 15598
                kick $n
                say 你白癡啊！不只壞掉，還整個毀掉了，
                say 你是來消遣我的，是嗎？快滾！
                break
        endif
        if inroom($i) == 15631
                nod $n
                say 沒錯，我的房子壞了，而我正忙著修理這棟房子，
                say 因此，如果沒有什麼重要的事情，請你離開好嗎？
                mpadd_qmark $n prehist_rook_quest -1 1 0 0 0 1
                break
        endif
        if inroom($i) == 15588
                sm $n
                if being($b)
                        say 雖然是壞掉了，但是由於 $b 的幫忙我又開始重建了，
                        if insameroom($b)
                                thank $b
                        else
                                say 不過他現在人不在這邊，也不知道去哪了。
                        endif
                endif
        endif
endif
~
