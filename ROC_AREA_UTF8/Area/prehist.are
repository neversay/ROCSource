#15431
adventurer-prehist lost adventurer~
迷途冒險者(lost adventurer)~
一位在遠古森林迷途已久的冒險者(lost adventurer)心驚膽戰地站在這邊。
~
他在一次的戰役中失去了他所有伙伴，因此僅能夠孤獨地躲在遠古森林中避免被遠古森林
兇惡的生物給吃掉。
~
1|2|64|67108864 8|32|512|8192 0 S
42 3000 0 0d0+0 0d0+0
0 0
0 8 1
P 1|4|8
S 16 -1000
S 41 70
>entry_prog 100~
if is_qmark($i) == prehist_adventurer_quest 100001
or is_qmark($i) == prehist_adventurer_quest 100002
        if inroom($i) == 15464
                if is_qmark($i) == prehist_adventurer_quest 100001
                        yell 救命啊！好恐怖啊！
                        mpecho $I受到莫名的驚嚇，忽然離開了隊伍往北邊跑了過去....
                        mpgoto 15419
                        mpmod_qmark self prehist_adventurer_quest v0 = 2
                endif
                break
        endif
        if inroom($i) == 15461
                mpmod_qmark self prehist_adventurer_quest v0 = 3
                mpmod_qmark self prehist_adventurer_quest timer = 72
                mpmod_qmark $b prehist_adventurer_quest v0 = 2
                mpmod_qmark $b prehist_adventurer_quest v1 | 1
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                thank $b
                say 啊！終於走出遠古森林了....，
                mpcallout 1 say 重見天日的感覺真好....。
                mpcallout 2 say 不過....，
                mpcallout 3 grin
                mpcallout 4 sm $b
                mpcallout 5 say $b ，我很感謝你的幫忙....，
                mpcallout 6 say 因此有個好差事需要你一起幫忙....，
                mpcallout 7 say 當然....，那需要花費你一些時間....，
                mpcallout 8 say 而且，會有一點危險....，
                mpcallout 9 say 不知道....你....有沒有興趣呢(yes/no)？
                mpcallout 9 mpdel_qmark self prehist_talkiing
                break
        endif
        if insameroom(dog-prehist)
                if rand(50)
                        mpforce dog-prehist hunt adventurer-prehist
                else
                        if insameroom($b)
                                mpforce dog-prehist hunt $b
                        endif
                endif
                break
        endif
        if insameroom(wandering)
                if rand(50)
                        mpforce wandering hunt adventurer-prehist
                else
                        if insameroom($b)
                                mpforce wandering hunt $b
                        endif
                endif
                break
        endif
        if insameroom(buzzard)
                if rand(50)
                        mpforce buzzard hunt adventurer-prehist
                else
                        if insameroom($b)
                                mpforce buzzard hunt $b
                        endif
                endif
        endif
        break
endif
if inroom($i) == 4634
        if is_qmark($i) == prehist_adventurer_quest 100004
                mpmod_qmark self prehist_adventurer_quest v0 = 5
                mpmod_qmark self prehist_adventurer_quest timer + 10
                mpmod_qmark $b prehist_adventurer_quest v0 = 4
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                hop
                say 啊！就是這邊，我記得就是這邊....，
                mpcallout 1 say 幫忙挖一下吧....挖....？
                mpcallout 1 five $b
                mpcallout 2 think
                mpcallout 3 say 我們好像忘了攜帶挖土的鏟子(shovel)了....，
                mpcallout 4 say 我記得我挖得相當深....，
                mpcallout 5 say 不用鏟子可能沒有辦法挖得到....，
                mpcallout 6 say 而且要使用光明之鎮所製造的黃金鏟子(golden shovel)....，
                mpcallout 7 say 主要是因為我在那些寶藏上頭....，
                mpcallout 8 say 放了一些法術....，
                mpcallout 9 say 一般的鏟子還沒挖到就會斷掉了....，
                mpcallout 10 say 如果沒有黃金鏟子(golden shovel)....，
                mpcallout 11 say 我們最好能夠去搞個一支來....，
                mpcallout 12 say 我身上的那一支好像被野獸追的時候....，
                mpcallout 13 say 臨時放在遠古森林某個洞穴裡頭的....，
                mpcallout 14 say 要不然只好去問問光明之鎮的武器店老闆有沒有了。
                mpcallout 14 mpdel_qmark self prehist_talking
                break
        endif
        if is_qmark($i) == prehist_adventurer_quest 100005
                if is_equ_obj($i) == 15452
                        mpcall prehist_adventurer_digging $b
                endif
        endif
        break
endif
if inroom($i) == 4569
        if is_qmark($i) == prehist_adventurer_quest 100006
                mpmod_qmark self prehist_adventurer_quest v0 = 7
                mpmod_qmark $b prehist_adventurer_quest v0 = 6
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                sm
                say 我找一下這個寶箱的鑰匙....
                mpcallout 1 mpecho $I開始在休息室中翻箱倒櫃、四處搜查....
                mpcallout 2 say 奇怪，我到底將鑰匙放到那邊去了....？
                mpcallout 3 ponder
                mpcallout 5 say 耶！找到了....！
                mpcallout 6 mpecho $I由休息室的地毯下搜出了一把亮晶晶的鑰匙(shining key)....
                mpcallout 6 mpoload 15457
                mpcallout 7 say 這可讓我找到了，梅杜莎主公一定....
                mpcallout 8 cac
                mpcallout 9 mpecho $I 的表情似乎有點得意忘形....
                mpcallout 10 say 呃....啊.... $B，你....，喔！我有點獎賞給你....，
                mpcallout 11 mpcall prehist_adventurer_reward $b
                mpcallout 12 say 啊....，那麼....，有機會再見吧！
                mpcallout 13 mpcall prehist_adventurer_leave $b
        endif
        break
endif
mpcall prehist_adventurer_underattack
~
>defun_prog prehist_adventurer_leave~
mpecho $I急急忙忙地離開了此處。
group leave
follow self
mpgoto 15449
mpoload 15459 38
unlock chest4-prehist
open chest4-prehist
put axe1-prehist chest4-prehist
close chest4-prehist
lock chest4-prehist
~
>defun_prog prehist_adventurer_reward~
mpgold $b 200000
mpexp $b 5000
mpskillexp $b 2000
mpmod_qmark self prehist_adventurer_quest v0 = 8
mpmod_qmark self prehist_adventurer_quest timer = -1
mpdel_qmark $b prehist_adventurer_quest
if is_qmark($b) != prehist_quest
        mpadd_qmark $b prehist_quest -1 32 0 0 0 1
else
        if is_qmark($b) !& prehist_quest 100032
                mpmod_qmark $b prehist_quest v0 | 32
        endif
endif
~
>greet_prog 100~
mpcall prehist_adventurer_underattack
~
>give_prog 15452~
if rembch($n)
        if is_equ_obj($i) != 15452
                say 哇！黃金鏟子，真是太好了。
                wear shovel-prehist
        else
                say 我身上已經裝備有一支了。
                drop shovel-prehist
        endif
        if inroom($i) == 4634
                if is_qmark($i) == prehist_adventurer_quest 100005
                        mpcall prehist_adventurer_digging $b
                endif
        endif
else
        ? $n
        say 你給我這支鏟子做什麼？
        drop shovel-prehist
endif
~
>defun_prog prehist_adventurer_digging~
mpmod_qmark self prehist_adventurer_quest v0 = 6
mpmod_qmark $b prehist_adventurer_quest v0 = 5
mpadd_qmark self prehist_talking 5 0 0 0 1 0
mpecho $I拿起手上的鏟子，開始在這邊認真地鏟了起來....
mpcallout 1 mpecho 喀拉....
mpcallout 3 mpecho 喀拉....喀拉....
mpcallout 5 mpecho 喀拉....喀拉....喀拉....
mpcallout 7 mpecho 喀拉....喀拉....喀拉....喀拉....
mpcallout 7 mpoload 15453 $b viclv floor
mpcallout 8 mpecho $I露出了興奮的表情....
mpcallout 9 say 啊！哈！我終於又找到你了....
mpcallout 9 mpoload 15454 99 floor
mpcallout 10 mpoload 15456
mpcallout 10 mpecho $I拿起 鐵製寶箱(ironed chest)
mpcallout 11 sm $b
mpcallout 12 say 我們一起到光明之鎮旅館中的高級休息室....，
mpcallout 13 say 我將這個寶箱的鑰匙藏在裡頭....，
mpcallout 14 say 我們快去拿吧！
~
>defun_prog prehist_adventurer_underattack~
if insameroom(spinosaurus)
        if isaffected($i) & 2
                say 哇！棘龍，好恐怖！
                mpecho 由於$I的驚慌失措，恐龍發現了$I的存在....
                vis
        endif
        mpforce spinosaurus hunt adventurer-prehist
        break
endif
if insameroom(tyrannosaurus)
        if isaffected($i) & 2
                say 哇！霸王龍，好恐怖！
                mpecho 由於$I的驚慌失措，恐龍發現了$I的存在....
                vis
        endif
        mpforce tyrannosaurus hunt adventurer-prehist
        break
endif
if insameroom(torosaurus)
        if isaffected($i) & 2
                say 哇！三犄龍，好恐怖！
                mpecho 由於$I的驚慌失措，恐龍發現了$I的存在....
                vis
        endif
        mpforce torosaurus hunt adventurer-prehist
        break
endif
if insameroom(pteranodon)
        if isaffected($i) & 2
                say 哇！翼手龍，好恐怖！
                mpecho 由於$I的驚慌失措，恐龍發現了$I的存在....
                vis
        endif
        mpforce pteranodon hunt adventurer-prehist
        break
endif
if insameroom(stegosaurus)
        if isaffected($i) & 2
                say 哇！劍龍，好恐怖！
                mpecho 由於$I的驚慌失措，恐龍發現了$I的存在....
                vis
        endif
        mpforce stegosaurus hunt adventurer-prehist
endif
~
>talk_prog topic~
if is_qmark($n) == prehist_adventurer_quest 100000
        say 你這個任務失敗的沒用傢伙！
        break
endif
if is_qmark($i) == prehist_talking
or is_qmark($n) & prehist_quest 100032
        break
endif
if rembch($n)
        if is_qmark($i) <= prehist_adventurer_quest 100002
                say $B你趕緊帶我走出遠古森林吧！
        endif
        if is_qmark($i) == prehist_adventurer_quest 100004
                say $B我們趕緊一起到迷霧大平原北邊找東西去吧。
        endif
else
        if being($b)
                say 希望$B能夠趕緊帶我走出遠古森林。
        endif
endif
~
>talk_prog restart~
if is_qmark($i) == prehist_talking
or is_qmark($n) & prehist_quest 100032
        break
endif
if is_qmark($n) == prehist_adventurer_quest 100000
        say 你這個任務失敗的沒用傢伙！
        break
endif
if is_qmark($i) >= prehist_adventurer_quest 100001
        if being($b)
                if rembch($n)
                        say 進行任務中無法取消任務，
                        say 你可以直接退出遊戲達到同樣方式，
                else
                        say 抱歉，我目前正在跟$B進行任務。
                endif
        endif
        break
endif
if is_qmark($n) <= prehist_adventurer_quest 100006
        mpdel_qmark $n prehist_adventurer_quest
        mpechoat $n 遠方傳來一陣聲響「本項任務你已經可以重解！」
endif
~
>talk_prog no~
if is_qmark($n) == prehist_adventurer_quest 100000
        say 你這個任務失敗的沒用傢伙！
        break
endif
if is_qmark($i) == prehist_talking
or is_qmark($n) & prehist_quest 100032
        break
endif
if is_qmark($n) == prehist_adventurer_quest 100002
        if rembch($n)
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                mpdel_qmark $n prehist_adventurer_quest
                mpmod_qmark $n prehist_quest v0 | 32
                shrug
                say 好吧，既然如此....，
                mpcallout 1 say 那麼接下來的事情我只好另尋高明....，
                mpcallout 2 say 至於你把我帶出遠古森林的獎賞....，
                mpcallout 3 mpskillexp $n 1500
                mpcallout 3 mpexp $n 5000
                mpcallout 4 wave $n
                mpcallout 4 say 希望往後的日子我們還能再見。
                mpcallout 5 mppurge self
                mpcallout 5 mpecho $I 轉身離開了你的視線....
        endif
endif
~
>talk_prog yes~
if isfight($i)
or is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_adventurer_quest
or is_qmark($n) & prehist_quest 100032
        if is_qmark($n) == prehist_adventurer_quest 100002
                if rembch($n)
                        mpmod_qmark self prehist_adventurer_quest v0 = 4
                        mpmod_qmark $n prehist_adventurer_quest v0 = 3
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        good $b
                        say 其實是這樣的....，
                        mpcallout 1 say 我埋了一點東西在迷霧大平原....，
                        mpcallout 2 say 至於在那邊有些忘記了，好像是在北邊....？
                        mpcallout 3 say 裡頭....藏了一點小秘密....，
                        mpcallout 4 say 我們還不熟....，
                        mpcallout 5 say 不過到時候你就會知道....，
                        mpcallout 6 say 那是怎麼樣的一個東西....，
                        mpcallout 7 say 放心，我絕對不會虧待你的....，
                        mpcallout 7 mpechoat $n $I拍了拍你的肩膀....
                        mpcallout 8 mpechoaround $n $I拍了拍$N的肩膀....
                        mpcallout 9 say 我們一起出發去迷霧大平原吧。
                        mpcallout 9 mpdel_qmark self prehist_talking
                endif
        endif
        break
endif
if is_qmark($i) == prehist_adventurer_quest 100000
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        gasp $n
        say 真的嗎？其實我已經躲在這邊很久了....，
        mpcallout 1 say 我的隊伍幾乎都被遠古森林中的生物給吃光了....，
        mpcallout 2 say 只剩下我躲在森林中躲了好幾天....，
        mpcallout 3 say 拜託你帶我先離開遠古森林再說吧！
        mpcallout 3 mpdel_qmark self prehist_talking
        mpcallout 3 mpgroup $n self 1 0
        mpcallout 3 mpdef_rembch $n
        mpcallout 3 mpmod_qmark self prehist_adventurer_quest v0 = 1
        mpcallout 3 mpmod_qmark self prehist_adventurer_quest timer = 24
        mpcallout 3 mpcall prehist_adventurer_quest $n
endif
~
>defun_prog prehist_adventurer_quest~
if is_qmark($n) != prehist_quest
        mpadd_qmark $n prehist_quest -1 0 0 0 0 1
endif
if is_qmark($n) != prehist_adventurer_quest
        mpadd_qmark $n prehist_adventurer_quest -1 1 0 0 0 1
endif
~
>rand_prog 50~
if being($b)
        if is_qmark($i) == prehist_adventurer_quest
                if insameroom($b)
                else
                        if is_qmark($i) > prehist_adventurer_quest 1005
                                mpmod_qmark self prehist_adventurer_quest timer - 5
                        endif
                endif
        else
                if is_qmark($b) == prehist_adventurer_quest 100001
                        tell $b 你實在不是一位好的冒險者，
                        tell $b 過了那麼久竟然還無法走出遠古森林！
                        tell $b 我看我還是另求他人好了。
                        mpat $b mpmod_qmark $b prehist_adventurer_quest v0 = 0
                        mpat $b mpmod_qmark $b prehist_adventurer_quest timer = 120
                        mppurge self
                endif
        endif
else
        if is_qmark($i) >= prehist_adventurer_quest 100001
                sigh
                say 又是一個未解完任務就離開遊戲的人。
                shrug
                mppurge self
        else
                if is_qmark($i) == prehist_talking
                or is_qmark($i) == prehist_adventurer_quest
                        break
                endif
                if ispc($r)
                        if is_qmark($r) & prehist_quest 100032
                                break
                        endif
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpechoat $r $I見到了你，連忙向你走了過來....
                        mpechoaround $r $I見到了$R，向$R的方向走了過去....
                        mpcallout 1 say 太好了，我終於見到人類了....，
                        mpcallout 2 mpecho $I的表情似乎充滿了驚恐....
                        mpcallout 3 say 我已經在遠古森林迷路好久了....，
                        mpcallout 4 say 不知道您是否能夠帶我出去？(yes/no)
                        mpcallout 4 mpadd_qmark self prehist_adventurer_quest -1 0 0 0 1 0
                        mpcallout 5 mpecho [1;33m$I 話沒說完，忽然樹林中蹦出一隻狂暴犬(wild dog)向$I撲了過去....[m
                        mpcallout 5 mpmload 15402
                        mpcallout 6 mpforce dog-prehist hunt adventurer-prehist
                        mpcallout 6 yell 哇！救救我呀！
                        mpcallout 6 mpdel_qmark self prehist_talking
                endif
        endif
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if vnum($n) == 15402
        mpecho [1;33m狂暴犬(wild dog)當場就把$I咬得肚破腸流....[m
        mpecho [1;33m現場立即聚集了不少兇殘的動物，開始大嚼$I的肉骨....[m
        mpmload 15402
        mpmload 15414
        mpoload 15406 30 floor
        mppurge self
endif
~
