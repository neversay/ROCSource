>greet_prog 100~
if is_qmark($n) == prehist_enemy
        yell 大膽狂徒，竟然還膽敢進入魔刀村！
        hunt $n
        mpnowait
endif
~
>repop_prog 100~
mpadd_qmark self delayed_cast -1 99999 0 0 1 0
~
>talk_prog topic~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
if is_qmark($n) == prehist_xue_quest 100004
        say 又是你這個討厭的傢伙，不要來煩我，快滾！
        break
endif
if is_qmark($i) == prehist_xue_quest
        say 您好，我是魔刀村的冰長老，有事嗎？
else
        say 我是魔刀村的冰長老，我正在忙，有事快說，有屁快放！
endif
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) == prehist_xue_quest 100002
        mpechoat $n -- ‧冰長老您好，您的孫女小雪請我來這邊陪你解悶(find distraction from boredom)。
endif
if is_qmark($n) == prehist_quest 200001
        mpechoat $n -- ‧請問一下有關「幻魔高塔(Phantom Tower)」的事情。
endif
if is_qmark($n) & prehist_quest 200002
        mpechoat $n -- ‧請問一下「梅杜莎(Medusa)」是什麼樣的一種生物？
endif
if is_qmark($n) & prehist_quest 100002
        if is_qmark($n) !& prehist_quest 100128
                if is_qmark($n) != prehist_ice_quest
                        mpechoat $n -- ‧請問一下北邊的房間為何禁止通行(no pass)？
                endif
                if is_qmark($n) == prehist_ice_quest 100000
                        mpechoat $n -- ‧我可以幫忙冰長老您清除(clear those ices)那些冰塊。
                endif
                if is_qmark($n) == prehist_ice_quest 100001
                        if mobcount(15650) == 0
                                mpechoat $n -- ‧冰長老，我已經將裡頭的冰塊清除完畢(clear complete)。
                        else
                                say $n 你將冰庫中的魔法冰塊清除完了嗎？
                        endif
                endif
        endif
endif
~
>talk_prog restart~
if is_qmark($n) == prehist_enemy
or is_qmark($n) & prehist_quest 100128
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($n) <= prehist_ice_quest 100001
        mpechoat $n 遠方傳來一陣聲響「本項任務你已經可以重新開始！」
        mpdel_qmark $n prehist_ice_quest
endif
~
>talk_prog p clear complete~
if is_qmark($n) == prehist_enemy
or is_qmark($n) !& prehist_quest 100002
or is_qmark($n) & prehist_quest 100128
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($n) == prehist_ice_quest 100001
        mpforce $n say 冰長老，我已經將裡頭的冰塊清除完畢。
        if mobcount(15650) == 0
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
				mpdel_qmark $n prehist_ice_quest
                mpmod_qmark $n prehist_quest v0 | 128
                clap $n
                say 真是太棒了....，
                mpcallout 1 mpexp $n 3000
                mpcallout 1 mpgold $n 50000
                mpcallout 2 say 謝謝你了....，
                mpcallout 3 say 往後我下去拿冰塊....，
                mpcallout 4 say 再也不用擔心被冰塊打了。
                mpcallout 4 mpdel_qmark self prehist_talking
        else
                say 你真的確定已經清除完畢了嗎？你最好再去看看。
        endif
endif
~
>talk_prog p clear those ices~
if is_qmark($n) == prehist_enemy
or is_qmark($n) !& prehist_quest 100002
or is_qmark($n) & prehist_quest 100128
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($n) == prehist_ice_quest 100000
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpmod_qmark $n prehist_ice_quest v0 = 1
        mpforce $n say 我可以幫忙冰長老您清除那些冰塊。
        sm $n
        say 是嗎？那你必須得要小心那些到處亂飛的冰塊....，
        mpcallout 1 say 要抓到那些冰塊可真是不容易....，
        mpcallout 2 say 還有我先警告你....，
        mpcallout 3 say 冰庫裡頭空間很小....，
        mpcallout 4 say 恐怕沒有辦法進去太多人....，
        mpcallout 5 say 你進去可別撞破了頭....，
        mpcallout 6 say 去吧！
        mpcallout 6 wave $n
        mpcallout 6 mpdel_qmark self prehist_talking
endif
~
>talk_prog p no pass~
if is_qmark($n) == prehist_enemy
or is_qmark($n) !& prehist_quest 100002
or is_qmark($n) & prehist_quest 100128
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($n) != prehist_ice_quest
        mpadd_qmark $n prehist_ice_quest -1 0 0 0 0 1
endif
mpforce $n say 請問一下北邊的房間為何禁止通行？
mpadd_qmark self prehist_talking 5 0 0 0 1 0
say 其實是因為我們的地下冰窖....，
mpcallout 1 say 有討厭的魔法生物在作怪....，
mpcallout 2 say 那些討厭的冰塊....，
mpcallout 3 say 可能會把誤闖的客人給砸傷....，
mpcallout 4 say 因此才會禁止不相干的人進入我們冰庫裡頭。
mpcallout 4 mpdel_qmark self prehist_talking
~
>talk_prog p phantom tower~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
mpforce $n say 請問一下有關「幻魔高塔(Phantom Tower)」的事情。
if is_qmark($i) == prehist_xue_quest
or is_qmark($n) & prehist_quest 100002
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        say 有關幻魔高塔的事情我都不太清楚....，
        mpcallout 1 say 只大略知道裡頭充斥著各式各樣的幻象生物....，
        mpcallout 2 say 幾乎沒有任何的武器或魔法可以對它們產生傷害。
        mpcallout 2 mpdel_qmark self prehist_talking
else
        say 我沒空回答，不要來煩我！
endif
~
>talk_prog p find distraction from boredom~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($n) == prehist_xue_quest 100002
        if is_qmark($i) == prehist_xue_quest
                sm $n
                say 不用了，我現在心情好的很，不用麻煩您了。
                break
        else
                mpforce $n say 冰長老您好，您的孫女小雪請我來這邊陪你解悶(find distraction from boredom)。
                say 你說什麼，你要來陪我解悶？好，那麼你要怎麼做？
                mpmod_qmark $n prehist_xue_quest v0 = 3
                if is_qmark($n) & prehist_xue_quest 300001
                        mpechoat $n -- ‧我曾經遇過這樣的事情....（使用需高智力(int)的對話技巧）
                endif
                if is_qmark($n) & prehist_xue_quest 300002
                        mpechoat $n -- ‧我曾經有個這樣的人生經驗....（使用需高智慧(wis)的對話技巧）
                endif
                if is_qmark($n) & prehist_xue_quest 300004
                        mpechoat $n -- ‧我曾經看過這樣的刀法....（展現需高力量(str)的舞刀技巧）
                endif
                if is_qmark($n) & prehist_xue_quest 300008
                        mpechoat $n -- ‧我曾經看過這種有趣動作....（展現需高敏捷(dex)的動作技巧）
                endif
                if is_qmark($n) & prehist_xue_quest 300016
                        mpechoat $n -- ‧我曾經遇過這樣的一件事情....（展現需高體質(con)的動作技巧）
                endif
        endif
endif
~
>talk_prog str~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($i) != prehist_xue_quest
        if is_qmark($n) == prehist_xue_quest 100003
                if is_qmark($n) & prehist_xue_quest 300004
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpforce $n say 我曾經看過這樣的刀法....
                        mpechoat $n 你將 藍(Lan) 曾經教過的刀法迅速地演練了一次給 $I 看....
                        mpechoaround $n $n 迅速地演練了一套精彩的刀法給 $I 看....
                        if str($n) > 20
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 5
                                mpcallout 2 sm $n
                                mpcallout 3 say 看起來蠻有趣的....，
                                mpcallout 4 say 加上你的力量不錯....，
                                mpcallout 5 say 整個刀法搭配你的力量更是無懈可擊....，
                                mpcallout 6 say 好久沒看到這樣的好刀法了....，
                                mpcallout 7 say 謝謝你，去告訴小雪，我的心情好多了。
                                mpcallout 7 mpdel_qmark self prehist_talking
                                mpcallout 7 mpadd_qmark self prehist_xue_quest 120 0 0 0 1 0
                        else
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 4
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest timer = 120
                                mpcallout 2 say ................
                                mpcallout 3 sigh
                                mpcallout 4 say 請問一下，你是在耍寶嗎....？
                                mpcallout 5 say 我只覺得我的心情更差了....，
                                mpcallout 6 say 拜託請你離開這邊....，
                                mpcallout 7 say 我沒空看一隻猴子在這邊拿著武器跳舞。
                                mpcallout 7 mpdel_qmark self prehist
                        endif
                else
                        mpechoat $n 你並未學過相關的技巧。
                endif
        endif
endif
~
>talk_prog int~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($i) != prehist_xue_quest
        if is_qmark($n) == prehist_xue_quest 100003
                if is_qmark($n) & prehist_xue_quest 300001
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpforce $n say 我曾經遇過這樣的事情....
                        mpechoat $n 你滔滔不絕地將 小痞(Pii) 教過你的口才技巧給展現了出來....
                        mpechoaround $n $n 滔滔不絕地對著 $I 說了一些有趣的事情....
                        if int($n) > 20
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 5
                                mpcallout 2 sm $n
                                mpcallout 3 say 聽起來蠻有趣的....，
                                mpcallout 4 say 不過我最驚訝的是整個事情經過你的編排....，
                                mpcallout 5 say 原本無趣的事情也會被你講到有趣了....，
                                mpcallout 6 say 你一定有著相當高的智力吧....，
                                mpcallout 7 say 謝謝你，去告訴小雪，我的心情好多了。
                                mpcallout 7 mpdel_qmark self prehist_talking
                                mpcallout 7 mpadd_qmark self prehist_xue_quest 120 0 0 0 1 0
                        else
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 4
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest timer = 120
                                mpcallout 2 say ................
                                mpcallout 3 sigh
                                mpcallout 4 say 你說完了吧...？
                                mpcallout 5 say 你以為你說的東西很有趣是吧....？
                                mpcallout 6 say 我告訴你，聽了只想作嘔....，
                                mpcallout 7 say 你走吧！聽癩蝦蟆叫都比聽你囉唆來的好。
                                mpcallout 7 mpdel_qmark self prehist_talking
                        endif
                else
                        mpechoat $n 你並未學過相關的技巧。
                endif
        endif
endif
~
>talk_prog wis~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($i) != prehist_xue_quest
        if is_qmark($n) == prehist_xue_quest 100003
                if is_qmark($n) & prehist_xue_quest 300002
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpforce $n say 我曾經有個這樣的人生經驗....
                        mpechoat $n 你滔滔不絕地將 飛燕(Feiyan) 教過你的口才技巧給展現了出來....
                        mpechoaround $n $n 滔滔不絕地對著 $I 說了一些致理的事情....
                        if wis($n) > 20
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 5
                                mpcallout 2 sm $n
                                mpcallout 3 say 聽起來蠻發人深省地....，
                                mpcallout 4 say 沒想到你年紀輕輕對人生就有著這樣的瞭解....，
                                mpcallout 5 gig
                                mpcallout 5 say 現在的年輕人可真是越來越早熟了....，
                                mpcallout 6 say 不管如何，謝謝你那精湛有趣的一席話語....，
                                mpcallout 7 say 謝謝你，去告訴小雪，我的心情好多了。
                                mpcallout 7 mpdel_qmark self prehist_talking
                                mpcallout 7 mpadd_qmark self prehist_xue_quest 120 0 0 0 1 0
                        else
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 4
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest timer = 120
                                mpcallout 2 say ................
                                mpcallout 3 sigh
                                mpcallout 4 say 喔！你所說的人生經驗就是這樣啊....，
                                mpcallout 5 say 小子，不要曾經經歷過一些雞毛蒜皮的小事....，
                                mpcallout 6 say 就以為自己登仙得道了好嗎....？
                                mpcallout 7 say 這年頭自以為是的冒險者真是越來越多了，快滾吧！
                                mpcallout 7 mpdel_qmark self prehist_talking
                        endif
                else
                        mpechoat $n 你並未學過相關的技巧。
                endif
        endif
endif
~
>talk_prog dex~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($i) != prehist_xue_quest
        if is_qmark($n) == prehist_xue_quest 100003
                if is_qmark($n) & prehist_xue_quest 300008
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpforce $n say 我曾經看過這種有趣動作....
                        mpechoat $n 你將 影(Ying) 曾經指導過的敏捷動作表演給 $I 看....
                        mpechoaround $n $n 迅速地表演了一段快速、敏捷的連環動作....
                        if dex($n) > 20
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 5
                                mpcallout 2 laugh
                                mpcallout 3 say 真是有趣的動作....，
                                mpcallout 4 say 不過整套動作的精華....，
                                mpcallout 5 say 在於你有著高超的敏捷度....，
                                mpcallout 6 say 不然這套動作就沒有意義了....，
                                mpcallout 7 say 謝謝你，去告訴小雪，我的心情好多了。
                                mpcallout 7 mpdel_qmark self prehist_talking
                                mpcallout 7 mpadd_qmark self prehist_xue_quest 120 0 0 0 1 0
                        else
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 4
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest timer = 120
                                mpcallout 2 say ................
                                mpcallout 3 sigh
                                mpcallout 4 say 你說這些如同瘋子一般的窩囊動作是如何能讓我感到快樂了....？
                                mpcallout 5 say 我想小雪這次一定是看走眼了....，
                                mpcallout 6 say 怎麼會請你來表演這種如雜技團般的可悲動作呢....？
                                mpcallout 7 say 拜託你快走，我要趕著製作冰品。
                                mpcallout 7 mpdel_qmark self prehist_talking
                        endif
                else
                        mpechoat $n 你並未學過相關的技巧。
                endif
        endif
endif
~
>talk_prog con~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
if is_qmark($i) != prehist_xue_quest
        if is_qmark($n) == prehist_xue_quest 100003
                if is_qmark($n) & prehist_xue_quest 300016
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpforce $n say 我曾經遇過這樣的一件事情....
                        mpechoat $n 你將一個重物懸掛在自己的....腰間，欲展現強健的體魄....
                        mpechoaround $n $n 將一個重物懸掛在自己的腰間....
                        if con($n) > 20
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 5
                                mpcallout 2 gasp $n
                                mpcallout 3 say 你的體魄看起來不錯喔....，
                                mpcallout 4 say 想當初我年輕的時候....，
                                mpcallout 5 say 比起你剛剛可是不妨多讓呢....！
                                mpcallout 6 say 嗯！年輕人，你的體魄不錯...，
                                mpcallout 7 say 謝謝你，去告訴小雪，我的心情好多了。
                                mpcallout 7 mpdel_qmark self prehist_talking
                                mpcallout 7 mpadd_qmark self prehist_xue_quest 120 0 0 0 1 0
                        else
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest v0 = 4
                                mpcallout 2 mpmod_qmark $n prehist_xue_quest timer = 120
                                mpcallout 2 say ................
                                mpcallout 3 sigh
                                mpcallout 4 say 你這叫強健的體魄啊....？
                                mpcallout 5 mpecho $I 將重達數倍重的重物，掛在自己的腰間....
                                mpcallout 6 say 這個才叫強健的體魄，沒有三兩三，也敢上梁山....，
                                mpcallout 7 say 滾！我不想見到你這個虛弱的傢伙。
                                mpcallout 7 mpdel_qmark self prehist_talking
                        endif
                else
                        mpechoat $n 你並未學過相關的技巧。
                endif
        endif
endif
~
>talk_prog medusa~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
mpforce $n say 請問一下「梅杜莎(Medusa)」是什麼樣的一種生物？
if is_qmark($i) == prehist_xue_quest
or is_qmark($n) & prehist_quest 100002
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        say 你說「梅杜莎」？在史卡拉貝大陸中這是屬於神話中的生物....，
        mpcallout 1 say 但是卻沒有人在史卡拉貝大陸發現過這類生物的蹤跡....，
        mpcallout 2 say 不過我聽說一些由遠古森林冒險回來的村民有提到....，
        mpcallout 3 say 他們在一個洞穴的入口發現了許多石頭的雕像....，
        mpcallout 4 say 但是雕像的表情栩栩如生般的驚恐....，
        mpcallout 5 say 彷彿曾經經歷過一場十分重大的災變或突發事件....，
        mpcallout 6 say 這些栩栩如生雕像的內容連內臟都十分的精細....，
        mpcallout 7 say 因此村子裡頭的長老們敲定....，
        mpcallout 8 say 迷霧之島上應該有存在著這一類的生物。
        mpcallout 8 mpdel_qmark self prehist_talking
else
        say 我沒空回答，不要來煩我！
endif
~
>talk_prog background~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
mpforce $n say 請問一下有關魔刀村的背景(background)或由來。
if is_qmark($i) == prehist_xue_quest
or is_qmark($n) & prehist_quest 100002
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        say 魔刀村主要成立的原因還是因為史卡拉貝大陸的人移居過來之後....，
        mpcallout 1 say 對於整個迷霧之島環境的破壞的造成的....，
        mpcallout 2 say 原本十分尊敬迷霧之島土地的原住民們....，
        mpcallout 3 say 在求生存之餘總是儘量不傷到整個大地之母的元氣....，
        mpcallout 4 say 但是看見那些外來移民不斷地大興土木....，
        mpcallout 5 say 在平原東岸圍起了數十里的圍牆....，
        mpcallout 6 say 又在海岸邊興建了壯觀的漁港....，
        mpcallout 7 say 雖然養足、保護了他們人們的生活、安全....，
        mpcallout 8 say 卻也讓迷霧之島變得傷痕累累....，
        mpcallout 9 say 村子裡頭的村民都是討厭史卡拉貝移民的人....，
        mpcallout 10 say 後來大家志同道合地就聚集在一起了。
        mpcallout 10 mpdel_qmark self prehist_talking
else
        say 我沒空回答，不要來煩我！
endif
~
>talk_prog p prehist forest~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
mpforce $n say 請問一下有關遠古森林(prehist forest)的一些事情。
if is_qmark($i) == prehist_xue_quest
or is_qmark($n) & prehist_quest 100002
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        say 你是說遠古森林嗎....？
        mpcallout 1 say 其實在大約4、50年前....，
        mpcallout 2 say 遠古森林危險的部分僅限於深處與地底的部分....，
        mpcallout 3 say 但是現在由於外來冒險者不斷的入侵....，
        mpcallout 4 say 加上不知道是誰在村子西南方建造了幻魔高塔....，
        mpcallout 5 say 使得整個遠古森林的生物都變得暴戾起來了....，
        mpcallout 6 say 對已經與遠古森林大部分生物相處習慣的我們是沒有什麼差別....，
        mpcallout 7 say 但是有許多史卡拉貝的冒險者就這樣喪送寶貴生命在森林之中....，
        mpcallout 8 say 我想這一切與是他們自己咎由自取吧！
        mpcallout 8 mpdel_qmark self prehist_talking
else
        say 我沒空回答，不要來煩我！
endif
~
>talk_prog class~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
or is_qmark($i) == prehist_xue_quest 100004
        break
endif
mpforce $n say 請問一下您是做什麼的(class)？
if is_qmark($i) == prehist_xue_quest
or is_qmark($n) & prehist_quest 100002
        sm $n
        say 我是外頭賣冰小女孩小雪的爺爺，所以我是賣冰的。
else
        say 我沒空回答，不要來煩我！
endif
~
>fight_prog 100~
if is_qmark($n) != prehist_enemy
        mpadd_all_qmark $n prehist_enemy -1 0 0 0 1 1
endif
if isfight($r)
        if is_qmark($r) != prehist_enemy
                mpadd_qmark $r prehist_enemy -1 0 0 0 1 1
        endif
endif
if hitprcnt($i) <= 70
        if is_qmark(water-spirit) > prehist_heal_elder 100000
                mpforce water-spirit c 'cure blindness'
                mpecho [1;36m水精靈(water spirit)化身為一道寒冰，緩緩的治療了 $I 身上的傷。[m
                mpforce water-spirit c double ice-prehist
                mpmod_qmark water-spirit prehist_heal_elder v0 - 1
        else
                if is_qmark(water-spirit) == prehist_heal_elder 100000
                        mpforce water-spirit say 我願讓自己的生命之水消失，以復原冰長老身上的傷口。
                        mpforce water-spirit c 'full heal' ice-prehist
                        mppurge water-spirit
                endif
        endif
endif
if rand(50)
        c 'colour spray'
        mpnowait
        c 'glacier strike'
        mpnowait
else
        c 'frost breath'
        mpnowait
endif
if rmobcount(10) < 5
        say 依照古老的約定，請妳們前來保護我的身軀！
        mpmload 10
        mpgruop self water-spirit 1 0
        mpforce water-spirit rescue ice-prehist
        mpadd_qmark water-spirit prehist_heal_elder -1 10 0 0 0 0
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) != prehist_enemy
        mpadd_qmark $n prehist_enemy -1 0 0 0 1 1
endif
~
