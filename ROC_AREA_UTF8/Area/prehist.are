or is_equ_obj($n) == 3454
or is_equ_obj($n) == 15452
        if robjcount(15474) > 0
        or robjcount(15475) > 0
                echoat $n 這邊已經被挖開一個洞了。
        else
                modrvt v1 | 1024
                echoat $n 你使用身上的鏟子開始挖掘....
                echoaround $n $n 使用身上的鏟子開始挖掘....
                callout 1 modrvt v0 = 1
                callout 1 modrvt t0 = 120
                callout 1 echoat $n 你在地上挖開了一個洞....
                callout 1 echoaround $n $n 在地上挖開了一個洞....
                callout 1 oload 15474 99 floor
                callout 1 modrvt v1 r 1024
        endif
else
        echoat $n 你身上並沒有可供挖掘的工具。
endif
~
