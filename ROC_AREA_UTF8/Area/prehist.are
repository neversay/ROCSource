        if robjcount(15633) == 0
                if robjcount(15634) == 0
                        oload 15632 50 floor
                endif
        endif
endif
~
>room_command setfree container~
if robjcount(15632) > 0
        if is_inv_obj($n) == 15631
                purge $n container-prehist
                purge instrument1-prehist
                oload 15633 viclv $n floor
                echoat $n 你將 玻璃容器(glass container) 放進了儀器下方的空位中....
                echoaround $n $n 將 玻璃容器(glass container) 放進了儀器下方的空位中....
        endif
        break
endif
if robjcount(15633) > 0
        if is_inv_obj($n) == 15631
                echoat $n 你嘗試將 玻璃容器(glass container) 放進了儀器下方的空位中....
                echoaround $n $n 嘗試將 玻璃容器(glass container) 放進了儀器下方的空位中....
                echo 但是儀器下方的空位已經放了一個空的 玻璃容器(glass container) 了。
        endif
        break
endif
if robjcount(15634) > 0
        if is_inv_obj($n) == 15631
                echoat $n 你嘗試將 玻璃容器(glass container) 放進了儀器下方的空位中....
                echoaround $n $n 嘗試將 玻璃容器(glass container) 放進了儀器下方的空位中....
                echo 但是儀器下方的空位已經放了一個裝滿金黃色液體的 玻璃容器(glass container) 了。
        endif
endif
~
>room_command takeout container~
echoat $n 你嘗試將 玻璃容器(glass container) 由儀器下方取出....
echoaround $n $n 嘗試將 玻璃容器(glass container) 由儀器下方取出....
if robjcount(15632) > 0
        echo 但是儀器下方並沒有任何的東西。
        break
endif
if robjcount(15633) > 0
        echoat $n 你由儀器下方取出了空的 玻璃容器(glass container)....
        echoaround $n $n 由儀器下方取出了空的 玻璃容器(glass container)....
        oload 15631 viclv $n target
        purge instrument2-prehist
        oload 15632 50 floor
        break
endif
if robjcount(15634) > 0
        echoat $n 你由儀器下方取出了裝滿金黃色液體的 玻璃容器(glass container)....
        echoaround $n $n 由儀器下方取出了裝滿金黃色液體的 玻璃容器(glass container)....
        oload 15626 viclv $n target
        purge instrument3-prehist
        oload 15632 50 floor
endif
~
>room_command mix material~
if is_qmark($n) == prehist_golden_potion 100002
        if is_inv_obj($n) == 301
                if is_inv_obj($n) == 110
                        if is_inv_obj($n) == 10706
                                echoat $n 你將三個製作黃金藥水的原料丟進了房間的儀器中....
                                echoaround $n $n 將三個製作黃金藥水的原料丟進了房間的儀器中....
                                purge $n nightshade-smurf
                                purge $n herb-plains
                                purge $n spider-murky
                                if robjcount(15632) > 0
                                        echo 整台儀器開始劇烈的震動....，
                                        callout 2 echo 儀器下方開始流出金黃色的液體....，
                                        callout 3 echo 但是儀器下方沒有可以裝盛液體的容器，所有液體都流失了！
                                        break
                                endif
                                if robjcount(15633) > 0
                                        mod_qmark $n prehist_golden_potion v0 = 3
                                        rpexp $n 1500
                                        callout 2 echo 整個房間的儀器都開始動了起來....
                                        callout 3 echo 儀器的下方開始流出金黃色的液體....
                                        callout 4 echo 儀器下方的玻璃容器已經裝滿了金黃色的液體！
                                        callout 4 purge instrument2-prehist
                                        callout 4 oload 15634 viclv $n floor
                                        break
                                endif
                                if robjcount(15634) > 0
                                        callout 2 echo 整個房間的儀器都開始動了起來....
                                        callout 3 echo 儀器的下方開始流出金黃色的液體....
                                        callout 4 echo 原已裝滿金黃色液體的玻璃容器內的液體溢了出來....
                                endif
                        endif
                endif
        endif
endif
~
|
