if insameroom(pii-prehist)
        if is_qmark($n) == prehist_pii_quest 100006
                mpadd_qmark self prehist_talking 5 0 0 0 1 0
                mpmod_qmark $n prehist_pii_quest v0 = 7
                mpmod_qmark pii-prehist prehist_pii_quest v0 = 1
                nod pii-prehist
                say 你終於願意不好高騖遠地訓練自己了嗎....？
                mpcallout 1 mpforce pii-prehist say 是的，金長老爺爺，我願意聽從您的指導....，
                mpcallout 1 mpforce pii-prehist blush golden-prehist
                mpcallout 2 mpforce pii-prehist say 好好地在刀技的根本 - 心技上先磨練磨練....，
                mpcallout 3 sm pii-prehist
                mpcallout 4 say 你有這樣的心就好，但是我先警告你....，
                mpcallout 5 say 過程可不是你想像的那般容易，你知道嗎....？
                mpcallout 6 mpforce pii-prehist say 我知道，但我願意用我所有的耐力以通過考驗....。
                mpcallout 6 mpforce pii-prehist nod golden-prehist
                mpcallout 7 good pii-prehist
                mpcallout 8 say 既然你有這樣的決心....，
                mpcallout 9 say 那麼你先到村口那個破舊的道場....，
                mpcallout 10 say 看那些辛勤苦練的刀客們....，
                mpcallout 11 say 然後再回來告訴我你看見了什麼。
                mpcallout 12 mpforce pii-prehist say 是的，金長老爺爺。
                mpcallout 12 mpforce pii-prehist nod golden-prehist
                mpcallout 12 mpmod_qmark $n prehist_pii_quest v0 = 8
                mpcallout 12 mpmod_qmark pii-prehist prehist_pii_quest v0 = 2
                mpcallout 12 mpmod_qmark pii-prehist prehist_pii_quest timer + 36
                mpcallout 13 mpforce pii-prehist tell $n 我們走吧！去村口的破舊道場。
        endif
