>room_rand 15~
if pcnum($) == 0
        break
endif
if rand(25)
        echo 忽然出現了一隻 三角龍(triceratops) 前來喝水....
        mload 15403
        if rand(25)
                callout 1 echo 這隻 三角龍(triceratops) 忽然向你展開攻擊....
                callout 1 force triceratops mpkill $r
        endif
        break
endif
if rand(33)
        echo 由空中飛來一隻 鷲(buzzard) 到這邊喝水....
        mload 15404
        if rand(20)
                callout 1 echo 這隻 鷲(buzzard) 忽然向你展開攻擊....
                callout 1 force buzzard mpkill $r
        endif
        break
endif
if rand(50)
        echo 一個 部落男子(wandering bribesman) 前來這裡取水....
        mload 15406
        if rand(20)
                callout 1 echo 部落男子(wandering bribesman)向你微微一笑後就離開了....
                callout 1 purge bribesman
        endif
else
        echo 一隻身軀巨大的 黑熊(black bear) 跑到這邊來喝水....
        mload 15414
        if rand(20)
                callout 1 echo 這隻 黑熊(black bear) 忽然向你撕咬了過來....
                callout 1 force bear mpkill $r
        endif
endif
~
|
