#15604
rook-prehist rook~
路克(Rook)~
一個體格魁武的刀客路克(Rook)在這裡嘗試修理這邊的屋子。
~
他的體格十分的健壯魁梧，但是表情卻顯得十分的煩躁，不知道是什麼事情困擾了他。
~
2|64 8|32|128|512|8192 0 S
48 0 0 0d0+0 0d0+30
5000 0
8 8 1
C 1|8|32
P 8|256|4194304|8388608
S 16 -1000
>repop_prog 100~
mpoload 15618
mpat 5 wear all
mpadd_qmark self prehist_rook_quest -1 0 0 0 1 0
~
>talk_prog topic~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
if is_qmark($n) == prehist_rook_quest 100000
        say 又是你，不是說請你不要出現在我面前了嗎？
        break
endif
say 請問有什麼事情嗎，$N？
mpechoat $n -- ‧請問一下有關魔刀村的背景(background)或由來。
mpechoat $n -- ‧請問一下有關遠古森林(prehist forest)的一些事情。
mpechoat $n -- ‧請問一下您是做什麼的(class)？
if is_qmark($n) & prehist_quest 200032
        if is_qmark($n) !& prehist_quest 100008
                if is_qmark($n) != prehist_rook_quest
                        mpechoat $n -- ‧你好，路克，聽說你的房子壞掉(broken)了是嗎？
                endif
        endif
endif
if is_qmark($n) == prehist_rook_quest 100001
        mpechoat $n -- ‧您別生氣，我可以義務幫您修理房子，只要您願意(fix compulsarily)。
        mpechoat $n -- ‧別生氣，我可以幫你修理房子，只要你願意付出一些代價(fix costly)。
endif
if is_qmark($n) == prehist_rook_quest 100002
        if is_qmark($n) & prehist_rook_quest 200001
                mpechoat $n -- ‧先別說報酬了，那麼我現在應該怎麼做(what can I do now)？
        endif
        if is_qmark($n) & prehist_rook_quest 200002
                mpechoat $n -- ‧好， 50 萬金幣可以接受，那麼我現在該做些什麼(what can I do now)？
                mpechoat $n -- ‧才 50 萬金幣，你別開玩笑了(are you kidding)，我不願意幫你。
        endif
endif
~
>give_prog 4104~
if inroom($i) != 15631
        say 我現在並不需要這個東西。
        break
endif
if is_qmark($i) >= prehist_rook_quest 100003
        sm $n
        say 現在這項建材已經蒐集完成，你不用再給我了。
        drop wood
        break
endif
if is_qmark($n) == prehist_rook_quest 100003
        mpmod_qmark self prehist_rook_quest v0 + 1
        nod $n
        say 我收到你的木材(wood)了。
        mpjunk all.wood
        if is_qmark($i) == prehist_rook_quest 100003
                if is_qmark($i) == prehist_rook_quest 200005
                        mpcall prehist_rook_building $n
                        break
                endif
        endif
        say 我還需要更多的木材(wood)。
endif
~
>give_prog 15641~
if inroom($i) != 15631
        say 我現在並不需要這個東西。
        break
endif
if is_qmark($i) >= prehist_rook_quest 200005
        sm $n
        say 現在這項建材已經蒐集完成，你不用再給我了。
        drop pebble-prehist
        break
endif
if is_qmark($n) == prehist_rook_quest 100003
        mpmod_qmark self prehist_rook_quest v1 + 1
        nod $n
        say 收到你的鵝卵石(pebble)了。
        mpjunk all.pebble
        if is_qmark($i) == prehist_rook_quest 100003
                if is_qmark($i) == prehist_rook_quest 200005
                        mpcall prehist_rook_building $n
                        break
                endif
        endif
        say 我還需要更多的鵝卵石(pebble)。
endif
~
>defun_prog prehist_rook_building~
mpdef_rembch $n
mpat 15634 mpforcer here deldoor 0
mpat 15634 mpforcer here modrvt v0 = 2
mpat 15634 mpforcer here makedoor 0 通往房屋(exit) exit 0 0 15588
mpforcer here deldoor 2
mpat 15588 mpforcer here makedoor 2 通往街道(exit) exit 0 0 15634
mptransfer all 15588
mptransfer obj 15588
mpgoto 15588
mpadd_qmark self prehist_rook_building 48 0 0 0 1 0
mpmod_qmark $n prehist_rook_quest v0 = 4
say 那麼我就開始進行重建的工作....，
say 有時候我會需要一些幫忙....，
say 希望到時候你能夠在我旁邊協助我。
mpecho $I 開始了重建房子的手續....
~
>talk_prog p carpenter's ink line~
say 你說墨線(carpenter's ink line)嗎？
say 那是用來在難以使用筆等繪圖工具畫出標記的表面做水平垂直記號的工具，
say 聽說啊！它還有避邪的功用呢。
~
>talk_prog plaster~
say 灰泥(plaster)是嗎？
say 灰泥俗稱灰漿，如果加上一些粒材就變成水泥沙漿，
say 可以用來連結建築骨架及牆面補強，
say 如果是非收縮性的灰泥，還可以用來補破洞喔。
~
>talk_prog p horiz apparatus~
say 水平儀(horiz apparatus)是用來測定水平的工具，
say 不然房子蓋起來歪歪的，住在裡頭的人可是會頭暈。
say 當然有些建築就是會故意蓋的歪斜歪斜的，
say 例如某個海外國度內的「古根漢」博物館，
say 地板就是斜的。
~
>talk_prog silicon~
say 矽(silicon)具備有非收縮性以及固化性，
say 而且硬化後不具備滲水性，
say 可以用來作為防水工程之用。
~
>tick_prog 100~
if being($b)
        if is_qmark($i) == prehist_rook_building
                if insameroom($b)
                        if is_qmark($i) == prehist_rook_building 1040
                                say 糟糕，我竟然忘了定位的墨線(carpenter's ink line)放在葉(Yieh)那邊了，
                                say 可不可以請你去幫我拿一下。
                                if is_qmark($b) != prehist_rook_quest_1
                                        mpadd_qmark $b prehist_rook_quest_1 40 0 0 0 1 1
                                endif
                        endif
                        if is_qmark($i) == prehist_rook_building 1032
                                kowtow
                                say 我正要沏牆，但是竟然沒有灰泥(plaster)當作連接材。
                                say 聽說波恩(Pawn)的實驗室有些灰泥，你去幫我要一點來好嗎？
                                say 波恩的實驗室在魔刀村的東北方。
                                if is_qmark($b) != prehist_rook_quest_2
                                        mpadd_qmark $b prehist_rook_quest_2 32 0 0 0 1 1
                                endif
                        endif
                        if is_qmark($i) == prehist_rook_building 1024
                                faint
                                say 糟糕，我的記性真的太差了，又忘了一個東西。
                                say 我上次去拜訪土長老，竟然把水平儀(horiz apparatus)忘在他那邊，
                                say 拜託你去拿一下吧。
                                lick $b
                                if is_qmark($b) != prehist_rook_quest_3
                                        mpadd_qmark $b prehist_rook_quest_3 24 0 0 0 1 1
                                endif
                        endif
                        if is_qmark($i) == prehist_rook_building 1016
                                blush
                                say 這個....，我忘了一項東西，
                                say 是最後用來作為防水的矽(silicon)，
                                say 應該是放在刀王那邊了，
                                say 看你能不能遇到他，跟他拿過來。
                                if is_qmark($b) != prehist_rook_quest_4
                                        mpadd_qmark $b prehist_rook_quest_4 16 0 0 0 1 1
                                endif
                        endif
                endif
                if is_qmark($i) == prehist_rook_building 1008
                        shout 太棒了，我的新房子完成了！
                        mpat 15634 mpforcer here deldoor 0
	           mpat 15634 mpforcer here modrvt v0 = 3
	           mpat 15634 mpforcer here makedoor 0 通往房屋(door) door 0 0 15587
	           mpforcer here deldoor 2
	           mpat 15587 mpforcer here makedoor 2 通往街道(door) door 0 0 15634
	           mptransfer all 15587
	           mpgoto 15587
	           if insameroom($b)
	           		mpcall prehist_rook_reward $b
	           else
			tell $b 我已經完成我的房子啦！
			tell $b 你不快點回來，可沒有獎賞可領。
	           endif
                endif
        else
                tell $b 你的動作實在太慢了，這項任務你只好重新來了。
                mppurge self
        endif
else
        if is_qmark($i) == prehist_rook_building
                shrug
                say 又一個沒有解完任務就離線的傢伙。
                mppurge self
        endif
endif
~
