or is_qmark($n) == prehist_enemy
        break
endif
mpforce $n say 請問一下有關魔刀村的背景(background)或由來。
mpadd_qmark self prehist_talking 5 0 0 0 1 0
say 我說$N啊！我才不到 30 歲....，
mpcallout 1 say 當初出生的時候....，
mpcallout 2 say 就已經身在魔刀村中了....，
mpcallout 3 say 因此我對於魔刀村的由來所知有限....，
mpcallout 4 say 你倒是可以多問問村裡頭的長老....，
mpcallout 5 say 他們一定能夠幫助你。
mpcallout 5 mpdel_qmark self prehist_taling
~
>talk_prog p prehist forest~
if is_qmark($i) == prehist_talking
or is_qmark($n) == prehist_enemy
        break
endif
mpforce $n say 請問一下有關遠古森林(prehist forest)的一些事情。
mpadd_qmark self prehist_talking 5 0 0 0 1 0
sigh
mpcallout 1 say 遠古森林比起以前已經完全變了樣....，
mpcallout 2 say 裡頭的生物變得十分的凶猛....，
mpcallout 3 say 使得我必須待在這個村子裡頭....，
mpcallout 4 say 避免那些發瘋或無故出現的生物(creature)攻進村子裡頭....，
mpcallout 5 say 因此我想要到光明之鎮增加歷練的計畫也得順延了。
mpcallout 5 shrug
mpcallout 5 mpdel_qmark self prehist_taling
