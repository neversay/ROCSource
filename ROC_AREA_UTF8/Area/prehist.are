sapth-prehist sapth slave~
賽斯(Sapth)~
賽斯(Sapth) - 蛇髮女妖的奴隸，在這邊尋求你的協助。
~
他的眼神中滿是懇求你拯救他脫離蛇髮女妖控制的眼神。
~
1|2|4|64|128 8|32|256|512 0 S
45 0 0 0d0+0 0d0+0
0 0
0 8 1
P 8|256|4194304
C 1|4
S 16 -1000
>greet_prog 100~
if being($b)
else
        if ispc($n)
                sob
                say 救救我吧！請幫助我脫離(break away)蛇髮女妖(medusa)的控制。
        endif
endif
~
>talk_prog medusa~
if is_qmark($i) == prehist_talking
or being($b)
        break
endif
fear
say 可怕的蛇髮女妖(medusa)....，
mpcallout 1 say 他把我弟弟索恩(Shaanh)跟我抓到這邊關了好久....，
mpcallout 2 say 聽裡頭的人說是因為我跟索恩的體格特質(characteristic)....，
mpcallout 3 say 因此蛇髮女妖把我們給關在這邊....，
mpcallout 4 say 我不過是一介平民....，
mpcallout 5 say 有什麼特質，英雄您趕快救我出去吧。
mpcallout 5 mpdel_qmark self prehist_talking
~
>talk_prog shaanh~
if is_qmark($i) == prehist_talking
or being($b)
        break
endif
say 索恩(Shaanh)是我的弟弟....，
mpcallout 1 say 我們一同生活在魔刀村裡頭....，
mpcallout 2 say 有一天我跟他外出打獵....，
mpcallout 3 say 忽然看到一陣閃光....，
mpcallout 4 say 接著就不省人事了....，
mpcallout 5 say 當我醒來的時候就已經在這暗無天日的房間中。
mpcallout 5 mpdel_qmark self prehist_talking
~
>talk_prog characteristic~
if is_qmark($i) == prehist_talking
or being($b)
        break
endif
ponder
say 其實我也不太清楚....，
mpcallout 1 say 我只有隱約聽到有關「開啟幻魔高塔」類似的話....，
mpcallout 2 say 其他我就不太清楚了....，
mpcallout 3 say 我根本就不知道為什麼會被抓到這邊來。
mpcallout 3 mpdel_qmark self prehist_talking
~
>talk_prog p break away~
if is_qmark($i) == prehsit_talking
or is_qmark($n) & prehist_quest 1001024
or is_qmark($n) == prehist_rescue_quest
        if is_qmark($n) & prehist_quest 1001024
                say $n 你已經完成本項任務了。
        endif
        if is_qmark($n) == prehist_rescue_quest 100000
                angry $n
                say 沒有用的傢伙，要找我談話等下輩子吧！
        endif
        break
endif
if being($b)
else
        hop $n
        say 那太好了，不過我們得先去找我的弟弟 - 索恩(Shaanh)，
        say 他應該就關在這附近，我們去找他吧。
        mpadd_qmark $n prehist_rescue_quest -1 1 1 0 0 1
        mpadd_qmark self prehist_rescue_quest 120 1 1 0 1 0
        mpdef_rembch $n
        mpgroup $n self 1 0
endif
~
>entry_prog 100~
if insameroom(shaanh-prehist)
        if insameroom($b)
                if is_qmark($i) == prehist_rescue_quest 100002
                        mpmod_qmark self prehist_rescue_quest v0 = 3
                        mpmod_qmark shaanh-prehist prehist_rescue_quest v0 = 3
                        mpmod_qmark $b prehist_rescue_quest v0 = 3
                        mpechoat $b 眾人到了這邊，忽然出現兩頭惡狼向你撲過來....
                        mpechoaround $b 眾人到了這邊，忽然出現兩頭惡狼向$B撲過來....
                        mpmload 15432
                        mpforce warg mpat 5 invoke
                        mpforce warg hunt $b
                        mpmload 15432
                        mpforce warg mpat 5 invoke
                        mpforce warg hunt $b
                        break
                endif
                if is_qmark($i) == prehist_rescue_quest 100003
                        mpmod_qmark self prehist_rescue_quest v0 = 4
                        mpmod_qmark shaanh-prehist prehist_rescue_quest v0 = 4
                        mpmod_qmark $b prehist_rescue_quest v0 = 4
                        if is_qmark($b) & prehist_rescue_quest 100001
                                say 就是這邊！就是這邊！我們到了！
                        endif
                        if is_qmark($b) & prehist_rescue_quest 100002
                                mpforce shannh-prehist say 啊！我記得就在這邊，我們到了！
                        endif
                endif
        endif
        break
endif
if insameroom(shaanh-prehist)
        if insameroom($b)
                if is_qmark($i) == prehist_rescue_quest 100001
                        mpmod_qmark self prehist_rescue_quest v0 = 2
                        mpadd_qmark shaanh-prehist prehist_rescue_quest 120 2 0 0 1 0
                        mpmod_qmark self prehist_rescue_quest timer = 120
                        mpmod_qmark $b prehist_rescue_quest v0 = 2
                        mpforce shaanh-prehist mpdef_rembch $b
                        mpforce shaanh-prehist mpgroup $b self 1 0
                        mpadd_qmark self prehist_talking 5 0 0 0 1 0
                        mpexp 500
                        mpecho $I 衝過去緊緊地抱住了 索恩(Shaanh) ....
                        mpforce shaanh-prehist say 大哥，你怎麼會來這邊....？
                        say 抱歉，小弟，我來晚了....，
                        mpcallout 1 point $b
                        mpcallout 1 say 這位英雄救出了我，準備幫我們逃出這邊....，
                        mpcallout 2 mpforce shaanh-prehist viva
                        mpcallout 3 mpforce shaanh-prehist say 那大哥意思是說我們終於可以逃出這邊了....？
                        mpcallout 4 nod shaanh-prehist
                        mpcallout 5 mpforce shaanh-prehist say 太好了，我們終於可以回到魔刀村了....，
                        mpcallout 6 say 先別高興，我們還得先離開這邊才行....，
                        mpcallout 7 mpforce shaanh-prehist agree
                        mpcallout 8 say 這位英雄，據我所知要逃出這邊是非常困難的....，
                        mpcallout 9 say 但是我知道一條藏在牆壁中的密道....，
                        mpcallout 10 say 就在你剛由外頭進入地底不久的地方....，
                        mpcallout 11 say 你就先帶我們到那邊去吧。
                        mpcallout 11 mpdel_qmark self prehist_talking
                endif
        endif
endif
~
>rand_prog 50~
if being($b)
        if is_qmark($i) == prehist_rescue_quest
                if insameroom($b)
                        if rand(15)
                                if hitprcnt($b) < 50
                                        say $B你受了點傷，讓我幫幫你....
                                        c 'double heal' $b
                                        mpnowait
                                endif
                        endif
                else
                        tell $b say 你跑去哪裡啦？快回來救我出去啊！
                        if is_qmark($i) > prehist_rescue_quest 1010
                                mpmod_qmark self prehist_rescue_quest timer - 10
                        endif
                endif
        else
                tell $b 你的速度真的是太慢了，這項任務已經失敗！
                mppurge self
        endif
else
        if is_qmark($i) == prehist_rescue_quest
                sigh
                say 又是一位未完成任務就離線的玩家。
                mppurge self
        endif
endif
~
