else
        if insameroom(guest-prehist)
                if rand(33)
                        mpforce guest-prehist say 小雪，給我來一客紅豆冰！
                        say 沒問題....。
                        mpcallout 1 mpecho 小雪進入了房間沒多久後，手上捧著一盤紅豆冰出來....
                        mpcallout 2 say 這是您的紅豆冰....。
                        mpcallout 2 mpecho 小雪將紅豆冰放到客人的面前....。
                        mpcallout 2 mpforce guest-prehist mpoload 15598
                        mpcallout 3 mpforce guest-prehist eat ice
                        mpcallout 3 mpdel_qmark self prehist_talking
                        break
                endif
                if rand(50)
                        mpforce guest-prehist say 小雪，我要一碗綠豆冰！
                        say 好的，馬上來！
                        mpcallout 1 mpecho 小雪進入了房間沒多久後，手上捧著一盤綠豆冰出來....
                        mpcallout 2 say 您好，這是您點的綠豆冰。
