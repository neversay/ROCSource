rock~
這塊岩石的顏色明顯地與這邊的其他生態格格不入，你應該仔細搜索一下。
~
>room_command search rock~
if roomvalue($0) == 0
        echoat $n 你仔細地搜索岩石(rock)的每一個角落....
        echoaround $n $n 開始仔細地搜索這塊顏色不一樣的大岩石(rock)....
        if int($n) < 18
                callout 1 echoat $n 你似乎可以感覺到這塊岩石(rock)的不自然，但卻又說不出什麼所以然....
                callout 1 echoaround $n $n 似乎搜索不出這塊顏色特別的岩石(rock)有什麼奇怪的地方....
        else
                callout 1 echoat $n 你可以感覺到這塊不同顏色的岩石(rock)是人為添加的，或許可以敲敲看....
                callout 1 echoaround $n $n 似乎搜索出了這塊顏色特別的岩石(rock)的奇怪之處....
        endif
        break
endif
if roomvalue($0) == 1
        echoat $n 你仔細地搜索岩石(rock)的每一個角落....
        echoaround $n $n 開始仔細地搜索這塊顏色不一樣的大岩石(rock)....
        callout 1 echoat $n 這一塊岩石已經被移開了。
        callout 1 echoaround $n $n 並沒有發現什麼特別的。
endif
~
>room_command knock rock~
if roomvalue($0) == 0
        echoat $n 你試著輕輕敲擊這塊顏色不同的岩石(rock)....
        echoaround $n $n 輕輕敲擊這塊顏色不同的岩石(rock)....
        callout 1 echo 敲擊所發出的聲音似乎顯示岩石後是空心的。
endif
~
>room_command move rock~
rcall prehist_rock_move $n
~
>room_command push rock~
rcall prehist_rock_move $n
~
>room_defun prehist_rock_move~
if roomvalue($0) == 0
        echoat $n 你嘗試推動這塊顏色不同的岩石(rock)....
        echoaround $n $n 嘗試推動這塊顏色不同的岩石(rock)....
        if pcnum($) < 2
                callout 1 echoat $n 你自己一個人完全推不動這塊岩石(rock)....
                callout 1 echoaround $n $n 完全無法推動這塊岩石(rock)....
        else
                if str($n) < 24
                        callout 1 echoat $n 你的力量太小，無法推動這塊岩石(rock)....
                        callout 1 echoaround $n $n 完全無法推動這塊岩石(rock)....
                else
                        callout 1 echoat $n 你順利地將這塊岩石(rock)給推開了....
                        callout 1 echoaround $n $n 順利地將這塊岩石(rock)給推開了....
                        callout 1 modrvt v0 = 1
                        callout 1 modrvt timer = 12
                        callout 1 makedoor 5 一個通往地下洞穴的通道(passage) passage 0 0 15428
                        callout 1 force 15428 makedoor 4 通往地面的通道(passage) passage 0 0 15423
                endif
        endif
        break
endif
if roomvalue($0) == 1
        echoat $n 你嘗試推動這塊顏色不同的岩石(rock)....
        echoaround $n $n 嘗試推動這塊顏色不同的岩石(rock)....
        callout 1 echo 但是這塊岩石(rock)已經被移開了。
endif
~
>room_rand 50~
if hasdoor(5)
        if roomvalue($0) == 0
                echo 忽然此處一陣震動，一塊移動的岩石(rock)將往下的通道給擋住了....
                deldoor 5
                force 15428 deldoor 4
                force 15428 echo 忽然此處一陣震動，一塊移動的岩石(rock)將往地面的通道給擋住了....
        endif
endif
~
