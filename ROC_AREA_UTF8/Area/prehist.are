>talk_prog p clear voice~
if is_qmark($n) == prehist_wuu_quest 100002
        mpforce $n say 我帶來了迷航之海的清音。
        if is_inv_obj($n) == 40008
                sm $n
                say 迷航之海的清音，這捆箭我已經想看到它很久了，
                say 果然是十分的完美，如果它的名字一般的漂亮，
                say 請把它拿給我吧！
        else
                say 但是你身上並沒有清音。
        endif
endif
