>talk_prog gathered~
if is_qmark($n) == prehist_xue_quest 100001
        if is_qmark($n) >= prehist_xue_quest 300001
                mpforce $n say 我已經蒐集(gathered)到有關如何取悅冰長老的方法了。
                if mobcount(15630) > 0
                        hop $n
                        say 真的嗎？那麼冰長老爺爺的事情就請你幫忙了。
                        say 他現在就在裡面，你可以打開門進去。
                        mpmod_qmark $n prehist_xue_quest v0 = 2
                else
                        bow $n
                        say 謝謝你，不過現在冰長老爺爺有事外出了，
                        say 可不可以請你等冰長老爺爺回來的時候再來找我。
                        sorry $n
                endif
        endif
endif
