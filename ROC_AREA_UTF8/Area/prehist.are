>room_command jump hole~
echoat $n 你往樓板的大洞(hole)用力一跳....
echoaround $n $n 往樓板的大洞(hole)跳了下去....
force 15676 echo $n 忽然由天花板上的洞跳了下來。
if dex($n) < 20
        echoat $n 當你落地的時候無法保持平衡，受到了一定的損傷。
        modhmv $n 01.50 100 0
else
        echoat $n 你以高超的技巧輕鬆落地。
endif
transfer $n 15676
~
>room_command jump default~
echoat $n 你要跳到哪裡去？
~
>room_command locate rope~
if is_inv_obj($n) == 15435
        purge $n rope1-prehist
        echoat $n 你將 繩索(rope) 放置在大洞旁，並將 繩索(rope) 垂放到樓下去....
        echoaround $n $n 將 繩索(rope) 放置在大洞旁，並將 繩索(rope) 垂放到樓下去....
        force 15676 echo 忽然天花板上的洞有一條繩索放了下來....
        oload 15436 99 floor
        force 15676 oload 15437 99 floor
else
        echoat $n 你身上並沒有這項東西。
endif
~
