>rand_prog 100~
if is_qmark($r) == prehist_enemy
        grin
        say 可惡的$R，你躲在這邊我就不知道了嗎？
        if class($r) == 5
        or class($r) == 6
        or class($r) == 7
        or class($r) == 8
                if isaffected($r) & 68719476736
                        say 有反彈魔法就能夠高枕無憂了嗎？
                        mpdis_magic $r 'mystic mirror'
                endif
                c 'seal magic' $r
                mpnowait
                hunt $r
                mpnowait
        else
                if rand(33)
                        c sleep $r
                        mpnowait
                        hunt $r
                        mpnowait
                        break
                endif
                if rand(50)
                        c paralyze $r
                        mpnowait
                        hunt $r
                        mpnowait
                else
                        c blindness $r
                        mpnowait
                        hunt $r
                        mpnowait
                endif
        endif
endif
if hitprcnt($i) <= 70
        c heal
        mpnowait
endif
if hitprcnt($i) <= 50
        c 'double heal'
        mpnowait
endif
if hitprcnt($i) <= 30
        c 'double heal'
        mpnowait
endif
if rand(50)
        if isaffected($i) & 1
                c 'cure blindness'
                mpnowait
        endif
        if isaffected($i) !& 128
                c sanc
                mpnowait
        endif
        if isaffected($i) & 4096
                c 'cure poison'
                mpnowait
        endif
endif
if insameroom(guard-prehist)
        if hitprcnt(guard-prehist) <= 70
                say 守衛你的身上有傷，讓我來幫你治療。
                c heal guard-prehist
                mpnowait
        endif
        if hitprcnt(guard-prehist) <= 50
                c 'double heal' guard-prehist
                mpnowait
        endif
        if hitprcnt(guard-prehist) <= 30
                c 'double heal' guard-prehist
                mpnowait
        endif
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_qmark($n) != prehist_enemy
        mpadd_qmark $n prehist_enemy -1 0 0 0 1 1
endif
~
