~
>room_command pull rod~
if robjcount(15444) > 0
	if roomvalue($0) & 1024
		echoat $n 目前正有人進行拉動拉桿的動作。
		break
	endif
	if roomvalue($1) == 2
		echoat $n 你嘗試拉動拉桿....
		echoaround $n $n 嘗試拉動拉桿....
		modrvt v0 | 1024
		if hasdoor(0)
			callout 2 echo 並沒有發生什麼特別的事情。
		else
			callout 2 echo 北面的牆壁忽然打開了。
			callout 2 modrvt v0 r 1024
			callout 2 modrvt v1 = 3
			callout 2 modrvt t0 = 48
			callout 2 makedoor 0 石壁上的出口(exit) exit 0 0 15596
			callout 2 force 15596 makedoor 2 石壁上的出口(exit) exit 0 0 15597
		endif
		break
	endif
	if roomvalue($1) == 3
		echoat $n 你嘗試拉動拉桿....
		echoaround $n $n 嘗試拉動拉桿....
		callout 2 echoat $n 這根拉桿已經被拉動過了。
	endif
else
	echoat $n 這裡並沒有什麼拉桿(rod)。
endif
~
>room_command clean hole~
if roomvalue($0) & 1024
	echoat $n 目前正有人進行清除的工作。
	break
endif
if roomvalue($1) == 0
	echoat $n 這裡並沒有什麼洞。
	break
endif
if roomvalue($1) == 1
	modrvt v0 | 1024
	echoat $n 你開始清除北面小洞中的雜物....
	echoaround $n $n 開始清除北面小洞中的雜物....
	callout 2 echo 小洞中出現了一根拉桿(rod)。
	callout 2 echoat $n 你將清除出的小洞雜物丟到地上。
	callout 2 echoaround $n $n 將小洞中清除出的雜物丟到地上....
	callout 2 oload 15444 99 floor
	callout 2 oload 15442 99 floor
	callout 2 modrvt v0 r 1024
	modrvt v1 = 2
	break
endif
if roomvalue($1) == 2
	echoat $n 小洞中的雜物已經清理過了。
endif
~
>room_command search hole~
if roomvalue($1) == 0
	echoat $n 這裡並沒有什麼洞。
	break
endif
echoat $n 你開始嘗試搜尋牆壁上的小洞....
echoaround $n $n 開始搜尋北面牆壁上的小洞....
if roomvalue($1) == 1
	callout 2 echoat $n 小洞內的雜物太多，無法知道小洞中有些什麼。
	callout 2 echoaround $n $n 由於小洞內雜物太多，無法進行搜尋的工作....
endif
if roomvalue($1) == 2
	callout 2 echoat $n 小洞中有一根拉桿(rod)，上頭滿是灰塵。
	callout 2 echoaround $n $n 在小洞中發現了一根拉桿。
endif
