>fight_prog 100~
if is_qmark($n) != prehist_enemy
        mpadd_all_qmark $n prehist_enemy -1 0 0 0 1 1
endif
if isfight($r)
        if is_qmark($r) != prehist_enemy
                mpadd_qmark $r prehist_enemy -1 0 0 0 1 1
        endif
endif
if is_equ_obj($i) != 15618
        wield hugeknife twohand
        disarm
endif
if ispc($r)
        if isfight($r)
        or is_qmark($r) == prehist_enemy
                if class($r) == 7
                        say 賢者 $r ，難道你以為躲在後面就沒事了嗎？
                        mpechoat $r [1;33m$I 使用奇特的身法避過眾人轉而向你攻擊！[m
                        mpechoarond $r [1;33m$I 使用奇特的身法避過眾人轉而向 $r 攻擊！[m
                        mpgoto $r
                        mpcallout 1 mpcall prehist_gorden_darkweapon_r $r
                else
                        if class($r) == 8
                                say 主教 $r ，我不會讓你有機會在後面亂來的！
                                mpechoat $r [1;33m$I 使用奇特的身法避過眾人轉而向你攻擊！[m
                                mpechoarond $r [1;33m$I 使用奇特的身法避過眾人轉而向 $r 攻擊！[m
                                mpgoto $r
                                mpcallout 1 mpcall prehist_gorden_darkweapon_r $r
                        else
                                if class($r) == 6
                                        say 鍊金師 $r ，你以為我會讓你有機會在後面施法嗎？
                                        mpechoat $r [1;33m$I 使用奇特的身法避過眾人轉而向你攻擊！[m
                                        mpechoarond $r [1;33m$I 使用奇特的身法避過眾人轉而向 $r 攻擊！[m
                                        mpgoto $r
                                        mpcallout 1 mpcall prehist_gorden_darkweapon_r $r
                                endif
                        endif
                endif
        endif
endif
if rand(33)
        circular
        mpnowait
endif
if rand(33)
        flaming
        mpnowait
endif
if rand(33)
        perform empslash
        mpnowait
endif
if hitprcnt($i) < 50
        if rand(50)
                if is_qmark($i) != prehist_gorden_flee
                        mpadd_qmark self 5 prehist_gorden_flee 5 0 0 0 1 0
                endif
                mpechoat $n [1;33m$I 見自己傷勢嚴重，忽然向你灑出三枚暗器！[m
                mpechoaround $n [1;33m$I 見自己傷勢嚴重，忽然向 $n 灑出三枚暗器！[m
                mpcall prehist_gorden_darkweapon_n $n
                mpcallout 1 mpcall prehist_gorden_flee $n
        endif
endif
