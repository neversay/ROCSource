        mpadd_qmark $n prehist_quest -1 0 256 0 0 1
else
        if is_qmark($n) !& prehist_quest 200256
                mpmod_qmark $n prehist_quest v1 | 256
        endif
endif
sigh
say 可惜在遠古森林中沒有一捆好箭啊，
say 真是可惜了我這把好弓。
~
>fight_prog 100~
