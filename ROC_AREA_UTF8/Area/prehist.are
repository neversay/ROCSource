endif
mpadd_qmark self prehist_talking 5 0 0 0 1 0
mpforce $n say 請問一下有關魔刀村的背景(background)或由來。
say 魔刀村的背景或由來....？
mpcallout 1 say 這個就說來話長了....，
mpcallout 2 say 不過對於村子裡頭第二代的我來說....，
mpcallout 3 say 我知道的還沒有那些長老們多呢....。
mpcallout 4 say 我只有大略的知道魔刀村中的村民與遠方的奈圖王國有著一定的關係....，
mpcallout 5 say 因為我們跟奈圖王國的居民都是屬於迷霧之島上頭的原住民....，
mpcallout 6 say 但是自從史卡拉貝大陸的移民在迷霧之島建造了光明之鎮後....，
mpcallout 7 say 似乎在奈圖王國內造成了相當大的衝擊....，
mpcallout 8 say 不喜歡史卡拉貝大陸人類的居民便分出來跑到了這邊....，
mpcallout 9 say 但是為什麼這邊要叫做魔刀村我就不太清楚了。
mpcallout 9 blush $n
mpcallout 9 mpdel_qmark self prehist_talking
~
>talk_prog please~
if is_qmark($n) == prehist_enemy
or is_qmark($i) == prehist_talking
        break
endif
if is_qmark($n) == prehist_xue_quest 100001
        mpadd_qmark self prehist_talking 5 0 0 0 1 0
        mpmod_qmark $n prehist_xue_quest v2 | 4
        mpforce $n say 請問一下您都是用什麼招數取悅(please)其他人們的？
        gasp $n
        say 我真訝異你會問我這樣的問題....，
        mpcallout 1 think $n
        mpcallout 2 say 其實對我來說，我一生窮究刀法多年....，
        mpcallout 3 say 為的就是將魔刀村上一代留下的刀法傳承給下一代....，
        mpcallout 4 say 因此當我施展了高超、強力的刀法給魔刀村的年輕人時....，
        mpcallout 5 say 往往可以看到他們臉上喜不自勝的表情....，
        mpcallout 6 say 或許對我來說取悅其他人們的方法....，
        mpcallout 7 say 就是施展他們一生夢寐以求的高超技巧或武功吧....。
        mpcallout 8 say 當然，這個需要非常強大的力量才行呢！
        mpcallout 9 sm $n
        mpcallout 9 mpdel_qmark self prehist_talking
endif
~
>rand_prog 100~
if isfight($i)
else
        if inroom($i) != 15658
                mpecho $I 轉身往自己的住處走去....
                mpgoto 15658
                break
        endif
endif
wear sleep-knife
wear sleep-knife
if ispc($r)
        if is_qmark($r) == prehist_enemy
                say 魔刀村的敵人 $r ，你給我納命來！
                hunt $r
                flaming
                mpnowait
                earth
                mpnowait
                circular
                mpnowait
        endif
endif
~
>fight_prog 100~
if is_qmark($n) != prehist_enemy
        mpadd_all_qmark $n prehist_enemy -1 0 0 0 1 1
endif
if isfight($r)
        if is_qmark($r) != prehist_enemy
                mpadd_qmark $r prehist_enemy -1 0 0 0 1 1
        endif
endif
if hitprcnt($i) < 70
        if is_qmark($i) == prehist_lan_groupfight
                if insameroom(gelang-prehist)
                else
                        if mobcount(15615) > 0
                                yell 葛浪，快來幫我啊！
                                mpecho [1;33m葛浪(Gelang) 忽然出現在這邊....[m
                                mptransfer gelang-prehist
                                if hitprcnt(gelang-prehist) > 30
                                        mpforce gelang-prehist rescue lan-prehist
                                endif
                        endif
                endif
        else
                if insameroom(gelang-prehist)
                        say 葛浪，快來幫我吧！
                        mpadd_qmark self prehist_lan_groupfight 10 0 0 0 1 0
                        mpgroup self gelang-prehist 1 0
                        mpforce gelang-prehist rescue lan-prehist
                else
                        if mobcount(15615) > 0
                                yell 葛浪，快來幫我啊！
                                mpecho [1;33m葛浪(Gelang) 忽然出現在這邊....[m
                                mptransfer gelang-prehist
                                mpadd_qmark self prehist_lan_groupfight 10 0 0 0 1 0
                                mpforce gelang-prehist rescue lan-prehist
                        endif
                endif
        endif
endif
wear sleep-knife
wear sleep-knife
disarm
skilldrv multihit $n
if rand(20)
        if is_qmark($i) != prehist_lan_uniqueskill
                if insameroom(gelang-prehist)
                        mpadd_qmark self prehist_lang_uniqueskill 5 0 0 0 1 0
                        yell 葛浪，讓我們一同施展我們的合體刀法！
                        mpforce gelang-prehist yell 好！藍，我們一起來吧！
                        mpcallout 1 mpecho [1;33m$I 與 葛浪(Gelang) 兩人將手上的武器高舉在手上....[m
                        mpcallout 2 mpforcer here modhmv pc 01.400 600 0
                        mpcallout 2 mpecho [1;31m一股凜冽的刀氣在現場飛騰，造成你無可比擬的傷害！[m
                        mpcallout 2 yell *****     飛沙走石     *****
                        mpcallout 2 mpforce gelang-prehist yell *****     飛沙走石     *****
                        mpcallout 2 mpdel_qmark self prehist_lan_uniqueskill
                endif
        endif
endif
~
>death_prog 100~
mpdis_magic self blindness
mpat 5 c inf
if is_inv_obj($i) == 15599
        mpjunk all.key
endif
if is_qmark($n) != prehist_enemy
        mpadd_qmark $n prehist_enemy -1 0 0 0 1 1
endif
~
