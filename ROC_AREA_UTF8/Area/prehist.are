        callout 1 echo 輪盤(turntable) 現在的位置就指著刻度 1 。
        break
endif
modrvt v1 | 1024
if roomvalue($1) & 2
        if roomvalue($1) & 64
                callout 1 echoat $n 你將 輪盤(turntable) 轉到刻度 1 的位置....
                callout 1 echoaround $n $n 將 輪盤(turntable) 轉到刻度 1 的位置....
                callout 2 rcall prehist_turntable_trap $n
