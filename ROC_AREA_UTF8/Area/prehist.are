>room_rand 50~
if hasdoor(0)
        if roomvalue($1) == 0
                echo 北方的石壁忽然落下....
                force 15605 echo 南方的石壁忽然落下....
                deldoor 0
                force 15605 deldoor 2
                force 15603 modrvt v0 = 0
        endif
endif
~
>room_defun prehist_turntable_trap~
if roomvalue($0) != 0
        modrvt v0 = 0
endif
if roomvalue($1) & 64
        modrvt v1 r 64
endif
if roomvalue($1) & 128
        modrvt v1 r 128
endif
echo 忽然 輪盤(turntable) 開始轉動指向刻度 0 的位置....
echo 你忽然聽到一陣機刮劇烈轉動的聲音....
modrvt v1 r 1024
if rand(25)
        echo [1;32m石壁旁的小洞忽然噴出無數的毒水，對你造成嚴重的損傷....[m
        modhmv pc 01.300 400 0
        add_affect $n poison 0 24 1 -5 4096
        echoat $n 你覺得自己似乎中了毒....
        break
endif
if rand(33)
        echo [1;31m石壁旁的小洞忽然射出無數的火箭，對你造成嚴重的損傷....[m
        modhmv pc 03.25 60 0
        break
endif
if rand(50)
        echo [1;35m石壁旁的小洞忽然噴出許多紫色的煙霧，對你造成嚴重的損傷....[m
        modhmv pc 03.10 30 0
        add_affect $n disease 0 24 5 -5 1099511627776
        echoat $n 你覺得自己身體似乎生了重病一般....
else
        echo [1;33m石壁旁的小洞忽然射出強烈的閃光，對你的眼睛造成嚴重的損傷....[m
        modhmv pc 01.50 100 0
        add_affect $n blindness 0 24 18 -10 1
        add_affect $n fear 0 24 3 -5 2199023255552
        echoat $n 你覺得自己非但看不見，同時身心似乎感覺有些異樣....
endif
~
|
